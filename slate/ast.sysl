module slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// The tree the parser builds and the interpreter walks.
//
// **Every node is a span and a kind, rather than an enum whose every variant carries a `Span`
// field.** The two say the same thing, and the split is what keeps the span from having to be
// destructured in each of the twenty-odd arms that only wanted the parts. It is also what makes the
// recursion one type wide: a child is a `&Expr`, never a `&`-of-one-variant.
//
// **A block is an expression, and that is the whole of slate's statement/expression story.** sysl's
// own rule is that a block's value is its trailing expression; slate takes it, so `return` is for
// leaving early and nothing else, and an `if` used for its value is the same `if` used for effect.

// An expression, with where it was written.
struct Expr
    span: Span
    kind: &ExprKind
end Expr

// What an expression is.
//
// The `&Expr` children are what make this a tree. A recursive enum through a reference is the shape
// `reference/types.md` states for exactly this, and the indirection is what gives the enum a size.
enum ExprKind
    // Literals. A number has already been decoded by the time it is here.
    IntLit(v: long)
    RealLit(v: real)
    StrLit(v: string)
    BoolLit(v: bool)
    NilLit

    // A name being read.
    Name(name: string)

    // `-x`, `!x`
    Unary(op: Tok, rhs: Expr)

    // `a + b`, and every other infix operator. `&&` and `||` are here too and are *not* ordinary
    // binaries at evaluation time -- they short-circuit, which the evaluator knows and this does not
    // need to record.
    Binary(op: Tok, lhs: Expr, rhs: Expr)

    // `f(a, b)`
    Call(callee: Expr, args: Buf[Expr])

    // `xs[i]`
    Index(target: Expr, key: Expr)

    // `o.name`
    Field(target: Expr, name: string)

    // `[a, b, c]`
    ArrayLit(items: Buf[Expr])

    // `{ a: 1, b: 2 }`. Two buffers rather than one of pairs, because the interpreter builds a map
    // from them and never wants a pair.
    ObjectLit(keys: Buf[string], values: Buf[Expr])

    // `x -> x * 2`, and the multi-parameter form `(a, b) -> a + b`.
    Lambda(params: Buf[string], body: Expr)

    // `if c then a else b`, and the indented form. The `else` is optional, and an `if` without one
    // used for its value is `nil` -- slate is dynamically typed, so there is no type for the missing
    // branch to disagree with.
    IfExpr(cond: Expr, then_branch: Expr, else_branch: Option[Expr])

    // An indented run of statements, whose value is its trailing expression.
    Block(stmts: Buf[Stmt])

    // Something was wrong here.
    //
    // **A node rather than a `Result`, and `pratt.sysl` argues the case in its own header.** A
    // parser that answers an error stops at the first mistake, so a file with two typos takes two
    // runs to fix. A node keeps the tree shaped, keeps the parser going, and lets one pass report
    // everything -- and the interpreter never sees one, because a program that produced any is not
    // run at all.
    Bad
end ExprKind

// A statement, with where it was written.
struct Stmt
    span: Span
    kind: &StmtKind
end Stmt

// What a statement is.
//
// **`Val` and `Var` do not clash with `Tok`'s words of the same name.** Two enums in one module may
// each declare a variant called `Val`; the expected type is what picks between them, and where
// nothing supplies one the compiler asks for `Tok.Val` or `StmtKind.Val` by name.
enum StmtKind
    // `val x = e` and `var x = e`. The difference is whether a later assignment is refused.
    Val(name: string, init: Expr)
    Var(name: string, init: Expr)

    // `x = e`, `o.f = e`, `xs[i] = e`. What may stand on the left is decided by the parser, so the
    // interpreter is handed a target it already knows is assignable.
    Assign(target: Expr, value: Expr)

    // A named function, which is a `val` holding a closure and is kept apart from one only so that
    // it can be recursive: the name is in scope inside the body.
    Def(name: string, params: Buf[string], body: Expr)

    // An expression evaluated for its effect, or -- as the last statement of a block -- for its
    // value.
    Eval(e: Expr)

    // `return`, with or without a value.
    Return(value: Option[Expr])

    Break
    Continue

    // `while c` with an indented body.
    While(cond: Expr, body: Expr)

    // `for x in e` with an indented body.
    For(name: string, iter: Expr, body: Expr)

    // `loop` with an indented body. The unconditional loop is a form of its own rather than
    // `while true`, which is the rule sysl states for itself and slate follows.
    Loop(body: Expr)
end StmtKind

// A whole file: the statements at its top level.
struct Program
    stmts: Buf[Stmt]
end Program

// -- construction -------------------------------------------------------------------------------

// The two constructors are here so that a parser reads without the tree's boxing on every line.
//
// **There is no operator on the argument, and reaching for one is the mistake to know about.** A
// `&T` is a counted box, not an address, so a value read into one is put in a box where it stands;
// `&kind` would be taking the address of a local, which is a different thing entirely and is
// refused in as many words.
expr(span: Span, kind: ExprKind) -> Expr = Expr(span, kind)

stmt(span: Span, kind: StmtKind) -> Stmt = Stmt(span, kind)
