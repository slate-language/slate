module slate
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{str_builder, Search}

// What slate claims, run by `sysl test .`.

// -- helpers ----------------------------------------------------------------------------------

// The token kinds a snippet lexes to, as one space-separated line.
//
// **Spans are dropped here and asserted separately.** A test that pins both says nothing clearly
// when it fails: the whole list is printed and the reader has to find which half moved. The shape
// of the token stream is what nearly every one of these is about, so that is what they compare.
//
// **A string rather than the `Buf[Tok]` this naturally wants to be**, because neither `Buf[T]` nor
// `[]T` is `Eq` where `T` is -- `sysl.slices.equal` is the only comparison, and it answers a bare
// `bool`, so a failure would print which assertion broke and not what the two sides were. Rendering
// first costs an allocation no test cares about and buys a failure that reads like a diff.
private kinds(text: string) -> string
    val r = lex(source_of("t", text))
    var out = str_builder()
    var t = r.tokens
    var first = true

    loop
        t.advance() match
            None -> break
            Some(x) ->
                if !first then out.push_char(' ')

                out.push(s"${x.value}")
                first = false

    out.finish()
end kinds

// Whether a snippet lexes with nothing to complain about.
private clean(text: string) -> bool = lex(source_of("t", text)).ok()

// The first complaint a snippet draws, rendered as the sentence a person would read.
private first_fault(text: string) -> string
    val src = source_of("t", text)
    val r = lex(src)

    if r.report.is_empty() then "" else r.report.render(src)
end first_fault

// -- words and operators ----------------------------------------------------------------------

@test
a_word_the_grammar_took_is_not_an_identifier()
    assert_eq(kinds("val"), "Val Newline Eof")
    assert_eq(kinds("var"), "Var Newline Eof")
    assert_eq(kinds("nil"), "Nil Newline Eof")

@test
a_word_the_grammar_did_not_take_is_an_identifier()
    assert_eq(kinds("value"), "Ident Newline Eof")
    assert_eq(kinds("iffy"), "Ident Newline Eof")
    assert_eq(kinds("_x1"), "Ident Newline Eof")

@test
end_is_a_soft_word_and_stays_an_identifier()
    // Taking `end` as a keyword would take the name away from every program that wanted it. The
    // parser decides what it means by what follows.
    assert_eq(kinds("end"), "Ident Newline Eof")

@test
a_two_byte_operator_is_read_before_its_first_byte()
    assert_eq(kinds("=="), "EqEq Newline Eof")
    assert_eq(kinds("="), "Assign Newline Eof")
    assert_eq(kinds("->"), "Arrow Newline Eof")
    assert_eq(kinds("-"), "Minus Newline Eof")
    assert_eq(kinds("<="), "LtEq Newline Eof")
    assert_eq(kinds("<"), "Lt Newline Eof")
    assert_eq(kinds("!="), "BangEq Newline Eof")
    assert_eq(kinds("!"), "Bang Newline Eof")
end a_two_byte_operator_is_read_before_its_first_byte

// -- literals ---------------------------------------------------------------------------------

@test
an_integer_and_a_real_are_told_apart()
    assert_eq(kinds("42"), "IntLit Newline Eof")
    assert_eq(kinds("4.2"), "RealLit Newline Eof")
    assert_eq(kinds("0x2a"), "IntLit Newline Eof")

@test
a_string_keeps_its_quotes_in_its_span()
    val r = lex(source_of("t", "\"hi\""))

    assert_eq(r.tokens.peek().unwrap().span, Span(0, 4))

@test
a_malformed_literal_is_reported_and_does_not_stop_the_line()
    assert(!clean("\"unclosed"))
    assert(!clean("\"\\q\""))

// -- layout -----------------------------------------------------------------------------------

@test
an_indented_run_opens_and_closes_one_block()
    assert_eq(kinds("a\n    b\n"), "Ident Indent Ident Newline Dedent Eof")

@test
two_lines_at_one_depth_are_separated_by_a_newline()
    assert_eq(kinds("a\nb\n"), "Ident Newline Ident Newline Eof")

@test
one_line_closes_as_many_blocks_as_it_dedents_past()
    assert_eq(kinds("a\n    b\n        c\nd\n"), "Ident Indent Ident Indent Ident Newline Dedent Dedent Ident Newline Eof")
end one_line_closes_as_many_blocks_as_it_dedents_past

@test
everything_still_open_closes_at_the_end_of_the_file()
    assert_eq(kinds("a\n    b\n        c\n"), "Ident Indent Ident Indent Ident Newline Dedent Dedent Eof")

@test
a_blank_line_is_not_a_line()
    // Neither a statement separator nor a block: there is nothing on it to separate.
    assert_eq(kinds("a\n\n\nb\n"), "Ident Newline Ident Newline Eof")

@test
a_comment_only_line_is_not_a_line_whatever_its_indentation()
    // A person who indents a comment to line up with the code below it did not mean to open a block.
    assert_eq(kinds("a\n        // note\nb\n"), "Ident Newline Ident Newline Eof")

@test
a_trailing_comment_ends_the_line_and_nothing_else()
    assert_eq(kinds("a // note\nb\n"), "Ident Newline Ident Newline Eof")

@test
a_newline_inside_brackets_is_not_a_line_ending()
    // The rule every language with both features implements the same way: count the brackets in the
    // lexer, and ignore line structure while the count is above zero.
    assert_eq(kinds("f(a,\n    b)\n"), "Ident LParen Ident Comma Ident RParen Newline Eof")
end a_newline_inside_brackets_is_not_a_line_ending

@test
a_line_lining_up_with_nothing_is_reported_rather_than_quietly_closed()
    // The one indentation mistake a person actually makes: a body pulled back to a column between
    // two open ones. Closing the nearest level quietly would turn it into a parse error elsewhere.
    val text = "a\n        b\n    c\n"

    assert(!clean(text))
    assert(first_fault(text).contains("lines up with no block"))
end a_line_lining_up_with_nothing_is_reported_rather_than_quietly_closed

@test
mixing_tabs_and_spaces_on_one_line_is_reported()
    assert(!clean("a\n \tb\n"))

@test
an_empty_file_has_no_structure_to_report()
    assert_eq(kinds(""), "Eof")
    assert_eq(kinds("\n\n"), "Eof")
    assert(clean(""))

// -- the parser -------------------------------------------------------------------------------

// A snippet's tree, in parenthesised prefix notation -- and the rendered complaint instead, where
// there was one.
//
// **Handing back the complaint is what stops a test passing on a tree built out of error nodes.**
// Rendering the tree regardless would print `<bad>`, which compares equal to an expectation that
// said `<bad>` -- a test asserting the parser failed the way it failed last time. A test that wants
// the error path asserts on `parse` directly, and several below do.
private good_tree(text: string) -> string
    val src = source_of("t", text)
    val r = parse(src)

    if !r.ok() then return r.report.render(src)

    show_program(r.program)
end good_tree

@test
precedence_comes_out_of_the_binding_powers()
    assert_eq(good_tree("1 + 2 * 3"), "(+ 1 (* 2 3))")
    assert_eq(good_tree("1 * 2 + 3"), "(+ (* 1 2) 3)")
    assert_eq(good_tree("a < b && c < d"), "(&& (< a b) (< c d))")
    assert_eq(good_tree("a || b && c"), "(|| a (&& b c))")
end precedence_comes_out_of_the_binding_powers

@test
arithmetic_groups_to_the_left()
    // Two numbers apart in the table is the whole of associativity: equal powers stop the inner
    // loop, so the second operator cannot take the first one's right-hand side.
    assert_eq(good_tree("8 - 4 - 2"), "(- (- 8 4) 2)")

@test
the_lambda_arrow_groups_to_the_right()
    // A function returning a function, rather than a parse error.
    assert_eq(good_tree("x -> y -> x + y"), "(fn(x) (fn(y) (+ x y)))")

@test
a_prefix_operator_binds_tighter_than_arithmetic_and_looser_than_a_field()
    assert_eq(good_tree("-a * b"), "(* (- a) b)")
    assert_eq(good_tree("-a.b"), "(- (. a b))")
    assert_eq(good_tree("!ok"), "(! ok)")

@test
calls_indexing_and_fields_chain()
    assert_eq(good_tree("f(1)(2)"), "(call (call f 1) 2)")
    assert_eq(good_tree("o.a.b"), "(. (. o a) b)")
    assert_eq(good_tree("xs[0][1]"), "(index (index xs 0) 1)")
    assert_eq(good_tree("o.f(1)"), "(call (. o f) 1)")

@test
a_grouping_changes_the_shape_and_leaves_no_node()
    assert_eq(good_tree("(1 + 2) * 3"), "(* (+ 1 2) 3)")

// -- literals and containers --------------------------------------------------------------------

@test
a_literal_is_decoded_from_the_span_the_lexer_proved()
    assert_eq(good_tree("42"), "42")
    assert_eq(good_tree("0x2a"), "42")
    assert_eq(good_tree("1_000"), "1000")
    assert_eq(good_tree("true"), "true")
    assert_eq(good_tree("nil"), "nil")

@test
a_string_arrives_with_its_escapes_decoded()
    assert_eq(good_tree("\"a\\tb\""), "\"a\tb\"")

@test
an_array_and_an_object_read_as_literals()
    assert_eq(good_tree("[1, 2, 3]"), "(array 1 2 3)")
    assert_eq(good_tree("[]"), "(array)")
    assert_eq(good_tree("{ a: 1, b: 2 }"), "(object a:1 b:2)")

@test
an_argument_list_may_be_broken_across_lines()
    // Not a rule of the grammar: the bracket depth made those newlines insignificant before the
    // parser saw anything.
    assert_eq(good_tree("f(1,\n  2)"), "(call f 1 2)")

// -- statements ---------------------------------------------------------------------------------

@test
the_two_bindings_are_told_apart()
    assert_eq(good_tree("val x = 1"), "(val x 1)")
    assert_eq(good_tree("var x = 1"), "(var x 1)")

@test
a_definition_is_told_from_a_call_by_what_follows_it()
    // The one place slate's grammar looks ahead, and what taking sysl's keyword-free function form
    // costs: the two are identical until the body.
    assert_eq(good_tree("add(a, b)\n    a + b"), "(def add(a b) (block (+ a b)))")
    assert_eq(good_tree("add(a, b)"), "(call add a b)")
    assert_eq(good_tree("double(x) = x * 2"), "(def double(x) (* x 2))")

@test
a_call_whose_arguments_are_not_names_is_never_a_definition()
    assert_eq(good_tree("f(a.b)"), "(call f (. a b))")
    assert_eq(good_tree("f(1)"), "(call f 1)")

@test
a_function_of_no_arguments_is_still_a_definition()
    assert_eq(good_tree("go()\n    1"), "(def go() (block 1))")

@test
a_block_is_a_run_of_statements_and_its_value_is_the_last()
    assert_eq(good_tree("f()\n    val a = 1\n    a + 1"), "(def f() (block (val a 1) (+ a 1)))")

@test
the_loops_read()
    assert_eq(good_tree("while a < 10\n    b"), "(while (< a 10) (block b))")
    assert_eq(good_tree("for x in xs\n    x"), "(for x xs (block x))")
    assert_eq(good_tree("loop\n    break"), "(loop (block (break)))")

@test
return_is_for_leaving_early_and_takes_a_value_or_not()
    assert_eq(good_tree("f()\n    return\n"), "(def f() (block (return)))")
    assert_eq(good_tree("f()\n    return 1\n"), "(def f() (block (return 1)))")

@test
assignment_is_a_statement_and_not_an_expression()
    assert_eq(good_tree("x = 1"), "(= x 1)")
    assert_eq(good_tree("o.f = 1"), "(= (. o f) 1)")
    assert_eq(good_tree("xs[0] = 1"), "(= (index xs 0) 1)")

@test
what_cannot_be_assigned_to_is_refused_where_it_is_written()
    val src = source_of("t", "1 + 1 = 2")
    val r = parse(src)

    assert(!r.ok())
    assert(r.report.render(src).contains("cannot be assigned to"))

// -- if ------------------------------------------------------------------------------------------

@test
if_has_an_inline_form_and_an_indented_one()
    assert_eq(good_tree("if a then 1 else 2"), "(if a 1 2)")
    assert_eq(good_tree("if a\n    1\nelse\n    2"), "(if a (block 1) (block 2))")

@test
elif_is_sugar_and_nests_into_the_else_of_the_one_before()
    // No node exists for it, so nothing downstream has to learn a rule about it.
    assert_eq(good_tree("if a\n    1\nelif b\n    2\nelse\n    3"),
        "(if a (block 1) (if b (block 2) (block 3)))")
end elif_is_sugar_and_nests_into_the_else_of_the_one_before

@test
an_if_without_an_else_has_no_second_branch()
    assert_eq(good_tree("if a\n    1"), "(if a (block 1))")

@test
a_statement_after_a_block_is_a_statement_and_not_a_continuation()
    // The case that is easy to leave out: a block closing ends the statement that contained it, the
    // newline having been spent inside the block.
    assert_eq(good_tree("if a\n    1\nb"), "(if a (block 1)) b")

// -- lambdas --------------------------------------------------------------------------------------

@test
a_lambda_takes_one_bare_parameter_or_a_parenthesised_list()
    assert_eq(good_tree("x -> x * 2"), "(fn(x) (* x 2))")
    assert_eq(good_tree("(a, b) -> a + b"), "(fn(a b) (+ a b))")
    assert_eq(good_tree("() -> 1"), "(fn() 1)")

@test
a_parenthesised_expression_is_not_mistaken_for_a_parameter_list()
    // The two are told apart by trying, because no single token distinguishes them.
    assert_eq(good_tree("(a + b) * 2"), "(* (+ a b) 2)")
    assert_eq(good_tree("(a)"), "a")

@test
a_lambda_may_have_an_indented_body()
    assert_eq(good_tree("val f = x ->\n    x + 1"), "(val f (fn(x) (block (+ x 1))))")

// -- recovery ---------------------------------------------------------------------------------

@test
a_parse_error_leaves_a_node_so_that_one_pass_reports_everything()
    val src = source_of("t", "val = 1\nval y = ")
    val r = parse(src)

    assert(!r.ok())

    // Both mistakes, from one run.
    assert(r.report.len() >= 2)
end a_parse_error_leaves_a_node_so_that_one_pass_reports_everything

// -- the interpreter ----------------------------------------------------------------------------

// What a program printed, joined by newlines -- or its complaint, where it had one.
private out(text: string) -> string
    val src = source_of("t", text)
    val r = run(src)

    if !r.ok() then return r.report.render(src)

    r.printed()
end out

// The complaint a program draws, rendered.
private fails(text: string) -> string
    val src = source_of("t", text)
    val r = run(src)

    if r.ok() then "" else r.report.render(src)
end fails

@test
arithmetic_promotes_an_integer_to_a_real_and_not_the_other_way()
    assert_eq(out("print(1 + 2)"), "3")
    assert_eq(out("print(7 / 2)"), "3")
    assert_eq(out("print(7.0 / 2)"), "3.5")
    assert_eq(out("print(2 + 0.5)"), "2.5")
    assert_eq(out("print(7 % 3)"), "1")
end arithmetic_promotes_an_integer_to_a_real_and_not_the_other_way

@test
dividing_by_zero_is_a_fault_and_not_a_crash()
    assert(fails("print(1 / 0)").contains("divides by zero"))
    assert(fails("print(1 % 0)").contains("remainder by zero"))

@test
strings_join_and_order()
    assert_eq(out("print(\"a\" + \"b\")"), "ab")
    assert_eq(out("print(\"a\" < \"b\")"), "true")

@test
an_operator_that_does_not_apply_names_both_sides()
    assert(fails("print(1 + \"a\")").contains("an integer and a string"))

// -- truthiness ---------------------------------------------------------------------------------

@test
only_false_and_nil_are_false()
    // Zero and the empty string being false as well is the rule JavaScript and Python took, and it
    // is the one most often written about as a mistake.
    assert_eq(out("if 0\n    print(\"yes\")"), "yes")
    assert_eq(out("if \"\"\n    print(\"yes\")"), "yes")
    assert_eq(out("if nil\n    print(\"no\")\nelse\n    print(\"yes\")"), "yes")
    assert_eq(out("if false\n    print(\"no\")\nelse\n    print(\"yes\")"), "yes")
end only_false_and_nil_are_false

@test
the_logical_operators_short_circuit_and_answer_the_deciding_operand()
    assert_eq(out("print(nil || \"fallback\")"), "fallback")
    assert_eq(out("print(\"set\" || \"fallback\")"), "set")
    assert_eq(out("print(false && boom())"), "false")

// -- bindings -----------------------------------------------------------------------------------

@test
a_val_is_written_once_and_a_var_is_not()
    assert_eq(out("var x = 1\nx = 2\nprint(x)"), "2")
    assert(fails("val x = 1\nx = 2").contains("written once"))

@test
an_undefined_name_is_a_fault_where_it_is_read()
    assert(fails("print(nope)").contains("`nope` is not defined"))
    assert(fails("nope = 1").contains("`nope` is not defined"))

@test
a_block_binds_in_a_scope_of_its_own()
    assert_eq(out("val x = 1\nif true\n    val x = 2\n    print(x)\nprint(x)"), "2\n1")

// -- functions and closures ---------------------------------------------------------------------

@test
a_blocks_value_is_its_trailing_expression()
    assert_eq(out("f()\n    val a = 1\n    a + 1\nprint(f())"), "2")

@test
return_leaves_early_from_inside_a_loop()
    // `Ret` passes through the loop untouched, which is what makes this work with nothing written
    // for it.
    assert_eq(out("f(xs)\n    for x in xs\n        if x > 1\n            return x\n    nil\nprint(f([1, 2, 3]))"), "2")

@test
a_named_function_can_call_itself()
    // The name is bound before the closure is built, so the body sees it.
    assert_eq(out("fact(n)\n    if n <= 1 then 1 else n * fact(n - 1)\nprint(fact(5))"), "120")

@test
a_closure_keeps_seeing_writes_to_the_scope_it_captured()
    // The counter, which is the whole argument for the scope being a counted box.
    assert_eq(out("counter()\n    var n = 0\n    bump()\n        n = n + 1\n        n\n    bump\nval c = counter()\nprint(c(), c(), c())"),
        "1 2 3")
end a_closure_keeps_seeing_writes_to_the_scope_it_captured

@test
two_closures_over_one_scope_share_it()
    assert_eq(out("pair()\n    var n = 0\n    up()\n        n = n + 1\n        n\n    get()\n        n\n    [up, get]\nval p = pair()\nval u = p[0]\nval g = p[1]\nu()\nu()\nprint(g())"),
        "2")
end two_closures_over_one_scope_share_it

@test
two_calls_of_one_function_do_not_share_a_scope()
    assert_eq(out("counter()\n    var n = 0\n    bump()\n        n = n + 1\n        n\n    bump\nval a = counter()\nval b = counter()\na()\na()\nprint(a(), b())"),
        "3 1")
end two_calls_of_one_function_do_not_share_a_scope

@test
functions_are_values()
    assert_eq(out("twice(f, v) = f(f(v))\nprint(twice(x -> x * 3, 2))"), "18")
    assert_eq(out("val p = print\np(\"through a binding\")"), "through a binding")

@test
the_wrong_number_of_arguments_is_a_fault()
    assert(fails("f(a) = a\nf(1, 2)").contains("takes 1 arguments and was given 2"))

@test
calling_something_that_is_not_a_function_is_a_fault()
    assert(fails("val x = 1\nx()").contains("is not something that can be called"))

// -- arrays and objects ---------------------------------------------------------------------------

@test
an_array_is_a_reference_type()
    assert_eq(out("val a = [1]\nval b = a\npush(b, 2)\nprint(a)"), "[1, 2]")

@test
values_compare_by_their_contents_and_not_by_identity()
    assert_eq(out("print([1, [2]] == [1, [2]])"), "true")
    assert_eq(out("print({a: 1} == {a: 1})"), "true")
    assert_eq(out("print([1] == [2])"), "false")
    assert_eq(out("print(1 == 1.0)"), "true")

@test
an_index_outside_an_array_is_a_fault_and_not_a_nil()
    // A missing *field* is `nil`, because a record grows fields over its life. A missing *index* is
    // a mistake, because an array's bounds are known.
    assert(fails("print([1, 2][5])").contains("outside an array of 2"))
    assert_eq(out("print({a: 1}.b)"), "nil")

@test
an_object_field_may_be_written_through_a_name_or_an_index()
    assert_eq(out("val o = {a: 1}\no.a = 2\nprint(o.a)"), "2")
    assert_eq(out("val o = {a: 1}\no[\"b\"] = 3\nprint(o.b)"), "3")

@test
an_array_element_may_be_written()
    assert_eq(out("val xs = [1, 2]\nxs[0] = 9\nprint(xs)"), "[9, 2]")

@test
a_string_prints_bare_and_shows_its_quotes_inside_a_container()
    assert_eq(out("print(\"hi\")"), "hi")
    assert_eq(out("print([\"hi\"])"), "[\"hi\"]")

// -- loops ----------------------------------------------------------------------------------------

@test
the_three_loops_run()
    assert_eq(out("var n = 0\nwhile n < 3\n    n = n + 1\nprint(n)"), "3")
    assert_eq(out("var n = 0\nfor x in [1, 2, 3]\n    n = n + x\nprint(n)"), "6")
    assert_eq(out("var n = 0\nloop\n    n = n + 1\n    if n > 2\n        break\nprint(n)"), "3")

@test
break_and_continue_reach_the_nearest_loop()
    assert_eq(out("var n = 0\nfor x in [1, 2, 3, 4]\n    if x == 3\n        break\n    n = n + x\nprint(n)"), "3")
    assert_eq(out("var n = 0\nfor x in [1, 2, 3]\n    if x == 2\n        continue\n    n = n + x\nprint(n)"), "4")

@test
break_outside_a_loop_reaches_the_top_and_is_reported()
    // A call is where `Ret` stops travelling and nothing else does, so this is not quietly swallowed
    // by the function it sits in.
    assert(fails("f()\n    break\nf()").contains("`break` outside a loop"))

@test
for_walks_an_array_and_says_so_when_given_anything_else()
    assert(fails("for x in 1\n    print(x)").contains("`for` walks an array"))

// -- the whole thing ------------------------------------------------------------------------------

@test
a_program_with_a_parse_error_is_not_run_at_all()
    // Running a tree with `Bad` nodes in it would produce a second, worse account of the same file.
    val src = source_of("t", "print(\"before\")\nval = 1")
    val r = run(src)

    assert(!r.ok())
    assert_eq(r.printed(), "")
end a_program_with_a_parse_error_is_not_run_at_all

@test
two_runs_do_not_share_output()
    // The reason the print buffer hangs off the run's `World` rather than being a module-level var.
    assert_eq(out("print(1)"), "1")
    assert_eq(out("print(2)"), "2")

// -- match --------------------------------------------------------------------------------------

@test
a_match_tries_its_arms_in_order()
    assert_eq(out("print(0 match\n    0 -> \"zero\"\n    _ -> \"other\")"), "zero")
    assert_eq(out("print(9 match\n    0 -> \"zero\"\n    _ -> \"other\")"), "other")

@test
a_match_reads_as_a_transformation_of_what_is_to_its_left()
    // `match` binds looser than arithmetic, so the sum is the subject rather than just `b`.
    assert_eq(good_tree("a + b match\n    _ -> 1"), "(match (+ a b) (_ 1))")

@test
a_lambda_body_may_be_a_match_rather_than_the_lambda_being_matched()
    // And tighter than the arrow, which is the other half of where `match` sits in the table.
    assert_eq(good_tree("x -> x match\n    _ -> 1"), "(fn(x) (match x (_ 1)))")

@test
a_subject_matching_no_arm_is_a_fault_naming_it()
    // slate is dynamically typed, so there is no exhaustiveness pass and there cannot be one: the
    // set of values a name may hold is not known. A miss is a runtime fault, as Scala's is.
    assert(fails("5 match\n    0 -> 1").contains("no arm of this match applies to 5"))

@test
a_binding_pattern_takes_anything_and_a_wildcard_binds_nothing()
    assert_eq(out("print(7 match\n    n -> n * 2)"), "14")
    assert_eq(out("print(7 match\n    _ -> \"anything\")"), "anything")
    assert(fails("print(7 match\n    _ -> _)").contains("`_` is not defined"))

@test
a_name_a_pattern_bound_is_a_val()
    assert(fails("7 match\n    n ->\n        n = 8").contains("written once"))

@test
a_guard_reads_what_the_pattern_bound_and_can_refuse_the_arm()
    // The whole reason a guard beats an `if` in the body: a refused arm lets a later one try.
    assert_eq(out("print(-5 match\n    n if n < 0 -> \"negative\"\n    _ -> \"other\")"), "negative")
    assert_eq(out("print(5 match\n    n if n < 0 -> \"negative\"\n    _ -> \"other\")"), "other")

@test
a_guard_does_not_swallow_the_arms_arrow()
    // It is read at the arrow's own binding power, which stops the expression loop exactly there.
    assert_eq(good_tree("n match\n    x if x > 1 -> 2"), "(match n (x if (> x 1) 2))")

// -- literal and alternative patterns -----------------------------------------------------------

@test
every_literal_is_a_pattern_including_a_negative_number()
    assert_eq(out("print(\"a\" match\n    \"a\" -> 1\n    _ -> 2)"), "1")
    assert_eq(out("print(true match\n    true -> 1\n    _ -> 2)"), "1")
    assert_eq(out("print(nil match\n    nil -> 1\n    _ -> 2)"), "1")
    assert_eq(out("print(-3 match\n    -3 -> 1\n    _ -> 2)"), "1")
    assert_eq(out("print(1.5 match\n    1.5 -> 1\n    _ -> 2)"), "1")

@test
alternatives_match_any_of_their_branches()
    assert_eq(out("print(\"sun\" match\n    \"sat\" | \"sun\" -> true\n    _ -> false)"), "true")
    assert_eq(out("print(\"wed\" match\n    \"sat\" | \"sun\" -> true\n    _ -> false)"), "false")

@test
an_alternative_may_not_bind_a_name()
    // `n | 0` would leave `n` bound down one path and not the other, and slate has no type system
    // to notice. Scala refuses the same thing for the same reason.
    assert(fails("1 match\n    n | 0 -> n").contains("may not bind a name"))

// -- array patterns -------------------------------------------------------------------------------

@test
an_array_pattern_matches_by_length_unless_it_is_open()
    assert_eq(out("print([1, 2] match\n    [a, b] -> a + b\n    _ -> 0)"), "3")
    assert_eq(out("print([1, 2, 3] match\n    [a, b] -> a + b\n    _ -> 0)"), "0")
    assert_eq(out("print([] match\n    [] -> \"empty\"\n    _ -> \"no\")"), "empty")

@test
a_rest_pattern_gathers_what_is_left_over()
    assert_eq(out("print([1, 2, 3] match\n    [first, ...rest] -> rest\n    _ -> nil)"), "[2, 3]")
    assert_eq(out("print([1] match\n    [first, ...rest] -> rest\n    _ -> nil)"), "[]")

@test
an_anonymous_rest_says_at_least_this_many_and_binds_nothing()
    assert_eq(out("print([1, 2, 3] match\n    [a, ...] -> a\n    _ -> 0)"), "1")
    assert_eq(out("print([] match\n    [a, ...] -> a\n    _ -> 0)"), "0")

@test
nothing_may_follow_a_rest_pattern()
    assert(fails("[1] match\n    [...r, last] -> 1").contains("nothing may follow it"))

@test
array_patterns_nest_and_recurse()
    assert_eq(out("sum(xs)\n    xs match\n        [] -> 0\n        [a, ...rest] -> a + sum(rest)\nprint(sum([1, 2, 3, 4]))"),
        "10")
end array_patterns_nest_and_recurse

// -- object patterns ------------------------------------------------------------------------------

@test
an_object_pattern_matches_an_object_with_at_least_these_fields()
    // A record grows fields over its life, so a pattern that broke when one was added would be a
    // pattern nobody could keep working.
    assert_eq(out("print({a: 1, b: 2} match\n    {a: x} -> x\n    _ -> 0)"), "1")
    assert_eq(out("print({b: 2} match\n    {a: x} -> x\n    _ -> 0)"), "0")

@test
an_object_pattern_may_name_a_field_as_shorthand_for_binding_it()
    assert_eq(out("print({name: \"ada\"} match\n    {name} -> name\n    _ -> \"none\")"), "ada")

@test
patterns_nest_to_any_depth()
    assert_eq(out("print({at: [1, 2]} match\n    {at: [x, y]} -> x + y\n    _ -> 0)"), "3")

// -- match as an expression -----------------------------------------------------------------------

@test
a_match_may_be_written_as_an_argument()
    // What `sh.sysl.parsing` 0.3.0 is for: a bracket used to suspend the off-side rule outright, so
    // the arms' newlines meant nothing and the block never opened.
    assert_eq(out("print(1 match\n    1 -> \"one\"\n    _ -> \"other\")"), "one")

@test
a_bracket_closes_the_block_its_match_opened()
    // The `)` is on the same line as the last arm, so no line ending will ever close that block.
    assert_eq(good_tree("f(x match\n    1 -> 2)"), "(call f (match x (1 2)))")

@test
a_match_written_as_an_argument_has_to_be_the_last_argument()
    // Not a bug but a consequence: the arms' block is closed by the bracket, so anything between
    // the last arm and the `)` is inside the block. The diagnostic says so rather than complaining
    // about a stray comma in an arm.
    assert(fails("f(x match\n    1 -> 2, 9)").contains("has to be the last argument"))
end a_match_written_as_an_argument_has_to_be_the_last_argument

@test
a_newline_inside_brackets_still_means_nothing_where_no_block_opened()
    assert_eq(good_tree("f(1,\n  2)"), "(call f 1 2)")

@test
an_arm_may_have_an_indented_body()
    assert_eq(out("print(1 match\n    1 ->\n        val a = 2\n        a + 1\n    _ -> 0)"), "3")

@test
a_failed_arm_does_not_leak_what_its_pattern_bound()
    // Each arm gets a scope of its own, because a pattern binds as it goes and cannot know it will
    // fail until it has already written a name.
    assert(fails("[1, 2] match\n    [a, b, c] -> 1\n    _ -> a").contains("`a` is not defined"))

// -- type patterns and `@` --------------------------------------------------------------------

@test
a_bare_name_that_names_a_kind_tests_for_it()
    // sysl's bare-name rule, with `Value`'s variants standing in for the scrutinee's enum's.
    assert_eq(out("print(7 match\n    int -> \"an integer\"\n    _ -> \"other\")"), "an integer")
    assert_eq(out("print(1.5 match\n    real -> \"a real\"\n    _ -> \"other\")"), "a real")
    assert_eq(out("print(\"hi\" match\n    str -> \"text\"\n    _ -> \"other\")"), "text")
    assert_eq(out("print(true match\n    bool -> \"a boolean\"\n    _ -> \"other\")"), "a boolean")
    assert_eq(out("print([1] match\n    array -> \"an array\"\n    _ -> \"other\")"), "an array")
    assert_eq(out("print({a: 1} match\n    object -> \"an object\"\n    _ -> \"other\")"), "an object")
    assert_eq(out("print(print match\n    fn -> \"a function\"\n    _ -> \"other\")"), "a function")
    assert_eq(out("print(nil match\n    nil -> \"nothing\"\n    _ -> \"other\")"), "nothing")
end a_bare_name_that_names_a_kind_tests_for_it

@test
a_bare_name_that_names_no_kind_still_binds()
    // The other half of the rule, and what keeps it from taking every name away.
    assert_eq(out("print(9 match\n    whatever -> whatever * 2)"), "18")
    assert_eq(out("print(9 match\n    integer -> integer * 2)"), "18")

@test
num_is_the_union_of_the_two_number_kinds()
    // Not a `Value` variant, and it earns its place: an integer and a real are separate values, so
    // every pattern guarding arithmetic would be written twice without it.
    assert_eq(out("print(7 match\n    num -> \"a number\"\n    _ -> \"other\")"), "a number")
    assert_eq(out("print(1.5 match\n    num -> \"a number\"\n    _ -> \"other\")"), "a number")
    assert_eq(out("print(\"7\" match\n    num -> \"a number\"\n    _ -> \"other\")"), "other")
    assert_eq(out("print(7 match\n    real -> \"a real\"\n    _ -> \"other\")"), "other")
end num_is_the_union_of_the_two_number_kinds

@test
at_binds_the_whole_value_as_well_as_testing_it()
    assert_eq(out("print(7 match\n    n @ int -> n * 2\n    _ -> 0)"), "14")
    assert_eq(out("print([1, 2] match\n    whole @ [a, b] -> whole\n    _ -> nil)"), "[1, 2]")

@test
at_binds_nothing_when_its_sub_pattern_did_not_take()
    assert(fails("\"hi\" match\n    n @ int -> n\n    _ -> n").contains("`n` is not defined"))

@test
a_type_pattern_makes_a_broad_guard_safe()
    // The case this feature exists for. `n if n < 0` binds anything, so the guard used to evaluate
    // `[3, 4] < 0` and fault; `n @ num if n < 0` cannot reach the guard with the wrong kind.
    val prog = "d(v)\n    v match\n        n @ num if n < 0 -> \"negative\"\n        _ -> \"other\"\nprint(d(-1), d([3, 4]), d(\"hi\"))"

    assert_eq(out(prog), "negative other other")
end a_type_pattern_makes_a_broad_guard_safe

@test
a_type_pattern_renders_as_the_word_that_was_written()
    assert_eq(good_tree("v match\n    n @ num -> 1\n    str -> 2"), "(match v (n@num 1) (str 2))")

@test
a_kind_name_is_only_special_in_a_pattern()
    // It is not a keyword: a program may still bind and read `int` as an ordinary name.
    assert_eq(out("val int = 3\nprint(int + 1)"), "4")
    assert_eq(out("array(n) = n * 2\nprint(array(4))"), "8")
