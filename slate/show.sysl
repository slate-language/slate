module slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{str_builder, StrBuilder}

// The tree, as parenthesised prefix notation.
//
// **This exists for the tests, and that is the whole of its brief.** A parser is checked by pinning
// the shape it produced, and a shape is only worth pinning if a person can read it: `(+ 1 (* 2 3))`
// says what a field-by-field dump of a nested struct does not. Precedence, associativity and the
// definition-versus-call decision are all visible at a glance in this form, which is what makes it
// worth the file.
//
// It is not a pretty-printer and will not round-trip: it drops spans, and it renders the sugar it
// was given rather than the text it came from.

// A whole program.
show_program(prog: Program) -> string
    var out = str_builder()

    for i in 0..<prog.stmts.len()
        if i > 0 then out.push_char(' ')

        write_stmt(&out, prog.stmts.at(i))

    out.finish()
end show_program

// One expression.
show_expr(e: Expr) -> string
    var out = str_builder()

    write_expr(&out, e)
    out.finish()

// One statement.
show_stmt(s: Stmt) -> string
    var out = str_builder()

    write_stmt(&out, s)
    out.finish()

private write_stmt(out: *StrBuilder, s: Stmt)
    *s.kind match
        Val(name, init) -> form2(out, "val", name, init)
        Var(name, init) -> form2(out, "var", name, init)
        Assign(target, value) ->
            out.push("(= ")
            write_expr(out, target)
            out.push_char(' ')
            write_expr(out, value)
            out.push_char(')')
        Def(name, params, body) ->
            out.push("(def ")
            out.push(name)
            out.push_char('(')

            for i in 0..<params.len()
                if i > 0 then out.push_char(' ')

                out.push(params.at(i))

            out.push(") ")
            write_expr(out, body)
            out.push_char(')')
        Eval(e) -> write_expr(out, e)
        Return(value) ->
            value match
                Some(v) ->
                    out.push("(return ")
                    write_expr(out, v)
                    out.push_char(')')
                None -> out.push("(return)")
        Break -> out.push("(break)")
        Continue -> out.push("(continue)")
        While(cond, body) ->
            out.push("(while ")
            write_expr(out, cond)
            out.push_char(' ')
            write_expr(out, body)
            out.push_char(')')
        For(name, iter, body) ->
            out.push("(for ")
            out.push(name)
            out.push_char(' ')
            write_expr(out, iter)
            out.push_char(' ')
            write_expr(out, body)
            out.push_char(')')
        Loop(body) ->
            out.push("(loop ")
            write_expr(out, body)
            out.push_char(')')
end write_stmt

// `(head name value)`, the shape both bindings take.
private form2(out: *StrBuilder, head: string, name: string, value: Expr)
    out.push_char('(')
    out.push(head)
    out.push_char(' ')
    out.push(name)
    out.push_char(' ')
    write_expr(out, value)
    out.push_char(')')
end form2

private write_expr(out: *StrBuilder, e: Expr)
    *e.kind match
        IntLit(v) -> out.push_int(v)
        RealLit(v) -> out.push_real(v)
        StrLit(v) ->
            out.push_char('"')
            out.push(v)
            out.push_char('"')
        BoolLit(v) -> out.push_bool(v)
        NilLit -> out.push("nil")
        Name(n) -> out.push(n)
        Unary(op, rhs) ->
            out.push_char('(')
            out.push(op_text(op))
            out.push_char(' ')
            write_expr(out, rhs)
            out.push_char(')')
        Binary(op, lhs, rhs) ->
            out.push_char('(')
            out.push(op_text(op))
            out.push_char(' ')
            write_expr(out, lhs)
            out.push_char(' ')
            write_expr(out, rhs)
            out.push_char(')')
        Call(callee, args) ->
            out.push("(call ")
            write_expr(out, callee)
            write_all(out, args)
            out.push_char(')')
        Index(target, key) ->
            out.push("(index ")
            write_expr(out, target)
            out.push_char(' ')
            write_expr(out, key)
            out.push_char(')')
        Field(target, name) ->
            out.push("(. ")
            write_expr(out, target)
            out.push_char(' ')
            out.push(name)
            out.push_char(')')
        ArrayLit(items) ->
            out.push("(array")
            write_all(out, items)
            out.push_char(')')
        ObjectLit(keys, values) ->
            out.push("(object")

            for i in 0..<keys.len()
                out.push_char(' ')
                out.push(keys.at(i))
                out.push_char(':')
                write_expr(out, values.at(i))

            out.push_char(')')
        Lambda(params, body) ->
            out.push("(fn(")

            for i in 0..<params.len()
                if i > 0 then out.push_char(' ')

                out.push(params.at(i))

            out.push(") ")
            write_expr(out, body)
            out.push_char(')')
        IfExpr(cond, then_branch, else_branch) ->
            out.push("(if ")
            write_expr(out, cond)
            out.push_char(' ')
            write_expr(out, then_branch)

            else_branch match
                Some(b) ->
                    out.push_char(' ')
                    write_expr(out, b)
                None -> ()

            out.push_char(')')
        MatchExpr(subject, arms) ->
            out.push("(match ")
            write_expr(out, subject)

            for i in 0..<arms.len()
                val arm = arms.at(i)

                out.push(" (")
                write_pattern(out, arm.pattern)

                arm.guard match
                    Some(g) ->
                        out.push(" if ")
                        write_expr(out, g)
                    None -> ()

                out.push_char(' ')
                write_expr(out, arm.body)
                out.push_char(')')

            out.push_char(')')
        Block(stmts) ->
            out.push("(block")

            for i in 0..<stmts.len()
                out.push_char(' ')
                write_stmt(out, stmts.at(i))

            out.push_char(')')
        Bad -> out.push("<bad>")
end write_expr

// A space-separated run of expressions, each preceded by its space.
private write_all(out: *StrBuilder, xs: Buf[Expr])
    for i in 0..<xs.len()
        out.push_char(' ')
        write_expr(out, xs.at(i))

// How an operator is written. Not `private`: a runtime complaint names the operator too.
op_text(k: Tok) -> string
    k match
        Plus -> "+"
        Minus -> "-"
        Star -> "*"
        Slash -> "/"
        Percent -> "%"
        EqEq -> "=="
        BangEq -> "!="
        Lt -> "<"
        LtEq -> "<="
        Gt -> ">"
        GtEq -> ">="
        AndAnd -> "&&"
        OrOr -> "||"
        Bang -> "!"
        _ -> "?"
end op_text

// A pattern, in the same parenthesised form as the rest.
private write_pattern(out: *StrBuilder, pat: Pattern)
    *pat.kind match
        Wild -> out.push_char('_')
        Bind(name) -> out.push(name)
        IntPat(v) -> out.push_int(v)
        RealPat(v) -> out.push_real(v)
        StrPat(v) ->
            out.push_char('"')
            out.push(v)
            out.push_char('"')
        BoolPat(v) -> out.push_bool(v)
        NilPat -> out.push("nil")
        ArrayPat(items, open, rest) ->
            out.push("[")

            for i in 0..<items.len()
                if i > 0 then out.push_char(' ')

                write_pattern(out, items.at(i))

            if open
                if !items.is_empty() then out.push_char(' ')

                out.push("...")

                rest match
                    Some(name) -> out.push(name)
                    None -> ()
            end if

            out.push("]")
        ObjectPat(keys, values) ->
            out.push("{")

            for i in 0..<keys.len()
                if i > 0 then out.push_char(' ')

                out.push(keys.at(i))
                out.push_char(':')
                write_pattern(out, values.at(i))

            out.push("}")
        OrPat(alts) ->
            out.push("(|")

            for i in 0..<alts.len()
                out.push_char(' ')
                write_pattern(out, alts.at(i))

            out.push_char(')')
end write_pattern
