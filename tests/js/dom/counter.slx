// The counter, driven. **This is the program `drive.mjs` clicks**, and it is the example under
// `examples/web/` with two things added: an id on each reading so the driver can find it without
// depending on the shape of the markup, and nothing else.
//
// It is a separate file from the example on purpose. The example is what a person reads; this is
// what a machine asserts against, and a fixture that doubles as documentation ends up serving
// neither -- the example would grow test scaffolding and the fixture would resist being changed.

import { createElement, Fragment, mount, useState } from "../../../packages/react/react.slx"
import { domHost } from "../../../packages/react/dom.slx"

Counter({ id, start = 0, step = 1 }) =
    val [count, setCount] = useState(start)

    <div class="counter">
        <p id={id} class="reading">{count}</p>
        <button class="up" onClick={() -> setCount(count + step)}>+{step}</button>
        <button class="down" onClick={() -> setCount(count - step)}>-{step}</button>
        <button class="reset" onClick={() -> setCount(start)}>reset</button>
    </div>

// A component that goes away, so that the driver can check the node was given back rather than
// leaked -- which is the one thing about this host that has nothing to do with what is on screen.
Maybe({ show }) =
    if !show then return null

    <p id="maybe">here</p>

App(props) =
    val [shown, setShown] = useState(true)

    <>
        <h1>slate counts</h1>
        <Counter id="first" start={0} step={1}/>
        <Counter id="second" start={100} step={5}/>
        <Maybe show={shown}/>
        <p id="risky">{"<script>alert(1)</script> & co"}</p>
        <button id="hide" onClick={() -> setShown(false)}>hide</button>
    </>

mount(<App/>, domHost("#app"))
