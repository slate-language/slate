import { createElement, Fragment, mount, html, flush, useState, useReducer, useRef, useMemo, useEffect } from "../react.slx"

// Hooks, which are what a component keeps between renders.
//
// **A hook is found by the ORDER it was called in**, so every test here is also a test that the slot
// counter is reset at the top of each render and that the array on the instance survived.

@test
A_SETTER_THAT_CHANGES_NOTHING_DOES_NOT_RE_RENDER()
    // **Which is what stops an effect from looping.** A component that sets its state to what it
    // already holds must be a no-op, not a render.
    var renders = 0
    var setter = null

    Same(props) =
        val [n, setN] = useState(1)

        renders = renders + 1
        setter = setN

        <p>{n}</p>

    val root = mount(<Same/>)

    assert(renders == 1)

    setter(1)
    flush(root)

    assert(renders == 1)

    setter(2)
    flush(root)

    assert(renders == 2)

@test
TWO_CHANGES_IN_ONE_TURN_ARE_ONE_RENDER()
    // React's batching, and the reason a handler can never see a half-updated tree.
    var renders = 0
    var setter = null

    Counter(props) =
        val [n, setN] = useState(0)

        renders = renders + 1
        setter = setN

        <p>{n}</p>

    val root = mount(<Counter/>)

    setter(n -> n + 1)
    setter(n -> n + 1)
    flush(root)

    assert(renders == 2)
    assert(html(root) == "<p>2</p>")

@test
useReducer_is_useState_with_the_reducer_in_front()
    var send = null

    count(state, action) = if action == "up" then state + 1 else state - 1

    Counter(props) =
        val [n, dispatch] = useReducer(count, 10)

        send = dispatch

        <p>{n}</p>

    val root = mount(<Counter/>)

    send("up")
    send("up")
    send("down")
    flush(root)

    assert(html(root) == "<p>11</p>")

@test
a_ref_survives_a_render_and_changing_it_renders_nothing()
    var renders = 0
    var box = null
    var setter = null

    Held(props) =
        val r = useRef(0)
        val [n, setN] = useState(0)

        renders = renders + 1
        box = r
        setter = setN

        <p>{n}</p>

    val root = mount(<Held/>)

    box.current = 5

    assert(renders == 1)

    setter(1)
    flush(root)

    assert(renders == 2)
    assert(box.current == 5)

@test
useMemo_recomputes_ONLY_WHEN_ITS_DEPENDENCIES_CHANGE()
    var made = 0
    var setter = null

    Memoed(props) =
        val [n, setN] = useState(0)
        val doubled = useMemo(() -> pricey(n), [n])
        val fixed = useMemo(() -> pricey(0), [])

        setter = setN

        <p>{doubled}</p>

    pricey(n) =
        made = made + 1
        n * 2

    val root = mount(<Memoed/>)

    assert(made == 2)

    setter(0)
    flush(root)

    assert(made == 2)

    setter(3)
    flush(root)

    assert(made == 3)
    assert(html(root) == "<p>6</p>")

@test
DEPENDENCIES_ARE_COMPARED_STRUCTURALLY_WHERE_REACT_COMPARES_BY_IDENTITY()
    // **A deliberate divergence, and slate's own equality is the reason.** `[1, 2] == [1, 2]` is true
    // here and false in JavaScript, so an object rebuilt with the same fields is not a change -- which
    // removes the surprising direction, recomputing when nothing changed.
    var made = 0
    var setter = null

    Rebuilt(props) =
        val [n, setN] = useState(0)
        val opts = { size: 1 }

        useMemo(() -> bump(), [opts])

        setter = setN

        <p>{n}</p>

    bump() =
        made = made + 1
        made

    val root = mount(<Rebuilt/>)

    assert(made == 1)

    setter(1)
    flush(root)

    assert(made == 1)

@test
an_effect_runs_after_the_render_and_again_when_what_it_depends_on_changes()
    var ran = []
    var setter = null

    Watched(props) =
        val [n, setN] = useState(0)

        setter = setN

        useEffect(() -> note(n), [n])

        <p>{n}</p>

    note(n) =
        push(ran, n)
        null

    val root = mount(<Watched/>)

    assert(ran == [0])

    setter(0)
    flush(root)

    assert(ran == [0])

    setter(1)
    flush(root)

    assert(ran == [0, 1])

@test
AN_EFFECT_WITH_NO_DEPENDENCIES_RUNS_AFTER_EVERY_RENDER()
    var ran = 0
    var setter = null

    Always(props) =
        val [n, setN] = useState(0)

        setter = setN

        useEffect(() -> tick())

        <p>{n}</p>

    tick() =
        ran = ran + 1
        null

    val root = mount(<Always/>)

    assert(ran == 1)

    setter(1)
    flush(root)

    assert(ran == 2)

@test
THE_CLEANUP_RUNS_BEFORE_THE_NEXT_EFFECT_AND_WHEN_THE_COMPONENT_GOES()
    // **Which is what makes an effect that subscribes to something safe to write.**
    var log = []
    var setter = null
    var showing = null

    Sub(props) =
        useEffect(() -> subscribe(props.to), [props.to])

        <p>{props.to}</p>

    subscribe(to) =
        push(log, "on " + to)

        () -> push(log, "off " + to)

    Shell(props) =
        val [state, set] = useState({ on: true, to: "a" })

        setter = set

        <div>{state.on && <Sub to={state.to}/>}</div>

    val root = mount(<Shell/>)

    assert(log == ["on a"])

    setter({ on: true, to: "b" })
    flush(root)

    assert(log == ["on a", "off a", "on b"])

    setter({ on: false, to: "b" })
    flush(root)

    assert(log == ["on a", "off a", "on b", "off b"])
    assert(html(root) == "<div></div>")
