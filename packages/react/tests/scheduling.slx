import { createElement, Fragment, mount, html, flush, useState, useEffect } from "../react.slx"

// When a change becomes a render.
//
// **A change does not render on the spot**, and that is React's batching rather than laziness: two
// setters called in one handler must be one render, or a handler could see a half-updated tree.
// `flush` is what a test uses to say "now"; a program that says nothing gets the same render one turn
// of the event loop later.

@test
async A_CHANGE_RENDERS_ON_ITS_OWN_ONE_TURN_LATER()
    var setter = null

    Counter(props) =
        val [n, setN] = useState(0)

        setter = setN

        <p>{n}</p>

    val root = mount(<Counter/>)

    setter(1)

    // Not yet -- the change is queued and the handler is still running.
    assert(html(root) == "<p>0</p>")

    await sleep(1)

    // And the loop turned, so the render happened with nobody asking for it.
    assert(html(root) == "<p>1</p>")

@test
async flush_IS_THE_SAME_RENDER_ASKED_FOR_EARLY()
    var setter = null
    var renders = 0

    Counter(props) =
        val [n, setN] = useState(0)

        renders = renders + 1
        setter = setN

        <p>{n}</p>

    val root = mount(<Counter/>)

    setter(1)
    flush(root)

    assert(renders == 2)

    // The turn that was scheduled finds nothing left to do rather than rendering a second time.
    await sleep(1)

    assert(renders == 2)
