import { createElement, Fragment, mount, html, flush, useState, useEffect, useMemo, useRef } from "../react.slx"

@test
an_element_renders_to_markup()
    val root = mount(<div class="a"><b>hi</b></div>)

    assert(html(root) == "<div class=\"a\"><b>hi</b></div>")

@test
a_component_is_a_function_of_its_props()
    Card(props) = <div class="card"><h2>{props.title}</h2>{props.children}</div>

    val root = mount(<Card title="Notes">a note</Card>)

    assert(html(root) == "<div class=\"card\"><h2>Notes</h2>a note</div>")

@test
a_fragment_has_no_tag()
    val root = mount(<><a/><b/></>)

    assert(html(root) == "<a></a><b></b>")

@test
text_is_escaped()
    val root = mount(<p>{"<script>"}</p>)

    assert(html(root) == "<p>&lt;script&gt;</p>")

@test
a_void_element_has_no_closing_tag()
    val root = mount(<div><br/><img src="x"/></div>)

    assert(html(root) == "<div><br><img src=\"x\"></div>")

@test
state_survives_a_re_render()
    var setter = null

    Counter(props) =
        val [n, setN] = useState(0)

        setter = setN

        <p>{n}</p>

    val root = mount(<Counter/>)

    assert(html(root) == "<p>0</p>")

    setter(1)
    flush(root)

    assert(html(root) == "<p>1</p>")

    setter(n -> n + 1)
    flush(root)

    assert(html(root) == "<p>2</p>")

@test
NOTHING_RENDERS_FOR_null_OR_A_BOOLEAN()
    // Which is what makes `{cond && <a/>}` the ordinary way to write a conditional child.
    val root = mount(<div>{null}{false}{true}<b/></div>)

    assert(html(root) == "<div><b></b></div>")

    val on = false

    assert(html(mount(<p>{on && <b/>}</p>)) == "<p></p>")

@test
A_COMPONENT_TAKES_ITS_PROPS_APART_WITH_DEFAULTS()
    // **This is the idiom, and the reason slate's patterns learned defaults.** It is what React code
    // is written in, and here it is better: a default fires on absence and on nothing else, where
    // JavaScript's `||` would replace a `0`, a `false` and an empty string as well.
    Card({ title = "Untitled", size = 1, children }) =
        <div class={"card s" + string(size)}><h2>{title}</h2>{children}</div>

    assert(html(mount(<Card>body</Card>)) == "<div class=\"card s1\"><h2>Untitled</h2>body</div>")
    assert(html(mount(<Card title="Notes" size={2}>body</Card>)) == "<div class=\"card s2\"><h2>Notes</h2>body</div>")

    // A prop that was given keeps what it holds, whatever that is.
    Count({ n = 10 }) = <p>{n}</p>

    assert(html(mount(<Count n={0}/>)) == "<p>0</p>")

@test
AN_UNDEFINED_CHILD_IS_REFUSED_BY_SLATE_AND_NOT_BY_THE_FRAMEWORK()
    // **A limit worth pinning rather than discovering.** An element's children travel as an array
    // literal, and slate refuses `undefined` in an array in as many words -- so `<p>{props.title}</p>`
    // faults where `title` was never passed, which is the commonest thing React code writes.
    //
    // `?? null` is what a program writes instead, and `null` renders nothing. The framework could not
    // fix this if it wanted to: the value never reaches it.
    Title(props) = <p>{props.title ?? null}</p>

    assert(html(mount(<Title/>)) == "<p></p>")
    assert(html(mount(<Title title="x"/>)) == "<p>x</p>")

@test
an_array_of_children_is_flattened()
    val rows = ["a", "b"].map(r -> <li>{r}</li>)

    assert(html(mount(<ul>{rows}</ul>)) == "<ul><li>a</li><li>b</li></ul>")

@test
A_HANDLER_AND_THE_FRAMEWORKS_OWN_PROPS_ARE_NOT_MARKUP()
    // `onClick` has nowhere to go in text, and `children` and `key` are the framework's own.
    val root = mount(<button onClick={() -> null} key="k" class="go">x</button>)

    assert(html(root) == "<button class=\"go\">x</button>")

@test
a_true_attribute_is_bare_and_a_false_one_is_absent()
    assert(html(mount(<input disabled required={false}/>)) == "<input disabled>")

@test
AN_ATTRIBUTE_VALUE_IS_ESCAPED_TOO()
    assert(html(mount(<a title={"a \" and <b>"}/>)) == "<a title=\"a &quot; and &lt;b&gt;\"></a>")

@test
a_number_child_is_text()
    assert(html(mount(<p>{42}</p>)) == "<p>42</p>")
