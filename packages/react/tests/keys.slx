import { createElement, Fragment, mount, html, flush, useState, useEffect } from "../react.slx"

// Reconciliation -- which old instance an element updates, and which it replaces.
//
// **A key is asked before a type, and that is the whole of what a key is for.** Two elements of the
// same type in the same place are the same thing unless their keys say otherwise, which is what lets
// a row keep its state when the row above it goes.

// A child that counts how many times it has been built, so that a test can tell an update from a
// replacement without looking at the markup.
val built = []

Row(props) =
    val [n, setN] = useState(0)

    useEffect(() -> note(props.name), [])

    <li>{props.name + ":" + string(n)}</li>

note(name) =
    push(built, "in " + name)

    () -> push(built, "out " + name)

@test
A_KEYED_CHILD_KEEPS_ITS_INSTANCE_WHEN_THE_ORDER_CHANGES()
    var setter = null

    List(props) =
        val [names, set] = useState(["a", "b", "c"])

        setter = set

        <ul>{names.map(name -> <Row key={name} name={name}/>)}</ul>

    val root = mount(<List/>)

    assert(built == ["in a", "in b", "in c"])
    assert(html(root) == "<ul><li>a:0</li><li>b:0</li><li>c:0</li></ul>")

    // Reversed, and nothing is torn down or built -- every row was found by its key.
    setter(["c", "b", "a"])
    flush(root)

    assert(built == ["in a", "in b", "in c"])
    assert(html(root) == "<ul><li>c:0</li><li>b:0</li><li>a:0</li></ul>")

@test
A_KEYED_CHILD_THAT_GOES_IS_THE_ONLY_ONE_TORN_DOWN()
    var setter = null

    clear(built)

    List(props) =
        val [names, set] = useState(["a", "b", "c"])

        setter = set

        <ul>{names.map(name -> <Row key={name} name={name}/>)}</ul>

    val root = mount(<List/>)

    assert(built == ["in a", "in b", "in c"])

    setter(["a", "c"])
    flush(root)

    // Only `b`, and the other two were never rebuilt.
    assert(built == ["in a", "in b", "in c", "out b"])
    assert(html(root) == "<ul><li>a:0</li><li>c:0</li></ul>")

@test
A_ROW_INSERTED_AT_THE_FRONT_BUILDS_ONLY_ITSELF()
    var setter = null

    clear(built)

    List(props) =
        val [names, set] = useState(["b"])

        setter = set

        <ul>{names.map(name -> <Row key={name} name={name}/>)}</ul>

    val root = mount(<List/>)

    setter(["a", "b"])
    flush(root)

    assert(built == ["in b", "in a"])

@test
UNKEYED_CHILDREN_ARE_MATCHED_BY_POSITION()
    // **Which is why a list without keys loses state when it is reordered**, and is the reason React
    // asks for them. The framework does not warn; the behaviour is the argument.
    var setter = null

    clear(built)

    List(props) =
        val [names, set] = useState(["a", "b"])

        setter = set

        <ul>{names.map(name -> <Row name={name}/>)}</ul>

    val root = mount(<List/>)

    setter(["b", "a"])
    flush(root)

    // Nothing was rebuilt -- each position was updated with the other's props.
    assert(built == ["in a", "in b"])
    assert(html(root) == "<ul><li>b:0</li><li>a:0</li></ul>")

@test
AN_ELEMENT_OF_A_DIFFERENT_TYPE_IS_REPLACED_AND_ITS_STATE_GOES()
    var setter = null

    Held(props) =
        val [n, setN] = useState(props.start)

        <b>{n}</b>

    Shell(props) =
        val [which, set] = useState("b")

        setter = set

        <div>{if which == "b" then <Held start={1}/> else <i>gone</i>}</div>

    val root = mount(<Shell/>)

    assert(html(root) == "<div><b>1</b></div>")

    setter("i")
    flush(root)

    assert(html(root) == "<div><i>gone</i></div>")

@test
A_NESTED_COMPONENTS_STATE_SURVIVES_ITS_PARENT_RE_RENDERING()
    var bump = null
    var setInner = null

    Inner(props) =
        val [n, setN] = useState(0)

        setInner = setN

        <b>{n}</b>

    Outer(props) =
        val [times, set] = useState(0)

        bump = set

        <div class={"t" + string(times)}><Inner/></div>

    val root = mount(<Outer/>)

    setInner(7)
    flush(root)

    assert(html(root) == "<div class=\"t0\"><b>7</b></div>")

    bump(1)
    flush(root)

    assert(html(root) == "<div class=\"t1\"><b>7</b></div>")

clear(xs) =
    loop
        if xs.len() == 0 then break

        removeAt(xs, 0)
