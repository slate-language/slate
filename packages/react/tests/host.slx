import { createElement, Fragment, mount, html, flush, stringHost, useState } from "../react.slx"

// The host adapter -- the seam a DOM renderer stands on.
//
// **These are the two functions the string host cannot demonstrate**, because for a string host both
// are nothing: `html` walks the tree afresh whenever it is asked, so it never needs telling that the
// top of the tree changed, and a node it drops is an ordinary object the collector takes. A DOM host
// needs both, and a recording host is how the contract is pinned without a document.
//
// The whole of the argument for the adapter is that one set of components renders in two places. A
// contract that only the string host is checked against is a contract with one implementation.

// A host that answers everything the string host does and writes down what it was asked. `into` is
// the list of top-level nodes it was last handed; `dropped` counts the nodes given back.
recorder() =
    val seen = { mounts: 0, into: [], dropped: 0 }
    val inner = stringHost()

    dropped(node) =
        seen.dropped = seen.dropped + 1

        null

    mounted(nodes) =
        seen.mounts = seen.mounts + 1
        seen.into = nodes

        null

    val host = inner with { drop: dropped, mounted: mounted, seen: seen }

    host

@test
THE_HOST_IS_HANDED_THE_TOP_OF_THE_TREE_WHEN_THE_TREE_IS_MOUNTED()
    val host = recorder()

    mount(<p>hello</p>, host)

    assert(host.seen.mounts == 1)
    assert(host.seen.into.len() == 1)

@test
IT_IS_HANDED_THEM_AGAIN_ON_EVERY_COMMIT_AND_NOT_ONLY_THE_FIRST()
    // **This is the one a DOM host would be broken without.** A component at the very top has no
    // host node above it, so when it renders a different set of nodes the reconciler has nobody to
    // tell -- and a page would keep showing an element the program had stopped rendering.
    var setter = null
    val host = recorder()

    App(props) =
        val [shown, setShown] = useState(true)

        setter = setShown

        <>
            <p>always</p>
            {shown && <p>sometimes</p>}
        </>

    val root = mount(<App/>, host)

    assert(host.seen.mounts == 1)
    assert(host.seen.into.len() == 2)

    setter(false)
    flush(root)

    assert(host.seen.mounts == 2)
    assert(host.seen.into.len() == 1)

@test
A_NODE_THE_FRAMEWORK_DROPS_IS_GIVEN_BACK_TO_THE_HOST()
    // A DOM host hands out a handle into a table it keeps, so a node nobody tells it about is a slot
    // held for the life of the page. Nothing on screen would show the difference, which is why it is
    // asserted here or nowhere.
    var setter = null
    val host = recorder()

    App(props) =
        val [shown, setShown] = useState(true)

        setter = setShown

        <div>{shown && <p>here</p>}</div>

    val root = mount(<App/>, host)

    assert(host.seen.dropped == 0)

    setter(false)
    flush(root)

    // The `<p>` and the text inside it: two nodes, both given back.
    assert(host.seen.dropped == 2)

@test
A_HOST_THAT_IS_NOT_GIVEN_IS_THE_STRING_HOST()
    // The default, said out loud, because every other test here passes a host and would not notice
    // if the default had stopped being one.
    assert(html(mount(<p>hi</p>)) == "<p>hi</p>")
