module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// The React framework under `packages/react/`, whose own tests are written in slate.
//
// **The framework is slate code and its tests are slate tests**, run through `slate test` the way
// anybody using the package would run their own. Writing them in sysl would mean a second copy of
// every program as an escaped string, and would test the framework through a harness nobody else
// uses.
//
// **This is the one sysl test that makes them part of the suite.** Without it `sysl test .` is green
// while every one of them is failing, which is the failure mode `every_example_runs_with_nothing_to_report`
// exists for on the other side of the tree.

@test
THE_REACT_PACKAGES_OWN_TESTS_ALL_PASS()
    assert_eq(cli_status(["slate", "test", "packages/react/tests"]), 0)

@test
EVERY_ONE_OF_THE_REACT_TEST_FILES_IS_ACTUALLY_RUN()
    // **A file that stops being picked up is silent**, and a green run of three files out of four
    // says nothing about the fourth. Naming them here is what makes that loud -- the same lesson the
    // examples walk was rewritten for.
    val said = cli_said(["slate", "test", "packages/react/tests"])

    assert(said.contains("elements.slx"))
    assert(said.contains("hooks.slx"))
    assert(said.contains("keys.slx"))
    assert(said.contains("scheduling.slx"))
    assert(!said.contains("failed"))
