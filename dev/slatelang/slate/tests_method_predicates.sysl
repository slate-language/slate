module dev.slatelang.slate
@tests

import sysl.text.Search

// A METHOD THAT IS A PREDICATE NARROWS AT ITS CALL, AND `this is T` NARROWS THE RECEIVER
// (`receiver.sysl`). Every narrowing is paired with a refusal of the same program where nothing
// narrows, so a test that passed because nothing was checked could not pass here.

// A data type whose members test the receiver: one inferred, one explicit, one an assertion.
val MethodShapes: string = "data Shape\n    Circle(r: real)\n    Square(side: real)\n\n    isCircle(self) = self is Circle\n    isSquare(self) -> this is Square =\n        val yes = self is Square\n        yes\n    ensureCircle(self) -> asserts this is Circle =\n        if !(self is Circle) then throw \"not a circle\"\n\nradius(c: Circle) = c.r\nside(q: Square) = q.side\npick(round: boolean) -> Shape = if round then Circle(1.5) else Square(2.5)\n"

val MethodNotCircle: string = "`radius` takes Circle here, and this is Shape"

// A class whose members test an argument: one explicit, one inferred.
val MethodCheckers: string = "type Box = { size: integer }\nclass Checker\n    var seen = 0\n\n    isBox(self, v: Box | string) -> v is Box =\n        if !(v is object) then return false\n        v.size is integer\n    present(self, m: object | null) = m != null\n    ensureBox(self, v: Box | string) -> asserts v is Box =\n        if !(v is object) then throw \"not a box\"\n\nneed(b: Box) = b.size\nval c = Checker()\n"

val MethodNotBox: string = "`need` takes { size: integer } here, and this is { size: integer } | string"

// -- `this` ------------------------------------------------------------------------------------------

@test
AN_INFERRED_METHOD_PREDICATE_NARROWS_ITS_RECEIVER()
    assert_eq(out(MethodShapes + "f(s: Shape) = if s.isCircle() then radius(s) else 0.5\nprint(f(Circle(1.5)), f(Square(2.5)))"), "1.5 0.5")

    // The control: with no test, the receiver is only a `Shape`.
    assert(fails(MethodShapes + "f(s: Shape) = if 1 == 1 then radius(s) else 0.5\nprint(f(Circle(1.5)))").contains(MethodNotCircle))

@test
A_CLAIM_THAT_this_IS_T_NARROWS_THE_RECEIVER_ON_BOTH_SIDES()
    assert_eq(out(MethodShapes + "g(s: Circle | Square) = if s.isSquare() then side(s) else radius(s)\nprint(g(Square(2.5)), g(Circle(1.5)))"), "2.5 1.5")

    // The inferred one too, through `!`.
    assert_eq(out(MethodShapes + "g(s: Circle | Square) = if !s.isCircle() then side(s) else radius(s)\nprint(g(Square(2.5)), g(Circle(1.5)))"), "2.5 1.5")

    // The control: the else side of a `Shape` has no alternative to take away.
    assert(fails(MethodShapes + "g(s: Circle | Square) = if 1 == 1 then side(s) else radius(s)\nprint(g(Square(2.5)))").contains("`side` takes Square here, and this is Circle | Square"))

@test
AN_ASSERTION_ABOUT_this_NARROWS_THE_LINES_BELOW_IT_AND_assert_DOES_TOO()
    assert_eq(out(MethodShapes + "h(s: Shape)\n    s.ensureCircle()\n    radius(s)\nprint(h(Circle(1.5)))"), "1.5")
    assert_eq(out(MethodShapes + "h(s: Shape)\n    assert(s.isCircle())\n    radius(s)\nprint(h(Circle(1.5)))"), "1.5")

    // Used as a value it proves nothing.
    assert(fails(MethodShapes + "h(s: Shape) = if s.ensureCircle() then radius(s) else 0.5\nprint(h(Circle(1.5)))").contains(MethodNotCircle))

    // Nothing checks the claim but the body: a receiver that is not one throws what the body throws.
    assert(fails(MethodShapes + "Square(2.5).ensureCircle()").contains("not a circle"))

@test
A_RECEIVER_THAT_IS_A_PATH_NARROWS_AS_A_PATH_AND_A_CALL_ENDS_AN_EARLIER_ONE()
    val held = MethodShapes + "val o = { a: pick(true), b: pick(false) }\n"

    assert_eq(out(held + "print(if o.a.isCircle() then radius(o.a) else 0.5)"), "1.5")
    assert_eq(out(held + "print(if o.a is Circle && o.b.isSquare() then side(o.b) else 0.5)"), "2.5")

    // `o.a` was narrowed before the call to `o.b.isSquare()`, and the call ends it.
    assert(fails(held + "print(if o.a is Circle && o.b.isSquare() then radius(o.a) else 0.5)").contains(MethodNotCircle))

@test
A_CLAIM_ABOUT_this_IS_HELD_TO_THE_RECEIVERS_CLASS()
    assert(fails("data Shape\n    Circle(r: real)\n\n    isText(self) -> this is string = false\n").contains("`this` is the `Shape` the method was called on, and string is not one, so `this is string` could never be true"))
    assert(fails("class Pen\n    var ink = 0\n\n    isText(self) -> this is string = false\n").contains("`this` is the `Pen` the method was called on, and string is not one"))

    // By the parameter's own name, too.
    assert(fails("class Pen\n    var ink = 0\n\n    isText(self) -> self is integer = false\n").contains("`self` is the `Pen` the method was called on, and integer is not one"))

    // What the class may be is accepted: a variant of the data type, another class, an object shape.
    assert_eq(out("class Pen\n    var ink = 0\n\n    isPen(self) -> this is Pen = true\n    inked(self) -> this is { ink: integer } = true\nprint(Pen().isPen(), Pen().inked())"), "true true")

@test
A_CLAIM_ABOUT_this_ON_SOMETHING_THAT_IS_NOT_A_METHOD_IS_REFUSED()
    assert(fails("isText(v) -> this is string = v is string").contains("`this` is the object a method was called on, and `isText` is not a method"))
    assert(fails("class Pen\n    var ink = 0\n\n    isPen() -> this is Pen = true\n").contains("`isPen` takes no parameters, so it has nowhere to receive `this`"))

@test
A_METHOD_PREDICATE_THAT_ANSWERS_SOMETHING_OTHER_THAN_A_BOOLEAN_IS_REFUSED()
    assert(fails("data Shape\n    Circle(r: real)\n\n    isCircle(self) -> this is Circle = \"yes\"\n").contains("`isCircle` is a type predicate (`-> this is Circle`), so every way out of it answers a boolean, and this one answers string"))

// -- arguments ---------------------------------------------------------------------------------------

@test
A_METHOD_PREDICATE_NARROWS_ITS_ARGUMENTS_INFERRED_OR_EXPLICIT()
    assert_eq(out(MethodCheckers + "f(v: Box | string) = if c.isBox(v) then need(v) else v.length\nprint(f({ size: 3 }), f(\"ab\"))"), "3 2")
    assert_eq(out(MethodCheckers + "f(m: object | null) = if c.present(m) then keys(m).length else 0\nprint(f({ a: 1 }), f(null))"), "1 0")
    assert_eq(out(MethodCheckers + "f(v: Box | string)\n    c.ensureBox(v)\n    need(v)\nprint(f({ size: 4 }))"), "4")
    assert_eq(out(MethodCheckers + "f(v: Box | string)\n    assert(c.isBox(v))\n    need(v)\nprint(f({ size: 5 }))"), "5")
    assert_eq(out(MethodCheckers + "f(v: Box | string, m: object | null) = if c.isBox(v) && c.present(m) then need(v) + keys(m).length else 0\nprint(f({ size: 1 }, { a: 1 }))"), "2")

    // The control: a plain call narrows nothing.
    assert(fails(MethodCheckers + "f(v: Box | string) = if c.seen == 0 then need(v) else 0\nprint(f(\"x\"))").contains(MethodNotBox))

@test
AN_INHERITED_METHOD_IS_FOUND_UP_THE_CHAIN()
    val sub = MethodCheckers + "class Strict from Checker\n    var level = 1\nval s = Strict()\n"

    assert_eq(out(sub + "f(v: Box | string) = if s.isBox(v) then need(v) else v.length\nprint(f({ size: 3 }), f(\"ab\"))"), "3 2")

@test
AN_OVERRIDE_IS_READ_WHERE_THE_RECEIVER_IS_KNOWN_TO_BE_THE_SUBCLASS()
    // With a predicate of its own, the subclass's is the one read.
    val own = MethodCheckers + "class Loose from Checker\n    var level = 1\n\n    isBox(self, v: Box | string) -> v is string = v is string\nval l = Loose()\n"

    assert_eq(out(own + "f(v: Box | string) = if l.isBox(v) then v.length else need(v)\nprint(f(\"abc\"), f({ size: 4 }))"), "3 4")

    // With none, nothing narrows: the base's predicate is not the method a `Plain` runs.
    val plain = MethodCheckers + "class Plain from Checker\n    var level = 1\n\n    isBox(self, v) = true\nval p = Plain()\n"

    assert(fails(plain + "f(v: Box | string) = if p.isBox(v) then need(v) else 0\nprint(f(\"x\"))").contains(MethodNotBox))

@test
A_RECEIVER_OF_UNKNOWN_TYPE_NARROWS_NOTHING()
    assert(fails(MethodCheckers + "f(x, v: Box | string) = if x.isBox(v) then need(v) else 0\nprint(f(c, \"x\"))").contains(MethodNotBox))
    assert(fails(MethodShapes + "f(x, s: Shape) = if x.isCircle() then radius(s) else 0.5\nprint(f(Circle(1.5), Circle(1.5)))").contains(MethodNotCircle))

    // A `?.` call is not one the checker can name.
    assert(fails(MethodCheckers + "f(v: Box | string) = if c?.isBox(v) then need(v) else 0\nprint(f(\"x\"))").contains(MethodNotBox))

@test
AN_IMPORTED_CLASS_AND_DATA_TYPE_CARRY_THEIR_METHOD_PREDICATES()
    assert_eq(ran_out("tests/mods/method_uses.sl"), "1.5 0.5 2.5 3 2")

// -- both hosts --------------------------------------------------------------------------------------

@test
BOTH_BACK_ENDS_RUN_A_PROGRAM_NARROWED_BY_METHOD_PREDICATES_TO_THE_SAME_ANSWER()
    val program = MethodShapes + "f(s: Shape) = if s.isCircle() then radius(s) else 0.5\ng(s: Circle | Square) = if s.isSquare() then side(s) else radius(s)\nh(s: Shape)\n    s.ensureCircle()\n    radius(s)\nprint(f(Circle(1.5)), f(Square(2.5)), g(Square(2.5)), h(Circle(1.5)))"

    assert_eq(out(program), "1.5 0.5 2.5 1.5")
    assert_eq(node_said(program), "1.5 0.5 2.5 1.5")
