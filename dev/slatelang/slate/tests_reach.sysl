module dev.slatelang.slate
@tests

import sysl.text.Search

// What a default may read: the bindings to its left, and none to its right or itself.
//
// **The two back ends used to disagree about exactly this**, which is why it is refused rather than
// defined: `early(a = t(b), b = 2)` called `early(b = 3)` answered 3 in the interpreter, the named
// argument having been laid before the default ran, and threw `ReferenceError: Cannot access 'b'
// before initialization` under `slate js`. The refusal is the checker's, which both back ends run,
// so each case is asked of both -- `fails` running the interpreter and `js` emitting the module.

private const Right: string = "the default of `a` reads `b`, which is to its right -- a default sees only the parameters before it"
private const Itself: string = "the default of `a` reads `a` itself -- a default sees only the parameters before it"
private const PatRight: string = "the default of `p` reads `q`, which is to its right -- a default sees only the names before it"

// The refusal from both back ends, each required to carry `said`.
private refused_by_both(program: string, said: string)
    val here = fails(program)
    val there = js(program)

    assert(here.contains(said), s"the interpreter said: ${here}")
    assert(there.contains(said), s"the JavaScript back end said: ${there}")
end refused_by_both

@test
A_DEFAULT_THAT_READS_A_PARAMETER_TO_ITS_RIGHT_IS_REFUSED_ON_BOTH_BACK_ENDS()
    refused_by_both("t(a) = a\nearly(a = t(b), b = 2) = a\nprint(early(b = 3))", Right)

@test
A_DEFAULT_THAT_READS_ITS_OWN_PARAMETER_IS_REFUSED()
    refused_by_both("f(a = a) = a\nprint(f(1))", Itself)

@test
A_LAMBDA_INSIDE_A_DEFAULT_MAY_NOT_READ_A_PARAMETER_TO_ITS_RIGHT_EITHER()
    // Nothing says when the lambda runs, so it is refused wherever it is written in the default.
    refused_by_both("f(a = () -> b, b = 2) = a()\nprint(f())", Right)

@test
A_LAMBDA_DEFAULT_INSIDE_A_DEFAULT_IS_HELD_TO_THE_OUTER_RULE_TOO()
    refused_by_both("f(a = (x = b) -> x, b = 2) = a()\nprint(f())", Right)

@test
A_DEFAULT_MAY_NOT_READ_THE_REST_PARAMETER_AFTER_IT()
    refused_by_both("f(a = xs, ...xs) = a\nprint(f())", "the default of `a` reads `xs`, which is to its right")

@test
A_DEFAULT_THAT_CALLS_A_PARAMETER_TO_ITS_RIGHT_IS_REFUSED()
    refused_by_both("t(v) = v\nf(a = b(1), b = t) = a\nprint(f())", Right)

@test
A_DEFAULT_MAY_READ_THE_PARAMETERS_TO_ITS_LEFT_A_GLOBAL_AND_ITS_OWN_LAMBDAS_NAMES()
    // The lambda's own `b` shadows the parameter to its right, exactly as a read of it would.
    val program = "val g = 10\nf(x, y = x + 1, z = g, w = ((b) -> b)(5), b = 2) = [x, y, z, w, b]\nprint(f(1))\nprint(f(1, b = 9))"

    assert_eq(out(program), "[1, 2, 10, 5, 2]\n[1, 2, 10, 5, 9]")
    assert(!js(program).contains("default of"))

@test
A_NAMED_CALL_SKIPPING_A_DEFAULT_THAT_READS_TO_ITS_LEFT_WORKS()
    assert_eq(out("early(a = 1, b = a + 1) = [a, b]\nprint(early(b = 3))\nprint(early(a = 4))"), "[1, 3]\n[4, 5]")

@test
A_PATTERN_DEFAULT_THAT_READS_A_NAME_TO_ITS_RIGHT_IS_REFUSED_ON_BOTH_BACK_ENDS()
    refused_by_both("val { p = q, q = 1 } = { q: 7 }\nprint(p)", PatRight)
    refused_by_both("val [p = q, q = 2] = []\nprint(p)", PatRight)
    refused_by_both("for { p = q, q = 0 } in [{ q: 1 }]\n    print(p)", PatRight)
    refused_by_both("f({ p = q, q = 0 }) = p\nprint(f({}))", PatRight)

@test
A_PATTERN_DEFAULT_THAT_READS_ITS_OWN_NAME_IS_REFUSED()
    refused_by_both("val { p = p } = {}\nprint(p)", "the default of `p` reads `p` itself -- a default sees only the names before it")

@test
A_PATTERN_DEFAULT_MAY_READ_THE_NAMES_TO_ITS_LEFT()
    assert_eq(out("val { a = 1, b = a + 1 } = {}\nprint(a, b)\nval { c, d = c * 2 } = { c: 5 }\nprint(c, d)"), "1 2\n5 10")

@test
A_PATTERN_DEFAULT_NAMING_NOTHING_IS_CAUGHT_WHERE_IT_IS_WRITTEN()
    // The checker walks a pattern's defaults now, so a misspelt name is refused before anything runs
    // rather than on the day a value arrives without the field.
    assert(fails("val { a = nope } = { a: 1 }\nprint(a)").contains("`nope` is not defined"))
