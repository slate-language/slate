module dev.slatelang.slate

import sh.sysl.parsing.{Source, source}
import sysl.buf.{Buf}
import sysl.fs.{read_bytes}

// Running one program the way `slate <file>` does: from a path, or from text already in hand. Not
// `main.sysl`, because three doors reach it -- the command line, a script, and the C API in `embed.sysl`.

// Not `private`: `script.sysl` runs a `.sl` file script through it, a script that names a file being
// the same thing as a file named on the command line.
run_program(exec: string, path: string, script_args: Buf[string], say: string -> unit) -> int
    read_bytes(path) match
        Err(e) ->
            say(s"slate: cannot read ${path}: ${e}")

            Failed
        Ok(bytes) -> run_bytes(exec, path, bytes, script_args, say, say)
end run_program

// A program's text, run the way `slate <file>` runs one. Not `private`: `embed.sysl` hands it text a
// C caller supplied, which is the same run with the file already read.
//
// **Two sinks, because what the program prints and what slate complains of are two audiences.** From
// the command line they are one -- both go to the terminal -- so `run_program` passes `say` twice.
// An embedder wants the program's output where the program sent it and the diagnostic in its own
// hands, which is the whole reason `complain` is a separate parameter rather than a flag.
run_bytes(exec: string, path: string, bytes: []const u8, script_args: Buf[string], say: string -> unit,
          complain: string -> unit) -> int =
    ran_bytes(exec, path, bytes, script_args, say, complain, src -> run(src))

// The same run, with what running the text MEANS handed in: `run` for a whole program, and a
// session's `add_program` for `slate_eval` in `embed.sysl`. **Everything around the run -- the
// arguments, the live sink, the profile, the status -- is this one function**, so an embedded call
// and a command-line run cannot drift about any of it.
ran_bytes(exec: string, path: string, bytes: []const u8, script_args: Buf[string], say: string -> unit,
          complain: string -> unit, go: Source -> Ran) -> int
    val src = source(path, bytes)

    // **Set before the run and not during it.** `install_builtins` declares `args` from this,
    // so a program whose arguments arrived later would see the empty array declared first.
    set_program_args(script_args)

    // **What it would take to run this again**, which is what a supervisor spawning a copy
    // of the program it is inside needs and cannot work out for itself: `args[0]` is the
    // first argument a PERSON typed, deliberately, so the executable's own name is not in
    // anything a program can read.
    set_program_command(exec, path)

    // **Live, not replayed**: a program run from the command line may never return -- a
    // server, a supervisor -- so `print` has to reach `say` as each call happens rather than
    // waiting here for `run` to answer and handing the whole of `r.output` over at once.
    // `do_print` in `builtin.sysl` reads `live_output` and `live_sink` to make that choice;
    // both are put back after the run so a later call into the interpreter in this same
    // process -- `slate test`, a doc example -- goes back to answering rather than narrating,
    // and so a `say` that captures into a test's own buffer is what a live `print` reaches
    // rather than the real descriptor.
    current().live_output = true
    current().live_sink = say

    // **`SLATE_PROFILE` and not a flag, and the paragraph above is the reason**: every word
    // after a program's name belongs to the program, so there is no flag slate could take
    // here without taking one from a script. The report goes to STDERR, which leaves what
    // the program printed exactly as it was -- a profiled run can still be diffed against
    // its own expected output, which is what `bench/check.sh` does.
    val profiling_asked = asked_to_profile()

    if profiling_asked then profile_start()

    val r = go(src)

    if profiling_asked
        profile_stop()
        eprints(profile_report())

    current().live_output = false
    current().live_sink = no_live_sink

    // **`r.render()` and not `r.report.render(src)`**: a program is as many files as it
    // imports, and each complaint has to be drawn against the one it is about.
    if !r.ok()
        complain(r.render())

        return Failed
    end if

    // **The program's own status, where it asked for one.** `r.status` is zero unless the
    // program called `exit`, so an ordinary run still leaves through `Fine` -- and a script
    // that exits 1 is told apart from slate itself failing only by which of them said so,
    // which is the same ambiguity every interpreter has and is not worth a third code.
    int(r.status)
end ran_bytes
