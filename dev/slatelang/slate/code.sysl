module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// What the compiler emits and the machine runs.
//
// **The tree-walker is being replaced because of `await`, and for no other reason.** A callback runs
// from an event loop, never from the middle of an expression, so callbacks and promises need nothing
// new. `await` has to suspend *inside* an expression, and a tree-walker's state is the sysl call
// stack, which cannot be captured. So the state moves onto a heap of slate's own, where a suspension
// is nothing more grand than declining to run a frame for a while.
//
// **The collector gets simpler, which was not the reason but is the larger gain.** `alloc` never
// collects, so a value held in a sysl local is invisible to the mark phase -- which is why the
// tree-walker carries a shadow stack of `hold`/`release` pairs, and why a missed one shows up as a
// rare crash rather than a failing test. A machine keeps its values in an operand stack that is an
// ordinary array, so the tracer walks it and the whole class of mistake goes away.
//
// **What is deliberately NOT compiled is a pattern.** `match_pattern` already exists, is tested, and
// is not on any hot path, so an arm's pattern is one instruction carrying an index into a table. The
// same goes for arithmetic and for calling: `binary` and `apply` are called by the machine exactly as
// the walker called them. A rewrite that reimplements settled semantics is a rewrite that changes
// them by accident.

// One instruction.
//
// **The operand stack is where everything happens**, so most of these say only what to do; the values
// they do it to are already on top.
enum Op
    // -- constants --
    PushNull
    PushUndefined
    PushBool(v: bool)
    PushInt(v: long)
    PushReal(v: real)

    // The text lives in the unit's string table, so an instruction stays a fixed-size thing with no
    // reference-counted member in it.
    PushStr(k: usize)

    // The value a `type` declaration binds -- the pattern at `pk` and the name at `k`, both indices
    // into the unit, so this stays a fixed-size instruction like every other constant.
    //
    // **It is an instruction rather than a constant folded in at compile time because a shape
    // captures the scope it was declared in**, which only exists while the module runs.
    PushShape(pk: usize, k: usize)

    // -- names --
    //
    // **Names are still looked up in the scope chain rather than in numbered slots.** Slot-indexing
    // locals is the obvious next optimisation and is deliberately not done here: this rewrite has to
    // preserve behaviour exactly, and resolving names at compile time changes when a mistake is
    // reported.
    LoadName(k: usize)
    DeclareVal(k: usize)
    DeclareVar(k: usize)
    StoreName(k: usize)

    // -- names the compiler resolved --
    //
    // **A slot is a cell of the OPERAND STACK, below the frame's working area.** A chunk that wants
    // any reserves them at entry, so `base` is where they start and `Ret`'s truncate back to `base`
    // is what frees them. Three things come out of that and each is a reason it is done this way:
    // the collector already walks the stack, so a slot is traced without the mark phase learning
    // about a new kind of thing; a coroutine and a generator run on a machine with a stack of their
    // own, so their slots suspend with them and nothing writes them down; and a `Handler` already
    // records a stack height to cut back to.
    //
    // **A name gets a slot only where NOTHING OUTSIDE THE CHUNK CAN SEE IT.** A closure captures the
    // scope chain by pointer, so an enclosing frame and a closure made inside it share the very same
    // `EnvObj` and see each other's writes -- which is what a cell would have to provide, already
    // provided. So a chunk holding any nested function keeps every name in the chain, and a module's
    // names are never slotted at all: an import is a load per export, so they are read by name from
    // outside.
    //
    // **A name the compiler cannot resolve keeps `LoadName` and faults at run time exactly as
    // before**, so nothing is refused earlier than it was and the checker's rule -- report only what
    // the machine would also refuse -- is untouched.
    LoadSlot(i: usize)
    DeclareSlot(i: usize)
    StoreSlot(i: usize)

    // A write to a slot holding a `val`. **The checker refuses this before the machine ever runs**,
    // and it is emitted anyway so that the one path where it does not -- a write the checker could
    // not see -- says the sentence it has always said rather than "not defined".
    ImmutableSlot(k: usize)

    // `val n: integer = v` where `n` is a slot. **The annotation is checked where the value arrives**
    // exactly as `CheckType` checks it, and the only difference is where the value is read from --
    // which is the whole of what a slot changes.
    CheckSlot(i: usize, k: usize, t: usize, pk: usize)

    // -- operators, run by the same code the walker ran --
    UnaryOp(op: Tok)
    BinaryOp(op: Tok)

    // -- containers --
    MakeArray(n: usize)

    // Takes `n` key/value pairs from the stack, keys first in each pair.
    MakeObject(n: usize)

    // Closes the object on top of the stack to writing, leaving it where it stood.
    //
    // **Only a `data` variant's constructor emits one.** A data value does not change, which is what
    // makes it safe to compare by what it holds and to use as a key in a table.
    SealData

    GetIndex
    SetIndex
    GetField(k: usize)
    SetField(k: usize)

    // -- control --
    Jump(to: usize)
    JumpIfFalse(to: usize)

    // **The short-circuit pair leave the operand that decided.** `a || b` answers `a` when `a` is
    // truthy, which is slate's rule and not sysl's -- so these jump without popping.
    // `??`. Keeps the left operand and skips the right unless the left is null or absent.
    JumpIfPresentKeep(to: usize)

    // The inverse, which `?.` needs: jump where the value on top IS `null` or `undefined`, keeping
    // it for the arm on the other side to drop.
    JumpIfAbsentKeep(to: usize)

    JumpIfTrueKeep(to: usize)
    JumpIfFalseKeep(to: usize)

    Pop

    // `Pop`, for the value of a statement nobody asked for. **A separate opcode because only this one
    // means "discarded"** -- the stack is popped for a dozen reasons, and a duplicate popped off the
    // top of a compound assignment is not a value the program threw away.
    Discard

    Dup

    // Push a copy of the value `n` places below the top. `DupAt(0)` is `Dup`, which is kept as its
    // own instruction because it is by far the commonest.
    //
    // **This and `RotUp` are what a compound assignment needs.** `xs[i] += 1` must evaluate `xs` and
    // `i` once and then reach them twice -- to read the old value and to write the new one -- and a
    // stack machine has no other way to say that.
    DupAt(n: usize)

    // Move the top value down `n` places, so that `[a, b, c]` with `n` of two becomes `[c, a, b]`.
    // What needs it is `x++`, which has to leave the OLD value where the new one was computed.
    RotUp(n: usize)

    // -- scopes --
    //
    // A block gets one, and so does each turn of a loop: a closure made inside a loop body captures
    // that turn's scope and not the one before it.
    PushScope
    PopScope

    // -- functions --
    //
    // `f(a, b = 2)` -- jump where `b` was given, and otherwise fall through to the instructions that
    // work the default out and bind it.
    //
    // **The test is whether the name is bound in the call's OWN scope, which is what "was given"
    // means here.** A missing argument is not bound to anything: slate's `undefined` may not be
    // stored, so there is no value to bind and none to compare against -- the parameter simply is
    // not there. Looking outward through the chain would find a global of the same name and decide
    // the argument had been given.
    JumpIfBound(k: usize, to: usize)

    // The same question asked of a chunk whose parameters are slots: jump where parameter `n`
    // arrived, and otherwise fall through to the default.
    //
    // **A slot has no way to be absent, so the frame carries a BITMASK of which parameters arrived**
    // and this tests one bit of it. The alternative -- an "unset" `Value` sitting in the slot -- is
    // refused on purpose: a sentinel is a thing that leaks into a program the one time the analysis
    // is wrong, and it would put a check on the front of every `LoadSlot` to catch it.
    //
    // **And a COUNT would have been wrong**, which is not obvious until you look at what a named
    // argument does. `arrange_named` builds its list with a hole in the MIDDLE -- `f(a, b = 1,
    // c = 2)` called `f(1, c: 5)` gives nothing for `b` and a value for `c` -- so "how many arrived"
    // cannot answer "did this one". One bit per parameter is the question actually being asked.
    JumpIfGiven(n: usize, to: usize)

    MakeClosure(chunk: usize)

    // A named function, which is a `val` holding a closure and is kept apart from one only so that
    // the name is in scope inside the body -- which is what makes it recursive.
    DefineFn(k: usize, chunk: usize)

    // **`names` IS AN INDEX INTO `arg_names`, AND ZERO MEANS EVERY ARGUMENT WAS POSITIONAL.** A
    // named argument cannot be placed while compiling -- which parameter `b = 1` fills is a question
    // about the callee, and the callee is a value nobody knows until the call happens -- so the
    // names travel in the instruction and `arrange_named` places them against the parameters the
    // function turned out to have.
    CallFn(argc: usize, names: usize)

    // `o.m(a)` -- look the name up on the object, and hand the object over where it came from a
    // proto.
    //
    // **A single instruction because the receiver rule needs both halves at once.** A `GetField`
    // followed by a `CallFn` has forgotten, by the time it calls, whether the function it is holding
    // was the object's own or a shared one delegated to -- and that is exactly the question that
    // decides whether an object is passed. `o.m` on its own still compiles to a plain `GetField`,
    // which hands back the bare function: taking a method off an object and calling it later is
    // allowed, and what you get is what you took.
    CallMethod(k: usize, argc: usize, names: usize)

    // `f(...xs)` and `o.m(...xs)` -- a call whose arguments were worked out while running.
    //
    // **The arguments arrive as one array rather than as a count**, which is the whole of what makes
    // them dynamic: `CallFn` carries how many there are in the instruction, and the number is not
    // known until the spread's array is in hand. `JoinArrays` is what builds it, so an argument list
    // may mix written arguments with spread ones in any order.
    CallSpread
    CallMethodSpread(k: usize)

    // Take the top `n` arrays and make one of them, which is how a spread argument list is built.
    //
    // **Anything that is not an array is refused here**, and the message names the spread rather
    // than the call -- `f(...42)` is a mistake about what may be spread, not about what `f` takes.
    JoinArrays(n: usize)
    Ret

    // -- suspension --
    //
    // **The instruction the whole machine exists for.** It takes the promise on top of the stack,
    // writes the frame it is standing in back so that there is something to come back to, and sets
    // the entire line of execution aside -- operand stack, frames, scope and all -- into `parked`.
    // The value it answers is written over the promise when the loop puts the machine back.
    Await

    // `yield e` -- hand the value on the stack to whoever is driving this generator, and stand still.
    //
    // **It does NOT pop, exactly as `Await` does not.** The yielded value stays in its slot while the
    // machine is set aside -- which is what keeps it reachable, the machine's stack being a root the
    // tracer already walks -- and the value the driver sends in is written over that same slot.
    Yield

    // Render the top `n` values as `print` would and join them, which is what an interpolated
    // string is.
    Join(n: usize)

    // `[v; n]` -- an array of `n` copies of the value under the count.
    Repeat

    // `base with { ... }` -- a copy of an object with `n` key/value pairs written over it.
    WithObject(n: usize)

    // `base with other` -- a copy of the base with everything the other object holds written over it.
    WithMerge(spread: bool)

    // `a..b` -- build a range from the two ends on the stack, or from none. `has_lo`/`has_hi` say
    // which ends were written, since a range with an end left out takes it from what it is used on.
    MakeRange(inclusive: bool, has_lo: bool, has_hi: bool)

    // `x is Pat` -- test the pattern against the value on top, replacing it with the answer. Unlike
    // `TestPat` it consumes its subject, an `is` being an expression rather than an arm's guard.
    IsPat(k: usize, negated: bool)

    // `val [a, b] = xs` -- take the value apart and bind what the pattern names.
    //
    // **It consumes the value and refuses a shape that does not fit**, which is the difference
    // between a binding and a `match` arm: an arm that does not take simply lets the next one try,
    // and a binding has no next one. `immutable` is whether the names it introduces may be
    // assigned to afterwards, which is the whole of the difference between `val` and `var` here.
    Unpack(k: usize, immutable: bool)

    // The same, where this chunk's names are numbered slots. The pattern's names were claimed in
    // `pattern_names` order beginning at `first`, so the values the walk gathers go into
    // `first`, `first + 1`, ... with nothing to look up and nothing to allocate.
    //
    // **`immutable` is gone rather than carried**, a slot's writability being a compile-time fact
    // the emitter already recorded.
    UnpackSlots(k: usize, first: usize)

    // -- matching --
    //
    // Tests the pattern against the value on top, in the current scope, and pushes whether it took.
    // The subject stays put, because a failed arm is followed by another that wants it.
    TestPat(k: usize)

    // The same, where the arm's names are numbered slots beginning at `first`. **The names are
    // written only where the pattern took**, so an arm that misses leaves the cells of the arm
    // before it alone -- which is what its own scope used to do.
    TestSlots(k: usize, first: usize)

    // -- iteration --
    //
    // `for x in e`. The subject is on the stack under a position that `IterNext` keeps.
    IterInit
    IterNext(to: usize)

    // The guard in front of a `for await`'s `next()`, and it exists for the DIAGNOSTIC alone.
    //
    // **`for await x in [1, 2]` would otherwise draw *"`next` is not something an array can do"***,
    // which is true and sends the reader to look at `next` -- a name they did not write. What is
    // wrong is the `await`, an array being something a plain `for` walks, and this is what says so.
    // It answers nothing and takes nothing: the subject stays where the call is about to find it.
    IterAwaitCheck

    // Stop with a fault.
    FailWith(k: usize)

    // A `match` that ran out of arms, which names the subject it was given -- so the message has to
    // be built where the subject is, rather than interned at compile time.
    FailNoArm

    // -- types --
    //
    // `-> type` on a definition: test what the body left on the stack, and leave it there. **A peek
    // rather than a pop**, the value being the function's answer and not this instruction's.
    CheckResult(type_name: usize, pat: usize)

    //
    // `p: Point` -- test the named binding against a pattern and stop if it does not hold.
    //
    // **An instruction of its own so the complaint can name all three things a reader needs**: the
    // parameter, the type it was declared as, and what it actually got. A `JumpIfFalse` over a
    // `FailWith` would have had only a message interned at compile time, which cannot say what
    // arrived.
    CheckType(name: usize, type_name: usize, pat: usize)

    // -- tests --
    //
    // Take the function on top of the stack and remember it as a test under the name it was given.
    //
    // **Only the file `slate test` was pointed at registers its tests**, which is what keeps a test
    // file that imports the module it tests from running that module's tests a second time. Walking
    // a directory runs every file as an entry in turn, so each file's tests run exactly once.
    DefineTest(k: usize)

    // -- handling a fault --
    //
    // **The handler is a place to STOP an unwind, and the unwind itself already existed.** A fault
    // leaves the instruction loop as an `Err` and has since the machine was written; what `try` adds
    // is a record of where to put the machine back to -- the operand height, the frame depth, the
    // scope, and the instruction the `catch` begins at -- so that the loop can be re-entered there
    // rather than handing the fault to whoever called it.
    PushHandler(to: usize)

    // The `try` body finished without faulting, so its handler is no longer owed anything.
    PopHandler

    // `throw v` -- raise a fault carrying what is on top of the stack.
    //
    // **The unwind is the one the machine already had**, so this op does nothing new: it turns a
    // value into the `Err` that every other fault leaves as, and `guarded` finds the handler exactly
    // as it does for a division by zero.
    Raise

    // -- modules --
    //
    // Push what another file exported, which is an ordinary object built by that file's own chunk
    // and kept in `module_values` under the index this instruction carries.
    //
    // **This is the only instruction that knows modules exist, and it knows nothing about files.**
    // Resolving a path, reading it, parsing it and refusing a cycle all happen while compiling; what
    // reaches the machine is a number. That is what "the VM never sees an import" means, and it is
    // what stops `import` from needing either a blocking read in the middle of an expression or a
    // promise that would force every importing program to be `async`.
    PushModule(m: usize)

    // Collect if enough has been allocated to be worth it.
    //
    // **Safe at any instruction boundary, which the walker's collection point was not.** Everything
    // live is on the operand stack, in a frame, or in a scope, and the tracer walks all three.
    Tick
end Op

// An instruction and where it came from.
//
// **Every one carries a span**, because a machine has no tree to ask afterwards. That is the tax a
// bytecode interpreter pays for its speed, and paying it per instruction is what keeps a runtime
// complaint pointing at the same character the walker pointed at.
struct Ins
    op: Op
    at: Span

// One function's code: the top level is a chunk, and so is every lambda and every named function.
struct Chunk
    code: Buf[Ins]
    params: Buf[string]

    // How many arguments a call must give, which is every parameter that has no default.
    //
    // **A count rather than the defaults themselves, because the defaults are already CODE.** They
    // are compiled into the head of this chunk, so nothing outside a call has to evaluate one; what
    // a caller needs to know is only where the arity it is allowed begins.
    required: usize

    // Whether the LAST parameter gathers what is left over -- `f(a, ...rest)`.
    //
    // **The name in `params` is the plain one**, the mark `ast.sysl` describes having been taken off
    // while this chunk was made. So a body binds `rest` and nothing downstream of compilation has to
    // know the spelling.
    //
    // A variadic call has no upper arity: `required` is still the floor, and the gather is what puts
    // the surplus somewhere.
    variadic: bool

    // What a fault calls it, and what a `<function>` prints as.
    name: string

    // Whether calling this runs it on a line of execution of its own and answers a promise.
    is_async: bool

    // Whether this chunk's body holds a `yield`, which is what makes calling it hand back a
    // generator rather than running it.
    is_gen: bool

    // How many cells this chunk reserves at entry: its parameters, then its locals. Zero for a chunk
    // whose names all stayed in the scope chain, which is every module and every function holding a
    // nested one.
    slots: usize

    // Whether this chunk's names -- its parameters as well as its locals -- are those slots.
    //
    // **A chunk that slots needs no `EnvObj` of its own at all**, which is what this exists to say
    // at the four places a call enters one. `vm.scope` becomes the closure's own captured scope, so
    // free names resolve exactly as they did and nothing is allocated per call. **Parameter `i` is
    // slot `i`**, claimed in order at the head of the chunk before a line of the body is emitted, so
    // no table has to travel from the compiler to the machine.
    //
    // Not the same question as `slots > 0`: a chunk with no parameters and no locals slots trivially
    // and still wants no scope built for it.
    slotted: bool

    // Which of the unit's sources this chunk was compiled from. **A fault's span is an offset into
    // this file and no other**, which is the whole reason a chunk has to remember it.
    source: usize

// Everything a compiled program is.
//
// **It lives outside the collected heap and holds counted boxes freely**, which the objects in the
// heap may not -- see `obj.sysl`. A chunk is immutable and acyclic once built, so reference counting
// frees it correctly and nothing here needs tracing.
struct Unit
    chunks: Buf[Chunk]
    strings: Buf[string]
    patterns: Buf[Pattern]

    // The parameter names written at each call site that named any, with `""` for a slot that was
    // given positionally. **Entry zero is the empty list**, so a call that named nothing carries a
    // `names` of zero and no lookup happens at all.
    arg_names: Buf[Buf[string]]

    // Every file the unit was compiled from, in the order they were read. A `Chunk.source` and a
    // `Signal.Fail`'s `src` both index this.
    sources: Buf[Source]

    // The top-level chunk of each module, **in the order they have to run** -- every file before any
    // file that imports it, and the program the user named last.
    //
    // **This is not the order the files were read in**, and the difference matters: reading is
    // depth-first from the entry, so the entry is source zero, while running is post-order, so the
    // entry is the last module. A module's own index here is what `PushModule` carries.
    modules: Buf[usize]

    // The resolved path of each module, in step with `modules` -- which is how a compiled `import`
    // finds the number to put in its `PushModule`.
    module_paths: Buf[string]

    // The packages the project reaches, so that a compiled `import ... from parsing` can be turned
    // into the same path the loader turned it into. **The loader's answer is not handed down as a
    // table**: there is one rule for what an import means and both passes ask it, which is what
    // stops the two from being able to disagree.
    packages: Packages

// An empty unit.
//
// **There is no chunk zero.** Every module gets a chunk of its own and the program the user named is
// simply the last of them, so nothing is special about the first -- which is what stopped the entry
// from having to be both the first chunk and the last thing to run.
new_unit() -> Unit
    var u = Unit(buf(), buf(), buf(), buf(), buf(), buf(), buf(), Packages(buf(), "", buf()))

    // Entry zero of `arg_names` is the empty list, which is what a `names` of zero means.
    u.arg_names.push(buf())
    u
end new_unit

// Record the parameter names one call site wrote, answering the index its instruction carries.
//
// **Not interned the way a string is.** A name list belongs to one call and is looked at once per
// call; searching the table for an equal one would cost more than the copy saves.
intern_arg_names(u: *Unit, names: Buf[string]) -> usize
    u.arg_names.push(names)
    u.arg_names.len() - 1

// Add a string to the table, reusing one that is already there.
//
// **Reuse matters more than it looks**: a field name appears once per access in the source and every
// one of them would otherwise be a separate copy in the unit.
intern_str(u: *Unit, s: string) -> usize
    for i in 0..<u.strings.len()
        if u.strings.at(i) == s then return i

    u.strings.push(s)
    u.strings.len() - 1
end intern_str

intern_pattern(u: *Unit, p: Pattern) -> usize
    u.patterns.push(p)
    u.patterns.len() - 1
