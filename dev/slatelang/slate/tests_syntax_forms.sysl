module dev.slatelang.slate
@tests

// What the forms of the syntax DO once they are parsed: loops and one-line bodies, compound and
// short-circuiting assignment, `?.` links, `catch` clauses, ranges and steps, spreads and
// shorthands in literals, and the values written into a string.
//
// Cut out of `tests_syntax.sysl`, which holds the lexer, the layout pass and the shape of the tree.
// Nothing here shares a helper with it.

// -- the syntax sysl has ----------------------------------------------------------------------------

@test
a_for_loop_leaves_the_stack_where_it_found_it()
    // **`IterInit` keeps its subject and pushes a counter beside it**, and the compiler once believed
    // it consumed the subject -- so every `for` a program ran stranded one value on the operand stack
    // for the rest of the enclosing chunk. Nothing was ever *wrong*, which is why no test caught it:
    // the stack simply grew, until fifty thousand turns of a loop containing one segfaulted the
    // process with no output at all.
    //
    // A `while` around it is what makes the leak accumulate; the top-level `Ret` truncates to zero, so
    // measuring the depth after a run cannot see it.
    assert_eq(out("var n = 0\nwhile n < 50000\n    for x in [1]\n        n = n + 1\nprint(n)"), "50000")

    // The value the statement leaves is its own and not the subject it walked.
    assert_eq(out("val v =\n    for x in [1, 2]\n        x\nprint(v)"), "null")

//
// **Everything below is measured against sysl's own grammar**, which is where it came from: slate's
// syntax should be sysl's minus what a dynamically typed language with no pointers has no use for.

@test
a_one_line_body_is_a_statement_and_not_only_an_expression()
    // **The gap that was worth the most.** sysl's `body(keyword)` is `suite | inlineBody` where the
    // inline form is one statement, so `if n > 2 then break` is a line a person writes -- and a
    // `then` taking only an expression refuses it along with `then return` and `then continue`.
    assert_eq(out("var n = 0\nloop\n    n += 1\n    if n > 2 then break\nprint(n)"), "3")
    assert_eq(out("f(n)\n    if n > 2 then return \"big\"\n    \"small\"\nprint(f(5), f(1))"), "big small")
    assert_eq(out("var n = 0\nfor x in [1, 2, 3]\n    if x == 2 then continue\n    n += x\nprint(n)"), "4")

    // An arm's body follows the same rule, for the same reason.
    assert_eq(out("val v = for x in [1, 2, 3]\n    x match\n        2 -> break \"two\"\n        _ -> null\nprint(v)"), "two")

@test
do_introduces_a_one_line_loop_body()
    assert_eq(out("var n = 0\nwhile n < 3 do n += 1\nprint(n)"), "3")
    assert_eq(out("for x in [1, 2] do print(x)"), "1\n2")
    assert_eq(out("var n = 0\nloop do\n    n += 1\n    if n > 1 then break\nprint(n)"), "2")

@test
an_end_marker_closes_a_block_and_end_is_still_a_name()
    assert_eq(out("if true\n    print(\"y\")\nend if"), "y")
    assert_eq(out("var n = 0\nwhile n < 2\n    n += 1\nend while\nprint(n)"), "2")
    assert_eq(out("for x in [1]\n    print(x)\nend for"), "1")
    assert_eq(out("var n = 0\nloop\n    n += 1\n    if n > 0 then break\nend loop\nprint(n)"), "1")
    assert_eq(out("f(x)\n    x + 1\nend f\nprint(f(1))"), "2")

    // **`end` is a soft word**, matched only immediately before the construct it closes -- so a
    // program may still call something `end`, which is sysl's rule and the reason for the shape.
    assert_eq(out("val end = 5\nprint(end)"), "5")

@test
do_while_runs_its_body_before_it_tests()
    assert_eq(out("var n = 0\ndo n += 1 while n < 3\nprint(n)"), "3")
    assert_eq(out("var n = 0\ndo\n    n += 1\nwhile n < 3\nprint(n)"), "3")

    // The difference from a `while`: the body runs once whatever the condition says.
    assert_eq(out("var n = 10\ndo n += 1 while n < 3\nprint(n)"), "11")

    // `continue` goes to the test rather than to the top, which is why it is not desugared.
    assert_eq(out("var n = 0\nvar seen = 0\ndo\n    n += 1\n    if n < 3 then continue\n    seen += 1\nwhile n < 5\nprint(n, seen)"), "5 3")

@test
a_compound_assignment_evaluates_its_place_once()
    // **`\=` is here beside `/=`**, and the two differ exactly as the operators do: the chain stays
    // whole through `\=` where a `/=` in the middle of it would leave a real for `%=` to refuse.
    assert_eq(out("var n = 10\nn += 5\nn -= 1\nn *= 2\nn \\= 7\nn %= 3\nprint(n)"), "1")
    assert_eq(out("var n = 10\nn += 5\nn -= 1\nn *= 2\nn /= 7\nprint(n)"), "4")
    assert_eq(out("var n = 6\nn &= 3\nn |= 8\nn ^= 1\nn <<= 2\nn >>= 1\nprint(n)"), "22")
    assert_eq(out("val o = { n: 1 }\no.n += 2\nprint(o.n)"), "3")
    assert_eq(out("val xs = [1, 2]\nxs[0] += 5\nprint(xs)"), "[6, 2]")

    // **The reason it is not desugared into `x = x + e`.** That rewriting evaluates the place twice,
    // so a place with a call in it would be reached twice.
    assert_eq(out("var calls = 0\nnext()\n    calls += 1\n    0\nval xs = [10]\nxs[next()] += 1\nprint(xs, calls)"), "[11] 1")

@test
a_short_circuiting_assignment_writes_only_where_the_test_says_to()
    assert_eq(out("var x = null\nx ??= 5\nprint(x)"), "5")
    assert_eq(out("var x = 3\nx ??= 5\nprint(x)"), "3")

    // **`??=` asks about ABSENCE and `||=` asks about truth**, which is the pair `??` and `||`
    // already are: a zero is there, so `??=` leaves it and `||=` writes over it.
    assert_eq(out("var x = 0\nx ??= 9\nprint(x)"), "0")
    assert_eq(out("var x = 0\nx ||= 9\nprint(x)"), "9")
    assert_eq(out("var x = \"\"\nx ||= \"filled\"\nprint(x)"), "filled")
    assert_eq(out("var x = 1\nx &&= 7\nprint(x)"), "7")
    assert_eq(out("var x = null\nx &&= 7\nprint(x)"), "null")
    assert_eq(out("var x = 0\nx &&= 7\nprint(x)"), "0")

    assert_eq(out("val o = { a: null, b: 2 }\no.a ??= 1\no.b ||= 33\nprint(o)"), "{a: 1, b: 2}")
    assert_eq(out("val xs = [null, 5]\nxs[0] ??= 7\nxs[1] ??= 8\nprint(xs)"), "[7, 5]")

    // **A field that is not there at all is an ABSENCE and not a null**, and `??=` asks about both
    // -- which is the whole of what `cache.thing ??= build()` is written for.
    assert_eq(out("val o = { }\no.made ??= 5\nprint(o)"), "{made: 5}")

    // **A NaN is PRESENT and is FALSE**, which is the one value where the two questions are hardest
    // to guess apart.
    assert_eq(out("var x = 0 / 0\nx ??= 3\nprint(x == x)"), "false")
    assert_eq(out("var x = 0 / 0\nx ||= 3\nprint(x)"), "3")

@test
A_SHORT_CIRCUITING_ASSIGNMENT_WRITES_A_MODULE_LEVEL_var_WHERE_NOTHING_HOLDS_IT_BY_NAME()
    // A module-level `var` nothing captures lives in a CELL rather than in a scope, so the write
    // goes through `StoreCell` and not `StoreName` -- a different path from the local a test's own
    // body declares, and the one an ordinary script takes.
    assert_eq(out("var a = null\nvar b = 0\na ??= \"written\"\nb ??= 99\nprint(a, b)"), "written 0")
    assert_eq(out("var s = \"\"\ns ||= \"filled\"\nprint(s)"), "filled")
    assert_eq(out("var n = 1\nn &&= 7\nprint(n)"), "7")

@test
a_short_circuiting_assignment_does_not_work_out_the_value_it_does_not_store()
    // **The whole of what these are for.** `cache[k] ??= build(k)` builds nothing for a key that is
    // already there, which a desugar into `x = x ?? build(k)` could not promise.
    assert_eq(out("var calls = 0\nf()\n    calls += 1\n    99\nvar a = 3\na ??= f()\nprint(a, calls)"), "3 0")
    assert_eq(out("var calls = 0\nf()\n    calls += 1\n    99\nvar a = null\na ??= f()\nprint(a, calls)"), "99 1")

    // And the place is still worked out exactly once, whichever way the test goes.
    assert_eq(out("var calls = 0\nwhere()\n    calls += 1\n    0\nval xs = [null]\nxs[where()] ??= 4\nprint(xs, calls)"), "[4] 1")
    assert_eq(out("var calls = 0\nwhere()\n    calls += 1\n    0\nval xs = [9]\nxs[where()] ??= 4\nprint(xs, calls)"), "[9] 1")
    assert_eq(out("var calls = 0\nwhich()\n    calls += 1\n    { n: 1 }\nwhich().n ||= 5\nprint(calls)"), "1")

@test
a_short_circuiting_assignment_writes_one_place()
    // A multi-assignment works out every value before it writes any of them, so there would be
    // nothing left to short-circuit.
    assert(fails("var a = 1\nvar b = 2\na, b ??= 3, 4").contains("write one place"))
    assert(fails("var a = 1\nvar b = 2\na, b ||= 3, 4").contains("write one place"))
    assert(fails("var a = 1\nvar b = 2\na, b &&= 3, 4").contains("write one place"))

    // The place is still checked, exactly as `+=`'s is.
    assert(fails("1 ??= 2").contains("cannot be assigned to"))

@test
each_of_the_three_guarded_links_answers_null_for_an_absent_left()
    assert_eq(out("val o = { xs: [10, 20] }\nprint(o.xs?.[1])"), "20")
    assert_eq(out("val o = { }\nprint(o.xs?.[1])"), "null")
    assert_eq(out("val o = { go: n -> n * 2 }\nprint(o.go?.(21))"), "42")
    assert_eq(out("val o = { }\nprint(o.go?.(21))"), "null")

    // A `null` written out is guarded exactly as a field that was never there is.
    assert_eq(out("val f = null\nprint(f?.())"), "null")
    assert_eq(out("val xs = null\nprint(xs?.[0])"), "null")

@test
a_guarded_link_carries_every_kind_of_link_that_follows_it()
    // **The chain rule `o?.f` already had, read over the two new links.** One `?.` guards the whole
    // run after it, whatever the run is made of -- a field, an index, a call, a method call.
    assert_eq(out("val a = { b: [ { c: 7 } ] }\nprint(a?.b?.[0]?.c)"), "7")
    assert_eq(out("val a = { b: [ { c: 7 } ] }\nprint(a?.b[0].c)"), "7")
    assert_eq(out("val a = { }\nprint(a.b?.[0]?.c)"), "null")
    assert_eq(out("val a = { }\nprint(a.b?.[0].c)"), "null")
    assert_eq(out("val a = { b: [ { go: () -> 5 } ] }\nprint(a?.b?.[0]?.go?.())"), "5")
    assert_eq(out("val a = { b: [ { go: () -> 5 } ] }\nprint(a?.b[0].go())"), "5")
    assert_eq(out("val f = null\nprint(f?.().x[0])"), "null")

@test
a_guarded_link_works_out_nothing_to_the_right_of_it_where_it_short_circuits()
    // The key of a guarded index and the arguments of a guarded call are the same rule `o?.m(a)`
    // already had about its arguments.
    assert_eq(out("var calls = 0\nwhere()\n    calls += 1\n    0\nval xs = null\nprint(xs?.[where()], calls)"), "null 0")
    assert_eq(out("var calls = 0\nwhere()\n    calls += 1\n    0\nval xs = [9]\nprint(xs?.[where()], calls)"), "9 1")
    assert_eq(out("var calls = 0\narg()\n    calls += 1\n    1\nval f = null\nprint(f?.(arg()), calls)"), "null 0")
    assert_eq(out("var calls = 0\narg()\n    calls += 1\n    1\nval f = n -> n + 1\nprint(f?.(arg()), calls)"), "2 1")

    // And the left is worked out exactly ONCE, whichever way the test goes.
    assert_eq(out("var calls = 0\npick()\n    calls += 1\n    [4]\nprint(pick()?.[0], calls)"), "4 1")

@test
a_guarded_call_answers_for_an_absence_and_never_for_a_wrong_kind()
    // **`?.` is about something not being there**, so a callee that IS there and is not a function
    // faults exactly as a plain call does. Answering `null` for it would turn a defect into a
    // value, which is the opposite of what the character is for.
    assert(fails("val f = 3\nf?.()").contains("not something that can be called"))
    assert(fails("val xs = 3\nprint(xs?.[0])").contains("cannot be indexed"))

@test
a_guarded_link_may_not_be_written_to()
    // `o?.f = v` was already refused; an index guarded the same way is refused for its reason --
    // there is no answer to what writing into absence should do.
    assert(fails("val xs = null\nxs?.[0] = 1").contains("cannot be assigned to"))
    assert(fails("val o = null\no?.f = 1").contains("cannot be assigned to"))

@test
a_catch_takes_a_pattern_and_a_bare_name_still_binds_everything()
    // **Nothing written before this changes**: a bare name is a pattern that matches everything,
    // and one such clause is the node slate always made.
    assert_eq(out("boom()\n    throw \"no\"\ntry\n    boom()\ncatch e\n    print(e.message)"), "no")

    // A pattern names what it will take, and a clause that does not want the fault stands aside.
    assert_eq(out("boom()\n    throw \"no\"\ntry\n    boom()\ncatch { message: \"yes\" }\n    print(\"wrong one\")\ncatch { message: \"no\" }\n    print(\"right one\")"), "right one")

@test
the_catch_clauses_are_tried_in_the_order_they_are_written()
    val prog = "boom(m)\n    throw m\nlook(m)\n    try\n        boom(m)\n    catch { message: \"a\" }\n        print(\"first\")\n    catch { message: \"b\" }\n        print(\"second\")\n    catch e\n        print(\"last\", e.message)\nlook(\"a\")\nlook(\"b\")\nlook(\"c\")"

    assert_eq(out(prog), "first\nsecond\nlast c")

    // A bare name written FIRST takes everything, exactly as an arm that matches everything does.
    assert_eq(out("boom()\n    throw \"a\"\ntry\n    boom()\ncatch e\n    print(\"caught\")\ncatch { message: \"a\" }\n    print(\"never\")"), "caught")

@test
a_catch_clause_takes_a_guard_and_a_refused_guard_lets_the_next_one_try()
    val prog = "boom(m)\n    throw m\nlook(m)\n    try\n        boom(m)\n    catch e if e.message == \"big\"\n        print(\"guarded\")\n    catch e\n        print(\"plain\", e.message)\nlook(\"big\")\nlook(\"small\")"

    assert_eq(out(prog), "guarded\nplain small")

@test
a_fault_no_catch_clause_wanted_is_thrown_again()
    // **A run of clauses is a filter rather than a `try` that swallows.** The words are the
    // original's; the line becomes the one that put it back, which is what `throw` says everywhere.
    assert(fails("boom()\n    throw \"unwanted\"\ntry\n    boom()\ncatch { message: \"other\" }\n    print(\"no\")").contains("unwanted"))

    // And an enclosing handler gets it, which is the whole of what "propagates" means.
    assert_eq(out("boom()\n    throw \"inner\"\ntry\n    try\n        boom()\n    catch { message: \"other\" }\n        print(\"no\")\ncatch e\n    print(\"outer saw\", e.message)"), "outer saw inner")

@test
the_postfix_catch_takes_a_pattern_and_one_clause()
    assert_eq(out("boom()\n    throw \"gone\"\nprint(boom() catch { message: \"gone\" } -> 0)"), "0")
    assert_eq(out("boom()\n    throw \"gone\"\nprint(boom() catch e if e.message == \"gone\" -> 1)"), "1")

    // One that does not want it throws it again, exactly as the block form does.
    assert(fails("boom()\n    throw \"gone\"\nprint(boom() catch { message: \"other\" } -> 0)").contains("gone"))

// A heap small enough that a collection lands inside the release a fault unwinds past, and the one
// the rest of the suite runs against. `tests_native_args.sysl` has the same pair for its own reason.
private const ThrowHeap: usize = 1048576
private const RoomyHeap: usize = 268435456

// What a program printed, run against a heap that collects under it. **The limit is put back whatever
// happened**, so nothing after this runs in a megabyte by accident.
private out_crowded(text: string) -> string
    set_heap_limit(ThrowHeap)

    val said = out(text)

    set_heap_limit(RoomyHeap)
    said
end out_crowded

// `tests/lang/faults.sl` asks what a thrown value ANSWERS, on both back ends. What is here is what
// only this process can ask: the interpreter's own sentences, and the same programs against a heap
// that collects while the fault is still travelling.

@test
an_uncaught_value_says_what_the_value_says()
    // **The sentence is the value written the way `print` writes it**, so a data variant names itself
    // rather than saying "thrown" -- which is the whole reason a fault may carry one.
    assert(fails("data Failure\n    NotFound(id)\n\nthrow NotFound(3)").contains("NotFound(3)"))

    // And a class that wrote a `toString` says what it says. This is the one diagnostic in slate that
    // runs a program's own code.
    assert(fails("class Money\n    var cents\n\n    toString(self) = s\"${self.cents} cents\"\n\nthrow Money(150)").contains("150 cents"))

    // A hook that faults while it is being reported may NOT replace the fault the program threw: what
    // is left is the ordinary rendering, and the hook's own words are nowhere in it.
    // **`throw` is a STATEMENT**, so the hook is a named function rather than a one-line lambda.
    val broken = fails("raiser() =\n    throw \"the hook went wrong\"\n\nval broken = { toString: raiser }\n\nthrow broken")

    assert(broken.contains("toString"))
    assert(!broken.contains("the hook went wrong"))

@test
a_thrown_string_still_flattens_to_the_fault_object()
    // Nothing written before values could be thrown changes: a string has nothing in it a handler
    // could sort on, so it arrives as `{message, line, file}` and a clause naming a type refuses it.
    assert_eq(out("data Failure\n    NotFound(id)\n\ntry\n    throw \"gone\"\ncatch NotFound(which)\n    print(\"a variant\")\ncatch e\n    print(e.message, e.line, e.file is string)"), "gone 5 true")

@test
a_value_fault_survives_a_collection_while_it_is_unwinding()
    // **A `Value` in a sysl local is not a root**, and a fault carrying one travels in exactly that
    // for the whole unwind -- past a `using` release, which runs the program's own code and allocates.
    // `guarded` holds it across that call; without the hold this prints whatever took its storage.
    val prog = "data Failure\n    NotFound(id)\n\ndeep(n) = if n == 0 then { a: 1, b: [1, 2, 3], c: \"xxxxxxxx\" } else deep(n - 1)\n\nmade() = { dispose: () -> deep(400) }\n\nboom()\n    using r = made()\n\n    throw NotFound(7)\n\nvar i = 0\n\nwhile i < 300\n    try\n        boom()\n    catch NotFound(which)\n        i = i + 1\n\ntry\n    boom()\ncatch NotFound(which)\n    print(which)"

    assert_eq(out_crowded(prog), "7")

@test
several_places_are_written_at_once()
    // Every value is computed before any place is written, which is what makes a swap a swap.
    assert_eq(out("var a = 1\nvar b = 2\na, b = b, a\nprint(a, b)"), "2 1")
    assert_eq(out("val o = { x: 1, y: 2 }\no.x, o.y = o.y, o.x\nprint(o)"), "{x: 2, y: 1}")
    assert_eq(out("var a = 1\nvar b = 2\na, b += 10, 20\nprint(a, b)"), "11 22")

    assert(fails("var a = 1\nvar b = 2\na, b = 1").contains("writes 2 places and was given 1"))

@test
a_comma_after_an_expression_does_not_commit_to_an_assignment()
    // **It is read speculatively and commits only on the `=`.** A stray comma in a `match` arm
    // leaves one behind too, and a rule that committed here would answer that with a sentence about
    // assignment -- replacing the one diagnostic that says what is actually wrong.
    assert(fails("val v = 1 match\n    1 -> 2, 9").contains("this is where the arm should have ended"))

@test
a_name_a_field_or_an_element_may_be_stepped()
    assert_eq(out("var n = 1\nprint(n++, n)"), "1 2")
    assert_eq(out("var n = 1\nprint(++n, n)"), "2 2")
    assert_eq(out("var n = 1\nprint(n--, n)"), "1 0")
    assert_eq(out("val o = { n: 5 }\nprint(o.n++, o.n)"), "5 6")
    assert_eq(out("val xs = [5]\nprint(--xs[0], xs)"), "4 [4]")

@test
the_bitwise_operators_bind_the_way_sysl_says()
    assert_eq(out("print(6 & 3, 6 | 3, 6 ^ 3, ~0)"), "2 7 5 -1")
    assert_eq(out("print(1 << 4, 32 >> 2)"), "16 8")

    // **A shift binds like a multiplication**, which is sysl's deliberate correction to C -- where
    // `1 << 2 + 3` groups in the way nobody predicts.
    assert_eq(out("print(1 << 2 + 3)"), "7")

    assert(fails("print(1.5 & 2)").contains("works on whole numbers"))

    // **A shift past 63 places is no longer a refusal**, an integer having no width to leave by:
    // `1 << 99` is the number. What is still refused is a negative count and one so large that the
    // answer would be megabytes of limbs -- `tests_bigint.sysl` has both.
    assert_eq(out("print(1 << 99)"), "633825300114114700748351602688")

@test
a_run_of_comparisons_is_one_comparison()
    assert_eq(out("print(1 < 2 < 3, 1 < 3 < 2, 3 == 3 < 5)"), "true false true")

    // **The middle operand is evaluated once**, which is the whole difference from writing the
    // conjunction out by hand.
    assert_eq(out("var calls = 0\nmid()\n    calls += 1\n    2\nprint(1 < mid() < 3, calls)"), "true 1")

@test
is_asks_a_pattern_where_a_condition_is_wanted()
    assert_eq(out("val v = [1, 2]\nprint(if v is array then \"arr\" else \"no\")"), "arr")
    assert_eq(out("print(3 is not string)"), "true")
    assert_eq(out("print(2 is 1 | 2 | 3, 9 is 1 | 2)"), "true false")
    assert_eq(out("print({ name: \"ada\" } is { name })"), "true")

    // **It sits between `&&` and the comparisons**, so this is two terms rather than an `is` against
    // a conjunction.
    assert_eq(out("val v = 5\nprint(v is number && v > 1)"), "true")

@test
a_range_is_a_value_and_a_for_walks_one()
    assert_eq(out("for i in 0..<3\n    print(i)"), "0\n1\n2")
    assert_eq(out("for i in 1..3 do print(i)"), "1\n2\n3")
    assert_eq(out("val r = 1..<4\nprint(r, r.length)"), "1..<4 3")

    // `1..3` and `1..<4` cover the same numbers, so they are equal -- and therefore hash alike, which
    // is what lets one find the other in a table.
    assert_eq(out("print(1..3 == 1..<4)"), "true")
    assert_eq(out("val o = {}\no[1..3] = \"a\"\nprint(o[1..<4])"), "a")

@test
an_end_left_out_of_a_range_is_taken_from_what_it_is_used_on()
    assert_eq(out("val xs = [1, 2, 3, 4, 5]\nprint(xs[1..<3], xs[2..], xs[..2], xs[..])"), "[2, 3] [3, 4, 5] [1, 2, 3] [1, 2, 3, 4, 5]")
    assert_eq(out("print(\"hello\"[1..<3])"), "el")

    // **A `for` refuses one**, since a walk with an end taken from nothing would never finish.
    assert(fails("for i in 1..\n    print(i)").contains("both ends"))
    assert(fails("print((1..).length)").contains("no length until it is used"))
    assert(fails("val xs = [1]\nprint(xs[0..<9])").contains("outside something 1 long"))

@test
a_range_takes_a_step_with_the_soft_word_by()
    assert_eq(out("for i in 0..<10 by 2\n    print(i)"), "0\n2\n4\n6\n8")
    assert_eq(out("print(10..0 by -1)"), "10..0 by -1")
    assert_eq(out("print((1..9 by 3).length)"), "3")

    // **A step of one is not printed**, so every range written before `by` existed reads back the way
    // it was written.
    assert_eq(out("print(0..3, 0..3 by 1)"), "0..3 0..3")

    // A step whose sign disagrees with the ends covers nothing, which is what `10..0` already did.
    assert_eq(out("print((0..10 by -1).length, (10..0 by 2).length)"), "0 0")

@test
a_step_binds_to_the_range_on_its_left_looser_than_arithmetic_and_tighter_than_a_comparison()
    // The step swallows the `+`, so this steps by two rather than comparing a range with a sum.
    assert_eq(out("print(0..<10 by 1 + 1)"), "0..<10 by 2")

    // And stops before the comparison, so what is compared is the whole stepped range -- which is
    // what the sentence about the two sides says.
    assert(fails("print(0..<10 by 2 < 99)").contains("does not apply to a range"))

@test
a_range_that_steps_by_zero_is_refused_where_the_zero_is_written()
    val said = fails("print(0..<10 by 0)")

    assert(said.contains("steps by 0"))
    assert(said.contains("`by` takes a step that moves"))

    // **A computed zero is caught by the machine**, which says the same sentence.
    assert(fails("val k = 0\nprint(0..<10 by k)").contains("steps by 0"))
    assert(fails("print(0..<10 by \"two\")").contains("the step of a range is a whole number"))

@test
by_is_a_soft_word_and_stays_an_ordinary_name()
    // Taking it as a keyword would take the name away from every program that wanted it. It means a
    // step only straight after a range, which is the one place the parser can tell.
    assert_eq(kinds("by"), "Ident Newline Eof")
    assert_eq(out("val by = 3\nprint(by * 2)"), "6")
    assert_eq(out("by(n) = n + 1\nprint(by(4))"), "5")
    assert_eq(out("print({ by: 7 }.by)"), "7")

    // A `by` on the line under a range is the call it looks like, the newline having ended the range.
    assert_eq(out("by(n) = n + 1\nval r = 0..3\nprint(r, by(1))"), "0..3 2")

@test
a_stepped_range_slices_by_the_positions_it_covers()
    assert_eq(out("print([10, 20, 30, 40, 50, 60][0..<6 by 2])"), "[10, 30, 50]")
    assert_eq(out("print(\"abcdef\"[0..<6 by 2])"), "ace")
    assert_eq(out("print([1, 2, 3][2..0 by -1])"), "[3, 2, 1]")

    // A stepped end cannot be taken from what the range is used on, there being no length to step
    // through; an ordinary open-ended slice is unchanged.
    assert(fails("print([1, 2, 3][..3 by 2])").contains("a slice that steps needs a range with both ends"))
    assert(fails("print([1, 2, 3][0..<9 by 2])").contains("outside something 3 long"))
    assert_eq(out("print([1, 2, 3][1..])"), "[2, 3]")

    // **A `by` IS NOT READ WHERE THE TOP OF THE RANGE IS MISSING**, a word standing there being the
    // top itself -- so `0..by` is a range up to what `by` holds and stays one.
    assert_eq(out("val by = 2\nprint([1, 2, 3][0..by])"), "[1, 2, 3]")

@test
a_step_in_a_pattern_picks_out_every_kth_number_and_is_refused_where_it_has_nothing_to_count_from()
    assert_eq(out("print(6 is 0..<10 by 2, 7 is 0..<10 by 2)"), "true false")
    assert_eq(out("type Even = 0..<10 by 2\nprint(4 is Even, 5 is Even)"), "true false")
    assert_eq(out("print(9 match\n    0..<10 by 3 -> \"on\"\n    _ -> \"off\")"), "on")

    // **A STEP NEEDS WHOLE BOUNDS AND AN END TO COUNT FROM**, and each refusal says which is missing.
    assert(fails("print(1 is 0.0..1.0 by 2)").contains("ends have to be whole numbers"))
    assert(fails("print(1 is ..100 by 2)").contains("counts from the end it does not have"))
    assert(fails("print(1 is 0..100 by 0)").contains("steps by 0"))

@test
an_inclusive_range_written_rusts_way_is_refused_by_name()
    // What the ordinary grammar would answer is a sentence about the open-ended range that parsed --
    // true about something else, and never mentioning the `=` that caused it.
    val said = fails("for i in 1..=3\n    print(i)")

    assert(said.contains("`..=` is not a range"))
    assert(said.contains("`a..<b`"))

@test
a_loop_is_an_expression_and_a_break_gives_it_its_value()
    assert_eq(out("val found = for x in [1, 5, 9] do if x > 3 then break x\nprint(found)"), "5")
    assert_eq(out("val v = for x in [1, 2] do x\nprint(v)"), "null")
    assert_eq(out("var n = 0\nval v = loop\n    n += 1\n    if n > 2 then break n * 10\nprint(v)"), "30")
    assert_eq(out("var n = 0\nval v = while true\n    n += 1\n    if n > 3 then break n\nprint(v)"), "4")

    // **The value is compiled before anything is unwound**, because the scopes about to close are the
    // ones holding the names it may use.
    assert_eq(out("val v = for x in [1, 2, 3]\n    if x == 2\n        val extra = x * 100\n        break extra\nprint(v)"), "200")

@test
a_loops_else_runs_when_it_finished_on_its_own()
    assert_eq(out("for x in [1, 2]\n    print(x)\nelse\n    print(\"all\")"), "1\n2\nall")
    assert_eq(out("for x in [1, 2, 3]\n    if x == 2 then break\nelse\n    print(\"never\")\nprint(\"after\")"), "after")
    assert_eq(out("var n = 0\nwhile n < 2 do n += 1\nelse\n    print(\"done\")\nprint(n)"), "done\n2")

@test
the_value_of_a_loops_else_is_the_loops_value()
    // **Checked against sysl rather than assumed.** The same two loops written in sysl answer `3` and
    // `-1`, so an `else` supplies a value rather than running for effect -- which is what makes the
    // search idiom read: `break` gives the answer that was found and `else` the one for none.
    val find = "find(xs, w)\n    for i in 0..<xs.length do\n        if xs[i] == w then break i\n    else\n        -1\n"

    assert_eq(out(find + "print(find([1, 2, 3], 2), find([1], 9))"), "1 -1")
    assert_eq(out("var n = 0\nval v = while n < 2 do n += 1\nelse\n    \"done\"\nprint(v)"), "done")
    assert_eq(out("var n = 0\nval v = do n += 1 while n < 2\nelse\n    \"ended\"\nprint(v, n)"), "ended 2")

    // A loop with no `else` answers null, and one that broke answers what the `break` carried.
    assert_eq(out("print(for x in [1] do x)"), "null")
    assert_eq(out("val v = for x in [1, 2]\n    break \"broke\"\nelse\n    \"finished\"\nprint(v)"), "broke")

@test
a_label_says_which_loop_a_break_leaves()
    val prog = "var hits = 0\nval r = 'outer for x in [1, 2, 3]\n    for y in [1, 2, 3]\n        hits += 1\n        if x * y > 3 then break 'outer x * y\nprint(r, hits)"

    assert_eq(out(prog), "4 5")

    // A `continue` may name one too, and takes the next turn of *that* loop.
    assert_eq(out("var n = 0\n'outer for x in [1, 2]\n    for y in [1, 2]\n        if y == 1 then continue 'outer\n        n += 100\n    n += 1\nprint(n)"), "0")

    assert(fails("for x in [1]\n    break 'nope").contains("no enclosing loop is called `'nope`"))
    assert(fails("'here print(1)").contains("a loop for this label to name"))

@test
an_array_may_be_written_as_copies_of_one_value()
    assert_eq(out("print([0; 4], [1; 0])"), "[0, 0, 0, 0] []")
    assert(fails("print([0; -1])").contains("is not something to make"))
    assert(fails("print([0; \"x\"])").contains("a repeat count is a whole number"))

@test
with_answers_a_copy_rather_than_changing_what_it_was_given()
    assert_eq(out("val base = { a: 1, b: 2 }\nval next = base with { b: 20, c: 3 }\nprint(base, next)"),
              "{a: 1, b: 2} {a: 1, b: 20, c: 3}")

    // **A tail rather than a binary operator**, so it binds as tightly as a field selection does.
    assert_eq(out("val o = { n: 1 }\nprint(o with { n: 9 })"), "{n: 9}")
    assert(fails("print(5 with { a: 1 })").contains("`with` copies an object"))

@test
with_takes_a_value_on_the_right_as_well_as_a_literal()
    // **This is what an object literal's `...` is built out of.** `{ ...a, ...b }` desugars to a
    // chain of these, so the two spellings cannot drift: there is one merge in the language and the
    // tests below pin the sugar against it.
    assert_eq(out("val a = { x: 1, y: 2 }\nval b = { y: 20, z: 3 }\nprint(a with b)"),
              "{x: 1, y: 20, z: 3}")

    // The base's order is kept and a field the other object also has keeps the place it had, which
    // is the literal form's rule and has to be the same one.
    assert_eq(out("val a = { x: 1, y: 2 }\nprint(a with { y: 9 } with { x: 8 })"), "{x: 8, y: 9}")

    // **The right-hand side takes its postfixes**, which is where the first attempt went wrong: `with`
    // binds as tightly as a field selection, so a right-hand side parsed at `with`'s own power stops
    // before the `.` and the merge's answer is thrown away by it.
    assert_eq(out("val a = { x: 1 }\nval o = { b: { y: 2 } }\nprint(a with o.b)"), "{x: 1, y: 2}")
    assert_eq(out("val a = { x: 1 }\nval f = () -> { y: 2 }\nprint(a with f())"), "{x: 1, y: 2}")

    // Neither side is changed -- a copy is the whole point of `with`.
    assert_eq(out("val a = { x: 1 }\nval b = { x: 2 }\nval c = a with b\nprint(a, b, c)"),
              "{x: 1} {x: 2} {x: 2}")

    // Both sides have to be objects, and the two complaints name which one was not.
    assert(fails("print({ a: 1 } with 5)").contains("`with` copies the fields of an object, and this is an integer"))
    assert(fails("print(5 with { a: 1 })").contains("`with` copies an object, and this is an integer"))

@test
an_array_literal_takes_a_spread_among_its_elements()
    assert_eq(out("val xs = [2, 3]\nprint([1, ...xs, 4])"), "[1, 2, 3, 4]")
    assert_eq(out("val xs = [2, 3]\nprint([...xs])"), "[2, 3]")
    assert_eq(out("val a = [1]\nval b = [2]\nprint([...a, ...b])"), "[1, 2]")
    assert_eq(out("print([...[]])"), "[]")

    // A trailing comma is allowed after one, as after anything else in a list.
    assert_eq(out("val xs = [1]\nprint([...xs,])"), "[1]")

    // **A spread makes a new array rather than aliasing the one it read.** Writing to the result
    // must not reach back, which is the whole reason a program writes `[...xs]` at all.
    assert_eq(out("val xs = [1]\nval ys = [...xs]\nys.push(2)\nprint(xs, ys)"), "[1] [1, 2]")

    // The ordinary literal is untouched, and is still built by the instruction that always built it.
    assert_eq(out("print([], [1, 2])"), "[] [1, 2]")

@test
A_SPREAD_IN_AN_ARRAY_LITERAL_IS_REFUSED_WHERE_THERE_IS_NO_ARRAY_TO_SPREAD()
    // The same complaint a call's arguments make, and for the same reason -- it names the `...`
    // rather than the literal, because the mistake is about what may be spread.
    assert(fails("print([...42])").contains("`...` spreads an array, bytes, a range, a generator, a set or a map, and this is an integer"))
    assert(fails("print([1, ...null])").contains("`...` spreads an array, bytes, a range, a generator, a set or a map, and this is null"))

    // **`[v; n]` and `...` say opposite things about one array**, so the refusal names both rather
    // than reporting a stray `;` and sending the reader to look at their punctuation.
    assert(fails("val xs = [1]\nprint([...xs; 3])").contains("one array cannot be both"))

    // A `...` still starts nothing on its own: it is read in a call's brackets and in an array
    // literal, and an expression may not simply be one.
    assert(fails("val a = ...[1]\nprint(a)").contains("expected"))

@test
an_object_literal_takes_a_spread_among_its_fields()
    assert_eq(out("val o = { b: 2 }\nprint({ a: 1, ...o, c: 3 })"), "{a: 1, b: 2, c: 3}")
    assert_eq(out("val o = { a: 1 }\nprint({ ...o })"), "{a: 1}")
    assert_eq(out("val a = { x: 1 }\nval b = { y: 2 }\nprint({ ...a, ...b })"), "{x: 1, y: 2}")

    // **A later entry wins over an earlier one, whichever way round they are written**, which is the
    // rule `with` already had and is what makes the desugaring honest.
    assert_eq(out("val o = { a: 9 }\nprint({ a: 1, ...o })"), "{a: 9}")
    assert_eq(out("val o = { a: 9 }\nprint({ ...o, a: 1 })"), "{a: 1}")

    // A field already present keeps the place it had rather than moving to the end.
    assert_eq(out("val o = { x: 9 }\nprint({ x: 1, y: 2, ...o })"), "{x: 9, y: 2}")

    // **A copy, not an alias** -- the same promise the array form makes.
    assert_eq(out("val o = { a: 1 }\nval c = { ...o }\nc.a = 2\nprint(o, c)"), "{a: 1} {a: 2}")

    // The ordinary literal is untouched.
    assert_eq(out("print({}, { a: 1 })"), "{} {a: 1}")

@test
AN_OBJECT_SPREAD_IS_THE_with_SLATE_ALREADY_HAD()
    // **Pinned as a shape, because the desugaring IS the design.** `{ a: 1, ...o, b: 2 }` is
    // `{ a: 1 } with o with { b: 2 }`, so nothing downstream of the parser learns a new node -- and a
    // change that quietly stopped desugaring would show up here rather than in behaviour.
    assert_eq(good_tree("val x = { a: 1, ...o, b: 2 }"),
              "(val x (with (spread (object a:1) o) b:2))")

    // With no spread the literal is the literal, which is what almost every one of them is.
    assert_eq(good_tree("val x = { a: 1 }"), "(val x (object a:1))")

@test
A_SPREAD_OF_SOMETHING_THAT_IS_NOT_AN_OBJECT_NAMES_THE_SPELLING_THE_READER_WROTE()
    // **The message says `...` and not `with`, and that is the point of carrying the spelling.** The
    // two are one instruction; a reader told about a `with` they never wrote goes looking for it.
    assert(fails("print({ ...5 })").contains("`...` spreads the fields of an object, and this is an integer"))
    assert(fails("print({ a: 1, ...null })").contains("`...` spreads the fields of an object, and this is null"))

    // And the `with` spelling still says `with`.
    assert(fails("print({ a: 1 } with 5)").contains("`with` copies the fields of an object, and this is an integer"))

@test
AN_OBJECT_LITERAL_SHORTHAND_IS_DESUGARED_TO_THE_FIELD_IT_STANDS_FOR()
    // **Pinned as a shape, because the desugaring IS the design.** `{ x }` is `{ x: x }` in the
    // parser, so the checker, the machine and the JavaScript back end never learn the spelling --
    // and a change that quietly grew a node for it fails here rather than in behaviour.
    assert_eq(good_tree("val o = { x }"), "(val o (object x:x))")
    assert_eq(good_tree("val o = { x, y }"), "(val o (object x:x y:y))")
    assert_eq(good_tree("val o = { x, y: 1 }"), "(val o (object x:x y:1))")

    // A spread sees a desugared field like any other, so the merge is the one `...` already had.
    assert_eq(good_tree("val o = { ...p, x }"), "(val o (with (spread (object) p) x:x))")

    // And a nested literal is read the same way at every depth.
    assert_eq(good_tree("val o = { p: { x } }"), "(val o (object p:(object x:x)))")

@test
A_with_READS_THE_SAME_ENTRY_AN_OBJECT_LITERAL_DOES()
    // **One entry, written once** -- `with_fields` and `object_literal` both ask `field_entry`, so
    // the shorthand cannot be a literal's alone and the refusals cannot drift apart.
    assert_eq(good_tree("val o = p with { x }"), "(val o (with p x:x))")
    assert_eq(good_tree("val o = p with { x, y }"), "(val o (with p x:x y:y))")
    assert_eq(good_tree("val o = p with { x, y: 1 }"), "(val o (with p x:x y:1))")

    assert_eq(out("val x = 1\nval y = 2\nval base = { a: 9, x: 0 }\nprint(base with { x }, base with { x, y }, base with { x, y: 7 })"),
        "{a: 9, x: 1} {a: 9, x: 1, y: 2} {a: 9, x: 1, y: 7}")

    // A `with` whose right-hand side is an expression rather than a literal is untouched.
    assert_eq(out("val a = { x: 1 }\nval more = { y: 2 }\nprint(a with more)"), "{x: 1, y: 2}")

@test
A_SHORTHAND_READS_A_NAME_AND_AN_UNBOUND_ONE_IS_REFUSED_BEFORE_THE_PROGRAM_RUNS()
    assert_eq(out("val x = 1\nval y = 2\nprint({ x }, { x, y }, { x, y: 3 })"), "{x: 1} {x: 1, y: 2} {x: 1, y: 3}")
    assert_eq(out("val o = { z: 9 }\nval x = 1\nprint({ ...o, x }, { x, ...o })"), "{z: 9, x: 1} {x: 1, z: 9}")

    // **The shorthand is an ordinary READ of a name**, so a name nothing bound gets the refusal
    // every other read of one gets, before a line runs.
    assert(fails("print({ nope })").contains("`nope` is not defined"))
    assert(fails("val o = { a: 1 }\nprint(o with { nope })").contains("`nope` is not defined"))

@test
THE_TWO_SPELLINGS_A_SHORTHAND_CANNOT_HAVE_EACH_SAY_WHAT_TO_WRITE_INSTEAD()
    // **A keyword is a FIELD name and never a bound one**, so there is no name for the shorthand
    // to read -- while the written-out field stays perfectly ordinary.
    assert(fails("print({ if })").contains("`if` is a word the grammar has taken, so a shorthand has no name it could read"))
    assert_eq(out("print({ if: 1 })"), "{\"if\": 1}")

    // A quoted key has no name in it at all, which is the object pattern's rule read on the
    // building side.
    assert(fails("print({ \"a.b\" })").contains("`a.b` is not a name, so this has to say what its value is"))

    // **`?` is a PATTERN's mark**, and the two notations are otherwise the same -- so a reader who
    // has written `{ pinned? }` on the left of an `=` is told why the right has no use for it.
    assert(fails("val x = 1\nprint({ x? })").contains("`x?` is a pattern's spelling"))

    // And all three read the same inside a `with`, one `field_entry` answering for both.
    assert(fails("val o = { a: 1 }\nprint(o with { if })").contains("`if` is a word the grammar has taken, so a shorthand has no name it could read"))
    assert(fails("val o = { a: 1 }\nprint(o with { \"a.b\" })").contains("`a.b` is not a name, so this has to say what its value is"))
    assert(fails("val x = 1\nval o = { a: 1 }\nprint(o with { x? })").contains("`x?` is a pattern's spelling"))

    // The written-out forms stay perfectly ordinary there too.
    assert_eq(out("val o = { a: 1 }\nprint((o with { if: 2 }).if, o with { \"a.b\": 3 })"), "2 {a: 1, \"a.b\": 3}")

@test
a_trailing_comma_is_allowed_in_every_list()
    assert_eq(out("f(a, b,) = a + b\nprint([1, 2,], { x: 1, }, f(1, 2,))"), "[1, 2] {x: 1} 3")
    assert_eq(out("val g = (a, b,) -> a + b\nprint(g(1, 2))"), "3")
    assert_eq(out("[1, 2,] match\n    [a, b,] -> print(a + b)"), "3")

@test
a_string_may_carry_the_values_written_into_it()
    assert_eq(out("val n = 5\nprint(s\"n is ${n}\")"), "n is 5")
    assert_eq(out("val a = 1\nval b = 2\nprint(s\"${a} and ${b} make ${a + b}\")"), "1 and 2 make 3")
    assert_eq(out("print(s\"plain\", s\"\")"), "plain ")

    // A hole renders as `print` would, so a container shows its contents.
    assert_eq(out("print(s\"${[1, 2]} ${null}\")"), "[1, 2] null")

    // **`s` is only a prefix where a quote follows**, so it stays an ordinary name.
    assert_eq(out("val s = 5\nprint(s)"), "5")

    // A doubled sigil is a literal one, which is the only way to write a `${` where a hole would
    // otherwise open. `sh.sysl.parsing` owns that rule, which is why it is Scala's spelling.
    assert_eq(out("print(s\"a $${x} b\")"), "a ${x} b")

    assert(fails("print(s\"unclosed ${x\")").contains("without closing"))

@test
A_BARE_NAME_NEEDS_NO_BRACES()
    // **Scala's short form, and the one a program reaches for most**, a hole being a single name far
    // more often than it is an expression.

    assert_eq(out("val w = 3\nval h = 4\nprint(s\"$w by $h\")"), "3 by 4")
    assert_eq(out("val w = 3\nval h = 4\nprint(s\"$w by $h\")"), out("val w = 3\nval h = 4\nprint(s\"${w} by ${h}\")"))
    assert_eq(out("val w = 3\nval h = 4\nprint(s\"$w$h\")"), "34")
    assert_eq(out("val w = 3\nval h = 4\nprint(s\"a $w and ${h + 1}\")"), "a 3 and 5")

@test
A_DOUBLED_SIGIL_IS_STILL_A_LITERAL_ONE_NOW_THAT_A_BARE_NAME_INTERPOLATES()
    // **The pair the whole thing turns on, and getting it wrong would be SILENT.** `$$w` and `$w`
    // decode to the same three characters, so this could never have been done by post-processing
    // what the reader answers -- the byte that separates them is gone by then. It is why
    // `read_interpolated_named` exists in `sh.sysl.parsing` rather than here.

    assert_eq(out("val w = 3\nprint(s\"$$w is not $w\")"), "$w is not 3")

@test
A_BARE_NAME_STOPS_AT_THE_END_OF_THE_NAME()
    // Identifier-only, as Scala's is: `$point.x` interpolates `point` and then reads `.x` as text,
    // and `${point.x}` is how a program says the other thing. Where a hole stops keeps one answer.

    assert_eq(out("val point = { x: 7 }\nprint(s\"$point.x\")"), "{x: 7}.x")
    assert_eq(out("val point = { x: 7 }\nprint(s\"${point.x}\")"), "7")

@test
A_SIGIL_THAT_BEGINS_NO_NAME_IS_ORDINARY_TEXT()
    // A trailing `$`, and a `$` before a digit or a space. None of them opens a hole, so a price and
    // a shell snippet still read as themselves.

    assert_eq(out("print(s\"costs 5$\")"), "costs 5$")
    assert_eq(out("print(s\"$ x\", s\"$1\")"), "$ x $1")

@test
A_COMPLAINT_ABOUT_A_BARE_NAME_POINTS_AT_THE_NAME()
    // The hole's span covers exactly the name, so the caret sits under it rather than under the
    // string it was written in.

    val said = fails("print(s\"a $nope b\")")

    assert(said.contains("`nope` is not defined"))
    assert(said.contains("^^^^"))

@test
a_hole_may_hold_anything_an_expression_may()
    assert_eq(out("print(s\"got ${ \"a}b\" } end\")"), "got a}b end")
    assert_eq(out("print(s\"o = ${ { a: 1 } }\")"), "o = {a: 1}")
    assert_eq(out("val n = 2\nprint(s\"outer ${ s\"inner ${n}\" }\")"), "outer inner 2")
    assert_eq(out("print(s\"${ if true then \"yes\" else \"no\" }\")"), "yes")

@test
a_complaint_inside_a_hole_points_at_the_hole()
    // **The reason a hole is parsed against a source padded out to its own offset.** Lexing its text
    // on its own would give spans measured from the hole, so every diagnostic in an interpolation
    // would name a column nobody could find.
    val said = fails("val a = 1\nprint(s\"x ${nope} y\")")

    assert(said.contains("`nope` is not defined"))
    assert(said.contains("2 | print(s\"x ${nope} y\")"))

@test
a_hole_with_nothing_in_it_complains_about_itself()
    // **It used to complain about the end of the file.** The sub-source a hole is parsed against is
    // the whole input with everything outside the hole blanked, so an empty hole lexes to one `Eof`
    // at the end of the *file* -- and the complaint pointed there, which for a string on line one
    // was `found the end of the file` at line three, under a blank line. True, and nowhere useful.
    val spaced = fails("val greeting = s\"hello ${ }\"")

    assert(spaced.contains("this interpolation has nothing in it"))
    assert(spaced.contains("1 | val greeting = s\"hello ${ }\""))
    assert(!spaced.contains("the end of the file"))

    // And with no space in it at all, which lexes to a different token stream.
    assert(fails("print(s\"a${}b\")").contains("this interpolation has nothing in it"))

