module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// What a statement leaves behind, read off the emitted code.
//
// **A STATEMENT WHOSE VALUE NOBODY READS PRODUCES NONE, AND NO TEST ABOUT ANSWERS CAN SEE THAT.**
// Every program here answers exactly what it always answered, so a build that went back to pushing a
// null for every statement and discarding it again would be green in `tests/lang/` and everywhere
// else. These count the instructions instead.
//
// It is `tests_slots.sysl`'s argument aimed at a different decision, and it is a file of its own
// because slots and statement values are two subjects that happen to share one way of being asked.
//
// **A NAME BELONGS TO TWO CHUNKS AND THE ANSWER IS THE LARGER, WHICH IS NOT A CONVENIENCE.**
// `compile_module` compiles a file twice -- once whole and once as its declarations alone -- so a
// top-level definition has two chunks of one name that are copies of each other, and a MODULE has
// its own chunk beside a declarations-only one that holds a subset of its statements. Reading the
// first match answers a module's question about the empty one, which is nought whatever the
// compiler did: the way a test of this kind rots without ever going red. The declarations are a
// subset either way, so the largest count is the real one.

// How many of the three bookkeeping instructions the chunk of that name carries.
//
// **`Discard` and `Pop` are counted together** because which one a site uses is about a dropped
// promise rather than about bookkeeping: what these tests are watching is whether a value was made
// only to be taken away again.
private bookkeeping(program: string, name: string) -> usize
    out(program)

    var most: usize = 0
    var found = false

    for i in 0..<running_unit().chunks.len()
        if running_unit().chunks.at(i).name != name then continue

        found = true

        val code = running_unit().chunks.at(i).code
        var n: usize = 0

        for k in 0..<code.len()
            code.at(k).op match
                PushNull -> n += 1
                Discard -> n += 1
                Pop -> n += 1
                _ -> ()

        if n > most then most = n

    assert(found, s"no chunk is called `${name}`")
    most
end bookkeeping

// How many values that chunk MAKES only to take away again: a `PushNull` pushed for a statement, and
// a `Discard` that drops one.
//
// **`Pop` IS DELIBERATELY NOT COUNTED HERE WHERE `bookkeeping` COUNTS IT.** A `match` arm `Pop`s the
// SUBJECT -- a value the program computed and the arm that took is finished with -- and counting
// that would hide the question these ask, which is whether a value was made for nobody at all.
private made_for_nobody(program: string, name: string) -> usize
    out(program)

    var most: usize = 0
    var found = false

    for i in 0..<running_unit().chunks.len()
        if running_unit().chunks.at(i).name != name then continue

        found = true

        val code = running_unit().chunks.at(i).code
        var n: usize = 0

        for k in 0..<code.len()
            code.at(k).op match
                PushNull -> n += 1
                Discard -> n += 1
                _ -> ()

        if n > most then most = n

    assert(found, s"no chunk is called `${name}`")
    most
end made_for_nobody

// How many `Tick`s that chunk carries.
//
// **The rule it reads is one safe point per statement that is not inside a loop's body, plus one at
// the top of each loop** -- so a loop's answer does not move with the size of its body.
private ticks(program: string, name: string) -> usize
    out(program)

    var most: usize = 0
    var found = false

    for i in 0..<running_unit().chunks.len()
        if running_unit().chunks.at(i).name != name then continue

        found = true

        val code = running_unit().chunks.at(i).code
        var n: usize = 0

        for k in 0..<code.len()
            code.at(k).op match
                Tick -> n += 1
                // A counted loop's head is folded into one instruction that still takes the
                // loop's safe point first, so it counts as the `Tick` it stands over.
                TickSlotIntLess(_, _) -> n += 1
                _ -> ()

        if n > most then most = n

    assert(found, s"no chunk is called `${name}`")
    most
end ticks

// Two assignments in a loop body and two bindings above it, none of whose values anybody reads.
private val LoopBody: string = "f()\n    var total = 0\n    var i = 0\n\n    while i < 3\n        total = total + i\n        i = i + 1\n\n    total\nprint(f())"

@test
A_LOOP_BODY_OF_PLAIN_STATEMENTS_MAKES_NO_VALUE_FOR_ANYBODY_TO_THROW_AWAY()
    // What is left is the loop's own answer and the statement that drops it: `while` is an
    // expression, so the normal exit pushes the null a `break` would have replaced, and the
    // statement standing in front of `total` drops it. The two bindings, the two assignments in the
    // body and the body itself now produce nothing at all.
    assert_eq(bookkeeping(LoopBody, "f"), 2)

    // Six statements are compiled in that chunk -- four in the body of `f` and two in the loop's, a
    // loop body being part of the chunk around it -- and they carry FIVE safe points: one per
    // statement of `f`, none for the two in the loop's body, and one at the top of the `while` that
    // stands for both of them.
    assert_eq(ticks(LoopBody, "f"), 5)

    assert_eq(out(LoopBody), "3")
end A_LOOP_BODY_OF_PLAIN_STATEMENTS_MAKES_NO_VALUE_FOR_ANYBODY_TO_THROW_AWAY

@test
THE_LAST_STATEMENT_OF_A_FUNCTION_STILL_YIELDS_ITS_VALUE()
    // A binding answers null, and a function whose body ends in one answers null -- so the one place
    // a `val` still pushes anything is where it is the block's own answer.
    val ends_in_a_binding = "g()\n    val a = 1\n\nprint(g())"

    assert_eq(bookkeeping(ends_in_a_binding, "g"), 1)
    assert_eq(out(ends_in_a_binding), "null")

    // And where the same binding is not last, nothing is pushed for it at all.
    val binding_then_a_value = "g()\n    val a = 1\n\n    a + 1\n\nprint(g())"

    assert_eq(bookkeeping(binding_then_a_value, "g"), 0)
    assert_eq(out(binding_then_a_value), "2")
end THE_LAST_STATEMENT_OF_A_FUNCTION_STILL_YIELDS_ITS_VALUE

@test
AN_if_LEAVES_ONE_VALUE_AS_AN_EXPRESSION_AND_NONE_AS_A_STATEMENT()
    // Both arms of an `if` leave the same thing, which is what makes the jump they meet at sound.
    val as_an_expression = "f(n)\n    val v = if n > 0 then \"up\" else \"down\"\n\n    v\n\nprint(f(1))\nprint(f(-1))"

    assert_eq(out(as_an_expression), "up\ndown")

    val as_a_statement = "f(n)\n    var seen = \"none\"\n\n    if n > 0\n        seen = \"up\"\n\n    seen\n\nprint(f(1))\nprint(f(-1))"

    // **NOT ONE INSTRUCTION IS SPENT ON A VALUE NOBODY ASKED FOR.** The branch that takes leaves
    // nothing, the branch nobody wrote pushes no null to stand for it -- so the jump over it is not
    // emitted either -- and the statement has nothing left to drop. It cost three.
    assert_eq(bookkeeping(as_a_statement, "f"), 0)

    // One safe point per statement, exactly where they were: **a branch is not a cycle**, so an `if`
    // changes nothing about where they go. Three in the body of `f` and one for the assignment
    // inside the branch.
    assert_eq(ticks(as_a_statement, "f"), 4)
    assert_eq(out(as_a_statement), "up\nnone")

    // **AND THE SAME `if` AS THE BODY'S ANSWER STILL PRODUCES ONE**, which is the half of this that
    // would go wrong in silence: the branch nobody wrote has to push the null a reader gets.
    val as_the_answer = "f(n)\n    if n > 0\n        \"up\"\n\nprint(f(1))\nprint(f(-1))"

    assert_eq(bookkeeping(as_the_answer, "f"), 1)
    assert_eq(out(as_the_answer), "up\nnull")
end AN_if_LEAVES_ONE_VALUE_AS_AN_EXPRESSION_AND_NONE_AS_A_STATEMENT

@test
A_match_AS_A_STATEMENT_MAKES_NO_VALUE_AND_AS_AN_ANSWER_STILL_DOES()
    // The same program twice, differing only in whether a line below the `match` reads a name --
    // which is the whole of what the compiler is deciding on.
    val arms = "f(n)\n    var seen = \"none\"\n\n    n match\n        0 -> seen = \"zero\"\n        _ -> seen = \"other\"\n"

    val as_a_statement = arms + "\n    seen\n\nprint(f(0))\nprint(f(1))"
    val as_the_answer = arms + "\nprint(f(0))\nprint(f(1))"

    assert_eq(made_for_nobody(as_a_statement, "f"), 0)
    assert_eq(out(as_a_statement), "zero\nother")

    // Two nulls, one per arm: an assignment answers null, and here that null is the `match`'s own
    // answer and the function's.
    assert_eq(made_for_nobody(as_the_answer, "f"), 2)
    assert_eq(out(as_the_answer), "null\nnull")
end A_match_AS_A_STATEMENT_MAKES_NO_VALUE_AND_AS_AN_ANSWER_STILL_DOES

@test
A_try_AS_A_STATEMENT_MAKES_NO_VALUE_AND_AS_AN_ANSWER_STILL_DOES()
    val guarded = "f(go)\n    var seen = \"none\"\n\n    try\n        if go\n            throw \"boom\"\n\n        seen = \"ran\"\n    catch e\n        seen = \"caught\"\n"

    val as_a_statement = guarded + "\n    seen\n\nprint(f(false))\nprint(f(true))"
    val as_the_answer = guarded + "\nprint(f(false))\nprint(f(true))"

    assert_eq(made_for_nobody(as_a_statement, "f"), 0)
    assert_eq(out(as_a_statement), "ran\ncaught")

    // One null for the body's last statement and one for the handler's, which is what the two ways
    // out of a `try` owe each other where somebody reads the answer.
    assert_eq(made_for_nobody(as_the_answer, "f"), 2)
    assert_eq(out(as_the_answer), "null\nnull")
end A_try_AS_A_STATEMENT_MAKES_NO_VALUE_AND_AS_AN_ANSWER_STILL_DOES

@test
AN_UNREAD_CONSTRUCT_INSIDE_AN_UNREAD_CONSTRUCT_MAKES_NOTHING_EITHER()
    // **UNREADNESS TRAVELS INWARD**, a branch being a block whose last statement is asked for
    // exactly what the construct standing around it was asked for. Without that the inner `if` would
    // make a value, the outer branch would carry it, and the saving would stop one level down.
    val nested = "f(a, b)\n    var out = \"?\"\n\n    if a\n        if b\n            out = \"both\"\n        else\n            out = \"first\"\n\n    out\n\nprint(f(true, true))\nprint(f(true, false))\nprint(f(false, false))"

    assert_eq(bookkeeping(nested, "f"), 0)
    assert_eq(ticks(nested, "f"), 6)
    assert_eq(out(nested), "both\nfirst\n?")
end AN_UNREAD_CONSTRUCT_INSIDE_AN_UNREAD_CONSTRUCT_MAKES_NOTHING_EITHER

@test
A_MODULE_BUILDS_NO_VALUE_FOR_A_STATEMENT_OF_ITS_OWN()
    // A module answers with the object its exports are gathered into rather than with its last
    // statement, so every statement at the top level of a file is unread.
    //
    // **The one instruction left is the `Discard` that takes the CALL's answer**, and that is the
    // line between the two halves of this: a binding computes nothing to drop, and `print` answers
    // something whatever is done with it. A dropped value still goes through `Discard` rather than
    // `Pop`, which is what reports a promise nobody waited on.
    val plain = "val a = 1\nval b = 2\nval c = a + b\nprint(c)"

    assert_eq(bookkeeping(plain, "t"), 1)

    // Four statements at the top of the file and no loop, so four safe points: a statement outside
    // a loop keeps its own.
    assert_eq(ticks(plain, "t"), 4)
    assert_eq(out(plain), "3")
end A_MODULE_BUILDS_NO_VALUE_FOR_A_STATEMENT_OF_ITS_OWN

// **A LOOP'S BODY GIVES ITS STATEMENTS' SAFE POINTS UP TO THE LOOP'S OWN, AND THE COUNT THEREFORE
// DOES NOT MOVE WITH THE SIZE OF THE BODY.** That is the whole of the change and it is what these
// read: the same loop with one statement in it and with four compiles to the same number of `Tick`s.
@test
A_LOOP_BODYS_STATEMENTS_GIVE_THEIR_SAFE_POINTS_UP_TO_THE_LOOPS_OWN()
    val one = "f()\n    var n = 0\n    var i = 0\n\n    while i < 3\n        i = i + 1\n\n    n\n\nprint(f())"
    val four = "f()\n    var n = 0\n    var i = 0\n\n    while i < 3\n        i = i + 1\n        n = n + 1\n        n = n + 2\n        n = n + 3\n\n    n\n\nprint(f())"

    assert_eq(ticks(one, "f"), ticks(four, "f"))

    // Four statements in `f` -- the two bindings, the `while` and the answer -- and one more at the
    // top of the loop.
    assert_eq(ticks(one, "f"), 5)
    assert_eq(out(one), "0")
    assert_eq(out(four), "18")

    // **And a statement OUTSIDE a loop still costs one each**, which is the half that was kept: two
    // more statements are two more safe points.
    val three = "f()\n    var a = 1\n    var b = 2\n    var c = 3\n\n    a + b + c\n\nprint(f())"
    val five = "f()\n    var a = 1\n    var b = 2\n    var c = 3\n    var d = 4\n    var e = 5\n\n    a + b + c + d + e\n\nprint(f())"

    assert_eq(ticks(five, "f") - ticks(three, "f"), 2)
end A_LOOP_BODYS_STATEMENTS_GIVE_THEIR_SAFE_POINTS_UP_TO_THE_LOOPS_OWN

// **EVERY LOOP FORM PUTS ITS SAFE POINT WHERE BOTH THE BACK EDGE AND A `continue` LAND**, which is
// the placement the whole guarantee rests on: written at the back edge instead, a body ending in
// `continue` would go round for ever without reaching one. A `do` loop is the one where the two are
// different instructions -- it repeats from the top and continues at the test -- so its safe point
// is at the test.
@test
EACH_LOOP_FORM_GIVES_ITS_BODY_ONE_SAFE_POINT_AND_KEEPS_ITS_CONTROL_FLOW()
    // The same six turns under each of the four, each with a `continue` in it so that the placement
    // is the one being read rather than the easy one.
    val whiled = "f()\n    var i = 0\n    var n = 0\n\n    while i < 6\n        i = i + 1\n\n        if i == 3\n            continue\n\n        n = n + i\n\n    n\n\nprint(f())"
    val looped = "f()\n    var i = 0\n    var n = 0\n\n    loop\n        i = i + 1\n\n        if i > 6\n            break n\n\n        if i == 3\n            continue\n\n        n = n + i\n\nprint(f())"
    val repeated = "f()\n    var i = 0\n    var n = 0\n\n    do\n        i = i + 1\n\n        if i == 3\n            continue\n\n        n = n + i\n    while i < 6\n\n    n\n\nprint(f())"
    val walked = "f()\n    var n = 0\n\n    for i in 1..6\n        if i == 3\n            continue\n\n        n = n + i\n\n    n\n\nprint(f())"

    // Whatever their bodies hold, each is its chunk's statements plus one.
    assert_eq(ticks(whiled, "f"), 5)
    assert_eq(ticks(looped, "f"), 4)
    assert_eq(ticks(repeated, "f"), 5)
    assert_eq(ticks(walked, "f"), 4)

    // 1 + 2 + 4 + 5 + 6: the `continue` skipped 3 and did not skip the turn after it, which is what
    // says an instruction put at the jump target left the control flow where it was.
    assert_eq(out(whiled), "18")
    assert_eq(out(looped), "18")
    assert_eq(out(repeated), "18")
    assert_eq(out(walked), "18")
end EACH_LOOP_FORM_GIVES_ITS_BODY_ONE_SAFE_POINT_AND_KEEPS_ITS_CONTROL_FLOW

@test
A_NESTED_LOOP_CARRIES_ONE_SAFE_POINT_PER_LOOP()
    // The inner loop is a statement of the outer one's body, so it carries none of its own as a
    // statement -- and it still puts one at its own top, or a body that never ends would reach none.
    val two = "f()\n    var n = 0\n    var i = 0\n\n    while i < 3\n        var j = 0\n        i = i + 1\n\n        while j < 3\n            j = j + 1\n            n = n + 1\n\n    n\n\nprint(f())"

    // Four statements in `f`, and one at the top of each of the two loops.
    assert_eq(ticks(two, "f"), 6)
    assert_eq(out(two), "9")
end A_NESTED_LOOP_CARRIES_ONE_SAFE_POINT_PER_LOOP

// **COUNTING THE INSTRUCTIONS SAYS WHERE A SAFE POINT WAS PUT AND NOT THAT IT IS ENOUGH OF THEM**,
// so these run programs whose only cycle is the one under test against a heap small enough that the
// schedule has to be asked. `heap_limit` is read at a safe point and nowhere else, so a cycle that
// reaches none runs straight past the ceiling it was given: a program that is told it has run out of
// a megabyte is a program that got there.
private const AMegabyte: usize = 1048576
private const TheUsualHeap: usize = 268435456

// Something to fill a megabyte with, and the shape `tests_async.sysl` already fills one with.
private const Holding: string = "push(kept, { a: i, b: [i, i, i], c: \"x\" + string(i) })"

// What a program PRINTED in a heap small enough to collect under it. `tests_kit.sysl`'s
// `in_small_heap` is the other half and answers what a program that ran OUT said.
//
// **The limit is put back whatever happened**, or everything after this runs in a megabyte.
private answered_in_a_megabyte(text: string) -> string
    set_heap_limit(AMegabyte)

    val said = out(text)

    set_heap_limit(TheUsualHeap)
    said
end answered_in_a_megabyte

@test
A_LOOP_WHOSE_BODY_CARRIES_NO_SAFE_POINT_OF_ITS_OWN_IS_STILL_BOUNDED()
    // The body's statements have none, so the `while`'s own is the only thing between this program
    // and a megabyte it was told to stay inside.
    val retains = "var kept = []\nvar i = 0\n\nwhile i < 40000\n    " + Holding + "\n    i = i + 1\n\nprint(kept.length)"

    assert(in_small_heap(retains).contains("run out of memory"),
        "the safe point at the top of a `while` is what reads the ceiling for its whole body")

    // And the same loop dropping what it makes runs to the end in that megabyte, which is the
    // collector being asked at the top of every turn.
    val drops = "var n = 0\nvar i = 0\n\nwhile i < 40000\n    val o = [i, i, i]\n    n = n + o[0]\n    i = i + 1\n\nprint(n)"

    assert_eq(answered_in_a_megabyte(drops), "799980000")
end A_LOOP_WHOSE_BODY_CARRIES_NO_SAFE_POINT_OF_ITS_OWN_IS_STILL_BOUNDED

@test
AN_UNCONDITIONAL_LOOP_IS_STILL_INTERRUPTIBLE()
    // `loop` with nothing in its body that carries a safe point: the one the guarantee is usually
    // stated about, and the one that would spin for ever uncollected if the top of it had none.
    val forever = "var kept = []\nvar i = 0\n\nloop\n    " + Holding + "\n    i = i + 1\n\n    if i > 40000\n        break\n\nprint(kept.length)"

    assert(in_small_heap(forever).contains("run out of memory"),
        "a `loop` reaches a safe point every turn, so it can be stopped from outside its own body")
end AN_UNCONDITIONAL_LOOP_IS_STILL_INTERRUPTIBLE

// **A CHUNK WHOSE BODY IS ONE EXPRESSION NEVER GOES THROUGH `compile_stmts`, SO IT USED TO CARRY NO
// SAFE POINT AT ALL.** A loop is not the only cycle a program can write: a recursion is one too, and
// one written through expression bodies reached nothing that asks the collector or reads the
// ceiling. It carries one at its head now, which is what makes the rule read *every chunk passes a
// safe point before it can recurse*.
@test
A_CHUNK_WHOSE_BODY_IS_ONE_EXPRESSION_CARRIES_ONE_SAFE_POINT()
    val expressed = "f(n) = n > 0 && f(n - 1)\nprint(f(3))"

    assert_eq(ticks(expressed, "f"), 1)
    assert_eq(out(expressed), "false")

    // A lambda is the same chunk written another way, and it is the shape a callback arrives in.
    val lambda = "val scale = 3\nval g = (v) -> v * scale\nprint(g(4))"

    assert_eq(ticks(lambda, "a function"), 1)
    assert_eq(out(lambda), "12")

    // **And a BLOCK body gains nothing**, its first statement's safe point already standing at the
    // chunk's head: two statements, two safe points, exactly what it carried before.
    val blocked = "f(n)\n    val m = n\n    m > 0 && f(m - 1)\n\nprint(f(3))"

    assert_eq(ticks(blocked, "f"), 2)
    assert_eq(out(blocked), "false")
end A_CHUNK_WHOSE_BODY_IS_ONE_EXPRESSION_CARRIES_ONE_SAFE_POINT

// Something to fill a megabyte with, made and answered by expression bodies alone.
private const Making: string = "make(n) = { a: n, b: [n, n, n], c: \"x\" + string(n) }\n"

@test
A_RECURSION_THROUGH_EXPRESSION_BODIES_IS_STILL_BOUNDED()
    // Nothing in this cycle is a statement -- a `||`, an `&&` and a call -- and every frame KEEPS
    // what it made, the chain being reachable from the deepest one. `heap_limit` is read at a safe
    // point and nowhere else, so a recursion that reached none would run straight past the megabyte
    // it was given and answer.
    val keeps = Making + "keep(n, held) = n <= 0 || keep(n - 1, [held, make(n)])\nprint(keep(6000, []))"

    assert(in_small_heap(keeps).contains("run out of memory"),
        "the safe point at the head of an expression-bodied chunk is what reads the ceiling for a recursion through one")

    // And the same recursion DROPPING what it makes runs to the end inside that megabyte, which is
    // the collector being asked once per call rather than never.
    val drops = Making + "step(n) = n <= 0 || (make(n).a >= 0 && step(n - 1))\nprint(step(6000))"

    assert_eq(answered_in_a_megabyte(drops), "true")
end A_RECURSION_THROUGH_EXPRESSION_BODIES_IS_STILL_BOUNDED

@test
A_RECURSION_THROUGH_EXPRESSION_BODIES_IS_STILL_INTERRUPTIBLE()
    // `AN_UNCONDITIONAL_LOOP_IS_STILL_INTERRUPTIBLE`'s twin: a recursion with no end written into
    // it, through a lambda whose body is one expression. **What it answers is what tells the two
    // builds apart** -- reaching a safe point every call, it is stopped by the ceiling; reaching
    // none, it would run until the call-depth limit caught it instead and say so.
    val forever = Making + "val go = (n, held) -> go(n + 1, [held, make(n)])\nprint(go(0, []))"

    assert(in_small_heap(forever).contains("run out of memory"),
        "a recursion through expression bodies reaches a safe point every call, so it can be stopped from outside its own cycle")
end A_RECURSION_THROUGH_EXPRESSION_BODIES_IS_STILL_INTERRUPTIBLE
