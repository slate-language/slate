36 1086f2b20a4b0a9f839ed44f1086f2b20a4b0a9f839ed44f4085f2b1eb2d5f83a0f6c9be [["x-secret","hush"],["x-secret","hush"],["x-open","loud"],["x-open","loud"]]
60 049b606c772d9e98a0f54cc5634cec2671a583218a8e960d5485f2593f0f0d8208990f1304227631220f1f022f780f0601350f1a01710f1903547565 [[":path","/a/very/long/path/that/is/not/indexed"],["content-length","123"],["etag","\"v1\""],["location","/x"],["age","5"],["if-none-match","q"],["if-modified-since","Tue"]]
48 4086f2b47e92547f0dc3bf207769646520c3a920c3bc4005555050455283bc341740842d35a7d700400085a8f50e92ff [["x-bytes","ÿ wide é ü"],["UPPER","Case"],["empty",""],["","noname"]]
