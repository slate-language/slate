-- what an inflater refuses
garbage: {"error":"decoding a header block: Header compression/decompression error"}
then good: {"error":"decoding a header block: Header compression/decompression error"}
index zero: {"error":"decoding a header block: Header compression/decompression error"}
index past the table: {"error":"decoding a header block: Header compression/decompression error"}
cut short: {"error":"decoding a header block: Header compression/decompression error"}
table resize past limit: {"error":"decoding a header block: Header compression/decompression error"}
table resize within: [[":method","GET"]]
empty: []
text faults: `hpackInflate` takes bytes or an array of numbers, and this is a string
bad huffman: {"error":"decoding a header block: Header compression/decompression error"}
deflate a number faults: `hpackDeflate` takes the headers as an object or as pairs, and this is an integer
deflate a decoder faults: `hpackDeflate` was given something that is not an encoder
inflate an encoder faults: `hpackInflate` was given something that is not a decoder
deflater a string faults: `hpackDeflater` takes a count of bytes, and this is a string
deflater negative faults: `hpackDeflater` takes a count of bytes, and this is -1
inflater an argument faults: `hpackInflater` takes nothing, and was given 1 argument
deflate arity faults: `hpackDeflate` takes an encoder and the headers, and was given 1 argument
inflate a number faults: `hpackInflate` takes bytes or an array of numbers, and this is an integer
close nothing faults: `hpackClose` takes an encoder or a decoder, and was given 0 arguments
close a number: null
closed encoder faults: this encoder has been closed
close again: null
closed decoder faults: this decoder has been closed
-- client oddities
respond stream on a client faults: `h2RespondStream` could not be sent: submitting a response: Protocol error
request stream on a server faults: `h2RequestStream` could not be sent: submitting a request: Protocol error
push: null
finish with trailers: null
push after finish: {"error":"the body on stream 1 has been finished, so there is nothing to add to"}
finish again: null
consume: null
consume an unknown stream: null
request a number body faults: a byte is between 0 and 255, and this is 300
"""

@test
JS_H2_HPACK_ENCODES_BYTE_FOR_BYTE_AS_NGHTTP2_AND_REFUSES_AS_IT_DOES_ON_BOTH_HOSTS()
    val want = HpackAnswered.trim()

    assert_eq(out(HpackSource).trim(), want)
    assert_eq(node_said(HpackSource).trim(), want)

// -- the page --------------------------------------------------------------------------------------

// The fenced blocks of `docs/library/nghttp2.md`, inside and outside alternately.
private page_parts() -> []string = split(from_utf8(read_bytes("docs/library/nghttp2.md").unwrap()).unwrap(), "```")

// The page's `slate` block holding `marker` -- or, with `answer`, the `output` block under it.
private page_block(marker: string, answer: bool) -> string
    val parts = page_parts()
    var found = false

    for i in 0..<parts.len
        val lines = split(parts[i], "\n")

        if !found && lines[0] == "slate" && parts[i].contains(marker)
            found = true

            if !answer then return block_body(lines)
        elif found && lines[0] == "output"
            return block_body(lines)

    ""
end page_block

private block_body(lines: []string) -> string
    var b = str_builder()

    for i in 1..<lines.len
        b.push(lines[i])
        b.push("\n")

    b.finish().trim()
end block_body

// **The page's two runnable programs run under node too**, against the very `output` block the docs
// suite holds the interpreter to: a client and a server talking in memory, and HPACK on its own.
@test
JS_H2_THE_nghttp2_PAGE_RUNS_UNDER_NODE_AS_IT_RUNS_IN_THE_INTERPRETER()
    for marker in ["pump(from, to)", "hpackDeflater()"]
        val program = page_block(marker, false)
        val want = page_block(marker, true)

        assert(program.contains("slate:nghttp2"))
        assert(want != "")
        assert_eq(out(program).trim(), want)
        assert_eq(node_said(program).trim(), want)

// -- over TLS, against node's own server -------------------------------------------------------------

// A JavaScript client over a real TLS connection to node's `http2` server: six requests at once (a
// body, a 100 KB upload that needs the server's credit, trailers, a 200 KB download that needs the
// client's, a 404, and a body written in pieces), then SETTINGS, a WINDOW_UPDATE and a PING, then a
// stream reset mid-body, then a GOAWAY. What each stream heard is printed in a fixed order once all
// have closed, and the server prints what it was asked, sorted, so nothing depends on timing.
private val TlsClientSource: string = raw"""
import { connect, onBytes, send, close, startTls, alpnProtocol } from slate:net
import { args, exit } from slate:process
import { readFileSync } from slate:fs
import { h2Client, h2Receive, h2Send, h2Next, h2Request, h2RequestStream, h2Push, h2Finish, h2Ping, h2Settings, h2WindowUpdate, h2Wants, h2Goaway, h2Reset, h2Close } from slate:nghttp2

val theCert = readFileSync("tests/tls/cert.pem").value

stalled()
    print("watchdog: the client did not finish")
    exit(3)

val guard = setTimeout(stalled, 20000)

async main()
    val c = (await connect("localhost", number(args[0]))).value
    val h = h2Client()
    val order = ["hello", "echo", "trailers", "big", "missing", "upload"]
    var names = {}
    var heads = {}
    var sizes = {}
    var results = {}
    var open = 0
    var stage = 0

    ask(name, method, path, body = null)
        val stream = h2Request(h, [[":method", method], [":scheme", "https"], [":authority", "localhost"], [":path", path], ["x-custom", name]], body)

        names[string(stream)] = name
        open = open + 1

        stream

    heard(e)
        val k = string(e.stream ?? 0)
        val name = names[k] ?? null

        if e.kind == "headers" && name != null
            heads[k] = (heads[k] ?? "") + e.of + " " + e.headers.filter(p -> p[0] != "date").map(p -> p[0] + "=" + p[1]).join(" ") + "; "
        elif e.kind == "data" && name != null
            sizes[k] = (sizes[k] ?? 0) + e.bytes.length
        elif e.kind == "ping"
            print("ping ack " + string(e.ack))

            if e.ack && stage == 1
                stage = 2

                val doomed = h2RequestStream(h, [[":method", "POST"], [":scheme", "https"], [":authority", "localhost"], [":path", "/reset"]])

                names[string(doomed)] = "reset"
                h2Push(h, doomed, "never finished")
                h2Reset(h, doomed, 8)
        elif e.kind == "streamClose" && name == "reset"
            print("reset closed " + string(e.code))
            h2Goaway(h, 0, 0)
            stage = 3
        elif e.kind == "streamClose" && name != null
            results[name] = (heads[k] ?? "") + string(sizes[k] ?? 0) + " bytes, closed " + string(e.code)
            open = open - 1

            if open == 0 && stage == 0
                for n in order
                    print(n + ": " + results[n])

                stage = 1
                h2Settings(h, { initialWindowSize: 1000000 })
                h2WindowUpdate(h, 0, 100000)
                h2Ping(h)

    turn()
        loop
            val e = h2Next(h)

            if e != null
                heard(e)
            else
                val out = h2Send(h)

                if out.length == 0 then break

                send(c, out)

        if stage == 3
            val w = h2Wants(h)

            print("wants read " + string(w.read) + " write " + string(w.write))
            h2Close(h)
            close(c)
            clearTimeout(guard)
            stage = 4

    arrived(chunk)
        if chunk == null || stage == 4 then return

        val said = h2Receive(h, chunk)

        if said != null then print("refused " + said.error)

        turn()

    onBytes(c, arrived)

    await startTls(c, { host: "localhost", trust: theCert, alpn: ["h2"] })

    print("alpn " + alpnProtocol(c))

    ask("hello", "GET", "/hello")
    ask("echo", "POST", "/echo", "e".repeat(100000))
    ask("trailers", "GET", "/trailers")
    ask("big", "GET", "/big")
    ask("missing", "GET", "/nowhere")

    val up = h2RequestStream(h, [[":method", "PUT"], [":scheme", "https"], [":authority", "localhost"], [":path", "/echo"], ["x-custom", "upload"]])

    names[string(up)] = "upload"
    open = open + 1
    h2Push(h, up, "piece one ")
    h2Push(h, up, toBytes("two"))
    h2Finish(h, up)
    turn()

main()
"""

// What the client printed, and what node's server was asked.
private tls_client_said() -> string
    val src = probe_path("js-h2-client")
    val out_js = src + ".js"

    write_text(src, TlsClientSource).unwrap()

    if cli_status(["slate", "js", src, "-o", out_js]) != 0
        // Best-effort cleanup: a temp file left behind is not a test failure.
        _ = remove_file(src)

        return "the client would not compile"

    val ran = capture("node", ["tests/tls/h2_probe.js", "--client", out_js], "", [], true, 120000)

    // Best-effort cleanup: a temp file left behind is not a test failure.
    _ = remove_file(src)
    _ = remove_file(out_js)

    ran match
        Err(e) -> s"node could not be started: ${e}"
        Ok(o) -> if o.status.ok() then o.text.trim() else o.err.unwrap_or("").trim()
end tls_client_said

@test
JS_H2_A_SLATE_CLIENT_UNDER_NODE_TALKS_HTTP_2_TO_NODES_OWN_SERVER_OVER_TLS()
    assert_eq(tls_client_said(), "alpn h2\n" +
        "hello: response :status=200 content-type=text/plain; 15 bytes, closed 0\n" +
        "echo: response :status=200 x-seen=100000; 100000 bytes, closed 0\n" +
        "trailers: response :status=200; trailer x-done=yes; 13 bytes, closed 0\n" +
        "big: response :status=200; 200000 bytes, closed 0\n" +
        "missing: response :status=404; 0 bytes, closed 0\n" +
        "upload: response :status=200 x-seen=13; 13 bytes, closed 0\n" +
        "ping ack true\n" +
        "reset closed 8\n" +
        "wants read false write false\n" +
        "asked GET /big 0 big\n" +
        "asked GET /hello 0 hello\n" +
        "asked GET /nowhere 0 missing\n" +
        "asked GET /trailers 0 trailers\n" +
        "asked POST /echo 100000 echo\n" +
        "asked PUT /echo 13 upload")

#endif
