module dev.slatelang.slate
@tests

import sysl.buf.{Buf, buf}
import sysl.text.{Search, str_builder}

// What a slate value holds OUTSIDE the collected heap, and the two things that used to be blind to
// it: the collection schedule and the ceiling.
//
// **A cell is small and what it owns is not.** A `StrObj` is a few words owning a sysl `string`, an
// `ArrayObj` a `Buf`, a `BytesObj` its bytes -- so a program moving megabyte buffers moved
// `gc.live_size` by almost nothing, no collection was ever due, and the garbage piled up until the
// operating system noticed. `Vm.payload` is the count and `obj.sysl`'s `charge`/`credit` keep it.
//
// **The invariant every one of these is really about is that a charge has a credit.** A charge with
// no credit grows for ever and ends in either collect-every-statement or a false out-of-memory, so
// the first test here is the one to read: after building and dropping a great many values of every
// kind, a collection must put the count back exactly where it started.

// A heap for a second VM, big enough that nothing in it runs out by accident.
private const SecondCeiling: usize = 1048576

// And one small enough that a few thousand string cells fill it.
private const ExhaustCeiling: usize = 262144

// A string long enough that its bytes are worth counting beside its cell.
private padded(n: usize) -> string
    var out = str_builder()

    for i in 0..<n
        out.push("payload ")

    out.finish()
end padded

// One round of building a value of every kind that owns storage, and dropping all of them.
//
// **Nothing here is rooted and that is the point** -- a `Value` in a sysl local is invisible to the
// collector, so every object this makes is garbage the moment the call returns.
private a_round_of_garbage(n: usize)
    val s = new_str_scanned(padded(n))
    val a = new_array(buf())
    val b = new_bytes(buf())
    val o = new_object()
    val e = new_env(null)

    var names: Buf[string] = buf()

    for i in 0..<n
        names.push(padded(1) + str(i))

    for i in 0..<n
        array_push(a, Str(s))
        bytes_push(b, 7u8)
        obj_put_name(o, names.at(i), Str(s))
        declare(e, names.at(i), Str(s), true)

    val run_of_bytes = padded(4)

    bytes_extend(b, run_of_bytes.bytes)

    // A closure owns its parameter names, which is the seventh thing a finalizer gives back.
    val c = new_closure(names, 0, e)

    ()
end a_round_of_garbage

@test
EVERY_BYTE_A_VALUE_HOLDS_OUTSIDE_THE_HEAP_IS_CHARGED_AND_GIVEN_BACK()
    reset_vm()
    reset_heap()
    collect_now()

    val start = current().payload

    for round in 0..<40
        a_round_of_garbage(30)

    assert(current().payload > start, "building all of that charged something")

    // **The figure must come back EXACTLY, not nearly.** The mark phase recounts what survived, so
    // anything left over is storage a live object is genuinely holding -- and nothing built above
    // is live.
    collect_now()
    assert_eq(current().payload, start, "a collection puts every byte of dropped payload back")

    // And a second collection over an unchanged live set moves nothing, which is what says the
    // recount is a measurement rather than an accumulation.
    collect_now()
    assert_eq(current().payload, start, "and a second collection over the same live set moves nothing")
end EVERY_BYTE_A_VALUE_HOLDS_OUTSIDE_THE_HEAP_IS_CHARGED_AND_GIVEN_BACK

@test
A_CONTAINER_THAT_GROWS_IS_CHARGED_AND_KEEPS_ITS_STORAGE_WHEN_IT_SHRINKS()
    reset_vm()
    reset_heap()
    collect_now()

    val start = current().payload
    val a = new_array(buf())

    for i in 0..<4000
        array_push(a, Int(long(i)))

    val grown = current().payload

    assert(grown >= start + 4000 * sizeof(Value), "the storage a growing array took is charged")

    // **`pop` and `clear` give a `Buf` no storage back**, so the charge does not fall with the count
    // -- reporting an emptied buffer as costing nothing would be describing pages that are still
    // committed.
    a.items.clear()
    assert_eq(current().payload, grown, "and emptying it gives none of that storage back")

    // What DOES give it back is the object dying, which is what the recount at a collection sees.
    collect_now()
    assert_eq(current().payload, start, "where collecting the array does")
end A_CONTAINER_THAT_GROWS_IS_CHARGED_AND_KEEPS_ITS_STORAGE_WHEN_IT_SHRINKS

@test
TRANSFERRING_A_BUFFER_MOVES_THE_CHARGE_OFF_THE_SENDER()
    reset_vm()
    reset_heap()
    collect_now()

    val start = current().payload
    val b = new_bytes(buf())

    for i in 0..<20000
        bytes_push(b, 3u8)

    val held = current().payload

    assert(held >= start + 20000, "a byte buffer is charged for the bytes it holds")

    // **This is what `transfer` does to the sender**, in `actor_copy.sysl`: the storage goes to the
    // receiver's heap and the sender's buffer is left with none. `clear` would leave the sender
    // holding every page it grew while the receiver held a copy of them.
    bytes_release(b)

    assert_eq(current().payload, start, "and transferring it takes the whole charge off the sender")
    assert_eq(b.data.len(), 0usize, "leaving the sender's buffer empty")
end TRANSFERRING_A_BUFFER_MOVES_THE_CHARGE_OFF_THE_SENDER

@test
A_PROGRAM_THAT_DROPS_MEGABYTE_BUFFERS_COLLECTS_THEM_RATHER_THAN_PILING_THEM_UP()
    // **The witness is the COLLECTION COUNT and not the resident size**, which is the only thing a
    // test can read and is the thing that was wrong: each buffer is one small cell, so `live_size`
    // barely moved, the threshold was never met, and the garbage stayed in the process. Measured
    // before this landed, the same shape of program ran no collection at all and peaked at 1.67 GB
    // over four thousand buffers.
    val said = out(raw"""
        var total = 0

        for i in 0..<200
            val b = toBytes("x".repeat(1048576))
            total += b.length

        print(total)
        """)

    assert_eq(said, "209715200", "the program ran")
    assert(current().collections > 100, s"two hundred megabytes of dropped buffers are collected, and this ran ${str(current().collections)} collections")
end A_PROGRAM_THAT_DROPS_MEGABYTE_BUFFERS_COLLECTS_THEM_RATHER_THAN_PILING_THEM_UP

@test
A_PROGRAM_THAT_DROPS_MEGABYTE_BUFFERS_PEAKS_AT_WHAT_IT_HOLDS_AND_NOT_AT_WHAT_IT_DROPPED()
    // **The count above is a proxy and this is the thing itself.** What was wrong was never the
    // number of collections -- it was 1.67 GB resident over four thousand buffers where nothing was
    // leaked -- and a count moves whenever the schedule is tuned, where a peak is what the schedule
    // is answerable for. `Vm.high_water` is the largest cells-plus-payload `maybe_collect` ever saw
    // stand, so a change that let payload pile up again fails here whatever it did to the count.
    //
    // **The bound is generous on purpose and must not be raised to make a change fit.** The program
    // holds one megabyte at a time and peaks at about 3.2 MB of cells and payload, so anything under
    // a few tens of megabytes says the schedule is following what is live; the failure this is here
    // for is three orders of magnitude away.
    val said = out(raw"""
        var total = 0

        for i in 0..<200
            val b = toBytes("x".repeat(1048576))
            total += b.length

        print(total)
        """)

    assert_eq(said, "209715200", "the program ran")
    assert(current().high_water < 33554432, s"two hundred dropped megabytes peaked at ${str(current().high_water)} bytes of cells and payload")
end A_PROGRAM_THAT_DROPS_MEGABYTE_BUFFERS_PEAKS_AT_WHAT_IT_HOLDS_AND_NOT_AT_WHAT_IT_DROPPED

@test
BUILDING_A_LONG_STRING_BY_REPEATED_JOINS_COLLECTS_A_HANDFUL_OF_TIMES_AND_NOT_ONCE_A_TURN()
    // **A join allocates a string the size of the one it is growing**, so what a turn drops is about
    // what the program is holding -- and a threshold set at a multiple of cells-PLUS-payload is
    // therefore crossed every turn, however much headroom it is given. The floor is what decides it:
    // 256 KiB is thousands of cells and one medium string, so the smallest-worth-collecting that
    // keeps a small program from tracing itself to death did nothing at all for payload.
    //
    // **Measured on this program**: 187 collections with one threshold over the combined figure and
    // 33 with each figure compared against its own, so the bound is that 33 with slack and a build
    // that gives payload back its old floor fails here. `bench/strings` is the same shape at
    // 150,000 turns, where it is 123,925 against 45,627.
    val said = out(raw"""
        var out = ""
        var i = 0

        while i < 4000
            out = out + "x" + string(i % 10)
            i = i + 1

        print(out.length)
        """)

    assert_eq(said, "8000", "the program ran")
    assert(current().collections < 70, s"building a string a piece at a time collects over the garbage and not over the string, and this ran ${str(current().collections)} collections")
end BUILDING_A_LONG_STRING_BY_REPEATED_JOINS_COLLECTS_A_HANDFUL_OF_TIMES_AND_NOT_ONCE_A_TURN

@test
A_HEAP_LIMIT_A_PROGRAM_NAMED_BOUNDS_ITS_PAYLOAD_AND_NOT_ONLY_ITS_CELLS()
    // A megabyte of heap and a four-megabyte buffer: the cells are a handful of words, so nothing
    // about the buffer was visible to the ceiling before this and the program ran happily.
    val said = in_small_heap("val b = toBytes(\"x\".repeat(4194304))\nprint(b.length)")

    assert(said.contains("run out of memory"), s"a named ceiling counts what a value holds outside the heap, and this said: ${said}")

    // **And the default is uncapped**, which is the other half of the decision: `HeapBytes` is a
    // number nobody chose, so charging payload against it would newly refuse a program that reads a
    // large file today.
    assert(!current().payload_capped, "the program's own VM is not payload-capped once the limit is back at the block")
end A_HEAP_LIMIT_A_PROGRAM_NAMED_BOUNDS_ITS_PAYLOAD_AND_NOT_ONLY_ITS_CELLS

@test
A_VALUE_MADE_WHILE_A_SECOND_VM_IS_ENTERED_COMES_OUT_OF_THAT_VMS_HEAP_AND_IS_CHARGED_TO_IT()
    // **Every constructor reads the VM once and hands it on**, to the allocator and to the charge, so
    // the one thing a wrong hand-on could do is put a value in one VM's heap and its bytes on another
    // VM's books. Two VMs are the only way to ask: while the second one is current, none of the
    // program's own figures may move at all.
    reset_vm()
    reset_heap()
    collect_now()

    val mine_payload = current().payload
    val mine_used = heap_used()

    var second = new_vm(SecondCeiling)
    val was = enter(&second)
    val empty = heap_used()
    val s = new_str_scanned(padded(200))
    val counted = s.chars
    val theirs_payload = current().payload
    val theirs_used = heap_used()

    leave(was)
    dispose_vm(&second)

    assert_eq(counted, 1600usize, "the string was built")
    assert(theirs_payload > 0, "its bytes are charged to the VM it was made in")
    assert(theirs_used > empty, "and its cell comes out of that VM's own heap")
    assert_eq(current().payload, mine_payload, "the program's own payload does not move")
    assert_eq(heap_used(), mine_used, "and nothing is taken from the program's own heap")
end A_VALUE_MADE_WHILE_A_SECOND_VM_IS_ENTERED_COMES_OUT_OF_THAT_VMS_HEAP_AND_IS_CHARGED_TO_IT

@test
A_FULL_HEAP_SETS_THE_FLAG_ON_THE_VM_THAT_RAN_OUT_AND_ANSWERS_WITH_ITS_RESERVE()
    // The error path of the same seam. A full heap may not be answered with null -- every constructor
    // writes straight through what comes back -- so the reserve is handed out and `heap_exhausted` is
    // set on the VM that ran out, which is the VM the statement boundary reads it from.
    reset_vm()
    set_heap_limit(ExhaustCeiling)
    reset_heap()

    val mark = root_mark()
    var made: usize = 0

    // Held on the shadow stack, so the collection the allocator tries first frees none of them.
    while made < 40000 && !current().heap_exhausted
        hold(str_value(padded(4)))
        made += 1

    val ran_out = current().heap_exhausted
    val answered = new_str_scanned("after") != null

    release(mark)
    set_heap_limit(HeapBytes)
    reset_heap()

    assert(ran_out, s"a heap that is full says so, and this made ${str(made)} strings without filling it")
    assert(answered, "and a constructor is handed the reserve rather than null")
    assert_eq(current().heap_exhausted, false, "and rebuilding the heap puts the flag back")
end A_FULL_HEAP_SETS_THE_FLAG_ON_THE_VM_THAT_RAN_OUT_AND_ANSWERS_WITH_ITS_RESERVE

@test
A_SECOND_VM_THAT_FILLS_ITS_HEAP_SAYS_SO_ABOUT_ITSELF_AND_ANSWERS_WITH_ITS_OWN_RESERVE()
    // The same error path on a VM that is not the program's own. The flag, the reserve and the
    // collection that is tried first must all be the entered VM's -- and the program's own VM must
    // hear nothing about it.
    reset_vm()
    reset_heap()
    collect_now()

    val mine_used = heap_used()

    var second = new_vm(ExhaustCeiling)
    val was = enter(&second)
    val mark = root_mark()
    var made: usize = 0

    while made < 40000 && !current().heap_exhausted
        hold(str_value(padded(4)))
        made += 1

    val ran_out = current().heap_exhausted
    val answered = new_str_scanned("after") != null

    release(mark)
    leave(was)
    dispose_vm(&second)

    assert(ran_out, s"a second VM's full heap says so, and this made ${str(made)} strings without filling it")
    assert(answered, "and a constructor on it is handed that VM's reserve rather than null")
    assert_eq(current().heap_exhausted, false, "the program's own VM never ran out")
    assert_eq(heap_used(), mine_used, "and nothing was taken from the program's own heap")
end A_SECOND_VM_THAT_FILLS_ITS_HEAP_SAYS_SO_ABOUT_ITSELF_AND_ANSWERS_WITH_ITS_OWN_RESERVE
