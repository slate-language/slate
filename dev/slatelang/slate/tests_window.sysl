module dev.slatelang.slate
@tests

// **THE WHOLE FILE IS BEHIND THE `webview` FEATURE**, which is the rule every suite over a gated
// subsystem follows: a build without the feature has no `slate:window` to test, so the tests go with
// it rather than being weakened into something that passes either build. What keeps that honest is
// `tests_owed.sysl`, which reads the sets off the build rather than off a written list.
//
// **AND `webview` IS THE ONE FEATURE THAT IS NOT IN `default`, so this file is compiled by
// `sysl test . --features webview` and by nothing else.** The ordinary gate says nothing about it,
// which is a fact worth knowing before reading a green run as covering this module.
#if feature_webview
import sh.sysl.parsing.*
import sysl.text.Search

// `slate:window` -- every sentence it says when it will not do something, and the two conversions the
// bridge between a page and the program is made of.
//
// **NOT ONE TEST HERE OPENS A WINDOW, AND THAT IS A HARD RULE RATHER THAN AN OMISSION.** Opening one
// needs a window server, and the machine this suite runs on has none for the account it runs as: the
// console belongs to somebody else, so `webview_create` blocks inside `[NSApplication run]` waiting
// for a launch notification that will never come. It does not fail -- it never returns. So a test
// that made a window would HANG the gate with nothing printed rather than failing it, and the whole
// design of this module's argument checking is what makes that avoidable: **every option is read and
// every handle is looked up before any C is touched**, so all of the below is reachable with no
// window anywhere.
//
// What is therefore NOT covered here, and is covered by running `examples/desktop/notes.sl` by hand
// from an account that owns the console: that a window appears, that the pump timer draws it, that a
// click reaches a bound function, and that closing it ends the program.
//
// **There is no corpus file and there cannot be one.** `tests/js/` is one program run on both back
// ends and compared, and this module has no implementation on the second: a browser page is already
// inside a window and node has no window system, so every name refuses there. That refusal is a test
// of its own at the bottom of this file, run under node exactly as `slate:lmdb`'s is.

// -- what a call takes ------------------------------------------------------------------------------

@test
EVERY_window_NAME_SAYS_WHAT_IT_TAKES()
    assert(said_by("window(1, 2)").contains("`window` takes an optional object of options, and was given 2 arguments"))
    assert(said_by("window(42)").contains("`window` takes an object of options, and this is an integer"))
    assert(said_by("windowBind(0, \"go\")").contains("`windowBind` takes a window, a name and a function, and was given 2 arguments"))
    assert(said_by("windowSize(0, 100)").contains("`windowSize` takes a window, a width and a height, and was given 2 arguments"))
    assert(said_by("windowEval(0)").contains("`windowEval` takes a window and the script, and was given 1 argument"))
    assert(said_by("windowTitle(0)").contains("`windowTitle` takes a window and the title, and was given 1 argument"))
    assert(said_by("windowNavigate(0)").contains("`windowNavigate` takes a window and the url, and was given 1 argument"))
    assert(said_by("windowHtml(0)").contains("`windowHtml` takes a window and the markup, and was given 1 argument"))
    assert(said_by("windowClose()").contains("`windowClose` takes a window, and was given 0 arguments"))
    assert(said_by("windowClosed()").contains("`windowClosed` takes a window, and was given 0 arguments"))
    assert(said_by("windowDone()").contains("`windowDone` takes a window, and was given 0 arguments"))
end EVERY_window_NAME_SAYS_WHAT_IT_TAKES

// **A handle is a number into a table and a number that names no window is refused by that table**,
// which is `slate:lmdb`'s arrangement and is what stops a foreign object ever becoming a slate value.
@test
A_NUMBER_THAT_NAMES_NO_WINDOW_IS_REFUSED_BY_THE_TABLE_IT_IS_LOOKED_UP_IN()
    assert(said_by("windowTitle(4, \"hello\")").contains("`windowTitle` was given something that is not a window"))
    assert(said_by("windowEval(0, \"1\")").contains("`windowEval` was given something that is not a window"))
    assert(said_by("windowSize(9, 100, 100)").contains("`windowSize` was given something that is not a window"))
    assert(said_by("windowClose(0)").contains("`windowClose` was given something that is not a window"))
    assert(said_by("windowClosed(0)").contains("`windowClosed` was given something that is not a window"))
    assert(said_by("windowDone(0)").contains("`windowDone` was given something that is not a window"))
    assert(said_by("windowBind(0, \"go\", () -> 1)").contains("`windowBind` was given something that is not a window"))

    // A window is never a string, and the sentence says which end is wrong.
    assert(said_by("windowTitle(\"w\", \"hello\")").contains("`windowTitle` takes a window, and this is a string"))
    assert(said_by("windowTitle(-1, \"hello\")").contains("`windowTitle` was given something that is not a window"))
end A_NUMBER_THAT_NAMES_NO_WINDOW_IS_REFUSED_BY_THE_TABLE_IT_IS_LOOKED_UP_IN

// **THE OPTIONS ARE READ IN FULL BEFORE ANY C IS TOUCHED**, which is what every assertion in this
// file rests on: a program that named an option wrong is told so with no window made and taken away
// again. It is also the only reason these tests can run at all here.
@test
AN_OPTION_window_DOES_NOT_HAVE_NAMES_THE_ONES_IT_DOES()
    val said = said_by("window({ titel: \"x\" })")

    assert(said.contains("`window` has no option called `titel`"))
    assert(said.contains("it takes `title`, `width`, `height`, `html`, `url` and `debug`"))

@test
EVERY_OPTION_SAYS_WHAT_IT_IS()
    assert(said_by("window({ title: 3 })").contains("`title` is text, and this is an integer"))
    assert(said_by("window({ html: [] })").contains("`html` is text, and this is an array"))
    assert(said_by("window({ url: null })").contains("`url` is text, and this is null"))
    assert(said_by("window({ debug: 1 })").contains("`debug` is true or false, and this is an integer"))
    assert(said_by("window({ width: \"wide\" })").contains("a width is a whole number, and this is a string"))
    assert(said_by("window({ height: \"tall\" })").contains("a height is a whole number, and this is a string"))

    // **Zero is refused rather than taken as "the platform's guess"**, a window of no size being a
    // thing nobody asked for and a number the reader plainly got wrong.
    assert(said_by("window({ width: 0 })").contains("a width is a positive whole number, and this is 0"))
    assert(said_by("window({ height: -10 })").contains("a height is a positive whole number, and this is -10"))
end EVERY_OPTION_SAYS_WHAT_IT_IS

// **Naming both is refused rather than resolved**, which is the manifest reader's rule about a
// repeated key drawn here for its reason: first-wins and last-wins each silently throw away a page
// somebody wrote.
@test
html_AND_url_ARE_ALTERNATIVES_AND_NAMING_BOTH_IS_REFUSED()
    val said = said_by("window({ html: \"<p>hi\", url: \"http://x/\" })")

    assert(said.contains("`window` takes `html` or `url` and not both"))
    assert(said.contains("a window shows one page"))

// -- the bridge, which is two conversions ---------------------------------------------------------

// **A page's call arrives as a JSON array and comes out as slate values**, which is the half of the
// bridge a handler sees. It is asked here directly, that being the only vantage without a window:
// webview hands the trampoline a string, and this is what it becomes.
@test
A_PAGES_ARGUMENTS_ARRIVE_AS_SLATE_VALUES()
    reset_heap()
    reset_vm()

    val got = page_arguments("[1, \"two\", true, null, [3], { \"a\": 4 }]", point(0)).unwrap()

    machine().stack.push(got)
    assert_eq(show_value(got), "[1, \"two\", true, null, [3], {a: 4}]")

    // **A page that passed nothing is an empty array and not an absence**, which is what keeps a
    // handler of no parameters working without a case of its own.
    assert_eq(show_value(page_arguments("[]", point(0)).unwrap()), "[]")
    reset_vm()
end A_PAGES_ARGUMENTS_ARRIVE_AS_SLATE_VALUES

// **A page cannot send anything but an array, so anything else is a defect in the bridge rather than
// in the program** -- and it says so rather than being read as a one-argument call.
@test
A_PAGES_CALL_THAT_IS_NOT_A_JSON_ARRAY_IS_REFUSED()
    reset_heap()
    reset_vm()

    assert(signal_message(page_arguments("{\"a\": 1}", point(0)).unwrap_err())
        .contains("a page's call arrives as a JSON array of its arguments, and this is not an array"))
    assert(signal_message(page_arguments("not json at all", point(0)).unwrap_err())
        .contains("a page called a bound function with arguments that are not JSON"))
    reset_vm()
end A_PAGES_CALL_THAT_IS_NOT_A_JSON_ARRAY_IS_REFUSED

// The other half: what a handler answered, as the JSON text the page's promise resolves with.
//
// **It is `toJSON`'s own encoder and not a second one**, so a class with a `toJSON` renders the way
// it renders everywhere else and a circular value is refused with the sentence it is refused with
// everywhere else.
@test
A_HANDLERS_ANSWER_GOES_BACK_TO_THE_PAGE_AS_JSON()
    reset_heap()
    reset_vm()

    assert_eq(answered_json(Int(5), point(0)).unwrap(), "5")
    assert_eq(answered_json(Null, point(0)).unwrap(), "null")
    assert_eq(answered_json(Bool(true), point(0)).unwrap(), "true")
    assert_eq(answered_json(str_value("hi"), point(0)).unwrap(), "\"hi\"")

    val o = new_object()

    machine().stack.push(Object(o))
    obj_put_name(o, "theme", str_value("dark"))
    obj_put_name(o, "size", Int(14))
    assert_eq(answered_json(Object(o), point(0)).unwrap(), "{\"theme\":\"dark\",\"size\":14}")
    reset_vm()
end A_HANDLERS_ANSWER_GOES_BACK_TO_THE_PAGE_AS_JSON

// -- the JavaScript back end -----------------------------------------------------------------------

@test
slate_window_REFUSES_ON_A_JAVASCRIPT_HOST_NAMING_THE_WINDOW_AND_WHY()
    // **It is not on `OWED` and must not go back**, which is `slate:lmdb`'s case: a browser page is
    // already inside a window and node's desktop shells are separate runtimes, so "not in the
    // JavaScript back end yet" would be a promise nobody can keep.
    val said = node_said("import { window } from slate:window\nprint(window({ title: \"x\" }))\n")

    assert(said.contains("`window` opens a native window, and no JavaScript host has one to open"))
    assert(said.contains("this module runs in the interpreter only"))
end slate_window_REFUSES_ON_A_JAVASCRIPT_HOST_NAMING_THE_WINDOW_AND_WHY

// -- the harness -------------------------------------------------------------------------------------

// A program over `slate:window` that is expected to fail, and what it said.
//
// **There is no `in_window` beside it and there must not be one**, for the reason at the head of this
// file: the helper that would make a window is the one that would hang the gate.
private said_by(text: string) -> string = fails(s"${WindowImport}${text}\n")
#endif
