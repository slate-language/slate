module dev.slatelang.slate

import sh.sysl.gc

// The three scalar kinds too wide for a `Value`, each in a cell of the collected heap.
//
// **A `Value` is a tag and one word, sixteen bytes, and that width is the reason for this file.**
// The union is as wide as its widest variant, and every push, pop, slot read, array element and
// table entry in every program moves one whole `Value` -- so a range's three numbers and three
// flags, carried inline, made every one of those moves forty bytes. A range, a civil reading and a
// zoned reading are the only kinds that need more than a word, and all three are rare in the
// places the width costs, so they pay a pointer and everything else stops paying for them.
//
// **A cell is written once, where it is made, and never again.** Nothing changes a range or a
// reading in place -- every operation answers a new value -- so two values naming one cell are
// the same value, and equality and hashing read what the cell holds rather than where it is.
//
// **None of them points at anything**, so one `gc.Kind` with a tracer that marks nothing and no
// finalizer serves all three, and `Vm.spare_cell` is one reserve for the three, taken at the size
// of the largest.

// `a..b`, `a..<b`, and every other way a range can be written. What each field means is said at
// `Value.RangeVal`.
struct RangeObj
    lo: long
    hi: long
    step: long
    inclusive: bool
    has_lo: bool
    has_hi: bool

// A civil reading: a day number from 1970-01-01 and the microseconds since that day's midnight.
struct DateTimeObj
    day: int
    us: long

// An instant, in microseconds from the epoch, read in the zone the slot `zone` names.
struct ZonedObj
    us: long
    zone: usize

// A cell holds only numbers, so there is nothing in one to mark.
private trace_cell(p: *u8, h: *gc.Heap)
    ()

// process-wide: see `str_kind` in `collector.sysl`.
var cell_kind: gc.Kind = gc.Kind(&trace_cell, null, null, null)

// A range. Every range there is is made here.
range_value(lo: long, hi: long, inclusive: bool, has_lo: bool, has_hi: bool, step: long) -> Value
    val v = current()
    var o: *RangeObj = ptr_cast(alloc_or_collect(v, sizeof(RangeObj), &cell_kind, v.spare_cell))

    o.lo = lo
    o.hi = hi
    o.step = step
    o.inclusive = inclusive
    o.has_lo = has_lo
    o.has_hi = has_hi
    RangeVal(o)
end range_value

// The last number a range reaches, which is what equality and hashing both read -- so `1..3` and
// `1..<4` are one range, and so are `0..<10 by 2` and `0..8 by 2`. One function for the two readers,
// because an `==` and a hash that disagree lose map entries.
range_reach(r: *RangeObj) -> long =
    if r.has_lo && r.has_hi then range_last(r.lo, r.hi, r.inclusive, r.step) else (if r.inclusive then r.hi else r.hi - 1)

// A civil reading. Every one there is is made here.
date_time_value(day: int, us: long) -> Value
    val v = current()
    var o: *DateTimeObj = ptr_cast(alloc_or_collect(v, sizeof(DateTimeObj), &cell_kind, v.spare_cell))

    o.day = day
    o.us = us
    DateTimeVal(o)

// A zoned reading. Every one there is is made here.
zoned_value(us: long, zone: usize) -> Value
    val v = current()
    var o: *ZonedObj = ptr_cast(alloc_or_collect(v, sizeof(ZonedObj), &cell_kind, v.spare_cell))

    o.us = us
    o.zone = zone
    ZonedVal(o)
