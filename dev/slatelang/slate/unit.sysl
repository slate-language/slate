module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, cmp as big_cmp, parse as big_parse, zero as big_zero}

// What a program compiles to: its chunks, and the tables every instruction indexes into.
//
// **This is not `code.sysl` because an instruction does not know it is in a unit.** `code.sysl` is the
// instruction set -- what one instruction says, how wide it may be, and which one an operator is --
// and nothing there names anything declared here. What lives here is where those instructions are
// kept and the tables their operands are indices into: the strings and what is known about each, the
// wide operands, the per-site caches, the modules, and the `intern_*` that fill them while compiling.
// Nothing `private` crosses between the two files.

// One function's code: the top level is a chunk, and so is every lambda and every named function.
struct Chunk
    code: Buf[Ins]
    params: Buf[string]

    // How many arguments a call must give, which is every parameter that has no default.
    //
    // **A count rather than the defaults themselves, because the defaults are already CODE.** They
    // are compiled into the head of this chunk, so nothing outside a call has to evaluate one; what
    // a caller needs to know is only where the arity it is allowed begins.
    required: usize

    // Whether the LAST parameter gathers what is left over -- `f(a, ...rest)`.
    //
    // **The name in `params` is the plain one**, the mark `ast.sysl` describes having been taken off
    // while this chunk was made. So a body binds `rest` and nothing downstream of compilation has to
    // know the spelling.
    //
    // A variadic call has no upper arity: `required` is still the floor, and the gather is what puts
    // the surplus somewhere.
    variadic: bool

    // What a fault calls it, and what a `<function>` prints as.
    name: string

    // Whether calling this runs it on a line of execution of its own and answers a promise.
    is_async: bool

    // Whether this chunk's body holds a `yield`, which is what makes calling it hand back a
    // generator rather than running it.
    is_gen: bool

    // How many cells this chunk reserves at entry: its parameters, then its locals, or only its
    // locals where it keeps its scope. Zero for a chunk whose names all stayed in the scope chain,
    // which is every module and any function every one of whose names something outside it reads.
    slots: usize

    // Whether this chunk's names -- its parameters as well as its locals -- are those cells.
    //
    // **A chunk that slots needs no `EnvObj` of its own at all**, which is what this exists to say
    // at the four places a call enters one. `vm.scope` becomes the closure's own captured scope, so
    // free names resolve exactly as they did and nothing is allocated per call. **Parameter `i` is
    // slot `i`**, claimed in order at the head of the chunk before a line of the body is emitted, so
    // no table has to travel from the compiler to the machine.
    //
    // **IT IS THE STRONGER OF TWO QUESTIONS AND `slots > 0` IS THE WEAKER ONE.** A chunk holding a
    // closure that reads one of its names keeps a scope for that name and puts every other one in a
    // cell, so it reserves a window and is not `slotted`. Anything deciding whether to build a scope
    // and bind arguments reads this; anything reserving the window reads `slots`. They were one
    // answer while a chunk either celled everything or nothing, and a mixed chunk is where they came
    // apart.
    slotted: bool

    // Whether an ordinary positional call may enter this chunk with its arguments left where they
    // stand: `slotted`, and neither variadic, `async` nor a generator.
    //
    // **IT IS THE FOUR FLAGS ANSWERED ONCE, WHEN THE CHUNK IS FINISHED, SO THE CALL ASKS ONE.** The
    // hottest arm in the interpreter used to read all four on every call, out of line, and hand the
    // answer back through memory. `compile_chunk` writes it beside `slotted`, the last of the four
    // to be known; every other chunk is made with it false, which sends a call the buffered way.
    in_place_ok: bool

    // Which of the unit's sources this chunk was compiled from. **A fault's span is an offset into
    // this file and no other**, which is the whole reason a chunk has to remember it.
    source: usize

// Everything a compiled program is.
//
// **It lives outside the collected heap and holds counted boxes freely**, which the objects in the
// heap may not -- see `obj.sysl`. A chunk is immutable and acyclic once built, so reference counting
// frees it correctly and nothing here needs tracing.
struct Unit
    chunks: Buf[Chunk]
    strings: Buf[string]

    // How many characters each of those strings holds, in step with it.
    //
    // **A LITERAL IS COUNTED ONCE, WHEN IT IS INTERNED.** A cell carries its character count, and
    // the cell a literal is (`literal.sysl`) is made on its first execution in each machine -- so
    // counting there would walk the text again per machine. The table is compiled once and read for ever.
    string_chars: Buf[usize]

    // The hash of each of those strings, in step with it.
    //
    // **A FIELD NAME IS HASHED ONCE, WHEN IT IS INTERNED, FOR THE REASON THE COUNT IS.** Hashing
    // walks the text, and a name written inside a loop would be walked on every turn -- so the three
    // instructions that look a name up in an object carry the answer with them instead.
    // `site_cache.sysl` is what reads it.
    string_hashes: Buf[u64]

    // The keys of every object literal and every `with { ... }`, as indices into `strings`, each a
    // run that its `MakeObject` or `WithObject` names -- so building one hashes nothing and pushes
    // no key.
    object_keys: Buf[u32]

    // Every whole literal in the program too wide for 64 bits, already built.
    //
    // **`PushBig` COPIES A VIEW WHERE `PushStr` READS TEXT**, which is the whole reason this holds
    // numbers rather than digits: a magnitude is built by dividing the text down a chunk at a time,
    // and a literal written inside a loop would pay for that on every turn. A `BigInt` copies with
    // a retain, so the instruction costs one.
    bigs: Buf[BigInt]

    patterns: Buf[Pattern]

    // The parameter names written at each call site that named any, with `""` for a slot that was
    // given positionally. **Entry zero is the empty list**, so a call that named nothing carries a
    // `names` of zero and no lookup happens at all.
    arg_names: Buf[Buf[string]]

    // Every file the unit was compiled from, in the order they were read. A `Chunk.source` and a
    // `Signal.Fail`'s `src` both index this.
    sources: Buf[Source]

    // The top-level chunk of each module, **in the order they have to run** -- every file before any
    // file that imports it, and the program the user named last.
    //
    // **This is not the order the files were read in**, and the difference matters: reading is
    // depth-first from the entry, so the entry is source zero, while running is post-order, so the
    // entry is the last module. A module's own index here is what `PushModule` carries.
    modules: Buf[usize]

    // The resolved path of each module, in step with `modules` -- which is how a compiled `import`
    // finds the number to put in its `PushModule`.
    module_paths: Buf[string]

    // The DECLARATIONS chunk of each module, in step with `modules`.
    //
    // **It holds the file's declarations and nothing else** -- its definitions, classes, data types,
    // types, externals and imports -- and answers the same exports object the module's own chunk
    // does, so a VM that has run only these knows every name the program declares and has done none
    // of what it does. `load_declarations` is the one caller and an ordinary run never enters it.
    module_decls: Buf[usize]

    // The packages the project reaches, so that a compiled `import ... from parsing` can be turned
    // into the same path the loader turned it into. **The loader's answer is not handed down as a
    // table**: there is one rule for what an import means and both passes ask it, which is what
    // stops the two from being able to disagree.
    packages: Packages

    // The top-level definitions of the file being compiled, and whether a read of each may still be
    // resolved. **Emptied between files** -- `defs.sysl` is the whole of what this is for.
    defs: Buf[ModuleDef]

    // Every resolved read emitted for the file being compiled, so that a spelling something further
    // down turns out to bind can be put back to a lookup.
    def_sites: Buf[DefSite]

    // How many cells of the machine's definition table have been handed out, for the whole unit. **A
    // number is never reused**, so two files' definitions of one spelling are two cells.
    def_total: usize

    // One cell per field-reading instruction in the program, holding where that instruction found
    // its name last time.
    //
    // **IT LIVES ON THE UNIT AND THE UNIT LIVES INSIDE THE `Vm`** (`vm_state.sysl`'s
    // `current_unit`), which is what makes a cache safe beside actors with nothing having to be
    // said about threads: an actor compiles its own declarations into its own unit on its own
    // thread, so no two lines of execution ever write one of these cells.
    site_caches: Buf[SiteCache]

    // The operands of the six instructions that carry more than a pair.
    //
    // **A PAYLOAD IS EIGHT BYTES AND THESE HAVE THREE OR FOUR OPERANDS**, so they hold a `u32` into
    // this table instead and read their operands from here. Every one of them is an instruction a
    // program runs rarely -- a declaration, an annotation check, a destructuring -- except
    // `CallMethod`, which spends the load inside a call it was about to make anyway.
    wide: Buf[WideOp]

    // `"proto"`, hashed once for the whole unit.
    //
    // **Every delegated lookup asks for it**, and a hash of five bytes computed at each one is a
    // real cost on a program whose methods live on a class. It is a fact about the language rather
    // than about a program, so it is worked out where the unit is made.
    proto_hash: u64

    // `"new"`, hashed once for the whole unit -- the one name a proto hit may not hand a receiver,
    // which `field_from_site` rules out with this before anything is compared.
    new_hash: u64

    // Where a class's `new` stood in its table the last time a constructor call looked (`class_call.sysl`).
    new_at: usize

// The operands of one instruction too wide to hold its own.
//
// **THREE NUMBERS AND NO NAMES, BECAUSE THE SIX THAT USE IT MEAN SIX DIFFERENT THINGS BY THEM.**
// Each variant in `Op` says what its own `a`, `b` and `c` are, beside its declaration and at the arm
// that reads them; a struct per instruction would be six tables to keep and six things to intern
// where one does.
struct WideOp
    a: usize
    b: usize
    c: usize

// Where one instruction found a name last time.
//
// **A POSITION, NOT A VALUE, AND NOT AN OBJECT** -- which is the whole of why this needs no
// invalidation at all. A cell is a guess that is CHECKED before it is believed, by comparing the key
// standing at that position against the name being looked up, so an answer built from one is right
// by construction whatever has happened to the object, to its class, or to any other object the site
// has seen. A guess that has gone stale costs the search it was trying to save and nothing else.
struct SiteCache
    // Where the name sat in the receiver's own table.
    own: usize

    // Where `proto` sat in the receiver's table, and where the name sat in that proto's.
    hop: usize
    up: usize

    // The builtin a method call on a value of kind `kind` found last time (`method_kind_code`; `0`
    // is none). A call on a string, an array or a number asks a table rather than a proto chain, and
    // the table's answer is the same for every value of the kind.
    kind: u32
    native: NativeFn

// An empty unit.
//
// **There is no chunk zero.** Every module gets a chunk of its own and the program the user named is
// simply the last of them, so nothing is special about the first -- which is what stopped the entry
// from having to be both the first chunk and the last thing to run.
new_unit() -> Unit
    var u = Unit(buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), Packages(buf(), "", buf()), buf(), buf(), 0, buf(), buf(), "proto".hash(), "new".hash(), 0)

    // Entry zero of `arg_names` is the empty list, which is what a `names` of zero means.
    u.arg_names.push(buf())

    // **Cell zero belongs to every caller that has no instruction of its own**, the machine reaching
    // a field read from a native or from an actor's delivery as well as from a `GetField`. It is a
    // guess like any other and is checked like any other, so sharing it costs those callers a stale
    // hit now and then and can never cost an answer.
    u.site_caches.push(SiteCache(0, 0, 0, 0, 0))
    u
end new_unit

// Record the parameter names one call site wrote, answering the index its instruction carries.
//
// **Not interned the way a string is.** A name list belongs to one call and is looked at once per
// call; searching the table for an equal one would cost more than the copy saves.
intern_arg_names(u: *Unit, names: Buf[string]) -> usize
    u.arg_names.push(names)
    u.arg_names.len() - 1

// Add a string to the table, reusing one that is already there.
//
// **Reuse matters more than it looks**: a field name appears once per access in the source and every
// one of them would otherwise be a separate copy in the unit.
intern_str(u: *Unit, s: string) -> usize
    for i in 0..<u.strings.len()
        if u.strings.at(i) == s then return i

    u.strings.push(s)
    u.string_chars.push(char_count(s))
    u.string_hashes.push(s.hash())
    u.strings.len() - 1
end intern_str

// A fresh cell for one instruction to remember where a name was found.
//
// **One per SITE and not one per name**, because what a site sees is one shape of object over and
// over where a name is shared by everything that ever writes it.
fresh_site(u: *Unit) -> usize
    u.site_caches.push(SiteCache(0, 0, 0, 0, 0))
    u.site_caches.len() - 1

// Write down the operands of one wide instruction, answering the index it carries.
//
// **Not deduplicated.** Two instructions with the same three operands are two instructions, and a
// scan of the table at each one would cost more than the twenty-four bytes it saves -- these are the
// rare instructions, which is why they are the ones paying the indirection.
intern_wide(u: *Unit, a: usize, b: usize, c: usize) -> u32
    u.wide.push(WideOp(a, b, c))
    u32(u.wide.len() - 1)

// A whole literal too wide for 64 bits, built once and kept.
//
// **The DIGITS are what is deduplicated**, two literals written the same way being one number, and
// a linear scan is what `intern_str` beside it does for the same reason: a program holds a handful
// of these at most.
intern_big(u: *Unit, digits: string) -> usize
    val n = big_parse(digits) match
        Some(v) -> v
        None -> big_zero()

    // **The comparison is of NUMBERS and not of text**, so `0xffffffffffffffff` and the same value
    // in decimal are one entry -- which is what a reader would expect of interning and is what the
    // string table gets for free from its keys already being canonical.
    for i in 0..<u.bigs.len()
        if big_cmp(u.bigs.at(i), n) == 0 then return i

    u.bigs.push(n)
    u.bigs.len() - 1
end intern_big

intern_pattern(u: *Unit, p: Pattern) -> usize
    u.patterns.push(p)
    u.patterns.len() - 1
