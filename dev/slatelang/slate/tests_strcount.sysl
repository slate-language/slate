module dev.slatelang.slate
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{entries, read_bytes}
import sysl.slices.sort_by
import sysl.text.{from_utf8_unchecked, Search, split, str_builder}

// What a character position COSTS, which is the one thing a benchmark cannot say.
//
// **A slate position is a character and the storage is UTF-8**, so `s.length` and `s[i]` both used to
// walk the string from the front every time they were asked -- which makes the ordinary
// `while i < s.length ... s[i]` walk quadratic twice over. `StrObj` carries the character count now,
// a string all of whose characters are one byte is indexed by arithmetic, and one that is not is
// walked from where it was last read.
//
// **The instrument is a COUNT and not a clock.** `Vm.chars_scanned` is every byte the
// character-position routines in `text.sysl` have walked over, and a test can assert a bound on it
// where it can assert nothing at all about a wall time. What each test below pins is that the total
// grows with the LENGTH of the string and not with its square: the old arrangement read about
// 200,000,000 bytes to walk 20,000 characters and each of these bounds is a small multiple of the
// string's own size.
//
// **A PROGRAM COSTS A FEW DOZEN BYTES BEFORE IT READS A CHARACTER OF ITS OWN STRING**, and that floor
// is not noise: every name compiled into it -- a variable, a property, a builtin -- is interned once
// through the same counter a runtime scan charges, so `text.length` and `print` cost their own few
// bytes at compile time and never again. A test asserting NO runtime scan therefore bounds the cost
// a little above that floor rather than at exactly zero, and a bound of a hundredth of `Walked` still
// fails at once if the scan it is watching for comes back.
//
// **EVERY PROGRAM HERE IS A `"...\n..."` STRING AND NOT AN `s"""` BLOCK, AND THAT IS NOT A STYLE
// CHOICE.** sysl strips the indentation of the CLOSING delimiter, so a block whose content sits
// deeper than its `"""` reaches slate indented and slate refuses the first line outright. Every test
// in this file was written that way and every one of them passed on a program that had never
// compiled: `out`'s answer was dropped and only an upper bound on a counter that had not moved was
// asserted, which a refused program meets exactly. **So `scanning` asserts what the program PRINTED**,
// and every bound is paired with a lower one or with an exact count.

// The string every walk here is over, in characters. Big enough that a quadratic walk is four
// hundred million bytes of scanning and a linear one is a rounding error.
private const Walked: usize = 20000

// What a program costs in bytes walked, which is the difference either side of the run -- and what it
// said, which is the half that says it ran at all.
private scanning(program: string, said: string) -> usize
    val before = bytes_scanned()
    val printed = out(program)

    assert_eq(printed, said, "what the program printed")
    bytes_scanned() - before
end scanning

// A one-byte string built ten characters at a time and then walked by index, counting the `x` each
// piece carries.
private index_walk() -> string =
    s"var text = \"\"\nvar k = 0\nwhile k < ${Walked / 10}\n    text = text + \"abcdexfghi\"\n    k = k + 1\nvar found = 0\nvar i = 0\nwhile i < text.length\n    if text[i] == \"x\" then found = found + 1\n    i = i + 1\nprint(found)"

// The loop condition on its own: the length asked once per character and the string never read.
private length_walk() -> string =
    s"val text = repeat(\"a\", ${Walked})\nvar i = 0\nwhile i < text.length\n    i = i + 1\nprint(i)"

// The same index walk over a string whose every character is three bytes.
private wide_walk() -> string =
    s"val text = repeat(\"日\", ${Walked})\nvar found = 0\nvar i = 0\nwhile i < text.length\n    if text[i] == \"本\" then found = found + 1\n    i = i + 1\nprint(found)"

// Taking a string apart into its characters, which asked twice per character where a byte offset was.
private taken_apart() -> string =
    s"val text = repeat(\"ab\", ${Walked / 2})\nprint(chars(text).length)"

// A string assembled a piece at a time and then asked how long it is.
private built_up() -> string =
    s"var text = \"\"\nvar k = 0\nwhile k < ${Walked / 10}\n    text = text + \"abcdefghij\"\n    k = k + 1\nprint(text.length)"

// One interned literal, asked its length a hundred thousand times.
private pushed_literal() -> string =
    "var n = 0\nvar i = 0\nwhile i < 100000\n    n = n + \"日本語\".length\n    i = i + 1\nprint(n)"

// Text that arrived from outside the machine, which is the one place a scan is owed.
private decoded_walk() -> string =
    "val text = fromBytes(toBytes(repeat(\"日\", 1000))).value\nvar i = 0\nvar found = 0\nwhile i < text.length\n    if text[i] == \"日\" then found = found + 1\n    i = i + 1\nprint(found)"

@test
WALKING_A_ONE_BYTE_STRING_BY_INDEX_READS_NO_TEXT_AT_ALL()
    // **Every character is one byte, so a position IS a byte offset** and nothing is walked to find
    // one. Nor is anything counted: each piece is a literal the unit already counted and a join adds
    // two numbers, so the only cost is the handful of names this program compiles (measured: 33 of
    // 20000 characters), and a regression that walked even once would blow straight past it.
    val cost = scanning(index_walk(), "2000")

    assert(cost < 66, s"walking ${Walked} one-byte characters by index read ${cost} bytes")

@test
ASKING_A_ONE_BYTE_STRING_ITS_LENGTH_READS_NOTHING()
    // The loop CONDITION on its own, which is the half nobody would think to look at: it asked the
    // string how long it was twenty thousand times, and the answer cost a walk of the string every
    // time. `repeat` multiplies rather than counting, so the count is carried before the loop starts,
    // and the only cost left is this program's own names (measured: 23).
    val cost = scanning(length_walk(), s"${Walked}")

    assert(cost < 46, s"asking a ${Walked}-character string its length ${Walked} times read ${cost} bytes")

@test
WALKING_A_STRING_THAT_IS_NOT_ONE_BYTE_READS_IT_ABOUT_ONCE()
    // **A three-byte character cannot be found by arithmetic**, so this is where the cursor earns
    // its place: a left-to-right walk steps from where it last was, so the whole walk reads the
    // string's bytes once rather than once per character. The bound is twice the byte length, which
    // is a hundredth of one percent of what the square would be -- and the LOWER bound is what says
    // the walk happened at all, a refused program reading nothing.
    val bytes = Walked * 3
    val cost = scanning(wide_walk(), "0")

    assert(cost >= bytes, s"walking ${Walked} three-byte characters read only ${cost} bytes, of ${bytes}")
    assert(cost < 2 * bytes, s"walking ${Walked} three-byte characters read ${cost} bytes, of ${bytes}")

@test
TAKING_A_STRING_APART_INTO_ITS_CHARACTERS_READS_IT_ONCE()
    // `chars` asked twice per character which character a byte offset was, and each of those two
    // questions walked the whole string -- so a text of any size was the square of its length before
    // its first piece was made. Every piece is one byte, so each is counted by arithmetic and there
    // is no walk at all -- the only cost is this program's own names (measured: 28). A bound as loose
    // as `2 * Walked` would still pass a regression that scanned the string once; this one would not.
    val cost = scanning(taken_apart(), s"${Walked}")

    assert(cost < 56, s"taking ${Walked} characters apart read ${cost} bytes")

@test
A_STRING_BUILT_A_PIECE_AT_A_TIME_IS_NEVER_COUNTED_AGAIN()
    // **Joining two strings adds their counts**, so the text a program assembles knows its length
    // for nothing. Counting the answer instead would read the whole of it once per join, which over
    // a loop is the square of the result -- two hundred million bytes for this one, against the
    // handful this program's own names cost at compile time (measured: 26).
    val cost = scanning(built_up(), s"${Walked}")

    assert(cost < 52, s"building ${Walked} characters a piece at a time read ${cost} bytes")

@test
A_LITERAL_IS_COUNTED_WHEN_IT_IS_COMPILED_AND_NOT_WHEN_IT_IS_PUSHED()
    // The same literal, pushed a hundred thousand times. It is one entry in the unit's string table
    // and the table carries its count, so the loop itself reads no text whatever -- the literal's own
    // nine bytes were charged once, at compile time, alongside this program's other names (measured
    // total: 22). A hundred thousand pushes that each rescanned it would be nearly a megabyte.
    val cost = scanning(pushed_literal(), "300000")

    assert(cost < 44, s"pushing one three-character literal 100000 times read ${cost} bytes")

@test
TEXT_FROM_OUTSIDE_THE_MACHINE_IS_COUNTED_ONCE()
    // **The one place a scan is owed**, and it is owed exactly once: nothing upstream of a decoded
    // buffer counted anything, so the cell is made with a walk -- and every question asked of it
    // afterwards is answered off the count that walk produced. Three thousand bytes of text, so the
    // walk of the cell and the walk of the string being indexed are each about that; the lower bound
    // is what says the decode really did read it.
    val cost = scanning(decoded_walk(), "1000")

    assert(cost >= 3000, s"one walk of 3000 bytes of text read only ${cost} bytes")
    assert(cost < 20000, s"one walk of 3000 bytes of text read ${cost} bytes")

// -- every string cell is made with a count, and the census is what keeps it that way --------------

// Where the runtime's source is, relative to the project root, which is where `sysl test .` runs.
private const RuntimeDir: string = "dev/slatelang/slate"

// The two ways to make a string cell, and the files each may be written in.
//
// **`new_str_counted` IS THE ONLY ALLOCATOR AND IT TAKES THE COUNT AS A PARAMETER**, so a site that
// makes a string cannot fail to say how long it is -- the compiler asks. `new_str_scanned` is the
// one way to say "nobody counted this", and it is a walk of the text, so it belongs to the boundary
// where text arrives from outside the machine. Everywhere else the count is already in hand.
//
// A file that wants to construct a string reaches for `str_value` or `str_counted` in `value.sysl`,
// which is what every site outside these two does.
private const CountedIn: string = "obj.sysl value.sysl"

@test
EVERY_STRING_CELL_IS_MADE_WITH_A_CHARACTER_COUNT()
    // **The two names are built rather than written**, so that this file's own census does not find
    // itself: a line here saying what it is looking for is a line containing what it is looking for.
    val forgetful_call = "new_str" + "("
    val counted_call = "new_str" + "_counted("

    var names = entries(RuntimeDir).unwrap()

    sort_by(names.view(), (a, b) -> a < b)

    var makes = str_builder()
    var forgetful: usize = 0
    var first = true

    for i in 0..<names.len()
        if !names.at(i).ends_with(".sysl") then continue

        val text = from_utf8_unchecked(read_bytes(s"${RuntimeDir}/${names.at(i)}").unwrap())
        val lines = split(text, "\n")
        var allocates = false

        for j in 0..<lines.len
            val line = lines[j]

            if line.starts_with("//") then continue

            // **The constructor that took no count is gone and may not come back**, a string made
            // without one being exactly what this whole arrangement is against.
            if line.contains(forgetful_call) then forgetful += 1
            if line.contains(counted_call) then allocates = true

        if allocates
            makes.push(if first then names.at(i) else s" ${names.at(i)}")
            first = false

    assert_eq(forgetful, 0, "calls to a string constructor that does not take a character count")

    // **Who may allocate a string cell at all.** The count is a claim nothing checks, exactly as an
    // array's `Buf` is, so the files that make one are the ones a reader has to trust -- and a third
    // appearing here is a decision rather than an accident.
    assert_eq(makes.finish(), CountedIn, "the files that make a string cell")
