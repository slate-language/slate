module dev.slatelang.slate
@tests

// The bytes under a string, and the text and numbers a JavaScript person reaches for.
//
// Cut out of `tests_builtins.sysl`, which holds the arrays, the optional reads, JSON and what the
// checker says before a program runs. Nothing here shares a helper with it.

// -- the bytes under the text ---------------------------------------------------------------------

@test
toBytes_COUNTS_WHAT_GOES_ON_THE_WIRE_AND_len_COUNTS_CHARACTERS()
    // **The two numbers differ and both are right**, which is the whole reason this pair exists.
    // Everything else in slate counts characters, because that is what a program reasoning about
    // text wants; a protocol saying how much is about to arrive counts bytes.
    assert_eq(out("print(\"héllo\".length, toBytes(\"héllo\").length)"), "5 6")
    // **It answers a BUFFER, where it answered an array of numbers.** `tests_bytes.sysl` carries the
    // kind and `tests/lang/bytes.sl` carries its operations; what is pinned here is that this pair
    // still counts what goes on the wire.
    assert_eq(out("print(toBytes(\"hé\"))"), "<bytes 3: 68 c3 a9>")
    assert_eq(out("print(toBytes(\"hé\").toArray())"), "[104, 195, 169]")

    // ASCII is where they agree, which is why getting this wrong survives every test written in
    // English and fails on the first accented body.
    assert_eq(out("print(\"abc\".length == toBytes(\"abc\").length)"), "true")

    assert_eq(out("print(toBytes(\"\"))"), "<bytes 0>")

@test
fromBytes_ANSWERS_A_RESULT_BECAUSE_ARBITRARY_BYTES_ARE_NOT_TEXT()
    assert_eq(out("print(fromBytes(toBytes(\"héllo\")).value)"), "héllo")
    assert_eq(out("print(fromBytes([]).value == \"\")"), "true")

    // **A lone `0xFF` is in no UTF-8 sequence**, so this is the failure a program reading a socket
    // has to be able to see: answering an empty string would hide the difference between bytes that
    // are not text and no bytes at all.
    assert_eq(out("val r = fromBytes([104, 255, 105])\nprint(r.ok, r.error)"),
        "false these bytes are not text -- they are not valid UTF-8")

    // The round trip is what makes a chunked read safe: a character split across two arrivals is
    // whole again once the pieces are back together.
    assert_eq(out("val a = [104, 195]\nval b = [169]\nprint(fromBytes(concat(a, b)).value)"), "hé")

@test
THE_BYTE_BUILTINS_SAY_WHAT_THEY_WANTED_WHEN_GIVEN_SOMETHING_ELSE()
    assert(fails("print(toBytes(42))").contains("`toBytes` takes a string, and this is an integer"))
    assert(fails("print(toBytes(\"a\", \"b\"))").contains("`toBytes` knows the encodings `utf8` and `latin1`, and this is `b`"))
    assert(fails("print(toBytes(\"a\", \"b\", \"c\"))").contains("`toBytes` takes a string and an optional encoding"))
    assert(fails("print(fromBytes(\"abc\"))").contains("`fromBytes` takes bytes or an array of numbers, and this is a string"))
    assert(fails("print(fromBytes([1, \"x\"]))").contains("and one of these is a string"))

    // **The range is checked rather than truncated**, a number outside it being a mistake in the
    // program rather than a byte anybody meant.
    assert(fails("print(fromBytes([256]))").contains("a byte is between 0 and 255, and this is 256"))
    assert(fails("print(fromBytes([-1]))").contains("a byte is between 0 and 255, and this is -1"))

@test
EVERY_VALUE_ANSWERS_toString_eq_ne_AND_equals()
    // **An object model is a set of questions every value can be asked**, and a language where
    // `o.toString()` works only when somebody remembered to write one has not got one. These four are
    // the whole of slate's, and the list is closed on purpose: they are reached only where nothing
    // nearer answered, so a name a program put on its object still wins.

    assert_eq(out("print((42).toString(), \"hi\".toString(), [1, 2].toString(), {a: 1}.toString())"),
        "42 hi [1, 2] {a: 1}")

    // **`eq` is identity on the kinds that have one and equality on the kinds that have not.** A
    // string, a number and a boolean are immutable and nothing can observe which copy it holds, so
    // `"a".eq("a")` answering false would be a trap rather than a distinction.
    assert_eq(out("val xs = [1, 2]\nprint(xs.eq(xs), xs.eq([1, 2]), xs.ne([1, 2]))"), "true false true")
    assert_eq(out("print(1.eq(1), \"a\".eq(\"a\"), true.eq(true), null.eq(null))"), "true true true true")

    // **`equals` is `==` under its own name and the two may never disagree**, which is why it is the
    // same function rather than a second reading of it.
    assert_eq(out("print([1, 2].equals([1, 2]), {a: 1}.equals({a: 1}), 1.equals(2))"), "true true false")

    // **A field the program put there wins, own or through a proto**, this table being consulted only
    // where the lookup found nothing.
    assert_eq(out("val o = { toString: () -> \"mine\" }\nprint(o.toString(), string(o))"), "mine mine")
    assert_eq(out("val P = { toString: (self) -> \"shared\" }\nprint({ n: 1, proto: P }.toString())"), "shared")

    // **The name on its own hands back the plain builtin**, exactly as `xs.map` does -- it is the same
    // value the call reaches, which is what makes these methods rather than syntax.
    assert_eq(out("val f = [1, 2].toString\nprint(f([3]))"), "[3]")

    // **The checker knows them too, and asks the machine's own table.** A pass that refused one would
    // be refusing a program that runs, which is the one mistake it may not make.
    assert_eq(out("print(\"abc\".eq(\"abc\"))"), "true")
    assert(fails("print(\"abc\".push(1))").contains("`push` is not something a string can do"))

@test
A_UNIVERSAL_METHOD_CALLED_WITH_NO_RECEIVER_IS_TOLD_THAT_AND_NOT_GIVEN_A_COUNT()
    // **The count these sentences print is `args.len() - 1` and the count is unsigned**, so a call
    // that gave no receiver at all -- which `val f = n.toString` then `f()` is, the name handing back
    // the bare function -- printed 18446744073709551615 and sent the reader looking for a program
    // that could have written it. `past_receiver` answers the empty window with its own sentence.
    assert(fails("val n = 10\nval f = n.toString\nprint(f())")
        .contains("`toString` is a method, so the value it is about is its first argument -- and this call gave nothing"))
    assert(fails("val f = (10).eq\nprint(f())").contains("`eq` is a method, so the value it is about"))
    assert(fails("val f = (10).ne\nprint(f())").contains("`ne` is a method, so the value it is about"))
    assert(fails("val f = (10).equals\nprint(f())").contains("`equals` is a method, so the value it is about"))

    // **The value it was taken off is the argument it wants**, which is where that sentence sends the
    // reader -- and is the receiver rule `docs/reference/objects.md` states.
    assert_eq(out("val n = 10\nval f = n.toString\nprint(f(n))"), "10")

    // A count that IS a count still reads as one, past the receiver and in words.
    assert(fails("print((42).toString(1))").contains("`toString` takes no arguments and was given 1 argument"))
    assert(fails("print((42).eq(1, 2))").contains("`eq` takes one argument and was given 2 arguments"))
    assert(fails("print((42).equals())").contains("`equals` takes one argument and was given 0 arguments"))

@test
A_BUILTIN_HOLDS_ITS_ARGUMENTS_ACROSS_A_CALLBACK_THAT_COLLECTS()
    // **`args` is a sysl `Buf` and the collector does not walk one**, and by the time a native runs
    // the call has already popped the callee and its arguments off the operand stack -- so for the
    // length of the call the only thing holding them was that buffer. Every builtin that answers
    // without running slate code was fine; the ten or so that call back into it were not.
    //
    // **What it looked like was never a memory failure**, which is what makes this worth a test of
    // its own: `["a", "b", "c"].map(r -> burn(500))` failed with *"this array was changed while
    // `map` was walking it"* about a literal nothing in the program can reach. Binding the array to
    // a `val` moved the failure onto the CALLBACK -- "this function takes from 1 to 0 arguments" --
    // the freed slot having been taken by something else and read back as a function of another
    // arity. Binding both made it pass, and the JavaScript back end passed throughout.
    //
    // **The receiver is a LITERAL and the callback is a lambda written at the call**, deliberately:
    // a name would hold both from the scope and the test would pass against the build this exists
    // for.
    val body = "burn(n) =\n" +
        "    var out = []\n" +
        "    for i in 0..<n\n" +
        "        push(out, { a: i, b: string(i), c: [i, i, i] })\n" +
        "    out.length\n" +
        "var total = 0\n" +
        "for round in 0..<200\n" +
        "    total = total + [\"a\", \"b\", \"c\"].map(r -> burn(500)).length\n" +
        "print(total)\n"

    assert_eq(out(body), "600")

// The program the three tests below share: a callback that allocates enough to collect.
private burner() -> string = "burn(r) =\n" +
    "    var out = []\n" +
    "    for i in 0..<700\n" +
    "        push(out, { a: i, b: string(i), c: [i, i, i] })\n" +
    "    out.length\n"

@test
A_NAMED_CALLBACK_THAT_COLLECTS_LEAVES_ITS_CALLERS_SCOPE_STANDING()
    // **The scope of the chunk that called the builtin was held by a sysl local for the length of the
    // callback**, `run_chunk`'s `outer_scope`: `vm.scope` becomes the callee's, a native pushes no
    // frame, and a frame records the scope of the call below it. Found by mimic, whose XINFO STREAM
    // FULL failed with *"`s` is not defined"* about a parameter of the very function it was in, once
    // in a while and only after the server had run for a long time.
    //
    // **The callback is a NAME and the lambda that keeps the scope is written AFTER the walk**, both
    // deliberately: a closure capturing the scope that is alive during the walk holds it through
    // `trace_closure`, and the test would pass against the build this exists for. Nearly all of the
    // program's allocation is inside `burn`, so the collection the last assertion asks for is one
    // that happened inside the window.
    val body = burner() +
        "f(s)\n" +
        "    val r = map([\"a\", \"b\", \"c\"], burn)\n" +
        "    s + r.length + map([1], x -> s).length\n" +
        "var total = 0\n" +
        "for round in 0..<20\n" +
        "    total = total + f(round)\n" +
        "print(total)\n"

    assert_eq(out(body), "270")
    assert(current().collections > 0, "the callback has to have collected, or the window was never exercised")

@test
EVERY_NESTED_RUN_HOLDS_ITS_CALLERS_SCOPE_AND_A_KEPT_var_IN_IT_IS_STILL_WRITABLE()
    // The same hole reached through two more doors -- `filter` with a named predicate and `sort` with
    // a named comparator -- with a `var` in the kept scope, written after both walks. A freed scope
    // loses its `mutable` table along with its names, so the assignment is the first thing to fault.
    //
    // **Both callbacks are names for the first test's reason**: a lambda written at the call captures
    // the very scope under test, and the builtin's own hold on it would keep that scope alive.
    val body = burner() +
        "keepIt(r) = burn(r) > 0\n" +
        "byLength(a, b) =\n" +
        "    burn(a)\n" +
        "    a < b\n" +
        "f(s)\n" +
        "    var n = s\n" +
        "    val kept = filter([\"a\", \"b\", \"c\"], keepIt)\n" +
        "    val ordered = [3, 1, 2]\n" +
        "    sort(ordered, byLength)\n" +
        "    n = n + 1\n" +
        "    map([1], x -> s + n)[0] + kept.length + ordered.length\n" +
        "var total = 0\n" +
        "for round in 0..<20\n" +
        "    total = total + f(round)\n" +
        "print(total)\n"

    assert_eq(out(body), "520")
    assert(current().collections > 0, "the callbacks have to have collected, or the window was never exercised")

@test
A_CALLBACK_THAT_COLLECTS_AND_THEN_FAULTS_LEAVES_THE_SCOPE_THAT_CAUGHT_IT_STANDING()
    // The error path: the callback collects and then faults, the caller's own `try` catches it, and
    // the caller carries on with a second named walk before reading its kept name. **The `try` alone
    // would not have shown the hole** -- a handler records its scope and `mark_machine` walks it --
    // which is why the walk after the `catch` is the part that failed before the fix.
    val body = burner() +
        "boom(r) =\n" +
        "    burn(r)\n" +
        "    r.nope()\n" +
        "f(s)\n" +
        "    var said = \"\"\n" +
        "    try\n" +
        "        map([\"a\", \"b\"], boom)\n" +
        "    catch e\n" +
        "        said = \"caught\"\n" +
        "    val r = map([\"a\", \"b\"], burn)\n" +
        "    said.length + s + r.length + map([1], x -> s).length\n" +
        "var total = 0\n" +
        "for round in 0..<20\n" +
        "    total = total + f(round)\n" +
        "print(total)\n"

    assert_eq(out(body), "370")
    assert(current().collections > 0, "the callbacks have to have collected, or the window was never exercised")

@test
EVERY_BUILTIN_THAT_CALLS_BACK_HOLDS_WHAT_IT_WAS_GIVEN()
    // The same hole, asked of the rest of the family. **Rooting at the dispatch rather than in each
    // `do_*` is what makes this one change**: a rule written out per builtin had already been
    // half-applied, which is how `map` came to be the one without it.
    val burn = "burn(n) =\n" +
        "    var out = []\n" +
        "    for i in 0..<n\n" +
        "        push(out, { a: i, b: string(i) })\n" +
        "    out.length\n"

    val each = "for round in 0..<40\n" +
        "    total = total + [\"a\", \"b\", \"c\"].filter(r -> burn(200) > 0).length\n" +
        "    total = total + [1, 2, 3].reduce((a, b) -> a + burn(200) - burn(200) + b, 0)\n" +
        "    total = total + [\"a\", \"b\"].flatMap(r -> [burn(200)]).length\n" +
        "    [3, 1, 2].sorted((a, b) -> burn(200) > 0 && a < b)\n" +
        "    [\"a\", \"b\"].forEach(r -> burn(200))\n" +
        "    if [\"a\"].some(r -> burn(200) > 0) then total = total + 1\n"

    assert_eq(out(burn + "var total = 0\n" + each + "print(total)"), "480")

// -- text and numbers a JavaScript person reaches for ---------------------------------------------

@test
padStart_AND_padEnd_BRING_A_STRING_UP_TO_A_WIDTH()
    assert_eq(out("print(padStart(\"7\", 3))"), "  7")
    assert_eq(out("print(padEnd(\"7\", 3))"), "7  ")

    // **The filler REPEATS and is cut to fit**, so a two-character filler on an odd amount of room
    // does not overshoot.
    assert_eq(out("print(padStart(\"7\", 5, \"ab\"))"), "abab7")
    assert_eq(out("print(padEnd(\"7\", 5, \"ab\"))"), "7abab")

    // A string already at or past the width is answered unchanged.
    assert_eq(out("print(padStart(\"hello\", 3))"), "hello")
    assert_eq(out("print(padStart(\"hi\", 2))"), "hi")

@test
padStart_AND_padEnd_REFUSE_A_NEGATIVE_WIDTH_AND_AN_EMPTY_FILLER()
    // The width and the filler are both the right SHAPE here, only the value is wrong, so this is an
    // ordinary call the checker lets through and the native itself refuses.
    assert(fails("print(padStart(\"7\", -1))").contains("`padStart` takes a width that is not negative, and this is -1"))
    assert(fails("print(padEnd(\"7\", -1))").contains("`padEnd` takes a width that is not negative, and this is -1"))
    assert(fails("print(padStart(\"7\", 3, \"\"))")
        .contains("`padStart` cannot pad with the empty string -- no amount of it reaches a width"))

    // **`padStart` has a fixed arity, so the checker refuses an ordinary call with the wrong count
    // before the native's own check ever runs** -- wrapping the function itself in `anything` hides
    // which one is being called from the pass, the same door `tests_builtins.sysl` already uses to
    // reach `map`'s own count check.
    assert(fails(Opaque + "print(anything(padStart)(\"7\"))")
        .contains("`padStart` takes a string, a width and an optional filler, and was given 1 argument"))

    // And the width is declared a whole number, so a string in that position is a checker refusal
    // too unless the argument's type is hidden from it.
    assert(fails(Opaque + "print(padStart(\"7\", anything(\"x\")))")
        .contains("`padStart` takes a whole number of characters, and this is a string"))

@test
replaceAll_IS_replace_UNDER_JAVASCRIPTS_SPELLING()
    // `replace` has always changed every occurrence, so `replaceAll` is the same native and not a
    // second behaviour -- the JavaScript habit of reaching for the "all" name is simply right here.
    assert_eq(out("print(replaceAll(\"a,b,c\", \",\", \"-\"))"), "a-b-c")
    assert_eq(out("print(replace(\"a,b,c\", \",\", \"-\") == replaceAll(\"a,b,c\", \",\", \"-\"))"), "true")

    // Its refusals are `replace`'s own sentences, said under the other name.
    assert(fails("print(replaceAll(\"x\", \"\", \"y\"))")
        .contains("`replace` cannot replace the empty string -- there is one of it between every pair of characters"))

    // `replaceAll` is declared to take exactly three arguments, so the checker catches the wrong
    // count before the native's own sentence would -- which is `replace`'s own, said under this name.
    assert(fails(Opaque + "print(anything(replaceAll)(\"x\"))")
        .contains("`replace` takes a string, what to replace, and what to put there, and was given 1 argument"))

@test
includes_IS_contains_UNDER_JAVASCRIPTS_SPELLING()
    assert_eq(out("print(includes(\"hello\", \"ell\"))"), "true")
    assert_eq(out("print(includes(\"hello\", \"xyz\"))"), "false")
    assert_eq(out("print(includes([1, 2, 3], 2))"), "true")
    assert_eq(out("print(includes([1, 2, 3], 9))"), "false")

    // **The one native answers both questions**, so the refusal it raises is `contains`'s own
    // sentence rather than a second one written for the other spelling. `includes` takes exactly two
    // arguments, so the checker catches the wrong count first.
    assert(fails(Opaque + "print(anything(includes)(\"x\"))")
        .contains("`contains` takes a string and what to look for, and was given 1 argument"))

@test
toFixed_WRITES_A_NUMBER_TO_EXACTLY_THAT_MANY_PLACES()
    assert_eq(out("print(toFixed(1.005, 2))"), "1.00")
    assert_eq(out("print(toFixed(1.25, 1))"), "1.3")
    assert_eq(out("print(toFixed(9, 2))"), "9.00")
    assert_eq(out("print(toFixed(0, 0))"), "0")

    // **A tie rounds AWAY from zero, which is JavaScript's rule and not C's `printf`** -- the whole
    // reason the arithmetic is done in exact integers rather than handed to the host's formatter.
    assert_eq(out("print(toFixed(2.5, 0))"), "3")
    assert_eq(out("print(toFixed(0.125, 2))"), "0.13")

    // The sign is taken off first, so a negative rounding to nothing still reads negative.
    assert_eq(out("print(toFixed(-0.4, 0))"), "-0")

@test
toFixed_REFUSES_A_PLACE_COUNT_OUTSIDE_ITS_RANGE()
    // The place count is the right SHAPE and only the value is out of range, which the native itself
    // refuses in an ordinary call. **The number itself is never a reason to refuse** -- JavaScript's
    // `toFixed` answers something for every real, and `tests/lang/numbers.sl` is where that is pinned
    // on both back ends, `1e21` and beyond included.
    assert(fails("print(toFixed(1, -1))").contains("`toFixed` writes from 0 to 100 places, and was asked for -1"))
    assert(fails("print(toFixed(1, 101))").contains("`toFixed` writes from 0 to 100 places, and was asked for 101"))

    // `toFixed` takes exactly two arguments of declared types, so both the count and either
    // argument's type are checker refusals unless `anything` hides them from the pass.
    assert(fails(Opaque + "print(anything(toFixed)(1))")
        .contains("`toFixed` takes a number and how many places, and was given 1 argument"))
    assert(fails(Opaque + "print(toFixed(1, anything(\"x\")))")
        .contains("`toFixed` takes a whole number of places, and this is a string"))
    assert(fails(Opaque + "print(toFixed(anything(\"x\"), 2))").contains("`toFixed` takes a number, and this is a string"))

@test
toExponential_AND_toPrecision_WRITE_A_NUMBER_IN_SCIENTIFIC_FORM()
    // **What each of them ANSWERS is `tests/lang/numberformat.sl`'s**, run on both back ends, and
    // `tests/js/p40.sl` sweeps forty values through both. What is here is the interpreter's own
    // half: the exact arithmetic in `decimal.sysl`, and the refusals a sentence has to get right.
    assert_eq(out("print(toExponential(0.1))"), "1e-1")
    assert_eq(out("print(toExponential(123456))"), "1.23456e+5")
    assert_eq(out("print(toExponential(100))"), "1e+2")
    assert_eq(out("print(toExponential(0))"), "0e+0")
    assert_eq(out("print(toPrecision(123.456, 4))"), "123.5")
    assert_eq(out("print(toPrecision(123456, 2))"), "1.2e+5")

    // **The tie is settled on the exact decimal value the double holds**, which is what the whole
    // integer arithmetic is for: `1.25` is halfway and goes up, and `1.35` is a shade above halfway
    // so it is not a tie at all.
    assert_eq(out("print(toExponential(1.25, 1))"), "1.3e+0")
    assert_eq(out("print(toExponential(1.35, 1))"), "1.4e+0")
    assert_eq(out("print(toPrecision(2.5, 1))"), "3")
    assert_eq(out("print(toPrecision(1.005, 3))"), "1.00")

    // A carry past the last place moves the exponent with it.
    assert_eq(out("print(toExponential(9.99, 1))"), "1.0e+1")
    assert_eq(out("print(toPrecision(9.99, 2))"), "10")

    // The smallest subnormal, whose exact value is not the five its shortest text writes.
    assert_eq(out("print(toExponential(5e-324))"), "5e-324")
    assert_eq(out("print(toExponential(5e-324, 3))"), "4.941e-324")

@test
toExponential_AND_toPrecision_REFUSE_A_DIGIT_COUNT_OUTSIDE_THEIR_RANGES()
    // **Their ranges differ by one and the sentences say which is which**, one significant digit
    // being the fewest that says anything where nought digits after the point is an ordinary ask.
    assert(fails("print(toExponential(1, -1))")
        .contains("`toExponential` writes from 0 to 100 digits, and was asked for -1"))
    assert(fails("print(toExponential(1, 101))")
        .contains("`toExponential` writes from 0 to 100 digits, and was asked for 101"))
    assert(fails("print(toPrecision(1, 0))")
        .contains("`toPrecision` writes from 1 to 100 significant digits, and was asked for 0"))
    assert(fails("print(toPrecision(1, 101))")
        .contains("`toPrecision` writes from 1 to 100 significant digits, and was asked for 101"))

    // The count is OPTIONAL on both, so only a missing NUMBER is a wrong count; the types are
    // checker refusals unless `anything` hides them from the pass.
    assert(fails(Opaque + "print(anything(toExponential)())")
        .contains("`toExponential` takes a number and how many digits, and was given 0 arguments"))
    assert(fails(Opaque + "print(toExponential(1, anything(\"x\")))")
        .contains("`toExponential` takes a whole number of digits, and this is a string"))
    assert(fails(Opaque + "print(toExponential(anything(\"x\")))")
        .contains("`toExponential` takes a number, and this is a string"))
    assert(fails(Opaque + "print(toPrecision(1, anything(\"x\")))")
        .contains("`toPrecision` takes a whole number of significant digits, and this is a string"))
    assert(fails(Opaque + "print(toPrecision(anything(\"x\")))")
        .contains("`toPrecision` takes a number, and this is a string"))

@test
formatNumber_GROUPS_THE_DIGITS_OF_A_WHOLE_NUMBER_OR_A_toFixed_ANSWER()
    assert_eq(out("print(formatNumber(1234567))"), "1,234,567")
    assert_eq(out("print(formatNumber(toFixed(1234.5, 2)))"), "1,234.50")
    assert_eq(out("print(formatNumber(1))"), "1")
    assert_eq(out("print(formatNumber(-1234))"), "-1,234")

    // The two options say where the thousands go and where the point is -- the French convention,
    // said with the same two strings rather than a locale name.
    assert_eq(out("print(formatNumber(toFixed(1234.5, 2), { separator: \" \", decimal: \",\" }))"), "1 234,50")

@test
formatNumber_REFUSES_A_REAL_RATHER_THAN_GUESSING_HOW_MANY_PLACES()
    // **A `real` has no one written form** -- `string` gives the shortest text that reads back, so
    // the same call would group a round one and put a separator into the middle of another's
    // seventeen digits of noise. The decision about places belongs to the
    // program, spelled `toFixed(x, 2)`. A literal real argument is refused by the checker itself,
    // since `formatNumber` is declared over a whole number or text -- `anything` is what reaches this
    // sentence, written for the case where the value's type was not known until the program ran.
    assert(fails(Opaque + "print(formatNumber(anything(1234.5)))")
        .contains("`formatNumber` groups a whole number or the text `toFixed` answered -- a real has no one written form"),
        fails(Opaque + "print(formatNumber(anything(1234.5)))"))

    // A digit-shaped key still needs to be actual digits -- this is a legal call the checker lets
    // through, and the native's own check is what refuses it.
    assert(fails("print(formatNumber(\"x\"))")
        .contains("`formatNumber` groups the digits of a number written in full, and \"x\" is not one"),
        fails("print(formatNumber(\"x\"))"))

    // An unknown option key is a legal call too, both arguments the right shape.
    assert(fails("print(formatNumber(1, { spacer: \" \" }))")
        .contains("`spacer` is not one of `formatNumber`'s options -- there are `separator` and `decimal`"))

    // A value outside the declared union, the options in the wrong shape, and the wrong count are
    // all checker refusals that `anything` opens back up to the native's own sentences.
    assert(fails(Opaque + "print(formatNumber(anything(true)))")
        .contains("`formatNumber` takes a number, and this is a boolean"))
    assert(fails(Opaque + "print(formatNumber(1, anything(2)))")
        .contains("`formatNumber` takes its options as a record, and this is an integer"))
    assert(fails(Opaque + "print(anything(formatNumber)())")
        .contains("`formatNumber` takes a number and an optional record, and was given 0 arguments"))

