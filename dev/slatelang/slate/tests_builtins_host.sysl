module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// A draw, which host a program is running on, what `freeze` closes, and the registry a builtin is
// installed into.
//
// Cut out of `tests_builtins.sysl`, which holds the arrays, the optional reads, JSON and what the
// checker says before a program runs. Nothing here shares a helper with it.

// -- a draw ----------------------------------------------------------------------------------------

@test
random_ANSWERS_A_REAL_BETWEEN_ZERO_AND_ONE()
    // **What a draw IS, since what it is cannot be written down.** The range and the kind are pinned
    // on both back ends by `tests/lang/numbers.sl`; this is the interpreter's own half, and the
    // generator being seeded on the first call is what it adds -- a seeding that faulted would fail
    // here rather than at whatever ran next.
    assert_eq(out("val r = random()\nprint(r is real, r >= 0 && r < 1)"), "true true")

    // Seeded ONCE, so the second call continues the sequence rather than re-seeding to the same
    // place: a generator re-seeded per call from a coarse source answers the same number twice.
    assert_eq(out("print(random() != random())"), "true")

@test
random_TAKES_NO_ARGUMENTS()
    // The checker knows `random` takes nothing, so a literal argument is refused before the native
    // is ever reached -- `host`'s own sentence just below.
    assert(fails("print(random(5))").contains("`random` takes 0 arguments and this gives it 1"))

    // And through a value the checker cannot see the arity of, the machine drops the surplus rather
    // than refusing the count -- a builtin taking nothing has nothing to bind and nothing to say.
    assert_eq(out(Opaque + "print(anything(random)(5) is real)"), "true")

// -- which host a program is running on -------------------------------------------------------------

@test
host_ANSWERS_WHICH_OF_THE_THREE_HOSTS_A_PROGRAM_IS_RUNNING_ON()
    // **The interpreter answers here, unconditionally** -- these tests drive it directly, so
    // `"interpreter"` is the one answer a sysl-side test can pin. `tests_js.sysl` pins the other two.
    assert_eq(out("print(host())"), "interpreter")

    // Constant for the life of a program, and takes nothing to ask.
    assert_eq(out("print(host() == host())"), "true")

@test
host_TAKES_NO_ARGUMENTS()
    // The checker knows `host` takes nothing, so a literal argument is refused before the native
    // is ever reached -- `now(5)`'s own sentence in `tests_time.sysl`, one name over.
    assert(fails("print(host(1))").contains("`host` takes 0 arguments and this gives it 1"))

    // And through a value the checker cannot see the arity of, the surplus is dropped rather than
    // refused, which is the call rule read at a native.
    assert_eq(out(Opaque + "print(anything(host)(1) == host())"), "true")

// -- what `freeze` closes, and what the checker knows about it -------------------------------------

@test
freeze_ANSWERS_THE_TYPE_IT_WAS_GIVEN_SO_A_CLOSED_VALUE_KEEPS_ITS_SHAPE()
    // **`SameAsArg(0)` rather than `any`**, which is what makes `val settings = freeze({ … })` keep
    // the shape it was written with -- so a misspelled field is still caught where it is read.
    assert_eq(out("val o = freeze({ a: 1 })\nprint(o.a, isFrozen(o))"), "1 true")
    assert(fails("f(n: integer) = n\nprint(f(freeze(\"s\")))").contains("takes integer here, and this is string"))

    // `isFrozen` answers a boolean, so the checker knows `!isFrozen(x)` is a test and not arithmetic.
    assert_eq(out("print(!isFrozen([1]))"), "true")

@test
EVERY_MUTATING_PATH_OF_A_FROZEN_VALUE_IS_REFUSED_AND_THE_SENTENCE_NAMES_THE_CALL()
    // **The list is what the item is**, so it is written out rather than sampled: an object's field,
    // an index, every array mutator, a buffer, and the three each of a set, a map and a weak map.
    // `tests/lang/freeze.sl` asks the same questions of BOTH back ends; this is the interpreter's
    // own record of the sentences, beside the one for a data value it must not be confused with.
    assert(fails("val o = freeze({ a: 1 })\no.a = 2").contains("`a` belongs to a frozen value"))
    assert(fails("val o = freeze({ a: 1 })\no[\"a\"] = 2").contains("a belongs to a frozen value"))
    assert(fails("push(freeze([1]), 2)").contains("this array is frozen, and `push` would change it"))
    assert(fails("val xs = freeze([1])\nxs[0] = 2").contains("`xs[i] = v` would change it"))
    assert(fails("push(freeze(toBytes(\"a\")), 1)").contains("this buffer is frozen, and `push` would change it"))
    assert(fails("freeze(Set([1])).add(2)").contains("this set is frozen, and `add` would change it"))
    assert(fails("freeze(Map([[1, 2]])).clear()").contains("this map is frozen, and `clear` would change it"))
    assert(fails("val k = { a: 1 }\nfreeze(WeakMap()).set(k, 1)").contains("this weak map is frozen, and `set` would change it"))

    // **A DATA VALUE SAYS SOMETHING ELSE**, which is the distinction `write_refusal` exists to draw:
    // `with` is what to write INSTEAD there and the way BACK to something writable here.
    assert(fails("data S\n    C(r)\n\nval c = C(1)\n\nc.r = 2").contains("belongs to a data value"))

@test
A_val_MEMBER_OF_A_CLASS_IS_REFUSED_AN_ASSIGNMENT_THROUGH_EITHER_DOOR()
    val cls = "class P\n    val kind = \"p\"\n    var n = 1\n"

    assert(fails(cls + "val p = P(2)\np.kind = \"q\"").contains("`kind` is a `val` of `P`"))
    assert(fails(cls + "P.kind = \"q\"").contains("`kind` is a `val` of `P`"))

    // A `var` field is what each object gets and is written freely, which is what says the refusal
    // is about the `val` rather than about writing a field at all.
    assert_eq(out(cls + "val p = P(2)\np.n = 7\nprint(p.kind, p.n)"), "p 7")

    // **The mark is not a field**, so nothing that walks a class reports it.
    assert_eq(out(cls + "print(has(P, \"kind\"), keys(P).length > 0)"), "true true")

// -- the registry a builtin is installed into ------------------------------------------------------

// What a native registered by this test does, which is the shape every `do_*` has.
private test_doubled(args: Args, at: Span) -> Step
    args.at(0) match
        Int(n) -> Ok(Int(n * 2))
        other -> fault(at, s"this test's native takes a whole number, and this is ${other.type_name()}")

// **A builtin is a registered function rather than an arm of a closed enum**, which is what lets a
// subsystem install its own natives without a central list learning their names. This is that API
// used exactly as an `install_` function uses it.
@test
a_native_the_registry_was_given_is_called_through_its_id()
    val id = register("Test.doubled", test_doubled)

    // **Registering a name twice answers the FIRST id rather than making a second entry.** That is
    // what lets an installer run once per program the process runs -- this suite runs thousands of
    // them -- without the table growing or an id moving under a `var` that already holds it.
    val again = register("Test.doubled", test_doubled)

    assert(id == again)
    assert(id != 0)
    assert_eq(native_name(id), "Test.doubled")

    native_of("Test.doubled") match
        Some(found) -> assert(found == id)
        None -> assert(false)

    // A name nothing registered is not a native, which is what keeps a qualified method name honest.
    native_of("Test.nothingWasRegisteredUnderThis") match
        Some(_) -> assert(false)
        None -> ()

    var args: Buf[Value] = buf()

    args.push(Int(21))

    call_native_buf(id, args, Span(0, 0)) match
        Ok(Int(n)) -> assert_eq(n, 42)
        _ -> assert(false)

    // **Zero is "never registered" and says so**, the id being one PAST the slot it names: a zero
    // that indexed the first entry would silently be `print`, which is the aliasing the offset
    // exists to prevent.
    call_native_buf(0, args, Span(0, 0)) match
        Ok(_) -> assert(false)
        Err(_) -> ()
end a_native_the_registry_was_given_is_called_through_its_id
