module dev.slatelang.slate
@tests

// `slate:process`'s `run`, which runs as kairos tasks on the `uv` driver: one waiting for the exit,
// one draining each pipe, and a kairos timer for the watchdog.
//
// **What these pin is that nothing a program can see moved when the I/O did.** Every expected line
// here is what slate 0.1.23 printed for the same program, the last release whose `run` was libuv
// callbacks: the shape of the answer, the status and the signal, the watchdog's sentence, and the
// whole of what a child wrote whatever its size or its last byte.

@test
TWO_RUNS_IN_FLIGHT_TOGETHER_EACH_GET_THEIR_OWN_ANSWER()
    // Started together and awaited in the opposite order, the slower one first in the program.
    val prog = "async main()\n" +
        "    val a = run(\"/bin/sh\", [\"-c\", \"sleep 0.3; echo one\"])\n" +
        "    val b = run(\"/bin/sh\", [\"-c\", \"echo two; echo err >&2\"])\n" +
        "    val rb = await b\n" +
        "    val ra = await a\n" +
        "    print(ra.value.out.trim(), ra.value.status, rb.value.out.trim(), rb.value.err.trim(), rb.value.status)\n" +
        "main()\n"

    assert_eq(proc_out(prog), "one 0 two err 0")

@test
A_RUN_ANSWERS_A_PROMISE_AND_NEVER_DURING_THE_CALL()
    // The answer is handed back inside a pass of the loop, so the line after the call always sees a
    // pending promise -- even for a child that is gone before the loop turns.
    val prog = "val p = run(\"/bin/sh\", [\"-c\", \"exit 0\"])\n" +
        "print(p)\n" +
        "async main()\n" +
        "    print((await p).value.status)\n" +
        "main()\n"

    assert_eq(proc_out(prog), "<promise pending>\n0")

@test
THE_WATCHDOG_STOPS_A_CHILD_AND_SAYS_SO_IN_THE_SENTENCE_IT_ALWAYS_HAS()
    // A limit given as a plain number of milliseconds; the duration form is in `tests_time.sysl`.
    val prog = "async main()\n" +
        "    val slow = await run(\"/bin/sh\", [\"-c\", \"sleep 5\"], { timeout: 100 })\n" +
        "    print(slow.ok, slow.error)\n" +
        "main()\n"

    assert_eq(proc_out(prog), "false `/bin/sh` took too long and was stopped")

@test
A_CHILD_THAT_EXITS_NON_ZERO_OR_IS_KILLED_IS_STILL_AN_ANSWER()
    // A status of three with no signal, and a child its own signal ended: status zero, signal
    // fifteen. Neither is a failed call -- there was a child, and this is what it did.
    val prog = "async main()\n" +
        "    val bad = await run(\"/bin/sh\", [\"-c\", \"echo out; echo bad >&2; exit 3\"])\n" +
        "    print(bad.ok, bad.value.status, bad.value.signal, bad.value.out.trim(), bad.value.err.trim())\n" +
        "    val sig = await run(\"/bin/sh\", [\"-c\", \"kill -TERM $$\"])\n" +
        "    print(sig.ok, sig.value.status, sig.value.signal)\n" +
        "main()\n"

    assert_eq(proc_out(prog), "true 3 null out bad\ntrue 0 15")

@test
OUTPUT_LARGER_THAN_ONE_READ_COMES_BACK_WHOLE_ON_BOTH_PIPES()
    // kairos reads a pipe at most sixty-four kilobytes at a time, so 200,000 bytes on one pipe and
    // 100,001 on the other are several pieces each, read side by side. The length and the last
    // character are what a lost or doubled piece would change.
    val prog = "async main()\n" +
        "    val big = await run(\"/bin/sh\", [\"-c\", \"yes a | head -c 200000; yes b | head -c 100001 >&2\"])\n" +
        "    print(big.value.out.length, big.value.err.length, big.value.out[199998], big.value.err[100000], big.value.status)\n" +
        "main()\n"

    assert_eq(proc_out(prog), "200000 100001 a b 0")

@test
OUTPUT_WITH_NO_NEWLINE_AT_THE_END_IS_KEPT_TO_THE_LAST_BYTE()
    val prog = "async main()\n" +
        "    val bare = await run(\"/bin/sh\", [\"-c\", \"printf abc; printf x >&2\"])\n" +
        "    print(bare.value.out == \"abc\", bare.value.err == \"x\", bare.value.out.length, bare.value.err.length)\n" +
        "main()\n"

    assert_eq(proc_out(prog), "true true 3 1")

@test
A_WATCHDOG_THAT_FIRES_AFTER_THE_CHILD_HAS_EXITED_STILL_ENDS_THE_RUN()
    // The shell exits at once and leaves a child of its own holding the output open, so the limit
    // is reached with nothing left to kill: the kill answers `ESRCH`, which is ignored, and the run
    // still ends -- once the pipe closes -- with the watchdog's sentence.
    val prog = "async main()\n" +
        "    val orphan = await run(\"/bin/sh\", [\"-c\", \"(sleep 0.5) & exit 0\"], { timeout: 100 })\n" +
        "    print(orphan.ok, orphan.error)\n" +
        "main()\n"

    assert_eq(proc_out(prog), "false `/bin/sh` took too long and was stopped")

@test
A_PROGRAM_THAT_IS_NOT_THERE_IS_REFUSED_IN_LIBUVS_OWN_WORDS()
    val prog = "async main()\n" +
        "    val gone = await run(\"no-such-program-anywhere\", [])\n" +
        "    print(gone.ok, gone.error)\n" +
        "main()\n"

    assert_eq(proc_out(prog), "false cannot run `no-such-program-anywhere`: ENOENT: no such file or directory")

@test
TWO_CHILDREN_READ_AT_ONCE_NEVER_SEE_EACH_OTHERS_BYTES()
    // Every armed reader shares ONE read buffer underneath, so what each is handed has to be copied
    // out before the next read on any stream overwrites it. Two children print different letters in
    // interleaved bursts; a reader that kept a view instead of a copy would see the other's letter.
    val prog = "printing(letter, n) = \"i=0; while [ $i -lt \" + string(n) + \" ]; do \" +\n" +
        "    \"printf '%0200d\\\\n' 0 | tr 0 \" + letter + \"; sleep 0.005; i=$((i+1)); done\"\n" +
        "pure(text, letter, n) = " +
        "text.split(\"\\n\").filter(l -> l != \"\").length == n && " +
        "text.split(\"\\n\").filter(l -> l != \"\").every(l -> l == letter.repeat(200))\n" +
        "async main()\n" +
        "    val a = run(\"/bin/sh\", [\"-c\", printing(\"A\", 60)])\n" +
        "    val b = run(\"/bin/sh\", [\"-c\", printing(\"B\", 60)])\n" +
        "    val rb = await b\n" +
        "    val ra = await a\n" +
        "    print(ra.value.status, rb.value.status, pure(ra.value.out, \"A\", 60), pure(rb.value.out, \"B\", 60))\n" +
        "main()\n"

    assert_eq(proc_out(prog), "0 0 true true")
