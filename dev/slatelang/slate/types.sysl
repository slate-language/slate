module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{str_builder, StrBuilder}

// What a value is, as the compiler would like to know it.
//
// **This is not a `Pattern`, and the difference is the whole reason the file exists.** A pattern
// *tests* a value and a type *describes* one, and the two part company as soon as anything is asked
// of them beyond a shape: a pattern has no function type, no notion of "anything", and no way to say
// what a call answered. Every static check slate will ever do is a question about these rather than
// about patterns.
//
// **Nothing reads this at run time and nothing ever should.** A type is a compile-time claim; what
// the machine does is test patterns, which is what `CheckType` carries. The two are built from the
// same annotation and go their separate ways -- `type_from_pattern` is the fork.
//
// **`Any` is what an unannotated thing is**, which is the shape a gradual system has to have: slate
// is dynamically typed and always will be at the edges, so the checker's job is to say something
// useful about the parts that were written down and nothing at all about the rest. TypeScript made
// the same choice and named it the same way.

struct Type
    kind: &TypeKind
end Type

enum TypeKind
    // Nothing is known. An unannotated parameter, a call whose callee is unknown, a field read from
    // an object whose shape nobody wrote down.
    Any

    // The primitives, spelled as slate spells them.
    NullType
    BooleanType
    IntegerType
    RealType
    StringType

    // `number`, which is `integer` or `real` and is one word rather than a union because slate's own
    // bare-name rule already treats it as a kind.
    NumberType

    // `array`, and `array of T` once there is a syntax for saying so. **`Any` for the element is not
    // a placeholder for a missing feature** -- it is what `array` on its own means.
    ArrayOf(element: Type)

    // An object with at least these fields. **At least**, which is the object pattern's rule and has
    // to be the type's as well or the two would disagree about the same annotation.
    //
    // **`optional` is the `?` an object pattern already carried, and dropping it refused programs
    // that run.** `{ ok: boolean, error?: string }` matches an object with no `error` at all --
    // `match_object` skips a key the pattern marked optional -- so a type that forgot which keys
    // those were described a narrower set of values than the annotation it came from. Too narrow is
    // the one direction this pass may not be wrong in.
    ObjectWith(keys: Buf[string], values: Buf[Type], optional: Buf[bool])

    // A function. `result` is what a call answers, which is the whole reason return annotations had
    // to come first: without one, nothing downstream of a call can be said at all.
    //
    // **`required` is how many of the parameters a call must give**, which is fewer than there are
    // wherever the function has defaults. Counting arity against the length alone would refuse a
    // call that runs.
    // **`variadic` is what a rest parameter costs this pass, and it costs it a field rather than a
    // silence.** A function that gathers has no upper arity, so counting a call against
    // `params.len()` would refuse a program that runs -- the one mistake this pass may not make.
    FunctionType(params: Buf[Type], required: usize, variadic: bool, result: Type)

    // A kind that is nothing but its word: the eight temporal ones -- `instant`, `duration`, `date`,
    // `time`, `dateTime`, `zone`, `zoned`, `period` -- and `generator`.
    //
    // **One kind carrying a name rather than nine kinds**, because nothing here reasons about them
    // structurally: there is no subtyping among them and nothing to describe inside one. A date is a
    // date and fits nothing else. Nine variants would be nine arms in `fits`, in `write_type` and in
    // `from_test`, all saying the same thing about a different word.
    NamedType(name: string)

    // A compiled regular expression. **A kind of its own rather than a name under something else**,
    // because nothing else in the language is one and there is no family for it to join.
    RegexType

    // A data type, and the closed list of variants it has.
    //
    // **The list is the whole reason this is not a `NamedType`.** Every other named kind fits its own
    // word and nothing else, which needs no more than the word; a data type has a value fitting it
    // for each of several other names, and a `match` over one is checkable exactly because the list
    // is closed.
    DataType(name: string, variants: Buf[string])

    // One variant of one, which fits itself and fits the data type it belongs to.
    //
    // **It does not carry the data type's name**, because it does not need to: `fits` asks the data
    // type whether this name is in its list, which is the question in the direction it is asked.
    VariantType(name: string)

    // `A | B`, flattened -- a union never holds a union.
    OneOf(alts: Buf[Type])
end TypeKind

// The constructor, here so that the boxing does not appear on every line that builds one.
type_of(kind: TypeKind) -> Type = Type(kind)

// What one element of this is, where it is a list and the element is known.
//
// **`None` is "nothing useful", not "not an array"** -- a bare `array` carries `Any`, and typing a
// loop variable `Any` would be noting a name for no reason. Only `array of T` answers.
//
// Not `private`: `check.sysl` types a `for` head with it.
element_of(t: Type) -> Option[Type] = *t.kind match
    ArrayOf(element) -> *element.kind match
        Any -> None
        _ -> Some(element)
    _ -> None

// What a `type` declaration binds, and what `shape` in an annotation asks for.
//
// **Named once here rather than spelled at each site**, so the checker's word for it and the
// program's are the same string and cannot drift.
shape_type() -> Type = type_of(NamedType(type_test_text(IsShape)))

// -- from what the parser read -------------------------------------------------------------------

// The type an annotation describes, given the pattern it was parsed as.
//
// **One annotation makes both**, which is what keeps a single grammar honest: the pattern goes to the
// machine to be tested and the type stays here to be reasoned about. A pattern that could not be a
// type does not reach this -- an annotation that binds is already refused, and so is a type
// declaration that does.
type_from_pattern(pat: Pattern) -> Type
    *pat.kind match
        Wild -> type_of(Any)
        TypePat(test) -> type_of(from_test(test))
        NullPat -> type_of(NullType)
        BoolPat(_) -> type_of(BooleanType)
        IntPat(_) -> type_of(IntegerType)
        RealPat(_) -> type_of(RealType)
        StrPat(_) -> type_of(StringType)
        ArrayPat(_, _, _, _) -> type_of(ArrayOf(type_of(Any)))

        // **`array of T` is what `ArrayOf` was carrying an element for**, and it had nothing to put
        // there until there was a syntax. `object of T` answers the bare word: there is no
        // `ObjectWith` shape for "every value fits", and `Any` fits everything, which is the
        // direction this pass is allowed to be wrong in.
        EveryPat(container, element) ->
            if container == IsArray then type_of(ArrayOf(type_from_pattern(element))) else type_of(Any)
        ObjectPat(keys, values, _, optional) ->
            var out: Buf[Type] = buf()

            for i in 0..<values.len()
                out.push(type_from_pattern(values.at(i)))

            type_of(ObjectWith(keys, out, optional))
        DataPat(name, variants) -> type_of(DataType(name, variants))
        VariantPat(name, _, _, _) -> type_of(VariantType(name))

        // **The object half is what is worth saying**, the nominal half being a class as often as a
        // variant and a class having no type of its own here. `Point { x }` therefore says the same
        // thing `{ x }` says, which is true of it and is what the field-name check has just proved.
        MadeFrom(_, inner) -> type_from_pattern(inner)
        OrPat(alts) ->
            var out: Buf[Type] = buf()

            // **Flattened as it is built**, so nothing downstream has to ask whether a union holds
            // one. `A | (B | C)` cannot be written today and will be able to be.
            for i in 0..<alts.len()
                val one = type_from_pattern(alts.at(i))

                *one.kind match
                    OneOf(inner) ->
                        for j in 0..<inner.len()
                            out.push(inner.at(j))
                    _ -> out.push(one)

            type_of(OneOf(out))

        // **An intersection of object shapes is one object shape with the fields of both**, which is
        // what a handler annotated `Authed & Noted` is describing. Anything else answers `Any`:
        // there is no `AllOf` in this lattice, and inventing one to describe a shape no program
        // writes would be a case in `fits`, `write_type` and every walk that reads a type, saying
        // nothing any of them could use. **`Any` fits everything, which is the safe direction** --
        // this pass may miss a complaint and may never invent one.
        AndPat(parts) ->
            var keys: Buf[string] = buf()
            var out: Buf[Type] = buf()
            var maybe: Buf[bool] = buf()

            for i in 0..<parts.len()
                *type_from_pattern(parts.at(i)).kind match
                    ObjectWith(ks, ts, os) ->
                        for j in 0..<ks.len()
                            keys.push(ks.at(j))
                            out.push(ts.at(j))
                            maybe.push(os.at(j))
                    _ -> return type_of(Any)

            type_of(ObjectWith(keys, out, maybe))

        // A binding cannot be a type and does not reach here; answering `Any` rather than refusing
        // keeps this total, which a conversion wants to be.
        _ -> type_of(Any)
end type_from_pattern

private from_test(test: TypeTest) -> TypeKind
    test match
        IsNull -> NullType
        IsBool -> BooleanType
        IsInt -> IntegerType
        IsReal -> RealType
        IsNum -> NumberType
        IsStr -> StringType
        IsArray -> ArrayOf(type_of(Any))
        IsObject -> ObjectWith(buf(), buf(), buf())
        IsFn -> FunctionType(buf(), 0, false, type_of(Any))

        // **Named by the word the test was written with.** `type_test_text` is what names them, so
        // the checker's vocabulary and the program's cannot drift: adding another kind of this shape
        // is a line in `type_test_named` and one arm here.
        IsInstant -> NamedType(type_test_text(test))
        IsDuration -> NamedType(type_test_text(test))
        IsDate -> NamedType(type_test_text(test))
        IsTime -> NamedType(type_test_text(test))
        IsDateTime -> NamedType(type_test_text(test))
        IsZone -> NamedType(type_test_text(test))
        IsZoned -> NamedType(type_test_text(test))
        IsPeriod -> NamedType(type_test_text(test))

        IsGen -> NamedType(type_test_text(test))
        IsPromise -> NamedType(type_test_text(test))
        IsRegex -> RegexType

        // **A word and nothing else, which is what `NamedType` is for.** A shape describes a set of
        // values and this pass reasons about none of it: two shapes fit each other because both are
        // shapes, exactly as two dates do.
        IsShape -> NamedType(type_test_text(test))
end from_test

// -- saying one out loud ----------------------------------------------------------------------------

// How a type is written, for a diagnostic and for a test to compare against.
//
// **It is written the way a program would write it**, so that a message quoting a type and a reader
// writing one are looking at the same thing.
show_type(t: Type) -> string
    var out = str_builder()

    write_type(&out, t)
    out.finish()
end show_type

private write_type(out: *StrBuilder, t: Type)
    *t.kind match
        Any -> out.push("any")
        NullType -> out.push("null")
        BooleanType -> out.push("boolean")
        IntegerType -> out.push("integer")
        RealType -> out.push("real")
        NumberType -> out.push("number")
        StringType -> out.push("string")
        ArrayOf(element) ->
            *element.kind match
                Any -> out.push("array")
                _ ->
                    out.push("array of ")
                    write_type(out, element)
        ObjectWith(keys, values, optional) ->
            if keys.len() == 0
                out.push("object")
                return

            out.push("{ ")

            for i in 0..<keys.len()
                if i > 0 then out.push(", ")

                out.push(keys.at(i))

                // The `?` is written back where the annotation wrote it, so a complaint about a
                // shape says which of its fields the value did not have to supply.
                if optional.at(i) then out.push("?")

                out.push(": ")
                write_type(out, values.at(i))

            out.push(" }")
        FunctionType(params, required, variadic, result) ->
            if params.len() == 0
                *result.kind match
                    Any ->
                        out.push("function")
                        return
                    _ -> ()

            out.push("(")

            for i in 0..<params.len()
                if i > 0 then out.push(", ")

                write_type(out, params.at(i))

                // A parameter that may be left out is marked where it is written, so a signature
                // says what a call is allowed to be as well as what it takes.
                if i >= required then out.push("?")

            out.push(") -> ")
            write_type(out, result)
        NamedType(name) -> out.push(name)
        DataType(name, _) -> out.push(name)
        VariantType(name) -> out.push(name)
        RegexType -> out.push("regex")
        OneOf(alts) ->
            for i in 0..<alts.len()
                if i > 0 then out.push(" | ")

                write_type(out, alts.at(i))
end write_type
