module dev.slatelang.slate

import sh.sysl.libuv
import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{str_builder, Search}

// Loading a program, running it, and running the tests a file declared.
//
// **`prepare` is `run` without the tests, and the two must not drift**: a change to how a program is
// loaded, compiled or started belongs in both. They are separate rather than factored because `run`
// answers a `Ran` and `prepare` answers a sentence.

// -- the entry point --------------------------------------------------------------------------------

// Compile a source and everything it imports, and run the lot.
run(src: Source) -> Ran
    reset_heap()
    reset_vm()
    reset_events()
    reset_async()
    reset_types()
    output.clear()

    val loaded = load_program(src)

    // **Nothing is compiled while anything is wrong with any file**, which is what makes a
    // diagnostic about a missing export a diagnostic rather than a fault at run time.
    if !loaded.ok() then return Ran(Null, loaded.report, loaded.srcs, loaded.sources, output, 0)

    current_unit = new_unit()
    current_unit.packages = loaded.packages

    // **The unit is told about every file before anything is compiled from any of them**, because a
    // chunk is stamped with an index into this list and a fault carries the same index out.
    for i in 0..<loaded.sources.len()
        current_unit.sources.push(loaded.sources.at(i))

    // Post-order, so a module is compiled -- and later run -- only once everything it imports has
    // been. The entry is the last of them.
    for i in 0..<loaded.order.len()
        val which = loaded.order.at(i)

        compile_module(&current_unit, loaded.programs.at(which), which, loaded.sources.at(which).name, which == 0)

    // **The compiler has complaints of its own, and they stop the program exactly as the parser's
    // do.** A name in a pattern that turned out to be a binding where a type was wanted is knowable
    // only once the types are resolved, which is here rather than while parsing.
    if compile_went_wrong()
        var found = loaded.report
        var found_srcs = loaded.srcs

        found.absorb(compile_report())

        val more = compile_report_srcs()

        for i in 0..<more.len()
            found_srcs.push(more.at(i))

        return Ran(Null, found, found_srcs, loaded.sources, output, 0)
    end if

    // **TWO scopes, because a built-in module sees names a program does not.** `natives` holds every
    // builtin and is what `slate:time`'s own chunk is run against -- it is a `LoadName` per export and
    // has to find them. `core` holds the ones no module has taken, and is what a program's own files
    // run against, so `date(...)` without an import is the run-time fault it should be.
    var natives = new_env(null)
    var core = new_env(null)

    hold_env(natives)
    hold_env(core)
    install_builtins(natives)
    install_core(core)

    var rep = loaded.report

    // **The report and the file list are copied out of `loaded` because a fault appends to both.**
    // The signal the program stopped with carries the file its span belongs to, so the pair stays in
    // step exactly as the parse-time ones did.
    var srcs = loaded.srcs

    // **The program runs, and then the loop drains.** A slate program with a timer or a pending
    // `await` in it does not exit when its last statement does, which is node's rule and the whole
    // point of having a loop.
    //
    // **A failure nothing was waiting for is the program's failure**, checked once everything has
    // settled: until then there is no telling a promise that will be awaited on the next line from
    // one that never will be.
    // **Rooted for the drain, for `run_one_test`'s reason** -- this is the same `Value` in the same
    // sysl local across the same call, and the whole program's answer rather than one test's.
    val mark = root_mark()

    val answer: Step = run_modules(natives, core) match
        Ok(v) ->
            hold(v)

            drain_events() match
                Ok(_) -> unhandled_rejection() match
                    Some(s) -> Err(s)
                    None -> Ok(v)
                Err(s) -> Err(s)
        Err(s) -> Err(s)

    release(mark)

    answer match
        Ok(v) -> Ran(v, rep, srcs, loaded.sources, output, 0)

        // **`exit` is not a failure and is not reported**, which is the whole of what makes it
        // different from every other way a run ends early. The status travels out to the driver and
        // the report stays as it was, so a script that prints its answer and exits 3 prints its
        // answer -- where adding a complaint would have it print a diagnostic nobody asked for.
        Err(Quit(_, _, n)) -> Ran(Null, rep, srcs, loaded.sources, output, n)
        Err(s) ->
            rep.add(error(signal_span(s), signal_message(s)))
            srcs.push(signal_source(s))
            Ran(Null, rep, srcs, loaded.sources, output, 0)
end run

// -- running the tests a file declared -------------------------------------------------------------

// How one `@test` went.
struct TestRan
    name: string
    ok: bool

    // Whether the test asked to be left out here, in which case `said` is its reason.
    //
    // **A third state and not a kind of pass**, so a suite that quietly stopped running half of
    // itself says so in the summary rather than reporting a hundred greens.
    left_out: bool

    // The failure, rendered against the file that raised it. Empty where it passed.
    said: string

    // What the test printed, which is worth showing only when it did not pass.
    printed: string

    // How long it took, in milliseconds.
    ms: u64
end TestRan

// Everything `slate test` found in one file.
struct Tested
    // Empty unless the file would not load or would not compile, in which case no test ran.
    report: string

    results: Buf[TestRan]

    passed(self) -> usize
        var n: usize = 0

        for i in 0..<self.results.len()
            if self.results.at(i).ok then n += 1

        n
    end passed

    left_out(self) -> usize
        var n: usize = 0

        for i in 0..<self.results.len()
            if self.results.at(i).left_out then n += 1

        n
    end left_out

    // **A count and no longer a subtraction**, a skipped test being neither a pass nor a failure.
    failed(self) -> usize = self.results.len() - self.passed() - self.left_out()
end Tested

// Load a file, run its top level, and then run every `@test` it declared.
//
// **The top level runs first and its faults are the file's, not any test's.** A file whose module
// body fails has no working tests to speak of, so that is reported as the file failing to load
// rather than as every test failing for the same reason.
run_tests(src: Source) -> Tested = run_tests_named(src, "")

// The same, running only the tests whose name contains `only` -- everything where it is empty.
//
// **The file still LOADS whatever the filter says**, a test's name being a thing the file has to run
// to declare. So a filter narrows what is run and never what is compiled, and a file that will not
// load is a failure under a filter exactly as it is without one.
//
// **`@setupAll` runs only where something was chosen.** A filter that picks nothing out of a file has
// no test for it to prepare, and preparing anyway would start a database for a file nobody asked to
// run.
run_tests_named(src: Source, only: string) -> Tested
    val started = prepare(src)

    if started != "" then return Tested(started, buf())

    // The tests were registered as the entry module ran, and the closures in `registered_tests` are
    // what keep their module's scope -- and everything they can see -- alive.
    var results: Buf[TestRan] = buf()
    var chosen: Buf[TestCase] = buf()

    for i in 0..<registered_tests.len()
        val t = registered_tests.at(i)

        if only == "" || t.name.contains(only) then chosen.push(t)

    if chosen.is_empty() then return Tested("", results)

    output.clear()

    // **The file's own event-loop scope opens here and closes after `@teardownAll`.** What a
    // `@setupAll` opens is meant to stand for the whole file, so nothing between here and the last
    // teardown may wait for it to close -- see `drain_events_to`.
    val floor = outstanding

    val opened = run_hook(HookSetupAll)

    for i in 0..<chosen.len()
        run_guarded(chosen.at(i), opened, &results)

    // **`@teardownAll` runs even where `@setupAll` faulted**, which is what a teardown is for: the
    // state it gives back is exactly the state a setup that stopped halfway left behind.
    hook_verdict(HookTeardownAll, run_hook(HookTeardownAll), &results)

    // **And the file's drain comes after it**, so the loop is given its last turns once the file has
    // had its chance to hand back what it took. A fault raised there belongs to the pair that
    // bracketed the file, there being no test left for it to be about.
    val over = drain_verdict(floor)

    if over != ""
        val whose = if hook_names.at(HookTeardownAll) != "" then HookTeardownAll else HookSetupAll

        results.push(TestRan(hook_names.at(whose), false, false, over, printed_so_far(), 0))
    end if

    Tested("", results)
end run_tests_named

// Everything `run` does up to and including the modules, answering a rendered complaint or nothing.
private prepare(src: Source) -> string
    reset_heap()
    reset_vm()
    reset_events()
    reset_async()
    reset_types()
    output.clear()

    val loaded = load_program(src)

    if !loaded.ok() then return Ran(Null, loaded.report, loaded.srcs, loaded.sources, output, 0).render()

    current_unit = new_unit()
    current_unit.packages = loaded.packages

    for i in 0..<loaded.sources.len()
        current_unit.sources.push(loaded.sources.at(i))

    for i in 0..<loaded.order.len()
        val which = loaded.order.at(i)

        compile_module(&current_unit, loaded.programs.at(which), which, loaded.sources.at(which).name, which == 0)

    if compile_went_wrong()
        var found = loaded.report
        var found_srcs = loaded.srcs

        found.absorb(compile_report())

        val more = compile_report_srcs()

        for i in 0..<more.len()
            found_srcs.push(more.at(i))

        return Ran(Null, found, found_srcs, loaded.sources, output, 0).render()
    end if

    var natives = new_env(null)
    var core = new_env(null)

    hold_env(natives)
    hold_env(core)
    install_builtins(natives)
    install_core(core)

    run_modules(natives, core) match
        Err(sig) -> return complaint(sig)
        Ok(_) -> ()

    drain_events() match
        Err(sig) -> return complaint(sig)
        Ok(_) -> ()

    unhandled_rejection() match
        Some(sig) -> complaint(sig)
        None -> ""
end prepare

// Everything `run` does up to the point the program would start, for a caller that wants the TREE
// rather than the run.
//
// **What `slate js` needs, and the reason it is not `prepare`**: a back end wants the files and the
// checker's verdict on them, and specifically does not want the program run. The two share nothing
// but their shape, so there is nothing here to drift -- this compiles for the diagnostics and throws
// the chunks away.
//
// **Compiling is what asks the checker**, and its complaints are the ones worth having before a
// program is turned into somebody else's language: a name that is not defined is a `ReferenceError`
// in JavaScript, thrown at a line the reader did not write, and a caret here instead.
loaded_and_checked(src: Source) -> (Loaded, string)
    reset_heap()
    reset_vm()
    reset_events()
    reset_async()
    reset_types()
    output.clear()

    val loaded = load_program(src)

    if !loaded.ok()
        return (loaded, Ran(Null, loaded.report, loaded.srcs, loaded.sources, output, 0).render())

    current_unit = new_unit()
    current_unit.packages = loaded.packages

    for i in 0..<loaded.sources.len()
        current_unit.sources.push(loaded.sources.at(i))

    for i in 0..<loaded.order.len()
        val which = loaded.order.at(i)

        compile_module(&current_unit, loaded.programs.at(which), which, loaded.sources.at(which).name, which == 0)

    if compile_went_wrong()
        var found = loaded.report
        var found_srcs = loaded.srcs

        found.absorb(compile_report())

        val more = compile_report_srcs()

        for i in 0..<more.len()
            found_srcs.push(more.at(i))

        return (loaded, Ran(Null, found, found_srcs, loaded.sources, output, 0).render())
    end if

    (loaded, "")
end loaded_and_checked

// Complaints from a pass that is not the machine's, drawn against the files they are about.
//
// **`Ran.render` and never `Report.render`**: a program is as many files as it imports, and a report
// rendered against one `Source` quotes the wrong line for every complaint about another. The
// JavaScript back end is the caller -- it walks every module of a program, so its report is the same
// shape the loader's is.
rendered_against(loaded: Loaded, rep: Report, srcs: Buf[usize]) -> string =
    Ran(Null, rep, srcs, loaded.sources, output, 0).render()

// One signal, drawn against the file it came from.
private complaint(sig: Signal) -> string
    var rep = report()
    var srcs: Buf[usize] = buf()

    rep.add(error(signal_span(sig), signal_message(sig)))
    srcs.push(signal_source(sig))
    Ran(Null, rep, srcs, current_unit.sources, output, 0).render()
end complaint

// One test with whatever the file wrote around it, and the verdicts that came of it.
//
// **THE `@setup`, THE TEST AND THE `@teardown` ARE ONE EVENT-LOOP SCOPE, AND THE DRAIN COVERS THE
// TRIPLE.** Each of the three is run only as far as its own answer settling, so a handle one of them
// opens is still open for the next -- a listener a setup starts is a listener the test can connect
// to -- and the loop is drained once, at the end, down to what was outstanding before the setup
// began. **The teardown runs BEFORE that drain**, which is what makes a teardown able to give back
// what the test took: a timer the test armed is cleared rather than waited out.
//
// **The `@teardown` runs however the test went -- passed, failed, or left out -- and however the
// `@setup` went.** What a teardown gives back is exactly what a setup that stopped halfway had
// already taken, so the one case where skipping it would be tempting is the one where it matters.
private run_guarded(t: TestCase, opened: HookRan, results: *Buf[TestRan])
    val began = libuv.hrtime()

    output.clear()

    // **`@setupAll` decided for every test in the file at once**, so a fault in it is this test's
    // failure and its `skip` is this test's skip -- and neither the per-test hooks nor the test run.
    if opened.left_out
        results.push(TestRan(t.name, false, true, opened.reason, "", 0))
        return
    end if

    if opened.said != ""
        results.push(TestRan(t.name, false, false, guarded_by(HookSetupAll, opened.said), "", 0))
        return
    end if

    // What the drain at the end is owed: everything above this. Whatever the file's `@setupAll`
    // opened is under it and is nothing this test may wait for.
    val floor = outstanding

    val before = run_hook(HookSetup)

    var left_out = false
    var reason = ""
    var said = ""

    if before.left_out
        left_out = true
        reason = before.reason
    elif before.said != ""
        said = guarded_by(HookSetup, before.said)
    else
        // The verdict a `skip` leaves behind, cleared before every test rather than after -- a test
        // that never called it must not inherit the last one's reason.
        skip_asked = false
        skip_reason = ""

        said = settled_call(t.fn, "a test")

        // **A skip beats whatever the unwind came out as**, which is what makes the asynchronous
        // case work: a `skip` inside an `async` test arrives here as a rejected promise, and the
        // reason was written down where it was called. It is read before the teardown runs, the
        // teardown clearing both.
        if skip_asked
            left_out = true
            reason = skip_reason
            said = ""
        end if
    end if

    // What the test printed, taken before the teardown so a tidy-up's own output is the teardown's.
    val printed = printed_so_far()

    val after = run_hook(HookTeardown)

    // The one drain, now that the teardown has given back whatever it was going to.
    val drained = drain_verdict(floor)

    // **A fault the drain turned up is the test's**, a timer that was left armed and threw being
    // something the test did -- and it is folded in only where the test had nothing to say for
    // itself, one mistake being worth one sentence.
    if !left_out && said == "" then said = drained

    val ok = !left_out && said == ""

    results.push(TestRan(t.name, ok, left_out, if left_out then reason else said, printed, elapsed(began)))
    hook_verdict(HookTeardown, after, results)
end run_guarded

// How a `@setup`, `@teardown`, `@setupAll` or `@teardownAll` went.
struct HookRan
    // The failure it left, rendered against the file that raised it. Empty where it did not fault.
    said: string

    // Whether it asked for the test to be left out, and why.
    left_out: bool
    reason: string
end HookRan

// Call one of them, where the file wrote one at all.
private run_hook(kind: usize) -> HookRan
    val fn = hook_fns.at(kind)

    fn match
        Null -> HookRan("", false, "")
        _ ->
            skip_asked = false
            skip_reason = ""

            val said = settled_call(fn, hook_names.at(kind))

            if !skip_asked then return HookRan(said, false, "")

            // **A `skip` in a teardown has no test left to leave out**, the verdict having been
            // given, so it is a complaint about the teardown rather than a third state.
            if kind == HookTeardown || kind == HookTeardownAll
                return HookRan(s"`${hook_names.at(kind)}` called `skip`, and a teardown has no test to leave out", false, "")

            HookRan("", true, skip_reason)
end run_hook

// A teardown's own failure, kept as a verdict of its own.
//
// **Never swallowed, and never folded into the test's verdict.** A test that passed and a teardown
// that broke are two things a reader needs told apart, and a teardown that fails after a test that
// already failed is the case where folding would lose it altogether -- so it is counted on the last
// line as the failure it is.
private hook_verdict(kind: usize, ran: HookRan, results: *Buf[TestRan])
    if ran.said == "" then return

    results.push(TestRan(hook_names.at(kind), false, false, ran.said, printed_so_far(), 0))
end hook_verdict

// A failure a test never reached, named after the thing that was supposed to prepare it.
private guarded_by(kind: usize, said: string) -> string =
    s"`${hook_names.at(kind)}` failed before this test ran\n${said}"

// The complaint a drain down to `floor` left behind, and nothing where it left none.
private drain_verdict(floor: usize) -> string
    val said = drain_events_to(floor) match
        Err(sig) -> complaint(sig)
        Ok(_) -> unhandled_rejection() match
            Some(sig) -> complaint(sig)
            None -> ""

    forget_rejections()
    said
end drain_verdict

// One call of no arguments: make it, wait for it alone, and read the verdict.
//
// **An `async` one is waited for rather than refused.** Calling it starts a coroutine and hands back
// a promise that has not settled, so a runner that read the answer straight away would call every
// asynchronous test a pass. The promise is marked handled first, so that a failure is reported here
// as this call's rather than at the end of the drain as the file's.
//
// **What is waited for is THIS call and not the loop**, which is `run_guarded`'s whole arrangement:
// a setup, a test and a teardown share one scope, so the loop is turned here only until this one
// answer settles and drained once at the end of the three.
private settled_call(fn: Value, what: string) -> string
    var args: Buf[Value] = buf()

    val said = apply_callback(fn, args, point(0), what) match
        Ok(v) ->
            // **THE PROMISE IS ROOTED ACROSS THE DRAIN, AND A sysl LOCAL IS NOT A ROOT.** The
            // collector walks the machine, the slots and this shadow stack; it cannot see a `Value`
            // sitting in a sysl variable, which is the rule `net.sysl` states about what a callback
            // may capture and it binds here for the same reason. `settle_call` runs whatever the
            // rest of this call needs, so a collection inside it is not a possibility but a
            // certainty for any test that allocates -- and an unrooted promise is freed there, its
            // memory handed to the next `new_promise`, and read back below as a promise that has
            // not settled.
            //
            // What that looks like is a test whose body ran to its last line and is reported as
            // never having finished. It moves when anything nearby allocates differently, which is
            // what makes it read as a defect in whatever was being tested.
            val mark = root_mark()

            hold(v)

            v match
                Promise(pr) -> pr.handled = true
                _ -> ()

            val after = settle_call(v) match
                Err(sig) -> complaint(sig)
                Ok(_) -> unhandled_rejection() match
                    Some(sig) -> complaint(sig)
                    None -> awaited_verdict(v)

            release(mark)
            after
        Err(sig) -> complaint(sig)

    // **What was reported here is not reported again by the next phase.** A test is three calls now
    // -- its `@setup`, itself, its `@teardown` -- each of which asks `unhandled_rejection`, and a
    // rejection left on the list would fail all three for one fault.
    forget_rejections()
    said
end settled_call

// What an `async` test's promise came to, once the loop has run it to the end.
private awaited_verdict(v: Value) -> string
    v match
        Promise(pr) ->
            if !pr.settled
                return "this test never finished -- something it awaited was never going to settle"

            if pr.failed then said_at(pr.message, pr.at) else ""
        _ -> ""
end awaited_verdict

// A message and a place, drawn against the file the machine was last in.
private said_at(message: string, at: Span) -> string
    var rep = report()
    var srcs: Buf[usize] = buf()

    rep.add(error(at, message))
    srcs.push(current_source)
    Ran(Null, rep, srcs, current_unit.sources, output, 0).render()
end said_at

// Everything printed since the output was last cleared, which is at the top of each test.
private printed_so_far() -> string
    var out = str_builder()

    for i in 0..<output.len()
        if i > 0 then out.push_char('\n')

        out.push(output.at(i))

    out.finish()
end printed_so_far

private elapsed(began: u64) -> u64 = (libuv.hrtime() - began) / 1000000

// Every module in turn, each in a scope of its own under the builtins.
//
// **A module gets its own scope and not a shared one**, which is the whole of what makes a file's
// top-level `val` private to it: nothing but what the file exported can be reached from outside, and
// two files may each call something `helper` without either knowing.
//
// The value answered is the entry module's exports, the entry being the last to run.
private run_modules(natives: *EnvObj, core: *EnvObj) -> Step
    var last: Value = Null

    for i in 0..<current_unit.modules.len()
        // **One of slate's own modules is compiled against every builtin; a program's file is not.**
        // The module's chunk is a `LoadName` per export and nothing else, so it has to be able to see
        // what it exports -- and a program that has not imported a name must not.
        val scope = new_env(if is_slate_module(current_unit.module_paths.at(i)) then natives else core)
        val mark = env_mark()

        hold_env(scope)

        // A module takes no arguments and never slots, its names being what an import reads.
        val answer = run_chunk(&current_unit, current_unit.modules.at(i), scope, buf())

        release_env(mark)

        answer match
            Ok(v) ->
                // **Pushed with nothing allocated in between**, so the object cannot be swept
                // between being answered and becoming a root.
                module_values.push(v)
                last = v
            Err(s) -> return Err(s)

    Ok(last)
end run_modules
