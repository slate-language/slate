module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// Which chunks put their names in numbered slots, and what a slotted chunk still gets right.
//
// **THESE ARE THE TESTS THAT WOULD OTHERWISE PASS VACUOUSLY.** Slotting is an optimisation, so every
// question about what a program ANSWERS is green whether the chunk slotted or not -- which means a
// change that quietly stopped slotting anything would break no test at all, and so would one that
// slotted a chunk it must not. `tests/lang/` covers the answers on both back ends; this file covers
// the decision, by compiling a program and asking the chunk.
//
// The behaviour that goes with each of these is in `tests/lang/frames.sl`, where it runs under the
// JavaScript back end too.

// Whether the chunk of that name slotted its names, after running the program.
//
// **`current_unit` is module state and outlives `run`**, which is what makes this possible without a
// second entry point into the compiler. A name no chunk has is a failure rather than a false: asking
// about a function that is not there is a test that has rotted, and answering "no" would hide it.
private slotting(program: string, name: string) -> bool
    out(program)

    for i in 0..<running_unit().chunks.len()
        if running_unit().chunks.at(i).name == name then return running_unit().chunks.at(i).slotted

    assert(false, s"no chunk is called `${name}`")
    false
end slotting

// How many cells that chunk reserves.
private slot_count(program: string, name: string) -> usize
    out(program)

    for i in 0..<running_unit().chunks.len()
        if running_unit().chunks.at(i).name == name then return running_unit().chunks.at(i).slots

    assert(false, s"no chunk is called `${name}`")
    0
end slot_count

// How many scopes that chunk pushes at run time, read off the code itself.
// **A NAME BELONGS TO TWO CHUNKS AND THE ANSWER IS THE LARGEST.** `compile_module` compiles a file
// twice -- once whole and once as its declarations alone -- so a module has its own chunk beside a
// declarations-only one holding a subset of its statements, and a top-level definition has two
// chunks of one name that are copies of each other. Reading the FIRST match answers a module's
// question about whichever of the two it met, which is the way a test of this kind rots without ever
// going red; the declarations are a subset either way, so the largest count is the real one.
private scope_pushes(program: string, name: string) -> usize
    out(program)

    var most: usize = 0
    var found = false

    for i in 0..<running_unit().chunks.len()
        if running_unit().chunks.at(i).name != name then continue

        found = true

        val code = running_unit().chunks.at(i).code
        var n: usize = 0

        for k in 0..<code.len()
            code.at(k).op match
                PushScope -> n += 1
                _ -> ()

        if n > most then most = n

    assert(found, s"no chunk is called `${name}`")
    most
end scope_pushes

@test
A_PLAIN_FUNCTION_SLOTS_ITS_PARAMETERS_AND_ITS_LOCALS()
    assert(slotting("f(a, b)\n    val c = a + b\n    c\nprint(f(1, 2))", "f"))

    // Two parameters and one local.
    assert_eq(slot_count("f(a, b)\n    val c = a + b\n    c\nprint(f(1, 2))", "f"), 3)
end A_PLAIN_FUNCTION_SLOTS_ITS_PARAMETERS_AND_ITS_LOCALS

@test
A_MODULE_NEVER_SLOTS_BECAUSE_AN_IMPORT_READS_ITS_NAMES_BY_NAME()
    assert_eq(slot_count("val a = 1\nprint(a)", "t"), 0)
end A_MODULE_NEVER_SLOTS_BECAUSE_AN_IMPORT_READS_ITS_NAMES_BY_NAME

@test
A_CHUNK_HOLDING_A_NESTED_FUNCTION_KEEPS_THE_NAMES_IT_READS_IN_THE_CHAIN()
    // A closure captures the scope chain by pointer and may read a name long after the frame that
    // declared it has returned, so a name it reads stays where it can find it.
    assert(!slotting("f(a)\n    val g = () -> a\n    g()\nprint(f(1))", "f"))
    assert(!slotting("f(a)\n    g() = a\n    g()\nprint(f(1))", "f"))
end A_CHUNK_HOLDING_A_NESTED_FUNCTION_KEEPS_THE_NAMES_IT_READS_IN_THE_CHAIN

@test
A_CHUNK_HOLDING_A_LAMBDA_CELLS_EVERY_NAME_THE_LAMBDA_CANNOT_REACH()
    // **THIS IS THE WHOLE CLAIM OF PER-NAME SLOTTING AND NO BEHAVIOUR TEST CAN SEE IT.** One
    // `Lambda` anywhere used to cost a chunk every cell it had, and most functions hold a lambda
    // somewhere -- so a chunk kept four names in the chain over the one a closure actually read.
    val prog = "f()\n    var total = 0\n    var turns = 0\n    val scale = 3\n    val weigh = (v) -> v * scale\n\n    while turns < 3\n        total = total + weigh(turns)\n        turns = turns + 1\n\n    total\nprint(f())"

    // It keeps its scope, `scale` living there for the closure to read.
    assert(!slotting(prog, "f"))

    // And `total`, `turns` and `weigh` are cells beside it -- three of its four names.
    assert_eq(slot_count(prog, "f"), 3)
    assert_eq(out(prog), "9")
end A_CHUNK_HOLDING_A_LAMBDA_CELLS_EVERY_NAME_THE_LAMBDA_CANNOT_REACH

@test
A_LAMBDA_THAT_REACHES_NOTHING_OF_ITS_CHUNK_LEAVES_IT_WHOLE()
    // **A closure's own parameters shadow for the length of its body**, so `(x) -> x * x` written
    // beside an `x` of ours reaches its own and takes nothing from us -- which is the one thing the
    // free-name walk subtracts, and the reason it is worth subtracting.
    val prog = "f(xs)\n    val x = 2\n    val double = (x) -> x * x\n\n    double(x)\nprint(f([]))"

    assert(slotting(prog, "f"))
    assert_eq(slot_count(prog, "f"), 3)
    assert_eq(out(prog), "4")
end A_LAMBDA_THAT_REACHES_NOTHING_OF_ITS_CHUNK_LEAVES_IT_WHOLE

@test
A_BINDING_SITE_ONE_OF_WHOSE_NAMES_IS_KEPT_PUTS_ALL_OF_THEM_IN_THE_SCOPE()
    // **`UnpackSlots` fills a RUN of cells the matcher pushed in order**, so a pattern one of whose
    // names must stay in the chain has no run to fill and takes the scope path whole. What that
    // costs is the neighbouring name's cell; what it would cost to get wrong is a binding read out
    // of somebody else's cell, which is what `AN_INNER_SCOPE_BINDING_SHADOWS_AN_OUTER_CELL` pins.
    val prog = "f(pairs)\n    var seen = 0\n    val a = 100\n\n    for [a, b] in pairs\n        val note = () -> b\n\n        seen = seen + a + note()\n\n    seen + a\nprint(f([[1, 2], [3, 4]]))"

    assert(!slotting(prog, "f"))

    // `seen`, the outer `a` and `note` -- the loop head's two names went to the scope together.
    assert_eq(slot_count(prog, "f"), 3)
    assert_eq(out(prog), "110")
end A_BINDING_SITE_ONE_OF_WHOSE_NAMES_IS_KEPT_PUTS_ALL_OF_THEM_IN_THE_SCOPE

@test
A_CHUNK_WHOSE_OWN_NAME_A_PATTERN_MENTIONS_DOES_NOT_SLOT()
    // **`ProtoPat` looks a class name up in the scope the match is RUNNING in**, so a parameter
    // shadowing a class makes the test false -- and a slotted name is not in that scope at all, so
    // the lookup would walk past the shadow and find the class. Refusing the chunk is what keeps the
    // answer the one `tests_classes.sysl` pins.
    val prog = "class A\n    new(x) = { x: x }\nval a = A.new(1)\nf(A) = a is A\nprint(f(A))"

    assert(!slotting(prog, "f"))

    // The same function without the shadow slots as usual.
    assert(slotting("class A\n    new(x) = { x: x }\nval a = A.new(1)\nf(v) = v is A\nprint(f(a))", "f"))
end A_CHUNK_WHOSE_OWN_NAME_A_PATTERN_MENTIONS_DOES_NOT_SLOT

@test
A_catch_BINDS_ONE_NAME_AND_NO_PATTERN_SO_ITS_CHUNK_STILL_SLOTS()
    // The binding form with no ordering question in it, which is why it is the one taught first.
    val prog = "boom()\n    throw \"no\"\nf()\n    val v = boom() catch e ->\n        e.message\n\n    v\nprint(f())"

    assert(slotting(prog, "f"))

    // The local and the handler's name are two cells.
    assert_eq(slot_count(prog, "f"), 2)
    assert_eq(out(prog), "no")
end A_catch_BINDS_ONE_NAME_AND_NO_PATTERN_SO_ITS_CHUNK_STILL_SLOTS

@test
TWO_catch_BLOCKS_USING_ONE_NAME_TAKE_TWO_CELLS()
    // **A slot is never reused when its block ends**, so two handlers spelling their name the same
    // way are two cells rather than one written twice -- which is what makes the second one's value
    // its own however the first one went.
    val prog = "one()\n    throw \"one\"\ntwo()\n    throw \"two\"\nf()\n    val a = one() catch e ->\n        e.message\n\n    val b = two() catch e ->\n        e.message\n\n    a + \" \" + b\nprint(f())"

    assert(slotting(prog, "f"))
    assert_eq(out(prog), "one two")
end TWO_catch_BLOCKS_USING_ONE_NAME_TAKE_TWO_CELLS

@test
A_catch_NAME_SHADOWS_AN_OUTER_ONE_AND_GIVES_IT_BACK()
    val prog = "boom()\n    throw \"inner\"\nf()\n    val e = \"outer\"\n    val caught = boom() catch e ->\n        e.message\n\n    caught + \" \" + e\nprint(f())"

    assert(slotting(prog, "f"))
    assert_eq(out(prog), "inner outer")
end A_catch_NAME_SHADOWS_AN_OUTER_ONE_AND_GIVES_IT_BACK

@test
A_FAULT_RAISED_IN_A_CALL_IS_CAUGHT_WITH_THE_CATCHERS_OWN_SLOTS_INTACT()
    // **The handler runs in the frame the `try` was written in**, which may be several calls above
    // where the fault was raised -- so its slots have to be exactly what they were. `guarded` cuts
    // the stack back to the height `PushHandler` recorded, which sits above the slot window.
    val prog = "deep(n)\n    if n == 0 then throw \"bottom\"\n\n    deep(n - 1)\nf()\n    val marker = 42\n    val said = deep(3) catch e ->\n        e.message\n\n    said + \" \" + string(marker)\nprint(f())"

    assert(slotting(prog, "f"))
    assert_eq(out(prog), "bottom 42")
end A_FAULT_RAISED_IN_A_CALL_IS_CAUGHT_WITH_THE_CATCHERS_OWN_SLOTS_INTACT

@test
A_CHUNK_HOLDING_AN_is_THAT_BINDS_A_NAME_DOES_NOT_SLOT()
    // **A slotted chunk has no `EnvObj` of its own**, so a pattern that binds while it runs writes
    // into the scope its closure captured -- which outlives the call. `is` is the one binding form
    // that can appear in a chunk this stage otherwise slots, and the cheap answer is not to slot it.
    val binds = "var n = 0\nnamed(v) = v is n\nprint(named(7))\nprint(n)"

    assert(!slotting(binds, "named"))
    assert_eq(out(binds), "true\n0")

    // **And a name a TYPE declares is not a binding**, which is the distinction that keeps this
    // refusal narrow: `v is Point` looks a class up and binds nothing, so its chunk still slots.
    val tests = "class Point\n    var x\n    var y\n\nsame(v) = v is Point\nprint(same(Point.new(1, 2)))"

    assert(slotting(tests, "same"))
    assert_eq(out(tests), "true")
end A_CHUNK_HOLDING_AN_is_THAT_BINDS_A_NAME_DOES_NOT_SLOT

@test
A_for_HEAD_THAT_TAKES_ITS_ELEMENT_APART_SLOTS_ITS_NAMES()
    // Three cells: the accumulator the body declares, and the two the head binds each turn.
    val prog = "f(pairs)\n    var out = 0\n\n    for [a, b] in pairs\n        out = out + a * 10 + b\n\n    out\nprint(f([[1, 2], [3, 4]]))"

    assert(slotting(prog, "f"))
    assert_eq(slot_count(prog, "f"), 4)
    assert_eq(out(prog), "46")
end A_for_HEAD_THAT_TAKES_ITS_ELEMENT_APART_SLOTS_ITS_NAMES

@test
A_DESTRUCTURING_BINDING_SLOTS_ITS_NAMES_IN_THE_ORDER_THE_MATCHER_HANDS_THEM_BACK()
    // **The order is the whole of the correctness here**: the compiler claims a cell per name in
    // `pattern_names`' order and the machine writes one per value the walk gathered, so a pattern
    // whose names came back in another order would put every one of them in the wrong cell -- and
    // the program would still run.
    val prog = "f(o)\n    val { name, count } = o\n    val [head, ...rest] = [1, 2, 3]\n\n    name + string(count) + string(head) + string(rest.length)\nprint(f({ name: \"n\", count: 7 }))"

    assert(slotting(prog, "f"))
    assert_eq(out(prog), "n712")
end A_DESTRUCTURING_BINDING_SLOTS_ITS_NAMES_IN_THE_ORDER_THE_MATCHER_HANDS_THEM_BACK

@test
TWO_ARMS_OF_ONE_match_BINDING_ONE_NAME_TAKE_TWO_CELLS()
    val prog = "f(v) = v match\n    [n] -> string(n)\n    [n, m] -> string(n + m)\n    _ -> \"none\"\nprint(f([5]) + \" \" + f([5, 6]) + \" \" + f(1))"

    assert(slotting(prog, "f"))

    // One for the first arm's `n`, two for the second arm's, and the parameter.
    assert_eq(slot_count(prog, "f"), 4)
    assert_eq(out(prog), "5 11 none")
end TWO_ARMS_OF_ONE_match_BINDING_ONE_NAME_TAKE_TWO_CELLS

@test
A_BINDING_PATTERN_WITH_DEFAULTS_SLOTS_AND_CARRIES_A_MASK()
    // **The matcher leaves a defaulted name UNBOUND and still matches**, which is what makes a
    // default a default -- so the collecting walk pushes a placeholder to keep the positions
    // aligned, the machine skips it, and the bit it did not set is what the guarded assignment
    // after the unpack asks about. One cell per name and one bit per cell.
    val defaulted = "f(o)\n    val { title = \"none\", count = 0, tag } = o\n\n    title + string(count) + tag\nprint(f({ tag: \"t\" }))"

    assert(slotting(defaulted, "f"))

    // The parameter and the pattern's three names.
    assert_eq(slot_count(defaulted, "f"), 4)
    assert_eq(out(defaulted), "none0t")

    // **The hole in the middle**, which is the case a count answers wrongly.
    val hole = "f(o)\n    val { title = \"none\", count = 0, tag } = o\n\n    title + string(count) + tag\nprint(f({ count: 9, tag: \"t\" }))"

    assert_eq(out(hole), "none9t")

    val plain = "f(o)\n    val { title } = o\n\n    title\nprint(f({ title: \"said\" }))"

    assert(slotting(plain, "f"))
    assert_eq(out(plain), "said")
end A_BINDING_PATTERN_WITH_DEFAULTS_SLOTS_AND_CARRIES_A_MASK

@test
A_QUESTION_MARK_IN_A_match_ARM_COSTS_ITS_CHUNK_ITS_SLOTS()
    // **A `?` is the one skip a mask cannot answer**, because there is nothing to fill the cell
    // with: a default says what a missing field binds and a `?` says the name is simply absent. So
    // an arm carrying one keeps the scope, where a scope says "not bound" and a cell would hand back
    // whatever it held before. A binding position refuses `?` outright, so a `match` arm is the only
    // place one can be written at all.
    val optional = "f(o) = o match\n    { a?, b } -> \"took \" + string(b)\n    _ -> \"no arm\"\nprint(f({ b: 1 }))"

    assert(!slotting(optional, "f"))
    assert_eq(out(optional), "took 1")

    // The same arm without the `?` slots.
    val plain = "f(o) = o match\n    { a, b } -> \"took \" + string(b)\n    _ -> \"no arm\"\nprint(f({ a: 0, b: 1 }))"

    assert(slotting(plain, "f"))
    assert_eq(out(plain), "took 1")
end A_QUESTION_MARK_IN_A_match_ARM_COSTS_ITS_CHUNK_ITS_SLOTS

@test
AN_ARM_THAT_NAMES_A_CLASS_IS_A_LOOKUP_AND_AN_ARM_THAT_NAMES_ANYTHING_ELSE_IS_A_BINDING()
    // The two readings of one bare name, and the chunk slots either way -- what changes is which
    // list the name joins. `Point` is looked up in the scope the match runs in, so it may not also
    // be a cell of this frame; `other` is a binding, so it must be.
    val prog = "class Point\n    var x\n\nf(v) = v match\n    Point -> \"a point\"\n    other -> \"a \" + string(other)\nprint(f(Point.new(1)) + \" and \" + f(2))"

    assert(slotting(prog, "f"))
    assert_eq(out(prog), "a point and a 2")

    // **And the shadow case the whole `tested` list exists for.** A parameter spelled like the class
    // makes the arm's lookup find the parameter, which is deliberately false -- so a chunk that
    // would slot that name may not slot at all.
    val shadow = "class Point\n    var x\n\nf(Point) = Point match\n    Point -> \"class\"\n    _ -> \"not\"\nprint(f(3))"

    assert(!slotting(shadow, "f"))
    assert_eq(out(shadow), "not")
end AN_ARM_THAT_NAMES_A_CLASS_IS_A_LOOKUP_AND_AN_ARM_THAT_NAMES_ANYTHING_ELSE_IS_A_BINDING


@test
A_SLOTTING_CHUNK_PUSHES_NO_SCOPE_AT_ALL()
    // **This is the test the benchmark cannot be**, and it is the one that says where the win came
    // from: nothing in a chunk that slots declares by name, so the `EnvObj` a block used to push
    // would be built, written to by nothing, and thrown away -- once a turn, in a loop.
    val prog = "f(pairs)\n    var out = 0\n\n    for [a, b] in pairs\n        out = out + a + b\n\n    out\nprint(f([[1, 2]]))"

    assert(slotting(prog, "f"))
    assert_eq(scope_pushes(prog, "f"), 0)

    // **A chunk that KEEPS its scope pushes one, for the block that declares the kept name** -- not
    // one per block. `out` is read by the closure and lives in the scope; `add`, `a` and `b` are
    // cells, so the loop head and the loop body declare nothing into a scope and open none. What is
    // left is the chunk's own body block, which is the one that declared `out`.
    //
    // **The lambda has to READ one of the chunk's names for this to be the second case**, which it
    // did not have to before per-name slotting: `(x, y) -> x + y` reaches nothing of `f`, so a chunk
    // holding one is whole and pushes no scope at all now.
    val kept = "f(pairs)\n    var out = 0\n    val add = (x) -> x + out\n\n    for [a, b] in pairs\n        out = add(a + b)\n\n    out\nprint(f([[1, 2]]))"

    assert(!slotting(kept, "f"))
    assert_eq(scope_pushes(kept, "f"), 1)
    assert_eq(out(kept), "3")
end A_SLOTTING_CHUNK_PUSHES_NO_SCOPE_AT_ALL

@test
A_BLOCK_IN_A_MIXED_CHUNK_THAT_DECLARES_NOTHING_INTO_THE_SCOPE_OPENS_NONE()
    // **THE LAST PLACE THE PER-TURN `EnvObj` WAS LEFT STANDING.** A chunk keeping its scope for one
    // captured name still built one for every block in it -- a loop head whose names are all cells,
    // a body that declares nothing -- and threw it away a turn later, which is B2's finding again
    // in the one shape per-name slotting had just created.
    //
    // Two loops and a `catch`, none of which binds a name the closure can reach.
    val prog = "boom()\n    throw \"x\"\nf(xs)\n    var n = 0\n    val peek = () -> n\n\n    for a in xs\n        n = n + a\n\n    while n < 10\n        n = n + peek()\n\n    val bad = boom() catch e ->\n        1\n\n    n + bad\nprint(f([1, 2]))"

    assert(!slotting(prog, "f"))

    // One scope, for the body block that declared `n`. `xs`, `peek`, `a`, `e` and `bad` are cells.
    assert_eq(scope_pushes(prog, "f"), 1)
    assert_eq(out(prog), "13")
end A_BLOCK_IN_A_MIXED_CHUNK_THAT_DECLARES_NOTHING_INTO_THE_SCOPE_OPENS_NONE

@test
A_BLOCK_THAT_DOES_DECLARE_INTO_THE_SCOPE_STILL_OPENS_ONE()
    // The other side of it, and the one that would be a silent wrong binding rather than a slow
    // program: a loop head binding a name a closure reads has to have somewhere to put it.
    val prog = "f(pairs)\n    var seen = 0\n\n    for [a, b] in pairs\n        val note = () -> b + seen\n\n        seen = seen + a + note()\n\n    seen\nprint(f([[1, 2], [3, 4]]))"

    assert(!slotting(prog, "f"))

    // Two: the body block, which declared `seen` for the closure to read, and the loop head, whose
    // `b` the closure also reads. `a` and `note` are cells in among them.
    assert_eq(scope_pushes(prog, "f"), 2)
    assert_eq(out(prog), "13")
end A_BLOCK_THAT_DOES_DECLARE_INTO_THE_SCOPE_STILL_OPENS_ONE

@test
A_break_POPS_EXACTLY_THE_SCOPES_THAT_WERE_PUSHED()
    // **THE ONE PLACE THIS CAN GO SILENTLY WRONG.** A `break` emits one `PopScope` per level between
    // where it stands and the loop's, counted off `e.scopes` -- so the counter must be raised only by
    // a block that actually pushed. Count every block instead and the break pops a scope nobody
    // pushed, which takes the chunk's OWN scope with it and the kept name in it.
    //
    // Neither loop head declares into a scope here -- `row`, `a` and `b` are all cells -- so the
    // break has nothing to pop, and a miscount would have it pop the block that holds `total`.
    val prog = "f(rows)\n    var total = 0\n    val keep = () -> total\n\n    for row in rows\n        for [a, b] in row\n            if b == 0 then break\n\n            total = total + a + b\n\n    total + keep()\nprint(f([[[1, 2], [3, 0]]]))"

    assert(!slotting(prog, "f"))
    assert_eq(scope_pushes(prog, "f"), 1)

    // 3 from the pair that ran, and `keep()` reads the same `total` afterwards -- which is the read
    // a pop too many makes fail.
    assert_eq(out(prog), "6")
end A_break_POPS_EXACTLY_THE_SCOPES_THAT_WERE_PUSHED

// -- what a call COSTS, which is the other thing a benchmark cannot say ----------------------------
//
// **An ordinary positional call leaves its arguments standing on the operand stack.** They are
// already at the cells the callee's frame begins at, so the buffer a call used to copy them into --
// one `malloc`, one free and two copies of every argument -- is not made at all. That is an
// optimisation, so every question about what a program ANSWERS is green either way; `Vm.args_buffered`
// is the instrument that is not.
//
// **It is a COUNT and it counts the SLOW path**, which is what makes each of these a claim with a
// negative control beside it: the fast path is asserted to charge nothing, and the shapes that
// genuinely cannot take it are asserted to charge once per call. A change that quietly stopped taking
// the fast path would make the first group fail, and one that took it where it must not would make
// the second.

// How many calls in that program copied their arguments into a buffer.
//
// **The program's own output is asserted rather than dropped**, which is what stops every test below
// passing on a program that never compiled: a count of nothing looks exactly like a count of zero.
private buffering(program: string, said: string) -> usize
    val before = calls_buffered()
    val printed = out(program)

    assert_eq(printed, said)
    calls_buffered() - before
end buffering

// How many calls each loop below makes. Large enough that the handful a program's own start-up makes
// is noise against it.
private const Calls: usize = 10000

// What each loop adds up to, which is what says the program ran rather than being refused.
private const Summed: string = "50005000"

// The program's own start-up and its `print` are calls too, so "nothing" is a small constant rather
// than a zero.
private const Incidental: usize = 200

// The tail every loop below shares: add to the running total, step, and say what it came to.
private counted(step: string) -> string =
    s"var total = 0\nvar i = 0\nwhile i < ${Calls}\n    total = total + ${step}\n    i = i + 1\nprint(total)"

@test
A_POSITIONAL_CALL_TO_A_SLOTTED_FUNCTION_COPIES_NO_ARGUMENTS()
    val cost = buffering("add(a, b) = a + b\n" + counted("add(i, 1)"), Summed)

    assert(cost < Incidental, s"${Calls} positional calls copied ${cost} argument lists")

@test
A_POSITIONAL_METHOD_CALL_COPIES_NO_ARGUMENTS_EITHER()
    // The receiver is parameter zero of a method reached through its class, and it is already
    // standing directly under the written arguments -- so this path moves nothing at all.
    val cost = buffering("class Tally\n    var n = 0\n\n    add(self, by) = self.n + by\nval t = Tally.new(1)\n" + counted("t.add(i)"), Summed)

    assert(cost < Incidental, s"${Calls} method calls copied ${cost} argument lists")

@test
A_NAMED_ARGUMENT_CALL_STILL_COPIES_ITS_ARGUMENTS()
    // Which parameter a name fills is a question about the callee, so the arguments have to be
    // arranged against its parameter list before there is a frame to put them in.
    val cost = buffering("add(a, b = 1) = a + b\n" + counted("add(i, b = 1)"), Summed)

    assert(cost >= Calls, s"${Calls} named calls copied only ${cost} argument lists")

@test
A_SPREAD_CALL_AND_A_VARIADIC_CALLEE_BOTH_STILL_COPY()
    // A spread's arguments arrive in an array rather than on the stack, and a variadic callee's
    // surplus is gathered into a fresh one -- two more things that have to be done to the arguments
    // before the frame exists.
    val spread = buffering("add(a, b) = a + b\n" + counted("add(...[i, 1])"), Summed)
    val gathering = buffering("add(a, ...rest) = a + rest.length\n" + counted("add(i, 1)"), Summed)

    assert(gathering >= Calls, s"${Calls} variadic calls copied only ${gathering} argument lists")
    assert(spread >= Calls, s"${Calls} spread calls copied only ${spread} argument lists")

@test
A_POSITIONAL_CONSTRUCTION_COPIES_NO_ARGUMENTS_EITHER()
    // **A constructor call is an ordinary call with the callee looked up first.** `Counter(3)` is an
    // object carrying a `new`, and that hook takes the arguments exactly as they were written -- it is
    // handed no receiver, the object it is about to make not existing yet -- so they are already
    // standing where its slots want them.
    val cost = buffering("class Counter\n    var n\n" + counted("Counter(i + 1).n"), Summed)

    assert(cost < Incidental, s"${Calls} constructions copied ${cost} argument lists")

@test
A_CONSTRUCTION_WHOSE_new_CANNOT_TAKE_THE_FAST_PATH_STILL_COPIES()
    // The three controls the plain call has, asked of a construction: a name has to be arranged
    // against the maker's parameter list, a spread arrives in an array, and a variadic `new` gathers
    // its surplus into a fresh one. Each is a thing done to the arguments before there is a frame.
    val named = buffering("class Counter\n    var n\n" + counted("Counter(n = i + 1).n"), Summed)
    val spread = buffering("class Counter\n    var n\n" + counted("Counter(...[i + 1]).n"), Summed)
    val gathering = buffering("class Bag\n    new(...xs) = { v: xs[0] }\n" + counted("Bag(i + 1).v"), Summed)

    assert(named >= Calls, s"${Calls} named constructions copied only ${named} argument lists")
    assert(spread >= Calls, s"${Calls} spread constructions copied only ${spread} argument lists")
    assert(gathering >= Calls, s"${Calls} variadic constructions copied only ${gathering} argument lists")

@test
A_CONSTRUCTION_AT_THE_DEPTH_LIMIT_IS_REFUSED_WITH_THE_ORDINARY_SENTENCE()
    // How deep a call has got is the last of the fast path's conditions, so a construction that has
    // run out of room goes back to the buffered path -- and is refused there in the sentence every
    // other call is refused with.
    val prog = "class Boxed\n    var w\ndeep(n) = if n == 0 then Boxed(1).w else deep(n - 1)\nprint((deep(20000)) catch e -> e.message)"

    assert_eq(out(prog), s"this call is ${MaxCallDepth} deep, which is farther than slate will go -- a recursion this deep is usually one that never ends")

@test
A_BUILTIN_CALL_COPIES_NO_ARGUMENTS_EITHER()
    // **A BUILTIN NEVER HAD A FRAME TO LAY, SO THE BUFFER BOUGHT IT NOTHING AT ALL.** It reads its
    // arguments through a window onto the stack they are standing on, and they come off with the
    // callee once it has answered -- one `malloc`, one free, a copy of every argument and a
    // shadow-stack hold each, gone from the call slate programs make most of.
    val plain = buffering(counted("abs(0 - i)"), "49995000")

    assert(plain < Incidental, s"${Calls} builtin calls copied ${plain} argument lists")

@test
A_BUILTIN_REACHED_AS_A_METHOD_COPIES_NOTHING_EITHER()
    // **The receiver is parameter zero of a delegated method and is already standing under the
    // written arguments**, which is the same arrangement an ordinary method call is in -- so the
    // window is one cell wider and nothing moves at all.
    val prog = "val xs = [0, 1, 2]\nvar total = 0\nvar i = 0\nwhile i < " + s"${Calls}" + "\n    total = total + xs.indexOf(i % 3)\n    i = i + 1\nprint(total)"
    val reached = buffering(prog, "9999")

    assert(reached < Incidental, s"${Calls} builtin method calls copied ${reached} argument lists")

@test
A_BUILTIN_THAT_CHANGES_ITS_RECEIVER_COPIES_NOTHING_EITHER()
    // `push` and `Map.set` are the two shapes a program spends its time in: the arguments stand, the
    // builtin writes through them, and the answer goes where the callee was.
    val filling = buffering("var xs = []\nvar i = 0\nwhile i < " + s"${Calls}" + "\n    push(xs, i)\n    i = i + 1\nprint(xs.length)", s"${Calls}")
    val keyed = buffering("var m = Map()\nvar i = 0\nwhile i < " + s"${Calls}" + "\n    m.set(i, i)\n    i = i + 1\nprint(m.get(" + s"${Calls - 1}" + "))", s"${Calls - 1}")

    assert(filling < Incidental, s"${Calls} pushes copied ${filling} argument lists")
    assert(keyed < Incidental, s"${Calls} map writes copied ${keyed} argument lists")

@test
A_BUILTIN_THAT_RUNS_A_CALLBACK_COPIES_NOTHING_EITHER()
    // **THE ONE WHOSE ARGUMENTS HAVE TO SURVIVE A COLLECTION**, which is what makes leaving them on
    // the stack safe rather than merely cheap: `map` runs slate code that pushes above them, and the
    // stack is a root the tracer already walks.
    val walking = buffering(counted("map([i], x -> x + 1)[0]"), Summed)

    assert(walking < Incidental, s"${Calls} callback builtin calls copied ${walking} argument lists")

@test
A_SPREAD_CALL_OF_A_BUILTIN_STILL_COPIES()
    // **The control that could disagree, and the one shape of builtin call that genuinely cannot take
    // the window**: a spread's arguments arrive in an array rather than on the stack, so they have to
    // be put there before a window can point at them.
    val spread = buffering(counted("abs(...[0 - i])"), "49995000")

    assert(spread >= Calls, s"${Calls} spread builtin calls copied only ${spread} argument lists")

@test
A_NAMED_ARGUMENT_TO_A_BUILTIN_IS_STILL_REFUSED_IN_ITS_OWN_SENTENCE()
    // A name is matched against a parameter list, and a builtin's parameters are sysl's -- so the
    // window is not offered here at all and the refusal is the one it has always been.
    val prog = "anything(v) = v\nprint((anything(abs)(x = 1)) catch e -> e.message)"

    assert_eq(out(prog), "this is a builtin, and a builtin's parameters have no names an argument can pick out")

@test
A_MODULE_LEVEL_LOOP_WHOSE_BODY_DECLARES_NOTHING_OPENS_NO_SCOPE()
    // **THE SAME RULE ASKED OF A MODULE, WHICH IS WHERE IT WAS NEVER ASKED AT ALL.** A module keeps
    // every name in its scope -- an import reads them by name -- so it has no cells, and the
    // question each `scoped_*` used to open with read that as "do not ask" rather than as "this
    // chunk binds by name". A loop body that declares nothing therefore built an `EnvObj`, wrote
    // nothing into it and threw it away, once a turn, in every file's top level.
    val prog = "var total = 0\nvar i = 0\n\nwhile i < 3\n    total = total + i\n    i = i + 1\n\nprint(total)"

    assert_eq(scope_pushes(prog, "t"), 0)
    assert_eq(out(prog), "3")
end A_MODULE_LEVEL_LOOP_WHOSE_BODY_DECLARES_NOTHING_OPENS_NO_SCOPE

@test
A_MODULE_LEVEL_LOOP_THAT_BINDS_A_NAME_STILL_OPENS_ONE_PER_TURN()
    // **The other side of it, and the one a program can SEE.** A closure made in a loop captures the
    // scope the turn is standing in, so a name bound per turn has to have a scope of its own per
    // turn -- which is JavaScript's `let` and is what these six answers are. A body that declares,
    // and a head that binds, each open one.
    val prog = "var fs = []\nvar i = 0\n\nwhile i < 3\n    val n = i\n    push(fs, () -> n)\n    i = i + 1\n\nvar gs = []\n\nfor k in 0..<3\n    push(gs, () -> k)\n\nprint([fs[0](), fs[1](), fs[2](), gs[0](), gs[1](), gs[2]()])"

    assert_eq(scope_pushes(prog, "t"), 2)
    assert_eq(out(prog), "[0, 1, 2, 0, 1, 2]")
end A_MODULE_LEVEL_LOOP_THAT_BINDS_A_NAME_STILL_OPENS_ONE_PER_TURN

@test
AN_is_WHOSE_PATTERN_BINDS_KEEPS_EVERY_SCOPE_IN_THE_CHUNK_IT_IS_WRITTEN_IN()
    // **`v is n` BINDS INTO THE SCOPE THE MATCH IS RUNNING IN, AND IT IS AN EXPRESSION** -- so
    // reading a block's STATEMENTS says nothing about it, and a block that stopped pushing would
    // land that binding one level out, over an outer name of the same spelling. `Emit.tests_bind` is
    // the chunk-wide answer, and a chunk holding one keeps the scopes it always kept.
    //
    // **The failure is silent and is the printed `99`**: without the guard the loop body opens
    // nothing, `n` is rebound at module level twice, and the last line says `1`.
    val binds = "val n = 99\nvar i = 0\n\nwhile i < 2\n    i is n\n    i = i + 1\n\nprint(n)"

    assert_eq(scope_pushes(binds, "t"), 1)
    assert_eq(out(binds), "99")

    // **And a bare name is a binding only where nothing declares a type of that name**, so the
    // control is the same loop testing against something that is LOOKED UP. Nothing binds, nothing
    // is kept, and the body opens no scope at all.
    val looks_up = "val n = 99\nvar i = 0\n\nwhile i < 2\n    i is integer\n    i = i + 1\n\nprint(n)"

    assert_eq(scope_pushes(looks_up, "t"), 0)
    assert_eq(out(looks_up), "99")
end AN_is_WHOSE_PATTERN_BINDS_KEEPS_EVERY_SCOPE_IN_THE_CHUNK_IT_IS_WRITTEN_IN

// -- the head of a chunk, and the reads a file's own definitions become ------------------------------

// **Two more decisions no answer can see**, which is this file's whole subject once more. A guard the
// head no longer needs and a read resolved while compiling both leave a program answering exactly
// what it answered, so the only way to ask whether either happened is to compile and read the code.

// The code of the chunk of that name, the longest where a name has more than one.
//
// **A DEFINITION BELONGS TO TWO CHUNKS**, `compile_module` compiling a file's declarations a second
// time on their own, and a module's own chunk is the longer of its two. Taking the longest answers
// about the whole file either way, which is `scope_pushes`' reason for the same choice.
private chunk_code(program: string, name: string) -> Buf[Ins]
    out(program)

    var found: Buf[Ins] = buf()
    var any = false

    for i in 0..<running_unit().chunks.len()
        if running_unit().chunks.at(i).name != name then continue

        any = true

        val code = running_unit().chunks.at(i).code

        if code.len() >= found.len() then found = code

    assert(any, s"no chunk is called `${name}`")
    found
end chunk_code

// How many parameters of that chunk are guarded, which is how many have something to bind where the
// call left them out.
private given_guards(program: string, name: string) -> usize
    val code = chunk_code(program, name)
    var n: usize = 0

    for k in 0..<code.len()
        code.at(k).op match
            JumpIfGiven(_, _) -> n += 1
            _ -> ()

    n
end given_guards

// How many reads in that chunk were resolved to one of the file's own definitions.
private resolved_reads(program: string, name: string) -> usize
    val code = chunk_code(program, name)
    var n: usize = 0

    for k in 0..<code.len()
        code.at(k).op match
            LoadDef(_) -> n += 1
            _ -> ()

    n
end resolved_reads

// The same question asked of a chunk whose parameters live in the scope chain.
private bound_guards(program: string, name: string) -> usize
    val code = chunk_code(program, name)
    var n: usize = 0

    for k in 0..<code.len()
        code.at(k).op match
            JumpIfBound(_, _) -> n += 1
            _ -> ()

    n
end bound_guards

// How many are still a lookup by name.
private name_reads(program: string, name: string) -> usize
    val code = chunk_code(program, name)
    var n: usize = 0

    for k in 0..<code.len()
        code.at(k).op match
            LoadName(_) -> n += 1
            _ -> ()

    n
end name_reads

@test
A_PARAMETER_THAT_CANNOT_BE_ABSENT_IS_NOT_GUARDED()
    // **The head of an ordinary function is empty now.** It used to open with one branch per
    // parameter whose only work, for a call that gave everything, was to jump over the binding of an
    // absence -- three instructions on every call of a function of three, with no default in it.
    val plain = "add3(a, b, c) = a + b + c\nprint(add3(1, 2, 3))"

    assert_eq(given_guards(plain, "add3"), 0)
    assert_eq(out(plain), "6")

    // **A `b?` binds what the frame already holds**, so it is not guarded either: the whole of what
    // it says is that a call may leave it out, which the frame answers by itself.
    val optional = "f(a, b?) = b ?? a\nprint(f(1))"

    assert_eq(given_guards(optional, "f"), 0)
    assert_eq(out(optional), "1")

    // **An EVALUATED default is still guarded, and that is the half that has to stay.** Its
    // expression may not run where the argument arrived, and `f(a, b = a + 1)` reads a parameter to
    // its left, so there is nothing to work out in advance either.
    val one = "f(a, b = a + 1) = a + b\nprint(f(1))"

    assert_eq(given_guards(one, "f"), 1)
    assert_eq(out(one), "3")

    val both = "f(a = 1, b = 2) = a + b\nprint(f())"

    assert_eq(given_guards(both, "f"), 2)
    assert_eq(out(both), "3")
end A_PARAMETER_THAT_CANNOT_BE_ABSENT_IS_NOT_GUARDED

@test
A_CHUNK_THAT_KEEPS_ITS_SCOPE_STILL_GUARDS_EVERY_PARAMETER()
    // **The control, and it is not a detail**: a parameter that lives in the scope chain rather than
    // in a cell is simply NOT BOUND where a call left it out, so a lookup would walk past it to a
    // global of the same spelling. That chunk's head is what it always was, asked of the scope.
    val kept = "f(a, b?)\n    val g = () -> a\n    g() + (b ?? 0)\nprint(f(1))"

    assert(!slotting(kept, "f"))
    assert_eq(given_guards(kept, "f"), 0)
    assert_eq(bound_guards(kept, "f"), 2)
    assert_eq(out(kept), "1")
end A_CHUNK_THAT_KEEPS_ITS_SCOPE_STILL_GUARDS_EVERY_PARAMETER

@test
A_CALL_OF_THE_FILES_OWN_DEFINITION_IS_RESOLVED_WHILE_COMPILING()
    // **`add3` cannot be anything else in this file**, so the call carries the number of the cell the
    // hoisted definition wrote itself into rather than the spelling to hash and walk for.
    val prog = "add3(a, b, c) = a + b + c\nrun() = add3(1, 2, 3)\nprint(run())"

    assert_eq(resolved_reads(prog, "run"), 1)
    assert_eq(name_reads(prog, "run"), 0)
    assert_eq(out(prog), "6")
end A_CALL_OF_THE_FILES_OWN_DEFINITION_IS_RESOLVED_WHILE_COMPILING

@test
A_SPELLING_SOMETHING_ELSE_BINDS_KEEPS_THE_LOOKUP_IT_HAD()
    // **THE BINDING IS WRITTEN BELOW THE READ, WHICH IS THE CASE THE FIXUP EXISTS FOR.** Definitions
    // are hoisted, so `run` is compiled before the compiler has met the local three lines down --
    // and a read emitted resolved has to be put back before the file is finished. Without that this
    // program answers `6` from a table cell while `other` means something else by the spelling.
    val prog = "add3(a, b, c) = a + b + c\nrun() = add3(1, 2, 3)\nother()\n    val add3 = 9\n    add3\nprint(run() + other())"

    assert_eq(resolved_reads(prog, "run"), 0)
    assert_eq(name_reads(prog, "run"), 1)
    assert_eq(out(prog), "15")
end A_SPELLING_SOMETHING_ELSE_BINDS_KEEPS_THE_LOOKUP_IT_HAD

// -- a file's own top-level `val` and `var` ---------------------------------------------------------

// How many reads in that chunk index a `val` or a `var` the file wrote at its own top level.
private cell_reads(program: string, name: string) -> usize
    val code = chunk_code(program, name)
    var n: usize = 0

    for k in 0..<code.len()
        code.at(k).op match
            LoadCell(_, _) -> n += 1
            _ -> ()

    n
end cell_reads

// And how many writes do.
private cell_writes(program: string, name: string) -> usize
    val code = chunk_code(program, name)
    var n: usize = 0

    for k in 0..<code.len()
        code.at(k).op match
            StoreCell(_, _) -> n += 1
            _ -> ()

    n
end cell_writes

// How many are still a write by name.
private name_writes(program: string, name: string) -> usize
    val code = chunk_code(program, name)
    var n: usize = 0

    for k in 0..<code.len()
        code.at(k).op match
            StoreName(_) -> n += 1
            _ -> ()

    n
end name_writes

@test
A_READ_AND_A_WRITE_OF_THE_FILES_OWN_VARIABLE_ARE_RESOLVED_WHILE_COMPILING()
    // **`total` cannot be anything else in this file**, so neither the read nor the write hashes the
    // spelling: each carries the number of the cell the declaration filled.
    val prog = "var total = 0\nrun()\n    total = total + 1\n    total\nprint(run())"

    assert_eq(cell_reads(prog, "run"), 2)
    assert_eq(cell_writes(prog, "run"), 1)
    assert_eq(name_reads(prog, "run"), 0)
    assert_eq(name_writes(prog, "run"), 0)
    assert_eq(out(prog), "1")
end A_READ_AND_A_WRITE_OF_THE_FILES_OWN_VARIABLE_ARE_RESOLVED_WHILE_COMPILING

@test
A_VARIABLES_SPELLING_SOMETHING_ELSE_BINDS_KEEPS_THE_LOOKUP_IT_HAD()
    // **THE LOCAL IS WRITTEN BELOW THE FUNCTION THAT READS THE VARIABLE**, so the read and the write
    // are both emitted resolved and both have to be put back before the file is finished -- which is
    // the half of the fixup a write is new to.
    val prog = "var total = 0\nrun()\n    total = total + 1\n    total\nother()\n    var total = 9\n    total\nprint(run() + other())"

    assert_eq(cell_reads(prog, "run"), 0)
    assert_eq(cell_writes(prog, "run"), 0)
    assert_eq(name_reads(prog, "run"), 2)
    assert_eq(name_writes(prog, "run"), 1)
    assert_eq(out(prog), "10")
end A_VARIABLES_SPELLING_SOMETHING_ELSE_BINDS_KEEPS_THE_LOOKUP_IT_HAD

@test
A_TOP_LEVEL_VALUE_IS_READ_THROUGH_A_CELL_AND_STILL_WRITTEN_ONCE()
    // A `val` is read through the table like a `var`, and a write to one is refused exactly where it
    // always was -- so the cell buys the read and changes nothing about the rule.
    val prog = "val k = 4\nrun() = k + 1\nprint(run())"

    assert_eq(cell_reads(prog, "run"), 1)
    assert_eq(out(prog), "5")
    assert(fails("val k = 4\nrun()\n    k = 5\n    k\nprint(run())").contains("`k` is a `val`"))
end A_TOP_LEVEL_VALUE_IS_READ_THROUGH_A_CELL_AND_STILL_WRITTEN_ONCE

@test
A_CELL_IS_EMPTY_UNTIL_THE_STATEMENT_THAT_BINDS_IT_IS_REACHED()
    // **A definition is hoisted and a variable is not**, so a function called above the `var` reads a
    // cell nothing has been put in -- and says the sentence it always said rather than answering with
    // whatever the empty cell holds.
    assert(fails("early() = later\nprint(early())\nvar later = 1").contains("`later` is not defined"))
    assert(fails("early()\n    later = 1\nearly()\nvar later = 0").contains("`later` is not defined"))
end A_CELL_IS_EMPTY_UNTIL_THE_STATEMENT_THAT_BINDS_IT_IS_REACHED

@test
ONE_SPELLING_DECLARED_TWICE_AT_A_FILES_TOP_LEVEL_GOES_BACK_TO_THE_LOOKUP()
    // **A file may write the same spelling twice and the second declaration is a second binding**, so
    // two cells under one name would make which one a read meant depend on where the read stood. The
    // second claim shuts the entry instead, and the file reads and writes that spelling by name
    // exactly as it did before there were cells at all.
    val prog = "var total = 1\nbump()\n    total = total + 1\n    total\nvar total = 5\nprint(bump())"

    assert_eq(cell_reads(prog, "bump"), 0)
    assert_eq(cell_writes(prog, "bump"), 0)
    assert_eq(name_reads(prog, "bump"), 2)
    assert_eq(name_writes(prog, "bump"), 1)
    assert_eq(out(prog), "6")
end ONE_SPELLING_DECLARED_TWICE_AT_A_FILES_TOP_LEVEL_GOES_BACK_TO_THE_LOOKUP

@test
A_SLOTTED_ANNOTATION_AND_A_SLOTTED_UNPACK_READ_THEIR_WIDE_OPERANDS()
    // **`CheckSlot` and `UnpackSlots` carry more operands than an instruction's payload holds**, so
    // each keeps what it needs first -- the slot, the mask -- and reads the rest out of `Unit.wide`:
    // the name and the type for one, the pattern and the first slot for the other. A wrong index
    // into that table is not a crash, it is a check against somebody else's pattern, so these ask
    // for the ANSWER a hundred thousand times over and then for the sentence the failure writes.
    assert_eq(out("f(x) =\n    val n: integer = x\n    n + 1\n\nvar t = 0\nfor i in 0..<100000\n    t = t + f(i)\n\nprint(t)"), "5000050000")
    assert_eq(out("f(p) =\n    val { a, b } = p\n    a * b\n\nvar t = 0\nfor i in 0..<100000\n    t = t + f({ a: 2, b: 3 })\n\nprint(t)"), "600000")

    // The two operands a passing check never looks at are the two the sentence is made of.
    val said = fails("f(x) =\n    val n: integer = x\n    n\n\nprint(f([1]))")

    assert(said.contains("`n` was declared integer"), said)
end A_SLOTTED_ANNOTATION_AND_A_SLOTTED_UNPACK_READ_THEIR_WIDE_OPERANDS

// -- which unpacking instruction a binding site gets ------------------------------------------------

// The instruction names of the chunk of that name, longest first.
//
// **The largest match is the real one**: `compile_module` compiles a file twice, so a top-level
// definition has two chunks of one name and the declarations-only copy holds a subset. This is
// `tests_fused.sysl`'s helper under another name -- `private` in sysl is per file, so a second copy
// is cheaper than making a test helper part of the module's surface, and the NAME still has to
// differ, `tests_operators.sysl` having its own. `holds` is `js_stmt.sysl`'s and is reached as it is.
private chunk_ops(program: string, name: string) -> Buf[string]
    out(program)

    var best: Buf[string] = buf()
    var found = false

    for i in 0..<running_unit().chunks.len()
        if running_unit().chunks.at(i).name != name then continue

        found = true

        val code = running_unit().chunks.at(i).code
        var names: Buf[string] = buf()

        for k in 0..<code.len()
            names.push(op_label(code.at(k).op))

        if names.len() > best.len() then best = names

    assert(found, s"no chunk is called `${name}`")
    best
end chunk_ops

@test
A_HEAD_OF_BARE_NAMES_IS_TAKEN_APART_BY_THE_INSTRUCTION_AND_NOT_BY_THE_MATCHER()
    // **THIS IS THE TEST THAT WOULD OTHERWISE PASS VACUOUSLY**, which is this file's whole reason:
    // both instructions answer the same thing, so an emitter that quietly stopped choosing the
    // shorter one would print exactly the right number for ever. The answers are asserted beside
    // each shape so a wrong one cannot hide behind a right instruction either.
    val pairs = chunk_ops("f(rows) =\n    var t = 0\n\n    for [a, b] in rows\n        t = t + a * b\n\n    t\n\nprint(f([[1, 2], [3, 4]]))", "f")

    assert(holds(pairs, "UnpackFixed"), "a `for [a, b]` head did not take the instruction")
    assert(!holds(pairs, "UnpackSlots"), "a `for [a, b]` head still entered the matcher")

    val threes = chunk_ops("f(rows) =\n    var t = 0\n\n    for [a, b, c] in rows\n        t = t + a + b + c\n\n    t\n\nprint(f([[1, 2, 3]]))", "f")

    assert(holds(threes, "UnpackFixed"), "a three-name head did not take the instruction")

    val fields = chunk_ops("f(rows) =\n    var t = \"\"\n\n    for { k, v } in rows\n        t = t + k + string(v)\n\n    t\n\nprint(f([{ k: \"a\", v: 1 }]))", "f")

    assert(holds(fields, "UnpackFixed"), "a `for { k, v }` head did not take the instruction")
    assert(!holds(fields, "UnpackSlots"), "a `for { k, v }` head still entered the matcher")

    // A destructuring `val` is the same binding site and gets the same instruction.
    val bound = chunk_ops("f(p) =\n    val { a, b } = p\n\n    a * b\n\nprint(f({ a: 2, b: 3 }))", "f")

    assert(holds(bound, "UnpackFixed"), "a destructuring `val` of bare names did not take it")
end A_HEAD_OF_BARE_NAMES_IS_TAKEN_APART_BY_THE_INSTRUCTION_AND_NOT_BY_THE_MATCHER

@test
EVERY_OTHER_SHAPE_STILL_WALKS_THE_MATCHER()
    // **The instruction can only take a pattern that cannot half-match**, so each of these keeps
    // `UnpackSlots`: a default leaves a name unbound and still matches, a rest gathers an array the
    // instruction never builds, and a nested pattern has a question inside it to ask.
    val defaulted = chunk_ops("f(rows) =\n    var t = 0\n\n    for [a, b = 7] in rows\n        t = t + a + b\n\n    t\n\nprint(f([[1], [2, 3]]))", "f")

    assert(holds(defaulted, "UnpackSlots"), "a head with a default left the matcher")
    assert(!holds(defaulted, "UnpackFixed"), "a head with a default took the fixed instruction")

    val rested = chunk_ops("f(rows) =\n    var t = 0\n\n    for [a, ...more] in rows\n        t = t + a + more.length\n\n    t\n\nprint(f([[1, 2, 3]]))", "f")

    assert(holds(rested, "UnpackSlots"), "a head with a rest left the matcher")
    assert(!holds(rested, "UnpackFixed"), "a head with a rest took the fixed instruction")

    val nested = chunk_ops("f(rows) =\n    var t = 0\n\n    for [[a, b], c] in rows\n        t = t + a + b + c\n\n    t\n\nprint(f([[[1, 2], 3]]))", "f")

    assert(holds(nested, "UnpackSlots"), "a nested head left the matcher")
    assert(!holds(nested, "UnpackFixed"), "a nested head took the fixed instruction")

    // An open head is not a fixed one either: its floor is not its length.
    val open = chunk_ops("f(rows) =\n    var t = 0\n\n    for [a, ...] in rows\n        t = t + a\n\n    t\n\nprint(f([[1, 2, 3]]))", "f")

    assert(!holds(open, "UnpackFixed"), "an open head took the fixed instruction")

    // A literal in the head is a test rather than a binding, so it walks.
    val literal = chunk_ops("f(rows) =\n    var t = 0\n\n    for [1, b] in rows\n        t = t + b\n\n    t\n\nprint(f([[1, 2]]))", "f")

    assert(!holds(literal, "UnpackFixed"), "a head holding a literal took the fixed instruction")
end EVERY_OTHER_SHAPE_STILL_WALKS_THE_MATCHER

@test
A_HEAD_IN_A_CHUNK_THAT_KEEPS_ITS_SCOPE_TAKES_NEITHER()
    // **A binding site is all or nothing**, so a pattern one of whose names a closure can reach has
    // no run of cells to fill and takes the scope path whole -- which is `Unpack` and neither of the
    // two above.
    val prog = "f(rows) =\n    var t = 0\n\n    for [a, b] in rows\n        val note = () -> b\n\n        t = t + a + note()\n\n    t\n\nprint(f([[1, 2], [3, 4]]))"
    val names = chunk_ops(prog, "f")

    assert(!holds(names, "UnpackFixed"), "a kept binding took the fixed instruction")
    assert(!holds(names, "UnpackSlots"), "a kept binding took the slotted instruction")
    assert(holds(names, "Unpack"), "a kept binding did not take the scope path")
    assert_eq(out(prog), "10")
end A_HEAD_IN_A_CHUNK_THAT_KEEPS_ITS_SCOPE_TAKES_NEITHER
