module dev.slatelang.slate

import sysl.buf.{Buf, buf}
import sysl.crypto.new_sha256
import sysl.encoding.hex_string
import sysl.text.{Search, from_utf8_unchecked, str_builder}

// `slate brew` -- a program's bundle, and the Homebrew formula that installs it.
//
// **The formula is written at the moment the bundle is, because that is the one moment the hash
// is free.** A formula names the bytes it installs by their SHA-256, and every other way of making
// one -- `brew create` against a URL that has to exist first, `shasum` over a file and a paste into
// a template -- is a step that can be skipped or done against the wrong file. Here the bytes are in
// hand, so the hash and the formula fall out of the same call that writes the bundle, and the formula
// cannot lag the file it names.
//
// **What a formula for a bundle needs from the machine is `slate` and nothing else**, which is why
// it is so much shorter than slate's own: no per-platform tarball, no `on_macos`, no library census.
// The bundle is text that opens with `#!/usr/bin/env slate`, so `bin.install` is the whole install,
// and `depends_on` the tap's `slate` is what puts the interpreter beside it.
//
// The download URL is the GitHub release's, at `<homepage>/releases/download/v<version>/<name>`,
// which is what makes `homepage` the one manifest key this command insists on: it is where the
// releases are as well as what the formula says.

// Where the release assets of a GitHub repository are.
val GitHubPrefix: string = "https://github.com/"

// The formula a tap installs `slate` itself from, which every bundle's formula depends on.
val SlateFormula: string = "slate-language/tap/slate"

// The SHA-256 of a text, as the sixty-four hex digits a formula writes.
sha256_hex(text: string) -> string
    var h = new_sha256()

    h.update(text.bytes)

    var out: [32]u8

    // A digest over bytes already in memory cannot fail; the `Result` is the library's shape.
    h.finish(out[0..<32]).unwrap()
    hex_string(out[0..<32])
end sha256_hex

// The Ruby class a formula for `name` declares: `my-tool` is `MyTool`, as brew itself derives it.
//
// **A word starts after `-`, `_` or `.`, and the separator is dropped**, which is Homebrew's own
// rule (`Formulary.class_s`); `@` is not handled, since a versioned formula is not something a
// bundle has a reason to be.
formula_class(name: string) -> string
    var out: Buf[u8] = buf()
    var start = true

    for i in 0..<name.bytes.len
        val c = name.bytes[i]

        if c == u8('-') || c == u8('_') || c == u8('.')
            start = true
        else
            out.push(if start && c >= u8('a') && c <= u8('z') then c - 32 else c)
            start = false

    from_utf8_unchecked(out.view())
end formula_class

// The release URL a formula for `p` fetches. `""` where the homepage is not a GitHub repository,
// which is the caller's refusal to make.
release_url(homepage: string, name: string, version: string) -> string
    if !homepage.starts_with(GitHubPrefix) then return ""

    // A homepage written with a trailing slash is the same repository.
    val repo = if homepage.ends_with("/") then from_utf8_unchecked(homepage.bytes[0..<homepage.bytes.len - 1]) else homepage

    s"${repo}/releases/download/v${version}/${name}"
end release_url

// The formula, given the project, the URL its bundle will be fetched from, and the bundle's hash.
//
// **The `test do` asks the one question a formula can answer** -- is the file installed where
// brew links from, and is it a command -- and nothing about the program, which the program's
// own suite already holds. A `--version` or `--help` would be a guess about what the program
// takes, and a bundle is handed every argument after its name.
formula(name: string, version: string, description: string, license: string, homepage: string, url: string, sha: string, slate_version: string) -> string
    var out = str_builder()

    out.push(s"class ${formula_class(name)} < Formula\n")
    if description != "" then out.push(s"  desc \"${ruby_quoted(description)}\"\n")
    out.push(s"  homepage \"${ruby_quoted(homepage)}\"\n")
    out.push(s"  url \"${ruby_quoted(url)}\"\n")
    out.push(s"  sha256 \"${sha}\"\n")
    if license != "" then out.push(s"  license \"${ruby_quoted(license)}\"\n")
    out.push("\n")
    out.push(s"  # A slate bundle: one text file that runs as itself, made by `slate brew` with slate ${slate_version}.\n")
    out.push(s"  depends_on \"${SlateFormula}\"\n")
    out.push("\n")
    out.push("  def install\n")
    out.push(s"    bin.install \"${ruby_quoted(name)}\"\n")
    out.push("  end\n")
    out.push("\n")
    out.push("  test do\n")
    out.push(s"    assert_predicate bin/\"${ruby_quoted(name)}\", :executable?\n")
    out.push("  end\n")
    out.push("end\n")
    out.finish()
end formula

// A text inside a Ruby double-quoted string: `\` and `"` escaped, and `#` too, since `#{` would
// interpolate. Nothing else in a name, a URL or a one-line description needs it.
private ruby_quoted(text: string) -> string
    var out: Buf[u8] = buf()

    for i in 0..<text.bytes.len
        val c = text.bytes[i]

        if c == u8('\\') || c == u8('"') || c == u8('#') then out.push(u8('\\'))

        out.push(c)

    from_utf8_unchecked(out.view())
end ruby_quoted
