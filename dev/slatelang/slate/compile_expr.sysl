module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// An expression to instructions.
//
// **`compile.sysl` is the other half** -- the entry, the declared types, and which module a written
// path names -- with the statements in `compile_stmt.sysl` between them, and the three are one pass
// split at the seams a reader already reads them at. Everything shared is either `emit.sysl`'s or
// one of the names `compile.sysl` leaves public, each of which says so where it is declared.

// -- expressions ----------------------------------------------------------------------------------

compile_expr(u: *Unit, e: *Emit, x: Expr)
    val at = x.span

    // **Every expression is off the spine unless the link above it just said otherwise**, which is
    // what makes `in_spine` safe to read here and nowhere else: a key, an argument and a receiver in
    // brackets all arrive through this line with the flag already down.
    val spine = e.in_spine

    e.in_spine = false

    // The outermost link of a `?.` chain is where the chain is opened, and it is the only place
    // that can be: the guard has to know where the run of links ENDS to jump past it.
    if !spine && chain_guarded(x)
        compile_chain(u, e, x)
        return
    end if

    *x.kind match
        IntLit(v) -> push_n(e, PushInt(v), at, 0, 1)
        BigLit(digits) -> push_n(e, PushBig(intern_big(u, digits)), at, 0, 1)
        RealLit(v) -> push_n(e, PushReal(v), at, 0, 1)
        BoolLit(v) -> push_n(e, PushBool(v), at, 0, 1)
        StrLit(v) -> push_n(e, PushStr(intern_str(u, v)), at, 0, 1)
        NullLit -> push_n(e, PushNull, at, 0, 1)
        UndefinedLit -> push_n(e, PushUndefined, at, 0, 1)
        Name(n) -> load_name(u, e, n, at)

        // **Nothing reaches this arm today and it is not dead code.** The parser builds a `Spread`
        // in a call's argument list and in an array literal, and both of those are read by the arm
        // that owns them rather than by walking into one -- so `val a = ...xs` is refused by the
        // parser as an expression it cannot start. The arm is here because the match is exhaustive,
        // and it says the useful thing rather than `unreachable` in case a later grammar lets one
        // through.
        Spread(_) -> complain_here(at, "`...` spreads a list of values, and may only be written inside a call's brackets or an array literal")

        // Here for the reason the arm above is: the parser builds one of these only in an argument
        // list, and the arm that owns an argument list reads it rather than walking into it.
        Named(name, _) -> complain_here(at, s"`${name} =` names an argument, and may only be written inside a call's brackets")
        Unary(op, rhs) ->
            compile_expr(u, e, rhs)
            push_n(e, unary_instruction(op), at, 1, 1)
        Binary(op, lhs, rhs) -> compile_binary(u, e, op, lhs, rhs, at)
        Compare(operands, ops) -> compile_compare(u, e, operands, ops, at)
        Range(lo, hi, inclusive, step) ->
            // **A ZERO STEP IS REFUSED WHERE IT IS WRITTEN.** `0..<10 by 0` names no numbers and
            // stands still for ever, so a reader who wrote it made a mistake rather than a choice --
            // and a literal zero is a mistake the compiler can see. One that is worked out is caught
            // by the machine, which says the same sentence with the value in it.
            step match
                Some(x) ->
                    *x.kind match
                        IntLit(v) ->
                            if v == 0
                                complain_here(x.span, "a range steps by 0, so it would never reach its end -- `by` takes a step that moves")
                        _ -> ()
                None -> ()

            lo match
                Some(x) -> compile_expr(u, e, x)
                None -> ()

            hi match
                Some(x) -> compile_expr(u, e, x)
                None -> ()

            step match
                Some(x) -> compile_expr(u, e, x)
                None -> ()

            val ends: usize = (if lo.is_some() then 1 else 0) + (if hi.is_some() then 1 else 0) +
                (if step.is_some() then 1 else 0)

            push_n(e, MakeRange(inclusive, lo.is_some(), hi.is_some(), step.is_some()), at, ends, 1)
        IsPattern(subject, pat, negated) ->
            refuse_defaults(pat, "`is`")

            // **A BINDING `is` BINDS ITS NAMES AT RUN TIME AND NO INSTRUCTION SAYS SO**, which is the
            // same hole `bind_pattern` covers for the forms that declare -- and the one form that had
            // it uncovered. A spelling bound here is a spelling a read of the file's own top level may
            // no longer be resolved to, wherever in the file the two stand.
            shadowed_pattern(u, pat)
            compile_expr(u, e, subject)
            push_n(e, IsPat(u32(intern_resolved(u, pat)), negated), at, 1, 1)
        IncDec(target, up, before) -> compile_inc_dec(u, e, target, up, before, at)
        Call(callee, args, guarded) ->
            // **`o.m(a)` is compiled as one thing, because that is the only form a receiver is
            // passed for.** Everything else -- a name, a call answering a function, an element of an
            // array -- is an ordinary call of whatever it evaluated to.
            //
            // **A `?.()` is read as a guard on the CALLEE, so the method fusion is given up for
            // it**: `o.m?.()` reads `o.m` as the value it is and calls that, which is what `o.m`
            // means anywhere else in the language.
            if guarded
                compile_guarded_call(u, e, callee, args, at)
                return
            end if

            *callee.kind match
                Field(target, name, optional) ->
                    e.in_spine = true

                    compile_expr(u, e, target)

                    // `o?.m(a)` does not evaluate its arguments where there is nothing to call the
                    // method on -- nor anything further along the chain, the guard's jump landing
                    // past the last link of it.
                    if optional then e.chain.push(push_n(e, JumpIfAbsentKeep(0), at, 0, 0))

                    if has_spread(args)
                        refuse_named_spread(args, at)
                        compile_spread_args(u, e, args, at)
                        push_n(e, CallMethodSpread(intern_str(u, name)), at, 2, 1)
                    else
                        val count = call_count(e, args)

                        for i in 0..<args.len()
                            compile_expr(u, e, arg_value(args.at(i)))

                        push_n(e, CallMethod(count, intern_wide(u, intern_str(u, name), arg_names_of(u, args, at), fresh_site(u))), at, args.len() + 1, 1)
                _ ->
                    e.in_spine = true

                    compile_expr(u, e, callee)

                    if has_spread(args)
                        refuse_named_spread(args, at)
                        compile_spread_args(u, e, args, at)
                        push_n(e, CallSpread, at, 2, 1)
                    else
                        val count = call_count(e, args)

                        for i in 0..<args.len()
                            compile_expr(u, e, arg_value(args.at(i)))

                        push_n(e, CallFn(count, u32(arg_names_of(u, args, at))), at, args.len() + 1, 1)
        Index(t, key, optional) ->
            e.in_spine = true

            compile_expr(u, e, t)

            // **The key is not worked out where there is nothing to read from**, which is the rule
            // `o?.m(a)` already has about its arguments: the guard jumps past the whole rest of the
            // chain, and the key is inside it.
            if optional then e.chain.push(push_n(e, JumpIfAbsentKeep(0), at, 0, 0))

            compile_expr(u, e, key)
            push_n(e, GetIndex, at, 2, 1)
        Field(t, name, optional) ->
            e.in_spine = true

            compile_expr(u, e, t)

            if optional then e.chain.push(push_n(e, JumpIfAbsentKeep(0), at, 0, 0))

            push_n(e, GetField(u32(intern_str(u, name)), u32(fresh_site(u))), at, 1, 1)

        // A chain the brackets around it ended. Everything after those brackets is a link on a
        // chain of its own, which is exactly what compiling this one here says.
        Chain(inner) -> compile_chain(u, e, inner)
        Interp(pieces) ->
            for i in 0..<pieces.len()
                compile_expr(u, e, pieces.at(i))

            push_n(e, Join(pieces.len()), at, pieces.len(), 1)
        ArrayRepeat(value, count) ->
            compile_expr(u, e, value)
            compile_expr(u, e, count)
            push_n(e, Repeat, at, 2, 1)
        WithFields(base, keys, values) ->
            compile_expr(u, e, base)

            for i in 0..<keys.len()
                push_n(e, PushStr(intern_str(u, keys.at(i))), at, 0, 1)
                compile_expr(u, e, values.at(i))

            push_n(e, WithObject(keys.len()), at, keys.len() * 2 + 1, 1)
        WithAll(base, other, spread) ->
            compile_expr(u, e, base)
            compile_expr(u, e, other)
            push_n(e, WithMerge(spread), at, 2, 1)
        ArrayLit(items) ->
            // **A spread makes the literal exactly the problem an argument list already was**, so
            // it is built by the same routine: runs of written elements become arrays and
            // `JoinArrays` makes one list of them. Without one the straight `MakeArray` is kept,
            // which is what nearly every literal in a program is.
            if has_spread(items)
                compile_spread_args(u, e, items, at)
            else
                for i in 0..<items.len()
                    compile_expr(u, e, items.at(i))

                push_n(e, MakeArray(items.len()), at, items.len(), 1)
        // The object is built and then closed, which is one instruction after the ones that would
        // have run anyway -- a data value costs nothing over the literal it is.
        DataLit(inner) ->
            compile_expr(u, e, inner)
            push_n(e, SealData, at, 1, 1)
        // **The same instruction a `type` declaration emits**, which is the point: a class's shape
        // and a type's are one thing made one way, resolved and interned here and holding the scope
        // it is evaluated in.
        ShapeLit(name, pat) -> push_n(e, PushShape(u32(intern_resolved(u, pat)), u32(intern_str(u, name))), at, 0, 1)
        ObjectLit(keys, _, values) ->
            for i in 0..<keys.len()
                push_n(e, PushStr(intern_str(u, keys.at(i))), at, 0, 1)
                compile_expr(u, e, values.at(i))

            push_n(e, MakeObject(keys.len()), at, keys.len() * 2, 1)
        Lambda(params, defaults, body, is_async) ->
            val c = compile_chunk(u, params, defaults, body_at(body), "a function", is_async, body_is_gen(body))

            push_n(e, MakeClosure(c), at, 0, 1)
        Yield(inner) ->
            compile_expr(u, e, inner)

            // Refused the way `await` outside an `async` function is, and for its reason: the tree is
            // compiled with no report to write into, so the refusal is an instruction that faults
            // where it stands. It is only reachable at the top level of a file -- a `yield` anywhere
            // inside a function has made that function a generator by being there.
            //
            // **`is_gen` IS ASKED AND `is_async` IS NOT, which is the whole of what an async
            // generator cost the compiler.** A body holding both is a generator whose steps answer
            // promises, and the instruction it yields with is the one it always was: what differs
            // is who is owed the value, which is a question the machine asks of the machine.
            if e.is_gen
                push_n(e, Op.Yield, at, 1, 1)
            else
                push_n(e, FailWith(intern_str(u, "`yield` belongs inside a function")), at, 1, 1)
        Await(inner) ->
            compile_expr(u, e, inner)

            // **Refused the way `break` outside a loop is**, with an instruction that faults where it
            // stands: the tree is compiled without a report to write into, and a fault carrying this
            // span points at the same character a parse error would have.
            if e.is_async
                push_n(e, Op.Await, at, 1, 1)
            else
                push_n(e, FailWith(intern_str(u, "`await` belongs in an `async` function")), at, 1, 1)
        Block(stmts) ->
            open_scope(e, at, scoped_block(e, stmts))
            compile_stmts(u, e, stmts, at, Kept)
            shut_scope(e, at)
        Ensures(value, declared, pat) ->
            // **Recorded before the body is compiled, so that every `return` in it is checked too.**
            // Saved and put back for the reason every other per-chunk record here is: a body reached
            // through this one -- a default parameter's, say -- is not this function's answer.
            val outer_declared = e.result_declared
            val outer_pat = e.result_pat

            e.result_declared = declared
            e.result_pat = Some(pat)

            compile_expr(u, e, value)

            e.result_declared = outer_declared
            e.result_pat = outer_pat

            val shape = resolve_pattern(pat, 0)

            // **Pointed at the ANNOTATION and not at the body.** `at` here is the wrapped
            // expression, which is the whole function; the pattern's own span is the `-> Nope` a
            // reader has to change.
            first_binding(shape) match
                Some(loose) -> complain_here(pat.span, s"`${loose}` is not a type, so `-> ${loose}` would check nothing${instead_of(loose)}")
                None -> ()

            push_n(e, CheckResult(u32(intern_str(u, declared)), u32(intern_pattern(u, shape))), fallout_span(value), 0, 0)
        TryCatch(body, name, handler) -> compile_try(u, e, body, name, handler, at)
        IfExpr(cond, then_branch, else_branch) -> compile_if(u, e, cond, then_branch, else_branch, at)
        MatchExpr(subject, arms) -> compile_match(u, e, subject, arms, at)
        While(label, cond, body, otherwise) -> compile_while(u, e, label, cond, body, otherwise, at)
        For(label, binding, iter, body, otherwise, waits) -> compile_for(u, e, label, binding, iter, body, otherwise, waits, at)
        Loop(label, body) -> compile_loop(u, e, label, body, at)
        DoWhile(label, body, cond, otherwise) -> compile_do_while(u, e, label, body, cond, otherwise, at)

        // A program with one of these in it is never run: `parse` reports first.
        Bad -> push_n(e, FailWith(intern_str(u, "this expression did not parse")), at, 0, 1)
end compile_expr

// Where a body's FALL-OUT value was actually written, for a result-type complaint to point at.
//
// **A `-> type` complaint about the body's own answer used to point at the whole body**, `value`
// carrying the span of everything the parser wrapped -- which starts at the body's first statement
// rather than at the one that produced the value in front of the reader. A run of statements leaves
// the LAST one's value (`compile_stmts`'s own rule), so that is the span to walk down to: through
// every wrapping `Block` -- `with_checks`' parameter checks, an `answering` clause block -- to the
// tail statement, and its own expression where it is a plain `Eval`.
private fallout_span(value: Expr) -> Span
    *value.kind match
        Block(stmts) ->
            if stmts.len() == 0
                value.span
            else
                val last = stmts.at(stmts.len() - 1)

                *last.kind match
                    Eval(x) -> fallout_span(x)
                    _ -> last.span
        _ -> value.span
end fallout_span

// A chain of comparisons, which is one comparison.
//
// **The middle operand is evaluated once and kept on the stack**, which is the whole difference from
// `a < b && b < c` written out: `a < f() < c` calls `f` a single time. Each step keeps a copy of the
// right operand to be the next step's left, and a step that answers false jumps to a common exit
// where whatever is still standing is dropped.
private compile_compare(u: *Unit, e: *Emit, operands: Buf[Expr], ops: Buf[Tok], at: Span)
    compile_expr(u, e, operands.at(0))

    var short: Buf[usize] = buf()
    val last = ops.len() - 1

    for i in 0..<ops.len()
        compile_expr(u, e, operands.at(i + 1))

        if i == last
            push_n(e, op_instruction(ops.at(i)), at, 2, 1)
        else
            // Keep the right operand: it is the next step's left.
            push_n(e, Dup, at, 0, 1)
            push_n(e, RotUp(2), at, 0, 0)
            push_n(e, op_instruction(ops.at(i)), at, 2, 1)
            short.push(push_n(e, JumpIfFalse(0), at, 1, 0))

    val done = put(e, Jump(0), at)

    // Reached with one value on the stack -- the operand the failing step had kept -- so the height
    // is the same on both paths and the counter needs no correction.
    val fail = here(e)

    for i in 0..<short.len()
        patch(e, short.at(i), fail)

    push_n(e, Pop, at, 1, 0)
    push_n(e, PushBool(false), at, 0, 1)
    patch(e, done, here(e))
end compile_compare

// `++x`, `x++`, and the two decrements.
//
// **Prefix and postfix differ only in WHICH value is kept**, so both are the same four moves: read
// the old value, put the one to keep out of the way underneath, copy it back to be written, write.
// A default is for BINDING and is refused where a pattern is a TEST.
//
// **A default makes the part of a pattern it is written on optional, so a test carrying one asks less
// than it appears to** -- `x match { a = 1 } -> ...` matches every object there is, including one
// with no `a`, and an arm that always matches is a trap rather than a shorthand. A binding has no
// next arm to fall through to, which is exactly why a default is useful there and nowhere else.
private refuse_defaults(pat: Pattern, where: string)
    if pattern_defaults(pat)
        complain_here(pat.span, s"a default belongs to a binding and not to ${where} -- it would make this pattern match a value that does not have the field, which is not a test")

// Whether any of these -- a call's arguments, or an array literal's elements -- was written `...xs`.
private has_spread(args: Buf[Expr]) -> bool
    for i in 0..<args.len()
        *args.at(i).kind match
            Spread(_) -> return true
            _ -> ()

    false

// The value an argument carries, which is the argument itself unless it was named.
//
// **A named argument is UNWRAPPED here and nowhere else.** Everything past this point -- the
// instructions, the stack, `invoke` -- sees the values in the order they were written, and the names
// travel beside them in the instruction rather than in the tree.
private arg_value(x: Expr) -> Expr = *x.kind match
    Named(_, value) -> value
    _ -> x

// The names one call site wrote, recorded on the unit, or zero where it named none.
//
// **A NAMED ARGUMENT COMES LAST, and the refusal is here rather than in the parser** because this is
// where the whole list is in hand. `f(a = 1, 2)` has no reading that is not a guess: the second
// argument would have to mean "the parameter `a` did not take", which is a rule about a parameter
// the reader cannot see from the call.
private arg_names_of(u: *Unit, args: Buf[Expr], at: Span) -> usize
    var any = false

    for i in 0..<args.len()
        *args.at(i).kind match
            Named(_, _) -> any = true
            _ ->
                if any
                    complain_here(args.at(i).span, "a named argument comes after every positional one, and this one follows a name")

                    return 0

    if !any then return 0

    var names: Buf[string] = buf()

    for i in 0..<args.len()
        names.push(*args.at(i).kind match
            Named(name, _) -> name
            _ -> "")

    intern_arg_names(u, names)
end arg_names_of

// **A spread and a name cannot be in one argument list.** How many arguments a spread stands for is
// not known until it runs, so which parameter a name would be filling is not either -- and the two
// answers a rule could give (the name wins, the spread wins) are both surprising.
private refuse_named_spread(args: Buf[Expr], at: Span)
    for i in 0..<args.len()
        *args.at(i).kind match
            Named(name, _) -> complain_here(args.at(i).span, s"`${name} =` names a parameter, and this call also spreads a list whose length is not known until it runs -- one or the other")
            _ -> ()
end refuse_named_spread

// `f?.(a, b)` -- the callee is worked out, and where it is nullish the whole call answers `null`
// with the arguments left unevaluated.
//
// **The guard is on the callee and nowhere else.** A callee that IS there and is not a function
// faults exactly as a plain call does, which is the line every guarded link in slate draws: `?.`
// answers for an absence and never for a wrong kind.
private compile_guarded_call(u: *Unit, e: *Emit, callee: Expr, args: Buf[Expr], at: Span)
    e.in_spine = true

    compile_expr(u, e, callee)
    e.chain.push(push_n(e, JumpIfAbsentKeep(0), at, 0, 0))

    if has_spread(args)
        refuse_named_spread(args, at)
        compile_spread_args(u, e, args, at)
        push_n(e, CallSpread, at, 2, 1)
    else
        val count = call_count(e, args)

        for i in 0..<args.len()
            compile_expr(u, e, arg_value(args.at(i)))

        push_n(e, CallFn(count, u32(arg_names_of(u, args, at))), at, args.len() + 1, 1)
end compile_guarded_call

// A whole `?.` chain: the run of links, and the one place they all land where a guard fires.
//
// **Every guard leaves the nullish value it tested standing**, `JumpIfAbsentKeep` being what its
// name says, so the landing sees exactly one value however many links were skipped and however far
// along the run the guard that fired was written. That is why there is one `Pop` and one `PushNull`
// for the chain rather than a pair per link: one value stood before the chain's first instruction
// and one stands after its last, on both paths.
private compile_chain(u: *Unit, e: *Emit, x: Expr)
    val at = x.span
    val floor = e.chain.len()

    e.in_spine = true

    compile_expr(u, e, x)

    // A chain with no guard in it is an ordinary run of links, which is what `Chain` around a
    // bracketed expression that turned out not to hold one leaves.
    if e.chain.len() == floor then return

    val done = put(e, Jump(0), at)
    val landing = here(e)

    for i in floor..<e.chain.len()
        patch(e, e.chain.at(i), landing)

    e.chain.truncate(floor)
    push_n(e, Pop, at, 1, 0)
    push_n(e, PushNull, at, 0, 1)
    patch(e, done, here(e))
end compile_chain

// A list of values that is not known until it runs, left on the stack as one array.
//
// **A run of written values becomes an array and each spread is already one**, and `JoinArrays`
// makes one list of them -- so `f(a, ...xs, b)` and `[a, ...xs, b]` both work, and the written and
// the spread values may be in any order. Building it element by element would have needed an append instruction and a
// place to keep the array between elements; this way the machine's array is built by the instruction
// that already builds arrays.
private compile_spread_args(u: *Unit, e: *Emit, args: Buf[Expr], at: Span)
    var groups: usize = 0
    var run: usize = 0

    for i in 0..<args.len()
        *args.at(i).kind match
            Spread(inner) ->
                if run > 0
                    push_n(e, MakeArray(run), at, run, 1)
                    groups += 1
                    run = 0

                compile_expr(u, e, inner)
                groups += 1
            _ ->
                compile_expr(u, e, args.at(i))
                run += 1

    if run > 0
        push_n(e, MakeArray(run), at, run, 1)
        groups += 1

    // **`JoinArrays` runs even for a single group, and the reason is the diagnostic.** One spread on
    // its own is already an array and joining it is a copy that changes nothing -- except that
    // `JoinArrays` is where a spread of something that is not an array is caught, and skipping it
    // sent `f(...42)` into the call with a value nothing had checked.
    if groups == 0
        push_n(e, MakeArray(0), at, 0, 1)
    else
        push_n(e, JoinArrays(groups), at, groups, 1)
end compile_spread_args

private compile_inc_dec(u: *Unit, e: *Emit, target: Expr, up: bool, before: bool, at: Span)
    val op: Tok = if up then Plus else Minus

    *target.kind match
        Name(n) ->
            load_name(u, e, n, target.span)

            if before
                push_n(e, PushInt(1), at, 0, 1)
                push_n(e, op_instruction(op), at, 2, 1)
                push_n(e, Dup, at, 0, 1)
            else
                push_n(e, Dup, at, 0, 1)
                push_n(e, PushInt(1), at, 0, 1)
                push_n(e, op_instruction(op), at, 2, 1)

            store_name(u, e, n, target.span)
        Field(obj, name, _) ->
            val k = intern_str(u, name)

            compile_expr(u, e, obj)
            push_n(e, Dup, target.span, 0, 1)
            push_n(e, GetField(u32(k), u32(fresh_site(u))), target.span, 1, 1)

            if before
                push_n(e, PushInt(1), at, 0, 1)
                push_n(e, op_instruction(op), at, 2, 1)

            // The value to keep goes under the receiver, and a copy of it comes back up to be stored.
            push_n(e, RotUp(1), at, 0, 0)
            push_n(e, DupAt(1), at, 0, 1)

            if !before
                push_n(e, PushInt(1), at, 0, 1)
                push_n(e, op_instruction(op), at, 2, 1)

            push_n(e, SetField(u32(k), u32(fresh_site(u))), target.span, 2, 0)
        Index(t, key, _) ->
            compile_expr(u, e, t)
            compile_expr(u, e, key)
            push_n(e, DupAt(1), target.span, 0, 1)
            push_n(e, DupAt(1), target.span, 0, 1)
            push_n(e, GetIndex, target.span, 2, 1)

            if before
                push_n(e, PushInt(1), at, 0, 1)
                push_n(e, op_instruction(op), at, 2, 1)

            push_n(e, RotUp(2), at, 0, 0)
            push_n(e, DupAt(2), at, 0, 1)

            if !before
                push_n(e, PushInt(1), at, 0, 1)
                push_n(e, op_instruction(op), at, 2, 1)

            push_n(e, SetIndex, target.span, 3, 0)
        _ ->
            push_n(e, FailWith(intern_str(u, "only a name, a field or an element may be stepped")), at, 0, 1)
end compile_inc_dec

// Whether an expression can never answer an absence, which is what lets a call carry `KeptArgs`.
//
// **`undefined` IS ONLY EVER THE IMMEDIATE ANSWER OF A READ THAT FOUND NOTHING** -- a field, an
// element, a parameter nobody gave, a bare `next()` resuming a `yield` -- and slate refuses to keep
// it anywhere. So a literal, an operator's result, a new array, object or string, and a read of a
// local the program bound itself are all proven: the binding refused the absence before the name
// could hold it. Everything else is not, and that is deliberately generous to the refusal: a call's
// answer, a parameter, `if` and `match` (whose arms could be any of the above), a `?.` chain, an
// `await` and a `yield` all keep the check.
//
// **`&&` and `||` answer the operand that decided and an absence is false**, so `o.f && x` can
// answer the absence; both sides must be proven. `a ?? b` answers `a` only where it is present,
// so only `b` has to be.
private never_absent(e: *Emit, x: Expr) -> bool = *x.kind match
    IntLit(_) -> true
    BigLit(_) -> true
    RealLit(_) -> true
    StrLit(_) -> true
    BoolLit(_) -> true
    NullLit -> true
    Name(n) -> slot_named(e, n) match
        Some(i) -> e.sure.at(e.slot_of.at(i))
        None -> false
    Unary(_, _) -> true
    Binary(op, lhs, rhs) ->
        if op == QQ
            never_absent(e, rhs)
        elif op == AndAnd || op == OrOr
            never_absent(e, lhs) && never_absent(e, rhs)
        else
            true
    Compare(_, _) -> true
    Interp(_) -> true
    ArrayLit(_) -> true
    ArrayRepeat(_, _) -> true
    ObjectLit(_, _, _) -> true
    WithFields(_, _, _) -> true
    WithAll(_, _, _) -> true
    Range(_, _, _, _) -> true
    IsPattern(_, _, _) -> true
    Lambda(_, _, _, _) -> true
    _ -> false

// A call's argument count as its instruction carries it, with `KeptArgs` where every argument is
// proven. **A call with no arguments is not marked**: there is nothing for the bit to skip, and a
// profile counting the marked calls should count only the ones it reached.
private call_count(e: *Emit, args: Buf[Expr]) -> u32
    for i in 0..<args.len()
        if !never_absent(e, arg_value(args.at(i))) then return u32(args.len())

    if args.is_empty() then u32(0) else u32(args.len()) | KeptArgs
end call_count

// **`&&` and `||` answer the operand that decided**, which is slate's rule and not sysl's -- so the
// jump keeps what it tested rather than popping it.
private compile_binary(u: *Unit, e: *Emit, op: Tok, lhs: Expr, rhs: Expr, at: Span)
    if op == AndAnd || op == OrOr || op == QQ
        compile_expr(u, e, lhs)

        val skip = if op == AndAnd
            push_n(e, JumpIfFalseKeep(0), at, 0, 0)
        elif op == OrOr
            push_n(e, JumpIfTrueKeep(0), at, 0, 0)
        else
            // `??` asks a different question from `||`: `0 ?? 1` is `0`, because zero is not absent.
            push_n(e, JumpIfPresentKeep(0), at, 0, 0)

        push_n(e, Pop, at, 1, 0)
        compile_expr(u, e, rhs)
        patch(e, skip, here(e))
        return

    compile_expr(u, e, lhs)
    compile_expr(u, e, rhs)
    push_n(e, op_instruction(op), at, 2, 1)
end compile_binary

private compile_if(u: *Unit, e: *Emit, cond: Expr, then_branch: Expr, else_branch: Option[Expr], at: Span)
    compile_expr(u, e, cond)

    val otherwise = push_n(e, JumpIfFalse(0), at, 1, 0)
    val before = e.sp

    open_scope(e, at, scoped_branch(e))
    compile_expr(u, e, then_branch)
    shut_scope(e, at)

    val done = put(e, Jump(0), at)

    patch(e, otherwise, here(e))
    e.sp = before

    open_scope(e, at, scoped_branch(e))

    else_branch match
        Some(x) -> compile_expr(u, e, x)
        None -> push_n(e, PushNull, at, 0, 1)

    shut_scope(e, at)
    patch(e, done, here(e))
end compile_if

// **An arm gets a scope of its own, thrown away when it does not take.** A pattern binds as it goes,
// so a failed arm has already written names, and the only thing keeping them out of the next arm is
// somewhere separate to write them.
private compile_match(u: *Unit, e: *Emit, subject: Expr, arms: Buf[Arm], at: Span)
    compile_expr(u, e, subject)

    val subject_sp = e.sp
    var leaves: Buf[usize] = buf()

    for i in 0..<arms.len()
        val arm = arms.at(i)

        val armed = scoped_arm(e, arm.pattern)

        open_scope(e, at, armed)

        // Reads the subject where it lies and answers whether it took; the subject stays, because the
        // arm after this one wants it.
        refuse_defaults(arm.pattern, "a `match` arm")
        test_pattern(u, e, arm.pattern, at)

        val missed = push_n(e, JumpIfFalse(0), at, 1, 0)
        var guard_missed: usize = 0
        var guarded = false

        arm.guard match
            Some(g) ->
                compile_expr(u, e, g)
                guard_missed = push_n(e, JumpIfFalse(0), at, 1, 0)
                guarded = true
            None -> ()

        // It took: the subject is finished with, and the body's value takes its place.
        push_n(e, Pop, at, 1, 0)
        compile_expr(u, e, arm.body)
        shut_scope(e, at)
        leaves.push(put(e, Jump(0), at))

        // It did not: give the scope back and try the next one, with the subject still in place.
        // **Only where this arm opened one** -- `shut_scope` has already been past on the taking
        // path, so this emits the bare op and `armed` is what says whether there is one to give back.
        patch(e, missed, here(e))

        if guarded then patch(e, guard_missed, here(e))

        if armed then push_n(e, PopScope, at, 0, 0)

        e.sp = subject_sp

    push_n(e, FailNoArm, at, 0, 0)
    e.sp = subject_sp

    for i in 0..<leaves.len()
        patch(e, leaves.at(i), here(e))
end compile_match

// An expression standing where its value is thrown away, compiled to leave nothing behind at all.
//
// **`if`, `match` AND `try` ARE STILL EXPRESSIONS AND NO RULE OF THE LANGUAGE CHANGES HERE.** What
// changes is the code emitted where the compiler can prove nobody reads the answer: written as a
// statement, each of them used to make a value in every branch -- a `PushNull` where the branch had
// none -- and meet a `Discard` on the far side of the join, three instructions per construct per
// execution computing nothing.
//
// **EVERY WAY IN STILL REACHES THE JOIN AT ONE DEPTH, WHICH IS THE WHOLE OF THE ARGUMENT.** Call the
// depth where the construct begins `S`:
//
// - an `if` computes its condition at `S + 1` and `JumpIfFalse` takes it back to `S`; each branch is
//   compiled through here and so leaves `S`; and an `else` nobody wrote pushes nothing instead of a
//   null, so no jump over it is emitted and the test aims straight at the join. Both ways in are `S`;
// - a `match` holds its subject at `S + 1` while the arms are tried, and an arm that takes `Pop`s it
//   and leaves `S`. Nothing falls out of the bottom -- `FailNoArm` reads the subject and faults --
//   so the counter is simply told `S`, which is where every arm's jump arrives;
// - a `try` establishes its handler at `S`, and that is the height the machine cuts back to: the body
//   leaves `S`, and the handler is entered at `S + 1` with the fault on top, which the binding of the
//   caught name takes off again. Both ways in are `S`;
// - a `break`, a `continue` and a `return` never fall through, and each puts the counter back to what
//   the code after it expects before leaving what the statement owes -- which here is nothing -- so a
//   branch ending in one leaves the depth its neighbours leave;
// - **unreadness travels INWARD**: a branch is a block, and its last statement is asked for exactly
//   what the construct was asked for, so an `if` whose branch ends in another `if` costs nothing
//   either.
//
// **A LOOP IS DELIBERATELY NOT ONE OF THESE.** `break x` gives a loop a value, pushed onto the bare
// stack after the unwind, so a loop's two ways out meet carrying one value by construction. Taking
// that away is an argument about `jump_out` rather than about a join, and it is not this one.
//
// Not `private`: reached from `compile_stmt.sysl`.
compile_unread(u: *Unit, e: *Emit, x: Expr, wants: StmtValue)
    val at = x.span

    *x.kind match
        IfExpr(cond, then_branch, else_branch) -> unread_if(u, e, cond, then_branch, else_branch, at, wants)
        MatchExpr(subject, arms) -> unread_match(u, e, subject, arms, at, wants)
        TryCatch(body, name, handler) -> compile_try_unread(u, e, body, name, handler, at, wants)
        Block(stmts) ->
            open_scope(e, at, scoped_block(e, stmts))
            compile_stmts(u, e, stmts, at, wants)
            shut_scope(e, at)

        // Everything else computes a value whatever is done with it, so what is left is the one
        // instruction that drops it -- which is what a statement emitted for it already.
        _ ->
            compile_expr(u, e, x)
            drop_value(e, at, wants)
end compile_unread

// `compile_if` with no value produced by either branch.
private unread_if(u: *Unit, e: *Emit, cond: Expr, then_branch: Expr, else_branch: Option[Expr], at: Span, wants: StmtValue)
    compile_expr(u, e, cond)

    val otherwise = push_n(e, JumpIfFalse(0), at, 1, 0)
    val before = e.sp

    open_scope(e, at, scoped_branch(e))
    compile_unread(u, e, then_branch, wants)
    shut_scope(e, at)

    else_branch match
        Some(x) ->
            val done = put(e, Jump(0), at)

            patch(e, otherwise, here(e))
            e.sp = before

            open_scope(e, at, scoped_branch(e))
            compile_unread(u, e, x, wants)
            shut_scope(e, at)
            patch(e, done, here(e))

        // **A missing `else` costs the `Jump` as well as the `PushNull`**, the branch that took now
        // having nowhere to jump over.
        None ->
            patch(e, otherwise, here(e))
            e.sp = before
end unread_if

// `compile_match` with no value produced by any arm.
//
// **`FailNoArm` READS THE SUBJECT, so the subject is still standing where it stood** -- what changes
// is only what an arm leaves once it has taken, and where the counter is told the arms meet.
private unread_match(u: *Unit, e: *Emit, subject: Expr, arms: Buf[Arm], at: Span, wants: StmtValue)
    compile_expr(u, e, subject)

    val subject_sp = e.sp
    var leaves: Buf[usize] = buf()

    for i in 0..<arms.len()
        val arm = arms.at(i)

        val armed = scoped_arm(e, arm.pattern)

        open_scope(e, at, armed)

        refuse_defaults(arm.pattern, "a `match` arm")
        test_pattern(u, e, arm.pattern, at)

        val missed = push_n(e, JumpIfFalse(0), at, 1, 0)
        var guard_missed: usize = 0
        var guarded = false

        arm.guard match
            Some(g) ->
                compile_expr(u, e, g)
                guard_missed = push_n(e, JumpIfFalse(0), at, 1, 0)
                guarded = true
            None -> ()

        push_n(e, Pop, at, 1, 0)
        compile_unread(u, e, arm.body, wants)
        shut_scope(e, at)
        leaves.push(put(e, Jump(0), at))

        patch(e, missed, here(e))

        if guarded then patch(e, guard_missed, here(e))

        if armed then push_n(e, PopScope, at, 0, 0)

        e.sp = subject_sp

    push_n(e, FailNoArm, at, 0, 0)

    // An arm that took dropped the subject and pushed nothing over it, so the join is one below where
    // the subject stood.
    e.sp = subject_sp - 1

    for i in 0..<leaves.len()
        patch(e, leaves.at(i), here(e))
end unread_match
