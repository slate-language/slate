module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// slx -- elements written in the source.
//
// **What is being pinned is that an element is a CALL and nothing more.** Every shape test below
// says the same thing in a different arrangement: `<div/>` is `createElement("div", {}, [])`, so the
// tree the rest of the compiler walks has never heard of elements. If one of these starts failing
// because a node was added, that is the design going and not a detail.
//
// The running tests are against a `createElement` written in slate at the head of each program --
// which is the point of the desugaring: what an element MEANS is a function a reader can open.

// -- the shape --------------------------------------------------------------------------------

@test
an_element_is_a_call_and_the_tree_has_no_node_for_one()
    assert_eq(good_tree("val x = <br/>"),
              "(val x (call createElement \"br\" (object) (array)))")

    // The props and the children are always there, empty or not, so a `createElement` never has to
    // ask how many arguments it was given.
    assert_eq(good_tree("val x = <p>hi</p>"),
              "(val x (call createElement \"p\" (object) (array \"hi\")))")

@test
A_LOWERCASE_TAG_IS_A_STRING_AND_A_CAPITALISED_ONE_IS_A_NAME()
    // **React's rule, kept because it is learned behaviour that costs no syntax.** A host element
    // travels as text and a component travels as the name the program has in scope.
    assert_eq(good_tree("val x = <div/>"), "(val x (call createElement \"div\" (object) (array)))")
    assert_eq(good_tree("val x = <Card/>"), "(val x (call createElement Card (object) (array)))")

    // `<Menu.Item/>` is a field selection, read through the tag's dot.
    assert_eq(good_tree("val x = <Menu.Item/>"),
              "(val x (call createElement (. Menu Item) (object) (array)))")

@test
an_attribute_spread_is_the_one_an_object_literal_takes()
    // The same fold, so an attribute written after a spread wins over it -- which is JSX's rule and
    // was already slate's.
    assert_eq(good_tree("val x = <div {...p} class=\"a\"/>"),
              "(val x (call createElement \"div\" (with (spread (object) p) class:\"a\") (array)))")

// -- running one ------------------------------------------------------------------------------

@test
an_element_renders_through_the_createElement_the_program_wrote()
    assert_eq(slx_out("print(<br/>)"), "<br></br>")
    assert_eq(slx_out("print(<div class=\"hi\">hello</div>)"), "<div class=hi>hello</div>")

    // A hole is an ordinary expression, and the text around it keeps the spaces it was written with.
    assert_eq(slx_out("val n = \"world\"\nprint(<p>hello {n}!</p>)"), "<p>hello world!</p>")
    assert_eq(slx_out("print(<p>Count: {1 + 1} left</p>)"), "<p>Count: 2 left</p>")

    // An element nests, and a nested one is an ordinary child.
    assert_eq(slx_out("print(<div><b>x</b></div>)"), "<div><b>x</b></div>")

@test
A_BARE_ATTRIBUTE_IS_true_AND_A_HYPHENATED_NAME_IS_ONE_NAME()
    // `<input disabled>` means what it means everywhere else it is written.
    assert_eq(slx_out("print(<i disabled/>)"), "<i disabled=true></i>")

    // **A hyphen is part of the name inside a tag and a subtraction outside one**, which is what the
    // lexer's mode is for: `data-id` is how the web spells it.
    assert_eq(slx_out("print(<i data-id=\"x\" aria-label=\"y\"/>)"), "<i data-id=x aria-label=y></i>")

@test
a_component_is_called_with_its_props_and_its_children()
    assert_eq(slx_out("Card(props) = <b>{props.label}</b>\nprint(<Card label=\"hi\"/>)"),
              "<b>hi</b>")

    // `children` is where the children arrive, which is the `createElement` above deciding it rather
    // than the compiler.
    assert_eq(slx_out("Box(props) = <div>{props.children[0]}</div>\nprint(<Box>inner</Box>)"),
              "<div>inner</div>")

@test
a_fragment_has_no_tag_of_its_own()
    assert_eq(slx_out("print(<><a/><b/></>)"), "<a></a><b></b>")

@test
AN_ELEMENT_IS_AN_EXPRESSION_AND_GOES_WHERE_ONE_GOES()
    assert_eq(slx_out("val xs = [<a/>, <b/>]\nprint(xs[1])"), "<b></b>")
    assert_eq(slx_out("f() = <a/>\nprint(f())"), "<a></a>")
    assert_eq(slx_out("print(if true then <a/> else <b/>)"), "<a></a>")

// -- the whitespace rule ------------------------------------------------------------------------

@test
TEXT_ON_ONE_LINE_IS_KEPT_AND_TEXT_ACROSS_LINES_IS_JOINED()
    // **A run with no line break in it is exactly what was written**, which is the case that matters
    // most: the space before a hole is one the reader meant.
    assert_eq(slx_out("print(<p>a  b</p>)"), "<p>a  b</p>")

    // A run that spans lines is mostly the indentation that lined it up under its tag, so each line
    // is trimmed, blank ones are dropped and what is left is joined with one space. JSX's rule, and
    // it is JSX's rule because any other makes an indented element read differently from a flat one.
    assert_eq(slx_out("print(<p>\n    one\n    two\n</p>)"), "<p>one two</p>")

    // Which means an element written across lines has no text children at all.
    assert_eq(slx_out("print(<div>\n    <b>x</b>\n</div>)"), "<div><b>x</b></div>")

@test
an_element_written_across_lines_opens_no_block()
    // The layout is suspended inside an element the way it is inside brackets, so an attribute may
    // go on a line of its own and the children may be indented under the tag.
    assert_eq(slx_out("print(<div\n    class=\"a\"\n    id=\"b\">x</div>)"),
              "<div class=a id=b>x</div>")

// -- telling a tag from a comparison ------------------------------------------------------------

@test
LESS_THAN_IS_STILL_LESS_THAN()
    // **`<` opens an element only where an operand is expected**, and everywhere else it is the
    // operator it always was. This is the whole of the ambiguity and the whole of the answer.
    assert_eq(out("val a = 1\nval b = 2\nprint(a < b)"), "true")
    assert_eq(out("val a = 1\nval b = 2\nprint(a<b)"), "true")
    assert_eq(out("print(1 < 2 && 3 > 2)"), "true")
    assert_eq(out("val xs = [1]\nprint(xs[0] < 2)"), "true")
    assert_eq(out("f() = 1\nprint(f() < 2)"), "true")

    // And a `<` after something that cannot end an operand is a tag.
    assert_eq(kinds("val x = <a/>"), "Val Ident Assign SlxOpen Ident SlxSelfEnd Newline Eof")
    assert_eq(kinds("val x = a < b"), "Val Ident Assign Ident Lt Ident Newline Eof")

// -- what is refused ----------------------------------------------------------------------------

@test
A_CLOSING_TAG_THAT_NAMES_THE_WRONG_ELEMENT_NAMES_BOTH()
    // Either name may be the mistake and the reader is the only one who knows which.
    assert(fails("val x = <div>hi</span>").contains("this closes `span`, and the tag it is closing is `div`"))
    assert(fails("val x = <div>hi</>").contains("`</>` closes a fragment, and this element is `div`"))

@test
AN_ELEMENT_THAT_NEVER_CLOSES_POINTS_AT_THE_TAG_THAT_OPENED_IT()
    // **Not at the end of the file**, which is where the complaint would otherwise land and is not
    // where the reader has to go.
    val said = fails("val x = <div>hi")

    assert(said.contains("this element reaches the end of the file without closing"))
    assert(said.contains("an element ends with `</name>`"))

@test
AN_ATTRIBUTES_VALUE_IS_A_STRING_OR_A_HOLE()
    // **A bare word is refused rather than read as a name.** `class=wide` is a variable called
    // `wide` in every other position and a string to everyone who writes it, so the two readings
    // disagree about something silent.
    assert(fails("val x = <div class=wide/>").contains("an attribute's value is a quoted string or a `{ ... }`"))

// The programs above are run against this, which is a `createElement` small enough to read: a
// function type renders by being called, and anything else renders as a tag.
//
// **It is deliberately not part of slate.** What an element means is a library's to say, and a test
// that supplied nothing would be testing a rule the compiler does not have.
private slx_out(text: string) -> string = out(s"${SlxPrelude}${text}")

private val SlxPrelude: string = raw"""
    createElement(t, props, kids) =
        if t is function then return t({ ...props, children: kids })

        var s = s"<${t}"

        for [k, v] in entries(props)
            s = s"${s} ${k}=${v}"

        s = s"${s}>"

        for c in kids
            s = s"${s}${c}"

        s"${s}</${t}>"

    Fragment(props) =
        var s = ""

        for c in props.children
            s = s"${s}${c}"

        s

    """
