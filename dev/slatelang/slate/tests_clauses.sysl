module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// Functions defined by clauses -- what the compiler refuses about a run, and where it points.
//
// **What a run DOES is `tests/lang/clauses.sl`**, where it runs on both back ends. What is here is
// what only the compiler can be asked: each refusal's sentence and the clause it sends the reader
// to, which is the line and column at the end of `-->`.

// -- what makes a run ---------------------------------------------------------------------------

@test
AN_UNTYPED_CALL_ABOVE_THE_CLAUSES_STAYS_A_CALL()
    // `show(n)` carries no annotation, so it is not a signature line -- the call runs and prints.
    assert_eq(out("val n = 0\nprint(show(n))\nshow(0) = \"zero\"\nshow(_) = \"other\"\n"), "zero")

@test
A_CALL_BELOW_THE_CLAUSES_IS_NOT_ONE_OF_THEM()
    assert_eq(out("show(0) = \"zero\"\nshow(_) = \"other\"\nprint(show(1))\nshow(2)\n"), "other")

@test
TWO_DEFINITIONS_OF_ONE_NAME_SIDE_BY_SIDE_ARE_TWO_CLAUSES()
    // **This used to be refused as a name declared twice**, and is now a run: the second line is
    // never reached, exactly as a `match` arm after a `_` is not.
    assert_eq(out("f(n) = \"first\"\nf(n) = \"second\"\nprint(f(1))\n"), "first")

@test
A_SINGLE_GUARDED_DEFINITION_IS_A_RUN_OF_ONE()
    assert_eq(out("f(n) | n > 0 = \"positive\"\nprint(f(1))\nprint(f(0) catch e -> e.message)\n"), "positive\nno clause of `f` applies to 0")

@test
A_GUARD_BLOCK_UNDER_A_LINE_SHAPED_LIKE_A_DEFINITION_IS_A_RUN()
    assert_eq(out("f(n)\n    | n > 0 = \"positive\"\n    | _ = \"not\"\nprint(f(1), f(0))\n"), "positive not")

@test
A_STATEMENT_WITH_A_BITWISE_OR_AFTER_A_CALL_IS_STILL_AN_EXPRESSION()
    // `f(x) | g(y)` has no body after it on its line, so it is not a guarded clause.
    assert_eq(out("f(x) = x\ng(y) = y\nprint(f(1) | g(2))\n"), "3")

// -- arity ---------------------------------------------------------------------------------------

@test
EVERY_CLAUSE_TAKES_AS_MANY_ARGUMENTS_AS_THE_FIRST()
    val said = fails("f(0) = 1\nf(a, b) = 2\nprint(f(0))\n")

    assert(said.contains("this clause of `f` takes 2 arguments and the first clause takes 1 argument -- every clause of one function takes the same number"))
    assert(said.contains("t:2:1"))

@test
EVERY_CLAUSE_TAKES_AS_MANY_ARGUMENTS_AS_THE_SIGNATURE()
    val said = fails("f(a: integer, b: integer) -> integer\nf(0) = 1\nprint(f(0, 1))\n")

    assert(said.contains("this clause of `f` takes 1 argument and the signature takes 2 arguments"))
    assert(said.contains("t:2:1"))

// -- the signature -------------------------------------------------------------------------------

@test
A_SIGNATURE_IS_TOLD_FROM_A_CALL_BY_ITS_ANNOTATION()
    assert_eq(out("twice(n: integer) -> integer\ntwice(0) = 0\ntwice(n) = n * 2\nprint(twice(8))\n"), "16")
    assert_eq(out("twice(n) -> integer\ntwice(0) = 0\ntwice(n) = n * 2\nprint(twice(8))\n"), "16")

@test
A_SIGNATURES_RESULT_TYPE_IS_HELD_OVER_EVERY_CLAUSE()
    val said = fails("f(n: integer) -> string\nf(0) = \"zero\"\nf(n) = n\nprint(f(0))\nprint(f(anything(1)))\nanything(v) = v\n")

    assert(said.contains("this answers string, and gave back 1"))

@test
A_SIGNATURES_ANNOTATION_IS_CHECKED_AT_A_CALL_THE_CHECKER_SEES()
    val said = fails("f(n: integer) -> integer\nf(0) = 0\nf(n) = n\nprint(f(\"x\"))\n")

    assert(said.contains("t:4:"))
    assert(said.contains("integer"))

@test
A_SIGNATURE_MAY_NOT_GATHER_THE_REST_OF_THE_ARGUMENTS()
    val said = fails("f(...xs: array) -> integer\nf([]) = 0\nprint(1)\n")

    assert(said.contains("`f` is defined by clauses, and a clause matches a fixed number of arguments"))
    assert(said.contains("t:1:1"))

@test
A_SIGNATURE_MAY_NOT_LEAVE_A_PARAMETER_WITHOUT_A_VALUE()
    val said = fails("f(a: integer, b?) -> integer\nf(a, b) = a\nprint(f(1))\n")

    assert(said.contains("a parameter of `f` may not be left without a value, because its clauses match every argument -- give it a default they can match, such as `= null`"))
    assert(said.contains("t:1:"))

@test
A_SIGNATURE_OVER_A_DATA_TYPE_IS_CHECKED_FOR_COVERING_IT()
    val said = fails("data Shape\n    Circle(r)\n    Rect(w, h)\n    Empty\n\narea(s: Shape) -> number\narea(Circle(r)) = r\narea(Rect(w, h)) = w * h\nprint(area(Empty))\n")

    assert(said.contains("the clauses of `area` do not cover every Shape -- `Empty` is unmatched. Add a clause for it, or one taking `_` for whatever is left"))
    assert(said.contains("t:6:1"))

@test
A_RUN_THAT_COVERS_ITS_DATA_TYPE_IS_ACCEPTED()
    assert_eq(out("data Shape\n    Circle(r)\n    Empty\n\narea(s: Shape) -> integer\narea(Circle(r)) = r\narea(_) = 0\nprint(area(Circle(2)), area(Empty))\n"), "2 0")

// -- what a clause's parameter may not carry -----------------------------------------------------

@test
A_CLAUSES_PARAMETER_CARRIES_NO_ANNOTATION()
    val said = fails("f(0) = 0\nf(n: integer) = n\nprint(f(1))\n")

    assert(said.contains("a parameter of a clause is a pattern and carries no annotation -- the types of `f` go on a signature line above its clauses"))
    assert(said.contains("t:2:4"))

@test
A_CLAUSES_PARAMETER_CARRIES_NO_DEFAULT()
    val said = fails("f(0) = 0\nf(n = 1) = n\nprint(f(1))\n")

    assert(said.contains("a default belongs to a binding and not to a clause of `f` -- a clause's parameter is a test"))
    assert(said.contains("t:2:5"))

@test
A_DEFAULT_INSIDE_A_CLAUSES_PATTERN_IS_REFUSED_AS_IN_A_MATCH()
    val said = fails("f({ a = 1 }) = a\nf(_) = 0\nprint(f({}))\n")

    assert(said.contains("a default belongs to a binding and not to a clause of `f` -- it would make this pattern match a value that does not have the field, which is not a test"))
    assert(said.contains("t:1:3"))

// -- where the clauses are -----------------------------------------------------------------------

@test
CLAUSES_SEPARATED_BY_ANOTHER_STATEMENT_ARE_REFUSED_AT_BOTH()
    val said = fails("f(0) = \"zero\"\nprint(1)\nf(n) = \"other\"\n")

    assert(said.contains("this clause of `f` is separated from the ones above it by other statements -- the clauses of one function are written one after another, so this would be a second function of the same name. Move it up beside the others"))
    assert(said.contains("t:3:1"))
    assert(said.contains("the clauses of `f` begin here"))
    assert(said.contains("t:1:1"))

@test
A_SEPARATED_CLAUSE_IS_REFUSED_IN_A_LOCAL_BLOCK_TOO()
    val said = fails("main()\n    g(0) = 1\n    val x = 2\n    g(n) = n\n    g(x)\nprint(main())\n")

    assert(said.contains("this clause of `g` is separated from the ones above it"))
    assert(said.contains("t:4:5"))

@test
AN_ASYNC_WORD_ON_A_LATER_CLAUSE_IS_REFUSED()
    val said = fails("async f(0) = 1\nasync f(n) = n\nprint(1)\n")

    assert(said.contains("`async` is written once, on the first line of `f` -- its clauses are one function, and that line says what kind it is"))
    assert(said.contains("t:2:1"))

@test
AN_ASYNC_RUN_ANSWERS_A_PROMISE()
    assert_eq(out("async f(0) = \"zero\"\nf(n) = s\"${n}\"\nasync main()\n    print(await f(0), await f(2))\nmain()\n"), "zero 2")

@test
A_CONTRACT_AT_THE_HEAD_OF_A_CLAUSE_IS_REFUSED()
    val said = fails("f(0) = 0\nf(n)\n    require n > 0\n    n\nprint(f(1))\n")

    assert(said.contains("`require` is a whole function's contract, and `f` is defined by clauses with no one body for it to head"))
    assert(said.contains("t:3:5"))

// -- guards ---------------------------------------------------------------------------------------

@test
A_GUARD_AFTER_AN_UNGUARDED_ONE_IS_NEVER_TRIED_AND_IS_REFUSED()
    val said = fails("f(n)\n    | _ = \"any\"\n    | n > 0 = \"positive\"\nprint(f(1))\n")

    assert(said.contains("this guard of `f` is never tried -- `| _` above it always holds, so it ends the block"))
    assert(said.contains("t:3:5"))

@test
A_SECOND_GUARD_UNDER_A_ONE_LINE_GUARDED_CLAUSE_IS_REFUSED()
    val deeper = fails("f(n) | n < 0 = \"negative\"\n    | n < 10 = \"small\"\nf(_) = \"large\"\nprint(f(1))\n")

    assert(deeper.contains("a second guard cannot follow a one-line guarded clause -- write the clause's patterns on a line of their own, `f(...)`, and every guard under it in an indented block, `| condition = body`"))
    assert(deeper.contains("t:2:5"))

    val beside = fails("f(n) | n < 0 = \"negative\"\n| n < 10 = \"small\"\nf(_) = \"large\"\nprint(f(1))\n")

    assert(beside.contains("a second guard cannot follow a one-line guarded clause"))
    assert(beside.contains("t:2:1"))

@test
A_GUARD_BLOCK_LINE_MUST_BEGIN_WITH_A_BAR()
    val said = fails("f(n)\n    | n > 0 = 1\n    n < 0 = 2\nprint(f(1))\n")

    assert(said.contains("a guard of `f` is written `| condition = body`, one to a line"))
    assert(said.contains("t:3:5"))

@test
A_MATCH_ARM_STILL_TAKES_AN_IF_GUARD()
    assert_eq(out("f(x) = x match\n    n if n < 0 -> \"neg\"\n    _ -> \"not\"\nprint(f(-1), f(1))\n"), "neg not")

// -- the JavaScript back end ------------------------------------------------------------------------

@test
THE_JAVASCRIPT_BACK_END_FAULTS_IN_THE_MACHINES_SENTENCE()
    // The parity itself is `tests/lang/clauses.sl`; this pins what is written for it.
    assert(js("f(0) = 1\nf(1) = 2\n").contains("$.fault(\"no clause of `f` applies to \" + $.plainShow("))
