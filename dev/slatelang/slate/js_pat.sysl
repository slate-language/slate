module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.str_builder

// Patterns, as JavaScript.
//
// **A pattern is emitted as DATA and matched by the runtime, where every other form is emitted as
// code.** Two things decide it. A pattern tests and binds in one walk, so code for it is a tree of
// conditionals with the bindings threaded through the branches that succeeded -- and slate's `is`
// binds names that outlive the test, which in JavaScript means a `let` before the condition and an
// assignment inside it. Written as data, `$.matched` does that walk once and answers either the
// values it bound, in the order the names were written, or null.
//
// The shapes, which `matchPattern` in the runtime reads:
//
// | `["_"]` | the wildcard, and a binding: both take whatever is there |
// | `["t", "integer"]` | one of slate's kinds |
// | `["v", 5n]` | a literal, compared as `same_literal` compares it -- no `equals` hook |
// | `["@", inner]` | a name bound to what the inner pattern matched |
// | `["arr", [...], open, rest]` | an array, `open` for a `...` tail and `rest` for a named one |
// | `["obj", ["k"], [...]]` | an object, by its own fields |
// | `["or", [...]]` | alternatives, none of which may bind |
// | `["proto", Point]` | made from that class, or from one descended from it |
//
// **Every pattern is resolved before it is emitted**, by the compiler's own `resolve_pattern`, so a
// bare name that turned out to be a type stands for what the type stands for. Resolving it here a
// second way would be a second answer to a question that already has one.

// Whether a pattern holds, as a JavaScript expression. For a pattern that binds nothing.
emit_test(j: *Js, pat: Pattern, subject: string) -> string =
    s"$$.matches(${subject}, ${pattern_js(j, resolve_pattern(pat, 0))})"

// Try a pattern, keeping what it bound. Answers the name holding either the bound values or null.
emit_attempt(j: *Js, pat: Pattern, subject: string) -> string
    val got = fresh(j)

    line(j, s"const ${got} = $$.matched(${subject}, ${pattern_js(j, resolve_pattern(pat, 0))});")
    got
end emit_attempt

// The names a pattern bound, taken out of what `$.matched` answered.
emit_bind_from(j: *Js, pat: Pattern, got: string)
    var names: Buf[string] = buf()

    pattern_names(resolve_pattern(pat, 0), &names)

    for i in 0..<names.len()
        val name = names.at(i)

        line(j, s"${declaring_into_block(j, name)}${js_name(name)} = ${got}[${i}];")
end emit_bind_from

// `val [a, b] = xs`: a pattern that has to hold, so a failure is a fault.
emit_binding(j: *Js, pat: Pattern, subject: string, immutable: bool, at: Span) =
    emit_bound(j, pat, subject, immutable, false, at)

// A `for`'s binding, which is written outside the block its names land in.
emit_loop_binding(j: *Js, pat: Pattern, subject: string, at: Span) =
    emit_bound(j, pat, subject, true, true, at)

private emit_bound(j: *Js, pat: Pattern, subject: string, immutable: bool, into_block: bool, at: Span)
    val resolved = resolve_pattern(pat, 0)

    // **A bare name is the commonest binding there is** -- `for x in xs` -- and it cannot fail, so
    // it is written as the assignment it is rather than as a walk over a pattern that always holds.
    *resolved.kind match
        Bind(name) ->
            line(j, s"${how(j, name, immutable, into_block)}${js_name(name)} = ${subject};")
            return
        Wild -> return
        _ -> ()

    var names: Buf[string] = buf()

    pattern_names(resolved, &names)

    if names.len() == 0
        line(j, s"$$.unpacked(${subject}, ${pattern_js(j, resolved)});")
        return
    end if

    val got = fresh(j)

    line(j, s"const ${got} = $$.unpacked(${subject}, ${pattern_js(j, resolved)});")

    var defaults: Buf[Option[Expr]] = buf()

    pattern_default_exprs(resolved, &defaults)

    for i in 0..<names.len()
        val name = names.at(i)
        val has = i < defaults.len() && defaults.at(i).is_some()

        // **A name with a default is never `const`**, because the line under it writes to it where
        // the subject supplied nothing. Nothing can see the difference: that write is the only one
        // there is and it happens before any of the program runs.
        line(j, s"${how(j, name, if has then false else immutable, into_block)}${js_name(name)} = ${got}[${i}];")

        if has
            val given = defaults.at(i).unwrap()
            val v = emit_expr(j, given)

            line(j, s"if (${js_name(name)} === undefined) ${js_name(name)} = ${v};")
end emit_bound

private how(j: *Js, name: string, immutable: bool, into_block: bool) -> string =
    if into_block then declaring_into_block(j, name) else declaring(j, name, immutable)

// `x is Point p` used as an expression: the names it binds outlive the test, so they are declared
// before it and filled in where it held.
emit_is(j: *Js, pat: Pattern, subject: string) -> string
    val resolved = resolve_pattern(pat, 0)
    var names: Buf[string] = buf()

    pattern_names(resolved, &names)

    val got = fresh(j)

    line(j, s"const ${got} = $$.matched(${subject}, ${pattern_js(j, resolved)});")

    // **Declared where the block has not declared them already**, since `is` may name what a `val`
    // above it named -- and a second `let` for one name is a JavaScript refusal to start.
    for i in 0..<names.len()
        val kept = declaring(j, names.at(i), false)

        if kept != "" then line(j, s"${kept}${js_name(names.at(i))};")

    if names.len() > 0
        line(j, s"if (${got} !== null) {")
        open(j)

        for i in 0..<names.len()
            line(j, s"${js_name(names.at(i))} = ${got}[${i}];")

        close(j)
        line(j, "}")

    s"(${got} !== null)"
end emit_is

// -- the descriptor ---------------------------------------------------------------------------------

// One pattern, as the data the runtime walks.
private pattern_js(j: *Js, pat: Pattern) -> string
    *pat.kind match
        Wild -> "[\"_\"]"
        Bind(_) -> "[\"_\"]"
        TypePat(t) -> s"[\"t\", ${quoted_js(type_test_text(t))}]"
        At(_, inner) -> s"[\"@\", ${pattern_js(j, inner)}]"
        IntPat(v) -> s"[\"v\", ${v}n]"
        RealPat(v) -> s"[\"v\", ${real_literal(v)}]"
        StrPat(v) -> s"[\"v\", ${quoted_js(v)}]"
        BoolPat(v) -> s"[\"v\", ${if v then "true" else "false"}]"
        NullPat -> "[\"v\", null]"
        ArrayPat(items, open, rest, defaults) ->
            val tail = rest match
                Some(_) -> "true"
                None -> "false"

            // **The count of elements that are NOT optional travels with the pattern**, so the
            // runtime's length check asks the same question the machine's does.
            s"[\"arr\", [${pattern_list(j, items)}], ${if open then "true" else "false"}, ${tail}, ${items.len() - optional_count(defaults)}]"
        ObjectPat(keys, values, defaults, optional) -> s"[\"obj\", [${key_list(keys)}], [${pattern_list(j, values)}], [${absent_list(defaults, optional)}]]"
        OrPat(alts) -> s"[\"or\", [${pattern_list(j, alts)}]]"

        // **The class is named rather than described**, since what `is` asks is identity: the value's
        // `proto` chain either reaches this very object or it does not. A class that is not in scope
        // is a name JavaScript would refuse, which the checker has already refused for us.
        ProtoPat(name, _, _) -> s"[\"proto\", ${js_name(name)}]"

        // **The nominal test and the object pattern, emitted side by side.** The runtime runs both
        // and the object half is the very form an ordinary `{ ... }` emits, so shorthand, defaults
        // and nesting need nothing here either.
        MadeFrom(name, inner) -> s"[\"made\", ${js_name(name)}, ${pattern_js(j, inner)}]"

        // A data type asks what a class asks, so it emits what a class emits -- the variant list it
        // carries is the checker's and there is nothing at run time to do with it.
        DataPat(name, _) -> s"[\"proto\", ${js_name(name)}]"

        // **A variant that declared no fields is the value itself**, so the runtime compares identity
        // rather than walking a chain; anything else is the chain plus the fields, named in the order
        // the declaration gave them.
        VariantPat(name, items, keys, singleton) ->
            if singleton
                s"[\"one\", ${js_name(name)}]"
            else
                s"[\"variant\", ${js_name(name)}, [${key_list(keys)}], [${pattern_list(j, items)}]]"
end pattern_js

private pattern_list(j: *Js, pats: Buf[Pattern]) -> string
    var out = str_builder()

    for i in 0..<pats.len()
        if i > 0 then out.push(", ")

        out.push(pattern_js(j, pats.at(i)))

    out.finish()
end pattern_list

private key_list(keys: Buf[string]) -> string
    var out = str_builder()

    for i in 0..<keys.len()
        if i > 0 then out.push(", ")

        out.push(quoted_js(keys.at(i)))

    out.finish()
end key_list

// The names a pattern binds, in the order the runtime hands their values back -- which is the order
// they are written, outermost first.
//
// Not `private`: `js.sysl` asks what a block declares before emitting it, and an `Unpack` declares
// whatever its pattern binds.
pattern_names(pat: Pattern, into: *Buf[string])
    *pat.kind match
        Bind(name) -> into.push(name)
        At(name, inner) ->
            into.push(name)
            pattern_names(inner, into)
        ArrayPat(items, _, rest, _) ->
            for i in 0..<items.len()
                pattern_names(items.at(i), into)

            rest match
                Some(name) -> into.push(name)
                None -> ()
        ObjectPat(_, values, _, _) ->
            for i in 0..<values.len()
                pattern_names(values.at(i), into)
        VariantPat(_, items, _, _) ->
            for i in 0..<items.len()
                pattern_names(items.at(i), into)
        MadeFrom(_, inner) -> pattern_names(inner, into)

        // An alternative may not bind, so there is nothing to gather from one.
        _ -> ()
end pattern_names

// The default belonging to each name `pattern_names` gathers, in the same order.
//
// **Two walks that must stay in step**, which is why this one mirrors the other line for line rather
// than being folded into it: a name and its default are read out of the same slot of `$.unpacked`'s
// answer.
private pattern_default_exprs(pat: Pattern, into: *Buf[Option[Expr]])
    *pat.kind match
        Bind(_) -> into.push(None)
        At(_, inner) ->
            into.push(None)
            pattern_default_exprs(inner, into)
        ArrayPat(items, _, rest, defaults) ->
            for i in 0..<items.len()
                val before = into.len()

                pattern_default_exprs(items.at(i), into)

                // A default belongs to a bare binding, which contributes exactly one name.
                if into.len() == before + 1 && defaults.at(i).is_some()
                    into.set(before, defaults.at(i))

            rest match
                Some(_) -> into.push(None)
                None -> ()
        ObjectPat(_, values, defaults, _) ->
            for i in 0..<values.len()
                val before = into.len()

                pattern_default_exprs(values.at(i), into)

                if into.len() == before + 1 && defaults.at(i).is_some()
                    into.set(before, defaults.at(i))

        // **In step with `pattern_names`, which is the whole contract between the two.** A variant's
        // fields carry no defaults of their own -- the default a variant may have belongs to its
        // CONSTRUCTOR and has already run by the time there is a value to take apart.
        VariantPat(_, items, _, _) ->
            for i in 0..<items.len()
                pattern_default_exprs(items.at(i), into)

        // The nominal half binds nothing, so the inner object pattern carries the defaults on its
        // own -- and it is the same `ObjectPat` arm above that reads them.
        MadeFrom(_, inner) -> pattern_default_exprs(inner, into)
        _ -> ()
end pattern_default_exprs

// How many entries carry a default.
private optional_count(defaults: Buf[Option[Expr]]) -> usize
    var n: usize = 0

    for i in 0..<defaults.len()
        if defaults.at(i).is_some() then n += 1

    n

// `true, false, true` -- which of these entries the subject need not have.
//
// **The two reasons a field may be absent collapse to one flag HERE and only here.** The runtime's
// matcher asks a single question -- may this key be missing -- and a default's binding is emitted as
// code after the unpack, so what a `=` means beyond "optional" is already somewhere else by the time
// this runs. A `?` means nothing beyond it at all.
private absent_list(defaults: Buf[Option[Expr]], optional: Buf[bool]) -> string
    var out = str_builder()

    for i in 0..<defaults.len()
        if i > 0 then out.push(", ")

        out.push(if defaults.at(i).is_some() || optional.at(i) then "true" else "false")

    out.finish()
