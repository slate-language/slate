module dev.slatelang.slate
@tests

import sh.sysl.libuv
import sysl.crypto.new_sha256
import sysl.encoding.hex_string
import sysl.fs.{read_bytes, write_text}
import sysl.text.{Search, from_utf8_unchecked}

// `slate brew`: a project's bundle and the Homebrew formula that installs it, written together.
//
// **The bundle is run alone, as every bundle test runs one**, and the formula's hash is checked
// against a digest taken independently of the bytes on disk -- because the whole point of writing
// the two at once is that the formula names exactly the file beside it.

// `slate brew <dir> -o <tmp>`, against the fixture cache, answering the directory written into.
brewed(dir: string) -> string
    val out = libuv.mkdtemp_sync("/tmp/slate-brew-XXXXXX").unwrap()

    set_package_cache("tests/cache")

    val said = cli_said(["slate", "brew", dir, "-o", out])

    set_package_cache("")
    assert(said.contains(s"wrote ${out}/app.rb"), s"`slate brew ${dir}` said: ${said}")
    out
end brewed

sha256_of(bytes: []const u8) -> string
    var h = new_sha256()

    h.update(bytes)

    var out: [32]u8

    h.finish(out[0..<32]).unwrap()
    hex_string(out[0..<32])
end sha256_of

@test
BREW_WRITES_A_BUNDLE_THAT_RUNS_ALONE_AND_A_FORMULA_THAT_NAMES_IT()
    val out = brewed("tests/proj")
    val bundle = s"${out}/app"

    set_package_cache("/tmp/slate-no-cache-here")

    val said = ran_out(bundle)

    set_package_cache("")
    assert_eq(said, "hello world (greet 2)\nHELLO WORLD (GREET 2)")

    val rb = from_utf8_unchecked(read_bytes(s"${out}/app.rb").unwrap())
    val sha = sha256_of(read_bytes(bundle).unwrap())

    assert(rb.starts_with("class App < Formula\n"), rb)
    assert(rb.contains("  desc \"Two packages, one of which imports the other\"\n"), rb)
    assert(rb.contains("  homepage \"https://github.com/example/app\"\n"), rb)
    assert(rb.contains("  url \"https://github.com/example/app/releases/download/v0.1.0/app\"\n"), rb)
    assert(rb.contains(s"  version \"0.1.0\"\n"), rb)
    assert(rb.contains(s"  sha256 \"${sha}\"\n"), rb)
    assert(rb.contains("  license \"ISC\"\n"), rb)
    assert(rb.contains("  depends_on \"slate-language/tap/slate\"\n"), rb)
    assert(rb.contains("    bin.install \"app\"\n"), rb)
    assert(rb.contains("    assert_predicate bin/\"app\", :executable?\n"), rb)
    assert(rb.contains(s"with slate ${SlateVersion}"), rb)

@test
THE_FORMULA_CLASS_IS_DERIVED_AS_BREW_DERIVES_IT()
    assert_eq(formula_class("app"), "App")
    assert_eq(formula_class("my-tool"), "MyTool")
    assert_eq(formula_class("my_tool.v2"), "MyToolV2")
    assert_eq(formula_class("Already"), "Already")

@test
THE_RELEASE_URL_IS_THE_GITHUB_RELEASE_ASSET()
    assert_eq(release_url("https://github.com/o/r", "r", "1.2.3"), "https://github.com/o/r/releases/download/v1.2.3/r")
    assert_eq(release_url("https://github.com/o/r/", "r", "1.2.3"), "https://github.com/o/r/releases/download/v1.2.3/r")
    assert_eq(release_url("https://example.com/r", "r", "1.2.3"), "")
    assert_eq(release_url("", "r", "1.2.3"), "")

@test
A_FORMULA_QUOTES_WHAT_RUBY_WOULD_READ()
    val rb = formula("x", "1.0.0", "says \"hi\" #{not} \\ done", "", "https://github.com/o/x", "u", "0", "9")

    assert(rb.contains("  desc \"says \\\"hi\\\" \\#{not} \\\\ done\"\n"), rb)
    assert(!rb.contains("license"), rb)

@test
A_PROJECT_WITHOUT_MAIN_OR_HOMEPAGE_IS_REFUSED_BY_NAME()
    val dir = libuv.mkdtemp_sync("/tmp/slate-brew-XXXXXX").unwrap()

    write_text(s"${dir}/package.sl", "{ name: \"x\", version: \"1.0.0\", homepage: \"https://github.com/o/x\" }\n").unwrap()
    assert_eq(cli_status(["slate", "brew", dir]), 1)
    assert(cli_said(["slate", "brew", dir]).contains("has no `main`, and `slate brew` bundles it"))

    write_text(s"${dir}/package.sl", "{ name: \"x\", version: \"1.0.0\", main: \"x.sl\" }\n").unwrap()
    assert(cli_said(["slate", "brew", dir]).contains("has no `homepage`, and a formula fetches its bundle"))

    write_text(s"${dir}/package.sl", "{ name: \"x\", version: \"1.0.0\", main: \"x.sl\", homepage: \"https://example.com/x\" }\n").unwrap()
    assert(cli_said(["slate", "brew", dir]).contains("`homepage` is https://example.com/x, and a formula fetches its bundle from a GitHub repository's releases"))

    // Refused before anything is bundled, so nothing is written.
    read_bytes(s"${dir}/x") match
        Ok(_) -> assert(false, "a refused project left a bundle behind")
        Err(_) -> ()

@test
A_PROGRAM_THE_CHECK_REFUSES_WRITES_NEITHER_FILE()
    val dir = libuv.mkdtemp_sync("/tmp/slate-brew-XXXXXX").unwrap()

    write_text(s"${dir}/package.sl", "{ name: \"bad\", version: \"1.0.0\", main: \"bad.sl\", homepage: \"https://github.com/o/bad\" }\n").unwrap()
    write_text(s"${dir}/bad.sl", "print(nothingByThisName)\n").unwrap()

    assert_eq(cli_status(["slate", "brew", dir]), 1)
    assert(cli_said(["slate", "brew", dir]).contains("`nothingByThisName` is not defined"))

    read_bytes(s"${dir}/bad") match
        Ok(_) -> assert(false, "a refused program left a bundle behind")
        Err(_) -> ()

    read_bytes(s"${dir}/bad.rb") match
        Ok(_) -> assert(false, "a refused program left a formula behind")
        Err(_) -> ()

@test
BREW_WITHOUT_AN_OUTPUT_DIRECTORY_WRITES_BESIDE_THE_MANIFEST()
    val dir = libuv.mkdtemp_sync("/tmp/slate-brew-XXXXXX").unwrap()

    write_text(s"${dir}/package.sl", "{ name: \"hi\", version: \"2.0.0\", main: \"hi.sl\", homepage: \"https://github.com/o/hi\" }\n").unwrap()
    write_text(s"${dir}/hi.sl", "print(\"hi\")\n").unwrap()

    assert_eq(cli_status(["slate", "brew", dir]), 0)
    assert_eq(ran_out(s"${dir}/hi"), "hi")
    assert(from_utf8_unchecked(read_bytes(s"${dir}/hi.rb").unwrap()).contains("class Hi < Formula"))

@test
BREW_MISUSED_IS_STATUS_TWO()
    assert_eq(cli_status(["slate", "brew", "tests/proj", "-o"]), 2)
    assert_eq(cli_status(["slate", "brew", "tests/proj", "extra"]), 2)
    assert_eq(cli_status(["slate", "brew", "-o", "x", "-o", "y"]), 2)

@test
THE_DESCRIPTIVE_KEYS_ARE_READ_AND_ARE_STRINGS()
    assert_eq(
        proj("{ name: \"x\", version: \"1.0.0\", description: \"d\", homepage: \"h\", license: \"l\" }"),
        "x 1.0.0 description=d homepage=h license=l")
    assert(proj("{ name: \"x\", version: \"1.0.0\", license: 3 }").contains("`license` is a string, and this one is"))
