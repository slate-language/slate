module dev.slatelang.slate

import sysl.buf.{Buf, buf}
import sysl.text.Search

// The modules slate brings with it, and what each one exports.
//
// **A BUILT-IN MODULE IS A `Program` WITH NO STATEMENTS AND AN EXPORT LIST, WHICH IS WHY THIS FILE
// IS SO SMALL.** `compile_module` already ends every module by emitting `PushStr(name)` and
// `LoadName(name)` for each export and folding them into an object -- and a module runs in a child
// of the scope the natives were declared into, so `LoadName("now")` finds the native `now` with
// nothing else asked of it. So one of these needs no source text, no synthesised statements and no
// second kind of chunk: the loader hands the compiler an empty program that claims the exports, and
// every pass downstream treats it as the ordinary module it is. Cycles, `PushModule`, the
// export-name check and its "did you mean" all work without being told.
//
// **The other kind is a module written in slate and carried in the binary**, which is what
// `slate:http` will be. Nothing here forbids it: such a module arrives as a `Program` with real
// statements, parsed from bundled text rather than from a file, and the same loader path takes it.
// It is not built because nothing needs it yet.

// The one family of built-in modules, and the word in front of the colon.
//
// **Named rather than assumed**, so that `node:http` can be refused by saying which families exist
// instead of complaining about the module after the colon, which is not the part that is wrong.
val BuiltinNamespace: string = "slate"

// What a built-in module is called as a source: `slate:time`.
//
// **Modules are told apart by this string alone**, since it is what `Loaded.sources` records and
// what `module_index` compares -- and a colon can appear in no file path slate will resolve, so a
// built-in module can never collide with a file or with a package's entry.
builtin_path(name: string) -> string = s"${BuiltinNamespace}:${name}"

// Whether a module path names one of slate's own.
//
// **Asked of the PATH rather than of a flag carried alongside it**, because the path is the one
// thing every pass already has: `Loaded.sources`, `Unit.module_paths` and `Chunk.name` are all this
// string. A colon appears in no path slate resolves, so the test cannot be fooled by a file.
is_slate_module(path: string) -> bool = path.starts_with(s"${BuiltinNamespace}:")

// Whether slate has a module of this name, and what it exports.
builtin_module(name: string) -> Option[Buf[string]]
    if name == "brotli" then return Some(named(BrotliExports))
    if name == "dom" then return Some(named(DomExports))
    if name == "fs" then return Some(named(FsExports))
    if name == "http" then return Some(named(HttpExports))
    if name == "jwt" then return Some(named(JwtExports))
    if name == "llhttp" then return Some(named(LlhttpExports))
    if name == "net" then return Some(named(NetExports))
    if name == "password" then return Some(named(PasswordExports))
    if name == "process" then return Some(named(ProcessExports))
    if name == "redis" then return Some(named(RedisExports))
    if name == "regex" then return Some(named(RegexExports))
    if name == "time" then return Some(named(TimeExports))
    if name == "ws" then return Some(named(WsExports))

    None
end builtin_module

// Every built-in module there is, for a message that has to list them.
builtin_module_names() -> Buf[string]
    var out: Buf[string] = buf()

    out.push("brotli")
    out.push("dom")
    out.push("fs")
    out.push("http")
    out.push("jwt")
    out.push("llhttp")
    out.push("net")
    out.push("password")
    out.push("process")
    out.push("redis")
    out.push("regex")
    out.push("time")
    out.push("ws")
    out
end builtin_module_names

// The slate source of a built-in module, and `""` for one that is an export list over natives.
//
// **The two kinds differ HERE and nowhere else.** A module with source is parsed, follows its own
// imports and runs its own statements; one without arrives as a `Program` with no statements and the
// export list above. Everything downstream -- the cycle check, `PushModule`, the export-name check
// and its "did you mean" -- is the same for both.
builtin_has_source(name: string) -> bool =
    name == "http" || name == "jwt" || name == "redis" || name == "ws"

builtin_source(name: string) -> string
    if name == "http" then return http_source()
    if name == "jwt" then return jwt_source()
    if name == "redis" then return redis_source()
    if name == "ws" then return ws_source()

    ""
end builtin_source

// The sentence a reader gets after naming a module that is not one.
builtin_choices() -> string
    val names = builtin_module_names()
    var out = ""

    for i in 0..<names.len()
        val sep = if i == 0 then "" else if i == names.len() - 1 then " and " else ", "

        out = s"${out}${sep}`${BuiltinNamespace}:${names.at(i)}`"

    s" -- slate has ${out}"
end builtin_choices

// -- what each module holds -------------------------------------------------------------------------

// The file system: the ten operations, each in a promise-shaped and a blocking form.
//
// **`stat`, `exists`, `remove` and `rename` are the argument for this one**, being verbs a program
// wants for its own -- and while they were global a script writing `val stat = ...` shadowed a
// builtin without meaning to. The pairing is node's, and so is the reasoning behind the `Sync`
// suffix: the longer name is the blocking one, so reaching for it is a decision.
// The document. **Thirteen names, and every one of them is a refusal under the interpreter** --
// there is no page there and saying so is worth more than leaving the module out, which would make
// the import itself look like the mistake.
//
// **`on`, `off`, `query` and `setText` are the argument for the module in its strongest form.** They
// are words a program wants for its own more than `stat` or `send` ever were: an event emitter has
// an `on`, a database has a `query`, and anything with a label has a `setText`. None of them could
// have been a global.
private val DomExports: []const string = [
    "createElement", "createText", "setAttribute", "removeAttribute", "setProperty",
    "on", "off", "setChildren", "setText", "byId", "query", "markup", "release"]

private val FsExports: []const string = [
    "readFile", "readBytes", "writeFile", "readDir", "stat",
    "exists", "remove", "mkdir", "rmdir", "rename",
    "readFileSync", "readBytesSync", "writeFileSync", "readDirSync", "statSync",
    "existsSync", "removeSync", "mkdirSync", "rmdirSync", "renameSync"]

// TCP: a listener, a connection, and the four things one does with either.
//
// **`send`, `close` and `connect` are the argument for this one**, being words a program wants for
// its own -- a mailer with its own `send`, a file abstraction with its own `close` -- and while they
// were global, writing one shadowed a builtin without meaning to. `listen` and `onData` are less
// contested but belong with them: a program that wants a socket wants the whole vocabulary, and
// splitting it across an import and the global core would be a distinction nobody could remember.
// JSON Web Tokens. **Written in slate**, over the two signing natives in `jws.sysl`.
//
// **`sign`, `verify` and `decode` are three words a program wants for its own**, which is the
// argument for a module rather than globals -- and `sign` in particular would collide with the
// arithmetic sense of the word.
private val JwtExports: []const string = ["sign", "verify", "decode"]

private val NetExports: []const string = [
    "listen", "connect", "onData", "onBytes", "onError", "send", "close", "localPort"]

// Password hashing, on Argon2id.
//
// **`hash` and `check` are the argument for this one, and they are as strong as the argument gets**
// -- a table with a `hash` of its own and a validator with a `check` are both ordinary things to
// write, and either would have shadowed a builtin without meaning to. `check` is also what `verify`
// had to become: `slate:jwt` exports that name and a server wants both modules at once.
private val PasswordExports: []const string = ["hash", "hashStrong", "check", "needsRehash"]

// Brotli, the encoding every browser asks for before gzip.
//
// **`compress` and `decompress` are the argument for this one** -- an archiver, a log writer, or
// anything with a second encoding of its own wants both words, and as globals either would have
// shadowed a builtin silently. `slate:http` reaches for the same two names from inside the builtin
// scope, which is what lets a response go out compressed with nothing asked of the handler.
private val BrotliExports: []const string = ["compress", "decompress"]

// HTTP, which is the one module written in slate rather than declared over natives.
//
// **The list is here anyway, and that is deliberate.** The module's own `export` lines are what
// actually govern -- it is parsed like any file -- so this is a second statement of the same fact,
// and `EVERY_NAME_A_BUILT_IN_MODULE_CLAIMS_IS_ONE_THE_SCOPE_ACTUALLY_HAS` fails the moment the two
// disagree. A module nobody has imported is never compiled, so without that test a renamed export
// would wait for the first program to want it.
private val HttpExports: []const string = ["serve", "close"]

// The HTTP parser itself -- llhttp, which is already in the binary because `slate:http` is written
// over it.
//
// **This is the lowest module slate has, and it is public on purpose.** `slate:http` is the server
// a program wants; this is the state machine under it, for the programs that want something else --
// a proxy, a client that keeps its connections, a test double that has to answer exactly the bytes
// it was asked about, or a protocol that begins as HTTP and then stops being it. Every one of those
// is an ordinary package now, where before it would have been a change to slate.
//
// **Node hid the same seam and its own client had to route around it**: undici carries llhttp
// compiled to wasm because `internalBinding('http_parser')` is not reachable. Two parsers in one
// process is the cost of that policy, and there is no version of it worth repeating.
//
// **The names keep their `http` prefix rather than being shortened to fit the module.** They are
// the seam `slate:http` is written against and they are spelled this way inside it, so a reader
// moving between the module's source and a package that uses the same calls sees one vocabulary.
private val LlhttpExports: []const string = [
    "httpParser", "httpStream", "httpFeed", "httpTake", "httpTakePart",
    "httpFinish", "httpClose", "httpUpgraded"]

// Other programs, and this program's own environment.
//
// **`run` is the argument for this one**, being about as ordinary a word as a program can want -- a
// task runner, a test harness, a script with a `run(step)` of its own. `env` comes with it because
// the two are one subject: a child's environment is given at the call, and what to give it is read
// from this one.
// **`args` and `exit` join them because a script is the same subject.** What this process was asked
// to do and what it tells the shell afterwards sit beside what a child process is asked and what it
// answered; a module called `process` that carried only the child half would be naming the smaller
// of the two.
private val ProcessExports: []const string = ["run", "env", "args", "exit"]

// Regular expressions, which is one name because a pattern is one object and everything else is a
// method on it.
//
// **A module of one export is still worth having**, since `regex` is a noun a program may want for
// a pattern of its own -- and the alternative was leaving one global behind for no reason but its
// being alone. `v is regex` and `re: regex` are type positions and need no import, as with every
// other type word.
private val RegexExports: []const string = ["regex"]

// Redis, which is one export because a connection is one object and everything else is a method on
// it -- the same shape `slate:regex` has.
//
// **`redis` is also what `connect` had to become.** `slate:net` exports that name and a program with
// a Redis client in it is a program with sockets in it, so the two would have collided in every file
// that wanted both.
private val RedisExports: []const string = ["redis"]

// The WebSocket server, written in slate over the upgrade `slate:http` hands over.
//
// **`accept` is the whole of what a program needs**, and the other three are the seam a *client*
// would be written against -- the same reasoning that made `slate:llhttp` public. `framed` and
// `unframed` are the protocol's byte layout in both directions and `accepting` is the one value the
// handshake turns on, so a program that wants to speak WebSocket to somebody else's server has the
// pieces rather than a second copy of them.
private val WsExports: []const string = ["accept", "accepting", "framed", "unframed"]

// Dates and times: the eight temporal types and everything that makes or reads one.
//
// **The generic names are the argument for the module.** `at`, `offset`, `format`, `day`, `second`
// and `time` are words a program wants for its own, and every one of them was a global -- so a
// script that wrote `val time = ...` was shadowing a builtin without meaning to. Behind an import
// they are asked for by name and cost nothing to a program that does not want them.
private val TimeExports: []const string = [
    "now", "monotonic", "instant",
    "date", "time", "dateTime", "zone", "localZone", "utc",
    "epochSeconds", "epochMillis", "epochMicros",
    "micros", "millis", "seconds", "minutes", "hours", "days", "weeks", "months", "years",
    "year", "month", "day", "hour", "minute", "second",
    "weekday", "monthName", "dayOfYear", "daysInMonth", "isLeapYear",
    "at", "offset", "isDST", "abbrev", "startOf", "onOrAfter", "format",
    "parseDate", "parseTime", "parseDateTime", "parseTimestamp"]

private named(names: []const string) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<names.len
        out.push(names[i])

    out
end named
