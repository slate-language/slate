module dev.slatelang.slate

import sysl.buf.{Buf, buf}
import sysl.text.Search

// The modules slate brings with it, and what each one exports.
//
// **A BUILT-IN MODULE IS A `Program` WITH NO STATEMENTS AND AN EXPORT LIST, WHICH IS WHY THIS FILE
// IS SO SMALL.** `compile_module` already ends every module by emitting `PushStr(name)` and
// `LoadName(name)` for each export and folding them into an object -- and a module runs in a child
// of the scope the natives were declared into, so `LoadName("now")` finds the native `now` with
// nothing else asked of it. So one of these needs no source text, no synthesised statements and no
// second kind of chunk: the loader hands the compiler an empty program that claims the exports, and
// every pass downstream treats it as the ordinary module it is. Cycles, `PushModule`, the
// export-name check and its "did you mean" all work without being told.
//
// **The other kind is a module written in slate and carried in the binary**, which is what
// `slate:http` will be. Nothing here forbids it: such a module arrives as a `Program` with real
// statements, parsed from bundled text rather than from a file, and the same loader path takes it.
// It is not built because nothing needs it yet.

// The one family of built-in modules, and the word in front of the colon.
//
// **Named rather than assumed**, so that `node:http` can be refused by saying which families exist
// instead of complaining about the module after the colon, which is not the part that is wrong.
val BuiltinNamespace: string = "slate"

// What a built-in module is called as a source: `slate:time`.
//
// **Modules are told apart by this string alone**, since it is what `Loaded.sources` records and
// what `module_index` compares -- and a colon can appear in no file path slate will resolve, so a
// built-in module can never collide with a file or with a package's entry.
builtin_path(name: string) -> string = s"${BuiltinNamespace}:${name}"

// Whether a module path names one of slate's own.
//
// **Asked of the PATH rather than of a flag carried alongside it**, because the path is the one
// thing every pass already has: `Loaded.sources`, `Unit.module_paths` and `Chunk.name` are all this
// string. A colon appears in no path slate resolves, so the test cannot be fooled by a file.
is_slate_module(path: string) -> bool = path.starts_with(s"${BuiltinNamespace}:")

// Whether slate has a module of this name, and what it exports.
builtin_module(name: string) -> Option[Buf[string]]
    if name == "fs" then return Some(named(FsExports))
    if name == "net" then return Some(named(NetExports))
    if name == "process" then return Some(named(ProcessExports))
    if name == "regex" then return Some(named(RegexExports))
    if name == "time" then return Some(named(TimeExports))

    None
end builtin_module

// Every built-in module there is, for a message that has to list them.
builtin_module_names() -> Buf[string]
    var out: Buf[string] = buf()

    out.push("fs")
    out.push("net")
    out.push("process")
    out.push("regex")
    out.push("time")
    out
end builtin_module_names

// The sentence a reader gets after naming a module that is not one.
builtin_choices() -> string
    val names = builtin_module_names()
    var out = ""

    for i in 0..<names.len()
        val sep = if i == 0 then "" else if i == names.len() - 1 then " and " else ", "

        out = s"${out}${sep}`${BuiltinNamespace}:${names.at(i)}`"

    s" -- slate has ${out}"
end builtin_choices

// -- what each module holds -------------------------------------------------------------------------

// The file system: the ten operations, each in a promise-shaped and a blocking form.
//
// **`stat`, `exists`, `remove` and `rename` are the argument for this one**, being verbs a program
// wants for its own -- and while they were global a script writing `val stat = ...` shadowed a
// builtin without meaning to. The pairing is node's, and so is the reasoning behind the `Sync`
// suffix: the longer name is the blocking one, so reaching for it is a decision.
private val FsExports: []const string = [
    "readFile", "readBytes", "writeFile", "readDir", "stat",
    "exists", "remove", "mkdir", "rmdir", "rename",
    "readFileSync", "readBytesSync", "writeFileSync", "readDirSync", "statSync",
    "existsSync", "removeSync", "mkdirSync", "rmdirSync", "renameSync"]

// TCP: a listener, a connection, and the four things one does with either.
//
// **`send`, `close` and `connect` are the argument for this one**, being words a program wants for
// its own -- a mailer with its own `send`, a file abstraction with its own `close` -- and while they
// were global, writing one shadowed a builtin without meaning to. `listen` and `onData` are less
// contested but belong with them: a program that wants a socket wants the whole vocabulary, and
// splitting it across an import and the global core would be a distinction nobody could remember.
private val NetExports: []const string = [
    "listen", "connect", "onData", "onBytes", "send", "close", "localPort"]

// Other programs, and this program's own environment.
//
// **`run` is the argument for this one**, being about as ordinary a word as a program can want -- a
// task runner, a test harness, a script with a `run(step)` of its own. `env` comes with it because
// the two are one subject: a child's environment is given at the call, and what to give it is read
// from this one.
private val ProcessExports: []const string = ["run", "env"]

// Regular expressions, which is one name because a pattern is one object and everything else is a
// method on it.
//
// **A module of one export is still worth having**, since `regex` is a noun a program may want for
// a pattern of its own -- and the alternative was leaving one global behind for no reason but its
// being alone. `v is regex` and `re: regex` are type positions and need no import, as with every
// other type word.
private val RegexExports: []const string = ["regex"]

// Dates and times: the eight temporal types and everything that makes or reads one.
//
// **The generic names are the argument for the module.** `at`, `offset`, `format`, `day`, `second`
// and `time` are words a program wants for its own, and every one of them was a global -- so a
// script that wrote `val time = ...` was shadowing a builtin without meaning to. Behind an import
// they are asked for by name and cost nothing to a program that does not want them.
private val TimeExports: []const string = [
    "now", "monotonic", "instant",
    "date", "time", "dateTime", "zone", "localZone", "utc",
    "epochSeconds", "epochMillis", "epochMicros",
    "micros", "millis", "seconds", "minutes", "hours", "days", "weeks", "months", "years",
    "year", "month", "day", "hour", "minute", "second",
    "weekday", "monthName", "dayOfYear", "daysInMonth", "isLeapYear",
    "at", "offset", "isDST", "abbrev", "startOf", "onOrAfter", "format",
    "parseDate", "parseTime", "parseDateTime", "parseTimestamp"]

private named(names: []const string) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<names.len
        out.push(names[i])

    out
end named
