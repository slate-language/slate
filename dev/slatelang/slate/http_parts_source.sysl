module dev.slatelang.slate

// `slate:http`'s third piece: the parts of a request a program reads by name, the router, and the
// file server.
//
// **One module, several blocks** -- see `http_write_source.sysl` for why. The query string, forms
// and cookies come first because the router's `:name` decoding uses the same percent-decoder.

http_parts_source() -> string = raw"""
    // -- the query string, forms and cookies -----------------------------------------------------------

    // **THE PERCENT-CODER AND THE `name=value` GRAMMAR ARE `slate:url`'s NOW.** They were written here
    // and were exported from here, with a comment saying a framework over this module needs the same
    // decoder the router uses -- which was true and was not enough. The JavaScript back end emits the
    // whole of an imported module, so a browser page importing `slate:http` to reach two of them grew
    // by 239 KB, and a page that wants to read a query string should not be paying for a file server.
    //
    // **The four names below are still `slate:http`'s exports and always will be**, forwarded rather
    // than removed: a program written against this module notices nothing. The import that supplies
    // them is at the head of the module, beside the other three.
    export percentDecode(s: string, plusIsSpace: boolean) -> string = urlDecode(s, plusIsSpace)

    export encodeComponent(s: string) -> string = urlEncode(s)

    export parseQuery(s: string) -> object = urlQuery(s)

    // A body sent as `application/x-www-form-urlencoded`, which is the same grammar as a query string.
    //
    // **It is not called automatically.** A body has a content type and a handler that did not ask for a
    // form should not have one parsed for it -- and a body arrives as text, so nothing is lost by asking.
    export parseForm(body: string) -> object = urlPairs(body, "&", true)

    // `a=1; b=2` -- the `Cookie` header a client sends.
    //
    // **Only the value is decoded.** A cookie's name is a token by the specification, and one holding a
    // `%` means that `%`; browsers do not encode names and decoding them would make two different
    // cookies into one.
    export parseCookies(header: string) -> object = urlPairs(header, ";", false)

    // One `Set-Cookie` value, for a handler to put in its headers.
    //
    // **A function answering a string rather than a shape the server understands**, because that is what
    // composes: several cookies are several strings, and `headers` already takes an array for a header
    // name that repeats. Nothing about setting a cookie had to be built into the server.
    //
    //     { headers: { "Set-Cookie": setCookie("session", id, { httpOnly: true, maxAge: 3600 }) } }
    export setCookie(name: string, value: string, options: object = {}) -> string =
        var out = name + "=" + encodeComponent(value)

        if has(options, "maxAge") then out = out + "; Max-Age=" + string(options.maxAge)
        if has(options, "expires") then out = out + "; Expires=" + string(options.expires)
        if has(options, "domain") then out = out + "; Domain=" + string(options.domain)

        // **`Path=/` by default, which is the one default here that is not the specification's.** A
        // cookie with no path is scoped to the directory of the request that set it, which is almost
        // never what a program means and is a bug that only appears on the second path.
        out = out + "; Path=" + (if has(options, "path") then string(options.path) else "/")

        if has(options, "sameSite") then out = out + "; SameSite=" + string(options.sameSite)
        if has(options, "httpOnly") && options.httpOnly then out = out + "; HttpOnly"
        if has(options, "secure") && options.secure then out = out + "; Secure"

        out

    // -- routing ---------------------------------------------------------------------------------------

    // A router: what path and method each handler is for, and the parameters a path binds.
    //
    //     val app = router()
    //
    //     app.get("/users/:id", (req) -> "user " + req.params.id)
    //     app.post("/users", (req) -> created(req.body))
    //     app.get("/files/*rest", (req) -> serveFile(req.params.rest))
    //
    //     serve(3000, app)
    //
    // **A router is an ordinary object holding functions**, which is what lets `serve` take one: a
    // handler is a function, and an object with a `handle` is asked for its `handle`. Nothing about the
    // server knows what routing is.
    export router() -> Router =
        var routes = []
        var fallback = null

        add(method: string, pattern: string, handler) =
            if !(handler is function) then throw "a route needs a function to call, and this is not one"

            push(routes, { method: method, parts: segments(pattern), handler: handler })

        // **Every route is tried in the order it was added**, which is the rule every router has and the
        // only one a reader can predict. A more specific route written second does not win.
        handle(req: object) =
            val want = segments(req.path)
            var allowed = []

            for r in routes
                val bound = fit(r.parts, want)

                if bound != null
                    if r.method == "" || r.method == req.method
                        req.params = bound

                        return r.handler(req)

                    if !contains(allowed, r.method) then push(allowed, r.method)

            // **A path that matched with the wrong method is 405 and not 404**, and the difference is
            // worth the four lines: 404 tells a client the thing is not there, and it is. `Allow` is
            // required on a 405 and is what a client reads to find out what it should have sent.
            if len(allowed) != 0
                return { status: 405, headers: { Allow: join(sorted(allowed), ", ") }, body: "" }

            if fallback != null then return fallback(req)

            { status: 404, body: "Not Found" }

        // **A named function and not a lambda**, because a lambda's one-line body is an expression
        // and `fallback = h` is a statement. Every other member is a call and needs no name.
        setFallback(h: function) =
            fallback = h

        { get: (p, h) -> add("GET", p, h),
          post: (p, h) -> add("POST", p, h),
          put: (p, h) -> add("PUT", p, h),
          patch: (p, h) -> add("PATCH", p, h),
          delete: (p, h) -> add("DELETE", p, h),
          head: (p, h) -> add("HEAD", p, h),
          options: (p, h) -> add("OPTIONS", p, h),
          any: (p, h) -> add("", p, h),
          notFound: setFallback,
          handle: handle }

    // The parts of a path, with the leading and trailing slashes gone. `/` is no parts at all, which is
    // what makes it match a route written `/` and nothing else.
    segments(path: string) -> array of string =
        var p = path
        var q = indexOf(p, "?")

        if q != null then p = p[0..<q]

        while startsWith(p, "/")
            p = p[1..<len(p)]

        while endsWith(p, "/") && p != ""
            p = p[0..<(len(p) - 1)]

        if p == "" then [] else split(p, "/")

    // Whether a route's parts fit a request's, and what its parameters bind to. `null` where they do not.
    //
    // **A `*name` takes the whole of the rest, slashes included**, which is what a file server needs and
    // is the one pattern that may match a different number of parts than it has.
    fit(parts: array of string, want: array of string) -> object | null =
        var out = {}
        var i = 0

        while i < len(parts)
            val p = parts[i]

            if startsWith(p, "*")
                val rest = p[1..<len(p)]

                if rest != "" then out[rest] = join(want[i..<len(want)], "/")

                return out

            if i >= len(want) then return null

            // **A `:name` is decoded AFTER the parts are cut, and that is right here where it is wrong
            // in `safePath`.** The two are different questions: the path is cut on the separators the
            // client actually wrote, so `%2f` is a character in a name and not a part boundary -- and
            // nothing is being judged, only handed to a handler. A handler that turns one of these into
            // a file name owes it the same reading `safePath` gives.
            if startsWith(p, ":")
                out[p[1..<len(p)]] = percentDecode(want[i], false)
            elif p != want[i]
                return null

            i = i + 1

        if len(want) != len(parts) then null else out

    // -- serving files ---------------------------------------------------------------------------------

    // `files(root)` -- a handler that answers what is under `root`, and nothing above it.
    //
    //     app.get("/assets/*rest", files("./public"))
    //     app.get("/*rest", files("./public", { index: "index.html", cacheControl: "max-age=300" }))
    //
    // **It answers a HANDLER rather than being one**, so the root is said once and the router decides
    // which paths reach it. A `*rest` parameter is what it reads where there is one, and `req.path`
    // otherwise -- so it also works as a whole server: `serve(3000, files("./public"))`.
    export files(root: string, options: object = {}) -> function =
        val index = if has(options, "index") then options.index else "index.html"
        val cache = if has(options, "cacheControl") then options.cacheControl else null

        // **The root is normalised ONCE, here, and not per request.** It is the thing every answer is
        // measured against, so working it out where it is said makes that measurement a comparison
        // rather than a second reading of the caller's text.
        val base = normalPath(root)

        async answerOne(req: object)
            val asked = if has(req.params, "rest") then req.params.rest else req.path
            val rel = safePath(asked)

            // **A path that climbs out is REFUSED and not sanitised**, which is `tar.sysl`'s rule for the
            // same attack: such a request is not a request with a mistake in it, and quietly rewriting
            // the name would hide what was attempted.
            if rel == null then return { status: 403, body: "Forbidden" }

            var path = normalPath(joinPath(base, rel))

            // The same refusal read off the whole path rather than off its parts.
            if !underRoot(base, path) then return { status: 403, body: "Forbidden" }

            var info = await stat(path)

            // A directory is its index file, where it has one and the caller wanted it.
            if info.ok && info.value.isDir && index != ""
                path = joinPath(path, index)
                info = await stat(path)

            // **A file that is not there and a path that is a directory answer the same 404**, on
            // purpose: telling a client which is which maps out a server's disk for it.
            if !info.ok || !info.value.isFile then return { status: 404, body: "Not Found" }

            val tag = etagOf(info.value)

            // **`ETag` and `If-None-Match`, and deliberately not `Last-Modified`.** A validator a client
            // never received is one it can never send, so the two are not both needed -- and the older
            // pair costs an HTTP date, which is a rendering in English of a moment in one zone. One
            // validator that is exact beats two where one is approximate to the second.
            if has(req.headers, "if-none-match") && req.headers["if-none-match"] == tag
                return { status: 304, headers: withCache({ ETag: tag }, cache), body: "" }

            val read = await readBytes(path)

            if !read.ok then return { status: 500, body: "Not Read" }

            var headers = withCache({ ETag: tag, "Content-Type": contentTypeOf(path) }, cache)

            { status: 200, headers: headers, body: read.value }

        answerOne

    // The size and the modification time, which change together and cheaply.
    //
    // **Not a hash of the contents.** Hashing a file on every request is what a static server exists not
    // to do, and size-and-time is what every server in the world uses for the same reason.
    etagOf(info: object) -> string = "\"" + string(info.size) + "-" + string(info.modified.epochMillis()) + "\""

    withCache(headers: object, cache: string | null) -> object =
        if cache == null then headers else headers with { "Cache-Control": cache }

    // The path under the root, or `null` where it does not stay under it.
    //
    // **EVERY PART IS DECODED BEFORE IT IS JUDGED, AND THAT ORDERING IS THE WHOLE OF THIS FUNCTION.**
    // Judging first and decoding afterwards is the same traversal with one more step in it: `%2e%2e` is
    // not `..` until it has been decoded, and `..%2f` is one part until it has. Both of those named a
    // file above the root and were answered `200`.
    //
    // What is refused, and every one of them is a refusal rather than a repair:
    //
    // - a part that DECODES to `..`, which is the climb itself;
    // - a decoded part carrying `/`, `\` or a NUL byte. An encoded separator is one part naming two,
    //   and a NUL is a name that stops early at the system call and not here;
    // - a `%` that is not followed by two hex digits. `percentDecode` reads that as a literal `%`,
    //   which is what a browser does and is right for something a person typed into a query string --
    //   and a path is the one place where guessing makes the guess a file name.
    //
    // An empty or `.` part is dropped, so `//a`, `/./a` and `a` are one path.
    safePath(p: string) -> string | null =
        var out = []

        for raw in split(p, "/")
            if !wellEscaped(raw) then return null

            val part = percentDecode(raw, false)

            if part == ".." then return null

            for b in toBytes(part)
                if b == 0 || b == 47 || b == 92 then return null

            if part != "" && part != "." then push(out, part)

        join(out, "/")

    // Whether every `%` in a part is followed by two hexadecimal digits.
    wellEscaped(s: string) -> boolean =
        if !contains(s, "%") then return true

        val bs = toBytes(s)
        var i = 0

        while i < len(bs)
            if bs[i] != 37
                i = i + 1
            elif i + 2 >= len(bs) || !hexDigit(bs[i + 1]) || !hexDigit(bs[i + 2])
                return false
            else
                i = i + 3

        true

    hexDigit(b: integer) -> boolean =
        (b >= 48 && b <= 57) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102)

    // A path with its empty and `.` parts gone and its `..` parts resolved against what stands to their
    // left.
    //
    // **It is worked out on the TEXT and never on the disk**, so it says what a name means and not what
    // the file system would make of it. A symlink inside the root that points outside it is followed
    // like any other file, which is the operator's choice to make -- nginx answers the same way.
    normalPath(p: string) -> string =
        val rooted = startsWith(p, "/")
        var out = []

        for part in split(p, "/")
            if part == "" || part == "."
                continue
            elif part == ".."
                if len(out) > 0 && out[len(out) - 1] != ".." then pop(out)
                elif !rooted then push(out, "..")
            else
                push(out, part)

        var text = join(out, "/")

        if rooted then text = "/" + text
        elif text == "" then text = "."

        text

    // Whether a normalised path is the root itself or something under it.
    //
    // **The second line rather than the first.** `safePath` has already refused everything that could
    // climb; this is what says so of the path that was actually built, so a future mistake in the part
    // rules is a `403` rather than a file.
    underRoot(base: string, path: string) -> boolean =
        if base == "/" then startsWith(path, "/")
        elif base == "." then !startsWith(path, "/") && !startsWith(path, "..")
        else path == base || startsWith(path, base + "/")

    joinPath(a: string, b: string) -> string =
        if b == "" then a
        elif endsWith(a, "/") then a + b
        else a + "/" + b

    // What is after the last `.` of the last segment, lowercased. Empty where there is none.
    extensionOf(path: string) -> string =
        var name = path
        var cut = lastIndexOf(name, "/")

        if cut != null then name = name[(cut + 1)..<len(name)]

        val dot = lastIndexOf(name, ".")

        if dot == null || dot == 0 then "" else lower(name[(dot + 1)..<len(name)])

    // **The types a program actually serves, and `application/octet-stream` for everything else.** A
    // complete table is a thousand lines that go out of date; what a browser needs to be told is the
    // handful where guessing wrongly breaks the page.
    contentTypeOf(path: string) -> string =
        val ext = extensionOf(path)

        if ext == "html" || ext == "htm" then "text/html; charset=utf-8"
        elif ext == "css" then "text/css; charset=utf-8"
        elif ext == "js" || ext == "mjs" then "text/javascript; charset=utf-8"
        elif ext == "json" then "application/json"
        elif ext == "map" then "application/json"
        elif ext == "txt" || ext == "md" then "text/plain; charset=utf-8"
        elif ext == "xml" then "application/xml"
        elif ext == "csv" then "text/csv; charset=utf-8"
        elif ext == "svg" then "image/svg+xml"
        elif ext == "png" then "image/png"
        elif ext == "jpg" || ext == "jpeg" then "image/jpeg"
        elif ext == "gif" then "image/gif"
        elif ext == "webp" then "image/webp"
        elif ext == "avif" then "image/avif"
        elif ext == "ico" then "image/x-icon"
        elif ext == "woff2" then "font/woff2"
        elif ext == "woff" then "font/woff"
        elif ext == "ttf" then "font/ttf"
        elif ext == "otf" then "font/otf"
        elif ext == "pdf" then "application/pdf"
        elif ext == "wasm" then "application/wasm"
        elif ext == "zip" then "application/zip"
        elif ext == "gz" then "application/gzip"
        elif ext == "mp4" then "video/mp4"
        elif ext == "webm" then "video/webm"
        elif ext == "mp3" then "audio/mpeg"
        elif ext == "wav" then "audio/wav"
        else "application/octet-stream"

    // Whether a body of this type is already compressed, so that brotli is not run over it to find out.
    //
    // **A static server would otherwise compress every image on every request and throw the answer
    // away**, the `len(small) >= len(raw)` check being what catches it -- correct, and paid for once per
    // request per file. These are the types where the answer is known in advance.
    alreadyPacked(type: string) -> boolean =
        ((startsWith(type, "image/") && !startsWith(type, "image/svg")) ||
            startsWith(type, "video/") || startsWith(type, "audio/") ||
            startsWith(type, "font/woff") || type == "application/zip" ||
            type == "application/gzip" || type == "application/pdf")
    """
