module dev.slatelang.slate

import sh.sysl.libuv
import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.from_utf8

// The file system, as promises.
//
// **Nothing here is new machinery, which is the point.** A file read is `sleep`'s shape with a
// different handle: claim a slot that roots a promise, hand libuv a closure capturing the slot's id,
// and settle the promise when the answer comes back. `await` was what needed the machine; this needed
// only the promises the machine already made possible.
//
// **Both forms are here, and the asynchronous one is the default.** Every call has a promise-shaped
// version under its plain name and a blocking one under a `Sync` suffix, which is node's arrangement
// and node's spelling.
//
// The plain names are asynchronous because a language whose whole event story is one loop has a lot
// to lose from a call that stops it: a server that blocks on a read stops answering everybody. The
// `Sync` forms exist because a great many programs are not servers. A script that reads a
// configuration file before it does anything, or whose entire job is three file operations in order,
// gains nothing from a promise and pays for it in `async` functions that exist only to hold an
// `await`.
//
// **The naming is what keeps this from being a trap**: the blocking call is the one with the longer
// name and the suffix, so reaching for it is a decision rather than an accident, and a reader can
// see which was written without checking anything.
//
// ## What the closure may capture, which is the one rule here
//
// **A `usize` and a `Span`, and nothing else.** The collector cannot see through an ARC box, so a
// closure holding a `Value` would hold it invisibly -- the same trap `event.sysl` describes for a
// timer's callback. An id indexes a table this program roots, and a `Span` is two integers. Both
// survive a collection because neither is in the collected heap at all.

// -- what a program calls --------------------------------------------------------------------------

// `readFile(path)` -- the whole of a file, as text.
//
// **The bytes are checked rather than assumed to be text.** A slate string is a sysl string and a
// sysl string is UTF-8, so handing over a file of arbitrary bytes would make a value whose every
// later operation is undefined. A program that wants bytes wants `readBytes`.
read_file_promise(path: string, at: Span) -> Step
    val id = begin_request()

    request_started(id, at, s"cannot read ${path}", libuv.read_file(path, (r) ->
        r match
            Err(e) -> refuse_request(id, at, s"cannot read ${path}", e)
            Ok(bytes) ->
                from_utf8(bytes) match
                    Ok(text) -> answer_request(id, str_value(text))
                    Err(_) -> deny_request(id, at, s"${path} is not text -- `readBytes` reads a file that is not")))
end read_file_promise

// `readBytes(path)` -- the whole of a file, as an array of numbers.
read_bytes_promise(path: string, at: Span) -> Step
    val id = begin_request()

    request_started(id, at, s"cannot read ${path}", libuv.read_file(path, (r) ->
        r match
            Err(e) -> refuse_request(id, at, s"cannot read ${path}", e)
            Ok(bytes) ->
                var items: Buf[Value] = buf()

                for i in 0..<bytes.len
                    items.push(Int(long(bytes[i])))

                answer_request(id, Array(new_array(items)))))
end read_bytes_promise

// `writeFile(path, text)` -- the whole of a file, replaced.
//
// **Composed here from open, write and close rather than taken from the binding**, which has a
// `write_file_sync` and no asynchronous whole-file write. Each step's callback carries only the id
// and the span, so the chain needs nothing rooted that the slot does not already root.
write_file_promise(path: string, text: string, at: Span) -> Step =
    put_file_promise(path, text, libuv.O_TRUNC, at)

// `appendFile(path, text)` -- the same, with the text added to what is there.
//
// **`O_APPEND` and not a read followed by a write**, which is what a program had to do without this:
// the kernel places the bytes at the end at the moment they are written, so two writers do not
// overwrite one another and nothing has to hold the whole file to add a line to it. A log is what
// this is for.
append_file_promise(path: string, text: string, at: Span) -> Step =
    put_file_promise(path, text, libuv.O_APPEND, at)

// The two of them, differing in one flag.
private put_file_promise(path: string, text: string, mode: int, at: Span) -> Step
    val id = begin_request()
    val what = s"cannot write ${path}"
    val flags = libuv.O_WRONLY | libuv.O_CREAT | mode

    request_started(id, at, what, libuv.open(path, (opened) ->
        opened match
            Err(e) -> refuse_request(id, at, what, e)
            Ok(f) ->
                request_continued(id, at, what, libuv.write(f, text.bytes, (written) ->
                    written match
                        Err(e) ->
                            libuv.close(f)
                            refuse_request(id, at, what, e)
                        Ok(n) ->
                            if n != text.bytes.len
                                libuv.close(f)
                                deny_request(id, at, s"${what}: only ${n} of ${text.bytes.len} bytes were taken")
                            else
                                // The file is closed either way, and the answer waits for it: a
                                // program that writes and then reads back would otherwise race its
                                // own close.
                                request_continued(id, at, what, libuv.close(f, (shut) ->
                                    shut match
                                        Err(e) -> refuse_request(id, at, what, e)
                                        Ok(_) -> answer_request(id, Null)))))
        , flags))
end put_file_promise

// `readDir(path)` -- the names in a directory, without `.` and `..`.
read_dir_promise(path: string, at: Span) -> Step
    val id = begin_request()
    val what = s"cannot list ${path}"

    request_started(id, at, what, libuv.scandir(path, (r) ->
        r match
            Err(e) -> refuse_request(id, at, what, e)
            Ok(entries) ->
                var items: Buf[Value] = buf()

                for i in 0..<entries.len
                    items.push(str_value(entries[i].name))

                answer_request(id, Array(new_array(items)))))
end read_dir_promise

// `stat(path)` -- what the file system knows about a path.
//
// An object rather than a handful of separate calls, since one trip through the thread pool answers
// all of it and a program asking whether something is a directory usually wants its size too.
stat_promise(path: string, at: Span) -> Step
    val id = begin_request()
    val what = s"cannot stat ${path}"

    request_started(id, at, what, libuv.stat(path, (r) ->
        r match
            Err(e) -> refuse_request(id, at, what, e)
            Ok(st) ->
                val mark = root_mark()
                val o = new_object()

                hold(Object(o))
                obj_put_name(o, "size", Int(long(st.size)))
                obj_put_name(o, "isFile", Bool(st.is_file()))
                obj_put_name(o, "isDir", Bool(st.is_dir()))
                // **The modification time, as an INSTANT.** A stat without one is not a stat: it is
                // what `Last-Modified` and every cache validator are made of, and slate could not
                // answer either without it. An instant and not a number, because that is the type
                // slate has for a point on the timeline -- `.at(zone)` reads it and `format` writes
                // it, and neither would work on a count of seconds.
                obj_put_name(o, "modified", InstantVal(st.mtime.seconds * 1000000 + st.mtime.nanos / 1000))
                release(mark)
                answer_request(id, Object(o))))
end stat_promise

// `exists(path)` -- whether a path is there at all.
//
// **A `stat` that failed is an answer rather than a fault**, which is the whole of what this adds
// over `stat`: asking whether something exists and being made to catch a failure to find out would
// be a question the language answered with an error.
exists_promise(path: string, at: Span) -> Step
    val id = begin_request()

    request_started(id, at, s"cannot reach ${path}", libuv.stat(path, (r) ->
        r match
            Err(_) -> answer_plain_request(id, Bool(false))
            Ok(_) -> answer_plain_request(id, Bool(true))))
end exists_promise

// `remove(path)` -- a file, not a directory.
remove_promise(path: string, at: Span) -> Step
    val id = begin_request()
    val what = s"cannot remove ${path}"

    request_started(id, at, what, libuv.unlink(path, (r) ->
        r match
            Err(e) -> refuse_request(id, at, what, e)
            Ok(_) -> answer_request(id, Null)))
end remove_promise

// `mkdir(path)` -- one directory, whose parent must be there.
mkdir_promise(path: string, at: Span) -> Step
    val id = begin_request()
    val what = s"cannot make ${path}"

    request_started(id, at, what, libuv.mkdir(path, (r) ->
        r match
            Err(e) -> refuse_request(id, at, what, e)
            Ok(_) -> answer_request(id, Null)))
end mkdir_promise

// `rmdir(path)` -- one directory, which must be empty.
rmdir_promise(path: string, at: Span) -> Step
    val id = begin_request()
    val what = s"cannot remove ${path}"

    request_started(id, at, what, libuv.rmdir(path, (r) ->
        r match
            Err(e) -> refuse_request(id, at, what, e)
            Ok(_) -> answer_request(id, Null)))
end rmdir_promise

// `rename(from, to)`.
rename_promise(from: string, to: string, at: Span) -> Step
    val id = begin_request()
    val what = s"cannot rename ${from}"

    request_started(id, at, what, libuv.rename(from, to, (r) ->
        r match
            Err(e) -> refuse_request(id, at, what, e)
            Ok(_) -> answer_request(id, Null)))
end rename_promise

// -- the same ten, blocking -------------------------------------------------------------------------

// **These need none of the machinery above**, which is the whole of why they are short. No slot, no
// promise, no closure and nothing rooted: the answer is already there when the call returns, so
// there is no window in which a collection could run and nothing for the collector to be told about.
// The asynchronous half is long because of what it takes to *wait* safely, not because of what a
// file system call is.

// `readFileSync(path)` -- the whole of a file, as text.
read_file_sync(path: string, at: Span) -> Step
    libuv.read_file_sync(path) match
        Err(e) -> Ok(err_value(s"cannot read ${path}: ${e}"))
        Ok(bytes) ->
            from_utf8(bytes) match
                Ok(text) -> Ok(ok_value(str_value(text)))
                Err(_) -> Ok(err_value(s"${path} is not text -- `readBytesSync` reads a file that is not"))

// `readBytesSync(path)` -- the whole of a file, as an array of numbers.
read_bytes_sync(path: string, at: Span) -> Step
    libuv.read_file_sync(path) match
        Err(e) -> Ok(err_value(s"cannot read ${path}: ${e}"))
        Ok(bytes) ->
            var items: Buf[Value] = buf()

            for i in 0..<bytes.len
                items.push(Int(long(bytes[i])))

            Ok(ok_value(Array(new_array(items))))

// `writeFileSync(path, text)` -- the whole of a file, replaced.
//
// **The binding has this one directly**, where the asynchronous half had to compose open, write and
// close because there is no asynchronous whole-file write.
write_file_sync(path: string, text: string, at: Span) -> Step
    libuv.write_file_sync(path, text.bytes) match
        Err(e) -> Ok(err_value(s"cannot write ${path}: ${e}"))
        Ok(_) -> Ok(ok_value(Null))

// `readDirSync(path)` -- the names in a directory, without `.` and `..`.
read_dir_sync(path: string, at: Span) -> Step
    libuv.scandir_sync(path) match
        Err(e) -> Ok(err_value(s"cannot list ${path}: ${e}"))
        Ok(entries) ->
            var items: Buf[Value] = buf()

            for i in 0..<entries.len
                items.push(str_value(entries[i].name))

            Ok(ok_value(Array(new_array(items))))

// `statSync(path)` -- what the file system knows about a path.
stat_sync(path: string, at: Span) -> Step
    libuv.stat_sync(path) match
        Err(e) -> Ok(err_value(s"cannot stat ${path}: ${e}"))
        Ok(st) ->
            val mark = root_mark()
            val o = new_object()

            hold(Object(o))
            obj_put_name(o, "size", Int(long(st.size)))
            obj_put_name(o, "isFile", Bool(st.is_file()))
            obj_put_name(o, "isDir", Bool(st.is_dir()))

            // The same instant the asynchronous one answers, and the note there says why it is one.
            obj_put_name(o, "modified", InstantVal(st.mtime.seconds * 1000000 + st.mtime.nanos / 1000))

            val wrapped = ok_value(Object(o))

            release(mark)
            Ok(wrapped)

// `existsSync(path)` -- whether a path is there at all, answered rather than raised.
exists_sync(path: string, at: Span) -> Step
    libuv.access_sync(path) match
        Err(_) -> Ok(Bool(false))
        Ok(_) -> Ok(Bool(true))

// `removeSync(path)` -- a file, not a directory.
remove_sync(path: string, at: Span) -> Step
    libuv.unlink_sync(path) match
        Err(e) -> Ok(err_value(s"cannot remove ${path}: ${e}"))
        Ok(_) -> Ok(ok_value(Null))

// `mkdirSync(path)` -- one directory, whose parent must be there.
mkdir_sync(path: string, at: Span) -> Step
    libuv.mkdir_sync(path) match
        Err(e) -> Ok(err_value(s"cannot make ${path}: ${e}"))
        Ok(_) -> Ok(ok_value(Null))

// `rmdirSync(path)` -- one directory, which must be empty.
rmdir_sync(path: string, at: Span) -> Step
    libuv.rmdir_sync(path) match
        Err(e) -> Ok(err_value(s"cannot remove ${path}: ${e}"))
        Ok(_) -> Ok(ok_value(Null))

// `renameSync(from, to)`.
rename_sync(from: string, to: string, at: Span) -> Step
    libuv.rename_sync(from, to) match
        Err(e) -> Ok(err_value(s"cannot rename ${from}: ${e}"))
        Ok(_) -> Ok(ok_value(Null))
