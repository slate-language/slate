module dev.slatelang.slate
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{read_bytes, remove_file, write_text}
import sysl.process.capture
import sysl.text.{Search, from_utf8_unchecked, str_builder}

// What the JavaScript back end owes, and the three sets that keep the answer honest.
//
// **A NATIVE IN NEITHER THE RUNTIME NOR THE `OWED` LIST IS SILENT**, and that is the failure this
// file exists to prevent. `jwsSign` was in neither for one release: a program that reached it died
// with `jwsSign is not defined`, a JavaScript sentence about a name slate is supposed to own, where
// what it should have heard is that the name is not built here yet.
//
// **A builtin is a PARAMETER of the emitted program now, which made a second half necessary.** The
// wrapper's parameters are `builtin_names()`, so a name that lives in `$b` and is not one of them is
// unreachable from any program -- nothing can call it and nothing can say anything about it. Before
// the scoping change every name in `$b` was installed onto `globalThis` and that could not happen.
//
// So the three sets are asked as two comparisons:
//
// - **`$b`'s own names and `builtin_names()` are the SAME SET.** One direction is "every native
//   either resolves in the runtime or is on the list", the list having been folded into `$b` by the
//   time a program runs; the other is "every name in `$b` is reachable".
// - **`OWED` is a SUBSET of `builtin_names()`.** A name on the list that is not a builtin is a
//   promise about something that does not exist -- most likely a rename that only happened on one
//   side.
//
// **The list is read off `$b.$owed` rather than out of this repo's text.** A `$`-prefixed name is
// one no slate program can write, and asking the runtime is what makes this a test of what was
// EMITTED rather than of what `js_rt_host.sysl` looks like.

// The two sets, read out of a program that has loaded and printed nothing of its own.
private owed_said() -> string
    val src = "tests/js-owed.tmp.sl"
    val out_js = src + ".js"

    write_text(src, "val nothing = 1\n").unwrap()

    val wrote = cli_status(["slate", "js", src, "-o", out_js])

    remove_file(src)

    if wrote != 0 then return s"`slate js` exited ${wrote}"

    val emitted = from_utf8_unchecked(read_bytes(out_js).unwrap())
    val probe =
        "console.log(\"--b\", Object.keys($b).filter((k) => !k.startsWith(\"$\")).sort().join(\" \"))\n" +
        "console.log(\"--o\", [...$b.$owed].sort().join(\" \"))\n"

    write_text(out_js, emitted + "\n" + probe).unwrap()

    val ran = capture("node", [out_js], "", [], true)

    remove_file(out_js)

    ran match
        Err(e) -> s"node could not be started: ${e}"
        Ok(o) -> if o.status.ok() then o.text.trim() else o.err.unwrap_or("").trim()
end owed_said

// The words of a line-and-space separated answer, which is all the parsing this needs.
private owed_words(text: string) -> Buf[string]
    var out: Buf[string] = buf()
    var word = str_builder()

    for i in 0..<text.bytes.len
        val c = text.bytes[i]

        if c == u8(' ') || c == u8('\n') || c == u8('\r')
            val w = word.finish()

            if w != "" then out.push(w)

            word = str_builder()
        else
            word.push_char(char(u32(c)))

    val last = word.finish()

    if last != "" then out.push(last)

    out
end owed_words

private owed_holds(names: Buf[string], name: string) -> bool
    for i in 0..<names.len()
        if names.at(i) == name then return true

    false

// The words after `--b` and the words after `--o`, which is how one run answers two questions.
private owed_after(words: Buf[string], marker: string) -> Buf[string]
    var out: Buf[string] = buf()
    var taking = false

    for i in 0..<words.len()
        val w = words.at(i)

        if w.starts_with("--")
            taking = w == marker
        elif taking
            out.push(w)

    out
end owed_after

@test
THE_NAMES_THE_EMITTED_RUNTIME_HAS_ARE_EXACTLY_THE_BUILTINS()
    val words = owed_words(owed_said())
    val theirs = owed_after(words, "--b")
    val ours = builtin_names()

    // A run that failed says so here rather than reporting two hundred missing names.
    assert(theirs.len() > 0)

    var missing = ""

    for i in 0..<ours.len()
        if !owed_holds(theirs, ours.at(i)) then missing = s"${missing}${ours.at(i)} "

    // **A builtin the runtime has no name for at all**, which is what `jwsSign` was: not built, not
    // on the list, and a JavaScript `is not defined` at the call.
    assert_eq(missing, "")

    var spare = ""

    for i in 0..<theirs.len()
        if !owed_holds(ours, theirs.at(i)) then spare = s"${spare}${theirs.at(i)} "

    // **A name in `$b` that no builtin claims**, which is unreachable from a program now that a
    // builtin is a parameter -- so it is either a name to declare in `natives.sysl` or one to
    // rename with a `$` in front, and either way nothing can use it as it stands.
    assert_eq(spare, "")

@test
EVERY_NAME_ON_THE_OWED_LIST_IS_A_BUILTIN_THAT_ACTUALLY_EXISTS()
    val words = owed_words(owed_said())
    val owed = owed_after(words, "--o")
    val ours = builtin_names()

    assert(owed.len() > 0)

    var unknown = ""

    for i in 0..<owed.len()
        if !owed_holds(ours, owed.at(i)) then unknown = s"${unknown}${owed.at(i)} "

    // **A promise about a name that does not exist**, which is what a rename on one side leaves
    // behind: the list still says the work is owed and nothing will ever reach it.
    assert_eq(unknown, "")

@test
A_NAME_ON_THE_OWED_LIST_SAYS_SO_WHEN_IT_IS_CALLED_RATHER_THAN_WHEN_IT_IS_NAMED()
    // **The stub is a FUNCTION**, so naming one succeeds and says nothing; what refuses is the call.
    // A test that only named one would pass against a runtime that had lost the list entirely.
    val named = "import { listen } from slate:net\nprint(listen)\n"

    assert_eq(node_said(named), "<function>")
    assert_eq(out(named), "<function>")
    assert(node_said("import { listen } from slate:net\nprint(listen(0))\n")
        .contains("`listen` is not in the JavaScript back end yet"))
