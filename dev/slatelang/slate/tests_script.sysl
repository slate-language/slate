module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// slate as a scripting language: a file the kernel can start, the arguments it was given, and the
// status it leaves behind.
//
// **These are the three things a `#!` line is worth having**, and none of them is about the language
// -- a shebang matters only to a file on a disk, arguments exist only because there was a command
// line, and a status is only ever read by whatever started the program. So nearly every test here
// goes in through `script_ran`, which writes a real file and drives the real `run_cli`: a helper
// built on a source made up in memory would be testing none of the three.
//
// **The lexer's own half is in `tests_syntax`**, where the rest of what a byte at the start of a
// line means already lives.

// -- a file the kernel can start --------------------------------------------------------------------

@test
a_shebang_line_is_not_part_of_the_program()
    val (status, said) = script_ran("#!/usr/bin/env slate\nprint(\"ran\")\n", [])

    assert_eq(said, "ran")
    assert_eq(status, 0)

@test
a_file_that_is_nothing_but_a_shebang_runs_and_says_nothing()
    // A script reduced to its first line is still a program, and an empty one.
    assert_eq(script_said("#!/usr/bin/env slate\n"), "")

    // And with no newline after it, which is what a file ending mid-line looks like.
    assert_eq(script_said("#!/usr/bin/env slate"), "")

@test
what_is_written_on_the_shebang_line_is_never_read()
    // **The line belongs to the kernel and slate does not parse it.** Anything at all may be written
    // there -- flags for the interpreter, a path with spaces in it, text that is not slate -- and it
    // reaches the program as nothing.
    assert_eq(script_said("#!/usr/bin/env -S slate --whatever\nprint(1)"), "1")
    assert_eq(script_said("#!/opt/homebrew/bin/slate\nprint(2)"), "2")

@test
the_line_after_a_shebang_is_still_line_two()
    // **The line is skipped and not removed**, which is the whole reason spans still work: every
    // byte after it is at the offset it really is at, so a complaint about the first statement says
    // line two and quotes the right text. Deleting the line instead would have shifted every
    // diagnostic in every script up by one.
    val (status, said) = script_ran("#!/usr/bin/env slate\nprint(nope)\n", [])

    assert(said.contains("`nope` is not defined"))
    assert(said.contains(":2:7"))
    assert_eq(status, 1)

@test
the_first_statement_after_a_shebang_opens_no_block()
    // The shebang is at column one and so is the line under it; a lexer that had counted the skipped
    // line as indentation would have opened a block here and complained about the line after.
    assert_eq(script_said("#!/usr/bin/env slate\nval a = 1\nval b = 2\nprint(a + b)"), "3")

// -- and only at the very beginning ------------------------------------------------------------------

@test
a_hash_bang_anywhere_but_the_first_byte_is_still_refused()
    // **`#` is not a comment in slate and this did not make it one.** The position is the whole of
    // the test, so the second line gets the message it always got.
    assert(fails("print(1)\n#!/usr/bin/env slate\n").contains("`#` is not a slate character"))

    // Including a second shebang under a real one, which is the case that would slip through a rule
    // written as "skip shebang lines" rather than "skip the first line if it is one".
    val (status, said) = script_ran("#!/usr/bin/env slate\n#!/usr/bin/env slate\nprint(1)\n", [])

    assert(said.contains("`#` is not a slate character"))
    assert_eq(status, 1)

@test
a_hash_that_is_not_followed_by_a_bang_is_refused_at_the_start_too()
    // Only `#!` is the kernel's mark. A lone `#` on the first line is a person writing a comment in
    // the wrong language, and the message says so rather than swallowing the line.
    assert(fails("# a comment\nprint(1)\n").contains("`#` is not a slate character"))

// -- what the script was asked to do ------------------------------------------------------------------

@test
a_script_with_no_arguments_has_an_empty_args()
    assert_eq(script_said("import { args } from slate:process\nprint(args.len())"), "0")
    assert_eq(script_said("import { args } from slate:process\nprint(args)"), "[]")

@test
args_holds_what_came_after_the_programs_name_in_order()
    val (status, said) = script_ran("import { args } from slate:process\nprint(args)", ["one", "two", "three"])

    assert_eq(said, "[\"one\", \"two\", \"three\"]")
    assert_eq(status, 0)

@test
the_programs_own_name_is_not_the_first_argument()
    // **Where this parts from C, node and Python, and it is deliberate.** Those three hand a program
    // its whole command line and every script begins by skipping past itself; slate is handed only
    // what came after, so `args[0]` is the first thing a person typed and `args.len()` is how many
    // things they typed.
    val (_, said) = script_ran("import { args } from slate:process\nprint(args[0])", ["first"])

    assert_eq(said, "first")

@test
a_flag_belongs_to_the_script_and_not_to_slate()
    // **slate reads nothing after the program's name**, which is what makes a script's own options
    // safe to invent: there is no flag slate could add later that would take one away.
    val (status, said) = script_ran("import { args } from slate:process\nprint(args)", ["--help", "-v", "--"])

    assert_eq(said, "[\"--help\", \"-v\", \"--\"]")
    assert_eq(status, 0)

@test
an_argument_is_a_string_and_goes_where_a_string_goes()
    val (_, said) = script_ran("import { args } from slate:process\nprint(upper(args[0]) + \"/\" + string(args.len()))", ["shout"])

    assert_eq(said, "SHOUT/1")

@test
args_is_a_value_and_calling_it_is_refused()
    // The mistake everybody who has written node makes once. The array names itself in the message,
    // which is what tells it apart from calling something that is not defined at all.
    val (status, said) = script_ran("import { args } from slate:process\nprint(args())", [])

    assert(said.contains("an array is not something that can be called"))
    assert_eq(status, 1)

@test
args_may_be_taken_apart_like_any_other_array()
    // It is an ordinary slate array, not a special form of one: everything an array can do, it does.
    val (_, said) = script_ran("import { args } from slate:process\nprint(join(sorted(args), \",\"))", ["c", "a", "b"])

    assert_eq(said, "a,b,c")

@test
args_must_be_imported_like_every_other_module_name()
    // It is in `slate:process` rather than a global, for the reason `run` is: `args` is an ordinary
    // word a script may want for its own.
    assert(fails("print(args)").contains("`args` is not defined"))

// -- and what it tells the shell afterwards ----------------------------------------------------------

@test
exit_hands_its_status_to_whatever_started_the_program()
    val (status, said) = script_ran("import { exit } from slate:process\nexit(3)", [])

    assert_eq(status, 3)
    assert_eq(said, "")

@test
exit_with_nothing_is_a_success()
    val (status, _) = script_ran("import { exit } from slate:process\nexit()", [])

    assert_eq(status, 0)

@test
a_program_that_says_nothing_about_a_status_still_answers_zero()
    val (status, said) = script_ran("print(\"fine\")", [])

    assert_eq(status, 0)
    assert_eq(said, "fine")

@test
everything_printed_before_an_exit_is_still_printed()
    // **The reason `exit` unwinds rather than calling the host's.** The driver collects what a
    // program printed and says it once the run is over, so a builtin that left the process where it
    // stood would take the answer with it -- a script that computes something, prints it and exits 1
    // would print nothing at all.
    val (status, said) = script_ran("import { exit } from slate:process\nprint(\"the answer\")\nprint(42)\nexit(1)", [])

    assert_eq(said, "the answer\n42")
    assert_eq(status, 1)

@test
nothing_after_an_exit_runs()
    val (status, said) = script_ran("import { exit } from slate:process\nprint(\"before\")\nexit(2)\nprint(\"after\")", [])

    assert_eq(said, "before")
    assert_eq(status, 2)

@test
exit_unwinds_out_of_the_call_that_made_it()
    val (status, said) = script_ran("import { exit } from slate:process\nstop() = exit(4)\nprint(\"before\")\nstop()\nprint(\"after\")", [])

    assert_eq(said, "before")
    assert_eq(status, 4)

@test
exit_is_not_something_a_try_may_catch()
    // **The reason it is its own signal rather than a fault with a special message.** `guarded`
    // matches `Fail` and only `Fail`, so a `try` between the `exit` and the top passes this straight
    // through: a library cannot swallow a script's decision to stop.
    val (status, said) = script_ran("import { exit } from slate:process\ntry\n    exit(7)\ncatch e\n    print(\"caught\")\nprint(\"after\")", [])

    assert_eq(said, "")
    assert_eq(status, 7)

@test
exit_works_from_inside_a_callback_the_loop_ran()
    // A script that decides to stop while waiting for something is the ordinary case, not an edge
    // one -- and the signal has to come out of the drain rather than out of the program's own
    // statements for it to work.
    val (status, said) = script_ran("import { exit } from slate:process\nsetTimeout(() -> exit(5), 1)\nprint(\"scheduled\")", [])

    assert_eq(said, "scheduled")
    assert_eq(status, 5)

@test
a_status_outside_a_bytes_worth_is_refused_rather_than_truncated()
    // **The one wrong answer a status can give.** A shell keeps the low eight bits of what it is
    // handed, so an unexamined `exit(256)` is a program that says it failed and is recorded as
    // having succeeded. Naming the range is the whole of the fix.
    val (status, said) = script_ran("import { exit } from slate:process\nexit(256)", [])

    assert(said.contains("a status is between 0 and 255, and this is 256"))
    assert_eq(status, 1)

    assert(script_said("import { exit } from slate:process\nexit(-1)").contains("a status is between 0 and 255, and this is -1"))

    // The two ends of the range are themselves fine.
    val (top, _) = script_ran("import { exit } from slate:process\nexit(255)", [])

    assert_eq(top, 255)

@test
exit_says_what_it_takes_when_it_is_given_something_else()
    // The checker has the signature -- one optional whole number -- so a string is refused before
    // the program runs at all.
    assert(script_said("import { exit } from slate:process\nexit(\"x\")").contains("`exit` takes integer here, and this is string"))

    // **The count is the checker's, and the native's own message is the backstop.** The signature
    // says nought-or-one, so a call giving two never runs -- which is why what comes back names the
    // range rather than the sentence in `do_exit`.
    assert(script_said("import { exit } from slate:process\nexit(1, 2)")
        .contains("`exit` takes from 0 to 1 argument and this gives it 2"))

@test
a_program_that_fails_still_leaves_with_one()
    // The status a script gets from slate itself, unchanged by any of this: a program that faults
    // says so and answers 1, and only `exit` puts anything else there.
    val (status, said) = script_ran("print(1 / 0)", [])

    assert(said.contains("divides by zero"))
    assert_eq(status, 1)

@test
a_test_may_not_stop_the_run_it_is_part_of()
    // **`exit` reaches `slate test` too, and there it is a complaint.** A `@test` asking to end the
    // process would take every test after it with it, so the signal that is a status everywhere else
    // is a diagnostic here -- and it names what was asked for rather than saying something went
    // wrong in the abstract.
    val said = test_verdict("import { exit } from slate:process\n@test\nt()\n    exit(9)\n", "t")

    assert(said.contains("`exit(9)` was called, and a test may not stop the run it is part of"))

    // **And it points at the `exit`, not at the top of the file.** That is the whole reason `Quit`
    // carries a span: the status is what the ordinary path reads, and the place is what the one path
    // that draws a diagnostic needs.
    assert(said.contains("t:4:5"))

@test
AN_ASYNC_TESTS_OWN_PROMISE_SURVIVES_THE_COLLECTIONS_ITS_DRAIN_CAUSES()
    // **A `Value` in a sysl local is not a root, and the runner kept one across the whole drain.**
    // `slate test` calls a test, takes the promise it answered, runs the loop until nothing is left,
    // and then reads the verdict off that promise. The collector walks the machine, the loop's slots
    // and the shadow stack -- not sysl's own variables -- so a collection anywhere in that drain
    // freed the promise and handed its memory to the next one allocated.
    //
    // **What it looks like is a test that ran to its last line being reported as never having
    // finished**, which is what a recycled promise says: a fresh one has not settled. It moves with
    // anything that allocates differently nearby, so it reads as a defect in whatever was under test
    // rather than in the runner -- it was found from `slate-language/pg`, whose suite it broke, and
    // it took a print statement in a branch that never ran to make it disappear.
    //
    // The test below allocates hard across nine suspensions, so the drain that reads its verdict is
    // one that has certainly collected.
    val said = test_verdict("churn()\n    var i = 0\n    var seen = 0\n\n    while i < 20000\n        val junk = { n: i, s: string(i) }\n        val soon = pending()\n\n        seen = seen + junk.n\n        i = i + 1\n\n@test\nasync THE_DRAIN_GOES_ON_AFTER_THIS_TEST_HAS_FINISHED()\n    setTimeout(churn, 1)\n    setTimeout(churn, 2)\n    setTimeout(churn, 3)\n\n    await sleep(0)\n\n    assert(true)\n", "THE_DRAIN_GOES_ON_AFTER_THIS_TEST_HAS_FINISHED")

    assert_eq(said, "")
