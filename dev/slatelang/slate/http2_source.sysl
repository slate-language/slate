module dev.slatelang.slate

// `slate:http`'s fourth piece: the same server, speaking HTTP/2.
//
// **One module, several blocks** -- see `http_write_source.sysl` for why. This one is separate as
// much for the reader as for the line count: HTTP/1.1 is a byte stream a state machine walks and
// HTTP/2 is a session frames go into and events come out of, and the two have almost no vocabulary
// in common. What they share is `shaped`, which reads a handler's answer, and the handler itself.
http2_source() -> string = raw"""
    // -- HTTP/2 -------------------------------------------------------------------------------------

    // The same server over HTTP/2, on a connection ALPN settled as `h2`.
    //
    // **THIS MODULE DRIVES THE PROTOCOL AND IMPLEMENTS NONE OF IT.** `slate:nghttp2` is bytes in,
    // bytes out and events in between; the socket stays here, which is exactly the arrangement the
    // HTTP/1.1 half has with llhttp. Nothing below writes a frame or reads one.
    //
    // **What a handler is given and what it may answer is unchanged**, and that is the whole feature:
    // a `Request` built here has the same fields one built from a `GET / HTTP/1.1` has, and the reply
    // goes through the same `shaped` -- so the same compression rule, the same header rules and the
    // same three body forms hold on both versions.
    //
    // **There is no keep-alive question and no pipelining question.** A connection carries many
    // streams at once and each is answered on its own, so the ordering machinery the 1.1 speaker
    // needs -- `busy`, the parser's queue, the `Connection` header -- has nothing to do here.
    speakH2(conn, called, streaming: boolean, first)
        // **`autoWindowUpdate: false` is not an option, it is the only working setting.** nghttp2
        // answers `INVALID_STATE` to `h2Consume` without it, and `h2Consume` is the call that returns
        // flow-control credit once the work is done rather than when the bytes land.
        val session = h2Server({ autoWindowUpdate: false })

        // What has arrived on each stream and is not yet a request. **Keyed by the stream number as
        // TEXT**, an object's keys being strings.
        var pending = {}

        var shut = false

        // Everything the session wants written, written. **Called after every receive and after every
        // response**, because a session may have frames of its own to send -- settings, window
        // updates, an acknowledgement -- that no handler asked for.
        //
        // **THE WRITE IS AWAITED AND ITS FAILURE IS THE CLIENT HAVING GONE.** An unawaited write is
        // a promise nobody holds, so once the peer is away its rejection is an orphan -- and an
        // orphaned rejection stops the program, which is the one thing a departed client may not be
        // able to do. That is the defect the 1.1 heartbeat had, and every site here had the same
        // shape: over a whole-body response the window is a moment and over an event stream it is
        // the life of the connection, but a moment is still a window.
        //
        // **So the failure is handled HERE rather than raised**, which is what lets a caller that
        // is not `async` -- the read callback, the drain loop -- go on calling it: this cannot
        // reject, so an unawaited call of it is not an orphan either. What a write failure means is
        // that there is nobody left to say anything to, so the connection ends.
        async flushed()
            if shut then return

            val out = h2Send(session)

            if len(out) == 0 then return

            try
                await send(conn, out)
            catch gone
                stop()

        stop()
            if shut then return

            shut = true

            h2Close(session)
            shutSocket(conn)

        // What a handler answered, as a HEADERS frame and a DATA frame on the stream that asked.
        //
        // **A HEADER NAME GOES OUT LOWERCASED.** An upper-case field name is malformed in HTTP/2 --
        // it is not a convention there, it is a connection error -- and a handler writing
        // `Content-Type` is writing what HTTP/1.1 taught it. The 1.1 speaker sends what it was given.
        //
        // **A defect in a handler is answered and then put back**, which is the 1.1 speaker's rule
        // and the reason is the same: the client is told, and the fault reaches the loop and stops
        // the program as any other fault would.
        async answer(stream: integer, req: object)
            // **Whether the failure came from WRITING the answer rather than from working it out**,
            // which is the same distinction `answer` draws on the 1.1 connection and `streamed`
            // draws mid-body. `h2Respond` answers an error for a stream the client has already
            // reset -- a cancelled fetch, a closed tab -- and `slate:nghttp2` raises that as a
            // fault; putting it back would let any client stop the server by giving up on a request
            // it had just made.
            var replying = false

            // **The whole of it is inside the `try`, and the refusal below is why.** A defect found
            // while reading the answer is a defect exactly as one raised while working it out is,
            // and a client that is told nothing waits forever.
            try
                val reply = await called(req)

                if shut then return

                val r = shaped(req, reply)

                var headers = [[":status", string(r.status)]]

                for [k, hv] in r.headers
                    push(headers, [lower(k), hv])

                // **A BODY THAT ARRIVES IN PIECES GOES OUT AS DATA FRAMES AS THEY ARRIVE.** The
                // head is sent at once and the frames follow, which is what an event stream needs
                // and is why `sh.sysl.nghttp2` 0.3.0 exists: until it had a data provider there was
                // nothing here to write a frame at a time with, and this refused the response
                // outright rather than draining a source that never ends.
                if r.source != null
                    replying = true

                    await sendStreamed(stream, r, headers)

                    return

                replying = true

                h2Respond(session, stream, headers, r.text ?? r.bytes)

                await flushed()
            catch e
                // The stream is gone: there is nobody to tell and nothing wrong with the program.
                if replying then return

                if !shut
                    // **Telling a client that has gone is not something to complain about**, which
                    // is `refuse`'s rule on the 1.1 connection. Without this a handler that faulted
                    // on a stream the client had already reset raised a SECOND fault here, from
                    // inside the `catch` -- and that one nothing was waiting for at all.
                    try
                        h2Respond(session, stream, [[":status", "500"]], "this request was not answered")

                        await flushed()
                    catch gone
                        val told = gone

                throw e

        // A response whose body arrives in pieces, as HEADERS and then a DATA frame per piece.
        //
        // **`streamed` on the 1.1 connection said in chunked framing; this says the same thing in
        // frames**, and every decision it made is made again here for the same reason -- which is
        // why the two read alike rather than sharing code they have almost no vocabulary in common
        // with. The head goes out before the source is asked for anything, because a source that
        // never ends would otherwise never let the `200` out.
        async sendStreamed(stream: integer, r: object, headers)
            h2RespondStream(session, stream, headers)

            await flushed()

            var beating = false
            var timer = null

            // **The heartbeat is a member of the response, not a guess from its content type**, and
            // over HTTP/2 it is one DATA frame like any other -- there is no chunk framing to get
            // wrong here, which was the 1.1 writer's first mistake.
            //
            // **A push that is refused ends the beating quietly.** The stream is gone, so there is
            // nobody to keep a connection open for; raising here would be a fault nothing awaits.
            async beat()
                if !beating then return

                val said = h2Push(session, stream, ": keep-alive\n\n")

                if said != null
                    beating = false

                    return

                await flushed()

                // **A beat that could not be written means there is nobody to keep a connection
                // open for**, so the beating stops. `flushed` has already ended the connection.
                if shut
                    beating = false

                    return

                if beating then timer = setTimeout(beat, r.heartbeat * 1000)

            if r.heartbeat > 0
                beating = true
                timer = setTimeout(beat, r.heartbeat * 1000)

            // **A source that faults is put back on the loop and a WRITE that fails is not**, which
            // is `streamed`'s rule and is what stops a client from ending the program by giving up
            // on a stream: the enclosing `try` in `answer` reads a failure as a client that has
            // gone, so a defect thrown from here would vanish into it. `sending` is true only
            // across the write.
            var sending = false

            try
                for await piece in r.source
                    // **The connection may have gone while the source was being asked**, which for
                    // a stream running over minutes is the ordinary end rather than a rare one: a
                    // refusal on the same connection, a GOAWAY, a client that hung up. The session
                    // is closed by then, so pushing into it would be a fault about a session where
                    // what happened is that nobody is listening.
                    if shut
                        beating = false

                        stopBeating(timer)

                        return

                    val part = framedH2(piece)

                    // **An empty piece is skipped**, as it is on the 1.1 connection. It says
                    // nothing there and would be a DATA frame carrying nothing here.
                    if part != null
                        sending = true

                        // **A refusal means the peer gave up on this stream** -- a cancelled fetch,
                        // a closed tab -- which `slate:nghttp2` answers rather than faults, the
                        // client going away being a condition and not a defect. There is nothing
                        // left to write to, so the response simply ends.
                        val said = h2Push(session, stream, part)

                        if said != null
                            sending = false
                            beating = false

                            stopBeating(timer)

                            return

                        await flushed()

                        sending = false
            catch e
                beating = false

                stopBeating(timer)

                if sending then throw e

                setTimeout(() -> putBack(e), 0)

                return

            beating = false

            stopBeating(timer)

            h2Finish(session, stream)

            await flushed()

        // A piece as `h2Push` takes it, or `null` where there is nothing in it.
        //
        // **No chunk framing, which is the whole difference from the 1.1 writer's `framed`**: a DATA
        // frame carries its own length, so a piece goes out as the bytes or the text it already is.
        framedH2(piece)
            if piece is array
                return if len(piece) == 0 then null else piece

            val text = if piece is string then piece else string(piece)

            if len(toBytes(text)) == 0 then null else text

        // Everything the peer did since the last read.
        //
        // **DRAINING AFTER THE READ IS ENOUGH HERE, AND A CLIENT'S IS NOT** -- which is worth stating
        // because the two look like the same loop and one of them stalls. nghttp2 queues an event
        // when it WRITES as much as when it reads, so a session whose stream ends on its own write
        // strands that event until the peer sends something else. What saves this one is not the
        // schedule but WHOSE HALF CLOSES LAST: a stream is not closed until both are, and the
        // server's own write can only be the second of the two if the client's half had already
        // closed -- which the server saw as `streamEnd`, on a read, and which is where the slot is
        // given back. The other order leaves the closing to an inbound END_STREAM or RST, also a
        // read. So there is no path on which a write completes a close while this table still holds
        // the stream.
        //
        // Measured rather than argued: six 1.2 MB uploads refused with a `413` on one connection,
        // and six ordinary requests on one connection, both with this table's size printed after
        // every drain. It goes to one and back to zero and never grows.
        //
        // **`docs/library/nghttp2.md` states the rule for a program writing its own client**, which
        // is where it bites: a client still uploading when its answer comes back ends its stream on
        // a write, and must drain again after writing or it waits for bytes that never come.
        drain()
            loop
                val e = h2Next(session)

                if e == null then break

                if e.kind == "headers" && e.of == "request"
                    // **A STREAMING SERVER IS HANDED THE REQUEST AT ITS HEADERS, NOT AT ITS END.**
                    // That is the whole of what `serveStream` is for: a handler that means to write
                    // a gigabyte to disk as it arrives cannot be given the gigabyte first. The
                    // frames that follow are delivered to the source below as they land, and the
                    // server holds none of them.
                    if streaming
                        val live = liveBody()

                        pending[string(e.stream)] = { live: live }

                        answer(e.stream, requestOfH2(e.headers, [], true, live))
                    else
                        pending[string(e.stream)] = { headers: e.headers, body: [] }
                elif e.kind == "data"
                    val key = string(e.stream)

                    if has(pending, key) && has(pending[key], "live")
                        pending[key].live.deliver(e.bytes)
                        h2Consume(session, e.stream, len(e.bytes))

                        continue

                    if has(pending, key)
                        val grown = concat(pending[key].body, e.bytes)

                        // **THE SAME BOUND THE 1.1 SERVER APPLIES, AND FOR THE SAME REASON.** A
                        // server that grows a buffer for as long as frames keep arriving is one
                        // connection away from being over, and `serve` has refused a body past
                        // `BodyBytes` with a `413` from the start -- while this path concatenated
                        // whatever arrived, so a client could hold a gigabyte in a server that
                        // refuses a megabyte over HTTP/1.1.
                        //
                        // **The answer goes out and the stream is NOT reset**, which was the first
                        // thing tried: an `h2Reset` on the same turn cancels the stream before its
                        // own response has left the session, so the client is told nothing at all --
                        // it sees `rstStream` where a `413` should have been. What arrives after
                        // this is consumed for its flow-control credit and dropped, which is what
                        // the 1.1 server does with a body it has already refused.
                        if len(grown) > BodyBytes
                            pending = forgotten(pending, key)

                            h2Respond(session, e.stream, [[":status", "413"]],
                                "the body is larger than " + string(BodyBytes) + " bytes")
                            h2Consume(session, e.stream, len(e.bytes))

                            continue

                        pending[key] = pending[key] with { body: grown }

                    // **Credit is returned when the work is done and not when the bytes land**, which
                    // is what a flow-control window is for: a server that acknowledged on arrival
                    // would be telling a client to keep sending while it was still reading the last
                    // lot. This is the call `autoWindowUpdate: false` exists for.
                    h2Consume(session, e.stream, len(e.bytes))
                elif e.kind == "streamEnd"
                    val key = string(e.stream)

                    if has(pending, key)
                        val held = pending[key]

                        pending = forgotten(pending, key)

                        // A streaming handler has been running since the headers arrived, so what
                        // the end of the stream means to it is that the body is complete.
                        if has(held, "live") then held.live.close()
                        else answer(e.stream, requestOfH2(held.headers, held.body, false, null))

                // **A STREAM THAT ENDS ANY OTHER WAY TAKES ITS PARTIAL BODY WITH IT.** Only
                // `streamEnd` used to clear a slot, so a client that reset a stream mid-upload --
                // a cancelled fetch, a browser tab closed, a timeout -- left the bytes it had sent
                // held for the life of the connection, and a client doing it repeatedly kept every
                // one of them.
                elif e.kind == "rstStream" || e.kind == "streamClose"
                    val key = string(e.stream)

                    // **A handler reading a body the peer abandoned has to be told it has ended**,
                    // or a `for await` over it waits for the rest of the run. What it sees is a
                    // truncated body, which is the only thing either version of HTTP can say once
                    // the request has stopped arriving.
                    if has(pending, key) && has(pending[key], "live") then pending[key].live.close()

                    pending = forgotten(pending, key)
                elif e.kind == "goaway"
                    stop()

                    return

        heard(chunk)
            if chunk == null
                stop()

                return

            // **Bytes the peer got wrong are an ANSWER and not a fault**, which is `slate:nghttp2`'s
            // rule: a peer that speaks nonsense is a condition a server handles, and the handling is
            // to say goodbye and hang up rather than to stop the program.
            val bad = h2Receive(session, chunk)

            if bad != null
                h2Goaway(session, 0)

                // **Not awaited, and it does not need to be**: `flushed` answers a write failure
                // itself, so there is no rejection for a caller to hold. The read callback is not
                // `async` and making it one would be a promise nothing awaits either.
                flushed()
                stop()

                return

            drain()

            flushed()

        onBytes(conn, heard)

        // **The server's own SETTINGS go out first.** A client is entitled to them and will wait.
        flushed()

        // The bytes that chose this speaker -- the client's preface and its first frames.
        heard(first)

    // The request a handler is given, out of an HTTP/2 header block and the body that followed it.
    //
    // **A HEADER BLOCK ARRIVES AS PAIRS AND THE OBJECT KEEPS THE LAST OF A REPEATED NAME**, which is
    // what `query` already does with a repeated field and is the same reasoning: an array where a
    // name repeats makes the type of `req.headers.x` depend on what a peer sent. Folding on the way
    // OUT is what request smuggling is made of; folding on the way in, having already framed the
    // request, is not.
    //
    // **`:authority` becomes `host`.** It is the same fact under HTTP/2's name, and a handler that
    // reads `req.headers.host` should not have to know which version it is being spoken to over.
    //
    // **A body that is not text is the empty string**, exactly as it is on the 1.1 path, where
    // llhttp's bytes go through the same conversion and the same `unwrap_or("")`.
    requestOfH2(pairs: array, bytes: array, streaming: boolean, live) -> object
        var method = "GET"
        var target = "/"
        var headers = {}

        for [name, value] in pairs
            if name == ":method"
                method = value
            elif name == ":path"
                target = value
            elif name == ":authority"
                headers["host"] = value
            elif name == "cookie" && has(headers, "cookie")
                // **RFC 9113 SS8.2.3: COOKIE FIELDS ARE JOINED WITH `"; "`.** HTTP/2 lets a client
                // split its cookies one per field so that each compresses on its own, and browsers
                // do -- so keeping the last of them, which is what every other repeated name gets
                // here, silently dropped all but one cookie from every such request. Joined, the
                // value is exactly what the same client sends over 1.1 and `parseCookies` reads it
                // unchanged.
                headers["cookie"] = headers["cookie"] + "; " + value
            elif !startsWith(name, ":")
                headers[name] = value

        val q = indexOf(target, "?")
        val path = if q == null then target else target[0..<q]
        val search = if q == null then "" else target[(q + 1)..<len(target)]

        val req = { method: method,
                    path: path,
                    search: search,
                    headers: headers,
                    query: parseQuery(search),
                    cookies: if has(headers, "cookie") then parseCookies(headers["cookie"]) else {},
                    params: {},
                    keepAlive: true,
                    upgrade: false }

        if streaming then return streamingRequest(req, live)

        val text = fromBytes(bytes)

        req with { body: if text.ok then text.value else "" }

    // A body that is still arriving: what DATA frames are delivered to, and what a handler reads.
    //
    // **Module level rather than inside `speakH2`, and the reason is one shadowed name.** The session
    // loop keeps its streams in a `pending` object, which is the very name the promise builtin goes by --
    // so a `pending()` written in there is a call of that object and is refused as one. Nothing here
    // reaches into the connection anyway: what a body needs is a place to put chunks and somebody to
    // give them to.
    //
    // **The push half only.** `next` is written over `each` in `streamingRequest`, exactly as the
    // 1.1 server writes it over its own -- a second reader reaching into this state would be a
    // second thing to keep in step with it.
    //
    // **Chunks that arrive before the handler asks are HELD rather than dropped**, because a
    // handler is an ordinary function and its first `await` is later than the frame that woke
    // it. What is not held is a body nobody ever asks for: `each` is what starts the delivery,
    // and a handler that never calls it leaves its chunks here until the stream closes.
    liveBody()
        var sink = null
        var held = []
        var total = 0
        var finished = false
        val ending = pending()

        val live = {}

        live.deliver = (chunk) ->
            total = total + len(chunk)

            if sink == null then push(held, chunk) else sink(chunk)

        // **The end is idempotent**, a stream ending and then closing being two events about one
        // body -- and a reset arrives instead of an end rather than after it.
        live.close = () ->
            if finished then return

            finished = true

            settle(ending, total)

        // `each` answers a promise for the number of bytes the body turned out to be, which is
        // the one number an upload handler usually wants.
        live.each = (f) ->
            sink = f

            for c in held
                f(c)

            held = []

            ending

        live

    // A streamed request over HTTP/2: the head, and the one way of asking for the rest.
    //
    // **The frames are handed over as they land**, which needed `sh.sysl.nghttp2`'s deferred/resume
    // path to exist -- until 0.3.0 the binding held a body whole and this delivered it in one chunk,
    // so a handler written to write a gigabyte to disk as it arrived got the gigabyte first.
    //
    // **`next` is written OVER `each` rather than beside it**, which is what the 1.1 server does and
    // for the same reason: the push half already knows about held chunks, the sink and the ending
    // promise, and a second reader reaching into that state would be a second thing to keep in step
    // with it. So this is an ordinary queue and one pending promise.
    streamingRequest(req: object, live: object) -> object
        var queue = []
        var waiting = null
        var started = false
        var finished = false

        // A chunk goes to whoever is already asking for one, and to the queue otherwise.
        deliver(c)
            if waiting == null
                push(queue, c)

                return

            val asked = waiting

            waiting = null

            settle(asked, { done: false, value: c })

        // **The end has to wake a waiting `next` as well as be remembered**, or a handler that asked
        // for one more chunk than the body had waits for the rest of the run.
        async endedAt(whole)
            await whole

            finished = true

            if waiting != null
                val asked = waiting

                waiting = null

                settle(asked, { done: true, value: null })

        val out = req with { each: live.each }

        out.next = () ->
            // **`each` drains what was held synchronously**, so the queue is checked after starting
            // rather than before: frames that arrived before the handler asked are in `queue` by the
            // time this line runs.
            if !started
                started = true

                endedAt(out.each(deliver))

            if len(queue) > 0 then return { done: false, value: shift(queue) }
            if finished then return { done: true, value: null }

            waiting = pending()

            waiting

        out

    // An object with one key gone. **A copy rather than a removal**, slate having no remover -- and a
    // stream table is small, being what is in flight rather than what has been.
    forgotten(o: object, key: string) -> object
        var out = {}

        for [k, v] in entries(o)
            if k != key then out[k] = v

        out
    """
