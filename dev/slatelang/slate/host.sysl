module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.Buf

// What the host this program is running on provides ITSELF.
//
// **`hostHas(name)` is not "is this feature available" -- it is "does the host hand me the thing, so
// that a module should use it rather than build one".** The two are different questions and only the
// second one a module can act on: the interpreter HAS a `fetch` and a compressor and it built both,
// so a module asking whether to reach for the host's would be told no and would be right.
//
// **It is declared into the scope a built-in module's source compiles in and not into a program's.**
// Which of two implementations answers is a module's business; what a program sees is one surface
// either way, and a name that let a program branch on its back end would be an invitation to write
// two programs. `natives.sysl` says the same thing where the name is declared.
//
// **The names are a FIXED SET and an unknown one is a fault**, because the alternative is a
// misspelling that answers false for ever and sends a module down the path it was trying to avoid.
// Both back ends carry the list and `tests_ws.sysl` pins that they carry the same one.

// The things a host can provide, in the order a reader meets them.
//
// **`websocket` is the only one that is true anywhere yet**, and it is the whole reason this exists:
// a browser has no socket at all and does have a WebSocket client, so `slate:ws` cannot reach its own
// framing there and must not pretend to. The other three are named now because `js_rt_host.sysl`
// already answers them and a list that grew one name at a time would be a list two files disagree
// about.
val HostThings: []const string = ["websocket", "compression", "fetch", "document"]

// `hostHas(name)` -- whether this host provides that thing itself.
//
// **The interpreter answers false to all four, and that is not a gap.** It speaks WebSocket over its
// own socket, compresses with miniz, fetches over OpenSSL and has no document at all; in every case
// what a module wants to know is whether to use somebody else's implementation, and here there is
// nobody else's to use.
do_host_has(args: Buf[Value], at: Span) -> Step
    wants(args, 1, at, "hostHas", "the name of a thing a host may provide")?

    val name = text_argument(args.at(0), at, "hostHas", "a name")?

    for i in 0..<HostThings.len
        if HostThings[i] == name then return Ok(Bool(false))

    fault(at, s"`${name}` is not something a host is asked for -- the names are ${listed(HostThings)}")
end do_host_has

// The names, written out the way a person lists things.
private listed(names: []const string) -> string
    var out = ""

    for i in 0..<names.len
        if i > 0 then out += if i == names.len - 1 then " and " else ", "

        out += s"`${names[i]}`"

    out
end listed

// What every one of the six WebSocket calls answers here.
//
// **Nothing reaches this in a working program**: `slate:ws` asks `hostHas("websocket")` first and
// takes its own path, which is the framing written in slate over `slate:net`. It refuses rather than
// answering nothing, because a declared name that quietly does nothing is the failure `OWED` exists
// to prevent, wearing a different hat.
no_host_socket(at: Span, name: string) -> Step =
    fault(at, s"`${name}` is the host's own WebSocket, and the interpreter has none -- it speaks the protocol itself over `slate:net`, which is what `hostHas(\"websocket\")` is asked in order to choose")
