module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// Sets and maps: what is in one, what counts as the same key, and what the checker may say about
// either.
//
// **Its own file rather than a section of `tests_lang.sysl`, because the KEY RULES are the subject.**
// The construction, the methods and the order are ordinary language tests; what is worth a file is
// that both kinds are the very table an object is, so a number and a real that are equal share a
// slot, two arrays written alike share one, and a class deciding its own `==` and `hash` decides
// which of its values are one member. `tests/js/p31.sl` is the differential corpus beside this.

// -- a set --------------------------------------------------------------------------------------

// **The whole of a set's surface**, and the order is the order things went in -- which is what a
// compact dict gives for nothing and is why `Set` is that table rather than a bucket array.
@test
A_SET_HOLDS_EACH_VALUE_ONCE_IN_THE_ORDER_IT_ARRIVED()
    val prog = raw"""
    val s = Set()

    s.add("b")
    s.add("a")
    s.add("b")

    print(s, s.size(), len(s), s.values())
    print(s.has("a"), s.has("z"))
    """

    assert_eq(out(prog), "[\"b\", \"a\"] 2 2 [\"b\", \"a\"]\ntrue false")
end A_SET_HOLDS_EACH_VALUE_ONCE_IN_THE_ORDER_IT_ARRIVED

// **`add` answers the set and `delete` answers whether there was one**, which is JavaScript's
// arrangement and is the one worth having: a chain of adds reads as building one set, and a delete
// that says nothing would leave a program asking `has` first every time.
@test
ADD_ANSWERS_THE_SET_AND_DELETE_ANSWERS_WHETHER_THERE_WAS_ONE()
    val prog = raw"""
    val s = Set().add(1).add(2).add(3)

    print(s)
    print(s.delete(2), s.delete(2), s)

    s.clear()

    print(s, s.size())
    """

    assert_eq(out(prog), "[1, 2, 3]\ntrue false [1, 3]\n[] 0")
end ADD_ANSWERS_THE_SET_AND_DELETE_ANSWERS_WHETHER_THERE_WAS_ONE

// A set is built from anything a `for` walks, and `Set(s)` copies one.
@test
A_SET_IS_BUILT_FROM_ANYTHING_A_FOR_LOOP_WALKS()
    val prog = raw"""
    print(Set([3, 1, 2, 3]))
    print(Set(0..<4))
    print(Set(Set([5, 6])))
    print(Set(Map([["a", 1]])))
    print(Set())
    """

    assert_eq(out(prog), "[3, 1, 2]\n[0, 1, 2, 3]\n[5, 6]\n[[\"a\", 1]]\n[]")
end A_SET_IS_BUILT_FROM_ANYTHING_A_FOR_LOOP_WALKS

// -- a map --------------------------------------------------------------------------------------

@test
A_MAP_KEEPS_THE_ORDER_A_KEY_WAS_FIRST_WRITTEN_IN()
    val prog = raw"""
    val m = Map()

    m.set("first", 1)
    m.set("second", 2)
    m.set("first", 10)

    print(m, m.size(), len(m))
    print(m.keys(), m.values(), m.entries())
    print(m.has("second"), m.delete("second"), m.has("second"), m)
    """

    assert_eq(out(prog), "[[\"first\", 10], [\"second\", 2]] 2 2\n" +
        "[\"first\", \"second\"] [10, 2] [[\"first\", 10], [\"second\", 2]]\n" +
        "true true false [[\"first\", 10]]")
end A_MAP_KEEPS_THE_ORDER_A_KEY_WAS_FIRST_WRITTEN_IN

// **`get` answers `null` for a key that is not there, and never `undefined`.** slate stores no
// absence anywhere, so a map handing one out would be the one hole in that rule -- and `has` is what
// tells a stored `null` from a missing key.
@test
GET_ANSWERS_NULL_FOR_A_KEY_THAT_IS_NOT_THERE()
    val prog = raw"""
    val m = Map()

    m.set("here", null)

    print(m.get("here"), m.get("gone"))
    print(m.has("here"), m.has("gone"))
    """

    assert_eq(out(prog), "null null\ntrue false")
end GET_ANSWERS_NULL_FOR_A_KEY_THAT_IS_NOT_THERE

@test
A_MAP_IS_BUILT_FROM_A_LIST_OF_PAIRS()
    val prog = raw"""
    print(Map([["a", 1], ["b", 2]]))
    print(Map(Map([["z", 9]])))
    print(Map([]))
    print(Map())
    """

    assert_eq(out(prog), "[[\"a\", 1], [\"b\", 2]]\n[[\"z\", 9]]\n[]\n[]")
end A_MAP_IS_BUILT_FROM_A_LIST_OF_PAIRS

// -- what counts as the same key ------------------------------------------------------------------

// **`1` and `1.0` are ONE key**, because `==` says they are equal. That is the rule `hash_plain`
// already had for an object's fields, and it is what a table keyed the host's way could not give:
// JavaScript's `Map` keys on SameValueZero and would make these two entries.
@test
AN_INTEGER_AND_AN_EQUAL_REAL_ARE_ONE_KEY()
    val prog = raw"""
    val m = Map()

    m.set(1, "integer")
    m.set(1.0, "real")

    print(m.size(), m.get(1), m.get(1.0))

    val s = Set()

    s.add(2)
    s.add(2.0)

    print(s.size())
    """

    assert_eq(out(prog), "1 real real\n1")
end AN_INTEGER_AND_AN_EQUAL_REAL_ARE_ONE_KEY

// A key is compared the way `==` compares it, so two arrays written alike are one key and `null` is
// a key like any other.
@test
A_KEY_IS_COMPARED_THE_WAY_EQUALS_COMPARES_IT()
    val prog = raw"""
    val s = Set()

    s.add([1, 2])
    s.add([1, 2])
    s.add([1, 3])

    print(s, s.size(), s.has([1, 2]))

    val m = Map()

    m.set(null, "absent nothing")
    m.set("null", "the word")

    print(m.size(), m.get(null), m.has(null))
    """

    assert_eq(out(prog), "[[1, 2], [1, 3]] 2 true\n2 absent nothing true")
end A_KEY_IS_COMPARED_THE_WAY_EQUALS_COMPARES_IT

// **A class that writes `==` should write `hash` beside it, and a set is where that matters.** The
// table finds a member by its hash and compares only then, so two equal values that hashed apart
// would never meet -- which is why `docs/reference/objects.md` says to write the pair.
@test
A_CLASS_WITH_ITS_OWN_EQUALITY_AND_HASH_DECIDES_ITS_OWN_MEMBERS()
    val prog = raw"""
    class Point
        var x
        var y

        ==(self, o) = o is Point && o.x == self.x && o.y == self.y
        hash(self) = self.x * 31 + self.y

    val s = Set()

    s.add(Point(1, 2))
    s.add(Point(1, 2))
    s.add(Point(3, 4))

    print(s.size(), s.has(Point(1, 2)), s.has(Point(9, 9)))

    val m = Map()

    m.set(Point(1, 2), "first")
    m.set(Point(1, 2), "written over")

    print(m.size(), m.get(Point(1, 2)))
    """

    assert_eq(out(prog), "2 true false\n1 written over")
end A_CLASS_WITH_ITS_OWN_EQUALITY_AND_HASH_DECIDES_ITS_OWN_MEMBERS

// **A `hash` that answers a constant still works**, which is what says the table compares as well as
// hashes: every member lands in one bucket and `==` is what separates them.
@test
A_HASH_THAT_COLLIDES_EVERYTHING_STILL_SEPARATES_BY_EQUALITY()
    val prog = raw"""
    class Tag
        var t

        ==(self, o) = o is Tag && o.t == self.t
        hash(self) = 1

    val s = Set()

    s.add(Tag("a"))
    s.add(Tag("b"))
    s.add(Tag("a"))

    print(s.size(), s.has(Tag("b")), s.has(Tag("c")))
    """

    assert_eq(out(prog), "2 true false")
end A_HASH_THAT_COLLIDES_EVERYTHING_STILL_SEPARATES_BY_EQUALITY

// **Two sets holding the same members are two sets.** A container that may change cannot compare by
// what is in it, or the answer would stop being true without either value being touched by the code
// that asked. `==` on a set and a map is identity, as it is on a promise and a function.
@test
A_SET_AND_A_MAP_COMPARE_BY_IDENTITY()
    val prog = raw"""
    val one = Set([1])
    val other = Set([1])

    print(one == one, one == other, one != other)

    val m = Map([["a", 1]])

    print(m == m, m == Map([["a", 1]]))

    val held = Set()

    held.add(one)

    print(held.has(one), held.has(other))
    """

    assert_eq(out(prog), "true false true\ntrue false\ntrue false")
end A_SET_AND_A_MAP_COMPARE_BY_IDENTITY

// -- walking one ----------------------------------------------------------------------------------

// A set yields its members and a map its pairs, which is what `...` spreads and what `forEach` is
// handed -- one answer to "what is in this" rather than three.
@test
A_FOR_LOOP_A_SPREAD_AND_FOREACH_ALL_YIELD_THE_SAME_THING()
    val prog = raw"""
    val s = Set([1, 2])
    val m = Map([["a", 1], ["b", 2]])

    for v in s
        print("member", v)

    for [k, v] in m
        print("pair", k, v)

    s.forEach((v) -> print("each", v))
    m.forEach((p) -> print("each", p))

    print([...s], [...m])
    print(...s)
    """

    assert_eq(out(prog), "member 1\nmember 2\npair a 1\npair b 2\neach 1\neach 2\n" +
        "each [\"a\", 1]\neach [\"b\", 2]\n[1, 2] [[\"a\", 1], [\"b\", 2]]\n1 2")
end A_FOR_LOOP_A_SPREAD_AND_FOREACH_ALL_YIELD_THE_SAME_THING

// **A removed entry leaves a tombstone in the table and a walk steps over it**, which is the one
// thing about a compact dict a walk has to know: positions do not shift, so the counter lands past
// the hole rather than on it.
@test
A_WALK_STEPS_OVER_WHAT_WAS_REMOVED()
    val prog = raw"""
    val s = Set([1, 2, 3, 4, 5])

    s.delete(1)
    s.delete(3)
    s.delete(5)

    for v in s
        print(v)

    print(s, s.size(), [...s])
    """

    assert_eq(out(prog), "2\n4\n[2, 4] 2 [2, 4]")
end A_WALK_STEPS_OVER_WHAT_WAS_REMOVED

// -- how each is written out ------------------------------------------------------------------------

// **A set prints as the array of its members and a map as the array of its pairs, and `toJSON`
// writes the same shape.** One rendering rather than two, so a value written out and read back is
// the same thing in both directions -- where JavaScript prints `Set(2) {1, 2}` and encodes `{}`.
@test
A_SET_AND_A_MAP_PRINT_AND_ENCODE_AS_ARRAYS()
    val prog = raw"""
    print(Set([1, 2]), Map([["a", 1]]))
    print(string(Set([1, 2])), string(Map([["a", 1]])))
    print(toJSON(Set([1, 2])), toJSON(Map([["a", 1], ["b", 2]])))
    print(toJSON(Set()), toJSON(Map()))
    print(Set([Set([1])]), Map([["m", Map([["n", 1]])]]))
    """

    assert_eq(out(prog), "[1, 2] [[\"a\", 1]]\n[1, 2] [[\"a\", 1]]\n[1,2] [[\"a\",1],[\"b\",2]]\n" +
        "[] []\n[[1]] [[\"m\", [[\"n\", 1]]]]")
end A_SET_AND_A_MAP_PRINT_AND_ENCODE_AS_ARRAYS

// A set that holds itself has no rendering that ends, and both the printer and the encoder say so
// rather than descending.
@test
A_SET_THAT_HOLDS_ITSELF_IS_NAMED_RATHER_THAN_WALKED()
    val prog = raw"""
    val s = Set()

    s.add(s)

    print(s)
    """

    assert_eq(out(prog), "[[...]]")
    assert(fails("val s = Set()\ns.add(s)\nprint(toJSON(s))\n").contains("this set holds itself"),
        "and there is no JSON for one")
end A_SET_THAT_HOLDS_ITSELF_IS_NAMED_RATHER_THAN_WALKED

// -- what a set and a map ARE ------------------------------------------------------------------------

@test
SET_AND_MAP_ARE_WORDS_A_PATTERN_IS_WRITTEN_WITH()
    val prog = raw"""
    val s = Set([1])
    val m = Map([["a", 1]])

    print(s is Set, s is Map, m is Map, m is Set, [1] is Set)

    kind(v) = match v
        Set -> "a set"
        Map -> "a map"
        _ -> "something else"

    print(kind(s), kind(m), kind(7))
    """

    assert_eq(out(prog), "true false true false false\na set a map something else")
end SET_AND_MAP_ARE_WORDS_A_PATTERN_IS_WRITTEN_WITH

// **`Set[T]` and `Map[K, V]` are tested member by member**, which is what makes them a claim the
// machine checks rather than a note to the checker -- `array of T` is the same arrangement, and it
// is why the checker is allowed to report a mismatch against one.
@test
A_MEMBER_TYPE_IS_TESTED_MEMBER_BY_MEMBER()
    val prog = raw"""
    print(Set([1, 2]) is Set[integer], Set([1, "x"]) is Set[integer], Set() is Set[string])
    print(Map([[1, "a"]]) is Map[integer, string], Map([[1, "a"]]) is Map[string, string])
    print(Map([["a", 1], ["b", "x"]]) is Map[string, integer])

    f(s: Set[string]) = s.size()

    print(f(Set(["a", "b"])))
    """

    assert_eq(out(prog), "true false true\ntrue false\nfalse\n2")
end A_MEMBER_TYPE_IS_TESTED_MEMBER_BY_MEMBER

// The run-time check is still there for a value the checker cannot see the type of, which is what an
// annotation on a parameter is for.
@test
A_MEMBER_TYPE_IS_REFUSED_AT_RUN_TIME_FOR_A_VALUE_NOBODY_TYPED()
    val prog = raw"""
    anything(v) = v

    f(s: Set[string]) = s.size()

    print(f(anything(Set([1, 2]))))
    """

    assert(fails(prog).contains("Set[string]"), "the annotation is quoted as it was written")
end A_MEMBER_TYPE_IS_REFUSED_AT_RUN_TIME_FOR_A_VALUE_NOBODY_TYPED

// A member pattern runs once per member, so a bare name in one would bind rather than test -- which
// is `array of T`'s rule and is refused in the same words.
@test
A_MEMBER_PATTERN_MAY_NOT_BIND()
    assert(fails("f(s: Set[thing]) = s\n").contains("is not a type"), "a set's member pattern")
    assert(fails("f(m: Map[string, thing]) = m\n").contains("is not a type"), "and a map's value pattern")
end A_MEMBER_PATTERN_MAY_NOT_BIND

// The bracket count is checked where it is written, there being no declaration to check it against.
@test
THE_NUMBER_OF_TYPES_IN_THE_BRACKETS_IS_CHECKED()
    assert(fails("f(s: Set[integer, string]) = s\n").contains("`Set` holds one kind of thing"),
        "a set takes one")
    assert(fails("f(m: Map[string]) = m\n").contains("`Map` takes a key type and a value type"),
        "and a map takes two")
end THE_NUMBER_OF_TYPES_IN_THE_BRACKETS_IS_CHECKED

// -- what each refuses ------------------------------------------------------------------------------

@test
A_CONSTRUCTOR_NAMES_WHAT_IT_WAS_GIVEN_INSTEAD()
    val walkable = "anything(v) = v\nprint(Set(anything(1)))\n"
    val loose = "anything(v) = v\nprint(Map(anything([1])))\n"
    val wide = "anything(v) = v\nprint(Map(anything([[\"a\", 1, 2]])))\n"
    val open = "anything(v) = v\nprint(Set(anything(1..)))\n"

    assert(fails(walkable).contains("`Set` takes an array, a range, a generator, a set or a map, and this is an integer"),
        "a set is built from something walkable")
    assert(fails(loose).contains("`Map` reads a list of pairs, and one of these is an integer"),
        "a map is built from pairs")
    assert(fails(wide).contains("one of these has 3 values rather than a key and a value"),
        "and a pair is exactly two")
    assert(fails(open).contains("needs a range with both ends"), "a range with an open end never finishes")
end A_CONSTRUCTOR_NAMES_WHAT_IT_WAS_GIVEN_INSTEAD

@test
A_METHOD_OF_THE_WRONG_KIND_AND_THE_WRONG_ARITY_ARE_BOTH_REFUSED()
    val many = "anything(v) = v\nval s = Set()\nprint(anything(s).add(1, 2))\n"
    val wrong = "print(Set().get(\"a\"))\n"
    val notAMap = "anything(v) = v\nprint(anything(Set()).get(\"a\"))\n"

    assert(fails(many).contains("`add` takes a set and a value, and was given 3 arguments"),
        "the receiver counts as one of them")
    assert(fails(wrong).contains("`get` is not something a set can do"), "and the checker says so first")
    assert(fails(notAMap).contains("`get` is not something a set can do"), "as does the machine")
end A_METHOD_OF_THE_WRONG_KIND_AND_THE_WRONG_ARITY_ARE_BOTH_REFUSED

// `undefined` may not be stored in a set or a map, which is the rule every other container already
// has -- and each position says which one it was.
@test
UNDEFINED_MAY_NOT_BE_PUT_IN_A_SET_OR_A_MAP()
    assert(fails("val s = Set()\ns.add({}.nope)\n").contains("cannot be put in a set"), "a member")
    assert(fails("val m = Map()\nm.set({}.nope, 1)\n").contains("cannot be a map key"), "a key")
    assert(fails("val m = Map()\nm.set(\"a\", {}.nope)\n").contains("cannot be put in a map"), "a value")
end UNDEFINED_MAY_NOT_BE_PUT_IN_A_SET_OR_A_MAP

// -- what the CHECKER may say ------------------------------------------------------------------------

// **A DECLARED annotation is a promise the program made, so it is held to it.** The element type is
// read off the constructor where the argument says one, and `Set()` says nothing -- which is the
// direction this pass is allowed to be wrong in.
@test
THE_CHECKER_REPORTS_A_MEMBER_TYPE_AGAINST_A_DECLARED_ANNOTATION()
    assert(fails("val s: Set[string] = Set([1, 2, 3])\n").contains("declared Set[string], and this is Set[integer]"),
        "a set whose members disagree with its declaration")
    assert_eq(fails("val s: Set[string] = Set([\"a\"])\n"), "")
    assert_eq(fails("val s: Set[string] = Set()\n"), "")
    assert_eq(fails("val m: Map[string, integer] = Map([[\"a\", 1]])\n"), "")
end THE_CHECKER_REPORTS_A_MEMBER_TYPE_AGAINST_A_DECLARED_ANNOTATION

// **And says nothing where nobody wrote a type**, which is the whole of the pass's rule: the machine
// takes any key at all, so an inference sharp enough to refuse one of these would be refusing a
// program that runs.
@test
THE_CHECKER_SAYS_NOTHING_ABOUT_A_SET_NOBODY_DECLARED()
    assert_eq(fails("val s = Set([1, 2])\ns.add(\"x\")\n"), "")
    assert_eq(fails("val m = Map([[\"a\", 1]])\nm.set(1, 2)\n"), "")
    assert_eq(fails("val s: Set[string] = Set([\"a\"])\ns.add(1)\n"), "")
    assert_eq(fails("f(s) = s.add(1)\nprint(f(Set()))\n"), "")
end THE_CHECKER_SAYS_NOTHING_ABOUT_A_SET_NOBODY_DECLARED

// **The five things a `Set` may be built from are what the machine accepts**, so the signature says
// `any` rather than `array`: a parameter type narrower than the machine's would refuse `Set(0..<3)`,
// which runs.
@test
THE_CHECKER_ACCEPTS_EVERY_ARGUMENT_THE_MACHINE_ACCEPTS()
    assert_eq(fails("print(Set(0..<3))\n"), "")
    assert_eq(fails("print(Set(Set([1])))\n"), "")
    assert_eq(fails("g() = yield 1\nprint(Set(g()))\n"), "")
    assert_eq(fails("print(Map(Map([[\"a\", 1]])))\n"), "")
end THE_CHECKER_ACCEPTS_EVERY_ARGUMENT_THE_MACHINE_ACCEPTS

// **A method's signature is read off the free function only where the two are the SAME native.**
// `s.has(v)` is a set's own and the global `has` takes an object and a key, so reading that
// signature here would refuse a program that runs -- which is what `global_native` is compared for.
@test
A_METHOD_IS_NOT_CHECKED_AGAINST_A_GLOBAL_OF_THE_SAME_NAME()
    assert_eq(fails("val s = Set([1])\nprint(s.has(1))\n"), "")
    assert_eq(fails("val m = Map([[1, 2]])\nprint(m.has(1), m.get(1), m.keys(), m.values(), m.entries())\n"), "")
    assert_eq(fails("val m = Map()\nprint(m.set(1, 2))\n"), "")

    // And `len` IS the same native on both sides, so its signature still applies.
    assert_eq(fails("val s = Set([1])\nprint(s.len() + 1)\n"), "")
end A_METHOD_IS_NOT_CHECKED_AGAINST_A_GLOBAL_OF_THE_SAME_NAME

// `mismatch` names the entry that does not fit rather than the collection, which is the path an
// object pattern already builds.
@test
A_MISMATCH_NAMES_THE_MEMBER_THAT_DOES_NOT_FIT()
    val prog = raw"""
    type Names = Set[string]

    val bad = Set(["a", 2])

    for problem in Names.mismatch(bad)
        print(problem.path, problem.wanted, problem.got)
    """

    assert_eq(out(prog), "2 string integer")
end A_MISMATCH_NAMES_THE_MEMBER_THAT_DOES_NOT_FIT
