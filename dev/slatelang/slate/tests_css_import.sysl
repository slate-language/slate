module dev.slatelang.slate
@tests

import sh.sysl.libuv
import sh.sysl.parsing.*
import sysl.text.Search

// A stylesheet's relative `@import`, inlined by the loader (`css_import.sysl`).
//
// **Every fixture is a real file under `tests/assets/cssimport/`**, because what is being tested is
// a path resolved against the importing STYLESHEET -- which only a tree of files can show. The program
// importing them is a string, named as though it sat in that directory.

private val Dir: string = "tests/assets/cssimport"

// What a program written beside the fixtures printed, or its complaint.
private beside(program: string) -> string
    val r = run(source(s"${Dir}/probe.sl", program.bytes))

    if r.ok() then r.printed() else r.render()

// The text a stylesheet arrives as once its imports are inlined, trimmed.
private inlined(file: string) -> string = beside(s"import s from \"./${file}\"\nprint(s.trim())\n")

// The complaint importing a stylesheet draws: it must name the CSS file and the place in it.
private refused(file: string, at: string, says: string)
    val said = beside(s"import s from \"./${file}\"\nprint(s)\n")

    assert(said.contains(says), said)
    assert(said.contains(s"--> ${Dir}/${at}"), said)

// -- what is inlined --------------------------------------------------------------------------------

@test
A_RELATIVE_import_IS_REPLACED_BY_THE_FILE_IT_NAMES()
    assert_eq(inlined("plain.css"), ".base { color: red; }\n\n.plain {}")

@test
AN_INLINED_FILE_HAS_ITS_OWN_IMPORTS_INLINED_RELATIVE_TO_ITSELF()
    // `deep.css` imports `mid/mid.css`, which imports `../leaf.css` -- resolved against `mid/`.
    assert_eq(inlined("deep.css"), ".leaf {}\n\n.mid {}\n\n.deep {}")

@test
A_PARENT_PATH_IN_SINGLE_QUOTES_IS_RESOLVED_AGAINST_THE_IMPORTING_SHEET()
    assert_eq(inlined("sub/up.css"), ".base { color: red; }\n\n.up {}")

@test
EVERY_url_FORM_IS_INLINED_QUOTED_OR_NOT_IN_ANY_CASE()
    assert_eq(inlined("urls.css"), ".one {}\n\n.two {}\n\n.three {}\n\n.four {}")

@test
A_MEDIA_CONDITION_BECOMES_A_media_BLOCK()
    assert_eq(inlined("media.css"), "@media print {\n.base { color: red; }\n}")

@test
A_LAYER_NAMED_OR_ANONYMOUS_BECOMES_A_layer_BLOCK()
    assert_eq(inlined("layer.css"), "@layer theme {\n.base { color: red; }\n}\n@layer {\n.leaf {}\n}")

@test
A_SUPPORTS_CONDITION_AND_A_MEDIA_LIST_BECOME_TWO_NESTED_BLOCKS()
    assert_eq(inlined("supports.css"),
        "@supports (display: grid) {\n@media screen and (min-width: 600px) {\n.base { color: red; }\n}\n}")

@test
A_SUPPORTS_CONDITION_ALONE_KEEPS_ITS_PARENTHESES()
    assert_eq(inlined("supports_only.css"), "@supports (not (display: grid)) {\n.one {}\n}")

@test
A_CHARSET_AND_A_LAYER_STATEMENT_MAY_COME_BEFORE_AN_INLINED_import()
    assert_eq(inlined("preamble.css"), "@charset \"utf-8\";\n@layer a, b;\n.base { color: red; }")

@test
A_FILE_IMPORTED_TWICE_IN_ONE_TREE_IS_INLINED_ONCE_WHERE_IT_IS_FIRST_MET()
    // `dedupe.css` imports `base.css`, then `plain.css`, which imports `base.css` again.
    assert_eq(inlined("dedupe.css"), ".base { color: red; }\n\n\n.plain {}\n\n.d {}")

@test
A_FILE_IMPORTED_TWICE_UNDER_DIFFERENT_CONDITIONS_IS_INLINED_UNDER_BOTH()
    assert_eq(inlined("dedupe_media.css"), ".base { color: red; }\n\n@media print {\n.base { color: red; }\n}")

// -- what is left alone -----------------------------------------------------------------------------

@test
AN_ABSOLUTE_A_SCHEME_RELATIVE_A_ROOT_AND_A_BARE_import_ARE_LEFT_AS_WRITTEN()
    assert_eq(inlined("kept.css"),
        "@import \"https://example.com/x.css\";\n@import url(//cdn.example.com/y.css);\n@import \"/root.css\";\n@import \"plain.css\";\n.kept {}")

@test
AN_import_INSIDE_A_COMMENT_IS_THE_COMMENT()
    assert_eq(inlined("comment.css"), "/* @import \"./base.css\"; */\n.c {}")

@test
AN_import_INSIDE_A_STRING_IS_THE_STRING_ESCAPED_QUOTES_INCLUDED()
    assert_eq(inlined("string.css"),
        ".s::before { content: '@import \"./base.css\";'; }\n.t::before { content: \"\\\"; @import './base.css';\"; }")

@test
AN_INLINED_FILE_MAY_KEEP_AN_ABSOLUTE_import_WHERE_IT_STILL_COMES_FIRST()
    assert_eq(inlined("keptfirst.css"), "@import \"https://example.com/x.css\";\n.h {}\n\n.k {}")

@test
A_FILE_NOT_ENDING_IN_css_IS_NOT_SCANNED()
    // The rule is about stylesheets: an HTML file holding the same line arrives exactly as written.
    assert_eq(beside("import s from \"./notes.txt\"\nprint(s.trim())\n"), "not a stylesheet")

// -- what is refused, against the CSS file and the `@import` in it ----------------------------------

@test
A_MISSING_FILE_IS_REFUSED_NAMING_BOTH_STYLESHEETS_AT_THE_import()
    refused("missing.css", "missing.css:2:3",
        s"cannot read `${Dir}/nowhere.css`, which `${Dir}/missing.css` imports")

@test
A_MISSING_FILE_TWO_LEVELS_DOWN_IS_REPORTED_IN_THE_FILE_THAT_ASKED_FOR_IT()
    refused("missing_deep.css", "missing.css:2:3", s"which `${Dir}/missing.css` imports")

@test
A_CYCLE_IS_REFUSED_NAMING_THE_CHAIN()
    refused("cyc_a.css", "cyc_b.css:1:1",
        s"this `@import` closes a circle: `${Dir}/cyc_a.css` imports `${Dir}/cyc_b.css` imports `${Dir}/cyc_a.css`")

@test
AN_import_OF_A_FILE_THAT_IS_NOT_A_STYLESHEET_IS_REFUSED()
    refused("notcss.css", "notcss.css:1:1", "`./notes.txt` is not a stylesheet")

@test
AN_import_AFTER_A_RULE_IS_REFUSED_RATHER_THAN_APPLIED()
    // A browser ignores it, so inlining it would apply rules that never applied.
    refused("late.css", "late.css:2:1", "an `@import` after a rule is ignored by a browser")

@test
A_LAYER_WITH_A_CONDITION_IS_REFUSED_RATHER_THAN_REWRITTEN()
    refused("layer_media.css", "layer_media.css:1:1", "names a layer and a condition")

@test
AN_ABSOLUTE_import_AN_INLINED_FILE_KEEPS_IS_REFUSED_WHERE_IT_WOULD_LAND_AFTER_RULES()
    refused("keptlate.css", "haskept.css:1:1", "where a browser ignores it")

@test
A_REFUSED_BARE_STYLESHEET_IS_REFUSED_BEFORE_THE_PROGRAM_RUNS()
    val said = beside("import \"./cyc_a.css\"\nprint(\"ran\")\n")

    assert(said.contains("closes a circle"), said)
    assert(!said.contains("ran\n"), said)

// -- every consumer sees the inlined text -----------------------------------------------------------

@test
A_BARE_IMPORT_PUTS_THE_INLINED_TEXT_IN_sheets()
    assert_eq(ran_out(s"${Dir}/sheet.sl"), "1\n.base { color: red; }\n\n.plain {}")

@test
THE_JAVASCRIPT_BACK_END_CARRIES_THE_SAME_INLINED_TEXT()
    // `node_said` writes its probe into `tests/`, so the specifiers are relative to that.
    val probe = "import s from \"./assets/cssimport/supports.css\"\nimport \"./assets/cssimport/plain.css\"\nimport { sheets } from slate:style\nprint(s.trim())\nprint(sheets()[0].trim())\n"

    assert_eq(node_said(probe),
        "@supports (display: grid) {\n@media screen and (min-width: 600px) {\n.base { color: red; }\n}\n}\n.base { color: red; }\n\n.plain {}")

@test
THE_JAVASCRIPT_BACK_END_REFUSES_WHAT_THE_INTERPRETER_REFUSES()
    // The refusal is the loader's, so `slate js` draws it in the same sentence at the same place.
    val said = cli_said(["slate", "js", s"${Dir}/cycle.sl"])

    assert(said.contains("closes a circle"), said)
    assert(said.contains(s"--> ${Dir}/cyc_b.css:1:1"), said)
    assert(cli_status(["slate", "js", s"${Dir}/cycle.sl"]) != 0, said)

@test
A_BUNDLE_CARRIES_THE_INLINED_TEXT_AND_NEEDS_NONE_OF_THE_FILES_IT_CAME_FROM()
    val dir = libuv.mkdtemp_sync("/tmp/slate-bundle-cssimport-XXXXXX").unwrap()
    val made = s"${dir}/sheet"

    assert_eq(cli_status(["slate", "bundle", s"${Dir}/sheet.sl", "-o", made]), 0)

    val said = ran_out(made)
    val js = cli_said(["slate", "js", made])

    scrub(dir)
    assert_eq(said, "1\n.base { color: red; }\n\n.plain {}")
    assert(js.contains(".base { color: red; }"), js)
    assert(!js.contains("@import"), js)
