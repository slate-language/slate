module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.text.{str_builder, StrBuilder}

// Walking the tree.
//
// **Everything that is not ordinary completion travels in the error channel, and that is the one
// design decision this file turns on.** A tree-walking interpreter has to carry four things upward
// out of a nested expression -- a `return`, a `break`, a `continue`, and a runtime fault -- and the
// usual shape for it is a five-armed `Outcome` enum matched at every one of the fifty places a
// sub-expression is evaluated.
//
// Modelling them as `Result[Value, Signal]` instead makes `?` do all of it. Every propagation site
// is `eval(x, env)?`, the four unwinding cases are indistinguishable to the code they pass through --
// which is exactly right, since none of them is that code's business -- and the two places that
// *do* care catch them: a loop stops at `Brk`, a call stops at `Ret`.

// Why a walk stopped early.
//
// The names avoid `Break`, `Continue` and `Return`, which `StmtKind` and `Tok` already have. Two
// enums may share a variant name and the expected type picks between them, but a reader should not
// have to work out which `Break` is meant.
enum Signal
    // A `return` on its way out of a call.
    Ret(v: Value)

    Brk
    Cont

    // Something the program did that it may not.
    Fail(at: Span, message: string)
end Signal

// What every step of the walk answers with.
type Step = Result[Value, Signal]

// A fault at a place, as the error channel wants it.
//
// Not `private`: `private` in sysl is private to the *file*, and `builtin.sysl` complains too.
fault(at: Span, message: string) -> Step = Err(Fail(at, message))

// -- entry point --------------------------------------------------------------------------------

// What running a program answers with.
struct Ran
    value: Value
    report: Report

    // The lines the program printed, in order.
    output: &Buf[string]

    ok(self) -> bool = !self.report.has_errors()

    // Everything printed, joined by newlines -- which is what a test compares against.
    printed(self) -> string
        var out = str_builder()

        for i in 0..<self.output.len()
            if i > 0 then out.push_char('\n')

            out.push(self.output.at(i))

        out.finish()
    end printed
end Ran

// Read a source and run it.
//
// **A program with a single mistake in it is not run at all.** The parser reports everything it
// found in one pass, and running a tree that has `Bad` nodes in it would produce a second, worse
// account of the same file.
// **Every run starts by emptying the heap**, which finalizes whatever the last one left reachable
// and clears the shadow stack. Without it a program's strings and buffers would survive its own end,
// and the interpreter's state is module storage -- see `obj.sysl` for why the collector forces that.
run(src: Source) -> Ran
    reset_heap()
    output.clear()

    val parsed = parse(src)

    if !parsed.ok() then return Ran(Nil, parsed.report, output)

    // The root scope is held for the whole run: everything a program can still reach hangs off it.
    var env = new_env(null)

    hold_env(env)
    install_builtins(env)

    var rep = parsed.report

    exec_block(parsed.program.stmts, env) match
        Ok(v) -> Ran(v, rep, output)
        Err(s) ->
            rep.add(error(signal_span(s), signal_message(s)))
            Ran(Nil, rep, output)
end run

// Where to point at a signal that escaped to the top.
signal_span(s: Signal) -> Span = s match
    Fail(at, _) -> at
    _ -> point(0)

signal_message(s: Signal) -> string = s match
    Fail(_, m) -> m
    Ret(_) -> "`return` outside a function"
    Brk -> "`break` outside a loop"
    Cont -> "`continue` outside a loop"

// -- statements ---------------------------------------------------------------------------------

// A run of statements, whose value is the last one's.
//
// **A block's value is its trailing expression**, which is sysl's rule and slate's. A block ending
// in something that is not an expression is `nil`, exactly as one ending in a `while` would be.
exec_block(stmts: Buf[Stmt], env: *EnvObj) -> Step
    val mark = root_mark()
    var last: Value = Nil

    for i in 0..<stmts.len()
        // **The one point a collection may happen.** Everything live is either in the scope chain or
        // on the shadow stack by now, which is what makes it safe here and nowhere else.
        maybe_collect()

        // A full heap is reported where there is a line to point at. The allocator has no idea which
        // statement it was serving, so it raises a flag and this is what reads it.
        if heap_exhausted
            release(mark)
            return fault(stmts.at(i).span, "this program has run out of memory")

        last = exec_stmt(stmts.at(i), env)?

        // The block's value has to survive the next statement's collection, and nothing else does.
        release(mark)
        hold(last)

    release(mark)
    Ok(last)
end exec_block

private exec_stmt(s: Stmt, env: *EnvObj) -> Step
    *s.kind match
        Val(name, init) -> declare_binding(env, name, init, false)
        Var(name, init) -> declare_binding(env, name, init, true)
        Eval(e) -> eval(e, env)
        Return(value) ->
            // The annotation says which `Nil` this is: `Tok` has one too, and a bare `return`
            // supplies nothing else on this line to pick from.
            val v: Value = value match
                Some(e) -> eval(e, env)?
                None -> Nil

            Err(Ret(v))
        Break -> Err(Brk)
        Continue -> Err(Cont)
        Assign(target, value) -> assign_to(target, value, env, s.span)
        Def(name, params, body) -> define(env, name, params, body)
        While(cond, body) -> run_while(cond, body, env)
        For(name, iter, body) -> run_for(name, iter, body, env, s.span)
        Loop(body) -> run_loop(body, env)
end exec_stmt

// `val x = e` and `var x = e`.
private declare_binding(env: *EnvObj, name: string, init: Expr, assignable: bool) -> Step
    val v = eval(init, env)?

    declare(env, name, v, assignable)
    Ok(Nil)
end declare_binding

// A named function.
//
// **The name is bound before the closure is built, so the body can see it.** That is the whole of
// what makes a named function recursive and a lambda not: the closure captures the scope, and the
// scope already holds the name by the time anything calls it.
private define(env: *EnvObj, name: string, params: Buf[string], body: usize) -> Step
    declare(env, name, Nil, false)
    declare(env, name, Fn(new_closure(params, body, env)), false)
    Ok(Nil)
end define

// `x = e`, `o.f = e`, `xs[i] = e`.
private assign_to(target: Expr, value: Expr, env: *EnvObj, at: Span) -> Step
    val v = eval(value, env)?

    *target.kind match
        Name(n) ->
            assign_name(env, n, v) match
                Written -> Ok(Nil)
                Immutable -> fault(target.span, s"`${n}` is a `val`, so it is written once")
                Unknown -> fault(target.span, s"`${n}` is not defined")
        Field(obj, name) ->
            eval(obj, env)? match
                Object(fields) ->
                    obj_put_name(fields, name, v)
                    Ok(Nil)
                other -> fault(target.span, s"a field belongs to an object, and this is ${other.type_name()}")
        Index(target_expr, key) ->
            val container = eval(target_expr, env)?
            val k = eval(key, env)?

            store_at(container, k, v, target.span)
        _ -> fault(at, "this cannot be assigned to")
end assign_to

// Writing through `xs[i]` and `o[k]`.
store_at(container: Value, k: Value, v: Value, at: Span) -> Step
    container match
        Array(items) ->
            k match
                Int(i) ->
                    if i < 0 || usize(i) >= items.items.len()
                        return fault(at, s"the index ${i} is outside an array of ${items.items.len()}")

                    items.items.set(usize(i), v)
                    Ok(Nil)
                other -> fault(at, s"an array is indexed by an integer, and this is ${other.type_name()}")
        Object(fields) ->
            k match
                _ -> obj_put(fields, k, v, at)
        other -> fault(at, s"${other.type_name()} cannot be indexed")
end store_at

// -- loops --------------------------------------------------------------------------------------

// **A loop is where two of the four signals stop travelling.** `Brk` ends it and `Cont` starts the
// next turn; `Ret` and `Fail` are none of a loop's business and keep going up, which is what makes
// `return` from inside two nested loops work with nothing written for it.
private run_while(cond: Expr, body: Expr, env: *EnvObj) -> Step
    loop
        if !eval(cond, env)?.truthy() then break

        turn(body, env)? match
            Brk -> break
            _ -> ()

    Ok(Nil)
end run_while

private run_loop(body: Expr, env: *EnvObj) -> Step
    loop
        turn(body, env)? match
            Brk -> break
            _ -> ()

    Ok(Nil)
end run_loop

private run_for(name: string, iter: Expr, body: Expr, env: *EnvObj, at: Span) -> Step
    val mark = root_mark()
    val subject = eval(iter, env)?

    hold(subject)

    subject match
        Array(items) ->
            for i in 0..<items.items.len()
                val scope = new_env(env)

                declare(scope, name, items.items.at(i), false)

                turn_in(body, scope)? match
                    Brk -> break
                    _ -> ()

            Ok(Nil)
        other -> fault(at, s"`for` walks an array, and this is ${other.type_name()}")
end run_for

// One turn of a loop, in a scope of its own, answering which of `break` and `continue` it ended on.
//
// **`Brk` and `Cont` are caught here and everything else is re-raised**, which is why the loops
// above are three lines each. The `Ok(Cont)` and `Ok(Brk)` it answers with are not values a program
// can see -- they are this file talking to itself.
private turn(body: Expr, env: *EnvObj) -> Result[Signal, Signal] = turn_in(body, new_env(env))

private turn_in(body: Expr, scope: *EnvObj) -> Result[Signal, Signal]
    val emark = env_mark()

    hold_env(scope)

    val answer = turn_body(body, scope)

    release_env(emark)
    answer
end turn_in

private turn_body(body: Expr, scope: *EnvObj) -> Result[Signal, Signal]
    eval(body, scope) match
        Ok(_) -> Ok(Cont)
        Err(Brk) -> Ok(Brk)
        Err(Cont) -> Ok(Cont)
        Err(other) -> Err(other)
end turn_body

// -- expressions --------------------------------------------------------------------------------

eval(e: Expr, env: *EnvObj) -> Step
    *e.kind match
        IntLit(v) -> Ok(Int(v))
        RealLit(v) -> Ok(Real(v))
        StrLit(v) -> Ok(str_value(v))
        BoolLit(v) -> Ok(Bool(v))
        NilLit -> Ok(Nil)
        Name(n) ->
            lookup(env, n) match
                Some(v) -> Ok(v)
                None -> fault(e.span, s"`${n}` is not defined")
        Unary(op, rhs) -> unary(op, eval(rhs, env)?, e.span)
        Binary(op, lhs, rhs) -> binary(op, lhs, rhs, env, e.span)
        Call(callee, args) -> do_call(callee, args, env, e.span)
        Index(target, key) -> read_at(eval(target, env)?, eval(key, env)?, e.span)
        Field(target, name) -> read_field(eval(target, env)?, name, e.span)
        ArrayLit(items) ->
            var out: Buf[Value] = buf()

            for i in 0..<items.len()
                out.push(eval(items.at(i), env)?)

            Ok(Array(new_array(out)))
        ObjectLit(keys, values) ->
            val o = new_object()
            val mark = root_mark()

            hold(Object(o))

            for i in 0..<keys.len()
                obj_put_name(o, keys.at(i), eval(values.at(i), env)?)

            release(mark)
            Ok(Object(o))
        Lambda(params, body) -> Ok(Fn(new_closure(params, body, env)))
        IfExpr(cond, then_branch, else_branch) ->
            if eval(cond, env)?.truthy()
                eval(then_branch, new_env(env))
            else
                else_branch match
                    Some(b) -> eval(b, new_env(env))
                    None -> Ok(Nil)
        MatchExpr(subject, arms) -> run_match(subject, arms, env, e.span)
        Block(stmts) -> run_block_scope(stmts, env)
        Bad -> fault(e.span, "this part of the program did not parse")
end eval

// Not `private`: `private` in sysl is private to the *file*, and the machine in `vm.sysl` runs the
// same operators the walker ran.
unary(op: Tok, v: Value, at: Span) -> Step
    op match
        Minus ->
            v match
                Int(n) -> Ok(Int(-n))
                Real(n) -> Ok(Real(-n))
                other -> fault(at, s"`-` needs a number, and this is ${other.type_name()}")
        Bang -> Ok(Bool(!v.truthy()))
        _ -> fault(at, "this is not a prefix operator")
end unary

// **`&&` and `||` take their right-hand side unevaluated**, which is why they are here rather than
// among the arithmetic: short-circuiting is the whole point of them, and an operator whose operands
// are both evaluated first cannot do it.
//
// They answer the operand that decided, not a boolean -- `a || b` is `a` where `a` is truthy and `b`
// otherwise. That is what nearly every dynamically typed language does, and it is the one place
// slate's rule is not sysl's: sysl's operands are `bool` and there is nothing else for it to give
// back.
binary(op: Tok, lhs: Expr, rhs: Expr, env: *EnvObj, at: Span) -> Step
    if op == AndAnd
        val a = eval(lhs, env)?

        return if a.truthy() then eval(rhs, env) else Ok(a)
    end if

    if op == OrOr
        val a = eval(lhs, env)?

        return if a.truthy() then Ok(a) else eval(rhs, env)
    end if

    val a = eval(lhs, env)?
    val b = eval(rhs, env)?

    on_values(op, a, b, at)
end binary

// The half of `binary` that works on operands already evaluated.
//
// **The machine reaches this and not `binary`**, because short-circuiting is a compile-time question
// there: `&&` becomes a jump that keeps the operand that decided, so by the time an operator runs
// both sides are values. Sharing the arithmetic rather than rewriting it is what stops the machine
// and the walker drifting apart while both exist.
on_values(op: Tok, a: Value, b: Value, at: Span) -> Step = op match
    EqEq -> Ok(Bool(same(a, b, at)?))
    BangEq -> Ok(Bool(!same(a, b, at)?))
    _ -> arith(op, a, b, at)

// -- arithmetic and comparison ------------------------------------------------------------------

// **A real and an integer meet as reals**, which is the promotion every language with both takes,
// and `+` on two strings joins them. Everything else is a fault naming both sides.
private arith(op: Tok, a: Value, b: Value, at: Span) -> Step
    if op == Plus
        a match
            Str(x) ->
                b match
                    Str(y) -> return Ok(str_value(x.s + y.s))
                    _ -> ()
            _ -> ()
    end if

    if is_number(a) && is_number(b)
        if is_int(a) && is_int(b) then return int_arith(op, as_int(a), as_int(b), at)

        return real_arith(op, as_real(a), as_real(b), at)
    end if

    // Ordering strings is worth having and is not arithmetic, so it is tested after the numbers.
    a match
        Str(x) ->
            b match
                Str(y) -> return compare_str(op, x.s, y.s, at)
                _ -> ()
        _ -> ()

    fault(at, s"`${op_text(op)}` does not apply to ${a.type_name()} and ${b.type_name()}")
end arith

private int_arith(op: Tok, x: long, y: long, at: Span) -> Step
    op match
        Plus -> Ok(Int(x + y))
        Minus -> Ok(Int(x - y))
        Star -> Ok(Int(x * y))
        Slash ->
            if y == 0 then fault(at, "this divides by zero") else Ok(Int(x / y))
        Percent ->
            if y == 0 then fault(at, "this takes a remainder by zero") else Ok(Int(x % y))
        Lt -> Ok(Bool(x < y))
        LtEq -> Ok(Bool(x <= y))
        Gt -> Ok(Bool(x > y))
        GtEq -> Ok(Bool(x >= y))
        _ -> fault(at, "this is not an arithmetic operator")
end int_arith

private real_arith(op: Tok, x: real, y: real, at: Span) -> Step
    op match
        Plus -> Ok(Real(x + y))
        Minus -> Ok(Real(x - y))
        Star -> Ok(Real(x * y))
        Slash -> Ok(Real(x / y))
        Percent -> fault(at, "a remainder is taken of integers")
        Lt -> Ok(Bool(x < y))
        LtEq -> Ok(Bool(x <= y))
        Gt -> Ok(Bool(x > y))
        GtEq -> Ok(Bool(x >= y))
        _ -> fault(at, "this is not an arithmetic operator")
end real_arith

private compare_str(op: Tok, x: string, y: string, at: Span) -> Step
    op match
        Lt -> Ok(Bool(x < y))
        LtEq -> Ok(Bool(x <= y))
        Gt -> Ok(Bool(x > y))
        GtEq -> Ok(Bool(x >= y))
        _ -> fault(at, s"`${op_text(op)}` does not apply to two strings")
end compare_str

private is_number(v: Value) -> bool = v match
    Int(_) -> true
    Real(_) -> true
    _ -> false

private is_int(v: Value) -> bool = v match
    Int(_) -> true
    _ -> false

private as_int(v: Value) -> long = v match
    Int(n) -> n
    _ -> 0

private as_real(v: Value) -> real = v match
    Int(n) -> real(n)
    Real(n) -> n
    _ -> 0.0

// Two containers whose comparison is already underway, one frame or more above.
struct SeenPair
    a: *u8
    b: *u8

// Whether this exact pairing is already being compared further up the walk.
private in_progress(seen: *Buf[SeenPair], a: *u8, b: *u8) -> bool
    for i in 0..<seen.len()
        val p = seen.at(i)

        if p.a == a && p.b == b then return true

    false
end in_progress

// Whether a value equals a literal written in a pattern.
//
// **A pattern does not consult an object's `equals`, and that is deliberate.** A literal pattern is a
// shape test: `5 -> ...` asks whether the subject *is* five, not whether something has been persuaded
// to say it is. Keeping hooks out of it also keeps `match_pattern` infallible, so an arm cannot fault
// halfway through binding.
private same_literal(v: Value, lit: Value) -> bool = v match
    Nil -> lit match
        Nil -> true
        _ -> false
    Bool(x) -> lit match
        Bool(y) -> x == y
        _ -> false
    Int(x) -> lit match
        Int(y) -> x == y
        Real(y) -> real(x) == y
        _ -> false
    Real(x) -> lit match
        Int(y) -> x == real(y)
        Real(y) -> x == y
        _ -> false
    _ -> false

// Whether two values are the same.
//
// **Deep for arrays and objects rather than by identity**, which is the choice Python makes and
// JavaScript does not. It is the one a person expects of `[1, 2] == [1, 2]`.
//
// **A cyclic pair answers `true` on re-entry rather than descending forever**, which is the
// coinductive rule: assume the pairing holds unless something below it proves otherwise. A set of
// single values cannot express that, because what is being asked is whether *this* value equals
// *that* one -- so the record is of pairs. Without it `b == c` over two self-referential arrays
// descends until the stack is gone, and sysl reports that as a bare SIGSEGV (card 0299).
same(a: Value, b: Value, at: Span) -> Result[bool, Signal]
    var seen: Buf[SeenPair] = buf()

    same_in(a, b, &seen, at)

// **The left side's `equals` decides, and only the left side's**, which is Java's rule for
// `a.equals(b)`. Consulting both and disagreeing has no answer, and consulting the right side when
// the left declined would make `==` non-obvious to read.
//
// A hook makes `==` run arbitrary slate code, so a lookup re-enters the interpreter and a bad
// `equals` can fault or loop. Java lives with exactly this.
private same_in(a: Value, b: Value, seen: *Buf[SeenPair], at: Span) -> Result[bool, Signal]
    hook_of(a, "equals") match
        Some(f) ->
            var args: Buf[Value] = buf()

            args.push(b)
            return Ok(apply(f, args, at)?.truthy())
        None -> ()

    same_plain(a, b, seen, at)
end same_in

private same_plain(a: Value, b: Value, seen: *Buf[SeenPair], at: Span) -> Result[bool, Signal]
    a match
        Nil -> b match
            Nil -> Ok(true)
            _ -> Ok(false)
        Bool(x) -> b match
            Bool(y) -> Ok(x == y)
            _ -> Ok(false)
        Str(x) -> b match
            // **`x == y` here would compare the two `*StrObj` POINTERS**, which is identity and not
            // equality -- and it compiles, because pointers do compare. Moving a string from a value
            // into the collected heap turned a structural comparison into an identity one silently,
            // and fourteen tests caught it. Go has the same distinction and answers it the same way.
            Str(y) -> Ok(x.s == y.s)
            _ -> Ok(false)
        Int(x) -> b match
            Int(y) -> Ok(x == y)
            Real(y) -> Ok(real(x) == y)
            _ -> Ok(false)
        Real(x) -> b match
            Int(y) -> Ok(x == real(y))
            Real(y) -> Ok(x == y)
            _ -> Ok(false)
        Array(xs) -> b match
            Array(ys) -> same_array(xs, ys, seen, at)
            _ -> Ok(false)
        Object(xs) -> b match
            Object(ys) -> same_object(xs, ys, seen, at)
            _ -> Ok(false)
        Fn(_) -> Ok(false)
        Native(x) -> b match
            Native(y) -> Ok(x == y)
            _ -> Ok(false)
end same_plain

// **Identity first, and it is not only an optimisation.** `a == a` over a structure that reaches
// itself is the commonest way to meet a cycle, and answering it by walking would visit every node
// to prove what the address already settled.
//
// **A pairing left on `seen` by a failing comparison is never consulted again**, which is why only
// the true path pops: a `false` propagates straight out of every frame above it, so the walk that
// would have read a stale entry does not happen.
private same_array(xs: *ArrayObj, ys: *ArrayObj, seen: *Buf[SeenPair], at: Span) -> Result[bool, Signal]
    val ax: *u8 = ptr_cast(xs)
    val ay: *u8 = ptr_cast(ys)

    if ax == ay then return Ok(true)
    if in_progress(seen, ax, ay) then return Ok(true)
    if xs.items.len() != ys.items.len() then return Ok(false)

    seen.push(SeenPair(ax, ay))

    for i in 0..<xs.items.len()
        if !same_in(xs.items.at(i), ys.items.at(i), seen, at)? then return Ok(false)

    seen.truncate(seen.len() - 1)
    Ok(true)
end same_array

private same_object(xs: *ObjectObj, ys: *ObjectObj, seen: *Buf[SeenPair], at: Span) -> Result[bool, Signal]
    val ax: *u8 = ptr_cast(xs)
    val ay: *u8 = ptr_cast(ys)

    if ax == ay then return Ok(true)
    if in_progress(seen, ax, ay) then return Ok(true)
    if xs.live != ys.live then return Ok(false)

    seen.push(SeenPair(ax, ay))

    // **Order is not compared, only contents** -- an object that gained its fields in another order
    // is the same object. `hash_object` sums its fields for exactly this reason: an order-sensitive
    // mix would hash these two differently and lose one of them in its own table.
    for i in 0..<xs.entries.len()
        val e = xs.entries.at(i)

        if !e.dead
            obj_get(ys, e.key, at)? match
                Some(v) -> if !same_in(e.value, v, seen, at)? then return Ok(false)
                None -> return Ok(false)

    seen.truncate(seen.len() - 1)
    Ok(true)
end same_object

// -- reading ------------------------------------------------------------------------------------

read_at(container: Value, k: Value, at: Span) -> Step
    container match
        Array(items) ->
            k match
                Int(i) ->
                    if i < 0 || usize(i) >= items.items.len()
                        return fault(at, s"the index ${i} is outside an array of ${items.items.len()}")

                    Ok(items.items.at(usize(i)))
                other -> fault(at, s"an array is indexed by an integer, and this is ${other.type_name()}")
        Object(fields) ->
            k match
                _ -> Ok(obj_get(fields, k, at)?.unwrap_or(Nil))
                other -> fault(at, s"an object is indexed by a string, and this is ${other.type_name()}")
        Str(sv) ->
            k match
                Int(_) -> fault(at, "a string is not indexed -- slate has no character type")
                other -> fault(at, s"a string is not indexed by ${other.type_name()}")
        other -> fault(at, s"${other.type_name()} cannot be indexed")
end read_at

// **A field that is not there reads as `nil` rather than faulting**, which is the choice every
// dynamically typed language with objects makes: a record grows fields over its life, and `o.maybe`
// is how a program asks whether this one has.
read_field(target: Value, name: string, at: Span) -> Step
    target match
        Object(fields) -> Ok(obj_get_name(fields, name).unwrap_or(Nil))
        other -> fault(at, s"a field belongs to an object, and this is ${other.type_name()}")

// -- calls --------------------------------------------------------------------------------------

// **A call is where `Ret` stops travelling.** Every other signal passes through untouched, so a
// `break` written inside a function body and outside any loop reaches the top and is reported
// there rather than quietly ending the call.
private do_call(callee: Expr, args: Buf[Expr], env: *EnvObj, at: Span) -> Step
    val mark = root_mark()
    val f = eval(callee, env)?

    hold(f)

    var vals: Buf[Value] = buf()

    for i in 0..<args.len()
        val v = eval(args.at(i), env)?

        // A `Buf` of the interpreter's own is not a root, so each argument is held as it arrives --
        // a later argument's own body may collect.
        hold(v)
        vals.push(v)

    val answer = apply(f, vals, at)

    release(mark)
    answer
end do_call

// Call a value with arguments already evaluated.
//
// **No calling scope is passed, and that is what a closure means.** The body runs in a child of the
// scope the closure *captured*, so nothing about where the call was written matters -- which is also
// what lets `==` call a user-supplied `equals` from inside a table lookup, where there is no
// interpreter scope to hand over.
apply(f: Value, vals: Buf[Value], at: Span) -> Step
    f match
        Native(f) -> call_native(f, vals, at)
        Fn(c) ->
            if vals.len() != c.params.len()
                return fault(at, s"this function takes ${c.params.len()} arguments and was given ${vals.len()}")

            val emark = env_mark()
            val scope = new_env(c.scope)

            hold_env(scope)

            for i in 0..<c.params.len()
                declare(scope, c.params.at(i), vals.at(i), true)

            // The annotation is the one the compiler asks for: a bare `Ok`/`Err` pair in a `match`
            // used as a value has nothing on the line to say what the other half is.
            val answer: Step = eval(body_at(c.body), scope) match
                Ok(v) -> Ok(v)
                Err(Ret(v)) -> Ok(v)
                Err(other) -> Err(other)

            release_env(emark)
            answer
        other -> fault(at, s"${other.type_name()} is not something that can be called")
end apply

// -- matching -----------------------------------------------------------------------------------

// `subject match` with its arms.
//
// **Each arm is tried in a scope of its own, and the scope is thrown away where the arm does not
// take.** A pattern binds as it goes -- there is no way to know whether `[a, b]` matches without
// binding `a` first -- so a failed arm has already written names, and the only way to keep those
// from leaking into the next arm is to give each one somewhere separate to write.
private run_match(subject: Expr, arms: Buf[Arm], env: *EnvObj, at: Span) -> Step
    val mark = root_mark()
    val emark = env_mark()
    val v = eval(subject, env)?

    // The subject is in no scope -- `[1, 2] match ...` is a temporary -- and every arm's body may
    // collect.
    hold(v)

    for i in 0..<arms.len()
        val arm = arms.at(i)
        val scope = new_env(env)

        // The arm's scope reaches `env` through its parent, but nothing reaches the arm's scope, so
        // it is held for as long as the arm is being tried.
        hold_env(scope)

        if match_pattern(arm.pattern, v, scope)
            // **The guard is evaluated in the arm's scope, after the pattern bound.** That is what
            // it is for: a guard that could not read what the pattern just bound would say nothing
            // an `if` in the body could not.
            val ok = arm.guard match
                Some(g) -> eval(g, scope)?.truthy()
                None -> true

            if ok
                val answer = eval(arm.body, scope)

                release(mark)
                release_env(emark)
                return answer
            end if
    end for

    release(mark)
    release_env(emark)

    fault(at, s"no arm of this match applies to ${value_text(v)}")
end run_match

// Whether a pattern matches a value, binding its names into `scope` as it goes.
//
// **It answers a bare `bool` rather than a `Step`, and that is deliberate**: nothing a pattern does
// can fail at runtime. There is no arithmetic in one, no call, and no index that could be out of
// range -- a pattern that does not fit simply does not fit, which is an answer and not a fault.
match_pattern(pat: Pattern, v: Value, scope: *EnvObj) -> bool
    *pat.kind match
        Wild -> true
        Bind(name) ->
            // Bound as a `val`: a name a pattern introduced is not a place to write to.
            declare(scope, name, v, false)
            true
        TypePat(test) -> is_kind(v, test)
        At(name, inner) ->
            // **The sub-pattern runs first, and the whole value is bound only if it took.** The
            // other order would leave the name bound after a failed arm -- which the arm's own
            // scope would throw away anyway, but only by accident rather than by rule.
            if !match_pattern(inner, v, scope) then return false

            declare(scope, name, v, false)
            true
        IntPat(want) -> same_literal(v, Int(want))
        RealPat(want) -> same_literal(v, Real(want))
        StrPat(want) -> v match
            // Compared against the sysl `string` directly, so a pattern never boxes one onto the
            // collected heap just to throw it away.
            Str(p) -> p.s == want
            _ -> false
        BoolPat(want) -> same_literal(v, Bool(want))
        NilPat -> v match
            Nil -> true
            _ -> false
        ArrayPat(items, open, rest) -> match_array(items, open, rest, v, scope)
        ObjectPat(keys, values) -> match_object(keys, values, v, scope)
        OrPat(alts) ->
            for i in 0..<alts.len()
                if match_pattern(alts.at(i), v, scope) then return true

            false
end match_pattern

// `[a, b]` and `[first, ...rest]`.
private match_array(items: Buf[Pattern], open: bool, rest: Option[string], v: Value, scope: *EnvObj) -> bool
    v match
        Array(xs) ->
            // A closed pattern must agree on length exactly; an open one treats the fixed patterns
            // as a floor.
            val fixed = items.len()

            if open
                if xs.items.len() < fixed then return false
            else
                if xs.items.len() != fixed then return false

            for i in 0..<fixed
                if !match_pattern(items.at(i), xs.items.at(i), scope) then return false

            // The tail is only gathered where it is named. `[a, ...]` allocates nothing.
            rest match
                Some(name) ->
                    var tail: Buf[Value] = buf()

                    for i in fixed..<xs.items.len()
                        tail.push(xs.items.at(i))

                    declare(scope, name, Array(new_array(tail)), false)
                None -> ()

            true
        _ -> false
end match_array

// `{ name: n }`.
//
// **An object pattern matches an object with *at least* these fields.** A record grows fields over
// its life, so a pattern that broke whenever one was added would be a pattern nobody could keep
// working -- and a program that wants exactness can ask `len(o)`.
private match_object(keys: Buf[string], values: Buf[Pattern], v: Value, scope: *EnvObj) -> bool
    v match
        Object(fields) ->
            for i in 0..<keys.len()
                obj_get_name(fields, keys.at(i)) match
                    None -> return false
                    Some(field) -> if !match_pattern(values.at(i), field, scope) then return false

            true
        _ -> false
end match_object

// Whether a value is of a kind.
//
// **`num` is the only one that is not a single variant**, being the union of `int` and `real` --
// which is what a pattern guarding arithmetic wants, and is why it is in the list at all.
private is_kind(v: Value, test: TypeTest) -> bool
    test match
        IsNil -> v match
            Nil -> true
            _ -> false
        IsBool -> v match
            Bool(_) -> true
            _ -> false
        IsInt -> v match
            Int(_) -> true
            _ -> false
        IsReal -> v match
            Real(_) -> true
            _ -> false
        IsNum -> v match
            Int(_) -> true
            Real(_) -> true
            _ -> false
        IsStr -> v match
            Str(_) -> true
            _ -> false
        IsArray -> v match
            Array(_) -> true
            _ -> false
        IsObject -> v match
            Object(_) -> true
            _ -> false
        IsFn -> v match
            Fn(_) -> true
            Native(_) -> true
            _ -> false
end is_kind

// A block with a scope of its own, held for as long as it runs.
private run_block_scope(stmts: Buf[Stmt], env: *EnvObj) -> Step
    val emark = env_mark()
    val scope = new_env(env)

    hold_env(scope)

    val answer = exec_block(stmts, scope)

    release_env(emark)
    answer
end run_block_scope
