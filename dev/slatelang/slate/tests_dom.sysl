module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.fs.{read_bytes, remove_file, write_text}
import sysl.process.capture
import sysl.text.{Search, from_utf8_unchecked}

// `slate:dom` -- the module that exists in three hosts and works in one.
//
// **The interpreter has no document, so every name here is a refusal**, and what these tests pin is
// that the refusal is the useful kind: the module resolves, the import is accepted, the names are
// declared, and only the CALL says there is no page. The alternative -- leaving the module out --
// would make `import { byId } from slate:dom` a complaint about the module, which sends a reader
// looking for a spelling mistake in the one line that is right.
//
// **What the DOM host actually DOES is not tested here and cannot be**, this suite having no
// document either. `slate-language/lath`'s `tests/dom/` is where that is checked, by hand, against a real DOM; its README
// says how and why it is not part of this run.

@test
SLATE_DOM_IS_A_MODULE_AND_ITS_NAMES_IMPORT()
    // The import on its own, with nothing called. **This is the half that would break if the module
    // were absent**, and it breaks before a program runs rather than when it reaches a name.
    assert_eq(out(s"${DomImport}print(\"ready\")"), "ready")

@test
EVERY_NAME_THE_MODULE_EXPORTS_IS_DECLARED()
    // A name in the export list with no `declare` behind it is a module that imports and then says
    // the name is not defined -- which is a worse failure than either half alone, and is exactly
    // what a list written twice invites.
    assert_eq(out(s"${DomImport}print(createElement is function, byId is function, release is function)"),
        "true true true")

@test
REACHING_THE_DOCUMENT_UNDER_THE_INTERPRETER_SAYS_WHICH_HOST_THIS_IS()
    // **The sentence names the command, because the command is the mistake.** The same program is
    // correct in a browser, so a complaint about the code would send the reader to change something
    // that is right.
    assert(fails(s"${DomImport}byId(\"app\")").contains(
        "`byId` needs a document, and the interpreter has none -- `slate:dom` is for a program compiled with `slate js` and loaded by a page"))

@test
EVERY_ONE_OF_THEM_REFUSES_RATHER_THAN_ONE_OF_THEM()
    // **A name wired to the wrong arm would be silent**, running some other builtin's code or
    // answering nothing at all, and a test of one name would not see it.
    val calls = ["createElement(\"div\")", "createText(\"x\")", "setAttribute(1, \"a\", \"b\")",
        "removeAttribute(1, \"a\")", "setProperty(1, \"a\", \"b\")", "on(1, \"click\", () -> 1)",
        "off(1, \"click\", () -> 1)", "setChildren(1, [])", "setText(1, \"x\")", "byId(\"a\")",
        "insertBefore(1, 2, null)", "removeChild(1, 2)",
        "query(\".a\")", "markup(1)", "release(1)",
        "children(1)", "tagName(1)", "nodeText(1)", "attribute(1, \"id\")"]

    for i in 0..<calls.len
        val said = fails(s"${DomImport}${calls[i]}")

        assert(said.contains("needs a document, and the interpreter has none"))

@test
THE_MODULE_IS_LISTED_AMONG_THE_OTHERS_WHEN_ONE_IS_MISSPELLED()
    // The "did you mean" is built from `builtin_module_names`, which is a second written list beside
    // the one `builtin_module` matches on. A module added to one and not the other is a module that
    // works and cannot be found.
    assert(fails("import { byId } from slate:dommm\nprint(1)").contains("dom"))

@test
A_PROGRAM_THAT_REACHES_THE_DOCUMENT_COMPILES_TO_JAVASCRIPT()
    // **The names go through the runtime like every other builtin**, which is what makes the back
    // end need no arm of its own for this module: `slate:dom` is seventeen more entries in `$b`.
    assert_eq(js("import { byId } from slate:dom\nval node = byId(\"app\")\n"), """
        $.at(1);
        const byId = $.field($m1, "byId");
        $.at(2);
        const node = $.call(byId, ["app"]);
        """)

// -- the page's other three doors ------------------------------------------------------------------

// Every one of the eleven, and what it is written as a call.
private page_calls() -> []const string = ["location()", "pushPath(\"/a\")", "replacePath(\"/a\")",
    "back()", "forward()", "onNavigate(() -> 1)", "stored(\"k\")", "store(\"k\", \"v\")",
    "unstore(\"k\")", "storedKeys()", "clearStored()"]

// Which of the three each one needs, in the same order.
private page_needs() -> []const string = ["location", "history", "history", "history", "history",
    "history", "localStorage", "localStorage", "localStorage", "localStorage", "localStorage"]

@test
THE_PAGES_OTHER_DOORS_REFUSE_UNDER_THE_INTERPRETER_NAMING_WHICH_ONE()
    // **Three sentences and not one, because they are three different mistakes.** A program reaching
    // for `stored` has not misunderstood the document; it has written something only a browser can
    // run, and being told "there is no document" would send it to look at the wrong thing.
    val calls = page_calls()
    val needs = page_needs()

    for i in 0..<calls.len
        val said = fails(s"${PageImport}${calls[i]}")

        assert(said.contains(s"needs a browser's `${needs[i]}`, and the interpreter is not a browser"))

@test
THEY_REFUSE_UNDER_NODE_TOO_AND_SAY_IT_IS_THE_HOST_RATHER_THAN_THE_INTERPRETER()
    // **node is a JavaScript host with no page**, which is a third thing from the interpreter and
    // from a browser -- so the sentence says what it is rather than repeating the interpreter's.
    // This is the parity principle read the other way: a browser HAS these, and everything else
    // refuses naming them.
    assert(node_said(s"${PageImport}print(location())")
        .contains("`location` needs a browser's `location`, and this JavaScript host has none"))
    assert(node_said(s"${PageImport}print(stored(\"k\"))")
        .contains("`stored` needs a browser's `localStorage`, and this JavaScript host has none"))
    assert(node_said(s"${PageImport}print(pushPath(\"/a\"))")
        .contains("`pushPath` needs a browser's `history`, and this JavaScript host has none"))

@test
EVERY_NAME_THE_PAGE_HALF_EXPORTS_IS_DECLARED()
    // The same check the element half gets: a name in the export list with no `declare` behind it
    // imports and then says it is not defined.
    assert_eq(out(s"${PageImport}print(location is function, stored is function, pushPath is function)"),
        "true true true")

// **A BROWSER'S `print` IS THE PRINT DIALOG**, and slate reached for it as a writer -- so a page's
// every `print("hi")` asked which printer to use and wrote nothing. quickjs is why the runtime looks
// at `globalThis.print` at all; a document is what tells a page from quickjs.
//
// **The preface is how a test reaches this at all.** The host record is built when the program
// loads, so a probe appended afterwards is too late; what a browser looks like has to be there
// first.
private prefaced(program: string, preface: string) -> string
    val src = "tests/js-page.tmp.sl"
    val out_js = src + ".js"

    write_text(src, program).unwrap()

    val wrote = cli_status(["slate", "js", src, "-o", out_js])

    remove_file(src)

    if wrote != 0 then return s"`slate js` exited ${wrote}"

    val emitted = from_utf8_unchecked(read_bytes(out_js).unwrap())

    write_text(out_js, preface + "\n" + emitted).unwrap()

    val ran = capture("node", [out_js], "", [], true)

    remove_file(out_js)

    ran match
        Err(e) -> s"node could not be started: ${e}"
        Ok(o) -> if o.status.ok() then o.text.trim() else o.err.unwrap_or("").trim()
end prefaced

@test
A_HOST_WITH_A_DOCUMENT_IS_A_PAGE_AND_ITS_print_IS_NOT_A_WRITER()
    // `globalThis.print` here is what a window's is: it takes no line and shows a dialog. A runtime
    // that reached for it writes nothing at all, which is the failure -- so the assertion is that
    // the output arrived, and the deliberate throw is what makes reaching for it loud rather than
    // silent.
    val browserish =
        "globalThis.document = { createElement: () => ({}) }\n" +
        "globalThis.print = () => { throw new Error(\"the print dialog was opened\") }\n"

    assert_eq(prefaced("print(\"hello from a page\")\n", browserish), "hello from a page")

@test
A_HOST_WITH_NO_DOCUMENT_STILL_USES_ITS_OWN_print()
    // The other half, which is why the rule is a document and not simply "prefer the console":
    // quickjs writes with a global `print` and has no page, and taking that away would leave it
    // writing through a console it is not obliged to have.
    val quickjsish =
        "globalThis.print = (line) => globalThis.console.log(\"via print: \" + line)\n"

    assert_eq(prefaced("print(\"hello from an engine\")\n", quickjsish),
        "via print: hello from an engine")
