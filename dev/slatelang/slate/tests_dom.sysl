module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// `slate:dom` -- the module that exists in three hosts and works in one.
//
// **The interpreter has no document, so every name here is a refusal**, and what these tests pin is
// that the refusal is the useful kind: the module resolves, the import is accepted, the names are
// declared, and only the CALL says there is no page. The alternative -- leaving the module out --
// would make `import { byId } from slate:dom` a complaint about the module, which sends a reader
// looking for a spelling mistake in the one line that is right.
//
// **What the DOM host actually DOES is not tested here and cannot be**, this suite having no
// document either. `tests/js/dom/` is where that is checked, by hand, against a real DOM; its README
// says how and why it is not part of this run.

@test
SLATE_DOM_IS_A_MODULE_AND_ITS_NAMES_IMPORT()
    // The import on its own, with nothing called. **This is the half that would break if the module
    // were absent**, and it breaks before a program runs rather than when it reaches a name.
    assert_eq(out(s"${DomImport}print(\"ready\")"), "ready")

@test
EVERY_NAME_THE_MODULE_EXPORTS_IS_DECLARED()
    // A name in the export list with no `declare` behind it is a module that imports and then says
    // the name is not defined -- which is a worse failure than either half alone, and is exactly
    // what a list written twice invites.
    assert_eq(out(s"${DomImport}print(createElement is function, byId is function, release is function)"),
        "true true true")

@test
REACHING_THE_DOCUMENT_UNDER_THE_INTERPRETER_SAYS_WHICH_HOST_THIS_IS()
    // **The sentence names the command, because the command is the mistake.** The same program is
    // correct in a browser, so a complaint about the code would send the reader to change something
    // that is right.
    assert(fails(s"${DomImport}byId(\"app\")").contains(
        "`byId` needs a document, and the interpreter has none -- `slate:dom` is for a program compiled with `slate js` and loaded by a page"))

@test
EVERY_ONE_OF_THE_THIRTEEN_REFUSES_RATHER_THAN_ONE_OF_THEM()
    // **A name wired to the wrong arm would be silent**, running some other builtin's code or
    // answering nothing at all, and a test of one name would not see it.
    val calls = ["createElement(\"div\")", "createText(\"x\")", "setAttribute(1, \"a\", \"b\")",
        "removeAttribute(1, \"a\")", "setProperty(1, \"a\", \"b\")", "on(1, \"click\", () -> 1)",
        "off(1, \"click\", () -> 1)", "setChildren(1, [])", "setText(1, \"x\")", "byId(\"a\")",
        "query(\".a\")", "markup(1)", "release(1)"]

    for i in 0..<calls.len
        val said = fails(s"${DomImport}${calls[i]}")

        assert(said.contains("needs a document, and the interpreter has none"))

@test
THE_MODULE_IS_LISTED_AMONG_THE_OTHERS_WHEN_ONE_IS_MISSPELLED()
    // The "did you mean" is built from `builtin_module_names`, which is a second written list beside
    // the one `builtin_module` matches on. A module added to one and not the other is a module that
    // works and cannot be found.
    assert(fails("import { byId } from slate:dommm\nprint(1)").contains("dom"))

@test
A_PROGRAM_THAT_REACHES_THE_DOCUMENT_COMPILES_TO_JAVASCRIPT()
    // **The names go through the runtime like every other builtin**, which is what makes the back
    // end need no arm of its own for this module: `slate:dom` is thirteen more entries in `$b`.
    assert_eq(js("import { byId } from slate:dom\nval node = byId(\"app\")\n"), """
        $.at(1);
        const byId = $.field($m1, "byId");
        $.at(2);
        const node = $.call(byId, ["app"]);
        """)
