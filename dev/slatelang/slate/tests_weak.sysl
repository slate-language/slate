module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// A weak map and a weak reference: the surface a program writes, and the collector behaviour that is
// the whole point of having them.
//
// **Its own file rather than a section of `tests_setmap.sysl`, because the COLLECTOR is the
// subject.** What a weak map does that a map does not cannot be seen from a slate program at all --
// nothing in the language forces a collection -- so half of this drives `collect_now` directly and
// builds its values with `new_weak_map` and `new_object`. That is the only vantage from which "this
// entry went away" is a thing a test can assert rather than hope for.
//
// **`tests/lang/weak.sl` is the both-hosts half beside this**, and it pins only what a program can
// observe without a collection: the four names, the refusals, and what `deref` answers while the
// target is held.

// -- what a program writes ------------------------------------------------------------------------

@test
A_WEAK_MAP_HOLDS_A_VALUE_UNDER_ANY_OBJECT_KEY()
    val prog = raw"""
    val k = { name: "a" }
    val wm = WeakMap()

    wm.set(k, 1)

    print(wm, wm.get(k), wm.has(k))
    print(wm.delete(k), wm.has(k), wm.get(k))
    """

    assert_eq(out(prog), "<WeakMap> 1 true\ntrue false null")
end A_WEAK_MAP_HOLDS_A_VALUE_UNDER_ANY_OBJECT_KEY

// **`set` answers the weak map so that writes chain**, which is a map's arrangement and JavaScript's.
@test
SET_ANSWERS_THE_WEAK_MAP_AND_DELETE_ANSWERS_WHETHER_THERE_WAS_ONE()
    val prog = raw"""
    val xs = [1, 2]
    val ys = [3]
    val wm = WeakMap().set(xs, "first").set(ys, "second")

    print(wm.get(xs), wm.get(ys))
    print(wm.delete(xs), wm.delete(xs))
    """

    assert_eq(out(prog), "first second\ntrue false")
end SET_ANSWERS_THE_WEAK_MAP_AND_DELETE_ANSWERS_WHETHER_THERE_WAS_ONE

// **A closure, an array and a class instance are all keys**, which is the reading of "an object"
// that matters: a thing a program keeps and hands around.
@test
EVERY_KIND_THE_COLLECTOR_CAN_FREE_IS_A_KEY()
    val prog = raw"""
    class Point
        var x

    val f = (n) -> n
    val p = Point.new(3)
    val s = Set([1])
    val m = Map()

    print(WeakMap().set(f, "closure").get(f))
    print(WeakMap().set(p, "instance").get(p))
    print(WeakMap().set(s, "set").get(s))
    print(WeakMap().set(m, "map").get(m))
    """

    assert_eq(out(prog), "closure\ninstance\nset\nmap")
end EVERY_KIND_THE_COLLECTOR_CAN_FREE_IS_A_KEY

@test
A_WEAK_REFERENCE_ANSWERS_ITS_TARGET_WHILE_SOMETHING_HOLDS_IT()
    val prog = raw"""
    val k = { name: "a" }
    val r = WeakRef(k)

    print(r, r.deref())
    print(r.deref() == k)
    """

    assert_eq(out(prog), "<WeakRef> {name: \"a\"}\ntrue")
end A_WEAK_REFERENCE_ANSWERS_ITS_TARGET_WHILE_SOMETHING_HOLDS_IT

// **Identity, which is the only equality either could have**: what is in a weak map is the
// collector's to change, and a weak reference's target may be gone by the time it is asked.
@test
THE_WEAK_PAIR_COMPARES_BY_IDENTITY()
    val prog = raw"""
    val wm = WeakMap()
    val k = { name: "a" }
    val r = WeakRef(k)

    print(wm == wm, wm == WeakMap())
    print(r == r, r == WeakRef(k))
    """

    assert_eq(out(prog), "true false\ntrue false")
end THE_WEAK_PAIR_COMPARES_BY_IDENTITY

// **A WEAK MAP KEYS BY IDENTITY WHERE A MAP KEYS BY WHAT A VALUE HOLDS**, which is the one place the
// two tables behave differently and is not a choice: a key a weak map finds structurally could not be
// dropped when the object that wrote it went, another equal one always being able to arrive -- and a
// JavaScript host's `WeakMap`, which is what `slate js` emits, keys by identity and could do nothing
// else.
@test
A_WEAK_MAP_FINDS_A_KEY_BY_IDENTITY_WHERE_A_MAP_FINDS_ONE_BY_VALUE()
    val prog = raw"""
    val a = { n: 1 }
    val b = { n: 1 }

    print(a == b)
    print(Map().set(a, "one").get(b), WeakMap().set(a, "one").get(b))
    print(WeakMap().set(a, "one").get(a), WeakMap().set(a, "one").has(b))
    """

    assert_eq(out(prog), "true\none null\none false")
end A_WEAK_MAP_FINDS_A_KEY_BY_IDENTITY_WHERE_A_MAP_FINDS_ONE_BY_VALUE

// **A class's own `hash` and `==` are not consulted at all**, which follows: they are what a
// structural table asks, and identity asks nothing of the program. It also keeps the collector clear
// of a program's code, which `weaken` could not run in any case.
@test
A_CLASSS_OWN_HASH_AND_EQUALITY_ARE_NOT_ASKED_BY_A_WEAK_MAP()
    val prog = raw"""
    class Boxed
        var v

        hash(self) = 7
        ==(self, other) = true

    val p = Boxed.new(1)
    val q = Boxed.new(2)

    print(Map().set(p, "p").get(q))
    print(WeakMap().set(p, "p").get(q))
    print(WeakMap().set(p, "p").get(p))
    """

    assert_eq(out(prog), "p\nnull\np")
end A_CLASSS_OWN_HASH_AND_EQUALITY_ARE_NOT_ASKED_BY_A_WEAK_MAP

// -- what neither can do ---------------------------------------------------------------------------

// **A KEY THE COLLECTOR CANNOT FREE IS REFUSED BY ALL FOUR NAMES**, where JavaScript refuses only
// `set` and answers `undefined` or `false` for the rest. A program that reads with a key it could
// never have written with is told at the line rather than at the missing entry.
@test
A_KEY_THE_COLLECTOR_CANNOT_FREE_IS_REFUSED_BY_EVERY_NAME()
    val said = "must be something the collector can free"

    assert(fails("val wm = WeakMap()\nwm.set(\"a\", 1)\n").contains(said), "a string")
    assert(fails("val wm = WeakMap()\nwm.set(1, 1)\n").contains(said), "an integer")
    assert(fails("val wm = WeakMap()\nwm.set(true, 1)\n").contains(said), "a boolean")
    assert(fails("val wm = WeakMap()\nwm.get(1)\n").contains(said), "a read")
    assert(fails("val wm = WeakMap()\nwm.has(1)\n").contains(said), "a test")
    assert(fails("val wm = WeakMap()\nwm.delete(1)\n").contains(said), "a removal")
    assert(fails("print(WeakRef(\"a\"))\n").contains(said), "and a weak reference's target")

    // The sentence names what arrived, so that the reader does not have to work out which argument.
    assert(fails("val wm = WeakMap()\nwm.set(\"a\", 1)\n").contains("and this is a string"),
        "and it names what came instead")
end A_KEY_THE_COLLECTOR_CANNOT_FREE_IS_REFUSED_BY_EVERY_NAME

// **NEITHER IS WALKABLE AND NEITHER HAS A SIZE**, and that is the design rather than an omission:
// what is in a weak map is the collector's to decide, so a walk would answer differently on two runs
// of one program with nothing between them, and a count is a walk that says how long it was.
@test
A_WEAK_MAP_HAS_NO_SIZE_NO_CLEAR_AND_NO_WALK()
    assert(fails("print(WeakMap().size)\n").contains("`size` is not something a weak map can do"),
        "no size")
    assert(fails("anything(v) = v\nprint(anything(WeakMap()).keys())\n").contains("`keys` is not something a weak map can do"),
        "no keys")
    assert(fails("anything(v) = v\nprint(anything(WeakMap()).clear())\n").contains("`clear` is not something a weak map can do"),
        "no clear")
    assert(fails("for x in WeakMap()\n    print(x)\n").contains("and this is a weak map"),
        "and a `for` says what it was given")
end A_WEAK_MAP_HAS_NO_SIZE_NO_CLEAR_AND_NO_WALK

@test
THE_TWO_CONSTRUCTORS_SAY_WHAT_THEY_TAKE()
    // **`WeakMap` takes nothing, so there is no count it can fail to reach** -- what a call gives
    // past zero is dropped, which is the call rule read at a native and is what the JavaScript
    // host's own `WeakMap` does anyway.
    assert_eq(out("print(WeakMap(1) == WeakMap(1))\n"), "false")
    assert(fails("print(WeakRef())\n").contains("`WeakRef` takes one thing to point at, and was given 0 arguments"),
        "and a weak reference from one thing")
    assert(fails("val wm = WeakMap()\nwm.set({ a: 1 })\n").contains("`set` takes a weak map, a key and a value, and was given 2 arguments"),
        "and a write takes three")
end THE_TWO_CONSTRUCTORS_SAY_WHAT_THEY_TAKE

// **There is no JSON for either**, which is the answer a function and a promise already get: what a
// weak map holds is not a thing that can be written down and read back.
@test
NEITHER_HAS_A_JSON_FORM()
    assert(fails("print(toJSON(WeakMap()))\n").contains("there is no JSON for a weak map"), "a weak map")
    assert(fails("print(toJSON(WeakRef([1])))\n").contains("there is no JSON for a weak reference"),
        "and a weak reference")
end NEITHER_HAS_A_JSON_FORM

// -- the collector ---------------------------------------------------------------------------------

// Write one entry into a table, with the test failing rather than the write being ignored.
private write_entry(t: *ObjectObj, k: Value, v: Value)
    obj_put(t, k, v, point(0)) match
        Ok(_) -> ()
        Err(_) -> assert(false, "the write into the weak map failed")

// An object with one field naming another value, which is what an entry's value refers back with.
private object_naming(name: string, v: Value) -> Value
    val o = new_object()

    obj_put_name(o, name, v)
    Object(o)

// **THE CLAIM THE WHOLE KIND RESTS ON.** An entry whose key nothing else holds is gone after a
// collection -- which is what a strong map cannot do and is the reason `slate:dom` may keep a
// listener table without pinning every node it has ever been handed.
@test
A_WEAK_MAP_ENTRY_GOES_WHEN_NOTHING_ELSE_HOLDS_ITS_KEY()
    reset_heap()
    reset_vm()

    val t = new_weak_map()

    // The map itself is rooted through the machine's stack; the key is held by nothing but the
    // entry, which is exactly the case under test.
    machine().stack.push(WeakMapVal(t))
    write_entry(t, Object(new_object()), str_value("listener"))

    assert_eq(t.live, 1, "the entry is there before the collection")
    collect_now()
    assert_eq(t.live, 0, "and gone after it")
    reset_vm()
end A_WEAK_MAP_ENTRY_GOES_WHEN_NOTHING_ELSE_HOLDS_ITS_KEY

// The other half of the same claim, and the one a bug in `weaken` would pass on its own: an entry
// whose key is still reachable stays, with its value.
@test
A_WEAK_MAP_ENTRY_SURVIVES_WHILE_ITS_KEY_IS_HELD()
    reset_heap()
    reset_vm()

    val t = new_weak_map()
    val key = Object(new_object())

    machine().stack.push(WeakMapVal(t))
    machine().stack.push(key)
    write_entry(t, key, str_value("listener"))
    collect_now()

    assert_eq(t.live, 1, "the entry is still there")

    obj_get(t, key, point(0)) match
        Ok(Some(v)) -> assert_eq(value_text(v), "listener", "and so is what it held")
        _ -> assert(false, "the entry answered nothing")

    reset_vm()
end A_WEAK_MAP_ENTRY_SURVIVES_WHILE_ITS_KEY_IS_HELD

// **THE EPHEMERON CASE, AND IT IS THE ONE WHOSE ABSENCE IS SILENT.** A value that refers back to its
// own key is the ordinary shape -- `wm.set(node, { owner: node })` -- and a collector that marked
// values strongly would keep the pair alive for as long as the map lived, which is the exact leak a
// weak map exists to prevent. Nothing about the surface of the language would show it.
@test
A_VALUE_THAT_REFERS_BACK_TO_ITS_OWN_KEY_IS_STILL_FREED()
    reset_heap()
    reset_vm()

    val t = new_weak_map()
    val key = Object(new_object())

    machine().stack.push(WeakMapVal(t))
    write_entry(t, key, object_naming("owner", key))

    assert_eq(t.live, 1, "the entry is there before the collection")
    collect_now()
    assert_eq(t.live, 0, "and the cycle through the map did not keep it")
    reset_vm()
end A_VALUE_THAT_REFERS_BACK_TO_ITS_OWN_KEY_IS_STILL_FREED

// **The other side of the ephemeron, which a `trace` marking neither half would fail.** A value is
// marked BECAUSE its key was, and that value may be some other entry's key -- so `a -> b` and
// `b -> c` with only `a` held keeps both entries, and it takes two marking passes to find out.
@test
A_VALUE_KEPT_BY_ITS_KEY_MAY_BE_ANOTHER_ENTRYS_KEY()
    reset_heap()
    reset_vm()

    val t = new_weak_map()
    val a = Object(new_object())
    val b = Object(new_object())
    val c = Object(new_object())

    machine().stack.push(WeakMapVal(t))
    machine().stack.push(a)
    write_entry(t, a, b)
    write_entry(t, b, c)
    collect_now()

    assert_eq(t.live, 2, "the chain is walked to its end")

    // And with nothing holding the head of the chain, the whole of it goes.
    reset_vm()

    val u = new_weak_map()
    val x = Object(new_object())
    val y = Object(new_object())

    machine().stack.push(WeakMapVal(u))
    write_entry(u, x, y)
    write_entry(u, y, Object(new_object()))
    collect_now()

    assert_eq(u.live, 0, "and nothing keeps a chain nothing holds")
    reset_vm()
end A_VALUE_KEPT_BY_ITS_KEY_MAY_BE_ANOTHER_ENTRYS_KEY

// **A weak reference does not keep its target alive**, and `deref` answers `null` once it is gone --
// `null` rather than `undefined`, slate having no `undefined` a program may store.
@test
A_WEAK_REFERENCE_CLEARS_WHEN_ITS_TARGET_IS_COLLECTED()
    reset_heap()
    reset_vm()

    val r = new_weak_ref(Object(new_object()))

    machine().stack.push(WeakRefVal(r))
    collect_now()

    r.target match
        Null -> ()
        _ -> assert(false, "the target should have gone")

    reset_vm()
end A_WEAK_REFERENCE_CLEARS_WHEN_ITS_TARGET_IS_COLLECTED

@test
A_WEAK_REFERENCE_KEEPS_ANSWERING_WHILE_ITS_TARGET_IS_HELD()
    reset_heap()
    reset_vm()

    val target = str_value("still here")
    val kept = new_weak_ref(object_naming("held", target))

    machine().stack.push(WeakRefVal(kept))
    machine().stack.push(kept.target)
    collect_now()

    kept.target match
        Object(o) -> obj_get_name(o, "held") match
            Some(v) -> assert_eq(value_text(v), "still here", "and what it holds is intact")
            None -> assert(false, "the target lost its field")
        _ -> assert(false, "the target should still be there")

    reset_vm()
end A_WEAK_REFERENCE_KEEPS_ANSWERING_WHILE_ITS_TARGET_IS_HELD

// -- storage the allocator did not clear -----------------------------------------------------------
//
// **`new_weak_ref` is the one constructor built over `gc.alloc_raw`**, and what these pin is the
// contract that entry point is handed out under: every byte of the payload is written before anything
// can read it, so a block carrying a dead weak reference's bytes is indistinguishable from a cleared
// one. `obj.sysl`'s `alloc_or_collect_raw` says why no other constructor may take that path.
//
// **The heap is deliberately small so that blocks are REUSED.** Over a large heap every allocation
// comes off the never-touched end of the block, which is zero anyway, so the test would pass against
// a constructor that had forgotten to write its field. A quarter of a megabyte and a few hundred
// collections is what puts a dead object's bytes under the next one.

private const ReuseCeiling: usize = 262144

@test
A_WEAK_REFERENCE_OVER_UNCLEARED_STORAGE_READS_BACK_WHAT_IT_WAS_GIVEN()
    reset_vm()
    set_heap_limit(ReuseCeiling)
    reset_heap()

    var round: usize = 0
    var collections: usize = 0

    // Each round makes a reference nothing roots, collects, and then reads the NEXT one back -- so
    // every read is of an object standing on storage a dead weak reference held a moment ago.
    while round < 240
        val stale = new_weak_ref(str_value("gone"))

        collect_now()
        collections += 1

        val mark = root_mark()
        val target = str_value("round " + str(round))
        val fresh = new_weak_ref(target)

        // Rooted across a second collection, which is the window where a payload nobody wrote would
        // be followed by `weaken_weak_ref`.
        hold(WeakRefVal(fresh))
        hold(target)
        collect_now()
        collections += 1

        assert_eq(value_text(fresh.target), "round " + str(round),
            "a weak reference over reused storage answers what it was given")

        release(mark)
        round += 1
    end while

    set_heap_limit(HeapBytes)
    reset_heap()
    reset_vm()

    assert_eq(round, 240, "every round ran")
    assert_eq(collections, 480, "and the collector walked the kind between each construction and its read")
end A_WEAK_REFERENCE_OVER_UNCLEARED_STORAGE_READS_BACK_WHAT_IT_WAS_GIVEN

// **The reserve path, which `alloc_raw` leaves exactly as it was.** A full heap is answered with
// `spare_weak_ref` -- a real object handed out before and holding a live `Value` -- so the
// constructor's write is an ordinary one over a payload that was never raw. `reset_heap` takes the
// reserves again, and a weak reference made after it is an ordinary one.
@test
A_FULL_HEAP_ANSWERS_A_WEAK_REFERENCE_WITH_ITS_RESERVE_AND_reset_heap_TAKES_ANOTHER()
    reset_vm()
    set_heap_limit(ReuseCeiling)
    reset_heap()

    val mark = root_mark()
    var made: usize = 0

    // Held on the shadow stack, so the collection the allocator tries first frees none of them.
    while made < 40000 && !current().heap_exhausted
        hold(WeakRefVal(new_weak_ref(str_value("held"))))
        made += 1

    val ran_out = current().heap_exhausted
    val reserve = new_weak_ref(str_value("from the reserve"))
    val reserve_answered = value_text(reserve.target) == "from the reserve"

    release(mark)
    set_heap_limit(HeapBytes)
    reset_heap()

    val kept = root_mark()
    val after = new_weak_ref(str_value("after"))

    hold(WeakRefVal(after))
    hold(after.target)
    collect_now()
    release(kept)

    assert(ran_out, s"a heap that is full says so, and this made ${str(made)} weak references without filling it")
    assert(reserve_answered, "the reserve is written through exactly as a fresh cell is")
    assert_eq(current().heap_exhausted, false, "and rebuilding the heap puts the flag back")
    assert_eq(value_text(after.target), "after", "and the reserve taken again serves the next one")

    reset_vm()
end A_FULL_HEAP_ANSWERS_A_WEAK_REFERENCE_WITH_ITS_RESERVE_AND_reset_heap_TAKES_ANOTHER
