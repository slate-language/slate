module dev.slatelang.slate

#if feature_http2

// Every name of `slate:nghttp2`, over `js_rt_h2.sysl`'s session and `js_rt_h2_hpack.sysl`'s HPACK.
//
// **Cut from that file at the line where the session ends and the argument checking begins**, so
// what is here is only what a program's call looks like: a session, an encoder or a decoder as an
// integer into a table, the headers as an object or as pairs, a body as text or bytes, and the
// sentences each refusal says. The sentences are `nghttp2.sysl`'s, which is what `tests_js_h2.sysl`
// and `tests_js_h2_client.sysl` hold the two to.

js_runtime_h2_calls() -> string = raw"""
        const h2Sessions = []

        const h2At = (v, name) => {
            if (!$.isInt(v)) fault("`" + name + "` takes a session, and this is " + typeName(v))

            const s = h2Sessions[Number(v)]

            if (s === undefined) fault("`" + name + "` was given something that is not a session")
            if (s === null) fault("this session has been closed, and `" + name + "` needs an open one")

            return s
        }

        const h2Count = (args, low, high, name, what) => {
            if (args.length < low || args.length > high)
                fault("`" + name + "` takes " + what + ", and was given " + args.length + " argument" + (args.length === 1 ? "" : "s"))
        }

        const h2Stream = (v, name) => {
            if (!$.isInt(v) || Number(v) < 1) fault("`" + name + "` takes a stream number, and this is " + typeName(v))

            return Number(v)
        }

        // Headers as an object or as pairs, as `[name, value, sensitive]`. A session lower-cases the
        // names; `hpackDeflate` encodes what it was given, which is what nghttp2's encoder does.
        const h2Fields = (v, name, keepCase) => {
            const pairs = []
            const text = (x) => {
                if (!$.isStr(x)) fault("a header value is text, and this one is " + typeName(x) + " -- `" + name + "` writes what goes on the wire")

                return x
            }

            if (v instanceof $.SObj) {
                for (const [k, x] of v.fields.values()) {
                    if (!$.isStr(k)) fault("a header name is text, and this is " + typeName(k))

                    pairs.push([k, text(x), false])
                }
            } else if (Array.isArray(v)) {
                for (const p of v) {
                    if (!Array.isArray(p)) fault("`" + name + "` takes the headers as pairs, and one of them is " + typeName(p))

                    if (p.length < 2 || p.length > 3)
                        fault("a header is a name and a value, and this one has " + p.length + " part" + (p.length === 1 ? "" : "s"))

                    if (!$.isStr(p[0])) fault("a header name is text, and this is " + typeName(p[0]))

                    pairs.push([p[0], text(p[1]), p.length === 3 && p[2] !== false && p[2] !== null])
                }
            } else {
                fault("`" + name + "` takes the headers as an object or as pairs, and this is " + typeName(v))
            }

            return keepCase ? pairs : pairs.map(([k, x, hidden]) => [k.toLowerCase(), x, hidden])
        }

        // A body as bytes, text crossing as its UTF-8; `undefined` and `null` are no body.
        const h2Body = (v, name) => {
            if (v === undefined || v === null) return Buffer.alloc(0)
            if ($.isStr(v)) return Buffer.from(v, "utf8")
            if (!(v instanceof $.SBytes) && !Array.isArray(v)) fault("`" + name + "` takes a body as text or bytes, and this is " + typeName(v))

            return Buffer.from($.bytesLike(v, name))
        }

        // A count of bytes, which is never negative.
        const h2Size = (v, name) => {
            if (!$.isInt(v)) fault("`" + name + "` takes a count of bytes, and this is " + typeName(v))
            if (v < 0n) fault("`" + name + "` takes a count of bytes, and this is " + v)

            return Number(v)
        }

        // `{ autoWindowUpdate }`, the one option a session takes.
        const h2Auto = (args, name) => {
            h2Count(args, 0, 1, name, "an optional object of options")
            h2NeedSockets(name)

            if (args.length === 0 || args[0] === null) return true

            if (!(args[0] instanceof $.SObj)) fault("`" + name + "` takes an object of options, and this is " + typeName(args[0]))

            for (const [k] of args[0].fields.values())
                if (k !== "autoWindowUpdate")
                    fault("`" + k + "` is not one of a session's options -- there is one, `autoWindowUpdate`, and setting it false is what `h2Consume` needs")

            const option = args[0].getKey("autoWindowUpdate")

            if (option === undefined) return true
            if (typeof option !== "boolean") fault("`autoWindowUpdate` is true or false, and this is " + typeName(option))

            return option
        }

        const h2Refusal = (message) => $.obj([["error", message]])

        const h2NeedSockets = (name) => {
            if (typeof Buffer === "undefined")
                fault("`" + name + "` needs a host with sockets, and this JavaScript host has none")
        }

        B.h2Server = (...args) => {
            h2Sessions.push(new h2.Session(h2Auto(args, "h2Server")))

            return BigInt(h2Sessions.length - 1)
        }

        B.h2Client = (...args) => {
            h2Sessions.push(new h2.Client(h2Auto(args, "h2Client")))

            return BigInt(h2Sessions.length - 1)
        }

        // A request, on a client; a server refuses it as nghttp2 does, in its words.
        const h2Ask = (args, name, whole) => {
            const s = h2At(args[0], name)
            const fields = h2Fields(args[1], name)
            const body = whole ? h2Body(args[2], name) : Buffer.alloc(0)

            if (!(s instanceof h2.Client)) fault("`" + name + "` could not be sent: submitting a request: Protocol error")

            return BigInt(s.request(fields, body, whole))
        }

        B.h2Request = (...args) => {
            h2Count(args, 2, 3, "h2Request", "a session, the headers and an optional body")

            return h2Ask(args, "h2Request", true)
        }

        B.h2RequestStream = (...args) => {
            h2Count(args, 2, 2, "h2RequestStream", "a session and the headers")

            return h2Ask(args, "h2RequestStream", false)
        }

        // The settings a program may name, as their identifiers.
        const h2SettingIds = { headerTableSize: 1, enablePush: 2, maxConcurrentStreams: 3, initialWindowSize: 4, maxFrameSize: 5, maxHeaderListSize: 6 }

        // A stream number where zero is the connection.
        const h2StreamOrZero = (v, name) => {
            if (!$.isInt(v)) fault("`" + name + "` takes a stream number, and this is " + typeName(v))
            if (v < 0n) fault("`" + name + "` takes a stream number, and this is " + v)

            return Number(v)
        }

        // This side's SETTINGS, checked as nghttp2 checks them before one is queued.
        B.h2Settings = (...args) => {
            h2Count(args, 2, 2, "h2Settings", "a session and an object of settings")

            const s = h2At(args[0], "h2Settings")

            if (!(args[1] instanceof $.SObj)) fault("`h2Settings` takes an object of settings, and this is " + typeName(args[1]))

            const entries = []

            for (const [k, v] of args[1].fields.values()) {
                if (!$.isStr(k)) fault("a setting is named, and this is " + typeName(k))
                if (!$.isInt(v)) fault("`" + k + "` is a number, and this is " + typeName(v))
                if (v < 0n) fault("`" + k + "` is a count, and this is " + v)

                const id = Object.hasOwn(h2SettingIds, k) ? h2SettingIds[k] : undefined

                if (id === undefined)
                    fault("`" + k + "` is not one of HTTP/2's settings -- they are `headerTableSize`, `enablePush`, `maxConcurrentStreams`, `initialWindowSize`, `maxFrameSize` and `maxHeaderListSize`")

                entries.push([id, Number(BigInt.asUintN(32, v))])
            }

            for (const [id, n] of entries)
                if ((id === 2 && n > 1) || (id === 4 && n > 0x7fffffff) || (id === 5 && (n < 16384 || n > 16777215)))
                    fault("`h2Settings` could not be sent: submitting SETTINGS: Invalid argument")

            s.settings(entries)

            return null
        }

        B.h2WindowUpdate = (...args) => {
            h2Count(args, 3, 3, "h2WindowUpdate", "a session, a stream and an increment")

            const s = h2At(args[0], "h2WindowUpdate")
            const stream = h2StreamOrZero(args[1], "h2WindowUpdate")
            const by = h2StreamOrZero(args[2], "h2WindowUpdate")
            const said = s.windowUpdate(stream, by)

            if (said !== null) fault("`h2WindowUpdate` could not be sent: " + said)

            return null
        }

        B.h2Ping = (...args) => {
            h2Count(args, 1, 1, "h2Ping", "a session")

            h2At(args[0], "h2Ping").ping()

            return null
        }

        B.h2Wants = (...args) => {
            h2Count(args, 1, 1, "h2Wants", "a session")

            const [read, write] = h2At(args[0], "h2Wants").wants()

            return $.obj([["read", read], ["write", write]])
        }

        B.h2Receive = (...args) => {
            h2Count(args, 2, 2, "h2Receive", "a session and some bytes")

            const s = h2At(args[0], "h2Receive")
            const said = s.receive(Buffer.from($.bytesLike(args[1], "h2Receive")))

            return said === null ? null : h2Refusal(said)
        }

        B.h2Send = (...args) => {
            h2Count(args, 1, 1, "h2Send", "a session")

            return $.bytesOf(new Uint8Array(h2At(args[0], "h2Send").send()))
        }

        B.h2Next = (...args) => {
            h2Count(args, 1, 1, "h2Next", "a session")

            const e = h2At(args[0], "h2Next").events.shift()

            if (e === undefined) return null

            const fields = [["kind", e.kind]]

            if (e.stream !== undefined) fields.push(["stream", BigInt(e.stream)])
            if (e.headers !== undefined) fields.push(["headers", e.headers.map((h) => [h[0], h[1]])])
            if (e.of !== undefined) fields.push(["of", e.of])
            if (e.bytes !== undefined) fields.push(["bytes", $.bytesOf(e.bytes)])
            if (e.code !== undefined) fields.push(["code", BigInt(e.code)])
            if (e.lastStream !== undefined) fields.push(["lastStream", BigInt(e.lastStream)])
            if (e.increment !== undefined) fields.push(["increment", BigInt(e.increment)])
            if (e.ack !== undefined) fields.push(["ack", e.ack])

            return $.obj(fields)
        }

        B.h2Respond = (...args) => {
            h2Count(args, 3, 4, "h2Respond", "a session, a stream, the headers and an optional body")

            const s = h2At(args[0], "h2Respond")

            s.respond(h2StreamOrZero(args[1], "h2Respond"), h2Fields(args[2], "h2Respond"), h2Body(args[3], "h2Respond"), true, args[3] === undefined || args[3] === null)

            return null
        }

        B.h2RespondStream = (...args) => {
            h2Count(args, 3, 3, "h2RespondStream", "a session, a stream and the headers")

            const s = h2At(args[0], "h2RespondStream")

            s.respond(h2StreamOrZero(args[1], "h2RespondStream"), h2Fields(args[2], "h2RespondStream"), Buffer.alloc(0), false, false)

            return null
        }

        B.h2Push = (...args) => {
            h2Count(args, 3, 3, "h2Push", "a session, a stream and a piece of the body")

            const s = h2At(args[0], "h2Push")
            const said = s.push(h2Stream(args[1], "h2Push"), h2Body(args[2], "h2Push"))

            return said === null ? null : h2Refusal(said)
        }

        B.h2Finish = (...args) => {
            h2Count(args, 2, 3, "h2Finish", "a session, a stream and optional trailers")

            const s = h2At(args[0], "h2Finish")
            const trailers = args[2] === undefined || args[2] === null ? null : h2Fields(args[2], "h2Finish")
            const said = s.finish(h2Stream(args[1], "h2Finish"), trailers)

            return said === null ? null : h2Refusal(said)
        }

        B.h2Goaway = (...args) => {
            h2Count(args, 2, 3, "h2Goaway", "a session, the last stream and an optional code")

            const s = h2At(args[0], "h2Goaway")

            if (!$.isInt(args[1])) fault("`h2Goaway` takes the last stream as a number, and this is " + typeName(args[1]))

            const code = args[2] === undefined ? 0n : args[2]

            if (!$.isInt(code)) fault("`h2Goaway` takes its code as a number, and this is " + typeName(code))

            s.goaway(Number(args[1]), Number(code))

            return null
        }

        // Give up on one stream and leave the connection alone -- `slate:http`'s answer to a header
        // block that missed its deadline, which is why the server half has it.
        B.h2Reset = (...args) => {
            h2Count(args, 3, 3, "h2Reset", "a session, a stream and an error code")

            const s = h2At(args[0], "h2Reset")
            const stream = h2Stream(args[1], "h2Reset")
            const code = args[2] === null ? 0n : args[2]

            if (!$.isInt(code)) fault("`h2Reset` takes an error code, and this is " + typeName(code))
            if (code < 0n) fault("`h2Reset` takes an error code, and this is " + code)

            s.reset(stream, Number(code))

            return null
        }

        B.h2Consume = (...args) => {
            h2Count(args, 3, 3, "h2Consume", "a session, a stream and a number of bytes")

            const s = h2At(args[0], "h2Consume")

            if (s.auto) fault("`h2Consume` is refused on a session that extends its own windows; open it with { autoWindowUpdate: false }")

            if (!$.isInt(args[2]) || Number(args[2]) < 0) fault("`h2Consume` takes a number of bytes, and this is " + typeName(args[2]))

            s.consume(h2Stream(args[1], "h2Consume"), Number(args[2]))

            return null
        }

        B.h2Close = (...args) => {
            h2Count(args, 1, 1, "h2Close", "a session")

            // Closing a session twice is not an error, as nghttp2's door has it.
            if (!$.isInt(args[0])) h2At(args[0], "h2Close")

            if (h2Sessions[Number(args[0])] !== undefined) h2Sessions[Number(args[0])] = null

            return null
        }

        // -- HPACK, which needs no session ------------------------------------------------------------

        // Two tables, and one number may name an encoder in one and a decoder in the other, which is
        // the interpreter's arrangement -- and why `hpackClose` clears both.
        const hpackDeflaters = []
        const hpackInflaters = []

        // An encoder's or a decoder's number, checked as far as its shape.
        const hpackId = (v, name) => {
            if (!$.isInt(v)) fault("`" + name + "` takes a session, and this is " + typeName(v))
            if (v < 0n) fault("`" + name + "` was given something that is not a session")

            return Number(v)
        }

        const hpackHeld = (table, id, name, what) => {
            if (id >= table.length) fault("`" + name + "` was given something that is not " + what)

            const x = table[id]

            if (x === null) fault("this " + what.split(" ")[1] + " has been closed")

            return x
        }

        B.hpackDeflater = (...args) => {
            h2Count(args, 0, 1, "hpackDeflater", "an optional table size")

            const size = args.length === 0 ? 4096 : h2Size(args[0], "hpackDeflater")

            hpackDeflaters.push(new h2.Deflater(size))

            return BigInt(hpackDeflaters.length - 1)
        }

        B.hpackInflater = (...args) => {
            h2Count(args, 0, 0, "hpackInflater", "nothing")

            hpackInflaters.push({ dec: new h2.Decoder(), bad: false })

            return BigInt(hpackInflaters.length - 1)
        }

        B.hpackDeflate = (...args) => {
            h2Count(args, 2, 2, "hpackDeflate", "an encoder and the headers")

            const id = hpackId(args[0], "hpackDeflate")
            const fields = h2Fields(args[1], "hpackDeflate", true)

            return $.bytesOf(new Uint8Array(hpackHeld(hpackDeflaters, id, "hpackDeflate", "an encoder").deflate(fields)))
        }

        // **A block that will not decode is an answer, and the decoder is spent by it**: its table is
        // out of step with the encoder's, so every block after it is refused too, as nghttp2's is.
        B.hpackInflate = (...args) => {
            h2Count(args, 2, 2, "hpackInflate", "a decoder and some bytes")

            const id = hpackId(args[0], "hpackInflate")
            const block = Buffer.from($.bytesLike(args[1], "hpackInflate"))
            const i = hpackHeld(hpackInflaters, id, "hpackInflate", "a decoder")

            if (!i.bad) {
                try {
                    return i.dec.decode(block, Infinity).map((f) => [f[0], f[1]])
                } catch (e) {
                    if (!(e instanceof h2.H2Error)) throw e

                    i.bad = true
                }
            }

            return h2Refusal("decoding a header block: Header compression/decompression error")
        }

        B.hpackClose = (...args) => {
            h2Count(args, 1, 1, "hpackClose", "an encoder or a decoder")

            const id = hpackId(args[0], "hpackClose")

            if (id < hpackDeflaters.length) hpackDeflaters[id] = null
            if (id < hpackInflaters.length) hpackInflaters[id] = null

            return null
        }
"""

#else
js_runtime_h2_calls() -> string = ""
#endif
