module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.fs.{entries}
import sysl.text.Search

// The builtin surface -- arrays, methods, JSON -- and what the checker says before running.
//
// **The checker may only report what the machine would also refuse**, so a test that pins a
// run-time fault hands over a value through `Opaque` that the pass cannot see the type of.

// -- arrays, and the method syntax a builtin type answers to ---------------------------------------

@test
an_array_is_walked_by_a_function()
    assert_eq(out("print(map([1, 2, 3], x -> x * 2))"), "[2, 4, 6]")
    assert_eq(out("print(filter([1, 2, 3, 4], x -> x % 2 == 0))"), "[2, 4]")
    assert_eq(out("print(reduce([1, 2, 3], (a, b) -> a + b, 0))"), "6")
    assert_eq(out("print(map([], x -> x))"), "[]")
    assert_eq(out("print(filter([], x -> true))"), "[]")

    // The starting value is what an empty fold answers, which is why it is required.
    assert_eq(out("print(reduce([], (a, b) -> a + b, 99))"), "99")

@test
a_CALLBACK_IS_HANDED_THE_VALUE_AND_NOTHING_ELSE()
    // **The defect this rules out is JavaScript's most quoted one**: `["1","2","3"].map(parseInt)`
    // answers `[1, NaN, NaN]` there, because `map` passes the index as a second argument and
    // `parseInt` reads it as a radix. A one-argument builtin is exactly what a reader expects to be
    // able to pass, so slate passes one argument.
    assert_eq(out("print(map([\"1\", \"2\", \"3\"], number))"), "[1, 2, 3]")

    // `apply` faults on an arity mismatch, so a two-argument function is refused rather than
    // silently fed an index.
    assert(fails("print(map([1], (a, b) -> a))").contains("takes 2 arguments and was given 1"))

@test
a_fault_inside_a_callback_is_the_programs_fault()
    // It travels out of the builtin exactly as any other does, carrying the line it was raised at.
    assert(fails("print(map([1, 2], x -> x.nope))").contains("`nope` is not something an integer can do"))
    assert(fails("print(filter([1], x -> nope))").contains("`nope`"))

@test
find_and_findIndex_answer_null_rather_than_a_sentinel()
    assert_eq(out("print(find([1, 5, 9], x -> x > 4))"), "5")
    assert_eq(out("print(findIndex([1, 5, 9], x -> x > 4))"), "1")

    // **Null and not -1**, which is the call `indexOf` already made: slate has a null and the `??`
    // that goes with it, so a sentinel would be an invented one a reader has to know.
    assert_eq(out("print(find([1, 2], x -> x > 9))"), "null")
    assert_eq(out("print(findIndex([1, 2], x -> x > 9))"), "null")
    assert_eq(out("print(findIndex([1, 2], x -> x > 9) ?? 0)"), "0")

@test
every_and_some_stop_as_soon_as_the_answer_is_settled()
    assert_eq(out("print(every([2, 4], x -> x % 2 == 0))"), "true")
    assert_eq(out("print(every([2, 3], x -> x % 2 == 0))"), "false")
    assert_eq(out("print(some([1, 2], x -> x > 1))"), "true")
    assert_eq(out("print(some([1, 2], x -> x > 9))"), "false")

    // What the two questions mean about nothing.
    assert_eq(out("print(every([], x -> false))"), "true")
    assert_eq(out("print(some([], x -> true))"), "false")

    // Stopping early is observable: the callback is not reached for what came after the answer.
    assert_eq(out("var n = 0\nprint(some([1, 2, 3], x -> \n    n = n + 1\n    x == 1))\nprint(n)"), "true\n1")

@test
SORTING_ORDERS_NUMBERS_AS_NUMBERS()
    // **JavaScript's most quoted defect.** `[10, 9].sort()` answers `[10, 9]` there, because the
    // default comparator renders both to text and compares those -- so "10" comes before "9". A
    // comparator should be needed only where the answer is genuinely ambiguous, and two numbers are
    // not.
    assert_eq(out("print(sorted([10, 9, 100, 1]))"), "[1, 9, 10, 100]")
    assert_eq(out("print(sorted([\"b\", \"a\", \"c\"]))"), "[\"a\", \"b\", \"c\"]")
    assert_eq(out("print(sorted([2.5, 1.5]))"), "[1.5, 2.5]")

    // A mixture has no order, and saying so beats inventing one.
    assert(fails("print(sorted([1, \"a\"]))").contains("does not apply to"))

@test
A_COMPARATOR_ANSWERS_A_BOOLEAN_BECAUSE_ZERO_IS_TRUE_HERE()
    assert_eq(out("print(sorted([1, 3, 2], (a, b) -> a > b))"), "[3, 2, 1]")

    // **The reason it cannot be JavaScript's number.** Only `null`, `undefined` and `false` are
    // false in slate, so `0` is true -- a comparator answering -1, 0 or 1 would read as "yes, yes,
    // yes" and sort nothing, with no complaint anywhere. A boolean cannot be misread, and anything
    // else is refused in a sentence naming what arrived.
    assert(fails("print(sorted([2, 1], (a, b) -> 1))").contains("a comparator answers whether the first value comes before the second"))
    assert(fails("print(sorted([2, 1], (a, b) -> 0))").contains("answered an integer"))

@test
sorting_is_stable_so_two_orderings_compose()
    // **An unstable sort loses the first ordering**, which is the whole reason a program sorts
    // twice. Merge sort is what makes this true rather than an accident of the input.
    val prog = "val xs = [{ n: \"b\", g: 1 }, { n: \"a\", g: 1 }, { n: \"c\", g: 0 }]\n" +
        "val byName = sorted(xs, (p, q) -> p.n < q.n)\n" +
        "print(map(sorted(byName, (p, q) -> p.g < q.g), p -> p.n))"

    assert_eq(out(prog), "[\"c\", \"a\", \"b\"]")

@test
THE_BARE_VERB_CHANGES_THE_ARRAY_AND_THE_PARTICIPLE_ANSWERS_A_NEW_ONE()
    // **JavaScript's `sort` and `reverse` mutate while `map` and `filter` do not, and nothing in
    // the name says which.** Python's `sorted(xs)` against `xs.sort()` is the fix, and slate holds
    // that convention for both pairs.
    assert_eq(out("val xs = [3, 1, 2]\nval ys = sorted(xs)\nprint(xs, ys)"), "[3, 1, 2] [1, 2, 3]")
    assert_eq(out("val xs = [3, 1, 2]\nsort(xs)\nprint(xs)"), "[1, 2, 3]")
    assert_eq(out("val xs = [1, 2, 3]\nval ys = reversed(xs)\nprint(xs, ys)"), "[1, 2, 3] [3, 2, 1]")
    assert_eq(out("val xs = [1, 2, 3]\nreverse(xs)\nprint(xs)"), "[3, 2, 1]")

@test
A_MUTATOR_NEVER_ANSWERS_THE_ARRAY_IT_CHANGED()
    // **So a mutation cannot be chained and mistaken for a fresh array.** JavaScript hands the array
    // back from `sort`, `reverse` and `push` alike, which is what makes its mutating and
    // non-mutating operations indistinguishable at the call site.
    assert_eq(out("print(sort([2, 1]))"), "null")
    assert_eq(out("print(reverse([1, 2]))"), "null")
    assert_eq(out("print(push([1], 2))"), "null")
    assert_eq(out("print(clear([1]))"), "null")
    assert_eq(out("print(insert([1], 0, 9))"), "null")

    // The two that take something out answer what they took, which is not the array.
    assert_eq(out("print(pop([1, 2]))"), "2")
    assert_eq(out("print(removeAt([1, 2], 0))"), "1")

@test
an_array_is_changed_in_place_by_name()
    assert_eq(out("val xs = [1]\npush(xs, 2)\nprint(xs)"), "[1, 2]")
    assert_eq(out("val xs = [1, 2, 3]\nprint(pop(xs), xs)"), "3 [1, 2]")
    assert_eq(out("val xs = [1, 3]\ninsert(xs, 1, 2)\nprint(xs)"), "[1, 2, 3]")
    assert_eq(out("val xs = [1, 2, 3]\nprint(removeAt(xs, 1), xs)"), "2 [1, 3]")
    assert_eq(out("val xs = [1, 2]\nclear(xs)\nprint(xs, len(xs))"), "[] 0")

    // A position past the end is a fault naming how many places there are.
    assert(fails("insert([1], 5, 0)").contains("was given the position 5, and this array has 1 places"))
    assert(fails("removeAt([1], 3)").contains("was given the position 3"))
    assert(fails("insert([1], -1, 0)").contains("the position -1"))

@test
POPPING_AN_EMPTY_ARRAY_IS_A_FAULT_AND_NOT_AN_ABSENT_VALUE()
    // **JavaScript answers `undefined`, which travels.** slate's `undefined` is the one value that
    // may not travel, so the honest answer is to say it where it happened rather than to hand back
    // something the next line has to refuse.
    assert(fails("pop([])").contains("there is nothing to pop off an empty array"))
    assert(fails("removeAt([], 0)").contains("there is nothing to remove from an empty array"))

@test
arrays_are_joined_flattened_and_added_up()
    assert_eq(out("print(concat([1], [2, 3]))"), "[1, 2, 3]")
    assert_eq(out("print(concat([1]))"), "[1]")
    assert_eq(out("print(concat([], []))"), "[]")

    // **One level and not all of them**, which is what JavaScript's default depth is: flattening a
    // tree of unknown depth is a different question, and doing it by accident to an array of pairs
    // loses the pairs.
    assert_eq(out("print(flat([[1, 2], [3]]))"), "[1, 2, 3]")
    assert_eq(out("print(flat([[[1]], [2]]))"), "[[1], 2]")
    assert_eq(out("print(flat([1, [2]]))"), "[1, 2]")

    assert_eq(out("print(sum([1, 2, 3]))"), "6")
    assert_eq(out("print(sum([]))"), "0")
    assert_eq(out("print(sum([1, 0.5]))"), "1.5")

    assert(fails("print(concat([1], 2))").contains("`concat` joins arrays, and one of these is an integer"))

@test
searching_an_array_uses_the_same_words_searching_a_string_does()
    // One question asked of two kinds, dispatched on what it was given rather than spelled twice.
    assert_eq(out("print(contains([1, 2], 2), contains(\"ab\", \"b\"))"), "true true")
    assert_eq(out("print(indexOf([1, 2, 1], 1), indexOf(\"aba\", \"a\"))"), "0 0")
    assert_eq(out("print(lastIndexOf([1, 2, 1], 1), lastIndexOf(\"aba\", \"a\"))"), "2 2")
    assert_eq(out("print(indexOf([1], 9))"), "null")

    // Equality is slate's, so a structure is found by what it holds and not by identity.
    assert_eq(out("print(contains([{ n: 1 }], { n: 1 }))"), "true")

@test
A_BUILTIN_METHOD_IS_THE_FREE_FUNCTION_WITH_THE_RECEIVER_IN_FRONT()
    // One implementation, one set of argument checks, one diagnostic -- reachable two ways.
    assert_eq(out("print([1, 2].map(x -> x + 1))"), "[2, 3]")
    assert_eq(out("print(map([1, 2], x -> x + 1))"), "[2, 3]")
    assert_eq(out("print([3, 1].sorted())"), "[1, 3]")
    assert_eq(out("print(\"a,b\".split(\",\"))"), "[\"a\", \"b\"]")
    assert_eq(out("print(\" x \".trim().upper())"), "X")
    assert_eq(out("print([1, 2].len(), \"ab\".len())"), "2 2")
    assert_eq(out("print((3.7).floor(), (0 - 2).abs())"), "3 2")

    // A method on its own is the plain builtin, exactly as `o.m` on an object is the plain function.
    assert_eq(out("val f = [1].len\nprint(f([1, 2, 3]))"), "3")

@test
A_METHOD_IS_LOOKED_UP_BY_THE_KIND_OF_THE_RECEIVER()
    // **The refusal names the kind, not the argument.** Reaching `upper` and complaining about what
    // it was given would send the reader to look at the value when what is wrong is the call.
    assert(fails("print([1].upper())").contains("`upper` is not something an array can do"))
    assert(fails("print(\"a\".push(1))").contains("`push` is not something a string can do"))
    assert(fails("print((1).map(x -> x))").contains("`map` is not something an integer can do"))
    assert(fails("print(true.len())").contains("`len` is not something a boolean can do"))

    // The same sentence without the call, since a builtin's set of names is closed either way.
    assert(fails("print([1].nope)").contains("`nope` is not something an array can do"))

@test
A_PROGRAM_MAY_NOT_ADD_TO_A_BUILTIN_TYPES_METHODS()
    // **The table is in the interpreter and is not an object a program can reach**, which settles by
    // construction what JavaScript settles by convention. Patching `Array.prototype` is what every
    // `hasOwnProperty` guard in node's ecosystem is defending against; slate has nowhere to patch.
    assert(fails("[1].proto = { double: xs -> xs }").contains("a field belongs to an object, and this is an array"))
    assert(fails("val p = [1].proto").contains("`proto` is not something an array can do"))

    // A program that wants its own array operation writes a function, which is what a function is
    // for -- and it composes with the builtins without being one.
    assert_eq(out("second(xs) = xs[1]\nprint(second([1, 2, 3].map(x -> x * 10)))"), "20")

@test
AN_OBJECTS_NAMES_BELONG_TO_THE_PROGRAM_AND_NOT_TO_A_TABLE()
    // **An object is deliberately absent from the method table.** A builtin answering there would
    // make every object claim to have a `keys`, a `len` and a `has` that nothing put on it -- so
    // `o.keys ?? fallback` would stop working for exactly those names, silently and only for those.
    // Objects already have a method mechanism, which is `proto`.
    assert_eq(out("print({ n: 1 }.keys ?? \"absent\")"), "absent")
    assert_eq(out("print(keys({ n: 1 }), len({ n: 1 }))"), "[\"n\"] 1")
    assert(fails("print({ n: 1 }.keys())").contains("`keys` is not a field of this object"))

    // And a proto is how an object gets one, unchanged by any of this.
    assert_eq(out("val shape = { area: s -> s.w * s.h }\nprint({ proto: shape, w: 2, h: 3 }.area())"), "6")

@test
a_builtin_walking_an_array_survives_a_collection_inside_its_callback()
    // **A sysl `Buf` of values is not a root**, so a callback that allocates could collect
    // everything mapped so far. The result array is a collected object and is held, and each answer
    // is pushed into it as it arrives -- which is what makes it reachable.
    val prog = "val xs = []\n" +
        "for i in 0..<400\n" +
        "    push(xs, i)\n" +
        "val ys = map(xs, i -> s\"item ${i} of ${len(xs)}\")\n" +
        "print(len(ys), ys[0], ys[399])"

    assert_eq(out(prog), "400 item 0 of 400 item 399 of 400")

@test
an_argument_of_the_wrong_kind_says_what_was_wanted()
    assert(fails(Opaque + "map(anything(1), x -> x)").contains("`map` takes an array, and this is an integer"))
    assert(fails(Opaque + "anything(map)([1])").contains("`map` takes an array and a function, and was given 1 argument"))
    assert(fails(Opaque + "anything(reduce)([1], (a, b) -> a)").contains("an array, a function and a starting value"))
    assert(fails(Opaque + "anything(sorted)([1], 2, 3)").contains("an array and an optional comparator"))
    assert(fails(Opaque + "sum(anything(\"a\"))").contains("`sum` takes an array"))

@test
A_CALLBACK_THAT_CHANGES_THE_ARRAY_IT_IS_WALKING_IS_TOLD_SO()
    // **Without this it is a sysl panic**, naming a `Buf` index and no line of the program: the loop
    // bound is read once, so an element removed part-way through leaves the next read past the end.
    // JavaScript's answer is quieter and worse -- `map` visits whatever survives and leaves holes,
    // so the mistake becomes a short array nobody traces back to the callback that caused it.
    val said = fails("val xs = [1, 2, 3, 4]\nprint(map(xs, x -> \n    pop(xs)\n    x))")

    assert(said.contains("this array was changed while `map` was walking it"))

    // The message names the fix, since a reader who believes it still has to know what to do.
    assert(said.contains("walk a copy of it, or build a new array"))

    // Every walk that can reach a program is guarded, not only the written-callback ones.
    assert(fails("val xs = [1, 2]\nfilter(xs, x -> \n    clear(xs)\n    true)").contains("`filter` was walking it"))
    // Written with the function named first, a block lambda having to be the last argument.
    val folding = "val xs = [1, 2]\nval f = (a, b) -> \n    pop(xs)\n    a\nreduce(xs, f, 0)"

    assert(fails(folding).contains("`reduce` was walking it"))
    assert(fails("val xs = [1, 2]\nfind(xs, x -> \n    push(xs, 3)\n    false)").contains("`find` was walking it"))
    assert(fails("val xs = [1, 2]\nevery(xs, x -> \n    pop(xs)\n    true)").contains("`every` was walking it"))
    assert(fails("val xs = [3, 1, 2, 5, 4]\nsort(xs, (a, b) -> \n    pop(xs)\n    a < b)").contains("`sort` was walking it"))

    // Including the ones whose only re-entry is a user `equals` reached from `same`.
    val hooked = "val probe = { n: 1, equals: o -> \n    clear(xs)\n    false }\n" +
        "val xs = [probe, probe, probe]\n" +
        "print(contains(xs, { n: 1 }))"

    assert(fails(hooked).contains("`contains` was walking it"))

// -- a binding that takes a value apart -------------------------------------------------------------

@test
a_binding_may_take_an_array_or_an_object_apart()
    assert_eq(out("val [a, b] = [1, 2]\nprint(a, b)"), "1 2")
    assert_eq(out("val { name, born } = { name: \"Ada\", born: 1815 }\nprint(name, born)"), "Ada 1815")

    // The long form renames, and the short one is the shorthand every language with this grows.
    assert_eq(out("val { name: who } = { name: \"Grace\" }\nprint(who)"), "Grace")

    // The same patterns a `match` arm is written with, so nesting and `...` come for free.
    assert_eq(out("val [first, ...rest] = [1, 2, 3]\nprint(first, rest)"), "1 [2, 3]")
    assert_eq(out("val { p: { q } } = { p: { q: 7 } }\nprint(q)"), "7")
    assert_eq(out("val [[m, n]] = [[1, 2]]\nprint(m, n)"), "1 2")

@test
a_destructuring_var_may_be_written_to_and_a_val_may_not()
    assert_eq(out("var [x, y] = [1, 2]\nx = 10\nprint(x, y)"), "10 2")
    assert(fails("val [a] = [1]\na = 2").contains("`a` is a `val`, so it is written once"))

    // A gathered tail follows the same rule as the names beside it.
    assert_eq(out("var [h, ...t] = [1, 2, 3]\nt = []\nprint(h, t)"), "1 []")

@test
a_binding_may_carry_a_default_for_what_the_subject_did_not_supply()
    assert_eq(out("val { a = 1, b } = { b: 2 }\nprint(a, b)"), "1 2")
    assert_eq(out("val { a: seen = \"none\" } = {}\nprint(seen)"), "none")
    assert_eq(out("val [x, y = 9] = [1]\nprint(x, y)"), "1 9")
    assert_eq(out("val [x, y = 9] = [1, 2]\nprint(x, y)"), "1 2")

    // A parameter takes its argument apart the same way, which is what this was built for.
    assert_eq(out("f({ title = \"Untitled\", size = 1 }) = title + \" \" + string(size)\nprint(f({}), f({ title: \"x\", size: 3 }))"),
              "Untitled 1 x 3")

    // A `for` head and a `var` binding, both of which are the same `Unpack`.
    assert_eq(out("for { n, tag = \"?\" } in [{ n: 1 }, { n: 2, tag: \"b\" }]\n    print(n, tag)"), "1 ?\n2 b")
    assert_eq(out("var { m = 5 } = {}\nm = m + 1\nprint(m)"), "6")

@test
A_DEFAULT_FIRES_ON_ABSENCE_AND_ON_NOTHING_ELSE()
    // **The trap every language with defaults has**, and slate is built so that it cannot fall into
    // it: JavaScript's `x || 1` takes the default for `0`, `false` and `""`, and even `x ?? 1` takes
    // it for a `null` the caller meant. A field that is THERE is bound, whatever it holds.
    assert_eq(out("val { a = 1 } = { a: 0 }\nprint(a)"), "0")
    assert_eq(out("val { a = 1 } = { a: false }\nprint(a)"), "false")
    assert_eq(out("val { a = 1 } = { a: \"\" }\nprint(a)"), "")
    assert_eq(out("val { a = 1 } = { a: null }\nprint(a)"), "null")

    // The reason it cannot go wrong is the mechanism rather than care: slate refuses to store
    // `undefined`, so a name nobody supplied is simply NOT BOUND, and the question the emitted code
    // asks is about the scope and not about the value. It is `JumpIfBound`, which is what a default
    // parameter already used.
    assert_eq(out("f(a = 1) = a\nprint(f(0), f(false), f(null))"), "0 false null")

@test
A_DEFAULT_IS_WORKED_OUT_WHERE_THE_BINDING_IS()
    // **Which is the rule a parameter's default already has**, and it is what makes the two worth
    // spelling the same way. A default sees every name bound to its left.
    assert_eq(out("f({ width, height = width }) = width * height\nprint(f({ width: 3 }), f({ width: 3, height: 2 }))"), "9 6")

    // And each binding gets a value of its own rather than one made when the pattern was written.
    assert_eq(out("f({ xs = [] }) =\n    push(xs, 1)\n    xs\nprint(f({}), f({}))"), "[1] [1]")

@test
A_DEFAULT_BELONGS_TO_A_BINDING_AND_IS_REFUSED_WHERE_A_PATTERN_IS_A_TEST()
    // **A default would make an arm match a value that does not have the field**, so an arm carrying
    // one always matches -- which is a trap rather than a shorthand. A binding has no next arm to
    // fall through to, which is exactly why it is useful there and nowhere else.
    assert(fails("val v = { a: 1 }\nprint(v match\n    { a = 1 } -> \"yes\")").contains("a default belongs to a binding and not to a `match` arm"))
    assert(fails("val v = {}\nprint(v is { a = 1 })").contains("a default belongs to a binding and not to `is`"))

    // A default has to have a name to give the value to.
    assert(fails("val { a: [b] = 1 } = { a: [2] }").contains("a default belongs to a name"))

    // **In an array the defaults must be last**, which is the rule a parameter list already has: for
    // a one-element array, `[a = 1, b]` has no answer for which of the two the element went to.
    assert(fails("val [a = 1, b] = [1, 2]").contains("an element with no default may not come after one that has a default"))

@test
A_FIELD_MARKED_QUESTION_MAY_BE_MISSING_AND_IS_CHECKED_WHERE_IT_IS_NOT()
    // **The one thing an optional field must not become is "anything".** A shape that stopped
    // checking `pinned` the moment it was allowed to be absent would accept a request body carrying
    // a `pinned` of the wrong kind, which is the case the check exists for.
    val shape = "type Note = { title: string, pinned?: boolean }\n"

    assert_eq(out(shape + "print({ title: \"a\" } is Note)"), "true")
    assert_eq(out(shape + "print({ title: \"a\", pinned: true } is Note)"), "true")
    assert_eq(out(shape + "print({ title: \"a\", pinned: 4 } is Note)"), "false")

    // A field with no `?` is still required, which is what says the mark did something.
    assert_eq(out(shape + "print({ pinned: true } is Note)"), "false")

    // **A nullable union is NOT this, and that is why the mark was needed.** `tag: string | null`
    // still requires the key to be there holding a null; nothing before `?` could say "or absent".
    assert_eq(out("type T = { tag: string | null }\nprint({ tag: null } is T, {} is T)"), "true false")

    // It nests, an inner object pattern being an ordinary pattern.
    assert_eq(out("type T = { home: { city?: string } }\nprint({ home: {} } is T, { home: { city: 4 } } is T)"),
        "true false")

    // And a `match` arm takes it, which is the other pattern-as-a-test position.
    assert_eq(out("print({ a: 1 } match\n    { a, b? } -> \"yes\"\n    _ -> \"no\")"), "yes")

@test
QUESTION_IS_FOR_A_PATTERN_THAT_TESTS_AS_A_DEFAULT_IS_FOR_ONE_THAT_BINDS()
    // **The mirror of the rule above it, and the pair is the whole design.** A default says what an
    // absent field binds, which only a binding can use; a `?` says nothing happens, which only a
    // test can use. A name a binding left unbound would fault at whichever later line read it, with
    // nothing there to say the binding was the cause -- so it is refused where it is written.
    assert(fails("val { title, pinned? } = { title: \"a\" }").contains("`?` says a field may be missing"))
    assert(fails("val { title, pinned? } = { title: \"a\" }").contains("write `= something`"))

    // A parameter is the same refusal, the parser having desugared it into the same `Unpack`.
    assert(fails("f({ a? }) = 1\nprint(f({}))").contains("`?` says a field may be missing"))

    // And a `for` head, which is the third binding position.
    assert(fails("for { a? } in [{}]\n    print(1)").contains("a `for` head binds"))

    // **A field says one or the other and never both**, there being no reading that uses each.
    assert(fails("val v = {}\nprint(v is { a? = 1 })").contains("says both `?` and a default"))

@test
AN_INTERSECTION_MATCHES_WHERE_EVERY_PART_DOES_AND_BINDS_WHAT_ALL_OF_THEM_BIND()
    // **`|`'s dual, and what a composition of guards leaves a handler to describe.** Each layer adds
    // fields, so the value at the bottom is the sum -- and without a way to say the sum it is
    // written out by hand and drifts from the layers that make it.
    val shapes = "type Authed = { user: { id: integer } }\ntype Noted = { body: string }\n"

    assert_eq(out(shapes + "print({ user: { id: 1 }, body: \"b\" } is Authed & Noted)"), "true")
    assert_eq(out(shapes + "print({ user: { id: 1 } } is Authed & Noted)"), "false")
    assert_eq(out(shapes + "print({ body: \"b\" } is Authed & Noted)"), "false")

    // It is an ordinary annotation, so a parameter takes the sum of what the guards added.
    assert_eq(out(shapes + "f(r: Authed & Noted) = r.user.id\nprint(f({ user: { id: 7 }, body: \"b\" }))"), "7")

    // **A part MAY bind, where an alternative may not**, and the asymmetry is the whole difference:
    // every part runs, so what one binds is bound whenever the pattern matched at all.
    assert_eq(out("print({ a: 1, b: 2 } match\n    { a } & { b } -> a + b\n    _ -> 0)"), "3")

    // A kind test and a literal intersect like anything else.
    assert_eq(out("print(1 match\n    integer & 1 -> \"one\"\n    _ -> \"no\")"), "one")

@test
AND_BINDS_TIGHTER_THAN_OR_AND_A_BARE_NAME_IN_ONE_IS_STILL_DEFERRED()
    // **`A & B | C` is `(A & B) | C`**, which is what every language carrying both gives it.
    val shapes = "type A = { a: integer }\ntype B = { b: integer }\ntype C = { c: integer }\n"

    assert_eq(out(shapes + "print({ a: 1, b: 2 } is A & B | C)"), "true")
    assert_eq(out(shapes + "print({ c: 3 } is A & B | C)"), "true")
    assert_eq(out(shapes + "print({ a: 1 } is A & B | C)"), "false")

    // **THE PARSER MAY NOT JUDGE A BARE NAME AND THAT DEFERRAL HAD TO REACH THROUGH `&`.** An
    // alternative may not bind, and an intersection of two names that turn out to be types binds
    // nothing -- but only `resolve_pattern` knows that, so the first draft refused every one of the
    // three lines above. `still_might_be_types` is the deferral, and this test is what found it.
    assert(fails("type C = { c: integer }\nprint({ c: 1 } is { a } & C | C)").contains("an alternative of a pattern may not bind a name"))

    // And the annotation guard reaches through one, naming the part that is not a type rather than
    // the whole -- a reader told the intersection is wrong looks at the half that is fine.
    assert(fails("type C = { c: integer }\nf(x: Nope & C) = 1\nprint(f({ c: 1 }))").contains("`Nope` is not a type"))

@test
A_REST_PARAMETER_GATHERS_WHAT_IS_LEFT_OVER()
    // **slate could SPREAD at a call and could not GATHER at a definition**, which is the asymmetry
    // this closes -- and the refusal a reader met was `this cannot be assigned to`, the parser
    // having read the whole head as a target.
    assert_eq(out("f(a, ...rest) = toJSON([a, rest])\nprint(f(1))"), "[1,[]]")
    assert_eq(out("f(a, ...rest) = toJSON([a, rest])\nprint(f(1, 2, 3))"), "[1,[2,3]]")

    // **It is bound to an EMPTY array where a call gave nothing left over**, never left unbound --
    // which is what makes a default on it meaningless and is why one is refused.
    assert_eq(out("f(...xs) = len(xs)\nprint(f(), f(1, 2))"), "0 2")

    // It composes with the spread at a call, which is the counterpart it never had.
    assert_eq(out("f(...xs) = len(xs)\nval a = [1, 2, 3]\nprint(f(...a))"), "3")

    // A lambda takes one on the same terms, `rest_parameter` being one function for both lists.
    assert_eq(out("val g = (a, ...rest) -> len(rest)\nprint(g(1), g(1, 2, 3))"), "0 2")

    // **A DEFAULT BEFORE IT IS FINE, and the first draft refused it wrongly.** Arguments fill the
    // fixed parameters left to right and the rest takes what is past them, so there is nothing for
    // the ambiguity an array pattern has to arise from.
    val h = "h(a, b = 9, ...rest) = toJSON([a, b, rest])\n"

    assert_eq(out(h + "print(h(1))"), "[1,9,[]]")
    assert_eq(out(h + "print(h(1, 2))"), "[1,2,[]]")
    assert_eq(out(h + "print(h(1, 2, 3, 4))"), "[1,2,[3,4]]")

    // **An `async` function and a generator gather too**, the gather being above the three ways out
    // of `invoke`: a rest parameter belongs to the function rather than to how it is entered.
    assert_eq(out("async w(...xs) = len(xs)\nasync main()\n    print(await w(1, 2, 3))\nmain()"), "3")
    assert_eq(out("g(...xs)\n    for x in xs\n        yield x\nval it = g(4, 5)\nprint(next(it).value, next(it).value)"),
        "4 5")

    // A class's own `new` and an ordinary method.
    assert_eq(out("class T\n    new(var name, ...tags) = 1\n\n    say(self, ...more) = self.name + toJSON(more)\n\nval t = T(\"a\", \"x\")\nprint(t.name, t.say(1))"),
        "a a[1]")

@test
A_REST_PARAMETER_IS_LAST_TAKES_NO_DEFAULT_AND_HAS_NO_UPPER_ARITY()
    // **Nothing may follow it**, which is the array pattern's rule for the array pattern's reason:
    // what is left over has no end to be counted from.
    assert(fails("f(...rest, z) = 1\nprint(f(1))").contains("nothing may follow it"))

    // **A default on it could never fire**, it being bound to an empty array where a call gave
    // nothing -- so there is no "not given" for a default to answer.
    assert(fails("f(...rest = []) = 1\nprint(f())").contains("could never be used"))

    // **A call cannot give too many, so the only end left to name is the floor.** Saying an upper
    // one would name a number the function does not have -- and both the checker and the machine
    // have to say it the same way.
    assert(fails("f(a, b, ...rest) = 1\nprint(f(1))").contains("takes at least 2 arguments"))
    assert(fails(Opaque + "f(a, b, ...rest) = 1\nprint(anything(f)(1))").contains("takes at least 2 arguments"))

    // And a call that gives more is not refused by either.
    assert_eq(out("f(a, ...rest) = len(rest)\nprint(f(1, 2, 3, 4, 5))"), "4")

@test
AN_OBJECT_MAY_ANSWER_FOR_AN_OPERATOR_AND_THE_LEFT_OPERAND_DECIDES()
    // **`equals` and `hash` were already proto hooks looked up by name**, so the mechanism existed
    // and this widens it. The words are words for the reason those two are: a class body reads
    // `plus(self, o) = ...` with the definition syntax it already has.
    val money = "class M\n    var c\n\n    plus(self, o) = M(self.c + o.c)\n    minus(self, o) = M(self.c - o.c)\n" +
        "    times(self, n) = M(self.c * n)\n    dividedBy(self, n) = M(self.c / n)\n" +
        "    remainder(self, n) = M(self.c % n)\n    negated(self) = M(-self.c)\n" +
        "    compare(self, o) = self.c - o.c\n\nval a = M(500)\nval b = M(125)\n"

    assert_eq(out(money + "print((a + b).c, (a - b).c, (a * 3).c, (a / 2).c, (a % 300).c)"),
        "625 375 1500 250 200")
    assert_eq(out(money + "print((-a).c)"), "-500")

    // **Ordering is ONE hook and not four**, `compare` answering a number whose sign the four read.
    assert_eq(out(money + "print(a < b, a > b, a <= a, a >= a)"), "false true true true")

    // So sorting falls out of it, a comparator being an ordinary `<`.
    assert_eq(out(money + "print(map(sorted([a, b], (x, y) -> x < y), m -> m.c))"), "[125, 500]")

    // **An inherited hook works**, the receiver rule handing the object to a method reached through
    // a proto -- which is what lets it be written as a method at all.
    assert_eq(out(money + "class C from M\n    new(var c) = 1\n\nprint((C(1) + C(2)).c)"), "3")

    // **THE LEFT OPERAND DECIDES AND THE RIGHT IS NEVER ASKED**, which is `equals`'s rule already:
    // there is no reflected form, so a number on the left is a number on the left.
    assert(fails(money + "print(2 * a)").contains("`*` does not apply to an integer and an object"))

    // A hook can never shadow what an operator already means -- it is the last thing tried.
    assert_eq(out(money + "print(1 + 2, \"a\" + \"b\")"), "3 ab")

    // An operator the class does not answer for says what it always said.
    assert(out(money + "print((a & b) catch e -> e.message)").contains("`&` does not apply"))

    // **`compare` must answer a NUMBER**, and a hook that does not is named rather than believed.
    assert(fails("class B\n    var n\n\n    compare(self, o) = true\n\nprint(B(1) < B(2))").contains("it answers a number below, at or above zero"))

@test
EVERY_HOOK_TAKES_THE_RECEIVER_NOW_AND_equals_WAS_THE_LAST_HOLDOUT()
    // **The asymmetry this used to pin is gone.** `equals` and `hash` were handed no receiver, so a
    // class could not write either as a method -- one reached through the chain was called with one
    // argument and died on the arity. That was a compatibility scar kept for the capture-style hook
    // used as a `proto`, and the object model is what made widening it worth the break.
    assert_eq(out("class M\n    var c\n\n    equals(self, o) = o is M && self.c == o.c\n\nprint(M(1) == M(1), M(1) == { c: 1 })"),
        "true false")

    assert_eq(out("class K\n    var v\n\n    hash(self) = 7\n    equals(self, o) = true\n\nvar t = {}\nt[K(1)] = \"s\"\nprint(t[K(2)], len(t))"),
        "s 1")

    // **A hook reached through an ordinary `proto` takes it too**, there being one rule and not one
    // rule per hook: `{ equals: (self, o) -> ... }` is how a shared one is written.
    assert_eq(out("val Keyed = { hash: (self) -> 7, equals: (self, o) -> true }\nvar t = {}\nt[{ v: 1, proto: Keyed }] = \"s\"\nprint(t[{ v: 2, proto: Keyed }], len(t))"),
        "s 1")

    // Where a hook is captured on the object instead, it takes no receiver -- the rule is about
    // where the function was FOUND, which is `CallMethod`'s rule exactly.
    assert_eq(out("val v = { n: 1, plus: o -> o.n + 1 }\nprint(v + { n: 4 })"), "5")
    assert_eq(out("print({ n: 1, equals: o -> true } == { z: 9 })"), "true")

@test
EVERY_OPERATOR_NAMES_ITSELF_IN_A_COMPLAINT_AND_SIX_OF_THEM_DID_NOT()
    // **`op_text` had `_ -> \"?\"` and the six bitwise operators fell into it**, so `v & w` on two
    // objects said *"`?` does not apply to an object and an object"* -- a sentence naming an
    // operator slate does not have, about a line holding one it does.
    assert(fails("val a = { }\nprint(a & a)").contains("`&` does not apply"))
    assert(fails("val a = { }\nprint(a | a)").contains("`|` does not apply"))
    assert(fails("val a = { }\nprint(a ^ a)").contains("`^` does not apply"))
    assert(fails("val a = { }\nprint(a << a)").contains("`<<` does not apply"))
    assert(fails("val a = { }\nprint(a >> a)").contains("`>>` does not apply"))

@test
ARRAY_OF_T_IS_HOW_A_LIST_IS_DESCRIBED_AND_NOTHING_COULD_SAY_IT_BEFORE()
    // **`...` tests the elements it writes and waves the rest through**, so a list of unknown
    // length -- the commonest thing in a request body -- had no spelling at all. This is the
    // regression that says so: it was `true` before `array of` existed.
    assert_eq(out("print([\"a\", 2] is [string, ...])"), "true")
    assert_eq(out("type T = array of string\nprint([\"a\", 2] is T)"), "false")

    val tags = "type Tags = array of string\n"

    assert_eq(out(tags + "print([\"a\", \"b\"] is Tags, \"no\" is Tags)"), "true false")

    // **An EMPTY container fits, which is the reading a test wants**: every element of nothing fits
    // anything, and a shape refusing `[]` would refuse the ordinary answer to a query that found
    // nothing.
    assert_eq(out(tags + "print([] is Tags)"), "true")

    // **A floor is said with an intersection**, which is `&` earning its place a second time.
    assert_eq(out(tags + "print([] is [any, ...] & Tags, [\"a\"] is [any, ...] & Tags)"), "false true")

    // `object of T` is the other half: an object's VALUES, its keys being the program's.
    val counts = "type Counts = object of integer\n"

    assert_eq(out(counts + "print({ a: 1 } is Counts, { a: \"x\" } is Counts, {} is Counts)"), "true false true")

    // It nests, an element being an ordinary pattern -- which is what `array of T` buys over a word.
    assert_eq(out("type G = array of array of integer\nprint([[1], [2]] is G, [[1], [\"x\"]] is G)"), "true false")
    assert_eq(out("type U = { name: string }\ntype Us = array of U\nprint([{ name: \"a\" }] is Us, [{ name: 1 }] is Us)"),
        "true false")

    // An ordinary annotation and an ordinary match arm.
    assert_eq(out("count(xs: array of integer) = len(xs)\nprint(count([1, 2, 3]))"), "3")
    assert_eq(out("print([1] match\n    array of string -> \"strings\"\n    array of integer -> \"integers\"\n    _ -> \"no\")"),
        "integers")

    // **`of` is read only after `array` or `object` in pattern position**, so it stays an ordinary
    // name everywhere -- which is the same bargain `end` and `type` get.
    assert_eq(out("val of = 5\nprint(of)"), "5")
    assert_eq(out("of(x) = x + 1\nprint(of(1))"), "2")

@test
AN_ELEMENT_PATTERN_MAY_NOT_BIND_AND_THE_MESSAGE_LEADS_WITH_THE_LIKELY_CAUSE()
    // **An element pattern runs once per element**, so a name in one would be bound to whichever
    // element ran last -- a value nobody asked for. It cannot be refused while parsing, a bare name
    // being a type where one was declared, so `resolve_pattern` is where it is caught.
    val said = fails("f(xs: array of Nope) = 1\nprint(f([]))")

    // **The message leads with "is not a type", which is nearly always the cause.** A reader told
    // only that an element pattern may not bind goes and looks at binding, when what they wrote was
    // a type name that is not one.
    assert(said.contains("`Nope` is not a type"))
    assert(said.contains("bind it once per element rather than test anything"))

    // Every route to a pattern is caught, not only an annotation: a declaration and a match arm.
    assert(fails("type T = array of n\nprint(1)").contains("`n` is not a type"))
    assert(fails("print([1] match\n    array of n -> n\n    _ -> 0)").contains("`n` is not a type"))

    // The shorthand binds, so `{ a? }` under one is refused with the name it would have bound.
    assert(fails("val v = []\nprint(v is array of { a? })").contains("`a` is not a type"))

@test
A_MISMATCH_UNDER_ARRAY_OF_NAMES_THE_ELEMENT_THAT_DOES_NOT_FIT()
    // The whole reason this feature had to exist: `mismatch` shipped in 0.0.7 and could say nothing
    // about a list, which is the commonest thing in a request body.
    assert_eq(out("type Tags = array of string\nprint(Tags.mismatch([\"a\", 2, false]))"),
        "[{path: \"1\", wanted: \"string\", got: \"integer\"}, {path: \"2\", wanted: \"string\", got: \"boolean\"}]")

    // The path reaches through, an element being an ordinary pattern.
    assert_eq(out("type U = { name: string }\ntype Us = array of U\nprint(Us.mismatch([{ name: 1 }]))"),
        "[{path: \"0.name\", wanted: \"string\", got: \"integer\"}]")

    // An object's entry is named by its KEY, which is the path an ordinary object pattern builds.
    assert_eq(out("type C = object of integer\nprint(C.mismatch({ a: 1, b: \"x\" }))"),
        "[{path: \"b\", wanted: \"integer\", got: \"string\"}]")

    // **The container is reported OR its elements are.** A value that is not an array has nothing
    // to say about element three.
    assert_eq(out("type Tags = array of string\nprint(Tags.mismatch(\"no\"))"),
        "[{path: \"\", wanted: \"array\", got: \"string\"}]")
    assert_eq(out("type C = object of integer\nprint(C.mismatch([1]))"),
        "[{path: \"\", wanted: \"object\", got: \"array\"}]")

@test
A_DECLARED_TYPE_IS_A_VALUE_UNDER_ITS_OWN_NAME()
    // **A `type` name was the only name in slate that bound nothing**, a class, a data type and a
    // variant each already being a shape and a value under one name -- which is why this breaks no
    // program. Without it the framework API that asked for it, `body(NewNote, handler)`, could not
    // be written at all: there was no way to spell the first argument.
    val note = "type NewNote = { title: string, text: string }\n"

    assert_eq(out(note + "print(NewNote)"), "<shape NewNote>")
    assert_eq(out(note + "print(NewNote.name())"), "NewNote")
    assert_eq(out(note + "print(NewNote is shape)"), "true")

    // **A shape is its declaration, so two types written the same way are two types.** That is the
    // opposite of `regex("a") == regex("a")`, and the right way round for each: a pattern text is
    // all a regular expression is.
    assert_eq(out(note + "type Same = { title: string, text: string }\nprint(NewNote == NewNote, NewNote == Same)"),
        "true false")

    // **Passing one is the whole point.** A shape carried into a function still answers there.
    assert_eq(out(note + "fits(shape, v) = shape.test(v)\nprint(fits(NewNote, { title: \"a\", text: \"b\" }))"), "true")

    // **The structure is not readable back out**, which is what keeps "a type costs nothing at run
    // time" true in the sense that mattered: three names and no fourth.
    assert(fails(note + "print(NewNote.keys())").contains("`keys` is not something a shape can do"))

@test
A_SHAPE_TESTS_A_VALUE_AND_A_MISMATCH_SAYS_WHAT_IS_WRONG_WITH_IT()
    val note = "type NewNote = { title: string, text: string, pinned?: boolean }\n"

    assert_eq(out(note + "print(NewNote.test({ title: \"a\", text: \"b\" }))"), "true")

    // An object pattern is PARTIAL, which is exactly right for a request body.
    assert_eq(out(note + "print(NewNote.test({ title: \"a\", text: \"b\", extra: 1 }))"), "true")
    assert_eq(out(note + "print(NewNote.test({ title: 4, text: \"b\" }))"), "false")

    // **`mismatch` COLLECTS rather than stopping at the first**, which is the whole difference from
    // `test`: a person filling in a form wants all four fields at once, and an API answering one
    // problem per request is one somebody has to call five times.
    assert_eq(out(note + "print(NewNote.mismatch({ title: 4 }))"),
        "[{path: \"title\", wanted: \"string\", got: \"integer\"}, {path: \"text\", wanted: \"string\", got: \"nothing\"}]")

    // A value that fits has nothing wrong with it, and an absent optional field is not a problem.
    assert_eq(out(note + "print(NewNote.mismatch({ title: \"a\", text: \"b\" }))"), "[]")

    // **The path names where in the value the problem is**, and `""` is the value itself.
    assert_eq(out("type D = { user: { name: string } }\nprint(D.mismatch({ user: { name: 1 } }))"),
        "[{path: \"user.name\", wanted: \"string\", got: \"integer\"}]")
    assert_eq(out(note + "print(NewNote.mismatch(7))"), "[{path: \"\", wanted: \"object\", got: \"integer\"}]")

    // **An array reports its LENGTH or its elements and never both**, the wrong length having
    // nothing useful to say about element three.
    assert_eq(out("type P = [integer, integer]\nprint(P.mismatch([1, \"x\"]))"),
        "[{path: \"1\", wanted: \"integer\", got: \"string\"}]")
    assert_eq(out("type P = [integer, integer]\nprint(P.mismatch([1]))"),
        "[{path: \"\", wanted: \"[integer, integer]\", got: \"an array of 1\"}]")

    // Every part of an intersection is walked, so a value failing both is told about both.
    assert_eq(out("type B = { a: integer } & { b: string }\nprint(B.mismatch({ a: \"x\" }))"),
        "[{path: \"a\", wanted: \"integer\", got: \"string\"}, {path: \"b\", wanted: \"string\", got: \"nothing\"}]")

    // **A data value is named by its VARIANT and a variant's fields are walked**, `object` being
    // true of it and telling a reader nothing. The nominal half is asked first: a value made by the
    // wrong variant has nothing to say about field two.
    val shape = "data S\n    Sq(w)\n    Nil2\n\ntype M = Sq(integer)\n"

    assert_eq(out(shape + "print(M.mismatch(Sq(\"w\")))"), "[{path: \"w\", wanted: \"integer\", got: \"string\"}]")
    assert_eq(out(shape + "print(M.mismatch(Nil2))"), "[{path: \"\", wanted: \"Sq(integer)\", got: \"Nil2\"}]")

    // **A shape's methods are its own and are not globals**, `test` and `name` being words a program
    // wants for itself -- so asking `test` of anything else is a complaint about the receiver.
    assert(fails("print(1 .test(2))").contains("`test` is not something an integer can do"))

@test
A_TYPE_CROSSES_A_FILE_AS_A_VALUE_AND_STILL_RESOLVES_AS_A_SHAPE()
    // **The import used to SKIP a name it knew to be a type**, the module having no field of that
    // name -- and a class, which is a type and a value at once, was the hole that made. That skip is
    // gone: `export type` puts the name in the export list like any other, so there is one rule for
    // every import and no list of exceptions.
    assert_eq(ran_out("tests/mods/uses_shape.sl"),
        "Point\ntrue\n[{path: \"y\", wanted: \"number\", got: \"nothing\"}]\ntrue\ntrue false")

    // **`export type` is what puts the name in the list**, so one written without it is no more
    // importable than an unexported `val` -- which is the half of the old arrangement that stayed.
    assert(ran_fault("tests/mods/wants_private_type.sl").contains("does not export `Secret`"))

@test
A_SHAPE_NAMING_A_CLASS_FINDS_IT_WHERE_THE_TYPE_WAS_DECLARED()
    // **A pattern may name a class and `ProtoPat` looks that name up in a scope as it matches**, so
    // a shape tested inside a function it was passed to would look in the wrong scope and -- a
    // pattern having nowhere to report from -- quietly match nothing. The slot holds the scope the
    // declaration ran in, which answers the question where it was asked.
    val src = "class Circle\n    var r\n\ntype H = { c: Circle }\nasked(s, v) = s.test(v)\n"

    assert_eq(out(src + "print(asked(H, { c: Circle.new(1) }))"), "true")
    assert_eq(out(src + "print(asked(H, { c: 3 }))"), "false")

@test
A_BINDING_THAT_DOES_NOT_FIT_IS_A_FAULT_SAYING_WHICH_HALF_IS_WRONG()
    // **A `match` arm that does not fit needs no sentence and a binding does**, there being no next
    // arm to try. JavaScript answers `undefined` for a field that is not there and carries on, which
    // is the same absence-that-travels slate refuses everywhere else.
    assert(fails("val [a, b] = [1]").contains("this binding takes 2 elements out of an array, and this one has 1"))
    assert(fails("val [a, ...r] = []").contains("takes at least 1 element out of an array"))
    assert(fails("val { a } = { b: 1 }").contains("this object has no field called `a`, which this binding takes out of it"))
    assert(fails("val [a] = 5").contains("this binding takes an array apart, and this is an integer"))

    // **What a binding NEEDS is the elements with no default**, so the count the complaint gives is
    // the one a reader has to satisfy rather than the length of the pattern.
    assert(fails("val [a, b = 2] = []").contains("takes at least 1 element out of an array, and this one has 0"))
    assert(fails("val [a, b = 2] = [1, 2, 3]").contains("this one has 3"))

    // And a field with a default is not one the complaint may name as missing.
    assert(fails("val { a, b = 2 } = { b: 1 }").contains("no field called `a`"))
    assert(fails("val { a } = 5").contains("this binding takes an object apart, and this is an integer"))

    // Right shape, wrong contents -- the two halves are different sentences.
    assert(fails("val [1, b] = [2, 3]").contains("this array has the right number of elements, and one of them does not fit"))

@test
THE_FIRST_TOKEN_DECIDES_SO_AN_ORDINARY_BINDING_IS_UNCHANGED()
    // **A bare name in pattern position is a type test where it names a type**, so reading every
    // binding as a pattern would stop `val string = 5` binding `string` and start testing against
    // it. A `[` or a `{` can begin no name, which is the whole of the decision.
    assert_eq(out("val string = 5\nprint(string)"), "5")
    assert_eq(out("val number = \"x\"\nprint(number)"), "x")
    assert_eq(out("for string in [1, 2]\n    print(string)"), "1\n2")

@test
a_for_head_may_take_each_element_apart()
    assert_eq(out("for [a, b] in [[1, 2], [3, 4]]\n    print(a, b)"), "1 2\n3 4")
    assert_eq(out("for { n } in [{ n: 1 }, { n: 2 }]\n    print(n)"), "1\n2")

    // An element that does not fit is the same fault a binding is, and names the turn it happened on.
    assert(fails("for [a, b] in [[1, 2], [3]]\n    print(a)").contains("takes 2 elements out of an array, and this one has 1"))

@test
an_object_is_walked_as_keys_values_or_pairs()
    assert_eq(out("print(keys({ a: 1, b: 2 }))"), "[\"a\", \"b\"]")
    assert_eq(out("print(values({ a: 1, b: 2 }))"), "[1, 2]")
    assert_eq(out("print(entries({ a: 1 }))"), "[[\"a\", 1]]")

    // **The pairs are what make a destructuring `for` head pay for itself.** In the order the fields
    // were first written, which is the order `keys` already answers in.
    assert_eq(out("for [k, v] in entries({ a: 1, b: 2 })\n    print(k, v)"), "a 1\nb 2")
    assert_eq(out("print(entries({}))"), "[]")
    assert(fails(Opaque + "entries(anything([1]))").contains("`entries` needs an object, and this is an array"))

// -- reading a field that may not be there -----------------------------------------------------

@test
optional_chaining_answers_null_where_there_is_nothing_to_read()
    assert_eq(out("print({ a: { b: 7 } }?.a?.b)"), "7")
    assert_eq(out("val n = null\nprint(n?.a)"), "null")
    assert_eq(out("print({ a: 1 }.missing?.b)"), "null")

    // It composes with `??`, which is what makes the pair worth having: one says where absence is
    // allowed and the other says what to do about it.
    assert_eq(out("val n = null\nprint(n?.a ?? \"gone\")"), "gone")

@test
QDOT_GUARDS_ITS_OWN_LINK_AND_NOT_THE_REST_OF_THE_CHAIN()
    // **Kotlin's rule rather than JavaScript's.** `a?.b.c` reads `b` off `a` or answers null, and
    // then asks `.c` of whatever that was. slate's rule about absence everywhere is that it stops at
    // the boundary it arose at, and one character quietly excusing a whole line is the opposite of
    // that -- so the reader writes `a?.b?.c` and says where each one is allowed.
    val said = fails("val n = null\nprint(n?.a.b)")

    assert(said.contains("there is nothing here to read `b` from"))

    // **The message names `?.` rather than the field**, because what is wrong is one link earlier.
    // "`b` is not something null can do" is true and sends the reader to look at the wrong thing.
    assert(said.contains("`?.` answers null where a value may be missing"))
    assert_eq(out("val n = null\nprint(n?.a?.b)"), "null")

@test
an_optional_method_call_does_not_evaluate_its_arguments()
    assert_eq(out("print({ greet: () -> \"hi\" }?.greet())"), "hi")
    assert_eq(out("val n = null\nprint(n?.greet())"), "null")

    // **Which is what makes the guard worth having over a test afterwards.** A written-out
    // `if n != null then n.greet(side())` says the same thing; `n?.greet(side())` says it once.
    val prog = "var calls = 0\nside() = \n    calls = calls + 1\n    1\n" +
        "val n = null\nprint(n?.greet(side()), calls)"

    assert_eq(out(prog), "null 0")

@test
an_optional_field_may_not_be_assigned_to()
    // There is no answer to what writing into absence should do, and JavaScript agrees.
    assert(fails("val o = { a: 1 }\no?.a = 2").contains("this cannot be assigned to"))

// -- JSON ----------------------------------------------------------------------------------------

@test
json_maps_onto_slates_own_values_because_they_are_the_same_seven_things()
    val prog = "val r = parseJSON(\"{\\\"name\\\": \\\"Ada\\\", \\\"tags\\\": [1, 2.5, true, null]}\")\n" +
        "print(r.ok, r.value.name, r.value.tags[1], r.value.tags[3])"

    assert_eq(out(prog), "true Ada 2.5 null")

    // Both kinds of number survive, which is the whole reason `sh.sysl.json` has two variants: a
    // real cannot hold an identifier past 2^53 and a long cannot hold 0.5.
    assert_eq(out("print(parseJSON(\"[1, 1.5]\").value)"), "[1, 1.5]")
    assert_eq(out("print(toJSON({ a: [1, 2] }))"), "{\"a\":[1,2]}")
    assert_eq(out("print(toJSON(parseJSON(\"{\\\"a\\\":1}\").value))"), "{\"a\":1}")

    // The second argument lays it out for a person.
    assert_eq(out("print(toJSON({ a: 1 }, 2))"), "{\n  \"a\": 1\n}")

@test
A_DOCUMENT_THAT_WILL_NOT_PARSE_IS_A_RESULT_AND_A_VALUE_THAT_WILL_NOT_RENDER_IS_A_FAULT()
    // **slate's two channels applied to the two directions, which genuinely differ.** Text arriving
    // from a file, a socket or a person is a condition every caller was going to handle; a function
    // or a circle in a value the program built itself is a defect in that program. `JSON.parse` and
    // `JSON.stringify` both throw, so node treats the two alike.
    assert_eq(out("print(parseJSON(\"{oops}\").ok)"), "false")

    // **The whole rendering and not just the headline.** A JSON document is usually machine-written
    // and long, so a bare "expected a string" says nothing a person can act on.
    val said = out("print(parseJSON(\"{oops}\").error)")

    assert(said.contains("expected a string"))
    assert(said.contains("{oops}"))

    // And the other direction faults, naming the thing that has no encoding.
    assert(fails("toJSON({ f: () -> 1 })").contains("there is no JSON for a function"))
    assert(fails("toJSON(print)").contains("there is no JSON for a function"))

@test
A_VALUE_WITH_NO_JSON_FORM_IS_NAMED_RATHER_THAN_DROPPED()
    // **Where slate parts company with node.** `JSON.stringify` drops a function and an `undefined`
    // silently from an object and turns them into `null` inside an array, so a request body goes out
    // with a field missing and nothing anywhere says which.
    assert(fails("toJSON([() -> 1])").contains("there is no JSON for a function"))

    // A circle is a fault with a sentence rather than a hang.
    assert(fails("val o = { a: 1 }\no.self = o\ntoJSON(o)").contains("this object holds itself, so there is no JSON for it"))
    assert(fails("val xs = []\npush(xs, xs)\ntoJSON(xs)").contains("this array holds itself"))

    // A JSON name is a string and a slate key is any value, so a key that is not one has no
    // encoding -- rendering it as text would make `{ 1: "a" }` and `{ "1": "a" }` one document.
    assert(fails("val o = {}\no[1] = \"x\"\ntoJSON(o)").contains("a JSON name is a string, and this object has a key that is an integer"))

@test
json_says_what_it_wanted_when_given_something_else()
    assert(fails(Opaque + "parseJSON(anything(5))").contains("`parseJSON` takes a string, and this is an integer"))
    assert(fails(Opaque + "anything(parseJSON)()").contains("takes one string and was given 0 arguments"))
    // **`toJSON` has a signature now, so the direct call is the CHECKER's complaint**, and these two
    // go through `anything` for the same reason the `parseJSON` pair above them does: the native's
    // own wording is what a person meets whenever the checker cannot see the callee, and it is worth
    // keeping pinned. `THE_OPTIONAL_ARGUMENT_OF_A_BUILTIN_IS_TYPE_CHECKED_TOO` holds the other half.
    assert(fails(Opaque + "anything(toJSON)()").contains("a value and an optional indent"))
    assert(fails(Opaque + "anything(toJSON)({}, \"two\")").contains("takes an indent as a number, and this is a string"))

    // **An indent of 40 is an integer and passes the checker**, so this one is still the machine's
    // on a direct call -- a range the signature cannot say is exactly what is left for it to say.
    assert(fails("toJSON({}, 40)").contains("indents by 0 to 16 spaces, and this is by 40"))

// -- what the compiler can say without running the program -----------------------------------------

@test
AN_ANNOTATED_PARAMETER_IS_CHECKED_WHERE_THE_CALL_IS_WRITTEN()
    // **The whole point of the pass: the same complaint, earlier.** The run-time check is still
    // there and still fires for a value that arrived from outside; this catches the ones written
    // down, which are the ones a person could have been told about before running anything.
    assert(fails("f(x: string) = x\nprint(f(42))").contains("`f` takes string here, and this is integer"))
    assert(fails("f(n: number) = n\nprint(f(\"s\"))").contains("takes number here, and this is string"))
    assert(fails("f(xs: array) = xs\nprint(f(\"no\"))").contains("takes array here, and this is string"))

    // The complaint points at the ARGUMENT rather than at the call, which is the thing to change.
    assert(fails("f(x: string) = x\nprint(f(42))").contains("^^"))

@test
AN_INTEGER_DOES_NOT_FIT_A_REAL_BECAUSE_THE_MACHINE_SAYS_SO()
    // **`fits` mirrors `is_kind` and may not drift from it.** Arithmetic promotes an integer to a
    // real and a type test does not, so `f(x: real)` given `1` faults when it runs -- and a checker
    // that let it through would be describing a language slate is not.
    assert(fails("f(r: real) = r\nprint(f(1))").contains("takes real here, and this is integer"))
    assert(fails("f(i: integer) = i\nprint(f(1.5))").contains("takes integer here, and this is real"))
    assert_eq(out("f(n: number) = n\nprint(f(1), f(1.5))"), "1 1.5")

    // A real anywhere in the arithmetic makes the answer a real, which is slate's promotion. Saying
    // `number` there would be true and too weak, and would refuse this.
    assert_eq(out("f(r: real) = r\nprint(f(1.0 * 2), f(2 * 1.5))"), "2 3")

@test
THE_ARITY_OF_A_CALL_IS_COUNTED_WHILE_COMPILING()
    assert(fails("f(a, b) = a\nf(1)").contains("`f` takes 2 arguments and this gives it 1"))
    assert(fails("val g = (a, b) -> a\ng(1, 2, 3)").contains("takes 2 arguments and this gives it 3"))

    // **A count that is wrong makes every argument's position a guess**, so nothing else about the
    // call is said -- four type errors for one missing argument is the commonest way a checker
    // becomes a thing to work around.
    val said = fails("f(a: string, b: string) = a\nf(1)")

    assert(said.contains("takes 2 arguments"))
    assert(!said.contains("takes string here"))

@test
AN_OBJECT_LITERAL_AT_THE_CALL_IS_CHECKED_AND_ONE_THROUGH_A_NAME_IS_NOT()
    // **The conservative boundary of this pass, and it is a decision rather than an omission.** An
    // object is mutable and a field may be added to it anywhere, so a shape recorded when it was
    // built is a claim that goes out of date with nothing local saying so -- and a stale shape is
    // too NARROW, which would refuse a program that runs.
    val shapes = "type P = { x: number, y: number }\nd(p: P) = p.x + p.y\n"

    assert(fails(shapes + "print(d({ x: 1 }))").contains("takes { x: number, y: number } here, and this is { x: integer }"))

    // A literal with MORE than was asked for still fits, which is the object pattern's rule and has
    // to be the type's too or one annotation would mean two things.
    assert_eq(out(shapes + "print(d({ x: 1, y: 2, z: 3 }))"), "3")

    // Through a name it is not checked, however it was built -- and the run-time check still is.
    assert_eq(out(shapes + "val built = { x: 1 }\nbuilt.y = 2\nprint(d(built))"), "3")

@test
AN_OPERATOR_THAT_CANNOT_MEET_IS_REFUSED_WHILE_COMPILING()
    assert(fails("print(1 + \"a\")").contains("`+` does not apply to integer and string"))
    assert(fails("f(s: string) = s * 2\nf(\"a\")").contains("`*` does not apply to string and integer"))

    // Only where both sides are known. Anything less certain is left to the machine.
    assert_eq(out("anything(v) = v\nprint(anything(1) + 1)"), "2")
    assert_eq(out("print(\"a\" + \"b\", 1 + 1, 1 + 1.5)"), "ab 2 2.5")

@test
THE_CHECKER_MAY_ONLY_REPORT_WHAT_THE_MACHINE_WOULD_ALSO_REFUSE()
    // **The rule the whole pass is built on.** A checker that is sometimes wrong is worse than no
    // checker, because a program then has to be written around it -- so everything the walk is
    // unsure of is `any`, which fits everything.
    //
    // Each of these is a legal program, and each is one the pass could have got wrong.

    // A `var` is `any` whatever it held, because this pass does not follow assignments.
    assert_eq(out("takes(s: string) = s\nvar v = 1\nv = \"text\"\nprint(takes(v))"), "text")

    // A builtin has no type here, so a call to one is never checked.
    assert_eq(out("print(len(\"abc\"), sorted([2, 1]))"), "3 [1, 2]")

    // A name a pattern bound is unknown, so nothing is said about it.
    assert_eq(out("takes(n: number) = n\nprint(5 match\n    bound -> takes(bound))"), "5")

    // `function` says callable and nothing about arity, so counting against it would refuse this.
    assert_eq(out("apply1(f: function) = f(1)\nprint(apply1(x -> x * 2))"), "2")

    // Mutual recursion works because every definition in a block is noted before any is walked.
    assert_eq(out("down(n: integer) = if n <= 0 then 0 else up(n - 1)\nup(n: integer) = down(n - 1)\nprint(down(4))"), "0")

@test
a_static_complaint_stops_the_program_the_way_a_parse_error_does()
    // It goes through `compile_faults`, which `run` and `prepare` both fold in, so nothing of the
    // program runs -- including the part before the mistake.
    val said = fails("print(\"before\")\nf(x: string) = x\nprint(f(1))")

    assert(said.contains("takes string here"))
    assert(!said.contains("before"))

@test
A_BUILTIN_HAS_A_SIGNATURE_AND_A_CALL_TO_ONE_IS_CHECKED()
    assert(fails("print(upper(5))").contains("`upper` takes string here, and this is integer"))
    assert(fails("print(keys([1]))").contains("`keys` takes object here, and this is array"))
    assert(fails("print(map({ a: 1 }, x -> x))").contains("`map` takes array here"))
    assert(fails("print(len(\"a\", \"b\"))").contains("`len` takes 1 argument and this gives it 2"))
    assert(fails("print(split(\"a,b\"))").contains("`split` takes 2 arguments and this gives it 1"))

    // What a builtin ANSWERS flows on, which is where a signature pays for itself twice.
    assert(fails("f(s: string) = s\nval n = len(\"abc\")\nprint(f(n))").contains("takes string here, and this is integer"))

@test
A_POSITION_THAT_MAY_BE_NULL_SAYS_SO_IN_ITS_TYPE()
    // **A real check rather than a nicety.** `indexOf` answers a position or nothing, so handing its
    // answer straight to a parameter wanting a number is a fault the machine would raise -- and the
    // union is what lets the compiler see it first.
    assert(fails("f(n: number) = n\nprint(f(indexOf(\"abc\", \"z\")))").contains("this is integer | null"))

    // And `??` is what a program writes instead, which the pass leaves alone.
    assert_eq(out("f(n: number) = n\nprint(f(indexOf(\"abc\", \"b\") ?? 0))"), "1")

@test
ONLY_THE_BUILTINS_WITH_A_FIXED_ARITY_HAVE_A_SIGNATURE()
    // `print`, `assert`, `min`, `max`, `concat`, `sorted`, `sort` and `toJSON` all take a range of
    // counts, and a signature saying one number would refuse the other -- so they say nothing.
    assert_eq(out("print(min(1, 2), max(1, 2, 3), concat([1], [2], [3]))"), "1 3 [1, 2, 3]")
    assert_eq(out("val xs = [2, 1]\nprint(sorted(xs), sorted(xs, (a, b) -> a > b))"), "[1, 2] [2, 1]")
    assert_eq(out("print(toJSON({ a: 1 }), toJSON({ a: 1 }, 1))"), "{\"a\":1} {\n \"a\": 1\n}")

@test
A_NAME_A_PROGRAM_TAKES_FOR_ITSELF_SHADOWS_THE_BUILTINS_SIGNATURE()
    // **Seeded into the outermost scope, so everything a program binds is found first.** Without
    // this, `for len in xs` would leave `len` looking like the builtin and the next call would be
    // counted against the wrong thing.
    assert_eq(out("val len = 5\nprint(len)"), "5")
    assert_eq(out("for len in [1, 2]\n    print(len)"), "1\n2")
    assert_eq(out("mine(len) = len(1, 2)\nprint(mine((a, b) -> a + b))"), "3")
    assert_eq(out("print(5 match\n    upper -> upper)"), "5")
    assert_eq(out("val [len, keys] = [1, 2]\nprint(len, keys)"), "1 2")

    // An imported name too, which is `any` and therefore no longer a builtin's signature.
    assert_eq(ran_out("tests/mods/uses_len.sl"), "9")

@test
A_TEST_NARROWS_THE_NAME_IT_TESTED()
    // **The feature a reader coming from TypeScript looks for first.** `x is string` makes `x` a
    // string for as long as the test held, so a call inside the branch is checked against that.
    val setup = "takes_string(s: string) = s\ntakes_number(n: number) = n\n"

    assert(fails(setup + "f(x) = if x is number then takes_string(x) else 0\nf(1)").contains("takes string here, and this is number"))
    assert_eq(out(setup + "f(x) = if x is string then takes_string(x) else 0\nprint(f(\"a\"))"), "a")

    // A `match` arm narrows its subject by the same rule, the arm only running where it took.
    val armed = setup + "f(x) = x match\n    string -> takes_number(x)\n    _ -> 0\nf(\"a\")"

    assert(fails(armed).contains("takes number here, and this is string"))

    // `&&` narrows by both, which is what the second operand is already inside when it runs.
    assert(fails(setup + "f(x) = if x is string && len(x) > 0 then takes_number(x) else 0\nf(\"a\")").contains("takes number here, and this is string"))

    // A negated test narrows the OTHER branch, which is the same rule read backwards.
    assert(fails(setup + "f(x) = if x is not string then 0 else takes_number(x)\nf(\"a\")").contains("takes number here, and this is string"))

@test
A_VAR_IS_NEVER_NARROWED_BECAUSE_THE_BRANCH_MAY_WRITE_TO_IT()
    // **A stale narrowing is too NARROW, which refuses a program that runs** -- so the environment
    // records whether a name may be written to, and a mutable one is left alone however it tested.
    val prog = "takes_string(s: string) = s\nvar m = 1\nif m is number\n    m = \"text\"\n    print(takes_string(m))"

    assert_eq(out(prog), "text")

@test
a_definition_is_checked_against_what_it_promised_to_answer()
    assert(fails("f() -> string = 1").contains("this was declared to answer string, and answers integer"))
    assert_eq(out("f(n: integer) -> integer = n * 2\nprint(f(3))"), "6")

    // A block body answers `any` here and is left alone, which is also what keeps an early `return`
    // out of it -- nothing about a block's value is known, so nothing is claimed.
    assert(fails("f() -> string =\n    val x = 1\n    x\nprint(f())").contains("this answers string, and gave back 1"))

@test
an_async_definition_answers_a_promise_and_not_what_its_body_says()
    // **So a result annotation on one describes the awaited value rather than the call.** Believing
    // the annotation at the call site would make `takes_string(fetchIt(1))` look right when what
    // arrives is a promise -- and, worse, would make `await`ing it look wrong.
    val prog = "takes_string(s: string) = s\n" +
        "async fetchIt(n: integer) -> string = \"got \" + string(n)\n" +
        "async main() = print(takes_string(await fetchIt(1)))\n" +
        "main()"

    assert_eq(out(prog), "got 1")

    // The body is still checked against what it promised, which is where the annotation is true.
    assert(fails("async f() -> string = 1\nf()").contains("declared to answer string, and answers integer"))

@test
EVERY_BUILTIN_WITH_A_SIGNATURE_ACCEPTS_ITS_ORDINARY_USE()
    // **A wrong parameter or result type refuses a program that runs, and this is what would notice.**
    // Every seeded builtin is called the way a program calls it, and each answer is fed on to
    // another; one bad entry in `install_builtin_types` makes this refuse to compile.
    val prog = "val xs = [3, 1, 2]\nval o = { a: 1, b: 2 }\nval s = \"hello world\"\n" +
        "print(len(xs), len(o), len(s), len(0..<3))\n" +
        "print(map(xs, x -> x * 2), filter(xs, x -> x > 1), reduce(xs, (a, b) -> a + b, 0))\n" +
        "print(find(xs, x -> x > 1), findIndex(xs, x -> x > 1), every(xs, x -> x > 0), some(xs, x -> x > 2))\n" +
        "print(reversed(xs), flat([[1]]), sum(xs))\n" +
        "print(keys(o), values(o), entries(o), has(o, \"a\"))\n" +
        "print(split(s, \" \"), join(xs, \",\"), upper(s), trim(\"  x  \"), replace(s, \"l\", \"L\"), repeat(\"ab\", 2))\n" +
        "print(startsWith(s, \"he\"), endsWith(s, \"ld\"), contains(s, \"lo\"), contains(xs, 3))\n" +
        "print(indexOf(s, \"o\") ?? 0, lastIndexOf(xs, 1) ?? 0)\n" +
        "print(abs(0 - 2), floor(2.7), ceil(2.1), round(2.5), trunc(2.9), pow(2, 3))\n" +
        "print(string(1), boolean(0), parseJSON(\"{}\").ok, chars(\"ab\"))\n" +
        "push(xs, 9)\ninsert(xs, 0, 0)\nprint(removeAt(xs, 0), pop(xs))\nreverse(xs)\nclear(xs)\n" +
        "print(upper(trim(\"  x  \")), len(split(s, \" \")))"

    val said = out(prog)

    assert(!said.contains("error"), said)
    assert(said.contains("3 2 11 3"))

    // And the variadic ones, which have no signature and must go on having none.
    assert_eq(out("print(min(1, 2), max(1, 2, 3), concat([1], [2]), sorted([2, 1]), toJSON({}))"), "1 3 [1, 2] [1, 2] {}")

@test
THE_PROGRAMS_THE_CHECKER_COULD_HAVE_GOT_WRONG_AND_DOES_NOT()
    // Each line here is a legal program the pass had a way to refuse, and every one of them was
    // written down because a first cut of the pass did refuse it.
    val decls = "identity(v) = v\ntakes_number(n: number) = n\ntakes_real(r: real) = r\n" +
        "takes_int(i: integer) = i\ntakes_string(t: string) = t\ntakes_fn(f: function) = f(1)\n"

    // `number` accepts both kinds, and a real anywhere in the arithmetic makes the answer a real.
    assert_eq(out(decls + "print(takes_number(1), takes_number(1.5), takes_number(1 + 2))"), "1 1.5 3")
    assert_eq(out(decls + "print(takes_real(1.0 * 2), takes_real(2 * 1.5))"), "2 3")

    // A `number` on the answering side may be either, so it is refused against neither.
    assert_eq(out(decls + "half(x) = x / 2\nprint(takes_int(2 * 3), takes_real(1.0))"), "6 1")

    // `function` says callable and nothing about arity.
    assert_eq(out(decls + "print(takes_fn(x -> x * 2))"), "2")

    // An unannotated function answers `any`, which fits everywhere.
    assert_eq(out(decls + "print(takes_string(identity(\"z\")), takes_int(identity(1)))"), "z 1")

    // An object literal with more than was asked for fits; one reached through a name is not judged.
    val shapes = "type P = { x: number, y: number }\nd(p: P) = p.x + p.y\n"

    assert_eq(out(shapes + "print(d({ x: 1, y: 2, z: 3 }))"), "3")
    assert_eq(out(shapes + "val b = { x: 1 }\nb.y = 2\nprint(d(b))"), "3")

// -- a parameter may take its argument apart --------------------------------------------------

@test
A_PARAMETER_MAY_BE_A_PATTERN_AND_THE_DESUGAR_IS_THE_ANNOTATIONS()
    // **`p: Point` already becomes a statement at the top of the body**, so a destructuring
    // parameter becomes an `Unpack` in the same place and `Def`, `Lambda`, the arity check, the
    // machine and the checker learn nothing at all. Taking that desugar was the whole of the work.
    assert_eq(out("greet({ name }) = \"hi \" + name\nprint(greet({ name: \"Ada\" }))"), "hi Ada")
    assert_eq(out("total([a, b]) = a + b\nprint(total([1, 2]))"), "3")
    assert_eq(out("f(a, { b }, c) = a + b + c\nprint(f(1, { b: 2 }, 3))"), "6")

    // Nesting, renaming and the shorthand are the pattern's own and came for free.
    assert_eq(out("f({ a: { b } }) = b\nprint(f({ a: { b: 7 } }))"), "7")
    assert_eq(out("f({ name: who }) = who\nprint(f({ name: \"Ada\" }))"), "Ada")

    // **The arity is what it looks like**, the hidden parameter being one name like any other.
    assert_eq(out("f({ a }, { b }) = a + b\nprint(f)"), "<function of 2>")

@test
A_LAMBDAS_PARAMETER_MAY_TAKE_ITS_ARGUMENT_APART_TOO()
    assert_eq(out("val f = ({ n }) -> n * 2\nprint(f({ n: 21 }))"), "42")
    assert_eq(out("val g = ([a, b], c) -> a + b + c\nprint(g([1, 2], 3))"), "6")
    assert_eq(out("print([{ n: 1 }, { n: 2 }].map(({ n }) -> n * 10))"), "[10, 20]")

    // **The wind-back still works**, which is what `lambda_params` is built on: a `(` that turns out
    // not to open a parameter list is an ordinary bracket, and an object literal in one is the case
    // that would break if the pattern were consumed and not put back.
    assert_eq(out("print(({ a: 1 }).a)"), "1")

@test
A_DESTRUCTURED_ARGUMENT_THAT_DOES_NOT_FIT_IS_A_FAULT()
    // The binding rule, reached from the parameter: a `match` arm lets the next one try and there is
    // no next one here.
    assert(fails("f({ a }) = a\nf(42)").contains("takes an object apart, and this is an integer"))
    assert(fails("f([a, b]) = a\nf([1])").contains("takes 2 elements out of an array, and this one has 1"))

    // **The caret points at the PARAMETER and not at the call**, which is the right end of the two:
    // the call is where a wrong value came from and the parameter is what says what was wanted, and
    // a reader who has just been told the shape needs to see the shape.
    assert(fails("f({ a }) = a\nf(42)").contains("{ a }"))

// -- an argument list worked out while running --------------------------------------------------

@test
A_CALL_MAY_SPREAD_AN_ARRAY_AND_THAT_IS_THE_ONLY_SPREAD_slate_HAS()
    // **The one genuine hole spread would have filled.** `{ ...o }` is `o with { ... }` and
    // `[...xs, y]` is `concat(xs, [y])`, both of which slate has -- but an argument list built at
    // run time had no spelling at all, `apply` not being something a program can reach.
    assert_eq(out("add(a, b, c) = a + b + c\nprint(add(...[1, 2, 3]))"), "6")

    // Written and spread arguments mix, in any order, which is what `JoinArrays` is for.
    assert_eq(out("add(a, b, c) = a + b + c\nprint(add(10, ...[20, 30]))"), "60")
    assert_eq(out("add(a, b, c) = a + b + c\nprint(add(...[1], 2, ...[3]))"), "6")
    assert_eq(out("print(max(...[4, 9, 2]))"), "9")
    assert_eq(out("print([1, 2].concat(...[[3, 4]]))"), "[1, 2, 3, 4]")

    // A method reached through a proto is still handed its receiver, the spread changing only where
    // the argument count comes from.
    val method = "val P = { twice: (self, k) -> self.n * k }\nval o = { n: 5, proto: P }\n"

    assert_eq(out(method + "print(o.twice(...[3]))"), "15")

@test
A_SPREAD_OF_SOMETHING_THAT_IS_NOT_AN_ARRAY_NAMES_THE_SPREAD()
    // **The message names the spread and not the call**, because that is where the reader has to
    // look: `f(...42)` is a mistake about what may be spread, not about what `f` takes.
    assert(fails("val f = (a) -> a\nf(...42)").contains("`...` spreads an array, and this is an integer"))

    // **A single spread is joined too, and this is why.** One spread on its own is already an array,
    // so the join is a copy that changes nothing -- except that the join is where a spread of
    // something else is caught, and skipping it sent the value into the call unchecked.
    assert(fails("val f = (a) -> a\nf(...\"text\")").contains("`...` spreads an array"))

    // `...` outside a call's brackets is not an expression at all, and the parser says so.
    assert(fails("val a = ...[1]").contains("expected an expression"))

@test
THE_CHECKER_SAYS_NOTHING_ABOUT_A_CALL_THAT_SPREADS()
    // **A spread makes the count a run-time fact**, so counting it as one argument would refuse a
    // program that runs -- the one mistake this pass may not make. The machine still counts, at the
    // call, and `add(...[1, 2])` faults there.
    assert_eq(out("add(a, b, c) = a + b + c\nprint(add(...[1, 2, 3]))"), "6")
    assert(fails("add(a, b, c) = a + b + c\nprint(add(...[1, 2]))").contains("takes 3 arguments"))

// -- the bytes under the text ---------------------------------------------------------------------

@test
toBytes_COUNTS_WHAT_GOES_ON_THE_WIRE_AND_len_COUNTS_CHARACTERS()
    // **The two numbers differ and both are right**, which is the whole reason this pair exists.
    // Everything else in slate counts characters, because that is what a program reasoning about
    // text wants; a protocol saying how much is about to arrive counts bytes.
    assert_eq(out("print(len(\"héllo\"), len(toBytes(\"héllo\")))"), "5 6")
    assert_eq(out("print(toBytes(\"hé\"))"), "[104, 195, 169]")

    // ASCII is where they agree, which is why getting this wrong survives every test written in
    // English and fails on the first accented body.
    assert_eq(out("print(len(\"abc\") == len(toBytes(\"abc\")))"), "true")

    assert_eq(out("print(toBytes(\"\"))"), "[]")

@test
fromBytes_ANSWERS_A_RESULT_BECAUSE_ARBITRARY_BYTES_ARE_NOT_TEXT()
    assert_eq(out("print(fromBytes(toBytes(\"héllo\")).value)"), "héllo")
    assert_eq(out("print(fromBytes([]).value == \"\")"), "true")

    // **A lone `0xFF` is in no UTF-8 sequence**, so this is the failure a program reading a socket
    // has to be able to see: answering an empty string would hide the difference between bytes that
    // are not text and no bytes at all.
    assert_eq(out("val r = fromBytes([104, 255, 105])\nprint(r.ok, r.error)"),
        "false these bytes are not text -- they are not valid UTF-8")

    // The round trip is what makes a chunked read safe: a character split across two arrivals is
    // whole again once the pieces are back together.
    assert_eq(out("val a = [104, 195]\nval b = [169]\nprint(fromBytes(concat(a, b)).value)"), "hé")

@test
THE_BYTE_BUILTINS_SAY_WHAT_THEY_WANTED_WHEN_GIVEN_SOMETHING_ELSE()
    assert(fails("print(toBytes(42))").contains("`toBytes` takes a string, and this is an integer"))
    assert(fails("print(toBytes(\"a\", \"b\"))").contains("`toBytes` takes one string, and was given 2 arguments"))
    assert(fails("print(fromBytes(\"abc\"))").contains("`fromBytes` takes an array of numbers, and this is a string"))
    assert(fails("print(fromBytes([1, \"x\"]))").contains("and one of these is a string"))

    // **The range is checked rather than truncated**, a number outside it being a mistake in the
    // program rather than a byte anybody meant.
    assert(fails("print(fromBytes([256]))").contains("a byte is between 0 and 255, and this is 256"))
    assert(fails("print(fromBytes([-1]))").contains("a byte is between 0 and 255, and this is -1"))

@test
EVERY_VALUE_ANSWERS_toString_eq_ne_AND_equals()
    // **An object model is a set of questions every value can be asked**, and a language where
    // `o.toString()` works only when somebody remembered to write one has not got one. These four are
    // the whole of slate's, and the list is closed on purpose: they are reached only where nothing
    // nearer answered, so a name a program put on its object still wins.

    assert_eq(out("print((42).toString(), \"hi\".toString(), [1, 2].toString(), {a: 1}.toString())"),
        "42 hi [1, 2] {a: 1}")

    // **`eq` is identity on the kinds that have one and equality on the kinds that have not.** A
    // string, a number and a boolean are immutable and nothing can observe which copy it holds, so
    // `"a".eq("a")` answering false would be a trap rather than a distinction.
    assert_eq(out("val xs = [1, 2]\nprint(xs.eq(xs), xs.eq([1, 2]), xs.ne([1, 2]))"), "true false true")
    assert_eq(out("print(1.eq(1), \"a\".eq(\"a\"), true.eq(true), null.eq(null))"), "true true true true")

    // **`equals` is `==` under its own name and the two may never disagree**, which is why it is the
    // same function rather than a second reading of it.
    assert_eq(out("print([1, 2].equals([1, 2]), {a: 1}.equals({a: 1}), 1.equals(2))"), "true true false")

    // **A field the program put there wins, own or through a proto**, this table being consulted only
    // where the lookup found nothing.
    assert_eq(out("val o = { toString: () -> \"mine\" }\nprint(o.toString(), string(o))"), "mine mine")
    assert_eq(out("val P = { toString: (self) -> \"shared\" }\nprint({ n: 1, proto: P }.toString())"), "shared")

    // **The name on its own hands back the plain builtin**, exactly as `xs.map` does -- it is the same
    // value the call reaches, which is what makes these methods rather than syntax.
    assert_eq(out("val f = [1, 2].toString\nprint(f([3]))"), "[3]")

    // **The checker knows them too, and asks the machine's own table.** A pass that refused one would
    // be refusing a program that runs, which is the one mistake it may not make.
    assert_eq(out("print(\"abc\".eq(\"abc\"))"), "true")
    assert(fails("print(\"abc\".push(1))").contains("`push` is not something a string can do"))
