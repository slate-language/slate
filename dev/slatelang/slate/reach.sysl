module dev.slatelang.slate

// What a default may read.
//
// **A default is worked out before the bindings to its right exist, so it may read the ones to its
// LEFT and none to its right.** A parameter's default runs at the head of the call, the parameters
// after it not yet given theirs; a pattern's runs after the value is taken apart, in the order the
// names are written. A read of its own name or of one to its right found an absence in the
// interpreter -- or, where a named argument had already been laid, the value the call gave -- and a
// `ReferenceError` under `slate js`, so the two back ends disagreed about the same program. Refusing
// it here is what makes them agree, and it is refused wherever it is written in the default: a
// lambda inside one included, since nothing says when that lambda runs.
//
// It is a file of its own because it is one question asked from three places -- a definition's
// defaults in `calls.sysl`, a pattern's in `check.sysl` and `check_expr.sysl`, and every name read in
// `check_expr.sysl` -- and `fits.sysl`, which holds the `TypeEnv` it reads, is the lattice.

// One default being walked: the name it belongs to, the entries `from..<to` of that name and every
// one bound after it, and what a default of its kind sees -- "the parameters" for a definition's and
// "the names" for a pattern's.
struct Defaulting
    owner: string
    from: usize
    to: usize
    sees: string
end Defaulting

// Walks `x` as the default of the binding at entry `from`, with that entry and every one after it
// up to `to` out of its reach.
//
// Not `private`: reached from `calls.sysl` for a definition's defaults.
walk_default(env: *TypeEnv, x: Expr, owner: string, from: usize, to: usize, sees: string)
    env.defaulting.push(Defaulting(owner, from, to, sees))
    check_expr(x, env)
    env.defaulting.pop()

// What is wrong with reading this name here, where it is a binding a default being walked may not
// see: its own, or one to its right. The innermost binding is what a read finds, so a nearer name of
// the same spelling -- a lambda's own parameter -- is not complained about.
//
// Not `private`: reached from `check_expr.sysl`'s `Name` arm.
right_hand_read(e: *TypeEnv, name: string) -> Option[string]
    if e.defaulting.len() == 0 then return None

    val found = innermost_entry(e, name) match
        Some(k) -> k
        None -> return None

    for d in 0..<e.defaulting.len()
        val w = e.defaulting.at(d)

        if found >= w.from && found < w.to
            if found == w.from
                return Some(s"the default of `${w.owner}` reads `${w.owner}` itself -- a default sees only ${w.sees} before it")

            return Some(s"the default of `${w.owner}` reads `${name}`, which is to its right -- a default sees only ${w.sees} before it")

    None
end right_hand_read

// The defaults a binding pattern carries, each walked where it is written. `first` is the first
// entry the pattern's names went into, so a default's reach ends at the entry of its own name.
//
// Not `private`: reached from `check.sysl` for a destructuring binding and `check_expr.sysl` for a
// `for` head.
check_pattern_defaults(pat: Pattern, first: usize, env: *TypeEnv)
    *pat.kind match
        At(_, inner) -> check_pattern_defaults(inner, first, env)
        ArrayPat(items, _, _, defaults) ->
            for i in 0..<items.len()
                pattern_default(items.at(i), defaults.at(i), first, env)
                check_pattern_defaults(items.at(i), first, env)
        ObjectPat(_, values, defaults, _) ->
            for i in 0..<values.len()
                pattern_default(values.at(i), defaults.at(i), first, env)
                check_pattern_defaults(values.at(i), first, env)
        _ -> ()
end check_pattern_defaults

// **A default may only be written on a bare binding**, which the parser holds to; anything else is
// walked as plain code rather than guessed at.
private pattern_default(item: Pattern, given: Option[Expr], first: usize, env: *TypeEnv)
    val x = given match
        Some(x) -> x
        None -> return

    *item.kind match
        Bind(name) -> entry_from(env, name, first) match
            Some(at) -> walk_default(env, x, name, at, env.names.len(), "the names")
            None -> check_expr(x, env)
        _ -> check_expr(x, env)
end pattern_default

// The entry of `name` at or after `from`, which is where a pattern's own binding of it went.
private entry_from(e: *TypeEnv, name: string, from: usize) -> Option[usize]
    for i in from..<e.names.len()
        if e.names.at(i) == name then return Some(i)

    None

// The entry a read of this name finds, innermost first -- the one `known_type` answers from.
private innermost_entry(e: *TypeEnv, name: string) -> Option[usize]
    var i = e.names.len()

    loop
        if i == 0 then return None

        i -= 1

        if e.names.at(i) == name then return Some(i)
