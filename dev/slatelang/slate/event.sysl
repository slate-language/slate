module dev.slatelang.slate

import sh.sysl.gc
import sh.sysl.libuv

// `close` is a `Handle` member, and a trait has to be in scope to reach one. Every handle type in
// the binding needs it, so it is imported here rather than at each use.
import sh.sysl.libuv.Handle
import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// The event loop, and what a slate program does with it.
//
// **A callback needs nothing from the machine, and that is worth knowing.** It runs *from* the loop,
// between statements of nothing, rather than from inside a half-evaluated expression -- so a
// tree-walker could have done all of this. `await` is the one that could not, because it suspends
// mid-expression, and it is built on top of what is here.
//
// ## The one thing embedding a loop costs a collected language
//
// **A pending callback is a root, and nothing else knows it.** `Timer.start` takes a sysl closure and
// the binding keeps it alive by reference counting -- but the *slate* closure that sysl closure means
// to call is a `Value` pointing into the collected heap, and the mark phase cannot see through an ARC
// box to find it. A timer set and then forgotten by the program is exactly the case: the only
// reference left is the one libuv holds, the collector frees the closure, and the timer eventually
// calls into swept memory.
//
// So the slate closure is held **here**, in a table this file roots, and the sysl closure captures a
// `usize` into it rather than the value. The same table holds the `&Timer`, because a counted box may
// not live in GC memory at all (see `obj.sysl`) and a slate program only ever sees the integer id.

// One thing the loop is going to call back.
struct Pending
    // What to call. `Null` once the slot is spent, which is what makes it collectable again.
    callback: Value

    // The promise to settle instead of calling anything, which is what `sleep` is. Null for a timer
    // a program set with `setTimeout`.
    promise: *PromiseObj

    // The handle, kept alive here for as long as the program may still cancel it.
    timer: Option[&libuv.Timer]

    // A socket, kept here for the same reason and closed the same way. **A socket differs from a
    // timer in what ends it**: a timer is spent when it fires and a socket lives until the program
    // says otherwise, so its slot is never surrendered by anything but `close`.
    socket: Option[&libuv.Tcp]

    // Whether this slot is in use. A spent slot is reused rather than grown past.
    live: bool

    // A repeating timer keeps firing; a one-shot frees its slot as it goes.
    repeating: bool

    // **Which occupant of this slot this is, and it is what makes an id safe to hand a program.**
    // A spent slot is reused, so an id on its own names a *position* rather than a thing: hold one
    // across a `close` and it comes to mean whatever took the position next. That is a use-after-free
    // wearing an integer's clothes, and it is silent -- `clearTimeout` on a cancelled timer's id
    // cancelled a *different* timer, and a closed socket's value compared equal to a live one.
    //
    // Every claim takes the next number, so a stale id carries a generation the slot no longer has
    // and every lookup misses. It is never reused and never reset.
    gen: usize

// Everything the loop may still call.
//
// **Module storage and a collector root.** See the header: this table is the only thing standing
// between a pending callback and the sweep.
var pending: Buf[Pending] = buf()

// How many callbacks are still outstanding, which is what decides whether the loop has work.
var outstanding: usize = 0

// The number the next claim will stamp its slot with. See `Pending.gen`.
var generation: usize = 0

// Mark what the loop can still reach.
mark_pending(h: *gc.Heap)
    for i in 0..<pending.len()
        if pending.at(i).live
            mark_value(h, pending.at(i).callback)
            gc.mark(h, ptr_cast(pending.at(i).promise))

// Give the table back between runs.
reset_events()
    // Every handle is dropped, which closes the timers with it.
    pending.clear()
    forget_parsers()
    outstanding = 0

    // **Back to zero, so that what a program is shown does not depend on what ran before it.** The
    // generation only has to be unique within one run -- nothing survives a `reset` to collide with
    // -- and letting it carry over would make a socket's printed name a function of the suite's
    // order.
    generation = 0
    loop_fault = None

// Take a slot, reusing a spent one where there is one.
//
// Not `private`: `private` in sysl is private to the *file*, and `fs.sysl` claims a slot for every
// request it has outstanding.
claim(p: Pending) -> usize
    var slot = p

    generation += 1
    slot.gen = generation

    for i in 0..<pending.len()
        if !pending.at(i).live
            pending.set(i, slot)
            outstanding += 1
            return i

    pending.push(slot)
    outstanding += 1
    pending.len() - 1
end claim

// Which occupant of a slot is in it now. `0` for a slot that has never been claimed, which no live
// id can carry -- `generation` counts from one.
//
// Not `private`: every id a program is given carries one of these, so `net.sysl` checks them too.
gen_at(id: usize) -> usize
    if id >= pending.len() then return 0

    pending.at(id).gen
end gen_at

// The slot a generation is in, if it is still in one.
//
// **A linear scan, and it is the right shape.** The table holds what the loop may still call, which
// is bounded by how much a program has in flight at once rather than by how much it has ever done --
// and the one caller is `clearTimeout`, which no program is in a hurry about.
slot_of_gen(gen: usize) -> Option[usize]
    for i in 0..<pending.len()
        val slot = pending.at(i)

        if slot.live && slot.gen == gen then return Some(i)

    None
end slot_of_gen

// Whether an id and the generation it was handed out with still name what they named.
holds(id: usize, gen: usize) -> bool
    if id >= pending.len() then return false

    val slot = pending.at(id)

    slot.live && slot.gen == gen
end holds

// Give a slot back. **The callback goes to `Null` here and not only the flag**, because the flag is
// what the mark phase reads and a live-looking slot would keep a dead closure alive forever.
//
// Not `private`: `fs.sysl` gives its slot back when an answer arrives.
surrender(id: usize)
    if id >= pending.len() then return

    var slot = pending.at(id)

    if !slot.live then return

    slot.live = false
    slot.callback = Null
    slot.promise = null

    // **The handle is CLOSED and not merely dropped.** A handle holds a reference to itself while it
    // is open, so letting go of the last name for it stops nothing -- deliberately, since dropping a
    // `setInterval` in JavaScript does not cancel it either. A handle never closed is also a handle
    // `run` will wait on forever, so this is what lets a program with a one-shot timer in it exit.
    slot.timer match
        Some(t) -> t.close(() -> ())
        None -> ()

    // A socket is closed for the same reason a timer is, and libuv insists on it for one more:
    // a handle that is never closed is one `run` waits on forever.
    slot.socket match
        Some(c) -> c.close(() -> ())
        None -> ()

    slot.timer = None
    slot.socket = None
    pending.set(id, slot)
    outstanding -= 1
end surrender

// Run the slate callback in a slot.
//
// **A fault inside a callback stops the program**, as an uncaught throw does in node. There is no
// statement to attach it to -- the loop is not running any -- so it is reported against the whole
// run.
private fire(id: usize)
    if id >= pending.len() then return

    val slot = pending.at(id)

    if !slot.live then return

    val cb = slot.callback
    val pr = slot.promise
    var none: Buf[Value] = buf()
    val mark = root_mark()

    hold(cb)

    // A one-shot is spent before its callback runs, so that a callback which sets another timer
    // cannot be given its own slot back underneath it. **The promise is read out first**, because
    // this is also what clears the slot's copy of it.
    if !slot.repeating then surrender(id)

    if pr != null
        // `sleep`: there is nothing to call, only a promise whose time has come.
        settle_ok(pr, Null)
    else
        apply(cb, none, point(0)) match
            Ok(_) -> ()
            Err(s) -> loop_fault = Some(s)

    release(mark)
end fire

// The first fault a callback raised, if any. Read once the loop stops.
var loop_fault: Option[Signal] = None

// -- a request, which is a slot holding nothing but a promise ---------------------------------------

// **The other thing a slot can be, and the reason this table is not called the timer table.** A file
// system call and a socket's connect and send are each one attempt with one outcome, so each takes a
// slot that roots a promise and gives the slot back as the answer arrives. Nothing here knows what
// kind of request it is; `fs.sysl` and `net.sysl` are the two that do.
//
// **The slot is also what keeps the loop running.** `outstanding` counts it, so a program does not
// exit with a read still in the thread pool.

// Start a request: a promise, and the slot that roots it until libuv answers.
//
// The slot is what keeps the loop running too -- `outstanding` counts it, so a program does not exit
// with a read still in the thread pool.
begin_request() -> usize
    val mark = root_mark()
    val pr = new_promise()

    hold(Promise(pr))

    val id = claim(Pending(Null, pr, None, None, true, false, 0))

    release(mark)
    id
end begin_request

// The promise a slot is holding, as the value a program gets back.
awaited_request(id: usize) -> Value = Promise(pending.at(id).promise)

// Hand an answer back and give the slot up.
//
// **What settles is a result, not the value** -- `{ ok: true, value: v }` -- so a promise from a
// file or a socket never rejects and the caller is handed something it has to look at. The three
// functions below are the whole of that retrofit: every success in `fs.sysl` and `net.sysl` already
// came through here and every failure through the two under it.
answer_request(id: usize, v: Value)
    val mark = root_mark()

    hold(v)

    val wrapped = ok_value(v)

    release(mark)
    answer_plain_request(id, wrapped)
end answer_request

// The same, for the one call whose answer is not a result.
//
// **`exists` answers rather than failing and always could**, so wrapping it would be asking a caller
// to unpack a question that has no failure case.
//
// **The promise is read out before the slot is surrendered**, because surrendering is also what
// clears the slot's copy of it -- the same ordering `fire` needs and for the same reason.
answer_plain_request(id: usize, v: Value)
    if id >= pending.len() then return

    val slot = pending.at(id)

    if !slot.live then return

    val pr = slot.promise

    surrender(id)

    if pr != null then settle_ok(pr, v)
end answer_plain_request

// Fail a request, with the sentence libuv gave.
//
// **The promise SETTLES rather than rejecting**, carrying `{ ok: false, error: ... }`. The span is
// still taken because it says where the call was written, which is what a diagnostic would want if
// this ever went back to raising.
refuse_request(id: usize, at: Span, what: string, e: libuv.Error)
    if id >= pending.len() then return

    val slot = pending.at(id)

    if !slot.live then return

    val pr = slot.promise

    surrender(id)

    if pr != null then settle_ok(pr, err_value(s"${what}: ${e}"))
end refuse_request

// Fail a request with a sentence of slate's own, where there is no libuv error to quote.
deny_request(id: usize, at: Span, message: string)
    if id >= pending.len() then return

    val slot = pending.at(id)

    if !slot.live then return

    val pr = slot.promise

    surrender(id)

    if pr != null then settle_ok(pr, err_value(message))
end deny_request

// A request libuv would not even start is one whose callback will never run, so the promise it was
// given has to fail here instead of waiting forever.
request_started(id: usize, at: Span, what: string, r: Result[unit, libuv.Error]) -> Step
    // **THE PROMISE IS READ BEFORE THE REQUEST CAN BE REFUSED, AND THE ORDER IS THE WHOLE OF IT.**
    // Refusing surrenders the slot, and surrendering clears the slot's copy of the promise -- so
    // `awaited_request` afterwards answers `Promise(null)`, which the machine dereferences and the
    // process dies on a bare SIGSEGV with nothing said. It is the failure path of every call that
    // can be refused before it starts, which is why it went unnoticed: libuv answers nearly
    // everything asynchronously and this arm is only taken when it refuses on the spot.
    val promised = awaited_request(id)

    r match
        Ok(_) -> Ok(promised)
        Err(e) ->
            refuse_request(id, at, what, e)
            Ok(promised)
end request_started

// The same check, for a step taken from inside a callback rather than from the builtin.
//
// **A chain of requests has one promise and several chances to fail to start.** `request_started`
// answers the value the builtin hands back; this one has nobody to answer, and exists only so that a
// step libuv refused fails the promise instead of leaving it pending for the rest of the program.
request_continued(id: usize, at: Span, what: string, r: Result[unit, libuv.Error])
    r match
        Ok(_) -> ()
        Err(e) -> refuse_request(id, at, what, e)

// -- what a program calls --------------------------------------------------------------------------

// `setTimeout(fn, ms)` and `setInterval(fn, ms)`, which differ only in the repeat.
set_timer(cb: Value, ms: long, repeating: bool, at: Span) -> Step
    cb match
        Fn(_) -> ()
        Native(_) -> ()
        other -> return fault(at, s"a timer needs a function to call, and this is ${other.type_name()}")

    val delay = if ms < 0 then 0u64 else u64(ms)
    val every = if repeating then delay else 0u64

    libuv.timer() match
        Err(e) -> fault(at, s"this timer could not be made: ${e}")
        Ok(t) ->
            val id = claim(Pending(cb, null, Some(t), None, true, repeating, 0))

            // **The closure captures the id and not the value**, which is the whole arrangement: the
            // collector cannot see through this box, so what it holds must be something the collector
            // does not have to see.
            t.start(delay, every, () -> fire(id)) match
                Err(e) ->
                    surrender(id)
                    fault(at, s"this timer could not be started: ${e}")
                Ok(_) -> Ok(Int(long(gen_at(id))))
end set_timer

// `sleep(ms)` -- a promise that settles when the time is up.
//
// **This is the one builtin that makes `await` worth having on its own.** Everything else a program
// can build for itself out of an `async` function; waiting for the clock needs a handle, and a handle
// needs the table above.
sleep_promise(ms: long, at: Span) -> Step
    val delay = if ms < 0 then 0u64 else u64(ms)

    libuv.timer() match
        Err(e) -> fault(at, s"this timer could not be made: ${e}")
        Ok(t) ->
            val pr = new_promise()
            val mark = root_mark()

            hold(Promise(pr))

            val id = claim(Pending(Null, pr, Some(t), None, true, false, 0))

            release(mark)

            t.start(delay, 0u64, () -> fire(id)) match
                Err(e) ->
                    surrender(id)
                    fault(at, s"this timer could not be started: ${e}")
                Ok(_) -> Ok(Promise(pr))
end sleep_promise

// `clearTimeout(id)` and `clearInterval(id)`.
//
// **The number a program holds is the GENERATION and not the slot**, which is the whole of what
// makes cancelling safe. A slot is reused, so cancelling a timer by its position cancelled whatever
// had since taken the position -- silently, and the program relying on that second timer simply
// never heard from it. A generation is never reused, so a stale id finds nothing.
//
// That it is a number at all is node's convention. Nothing but this pair of functions reads it, and
// nothing about it is promised beyond being able to name one timer once.
clear_timer(v: Value, at: Span) -> Step
    v match
        Int(n) ->
            if n >= 0
                slot_of_gen(usize(n)) match
                    Some(id) -> surrender(id)
                    None -> ()

            Ok(Null)
        other -> fault(at, s"a timer is cancelled by its id, and this is ${other.type_name()}")

// Run until nothing is outstanding and nothing is owed.
//
// **This is what makes a slate program with a timer in it not exit immediately.** node does the same:
// the process lives as long as something is scheduled.
//
// **Two queues, drained in a fixed order, and the order is the whole rule.** Everything a suspended
// call is owed is handed back *before* the loop is allowed another turn -- so a promise resolved
// inside a timer callback moves its awaiting function along before the next timer fires. Running
// libuv to completion in one go, as this used to, would have batched every callback ahead of every
// resumption and interleaved them in an order nothing could predict. JavaScript's microtask rule is
// exactly this, and it is why `RUN_ONCE` is asked for rather than the default.
drain_events() -> Result[unit, Signal]
    // How many turns in a row have reported nothing active and settled nothing of ours. See the
    // guard below for what it is for.
    var idle = 0

    loop
        run_microtasks()

        // A resumption may have faulted its way out to a promise nobody holds, and a callback may
        // have faulted outright. Either ends the program.
        loop_fault match
            Some(s) -> return Err(s)
            None -> ()

        if outstanding == 0 then break

        // **A turn reporting nothing active does NOT end the drain, and thinking it did cost a
        // working file system.** A timer is a handle and libuv counts it, so a loop with one
        // pending says it is alive and the count and the loop agree. **An `fs` call is a
        // REQUEST**: the turn that answers the last one outstanding processes its callback and
        // *then* reports nothing active, so breaking on that answer throws away everything the
        // callback settled -- the promise resolves, and the coroutine awaiting it is never handed
        // its value because `run_microtasks` at the top of this loop is what does the handing.
        //
        // `outstanding` is the authority on whether there is work, and the loop's answer is only a
        // check on it. Two turns running with nothing active and nothing of ours settled means the
        // count is wrong, and stopping is better than spinning on it.
        if idle >= 2 then break

        // **Read a turn beginning HERE and not after the last one ended.** `run_microtasks` above
        // resumes coroutines, and a resumed coroutine starts the next request -- so a count taken
        // at the bottom of the loop is a count of work this turn had nothing to do with.
        val before = outstanding

        val more = libuv.default_loop().run(libuv.RUN_ONCE) match
            Err(e) -> return Err(failure(point(0), s"the event loop stopped: ${e}"))
            Ok(alive) -> alive

        idle = if !more && outstanding == before then idle + 1 else 0
    end loop

    // A handle that was closed needs one more turn for its close callback, and there is nothing left
    // to wait for -- so this returns as soon as those have run.
    val closed: Result[unit, Signal] = libuv.default_loop().run() match
        Err(e) -> Err(failure(point(0), s"the event loop stopped: ${e}"))
        Ok(_) -> Ok(())

    closed?

    // That last turn may itself have settled something, and a promise settled with nobody handed
    // the answer is a coroutine abandoned mid-statement.
    run_microtasks()

    loop_fault match
        Some(s) -> Err(s)
        None -> Ok(())
end drain_events
