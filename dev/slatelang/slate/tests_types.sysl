module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// Protos, declared types, text, numbers, and what an annotation claims.
//
// A `type` is a named pattern resolved while compiling, so nothing here outlives the compile.

// -- prototypes -------------------------------------------------------------------------------------

@test
a_test_marked_in_a_program_that_is_merely_run_is_an_ordinary_function()
    // `slate foo.sl` registers the tests and calls none of them, so `@test` costs a program that is
    // not being tested one closure and nothing else.
    assert_eq(out("@test\nchecks() =\n    assert(false)\nprint(\"ran the program, not the test\")"), "ran the program, not the test")

// **`proto` is an ordinary field, which is the whole design.** slate already looked `hash` and
// `equals` up by name, so a well-known field is the mechanism the language had rather than a new one:
// no syntax, no new `Value` variant, and `with` works on it like anything else.
//
// **The receiver rule is the part that needed thought.** A method stored on the object has captured
// what it needs -- `p.equals = o -> o.x == p.x` is what slate has always written -- and one shared
// through a proto cannot have, there being one of it for every instance. So the shared kind is handed
// the object and the captured kind is not, and that is not a special case: it is the actual
// difference between the two.

@test
a_method_on_a_proto_is_given_the_object_it_was_found_on()
    assert_eq(out(Pointish + "print(point(3, 4).dist())"), "25")

@test
a_proto_supplies_plain_fields_and_not_only_methods()
    assert_eq(out(Pointish + "print(point(1, 1).kind)"), "a point")

@test
a_field_on_the_object_shadows_the_protos()
    assert_eq(out(Pointish + "print({ x: 1, y: 1, proto: Point, kind: \"mine\" }.kind)"), "mine")

@test
a_captured_method_is_still_given_no_receiver()
    // **The compatibility claim, and the reason the rule is written this way.** Every hook slate had
    // before protos existed is a closure that captured its object, and `apply` faults on an arity
    // mismatch -- so a receiver passed to one of those would have broken every one of them.
    val prog = "f() =\n    var o = { n: 5 }\n    o.double = () -> o.n * 2\n    o\nprint(f().double())"

    assert_eq(out(prog), "10")

@test
a_method_taken_off_an_object_is_the_bare_function()
    // `o.m` is a `GetField` and hands back what it found; only `o.m(...)` passes a receiver. Taking a
    // method off an object and calling it later is allowed, and what you get is what you took.
    assert_eq(out(Pointish + "val p = point(3, 4)\nval f = p.dist\nprint(f(p))"), "25")

@test
a_proto_may_have_a_proto()
    val prog = "val Shape = { describe: self -> s\"${self.kind} of ${self.area()}\", kind: \"shape\" }\nval Square = { proto: Shape, kind: \"square\", area: self -> self.side * self.side }\nprint({ side: 4, proto: Square }.describe())"

    // The method on the outer proto calls one the inner proto supplies, which is dispatch through
    // the chain rather than a name resolved where it was written.
    assert_eq(out(prog), "square of 16")

@test
a_proto_is_the_nominal_identity_and_needs_no_syntax()
    // **For a HAND-WRITTEN proto this is the only way to ask**, because a bare name in pattern
    // position is a binding -- sysl's rule and slate's -- and nothing has told the compiler that
    // `Point` names a kind rather than a variable. `class` is what says so, and `p is Square` is the
    // better question once something has: `==` on objects is deep, so the test below answers true for
    // any object holding the same fields, and it looks exactly one link up the chain.
    assert_eq(out(Pointish + "print(point(1, 2).proto == Point)"), "true")
    assert_eq(out(Pointish + "print({ x: 1 }.proto == Point)"), "false")

@test
a_hook_may_come_from_a_proto()
    // What makes a proto a place for shared *behaviour*: one `hash` and one `equals` serving every
    // object that delegates to them, so two objects with different data are one key.
    val prog = "val Keyed = { hash: () -> 7, equals: o -> true }\nvar t = {}\nt[{ v: 1, proto: Keyed }] = \"stored\"\nprint(t[{ v: 2, proto: Keyed }], len(t))"

    assert_eq(out(prog), "stored 1")

@test
a_circle_of_protos_is_a_sentence_rather_than_a_hang()
    // A `proto` is an ordinary field, so a program can point one at itself -- and a lookup that
    // misses would otherwise walk forever with nothing to report.
    val said = fails("var o = { n: 1 }\no.proto = o\nprint(o.missing)")

    assert(said.contains("`proto` chain is more than 64 deep"))
    assert(said.contains("which means it is a circle"))

@test
calling_a_field_that_is_not_there_says_so()
    assert(fails("print({ n: 1 }.nope())").contains("`nope` is not a field of this object"))

    // **A builtin's set of names is closed, so a miss names the KIND rather than the field.** An
    // object grows fields over its life and a missing one is an ordinary state; an integer's method
    // list is fixed, and a name that is not on it is a mistake at the call.
    assert(fails("print(5 .nope())").contains("`nope` is not something an integer can do"))

// -- types -------------------------------------------------------------------------------------------

@test
a_proto_costs_one_table_rather_than_one_closure_per_object()
    // **The measurement the design is for.** Three methods written as captured closures cost three
    // closures per instance; on a proto they cost three once. Six thousand objects is over the line
    // one way and inside it the other.
    //
    // **Run against a fixed four megabytes rather than whatever the heap happens to be**, so the
    // numbers mean something a year from now. This test was written against a 4 MiB heap, failed the
    // day the heap became 16 MiB and again the day it became 256, which is two more times than a
    // measurement should have to be re-derived.
    val captured = "make(x) =\n    var o = { x: x }\n    o.a = () -> o.x\n    o.b = () -> o.x\n    o.c = () -> o.x\n    o\nvar xs = []\nvar i = 0\nwhile i < 6000\n    push(xs, make(i))\n    i += 1\nprint(len(xs))"
    val shared = "val P = { a: self -> self.x, b: self -> self.x, c: self -> self.x }\nvar xs = []\nvar i = 0\nwhile i < 6000\n    push(xs, { x: i, proto: P })\n    i += 1\nprint(len(xs))"

    set_heap_limit(4194304)

    val crowded = fails(captured)
    val roomy = out(shared)

    set_heap_limit(268435456)

    assert(crowded.contains("run out of memory"), "six thousand objects with captured methods now fit in four megabytes, so the cost of a closure has changed")
    assert_eq(roomy, "6000")

// **A type is a named PATTERN, and that is the whole design.** slate already had structural tests
// over object shapes, so a type is one of those given a name -- `p is Point` is the `is` slate always
// had, and nothing of a type exists at run time.
//
// It is TypeScript's `type`, deliberately: the same declaration, the same structural reading. What
// differs is that slate's is not erased, so one declaration serves both the pattern and the check at
// a boundary -- which is the pair TypeScript users write twice, once as a `type` and once as a zod
// schema.

@test
a_type_is_a_named_pattern()
    assert_eq(out(Shapes + "print({ x: 1, y: 2 } is Point)"), "true")
    assert_eq(out(Shapes + "print({ x: 1 } is Point)"), "false")

@test
a_type_matches_an_object_that_has_at_least_those_fields()
    // The object pattern's own rule, inherited rather than restated: a record grows fields over its
    // life, and a test that broke whenever one was added would be one nobody could keep working.
    assert_eq(out(Shapes + "print({ x: 1, y: 2, z: 3 } is Point)"), "true")

@test
a_type_stands_where_a_match_arm_does()
    val prog = Shapes + "describe(v) = v match\n    Point -> \"a point\"\n    Named -> \"named\"\n    _ -> \"other\"\nprint(describe({ x: 1, y: 2 }), describe({ name: \"bob\" }), describe(5))"

    assert_eq(out(prog), "a point named other")

@test
a_type_may_be_written_in_terms_of_another()
    val prog = Shapes + "type Line = { a: Point, b: Point }\nval p = { x: 1, y: 2 }\nprint({ a: p, b: p } is Line, { a: p, b: { x: 1 } } is Line)"

    assert_eq(out(prog), "true false")

@test
a_bare_name_that_names_no_type_still_binds()
    // **sysl's rule, and slate had it already**: a bare identifier in pattern position is a test when
    // it names something and a binding otherwise. Declaring a type is what makes the name name
    // something; nothing else about patterns changed.
    assert_eq(out("print(5 match\n    anything -> s\"bound ${anything}\")"), "bound 5")

@test
a_parameter_may_say_what_it_takes_and_is_told_where_it_arrived()
    // **The whole reason to write one.** The complaint lands where the value was handed over rather
    // than wherever it was first used wrongly, which is most of what a type buys a dynamic language.
    assert_eq(out(Shapes + "area(p: Point) = p.x * p.y\nprint(area({ x: 3, y: 4 }))"), "12")

    val said = fails(Shapes + Opaque + "area(p: Point) = p.x * p.y\nprint(area(anything({ x: 1 })))")

    assert(said.contains("`p` was declared Point, and was given {x: 1}"))

@test
an_unannotated_function_is_the_tree_it_always_was()
    // The body is left alone where nothing was annotated, so nothing pays for the feature.
    assert_eq(good_tree("f(x) = x + 1"), "(def f(x) (+ x 1))")
    assert(good_tree("f(x: number) = x + 1").contains("(check x number)"))

@test
a_type_declared_inside_a_block_is_refused()
    assert(fails("if true\n    type T = { a: number }").contains("a type belongs to the top level of a file"))

@test
a_type_may_annotate_more_than_one_parameter_and_hold_brackets()
    // The lookahead that tells a definition from a call has to skip an annotation's pattern with its
    // brackets balanced, which is what this would catch.
    val prog = "type Pair = { a: number, b: number }\nboth(p: Pair, q: { xs: array }) = p.a + len(q.xs)\nprint(both({ a: 1, b: 2 }, { xs: [1, 2] }))"

    assert_eq(out(prog), "3")

// -- types across a file -----------------------------------------------------------------------

@test
an_exported_type_crosses_a_file()
    // **`export type` is how an interface leaves the file it was written in**, which is most of what
    // an interface is for. Nothing of it reaches run time: the compiler drops the binding, the module
    // having no field of that name, and resolves the name where it stands in a pattern instead.
    assert_eq(ran_out("tests/mods/uses_types.sl"), "true\nfalse\n12\nbound 5\ntrue false")

@test
a_type_that_was_not_exported_stays_in_its_own_file()
    // In the importing file `Secret` is an ordinary binding, which is what the fixture's third line
    // shows -- and the file that declared it still tests with it.
    val said = ran_out("tests/mods/uses_types.sl")

    assert(said.contains("bound 5"))

// -- text, counted in characters ----------------------------------------------------------------

@test
asking_for_a_type_a_file_does_not_export_is_the_same_diagnostic_as_any_other()
    // `Secret` is declared in `shapes.sl` without `export`, so it is no more importable than an
    // unexported `val` -- and the message lists what the file does offer, `Point` among it, which is
    // what says a type counts as an export rather than being invisible to the check.
    val said = ran_fault("tests/mods/wants_private_type.sl")

    assert(said.contains("does not export `Secret`"))
    assert(said.contains("`Point`"))
    assert(said.contains("`origin`"))

    // **The list and the suggestion answer different questions and a narrow file gets both**: what
    // else is there, for a reader of an unfamiliar file, and which one was probably meant, for a
    // reader who mistyped.
    assert(said.contains("did you mean `isSecret`?"))

// **A slate string is a sequence of CHARACTERS and never of bytes**, which is the user's call and
// the only defensible one: `len("日本語")` answering nine and `"日本語"[0..<1]` answering a third of
// a character are facts about UTF-8 leaking through a language that has no business exposing it.
//
// Both of those were the behaviour until this landed, so every test here would have failed before it
// and several are as much regression tests as they are specifications.

@test
a_string_is_measured_in_characters()
    assert_eq(out("print(len(\"日本語\"))"), "3")
    assert_eq(out("print(len(\"héllo\"))"), "5")
    assert_eq(out("print(len(\"\"))"), "0")

@test
a_string_is_cut_at_character_boundaries()
    // Cut by bytes these answer half a character each, which is what they used to do.
    assert_eq(out("print(\"日本語\"[0..<1])"), "日")
    assert_eq(out("print(\"日本語\"[1..])"), "本語")
    assert_eq(out("print(\"héllo\"[0..<2])"), "hé")

@test
a_character_is_a_string_of_one()
    // **There is still no character type**, so indexing answers a string -- which is Python's answer
    // and is what lets `s[i]`, `chars` and `split` all hand back the same kind of thing.
    assert_eq(out("print(\"日本語\"[2])"), "語")
    assert_eq(out("print(\"héllo\"[1])"), "é")
    assert(fails("print(\"abc\"[5])").contains("the index 5 is outside a string of 3 characters"))

@test
chars_takes_a_string_apart()
    assert_eq(out("print(chars(\"añb\"))"), "[\"a\", \"ñ\", \"b\"]")
    assert_eq(out("print(chars(\"\"))"), "[]")

@test
split_and_join_are_the_two_directions()
    assert_eq(out("print(split(\"a,b,,c\", \",\"))"), "[\"a\", \"b\", \"\", \"c\"]")
    assert_eq(out("print(join([\"a\", \"b\"], \"-\"))"), "a-b")

    // Anything that is not a string joins as `print` would render it.
    assert_eq(out("print(join([1, true, \"x\"], \" \"))"), "1 true x")

    // An empty separator splits into characters, which is what every language answering this at all
    // answers -- and saves reaching for `chars` under another name.
    assert_eq(out("print(split(\"abc\", \"\"))"), "[\"a\", \"b\", \"c\"]")

@test
searching_answers_positions_a_person_would_count()
    // **In characters.** `indexOf("héllo", "llo")` is 2 by character and 3 by byte, which is the
    // shortest input that tells the two apart.
    assert_eq(out("print(indexOf(\"héllo\", \"llo\"))"), "2")
    assert_eq(out("print(lastIndexOf(\"abcabc\", \"b\"))"), "4")

    // **Null rather than -1**, because slate has a null and the operators that go with it.
    assert_eq(out("print(indexOf(\"hello\", \"z\"))"), "null")
    assert_eq(out("print(indexOf(\"hello\", \"z\") ?? 0)"), "0")

    assert_eq(out("print(contains(\"hello\", \"ell\"), contains(\"hello\", \"z\"))"), "true false")
    assert_eq(out("print(startsWith(\"hello\", \"he\"), endsWith(\"hello\", \"lo\"))"), "true true")

@test
trimming_takes_whitespace_off_the_ends()
    assert_eq(out("print(\"[\" + trim(\"  hi \\t \") + \"]\")"), "[hi]")
    assert_eq(out("print(\"[\" + trimStart(\"  hi  \") + \"]\")"), "[hi  ]")
    assert_eq(out("print(\"[\" + trimEnd(\"  hi  \") + \"]\")"), "[  hi]")
    assert_eq(out("print(\"[\" + trim(\"   \") + \"]\")"), "[]")

@test
replacing_and_repeating()
    assert_eq(out("print(replace(\"a-b-c\", \"-\", \"+\"))"), "a+b+c")
    assert_eq(out("print(repeat(\"ab\", 3))"), "ababab")
    assert_eq(out("print(repeat(\"ab\", 0))"), "")

    // Replacing nothing would put the new text between every pair of characters, which is never what
    // was meant.
    assert(fails("print(replace(\"abc\", \"\", \"x\"))").contains("cannot replace the empty string"))
    assert(fails("print(repeat(\"a\", -1))").contains("a count that is not negative"))

@test
CASE_CONVERSION_IS_ASCII_AND_SAYS_SO()
    // **A KNOWN LIMIT, pinned so that it is a decision rather than a surprise.** `sysl.text`'s
    // `to_upper` is ASCII by design and documents itself as such -- a Unicode case table is above
    // that layer and slate has none. So `é` comes back untouched, which is wrong for a language that
    // has just been told to count in characters, and is worth a card rather than a quiet paper-over.
    assert_eq(out("print(upper(\"abc\"), lower(\"ABC\"))"), "ABC abc")
    assert_eq(out("print(upper(\"héllo\"))"), "HéLLO")
    assert_eq(out("print(lower(\"HÉLLO\"))"), "hÉllo")

// -- numbers -----------------------------------------------------------------------------------

@test
num_reads_a_number_out_of_a_string()
    // **A whole number where it was written as one**, which is the distinction slate keeps
    // everywhere else and would be odd to drop here.
    assert_eq(out("print(number(\"42\"), number(\"-7\"))"), "42 -7")
    assert_eq(out("print(number(\"3.5\"))"), "3.5")
    assert_eq(out("print(number(\"nope\"), number(\"\"))"), "null null")

    // A number given to it is already one.
    assert_eq(out("print(number(7), number(1.5))"), "7 1.5")

@test
integer_and_real_move_between_the_two_kinds()
    assert_eq(out("print(integer(3.7), integer(-3.7), integer(4))"), "3 -3 4")
    assert_eq(out("print(real(3))"), "3")
    assert(fails("print(integer(\"3\"))").contains("`number` is what reads one out of a string"))

@test
rounding_keeps_the_kind_it_was_given()
    // An integer is already whole, so all four leave one alone rather than making it a real.
    assert_eq(out("print(floor(3.7), ceil(3.2), round(3.5), trunc(-3.7))"), "3 4 4 -3")
    assert_eq(out("print(floor(3), ceil(3), round(3), trunc(3))"), "3 3 3 3")

@test
the_arithmetic_a_program_reaches_for()
    assert_eq(out("print(abs(-4), abs(-4.5))"), "4 4.5")
    assert_eq(out("print(sqrt(16), pow(2, 10))"), "4 1024")
    assert(fails("print(sqrt(-1))").contains("a number that is not negative"))

@test
min_and_max_take_as_many_as_they_are_given()
    assert_eq(out("print(min(3, 1, 2), max(3, 1, 2))"), "1 3")
    assert_eq(out("print(min(5))"), "5")

    // **Integers in, integer out.** A `min` answering a real for two integers would make every use
    // of it in an index a conversion.
    assert_eq(out("print(min(1.5, 2))"), "1.5")
    assert(fails("print(min())").contains("at least one number"))

// -- optional and union types ---------------------------------------------------------------------

@test
a_text_builtin_says_what_it_wanted_when_given_something_else()
    assert(fails(Opaque + "print(anything(len)())").contains("`len` takes one argument"))
    assert(fails(Opaque + "print(split(anything(5), \",\"))").contains("`split` takes a string"))
    assert(fails(Opaque + "print(join(anything(5), \",\"))").contains("`join` takes an array"))
    assert(fails(Opaque + "print(trim(anything(5)))").contains("`trim` takes a string"))
    assert(fails(Opaque + "print(anything(upper)())").contains("`upper` takes one string"))
    assert(fails(Opaque + "print(abs(anything(\"x\")))").contains("`abs` takes a number"))

// **Annotating a parameter is optional per PARAMETER**, and a type may be a union -- including one
// with `null` in it, which is how a parameter says it will take nothing.
//
// The union case needed a fix rather than a feature. A name standing in a pattern is a type where one
// was declared and a binding otherwise, and which it is cannot be known while parsing -- so the
// parser's "no alternative may bind" check refused `Point | null` before anything had a chance to
// resolve it. The check now runs where the answer exists.

@test
a_parameter_list_may_annotate_some_and_not_others()
    assert_eq(out("type Point = { x: number }\nmixed(a, b: Point, c) = s\"${a} ${b.x} ${c}\"\nprint(mixed(1, { x: 2 }, 3))"), "1 2 3")

@test
a_type_may_be_a_union_and_may_include_null()
    val prog = "type Point = { x: number, y: number }\ntype MaybePoint = Point | null\nhere(p: MaybePoint) = if p == null then \"nowhere\" else s\"at ${p.x}\"\nprint(here({ x: 1, y: 2 }), here(null))"

    assert_eq(out(prog), "at 1 nowhere")

    // And what the union does not cover is still refused where the value arrives.
    val said = fails("type Point = { x: number, y: number }\ntype MaybePoint = Point | null\n" + Opaque + "here(p: MaybePoint) = 1\nprint(here(anything(5)))")

    assert(said.contains("`p` was declared MaybePoint, and was given 5"))

@test
a_union_may_be_written_over_several_shapes()
    val prog = "type Shape = { side: number } | { radius: number } | null\nprint({ side: 2 } is Shape, { radius: 1 } is Shape, null is Shape, 5 is Shape)"

    assert_eq(out(prog), "true true true false")

@test
an_alternative_that_really_binds_is_still_refused()
    // **The check the parser used to make, moved to where the answer exists.** `n | 0` would leave
    // `n` bound down one path and not the other, and slate has no type system to notice -- so it is
    // refused, and now says what to write instead.
    val said = fails("print(5 match\n    n | 0 -> \"bound\"\n    _ -> \"no\")")

    assert(said.contains("an alternative of a pattern may not bind a name"))
    assert(said.contains("write a type where one was meant"))

// -- a type is a shape, not a destructuring ---------------------------------------------------------

@test
a_compile_time_complaint_stops_the_program_as_a_parse_error_does()
    // The compiler had nothing to complain *with* until types existed: everything before then was a
    // parse error or something a `FailWith` carried to run time. This one is knowable while compiling
    // and has no value to attach itself to, so it needed a channel of its own.
    val r = run(source_of("t", "print(5 match\n    n | 0 -> 1\n    _ -> 2)"))

    assert(!r.ok())
    assert_eq(r.printed(), "")

// **A type is a named pattern, so nothing stopped one holding a bare name -- and a bare name binds.**
// `type Tagged = { x: n }` introduced `n` at every site that used the type, including out of an `is`
// into the surrounding scope. A declaration that reads as a shape should not put a name in scope.
//
// It is also what the union rule already said: an alternative may not bind, for the same reason. A
// whole type being allowed to was the inconsistency rather than the rule.

@test
a_type_may_not_bind_a_name()
    val said = fails("type Tagged = { x: n }\nprint({ x: 1 } is Tagged)")

    assert(said.contains("a type is a shape, so `Tagged` may not bind `n`"))

@test
a_type_that_bound_a_name_used_to_leak_it_into_the_enclosing_scope()
    // **The behaviour the refusal exists to stop, written down so the reason survives.** `is` binds
    // into the scope it is written in, which is what makes `x is Pat` useful -- and a *type* holding
    // a binding turned that into a name appearing from a declaration somewhere else entirely.
    val said = fails("type Tagged = { x: n }\nprint({ x: 1 } is Tagged)\nprint(n)")

    assert(said.contains("may not bind"))

    // **BOTH complaints are made now**, and that is right: the type is refused, so nothing binds
    // `n`, so the `print(n)` under it is a name nothing defines. The refusal that matters is still
    // the first one, and it is the one the reader acts on.
    assert(said.contains("`n` is not defined"))

@test
a_type_written_in_terms_of_itself_is_refused_and_says_so()
    // **A latent one, found by the same check.** `resolve_pattern` gives up at 32 levels and hands
    // back the unresolved name -- which is a binding, so the type silently became "anything" that
    // deep. Refusing it says what is actually wrong rather than leaving a shape that quietly matches.
    val said = fails("type T = { next: T }\nprint(1)")

    assert(said.contains("`T` is written in terms of itself"))
    assert(said.contains("rather than one that nests without end"))

@test
a_type_over_other_types_is_still_ordinary()
    // The check must not catch a type that merely names another, which is the common case.
    val prog = "type Pt = { x: number, y: number }\ntype Line = { a: Pt, b: Pt }\nval p = { x: 1, y: 2 }\nf(q: Pt) = q.x\nprint({ a: p, b: p } is Line, f(p))"

    assert_eq(out(prog), "true 1")

// -- an annotation that names nothing ---------------------------------------------------------------

@test
a_pattern_outside_a_type_may_still_bind_as_it_always_could()
    // Nothing about ordinary patterns changed: `is` and a `match` arm bind, which is what they are
    // for. The rule is about a *declaration*.
    assert_eq(out("print({ x: 7 } match\n    { x: v } -> v)"), "7")
    assert_eq(out("val ok = { x: 7 } is { x: v }\nprint(ok, v)"), "true 7")

// **A CHECK THAT QUIETLY PASSES IS WORSE THAN NO CHECK, because the reader believes it.** A bare name
// in pattern position is a binding where it names no type, and a binding matches anything -- so an
// annotation naming a type that does not exist accepted every value and bound the type's name inside
// the function. Found by asking what `f(x: string)` did back when slate's word was `str`.

@test
an_annotation_naming_no_type_is_refused()
    val said = fails("h(x: Undeclared) = 1\nprint(h(9))")

    assert(said.contains("`Undeclared` is not a type, so checking `x` against it would check nothing"))
    assert(said.contains("declare it with `type`"))

@test
an_annotation_refusal_guesses_what_was_meant()
    // The words another language would have taught a reader, guessed at the moment of the mistake
    // rather than left to a list in a manual.
    assert(fails("f(x: str) = x").contains("slate's word is `string`"))
    assert(fails("f(x: num) = x").contains("slate's word is `number`"))
    assert(fails("f(x: bool) = x").contains("slate's word is `boolean`"))
    assert(fails("f(x: fn) = x").contains("slate's word is `function`"))
    assert(fails("f(x: int) = x").contains("slate's word is `integer`"))
    assert(fails("f(x: float) = x").contains("slate's word is `real`"))

@test
an_annotation_may_not_bind_anywhere_inside_itself()
    // Not only the bare form: a shape holding a binding checks less than it appears to.
    assert(fails("f(p: { x: n }) = p.x").contains("would check nothing"))

@test
the_type_test_words_are_string_and_number()
    // **The user's call**, so that a reader coming from anywhere else writes what they expect. The
    // builtins keep their own names and do not collide: a word in pattern position is read by
    // `type_test_named` and nowhere else.
    assert_eq(out("print(\"a\" is string, 1 is number, 1.5 is number)"), "true true true")
    assert_eq(out("f(x: string) = x\ng(n: number) = n\nprint(f(\"hi\"), g(3))"), "hi 3")
    assert(fails(Opaque + "f(x: string) = x\nprint(f(anything(1)))").contains("`x` was declared string, and was given 1"))

    // `str` renders and `num` parses, both still functions.
    assert_eq(out("print(string(42) + \"!\", number(\"42\") + 1)"), "42! 43")

@test
a_type_word_tests_in_a_pattern_and_converts_in_an_expression()
    // **The two positions never overlap**, so one word does both: a word in pattern position is read
    // by `type_test_named` and nowhere else.
    assert_eq(out("print(string(123), string(1.5), string(true), string([1, 2]))"), "123 1.5 true [1, 2]")
    assert_eq(out("print(number(\"42\"), integer(3.9), real(3))"), "42 3 3")
    assert_eq(out("print(1 is integer, 1.5 is real, true is boolean, (() -> 1) is function)"), "true true true true")

// -- what a call answers, and `any` -----------------------------------------------------------------

@test
boolean_is_truthiness_and_slates_truthiness_is_not_javascripts()
    // **Only `null`, `undefined` and `false` are falsy**, which is Lua's rule and slate's own `if`.
    // A reader from JavaScript will expect `boolean(0)` to be false; it is not, and `if 0` agrees.
    assert_eq(out("print(boolean(null), boolean(false), boolean(0), boolean(\"\"), boolean([]))"), "false false true true true")
    assert_eq(out("print(if 0 then \"t\" else \"f\", if \"\" then \"t\" else \"f\")"), "t t")

// **`-> type` had to come first, because nothing downstream of a call can be checked without it.**
// It is read where a parameter's annotation is read and wraps the body the same way, so `Def` and
// `Lambda` learn nothing and neither does anything that reads them.
//
// The check it emits today is a runtime one, testing what the body left on the stack. What it is
// *for* is the static pass that will read `Type` instead.

@test
a_definition_may_say_what_it_answers()
    assert_eq(out("double(x: number) -> number = x * 2\nprint(double(4))"), "8")
    assert_eq(out("greet(who: string) -> string\n    s\"hello ${who}\"\nprint(greet(\"world\"))"), "hello world")
    assert_eq(out("count(xs: array) -> integer = len(xs)\nprint(count([1, 2, 3]))"), "3")

@test
answering_the_wrong_kind_is_a_fault_where_it_was_answered()
    val said = fails("name(p: { id: number }) -> string = p.id\nprint(name({ id: 7 }))")

    assert(said.contains("this answers string, and gave back 7"))

@test
a_result_annotation_naming_no_type_is_refused_and_points_at_itself()
    // **At the annotation, not at the body.** The wrapped expression is the whole function; what a
    // reader has to change is the `-> Nope`.
    val said = fails("bad(x) -> Nope = x")

    assert(said.contains("`Nope` is not a type, so `-> Nope` would check nothing"))
    assert(said.contains("1 | bad(x) -> Nope = x"))

@test
any_is_a_type_and_matches_everything()
    // **What an unannotated thing is**, and the shape a gradual system has to have: slate is
    // dynamically typed at the edges and always will be, so `any` is a claim about a value rather
    // than a refusal to make one.
    assert_eq(out("f(x: any) -> any = x\nprint(f(1), f(\"s\"), f(null))"), "1 s null")
    assert_eq(out("print(1 is any, null is any, [] is any)"), "true true true")

@test
a_type_is_read_off_an_annotation_and_said_back()
    // **`Type` is not `Pattern`, which is the whole reason it exists** -- a pattern tests a value and
    // a type describes one. One annotation makes both: the pattern goes to the machine and the type
    // stays for the checker. This is what proves the fork works before anything reads the far side.
    assert_eq(type_text("number"), "number")
    assert_eq(type_text("any"), "any")
    assert_eq(type_text("array"), "array")
    assert_eq(type_text("{ x: number, y: string }"), "{ x: number, y: string }")
    assert_eq(type_text("string | null"), "string | null")
    assert_eq(type_text("{ a: { b: boolean } }"), "{ a: { b: boolean } }")

@test
A_NAME_A_PATTERN_TESTED_AND_BOUND_CARRIES_THE_TESTS_TYPE()
    // **`n @ int` is the one place a pattern says something a walk can use.** A bare name matches
    // anything, so anything is what is known about it; `@` is the spelling slate already had for
    // testing and naming at once, and the name is worth exactly what the test proved.
    //
    // What it buys is the method-name check, which is this pass's best feature -- a name that could
    // only ever hold an integer being asked to `push`.
    assert(fails("val v = 3\nprint(v match\n    n @ int -> n.push(1)\n    _ -> \"?\")").contains("`push` is not something an integer can do"))

    // And the right call on the same name is untouched.
    assert_eq(out("val v = \"abc\"\nprint(v match\n    s @ string -> s.upper()\n    _ -> \"?\")"), "ABC")

@test
A_CLASS_NAME_IN_AN_AT_PATTERN_IS_RESOLVED_LIKE_ANY_OTHER_TYPE()
    // The sub-pattern goes through `resolve_pattern` before it is read for a type, so a declared
    // `type` and a `class` both work where a bare name would have been a binding and answered `any`.
    val prog = "type Two = { a: integer, b: integer }\nval v = { a: 1, b: 2 }\nprint(v match\n    t @ Two -> t.a + t.b\n    _ -> 0)"

    assert_eq(out(prog), "3")

@test
THE_NAME_A_catch_BINDS_IS_KNOWN_TO_BE_A_FAULT()
    // **The one name in the language whose shape is known without anybody writing it down.** `throw`
    // turns whatever a program raised into the same three fields every other fault leaves, so a
    // `catch` name is `{ message, line, file }` and nothing else has to say so.
    assert(fails("try\n    throw \"x\"\ncatch e\n    print(e.push(1))").contains("`push` is not a field of this object"))

    // **Reading a field it does not list is still allowed, and that is not an oversight.** An object
    // type means AT LEAST these fields, and a program may write more onto a fault it caught.
    assert_eq(out("try\n    throw \"x\"\ncatch e\n    e.retry = () -> \"again\"\n    print(e.message, e.retry())"), "x again")
