module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// Reading a pattern.
//
// A pattern is a tree of its own, parsed by ordinary recursive descent -- there is no precedence to
// speak of, `|` being the only thing that joins two of them.
//
// **A pattern is not an expression, and reading it with the expression parser would have been the
// tempting mistake.** They overlap almost entirely in surface -- `[a, b]`, `{ name: n }`, `1` -- and
// differ in what a *name* means: in an expression a name is read, and in a pattern it is written.
// Reading one as the other and converting afterwards would put the complaint about `[1 + 1]` in a
// function that no longer knows a pattern was wanted.

// One pattern, alternatives included.
parse_pattern(p: *Parser) -> Pattern
    val first = parse_primary_pattern(p)

    if !p.at(Pipe) then return first

    var alts: Buf[Pattern] = buf()

    alts.push(first)

    loop
        if !p.accept(Pipe) then break

        alts.push(parse_primary_pattern(p))

    // **No alternative may bind.** `n | 0` would leave `n` bound down one path and not the other,
    // so every use of it below would be a name that may or may not exist -- and slate has no type
    // system to notice. Scala refuses the same thing for the same reason.
    for i in 0..<alts.len()
        if binds(alts.at(i))
            p.fault(alts.at(i).span, "an alternative of a pattern may not bind a name")

    pattern(first.span.to(alts.at(alts.len() - 1).span), OrPat(alts))
end parse_pattern

// Whether a pattern binds anything, used to refuse a binding inside alternatives.
private binds(pat: Pattern) -> bool
    *pat.kind match
        Bind(_) -> true
        At(_, _) -> true
        ArrayPat(items, _, rest) ->
            if rest.is_some() then return true

            for i in 0..<items.len()
                if binds(items.at(i)) then return true

            false
        ObjectPat(_, values) ->
            for i in 0..<values.len()
                if binds(values.at(i)) then return true

            false
        OrPat(alts) ->
            for i in 0..<alts.len()
                if binds(alts.at(i)) then return true

            false
        _ -> false
end binds

// What a bare identifier in pattern position means.
//
// **Three answers, and the order between them is the rule.** `_` is the wildcard; a name that is one
// of slate's kinds is a test for that kind; anything else binds. That is sysl's bare-name rule with
// `Value`'s variants standing in for the scrutinee's enum's, and it is why a type test needs no
// syntax of its own.
//
// `n @ pat` follows the name where one is given, which is the spelling sysl uses for the same thing
// and is how a program tests and binds at once.
private bare_name_pattern(p: *Parser, at: Span) -> Pattern
    p.bump()

    val name = p.text(at)

    // `_` is an ordinary identifier to the lexer -- `is_ident_start` takes it -- so the wildcard is
    // decided here, by the text. That keeps `_` usable as a name everywhere else, the same bargain
    // `end` gets.
    if name == "_" then return pattern(at, Wild)

    if p.accept(At)
        val inner = parse_primary_pattern(p)

        return pattern(at.to(inner.span), At(name, inner))
    end if

    type_test_named(name) match
        Some(test) -> pattern(at, TypePat(test))
        None -> pattern(at, Bind(name))
end bare_name_pattern

private parse_primary_pattern(p: *Parser) -> Pattern
    val at = p.here()

    p.peek() match
        Ident -> bare_name_pattern(p, at)
        IntLit ->
            p.bump()
            pattern(at, IntPat(read_int_at(p, at)))
        RealLit ->
            p.bump()
            pattern(at, RealPat(read_real_at(p, at)))
        StrLit ->
            p.bump()
            pattern(at, StrPat(read_str_at(p, at)))
        True ->
            p.bump()
            pattern(at, BoolPat(true))
        False ->
            p.bump()
            pattern(at, BoolPat(false))
        Null ->
            p.bump()
            pattern(at, NullPat)
        Minus -> negative_number_pattern(p, at)
        LBracket -> array_pattern(p, at)
        LBrace -> object_pattern(p, at)
        _ ->
            p.report.add(expected(at, "a pattern", p.found(at)))
            p.bump()
            pattern(at, Wild)
end parse_primary_pattern

// `-1` and `-1.5`.
//
// A pattern has no arithmetic, so the minus is part of the literal rather than an operator -- which
// is why it is read here and not by anything general.
private negative_number_pattern(p: *Parser, at: Span) -> Pattern
    p.bump()

    val here = p.here()

    p.peek() match
        IntLit ->
            p.bump()
            pattern(at.to(here), IntPat(-read_int_at(p, here)))
        RealLit ->
            p.bump()
            pattern(at.to(here), RealPat(-read_real_at(p, here)))
        _ ->
            p.report.add(expected(here, "a number after `-` in a pattern", p.found(here)))
            pattern(at, Wild)
end negative_number_pattern

// `[a, b]`, `[]`, and `[first, ...rest]`.
private array_pattern(p: *Parser, at: Span) -> Pattern
    p.bump()

    var items: Buf[Pattern] = buf()
    var open = false
    var rest: Option[string] = None

    if !p.at(RBracket)
        loop
            if p.accept(Spread)
                open = true

                // **A name after `...` is optional**, and its absence is what `[a, ...]` means: at
                // least one element, and the others are none of this arm's business.
                if p.at(Ident) then rest = Some(parse_name(p, "a name for the rest of the array"))

                // Nothing may follow it, because what is left over has no end to be counted from.
                // A pattern like `[...init, last]` is a different feature and slate does not have it.
                if !p.at(RBracket)
                    p.fault(p.here(), "`...` gathers the rest of the array, so nothing may follow it")

                break
            end if

            items.push(parse_pattern(p))

            if !p.accept(Comma) then break
            if p.at(RBracket) then break

    p.expect(RBracket, "`]`")

    pattern(at.to(p.just_taken()), ArrayPat(items, open, rest))
end array_pattern

// `{ name: n }`, and `{ name }` as shorthand for `{ name: name }`.
private object_pattern(p: *Parser, at: Span) -> Pattern
    p.bump()

    var keys: Buf[string] = buf()
    var values: Buf[Pattern] = buf()

    if !p.at(RBrace)
        loop
            val key_at = p.here()
            val key = parse_name(p, "a field name")

            keys.push(key)

            // **`{ name }` binds `name`**, which is the shorthand every language with object
            // patterns grows, and is worth having because the long form repeats the word.
            if p.accept(Colon)
                values.push(parse_pattern(p))
            else
                values.push(pattern(key_at, Bind(key)))

            if !p.accept(Comma) then break
            if p.at(RBrace) then break

    p.expect(RBrace, "`}`")

    pattern(at.to(p.just_taken()), ObjectPat(keys, values))
end object_pattern

// The arms of a `match`, which are an indented block of `pattern -> body` lines.
parse_arms(p: *Parser) -> Buf[Arm]
    var arms: Buf[Arm] = buf()

    if !p.expect(Indent, "an indented list of `pattern -> result` arms") then return arms

    p.skip_newlines()

    loop
        if p.at(Dedent) || p.at(Eof) then break

        arms.push(parse_arm(p))

        if !p.end_of_statement()
            // **A `match` written as an argument must be the last one, and this is where that shows
            // up.** The block its arms live in is closed by the bracket, so anything between the
            // last arm and the `)` is inside the block -- a `,` there reads as a stray token in an
            // arm, and the generic complaint about it says nothing a person could act on.
            if p.at(Comma)
                p.fault(p.here(), "a `match` written as an argument has to be the last argument")
            else
                p.fault(p.here(), "this is where the arm should have ended")

            p.bump()
        end if

        p.skip_newlines()
    end loop

    p.expect(Dedent, "the end of the arms")

    if arms.is_empty() then p.fault(p.just_taken(), "a `match` needs at least one arm")

    arms
end parse_arms

private parse_arm(p: *Parser) -> Arm
    val pat = parse_pattern(p)

    // **A guard is read before the arrow and after the pattern**, so it can name what the pattern
    // just bound. That ordering is the whole reason a guard is worth having over an `if` in the
    // body: `n if n > 10` can refuse the arm and let a later one try, and an `if` inside the body
    // cannot.
    val guard = if p.accept(If) then Some(parse_expr_before_arrow(p)) else None

    p.expect(Arrow, "`->` and a result")

    // **An arm's one-line body is a STATEMENT**, the same rule a `then` follows, so `2 -> break x`
    // and `_ -> return 0` are arms rather than parse errors.
    val body = if p.at(Indent) then parse_block(p) else inline_stmt_body(p)

    Arm(pat, guard, body)
end parse_arm
