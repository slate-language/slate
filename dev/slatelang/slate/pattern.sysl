module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// Reading a pattern.
//
// A pattern is a tree of its own, parsed by ordinary recursive descent -- there is no precedence to
// speak of, `|` being the only thing that joins two of them.
//
// **A pattern is not an expression, and reading it with the expression parser would have been the
// tempting mistake.** They overlap almost entirely in surface -- `[a, b]`, `{ name: n }`, `1` -- and
// differ in what a *name* means: in an expression a name is read, and in a pattern it is written.
// Reading one as the other and converting afterwards would put the complaint about `[1 + 1]` in a
// function that no longer knows a pattern was wanted.

// -- the type parameters a definition is INSIDE ------------------------------------------------------

// **The parser is what knows a name is a type parameter, and `ScopedNames` is where it remembers.**
// A bare name in a type is a declared type or a mistake; one the enclosing `[...]` introduced is
// neither, and nothing downstream could tell the difference -- a name resolved later would find no
// type and complain about a name the reader deliberately wrote.
//
// **The stack itself is `sh.sysl.parsing`'s, because none of it is about types.** It answers "is
// this word one of the names the region I am inside introduced", which is a question a loop label, a
// `let ... in` binding and a macro parameter all ask; what is slate's is only which words go in it.
//
// **Module storage rather than a field on `Parser`**, one parse running at a time -- and a region
// per definition, so `outer[T]` holding `inner[U]` leaves `U` unspellable the moment `inner` ends.
private var active_params: ScopedNames = scoped_names()

// Not `private`: `define.sysl` opens one around a definition and `parse.sysl` around a declaration.
push_type_params(names: Buf[string])
    active_params.open_with(names)

pop_type_params()
    active_params.close()

// **Emptied before a parse rather than after one**, because a file that stopped on a syntax error
// may have left a definition unclosed -- and a leftover parameter name would make a bare `T` in the
// NEXT program a type that tests nothing.
//
// Not `private`: `parse_source` clears it with everything else it clears.
reset_type_params()
    active_params.clear()

private is_type_param(name: string) -> bool = active_params.has(name)

// `[A, B]` after a definition's or a declaration's name.
//
// **Bare names and nothing else.** There are no bounds, no variance and no defaults: slate refuses
// nothing on a type parameter -- nothing at run time could -- so a bound would be a promise the
// language cannot keep. What a parameter does is carry what a call was given through to the answer.
//
// Not `private`: read from `define.sysl` and `parse.sysl`.
type_parameters(p: *Parser) -> Buf[string]
    var names: Buf[string] = buf()

    p.expect(LBracket, "`[` and the type parameters")

    if !p.at(RBracket)
        loop
            val at = p.here()
            val name = parse_name(p, "a name for the type parameter")

            // **A type parameter that names one of slate's kinds would shadow it inside the whole
            // definition**, so `f[string](x: string)` would check nothing at all -- which is the
            // silent hole this repo refuses everywhere else.
            type_test_named(name) match
                Some(_) -> p.fault(at, s"`${name}` is one of slate's own types, so a type parameter of that name would make every `${name}` in this definition test nothing -- name it `T`")
                None -> ()

            names.push(name)

            if !p.accept(Comma) then break
            if p.at(RBracket) then break

    p.expect(RBracket, "`]` after the type parameters")

    names
end type_parameters

// One pattern, alternatives included.
//
// **`&` binds tighter than `|`**, so `A & B | C` is `(A & B) | C` -- the reading every language with
// both gives it, and the useful one: a union of shapes is far commoner than an intersection with a
// union in it, which wants its brackets anyway.
parse_pattern(p: *Parser) -> Pattern = parse_alternatives(p, false)

// One type expression.
//
// **A TYPE IS A PATTERN PLUS THE THREE THINGS A PATTERN CANNOT HAVE**: a function type, brackets that
// group, and type arguments. Everything else -- `{ a: T }`, `[T, U]`, `array of T`, a union, an
// intersection, a literal -- is read by the very functions a `match` arm is read by, so the two can
// never drift about the shape they share.
//
// **The fork exists because of one token.** `->` is the arm arrow, so an arm's `string -> "a"` would
// read as a function type from `string` to the literal type `"a"` and swallow the body. A type
// position has no such arrow of its own: an annotation ends at a `,`, a `)`, a `=` or the end of the
// line, and a result type ends at the `=` or the block that follows it. So the arrow is read here and
// refused there, rather than being disambiguated -- which it cannot be, both readings being legal.
//
// **The four type positions are the whole list**: a parameter's annotation, a result, the right of a
// `type` declaration, and a class's `is` promises. A binding, a `for` head, an `is` test and a
// `match` arm all read patterns.
parse_type(p: *Parser) -> Pattern = parse_alternatives(p, true)

private parse_alternatives(p: *Parser, types: bool) -> Pattern
    val joined = parse_union(p, types)

    // **The arrow is read after the union, which is what makes it the loosest thing in a type.**
    // `string | null -> integer` is a function taking either, which is the reading a parameter wants;
    // a union with a function in it says so with brackets, `(integer -> integer) | null`.
    //
    // **One bare parameter needs no brackets, mirroring the lambda it describes**: `n -> n + 1` has
    // the type `integer -> integer`. Two or more are a bracketed list, and so is none.
    if !types || !p.at(Arrow) then return joined

    p.bump()

    // **Right-associative**, so `A -> B -> C` is a function answering a function -- the reading every
    // language with a curried arrow gives it, and the only one that is any use: the other grouping
    // describes a function whose parameter is a function and would be written `(A -> B) -> C`.
    val result = parse_alternatives(p, true)

    var params: Buf[Pattern] = buf()

    params.push(joined)

    pattern(joined.span.to(result.span), FnPat(params, result))
end parse_alternatives

private parse_union(p: *Parser, types: bool) -> Pattern
    val first = parse_intersection(p, types)

    if !p.at(Pipe) then return first

    var alts: Buf[Pattern] = buf()

    alts.push(first)

    loop
        if !p.accept(Pipe) then break

        alts.push(parse_intersection(p, types))

    // **No alternative may bind.** `n | 0` would leave `n` bound down one path and not the other,
    // so every use of it below would be a name that may or may not exist -- and slate has no type
    // system to notice. Scala refuses the same thing for the same reason.
    //
    // **A BARE NAME IS LEFT ALONE HERE, because the parser cannot yet know whether it is one.** A
    // name standing in a pattern is a type where one was declared and a binding otherwise, and which
    // it is settled while compiling -- so `Point | null` would be refused as a binding by a check
    // that ran now. `resolve_pattern` makes the same complaint about whatever is still a binding
    // once the types are known, which is the first moment the question has an answer.
    for i in 0..<alts.len()
        val alt = alts.at(i)

        if !still_might_be_types(alt) && binds(alt)
            p.fault(alt.span, "an alternative of a pattern may not bind a name")

    pattern(first.span.to(alts.at(alts.len() - 1).span), OrPat(alts))
end parse_union

// Whether this alternative is made only of bare names, which the parser cannot yet judge.
//
// **`A & B | C` sent the first draft of this straight into the refusal above.** An intersection of
// two bare names binds two names as far as `binds` can see, and whether either is a type is settled
// by `resolve_pattern` and not here -- so the deferral a lone bare name already got has to reach
// through an intersection as well. Nothing is lost by deferring: `resolve_pattern`'s own `OrPat` arm
// asks `binds` again once the types are known, and complains there about whatever is still a
// binding.
private still_might_be_types(pat: Pattern) -> bool
    *pat.kind match
        Bind(_) -> true
        AndPat(parts) ->
            for i in 0..<parts.len()
                if !still_might_be_types(parts.at(i)) then return false

            true
        _ -> false
end still_might_be_types

// `A & B` -- every part must match.
//
// **Nothing is refused here where an alternative refuses a binding**, because the reason does not
// carry over: an alternative binds down one path only, and every part of this one runs. What is
// refused is left to the passes that can see more -- `resolve_pattern` still complains about a bare
// name that named no type, exactly as it does inside a union.
private parse_intersection(p: *Parser, types: bool) -> Pattern
    val first = parse_primary_pattern(p, types)

    if !p.at(Amp) then return first

    var parts: Buf[Pattern] = buf()

    parts.push(first)

    loop
        if !p.accept(Amp) then break

        parts.push(parse_primary_pattern(p, types))

    pattern(first.span.to(parts.at(parts.len() - 1).span), AndPat(parts))
end parse_intersection

// Whether a pattern binds anything, used to refuse a binding inside alternatives.
// The first name a pattern binds, if it binds one.
//
// Not `private`: `compile.sysl` refuses a declared type that binds, and a message naming which name
// is the difference between a reader fixing it and a reader guessing.
first_binding(pat: Pattern) -> Option[string]
    *pat.kind match
        Bind(name) -> Some(name)
        At(name, _) -> Some(name)
        ArrayPat(items, _, rest, _) ->
            rest match
                Some(name) -> return Some(name)
                None -> ()

            for i in 0..<items.len()
                first_binding(items.at(i)) match
                    Some(n) -> return Some(n)
                    None -> ()

            None
        ObjectPat(_, values, _, _) ->
            for i in 0..<values.len()
                first_binding(values.at(i)) match
                    Some(n) -> return Some(n)
                    None -> ()

            None

        // **An element pattern runs once per element, so a name in one is bound to whichever element
        // ran last** -- a value nobody asked for. `resolve_pattern` is where that is refused, and
        // this is the question it asks.
        EveryPat(_, element) -> first_binding(element)

        // **A name written in a function type is a binding like any other and is refused like one.**
        // `(n) -> integer` reads as a function taking whatever `n` names, and where nothing names it
        // the reader wrote a parameter's name in a place that has none.
        FnPat(params, result) ->
            for i in 0..<params.len()
                first_binding(params.at(i)) match
                    Some(n) -> return Some(n)
                    None -> ()

            first_binding(result)

        // **A type given to a generic type is an ordinary type and is asked the ordinary question**,
        // so `Pair[n, string]` is refused for naming a binding exactly as `{ x: n }` is.
        AppliedPat(_, args) ->
            for i in 0..<args.len()
                first_binding(args.at(i)) match
                    Some(n) -> return Some(n)
                    None -> ()

            None
        OrPat(alts) ->
            for i in 0..<alts.len()
                first_binding(alts.at(i)) match
                    Some(n) -> return Some(n)
                    None -> ()

            None
        AndPat(parts) ->
            for i in 0..<parts.len()
                first_binding(parts.at(i)) match
                    Some(n) -> return Some(n)
                    None -> ()

            None
        VariantPat(_, items, _, _) ->
            for i in 0..<items.len()
                first_binding(items.at(i)) match
                    Some(n) -> return Some(n)
                    None -> ()

            None
        MadeFrom(_, inner) -> first_binding(inner)
        _ -> None
end first_binding

// Whether a pattern binds anything.
//
// Not `private`: `private` in sysl is private to the *file*, and `compile.sysl` asks the same question
// of an alternative once a name that turned out to be a type has been resolved away.
binds(pat: Pattern) -> bool
    *pat.kind match
        Bind(_) -> true
        At(_, _) -> true
        ArrayPat(items, _, rest, _) ->
            if rest.is_some() then return true

            for i in 0..<items.len()
                if binds(items.at(i)) then return true

            false
        ObjectPat(_, values, _, _) ->
            for i in 0..<values.len()
                if binds(values.at(i)) then return true

            false
        OrPat(alts) ->
            for i in 0..<alts.len()
                if binds(alts.at(i)) then return true

            false
        AndPat(parts) ->
            for i in 0..<parts.len()
                if binds(parts.at(i)) then return true

            false
        VariantPat(_, items, _, _) ->
            for i in 0..<items.len()
                if binds(items.at(i)) then return true

            false
        MadeFrom(_, inner) -> binds(inner)
        EveryPat(_, element) -> binds(element)
        FnPat(params, result) ->
            for i in 0..<params.len()
                if binds(params.at(i)) then return true

            binds(result)
        AppliedPat(_, args) ->
            for i in 0..<args.len()
                if binds(args.at(i)) then return true

            false
        _ -> false
end binds

// What a bare identifier in pattern position means.
//
// **Three answers, and the order between them is the rule.** `_` is the wildcard; a name that is one
// of slate's kinds is a test for that kind; anything else binds. That is sysl's bare-name rule with
// `Value`'s variants standing in for the scrutinee's enum's, and it is why a type test needs no
// syntax of its own.
//
// `n @ pat` follows the name where one is given, which is the spelling sysl uses for the same thing
// and is how a program tests and binds at once.
private bare_name_pattern(p: *Parser, at: Span, types: bool) -> Pattern
    p.bump()

    val name = p.text(at)

    // `_` is an ordinary identifier to the lexer -- `is_ident_start` takes it -- so the wildcard is
    // decided here, by the text. That keeps `_` usable as a name everywhere else, the same bargain
    // `end` gets.
    if name == "_" then return pattern(at, Wild)

    // **`any` is a type and matches everything, which is what makes it useful as an annotation.** It
    // is the same test `_` makes; what differs is that a reader writing `any` is saying something
    // about the value rather than declining to name it, and `show_type` says it back to them.
    if name == "any" then return pattern(at, Wild)

    if p.accept(At)
        val inner = parse_primary_pattern(p, types)

        return pattern(at.to(inner.span), At(name, inner))
    end if

    // **`Circle(r)` takes a data variant apart by POSITION**, and a `(` after a name in pattern
    // position begins nothing else -- a pattern makes no calls, so there is nothing for this to be
    // mistaken for. The field names are not known here and are filled in by `resolve_pattern`, which
    // is where a name that turns out not to be a variant is complained about and where an arity that
    // does not match the declaration is caught.
    if p.at(LParen)
        p.bump()

        var items: Buf[Pattern] = buf()

        // **`Circle()` is refused rather than read as the bare test.** An empty list is the shape a
        // declaration registers and the shape a bare name resolves to, so admitting a written one
        // would make "took nothing apart" and "named no fields" the same pattern -- and the arity
        // check could then never fire on a variant that carries fields.
        if p.at(RParen)
            p.fault(at.to(p.here()), s"`${name}()` takes no fields apart, so write `${name}` -- which tests the variant and binds nothing")

        if !p.at(RParen)
            loop
                items.push(parse_alternatives(p, types))

                if !p.accept(Comma) then break

        p.expect(RParen, "a `)` after the fields taken apart")

        return pattern(at.to(p.just_taken()), VariantPat(name, items, buf(), false))
    end if

    // **`Point { x: a, y }` tests and takes apart BY NAME**, and a `{` after a name in pattern
    // position is as unambiguous as the `(` above: a pattern builds no objects, so there is nothing
    // else this could begin. Which fields a declaration actually has is not known here either --
    // `resolve_pattern` checks the names against it, for the same reason it checks the arity.
    if p.at(LBrace)
        val inner = object_pattern(p, p.here(), types)

        return pattern(at.to(p.just_taken()), MadeFrom(name, inner))
    end if

    // **A type parameter is decided before anything else a name could be**, which is what makes it a
    // parameter: inside `f[T]`, `T` is that parameter and not a type the file happens to declare.
    if is_type_param(name)
        if types then return pattern(at, TypeVarPat(name))

        // **`x is T` CANNOT BE ASKED, and saying so is much better than answering it.** A type
        // parameter is erased -- there is nothing at run time that knows what a call solved it to --
        // so this would be a bare name binding `x`'s value and matching everything, which is a test
        // the reader believes and does not get.
        p.fault(at, s"`${name}` is a type parameter, and a type parameter is not there at run time -- so nothing can be tested against it. Test the type you expect, or take a `${name}` and let the caller's type say what it was")

        return pattern(at, Wild)
    end if

    // `Pair[string, integer]` -- a generic type, given what it is generic over. **A `[` after a name
    // begins nothing else, in a type or in a pattern**: an array pattern is `[a, b]` and an array
    // type is `[T, U]` or `array of T`, and neither can follow a name, there being no juxtaposition
    // in the grammar and no indexing in a pattern.
    if p.at(LBracket)
        p.bump()

        var args: Buf[Pattern] = buf()

        if !p.at(RBracket)
            loop
                args.push(parse_type(p))

                if !p.accept(Comma) then break
                if p.at(RBracket) then break

        p.expect(RBracket, "`]` after the types a generic type is given")

        return pattern(at.to(p.just_taken()), AppliedPat(name, args))
    end if

    type_test_named(name) match
        Some(test) ->
            // **`array of string` and `object of integer`, and `of` is read HERE and nowhere else.**
            // It is soft in the strongest sense: only a type word can precede it in pattern
            // position, and juxtaposing two patterns is a syntax error anyway -- so a program may
            // still call a variable `of` everywhere, and does not even have to avoid it here.
            if (test == IsArray || test == IsObject) && p.at(Ident) && p.text(p.here()) == "of"
                p.bump()

                val element = parse_primary_pattern(p, types)

                pattern(at.to(element.span), EveryPat(test, element))
            else
                pattern(at, TypePat(test))
        None -> pattern(at, Bind(name))
end bare_name_pattern

private parse_primary_pattern(p: *Parser, types: bool) -> Pattern
    val at = p.here()

    // **A `(` in a type begins two things and the token after the `)` says which**, which is one
    // token of lookahead and no ambiguity: an arrow makes the brackets a parameter list, and anything
    // else makes them grouping. Nothing needs deciding on the way in, so the list is read once either
    // way. A pattern has no brackets at all -- a `match` arm groups with nothing, `|` and `&` being
    // the only things that join two patterns and the tighter of them binding first.
    if types && p.at(LParen) then return paren_type(p, at)

    p.peek() match
        Ident -> bare_name_pattern(p, at, types)
        IntLit ->
            p.bump()
            pattern(at, IntPat(read_int_at(p, at)))
        RealLit ->
            p.bump()
            pattern(at, RealPat(read_real_at(p, at)))
        StrLit ->
            p.bump()
            pattern(at, StrPat(read_str_at(p, at)))
        True ->
            p.bump()
            pattern(at, BoolPat(true))
        False ->
            p.bump()
            pattern(at, BoolPat(false))
        Null ->
            p.bump()
            pattern(at, NullPat)
        Minus -> negative_number_pattern(p, at)
        LBracket -> array_pattern(p, at, types)
        LBrace -> object_pattern(p, at, types)
        _ ->
            p.report.add(expected(at, "a pattern", p.found(at)))
            p.bump()
            pattern(at, Wild)
end parse_primary_pattern

// `(A, B) -> C` and `() -> C` -- a function type's parameter list -- and `(A | B)`, one type grouped.
//
// **The list is read before anything is decided, so neither reading is speculative.** What follows
// the `)` chooses: an arrow makes those types the parameters, and no arrow makes a single one of them
// the type in brackets. Several with no arrow is neither, and says so.
private paren_type(p: *Parser, at: Span) -> Pattern
    p.bump()

    var items: Buf[Pattern] = buf()

    if !p.at(RParen)
        loop
            val item = parse_type(p)

            // **A reader coming from TypeScript writes `(n: integer) -> integer`, and the parameter's
            // name has nowhere to go here.** Left alone, the complaint is about the `)` that never
            // arrived, which sends them to count brackets rather than to delete a word.
            if p.at(Colon)
                p.fault(item.span, "a function type says what its parameters ARE rather than what they are called -- write `(integer) -> string`")
                p.bump()
                items.push(parse_type(p))
            else
                items.push(item)

            if !p.accept(Comma) then break
            if p.at(RParen) then break

    p.expect(RParen, "`)`")

    val closed = at.to(p.just_taken())

    if p.accept(Arrow)
        val result = parse_type(p)

        return pattern(closed.to(result.span), FnPat(items, result))

    if items.len() == 1 then return items.at(0)

    if items.is_empty()
        p.fault(closed, "`()` is the parameter list of a function that takes nothing, so it needs `->` and what that function answers -- write `() -> string`")
    else
        p.fault(closed, "several types in brackets are a function type's parameter list, so they need `->` and what that function answers -- brackets around one type group it")

    pattern(closed, Wild)
end paren_type

// `-1` and `-1.5`.
//
// A pattern has no arithmetic, so the minus is part of the literal rather than an operator -- which
// is why it is read here and not by anything general.
private negative_number_pattern(p: *Parser, at: Span) -> Pattern
    p.bump()

    val here = p.here()

    p.peek() match
        IntLit ->
            p.bump()
            pattern(at.to(here), IntPat(-read_int_at(p, here)))
        RealLit ->
            p.bump()
            pattern(at.to(here), RealPat(-read_real_at(p, here)))
        _ ->
            p.report.add(expected(here, "a number after `-` in a pattern", p.found(here)))
            pattern(at, Wild)
end negative_number_pattern

// `[a, b]`, `[]`, and `[first, ...rest]`.
private array_pattern(p: *Parser, at: Span, types: bool) -> Pattern
    p.bump()

    var items: Buf[Pattern] = buf()
    var defaults: Buf[Option[Expr]] = buf()
    var open = false
    var rest: Option[string] = None

    if !p.at(RBracket)
        loop
            if p.accept(Spread)
                open = true

                // **A name after `...` is optional**, and its absence is what `[a, ...]` means: at
                // least one element, and the others are none of this arm's business.
                if p.at(Ident) then rest = Some(parse_name(p, "a name for the rest of the array"))

                // Nothing may follow it, because what is left over has no end to be counted from.
                // A pattern like `[...init, last]` is a different feature and slate does not have it.
                if !p.at(RBracket)
                    p.fault(p.here(), "`...` gathers the rest of the array, so nothing may follow it")

                break
            end if

            val item = parse_alternatives(p, types)

            items.push(item)
            defaults.push(parse_default(p, item))

            if !p.accept(Comma) then break
            if p.at(RBracket) then break

    p.expect(RBracket, "`]`")

    // **A default must be at the END of an array pattern, which is the rule a parameter list already
    // has.** `[a = 1, b]` has no answer for a one-element array: whichever way it were read, one of
    // the two names would be the one the element went to and the other would be a guess.
    var seen = false

    for i in 0..<defaults.len()
        if defaults.at(i).is_some()
            seen = true
        elif seen
            p.fault(items.at(i).span, "an element with no default may not come after one that has a default -- the array would have no answer for which of them a missing element belonged to")

    pattern(at.to(p.just_taken()), ArrayPat(items, open, rest, defaults))
end array_pattern

// `{ name: n }`, and `{ name }` as shorthand for `{ name: name }`.
private object_pattern(p: *Parser, at: Span, types: bool) -> Pattern
    p.bump()

    var keys: Buf[string] = buf()
    var values: Buf[Pattern] = buf()
    var defaults: Buf[Option[Expr]] = buf()
    var optional: Buf[bool] = buf()

    if !p.at(RBrace)
        loop
            val key_at = p.here()
            val quoted = p.at(StrLit)
            val key = parse_key(p, "a field name")

            keys.push(key)

            // **The `?` goes on the KEY, before the colon**, which is where TypeScript, Swift and
            // every other language with the mark put it -- and it is a fact about the field rather
            // than about the pattern its value is checked against, so it belongs on that side.
            optional.push(p.accept(Question))

            // **`{ name }` binds `name`**, which is the shorthand every language with object
            // patterns grows, and is worth having because the long form repeats the word.
            //
            // **A quoted key has no shorthand, because there is no name in it to bind.** `{ "a.b" }`
            // would have to invent one, so it is refused here rather than at the point where the
            // invented name turned out not to exist.
            if p.accept(Colon)
                values.push(parse_alternatives(p, types))
            elif quoted
                p.fault(key_at, s"`${key}` is not a name, so this has to say what to bind it to -- write `\"${key}\": some_name`")
                values.push(pattern(key_at, Bind("")))
            else
                values.push(pattern(key_at, Bind(key)))

            defaults.push(parse_default(p, values.at(values.len() - 1)))

            // **A field may say `?` or `=` and not both**, the two answering the same question
            // differently: one says nothing is bound when the field is absent and the other says
            // what is. Written together there is no reading that uses both.
            if optional.at(optional.len() - 1) && defaults.at(defaults.len() - 1).is_some()
                p.fault(key_at, s"`${key}` says both `?` and a default -- `?` is for a pattern that tests, where an absent field binds nothing, and a default is for one that binds. Write whichever this is")

            if !p.accept(Comma) then break
            if p.at(RBrace) then break

    p.expect(RBrace, "`}`")

    pattern(at.to(p.just_taken()), ObjectPat(keys, values, defaults, optional))
end object_pattern

// `= expr` after a binding inside a pattern, which is what makes that part of the pattern optional.
//
// **A default may only be written on a BARE BINDING**, because what a default does is bind a name the
// subject did not supply -- and a pattern that is not a binding has no name to give it to. The check
// is here rather than at the point the value goes missing, where there would be nothing to name.
//
// **A default is an EXPRESSION and is worked out where the binding is, not where the pattern was
// written.** That is the rule a parameter's default already has, and it is the reason `{ xs = [] }`
// gives each binding an array of its own.
private parse_default(p: *Parser, target: Pattern) -> Option[Expr]
    if !p.accept(Assign) then return None

    val value = parse_expr(p)

    val bare = *target.kind match
        Bind(_) -> true
        _ -> false

    if !bare
        p.fault(target.span, "a default belongs to a name -- write it after the name a missing value should be bound to")

        return None

    Some(value)
end parse_default

// The arms of a `match`, which are an indented block of `pattern -> body` lines.
parse_arms(p: *Parser) -> Buf[Arm]
    var arms: Buf[Arm] = buf()

    if !p.expect(Indent, "an indented list of `pattern -> result` arms") then return arms

    p.skip_newlines()

    loop
        if p.at(Dedent) || p.at(Eof) then break

        arms.push(parse_arm(p))

        if !p.end_of_statement()
            // **A `match` written as an argument must be the last one, and this is where that shows
            // up.** The block its arms live in is closed by the bracket, so anything between the
            // last arm and the `)` is inside the block -- a `,` there reads as a stray token in an
            // arm, and the generic complaint about it says nothing a person could act on.
            if p.at(Comma)
                p.fault(p.here(), "a `match` written as an argument has to be the last argument")
            else
                p.fault(p.here(), "this is where the arm should have ended")

            p.bump()
        end if

        p.skip_newlines()
    end loop

    p.expect(Dedent, "the end of the arms")

    if arms.is_empty() then p.fault(p.just_taken(), "a `match` needs at least one arm")

    arms
end parse_arms

private parse_arm(p: *Parser) -> Arm
    val pat = parse_pattern(p)

    // **A guard is read before the arrow and after the pattern**, so it can name what the pattern
    // just bound. That ordering is the whole reason a guard is worth having over an `if` in the
    // body: `n if n > 10` can refuse the arm and let a later one try, and an `if` inside the body
    // cannot.
    val guard = if p.accept(If) then Some(parse_expr_before_arrow(p)) else None

    p.expect(Arrow, "`->` and a result")

    // **An arm's one-line body is a STATEMENT**, the same rule a `then` follows, so `2 -> break x`
    // and `_ -> return 0` are arms rather than parse errors.
    val body = if p.at(Indent) then parse_block(p) else inline_stmt_body(p)

    Arm(pat, guard, body)
end parse_arm
