module dev.slatelang.slate
@tests

// How often the HTTP server asks a socket who is at the other end, read off `peer_lookups()`.
//
// **A connection's peer never changes, so a connection is asked ONCE**, however many requests it
// carries: the speaker reads it when it takes the connection over and hands every request the same
// answer. A benchmark can say a server got faster and cannot say a request stopped making the
// `getpeername` call; this can.
//
// **The counter is the interpreter's.** `Vm.peer_lookups` is charged in `remote_address`, the native
// behind `remoteAddress`, which the JavaScript back end does not run: node gives it the address on
// the socket it already holds. So the counts below are interpreter-only, and
// `tests/js/p61.sl` is what says both back ends hand a handler the same address on a kept connection.
//
// **Every program asserts what it printed**, and what it printed includes how many answers carried
// `127.0.0.1` -- the `::ffff:` form a dual-stack listener reports taken off -- so a count of nothing
// cannot look like a count of one, and a cached value that was wrong would be read as wrong.

// How many lookups `program` charged, its output asserted to be `said`.
private lookups_of(program: string, said: string) -> usize
    val before = peer_lookups()
    val printed = wire_out(program)

    assert_eq(printed, said)
    peer_lookups() - before

// `conns` clients, each a keep-alive connection that asks `wanted` times, a request sent once the
// answer to the one before has arrived. The handler answers its caller's address between angle
// brackets, and each client counts the answers that carry the right one. `ending` is the statement
// that stops the server, and `setup` makes it and names the port.
private asked_of(setup: string, ending: string, conns: int, wanted: int) -> string =
    setup +
    s"val conns = ${conns}\n" +
    s"val wanted = ${wanted}\n" +
    "val ask = \"GET /plain HTTP/1.1\\r\\nHost: h\\r\\n\\r\\n\"\n" +
    "var total = 0\n" +
    "var right = 0\n" +
    "async client()\n" +
    "    val c = (await connect(\"127.0.0.1\", port)).value\n" +
    "    var got = \"\"\n" +
    "    var answered = 0\n" +
    "    heard(chunk)\n" +
    "        got = got + chunk\n" +
    "        val now = split(got, \">\").length - 1\n" +
    "        if now > answered\n" +
    "            total = total + now - answered\n" +
    "            answered = now\n" +
    "            if answered < wanted\n" +
    "                send(c, ask)\n" +
    "            else\n" +
    "                right = right + split(got, \"<127.0.0.1>\").length - 1\n" +
    "                shutSocket(c)\n" +
    "                if total == conns * wanted\n" +
    "                    print(string(total) + \" answered, \" + string(right) + \" right\")\n" +
    "                    " + ending + "\n" +
    "                    done()\n" +
    "    onData(c, heard)\n" +
    "    await send(c, ask)\n" +
    "for i in 0..<conns\n" +
    "    client()\n"

private const Served: string =
    "val server = serve(0, req -> { status: 200, body: \"<\" + req.address + \">\" })\n" +
    "val port = localPort(server)\n"

private const Adopted: string =
    "import { adopt } from slate:http\n" +
    "import { listen } from slate:net\n" +
    "val app = adopt(req -> { status: 200, body: \"<\" + req.address + \">\" })\n" +
    "val outer = listen(0, conn -> app.handle(conn))\n" +
    "val port = localPort(outer)\n"

@test
FIVE_REQUESTS_ON_ONE_KEPT_CONNECTION_ASK_FOR_THE_PEER_ONCE_ON_THE_INTERPRETER()
    // Five requests, each answered with the right address, and one `getpeername` for all of them.
    // Asked per request this read five.
    assert_eq(lookups_of(asked_of(Served, "close(server)", 1, 5), "5 answered, 5 right"), 1)

@test
TWO_CONNECTIONS_ASK_FOR_THE_PEER_TWICE_ON_THE_INTERPRETER()
    // The control, and the lower bound: a peer is asked for per CONNECTION, so a second connection
    // is a second lookup, and the count is not simply stuck at one.
    assert_eq(lookups_of(asked_of(Served, "close(server)", 2, 3), "6 answered, 6 right"), 2)

@test
AN_ADOPTED_CONNECTION_IS_ASKED_FOR_ITS_PEER_ONCE_AND_ANSWERS_RIGHT_ON_THE_INTERPRETER()
    // A cluster worker is handed a socket that `listen` accepted, so the speaker that takes it over
    // is the one a served connection gets, and the address is the right one on both requests.
    assert_eq(lookups_of(asked_of(Adopted, "shutSocket(outer)", 1, 2), "2 answered, 2 right"), 1)
