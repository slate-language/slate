module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.slices.sort_by
import sysl.text.{str_builder, StrBuilder, from_utf8_unchecked}

// What running a program needs that is not the machine itself: equality, arithmetic, indexing,
// pattern matching, and calling.
//
// **This was `eval.sysl`, and it is what survived the tree-walker.** Every one of these was shared by
// the walker and the machine while both existed, which is why the port could not change them by
// accident -- a rewrite that reimplements settled semantics is a rewrite that changes them.
//
// **A fault still travels in the error channel.** The machine compiles `break`, `continue` and a
// block's value into jumps, so `Brk` and `Cont` no longer travel anywhere -- but `Ret` still leaves a
// native that called back into slate, and a fault still has to come out of a hook from inside a table
// lookup. `Result[Value, Signal]` is what carries both, and `?` is still what propagates them.

// Why a walk stopped early.
//
// The names avoid `Break`, `Continue` and `Return`, which `StmtKind` and `Tok` already have. Two
// enums may share a variant name and the expected type picks between them, but a reader should not
// have to work out which `Break` is meant.
enum Signal
    // A `return` on its way out of a call.
    Ret(v: Value)

    Brk
    Cont

    // Something the program did that it may not.
    //
    // **`src` is which file the span is an offset into**, and it travels with the fault rather than
    // being looked up when the fault is reported. A `Signal` outlives the statement that raised it —
    // an unhandled rejection is reported after the loop has drained, by which time the machine is
    // somewhere else entirely — so the file has to be captured where the span was.
    Fail(at: Span, src: usize, message: string)

    // An `await` set the running machine aside.
    //
    // **It travels in the error channel because that is the only channel that unwinds.** Suspending
    // means leaving `execute` without a value, and every `?` on the way out already knows how to pass
    // an `Err` along -- so a new outcome type would have rewritten forty call sites to say what one
    // variant says here. Nothing but the scheduler ever matches on it, and it never reaches a
    // program: the machine it belongs to is in `parked` by the time it is raised.
    Wait
end Signal

// What every step of the walk answers with.
type Step = Result[Value, Signal]

// A fault at a place, as the error channel wants it.
//
// Not `private`: `private` in sysl is private to the *file*, and `builtin.sysl` complains too.
// Which file the machine is currently running code from, as an index into the unit's sources.
//
// **Module storage, set by the machine as it enters and leaves a chunk**, because the alternative is
// threading a file through every one of the 116 places that can raise a fault. A chunk knows which
// file it was compiled from; the machine knows which chunk it is in; so this is the two facts joined
// at the one moment anybody needs them.
var current_source: usize = 0

// A fault as a bare `Signal`, for the callers whose error channel is not a `Step`.
//
// **This is the ONE place a `Fail` is built**, which is what lets it learn the current file without
// 116 call sites saying so. `Fail` is otherwise only ever matched on.
failure(at: Span, message: string) -> Signal = Fail(at, current_source, message)

fault(at: Span, message: string) -> Step = Err(failure(at, message))

// -- what a call that was EXPECTED to fail answers with ------------------------------------------

// **A failure a caller is meant to deal with is a value, not an unwind.** A file that is not there
// is not a defect in the program asking for it; a name that is not defined is. So the two get two
// channels: this one, which the caller has to look at, and `catch`, which is there for the ones
// nothing could have anticipated. That is Rust's division and Swift's, and it is the reason building
// both was not a compromise -- unwinding cost the machine a handler stack, and this cost nothing at
// all, because slate objects already do everything a result needs doing.
//
// **An ordinary object, so `match` already takes it apart**: `r match { ok: true, value: v } -> ...`
// needs no syntax slate does not have.

// A call that worked, and what it answered.
ok_value(v: Value) -> Value
    val mark = root_mark()
    val o = new_object()

    hold(Object(o))
    hold(v)
    obj_put_name(o, "ok", Bool(true))
    obj_put_name(o, "value", v)
    release(mark)
    Object(o)
end ok_value

// A call that did not, and the sentence saying why.
//
// **Only the field that applies is there**, rather than both with one of them null. Reading `r.value`
// off a failure is then `undefined`, which slate already refuses to bind with a message naming the
// field -- so the mistake is caught where it is made instead of travelling as a null.
err_value(message: string) -> Value
    val mark = root_mark()
    val o = new_object()

    hold(Object(o))
    obj_put_name(o, "ok", Bool(false))
    obj_put_name(o, "error", str_value(message))
    release(mark)
    Object(o)
end err_value

// One end of a range, which has to be a whole number.
//
// Not `private`: the machine builds a range and `builtin.sysl` reports on one.
range_end(v: Value, at: Span, which: string) -> Result[long, Signal]
    v match
        Int(n) -> Ok(n)
        other -> Err(failure(at, s"${which} of a range is a whole number, and this is ${other.type_name()}"))

// Whether a value is the absent one.
is_absent(v: Value) -> bool = v match
    Undefined -> true
    _ -> false

// Whether `??` should reach for its default.
//
// **Both, which is JavaScript's rule and is the right one in practice.** In theory a `null` a program
// chose should survive a default, and slate can still say so -- `has` asks whether a field is there
// and `== undefined` asks whether a read found one. But the overwhelmingly common need is "if this is
// missing or empty, use that", and an operator that handled only half of it would be reached for and
// found wanting. The distinction stays where it earns its keep and is not made to earn it here.
//
// C#, Kotlin and Swift all fire on their single absent value; JavaScript fires on both because it has
// two. slate has two, so it fires on both.
is_nullish(v: Value) -> bool = v match
    Null -> true
    Undefined -> true
    _ -> false

// Refuse to keep absence.
//
// **This is the whole of what makes `undefined` second class**, and it is checked at every point a
// value is kept or handed on rather than at the point it is made: bound to a name, written to one,
// put in an array or an object, used as a key, or passed to a function.
//
// The alternative -- letting it flow like any other value -- is JavaScript's, and the reason it hurts
// is not that `undefined` exists but that it *travels*. It is stored, passed through three layers,
// and observed a long way from the lookup that made it, by which time nothing knows what was
// missing. Refusing it here means the program has to say what absence means where it arose, which is
// the one place it still knows.
keepable(v: Value, at: Span, what: string) -> Result[unit, Signal]
    if is_absent(v)
        return Err(failure(at, s"this field is not there, and `undefined` cannot be ${what} -- give it a value with `??`, or ask `has` first"))

    Ok(())
end keepable

// -- entry point --------------------------------------------------------------------------------

// Where a diagnostic is, for putting a report in reading order across several files.
//
// **The file comes first and the index is the last resort**, which is `sh.sysl.parsing`'s own
// `Placed` with one field in front of it: sorting on the triple makes every key distinct, so an
// unstable sort still leaves two complaints about one place in the order they were made.
private struct Placed
    src: usize
    start: usize
    index: usize

// What running a program answers with.
struct Ran
    value: Value
    report: Report

    // Which file each diagnostic is about, in step with the report's own items.
    //
    // **A parallel list rather than a field on the `Diagnostic`.** `Diagnostic` belongs to
    // `sh.sysl.parsing`, which the sysl compiler, `json` and `ogol` all share, so a field there would
    // be paid for by every construction in the organisation for one consumer's benefit -- and the
    // same argument that keeps the file out of `Span` keeps it out of here. What makes the parallel
    // list safe is that a report is append-only and `Report.render` sorts a table of positions rather
    // than the report, so the items stay in the order they were added.
    srcs: Buf[usize]

    // Every file the program was made of, indexed by what `srcs` holds.
    sources: Buf[Source]

    // The lines the program printed, in order.
    output: &Buf[string]

    ok(self) -> bool = !self.report.has_errors()

    // Every complaint rendered against the file it is actually about.
    //
    // **`Report.render` cannot do this and must not be asked to**: it takes one `Source` and renders
    // everything against it, which quotes the wrong line as soon as a program is more than one file.
    // Rendering per item is what `Report.at` exists for.
    //
    // Sorted by file and then by position, so the complaints about one file arrive together and in
    // reading order, with the files in the order they were read -- the entry first.
    render(self) -> string
        var order: Buf[Placed] = buf()

        for i in 0..<self.report.len()
            order.push(Placed(self.srcs.at(i), self.report.at(i).span.start, i))

        val xs = order.view()

        sort_by(xs, (p, q) -> p.src < q.src
            || (p.src == q.src && p.start < q.start)
            || (p.src == q.src && p.start == q.start && p.index < q.index))

        // The same handful `sh.sysl.parsing` prints, and for its reason: a grammar that resumes
        // after a mistake reports the same one several ways, and the twentieth is never read.
        val shown = if xs.len > ReportLimit then ReportLimit else xs.len
        var b = str_builder()

        for i in 0..<shown
            if i > 0 then b.push("\n")

            val at = xs[i]

            b.push(self.report.at(at.index).render(self.sources.at(at.src)))

        if shown < xs.len then b.push(s"\nshowing the first ${shown} of ${xs.len}\n")

        b.finish()
    end render

    // Everything printed, joined by newlines -- which is what a test compares against.
    printed(self) -> string
        var out = str_builder()

        for i in 0..<self.output.len()
            if i > 0 then out.push_char('\n')

            out.push(self.output.at(i))

        out.finish()
    end printed
end Ran

// How many complaints are printed before the rest are counted.
private const ReportLimit: usize = 5

// Where to point at a signal that escaped to the top.
signal_span(s: Signal) -> Span = s match
    Fail(at, _, _) -> at
    _ -> point(0)

// Which file a signal that escaped to the top is about.
//
// **Zero for the ones that carry no place**, which is the entry: a `break` outside a loop is a
// complaint about the program the user named, and there is nowhere better to point.
signal_source(s: Signal) -> usize = s match
    Fail(_, src, _) -> src
    _ -> 0

signal_message(s: Signal) -> string = s match
    Fail(_, _, m) -> m
    Ret(_) -> "`return` outside a function"
    Brk -> "`break` outside a loop"
    Cont -> "`continue` outside a loop"
    Wait -> "`await` suspended a call that had nowhere to come back to"

// Writing through `xs[i]` and `o[k]`.
store_at(container: Value, k: Value, v: Value, at: Span) -> Step
    container match
        Array(items) ->
            k match
                Int(i) ->
                    if i < 0 || usize(i) >= items.items.len()
                        return fault(at, s"the index ${i} is outside an array of ${items.items.len()}")

                    items.items.set(usize(i), v)
                    Ok(Null)
                other -> fault(at, s"an array is indexed by an integer, and this is ${other.type_name()}")
        Object(fields) ->
            k match
                _ -> obj_put(fields, k, v, at)
        other -> fault(at, s"${other.type_name()} cannot be indexed")
end store_at

// Not `private`: `private` in sysl is private to the *file*, and the machine in `vm.sysl` runs the
// same operators the walker ran.
unary(op: Tok, v: Value, at: Span) -> Step
    op match
        Minus ->
            v match
                Int(n) -> Ok(Int(-n))
                Real(n) -> Ok(Real(-n))
                other -> fault(at, s"`-` needs a number, and this is ${other.type_name()}")
        Bang -> Ok(Bool(!v.truthy()))
        Tilde ->
            v match
                Int(n) -> Ok(Int(~n))
                other -> fault(at, s"`~` needs a whole number, and this is ${other.type_name()}")
        _ -> fault(at, "this is not a prefix operator")
end unary

// The half of `binary` that works on operands already evaluated.
//
// **The machine reaches this and not `binary`**, because short-circuiting is a compile-time question
// there: `&&` becomes a jump that keeps the operand that decided, so by the time an operator runs
// both sides are values. Sharing the arithmetic rather than rewriting it is what stops the machine
// and the walker drifting apart while both exist.
on_values(op: Tok, a: Value, b: Value, at: Span) -> Step = op match
    EqEq -> Ok(Bool(same(a, b, at)?))
    BangEq -> Ok(Bool(!same(a, b, at)?))
    _ -> arith(op, a, b, at)

// -- arithmetic and comparison ------------------------------------------------------------------

// **A real and an integer meet as reals**, which is the promotion every language with both takes,
// and `+` on two strings joins them. Everything else is a fault naming both sides.
private arith(op: Tok, a: Value, b: Value, at: Span) -> Step
    if op == Plus
        a match
            Str(x) ->
                b match
                    Str(y) -> return Ok(str_value(x.s + y.s))
                    _ -> ()
            _ -> ()
    end if

    if is_number(a) && is_number(b)
        if is_int(a) && is_int(b) then return int_arith(op, as_int(a), as_int(b), at)

        return real_arith(op, as_real(a), as_real(b), at)
    end if

    // Ordering strings is worth having and is not arithmetic, so it is tested after the numbers.
    a match
        Str(x) ->
            b match
                Str(y) -> return compare_str(op, x.s, y.s, at)
                _ -> ()
        _ -> ()

    fault(at, s"`${op_text(op)}` does not apply to ${a.type_name()} and ${b.type_name()}")
end arith

private int_arith(op: Tok, x: long, y: long, at: Span) -> Step
    op match
        Plus -> Ok(Int(x + y))
        Minus -> Ok(Int(x - y))
        Star -> Ok(Int(x * y))
        Slash ->
            if y == 0 then fault(at, "this divides by zero") else Ok(Int(x / y))
        Percent ->
            if y == 0 then fault(at, "this takes a remainder by zero") else Ok(Int(x % y))
        Lt -> Ok(Bool(x < y))
        LtEq -> Ok(Bool(x <= y))
        Gt -> Ok(Bool(x > y))
        GtEq -> Ok(Bool(x >= y))

        // **The bitwise operators are integers only**, which needs no rule of its own: they are here
        // and nowhere else, so a real reaching one falls through to the sentence naming both sides.
        Amp -> Ok(Int(x & y))
        Pipe -> Ok(Int(x | y))
        Caret -> Ok(Int(x ^ y))
        Shl ->
            if y < 0 || y > 63 then fault(at, s"a shift is by 0 to 63 places, and this is by ${y}") else Ok(Int(x << y))
        Shr ->
            if y < 0 || y > 63 then fault(at, s"a shift is by 0 to 63 places, and this is by ${y}") else Ok(Int(x >> y))
        _ -> fault(at, "this is not an arithmetic operator")
end int_arith

private real_arith(op: Tok, x: real, y: real, at: Span) -> Step
    op match
        Plus -> Ok(Real(x + y))
        Minus -> Ok(Real(x - y))
        Star -> Ok(Real(x * y))
        Slash -> Ok(Real(x / y))
        Percent -> fault(at, "a remainder is taken of integers")
        Lt -> Ok(Bool(x < y))
        LtEq -> Ok(Bool(x <= y))
        Gt -> Ok(Bool(x > y))
        GtEq -> Ok(Bool(x >= y))

        // **The bitwise operators reach here only with a real in hand**, and saying they are not
        // arithmetic would be a true sentence about the wrong thing: the operator is fine and the
        // operand is not.
        Amp -> not_whole(op, at)
        Pipe -> not_whole(op, at)
        Caret -> not_whole(op, at)
        Shl -> not_whole(op, at)
        Shr -> not_whole(op, at)
        _ -> fault(at, "this is not an arithmetic operator")
end real_arith

private not_whole(op: Tok, at: Span) -> Step =
    fault(at, s"`${op_text(op)}` works on whole numbers, and a real is not one")

private compare_str(op: Tok, x: string, y: string, at: Span) -> Step
    op match
        Lt -> Ok(Bool(x < y))
        LtEq -> Ok(Bool(x <= y))
        Gt -> Ok(Bool(x > y))
        GtEq -> Ok(Bool(x >= y))
        _ -> fault(at, s"`${op_text(op)}` does not apply to two strings")
end compare_str

private is_number(v: Value) -> bool = v match
    Int(_) -> true
    Real(_) -> true
    _ -> false

private is_int(v: Value) -> bool = v match
    Int(_) -> true
    _ -> false

private as_int(v: Value) -> long = v match
    Int(n) -> n
    _ -> 0

private as_real(v: Value) -> real = v match
    Int(n) -> real(n)
    Real(n) -> n
    _ -> 0.0

// Two containers whose comparison is already underway, one frame or more above.
struct SeenPair
    a: *u8
    b: *u8

// Whether this exact pairing is already being compared further up the walk.
private in_progress(seen: *Buf[SeenPair], a: *u8, b: *u8) -> bool
    for i in 0..<seen.len()
        val p = seen.at(i)

        if p.a == a && p.b == b then return true

    false
end in_progress

// Whether a value equals a literal written in a pattern.
//
// **A pattern does not consult an object's `equals`, and that is deliberate.** A literal pattern is a
// shape test: `5 -> ...` asks whether the subject *is* five, not whether something has been persuaded
// to say it is. Keeping hooks out of it also keeps `match_pattern` infallible, so an arm cannot fault
// halfway through binding.
private same_literal(v: Value, lit: Value) -> bool = v match
    Null -> lit match
        Null -> true
        _ -> false
    Bool(x) -> lit match
        Bool(y) -> x == y
        _ -> false
    Int(x) -> lit match
        Int(y) -> x == y
        Real(y) -> real(x) == y
        _ -> false
    Real(x) -> lit match
        Int(y) -> x == real(y)
        Real(y) -> x == y
        _ -> false
    _ -> false

// Whether two values are the same.
//
// **Deep for arrays and objects rather than by identity**, which is the choice Python makes and
// JavaScript does not. It is the one a person expects of `[1, 2] == [1, 2]`.
//
// **A cyclic pair answers `true` on re-entry rather than descending forever**, which is the
// coinductive rule: assume the pairing holds unless something below it proves otherwise. A set of
// single values cannot express that, because what is being asked is whether *this* value equals
// *that* one -- so the record is of pairs. Without it `b == c` over two self-referential arrays
// descends until the stack is gone, and sysl reports that as a bare SIGSEGV (card 0299).
same(a: Value, b: Value, at: Span) -> Result[bool, Signal]
    var seen: Buf[SeenPair] = buf()

    same_in(a, b, &seen, at)

// **The left side's `equals` decides, and only the left side's**, which is Java's rule for
// `a.equals(b)`. Consulting both and disagreeing has no answer, and consulting the right side when
// the left declined would make `==` non-obvious to read.
//
// A hook makes `==` run arbitrary slate code, so a lookup re-enters the interpreter and a bad
// `equals` can fault or loop. Java lives with exactly this.
private same_in(a: Value, b: Value, seen: *Buf[SeenPair], at: Span) -> Result[bool, Signal]
    hook_of(a, "equals") match
        Some(f) ->
            var args: Buf[Value] = buf()

            args.push(b)
            return Ok(apply(f, args, at)?.truthy())
        None -> ()

    same_plain(a, b, seen, at)
end same_in

private same_plain(a: Value, b: Value, seen: *Buf[SeenPair], at: Span) -> Result[bool, Signal]
    a match
        Null -> b match
            Null -> Ok(true)
            _ -> Ok(false)
        Undefined -> b match
            Undefined -> Ok(true)
            _ -> Ok(false)
        Bool(x) -> b match
            Bool(y) -> Ok(x == y)
            _ -> Ok(false)
        Str(x) -> b match
            // **`x == y` here would compare the two `*StrObj` POINTERS**, which is identity and not
            // equality -- and it compiles, because pointers do compare. Moving a string from a value
            // into the collected heap turned a structural comparison into an identity one silently,
            // and fourteen tests caught it. Go has the same distinction and answers it the same way.
            Str(y) -> Ok(x.s == y.s)
            _ -> Ok(false)
        Int(x) -> b match
            Int(y) -> Ok(x == y)
            Real(y) -> Ok(real(x) == y)
            _ -> Ok(false)
        Real(x) -> b match
            Int(y) -> Ok(x == real(y))
            Real(y) -> Ok(x == y)
            _ -> Ok(false)
        Array(xs) -> b match
            Array(ys) -> same_array(xs, ys, seen, at)
            _ -> Ok(false)
        Object(xs) -> b match
            Object(ys) -> same_object(xs, ys, seen, at)
            _ -> Ok(false)
        Fn(_) -> Ok(false)

        // Two ranges are equal when they cover the same numbers, which is what `..` and `..<` written
        // two ways can do: `1..3` and `1..<4` are the same three.
        RangeVal(alo, ahi, ainc, ahl, ahh) -> b match
            RangeVal(blo, bhi, binc, bhl, bhh) ->
                if ahl != bhl || ahh != bhh then return Ok(false)

                val ax = if ainc then ahi else ahi - 1
                val bx = if binc then bhi else bhi - 1

                Ok(alo == blo && ax == bx)
            _ -> Ok(false)

        // **A promise compares by identity, as a function does.** Two promises that will settle to
        // the same value are not the same promise, and asking whether they are equal before either
        // has settled has no answer that stays true.
        Promise(x) -> b match
            Promise(y) -> Ok(x == y)
            _ -> Ok(false)
        Native(x) -> b match
            Native(y) -> Ok(x == y)
            _ -> Ok(false)

        // **A socket is its slot**, so two names for one socket are equal and two sockets never are.
        // That is identity again, arrived at from the other direction: the id *is* what the value is.
        Socket(x, xg) -> b match
            Socket(y, yg) -> Ok(x == y && xg == yg)
            _ -> Ok(false)
end same_plain

// **Identity first, and it is not only an optimisation.** `a == a` over a structure that reaches
// itself is the commonest way to meet a cycle, and answering it by walking would visit every node
// to prove what the address already settled.
//
// **A pairing left on `seen` by a failing comparison is never consulted again**, which is why only
// the true path pops: a `false` propagates straight out of every frame above it, so the walk that
// would have read a stale entry does not happen.
private same_array(xs: *ArrayObj, ys: *ArrayObj, seen: *Buf[SeenPair], at: Span) -> Result[bool, Signal]
    val ax: *u8 = ptr_cast(xs)
    val ay: *u8 = ptr_cast(ys)

    if ax == ay then return Ok(true)
    if in_progress(seen, ax, ay) then return Ok(true)
    if xs.items.len() != ys.items.len() then return Ok(false)

    seen.push(SeenPair(ax, ay))

    for i in 0..<xs.items.len()
        if !same_in(xs.items.at(i), ys.items.at(i), seen, at)? then return Ok(false)

    seen.truncate(seen.len() - 1)
    Ok(true)
end same_array

private same_object(xs: *ObjectObj, ys: *ObjectObj, seen: *Buf[SeenPair], at: Span) -> Result[bool, Signal]
    val ax: *u8 = ptr_cast(xs)
    val ay: *u8 = ptr_cast(ys)

    if ax == ay then return Ok(true)
    if in_progress(seen, ax, ay) then return Ok(true)
    if xs.live != ys.live then return Ok(false)

    seen.push(SeenPair(ax, ay))

    // **Order is not compared, only contents** -- an object that gained its fields in another order
    // is the same object. `hash_object` sums its fields for exactly this reason: an order-sensitive
    // mix would hash these two differently and lose one of them in its own table.
    for i in 0..<xs.entries.len()
        val e = xs.entries.at(i)

        if !e.dead
            obj_get(ys, e.key, at)? match
                Some(v) -> if !same_in(e.value, v, seen, at)? then return Ok(false)
                None -> return Ok(false)

    seen.truncate(seen.len() - 1)
    Ok(true)
end same_object

// -- ranges ---------------------------------------------------------------------------------------

// How many whole numbers a range covers. A `for` walks exactly this many.
//
// Not `private`: `builtin.sysl` answers `len` of one.
range_count(lo: long, hi: long, inclusive: bool) -> usize
    val last = if inclusive then hi else hi - 1

    if last < lo then 0 else usize(last - lo + 1)

// The half-open pair a range picks out of something `n` long, with the ends it did not name taken
// from that length and every end held inside it.
//
// Not `private`: the machine slices with it too.
range_within(r: Value, n: usize, at: Span) -> Result[(usize, usize), Signal]
    r match
        RangeVal(lo, hi, inclusive, has_lo, has_hi) ->
            val start = if has_lo then lo else 0
            val stop = if has_hi then (if inclusive then hi + 1 else hi) else long(n)

            if start < 0 || stop < start || usize(stop) > n
                return Err(failure(at, s"this slice runs from ${start} to ${stop}, which is outside something ${n} long"))

            Ok((usize(start), usize(stop)))
        other -> Err(failure(at, s"a slice is taken with a range, and this is ${other.type_name()}"))
end range_within

// -- reading ------------------------------------------------------------------------------------

read_at(container: Value, k: Value, at: Span) -> Step
    container match
        Array(items) ->
            k match
                Int(i) ->
                    if i < 0 || usize(i) >= items.items.len()
                        return fault(at, s"the index ${i} is outside an array of ${items.items.len()}")

                    Ok(items.items.at(usize(i)))

                // **A range subscript is a slice, and it is what an open end is FOR.** `xs[2..]`
                // takes an end from the array, which is the reading that makes a range with a side
                // missing mean something rather than being syntax with nowhere to go.
                RangeVal(_, _, _, _, _) ->
                    val bounds = range_within(k, items.items.len(), at)?
                    var out: Buf[Value] = buf()
                    var i = bounds.0

                    while i < bounds.1
                        out.push(items.items.at(i))
                        i += 1

                    Ok(Array(new_array(out)))
                other -> fault(at, s"an array is indexed by an integer, and this is ${other.type_name()}")
        Object(fields) ->
            k match
                _ -> Ok(obj_get(fields, k, at)?.unwrap_or(Undefined))
                other -> fault(at, s"an object is indexed by a string, and this is ${other.type_name()}")
        Str(sv) ->
            // **Both of these count CHARACTERS.** A string is a sequence of characters in slate and
            // never of bytes, so a position here is one a person would count -- and an index into
            // the bytes would hand back half of one wherever the text was not ASCII.
            val n = char_count(sv.s)

            k match
                // **A character is a string of one**, there being no character type -- which is
                // Python's answer and is what lets `s[i]`, `chars(s)` and `split` all hand back the
                // same kind of thing.
                Int(i) ->
                    if i < 0 || usize(i) >= n
                        return fault(at, s"the index ${i} is outside a string of ${n} characters")

                    Ok(str_value(char_slice(sv.s, usize(i), usize(i) + 1)))
                RangeVal(_, _, _, _, _) ->
                    val bounds = range_within(k, n, at)?

                    Ok(str_value(char_slice(sv.s, bounds.0, bounds.1)))
                other -> fault(at, s"a string is not indexed by ${other.type_name()}")
        other -> fault(at, s"${other.type_name()} cannot be indexed")
end read_at

// **A field that is not there reads as `null` rather than faulting**, which is the choice every
// dynamically typed language with objects makes: a record grows fields over its life, and `o.maybe`
// is how a program asks whether this one has.
read_field(target: Value, name: string, at: Span) -> Step
    target match
        Object(fields) ->
            val found = field_from(fields, name, at)?

            Ok(found.0)

        // **A builtin type has methods and no fields**, so `xs.map` hands back the plain builtin --
        // the same thing `o.m` hands back for an object, and called the same way. Anything that is
        // not a method of this kind is a fault rather than the `undefined` an object answers with,
        // because a builtin's set of names is closed and a missing one is a mistake.
        other ->
            builtin_method(other, name) match
                Some(f) -> Ok(Native(f))
                None -> fault(at, no_such_method(other, name))

// How far a chain of prototypes may go before slate decides it is a circle.
//
// **A `proto` is an ordinary field, so a program can make one point at itself** -- and a lookup that
// misses would then walk forever with nothing to report. The limit is generous enough that no honest
// arrangement reaches it and small enough that the mistake is a sentence rather than a hang.
private const MaxProtoDepth: usize = 64

// A field, and whether it came from a PROTO rather than from the object itself.
//
// **That second answer is the whole of slate's receiver rule.** A method stored on the object has
// already captured what it needs -- `p.equals = o -> o.x == p.x` is the shape slate has always
// written -- and one shared through a proto demonstrably cannot have, there being one of it for
// every instance. So the shared kind is handed the object and the captured kind is not, and the
// difference is not a special case but the actual distinction between the two.
//
// Absent everywhere is `Undefined`, which is what a missing field has always been.
field_from(o: *ObjectObj, name: string, at: Span) -> Result[(Value, bool), Signal]
    obj_get_name(o, name) match
        Some(v) -> return Ok((v, false))
        None -> ()

    var up = o
    var depth: usize = 0

    loop
        val next = obj_get_name(up, "proto") match
            Some(Object(p)) -> p
            _ -> return Ok((Undefined, false))

        obj_get_name(next, name) match
            Some(v) -> return Ok((v, true))
            None -> ()

        depth += 1

        if depth >= MaxProtoDepth
            return Err(failure(at, s"this object's `proto` chain is more than ${MaxProtoDepth} deep, which means it is a circle -- looking up `${name}` would never finish"))

        up = next
end field_from

// A builtin method and the receiver rule's answer for it, in the shape `field_from` uses.
//
// **A builtin method is always delegated to**, which is what the `true` says: it is the free
// function of that name and the receiver is its first argument, so it is exactly the case a proto
// method is -- one implementation shared by every value of the kind, which therefore has to be told
// which one it is working on.
builtin_receiver(target: Value, name: string, at: Span) -> Result[(Value, bool), Signal] =
    builtin_method(target, name) match
        Some(f) -> Ok((Native(f), true))
        None -> Err(failure(at, no_such_method(target, name)))

// Call a value with arguments already evaluated.
//
// **No calling scope is passed, and that is what a closure means.** The body runs in a child of the
// scope the closure *captured*, so nothing about where the call was written matters -- which is also
// what lets `==` call a user-supplied `equals` from inside a table lookup, where there is no
// interpreter scope to hand over.
apply(f: Value, vals: Buf[Value], at: Span) -> Step
    f match
        Native(f) -> call_native(f, vals, at)
        Fn(c) ->
            if vals.len() != c.params.len()
                return fault(at, s"this function takes ${c.params.len()} arguments and was given ${vals.len()}")

            // **An `async` function starts a coroutine wherever it is called from**, including from a
            // native -- a timer callback, a user `equals`. Running its body here instead would put an
            // `await` under a sysl frame that cannot be captured, which is the one thing the machine
            // exists to avoid.
            if current_unit.chunks.at(c.body).is_async
                return start_async(c, vals, at)

            val emark = env_mark()
            val scope = new_env(c.scope)

            hold_env(scope)

            for i in 0..<c.params.len()
                declare(scope, c.params.at(i), vals.at(i), true)

            // The annotation is the one the compiler asks for: a bare `Ok`/`Err` pair in a `match`
            // used as a value has nothing on the line to say what the other half is.
            val answer = run_chunk(&current_unit, c.body, scope)

            release_env(emark)
            answer
        other -> fault(at, s"${other.type_name()} is not something that can be called")
end apply

// What to say when a destructuring binding does not fit.
//
// **A `match` arm that does not fit needs no sentence and a binding does**, there being no next arm
// to try -- so this is the one place a pattern's failure has to be explained. `write_pattern`'s
// s-expression form is for reading a parse and would send the reader to the wrong thing here; what
// they need is which of the two halves is wrong, so each arm names the shape it wanted and the
// thing that arrived.
unpack_complaint(pat: Pattern, v: Value) -> string
    *pat.kind match
        ArrayPat(items, open, _) ->
            v match
                Array(a) ->
                    val least = if open then "at least " else ""

                    if a.items.len() == items.len()
                        return "this array has the right number of elements, and one of them does not fit the binding"

                    s"this binding takes ${least}${items.len()} elements out of an array, and this one has ${a.items.len()}"
                other -> s"this binding takes an array apart, and this is ${other.type_name()}"
        ObjectPat(keys, _) ->
            v match
                Object(o) ->
                    for i in 0..<keys.len()
                        if obj_get_name(o, keys.at(i)).is_none()
                            return s"this object has no field called `${keys.at(i)}`, which this binding takes out of it"

                    "every field this binding names is there, and one of them does not fit"
                other -> s"this binding takes an object apart, and this is ${other.type_name()}"
        _ -> s"this value does not fit the binding -- it is ${show_value(v)}"
end unpack_complaint

// Whether a pattern matches a value, binding its names into `scope` as it goes.
//
// **`assignable` is what a destructuring `var` needs and nothing else uses.** A name a `match` arm
// or an `is` introduces is a `val` -- it is the arm's reading of the subject and there is nothing to
// write it back to -- so every caller but `Unpack` passes false.
//
// **It answers a bare `bool` rather than a `Step`, and that is deliberate**: nothing a pattern does
// can fail at runtime. There is no arithmetic in one, no call, and no index that could be out of
// range -- a pattern that does not fit simply does not fit, which is an answer and not a fault.
match_pattern(pat: Pattern, v: Value, scope: *EnvObj, assignable: bool) -> bool
    *pat.kind match
        Wild -> true
        Bind(name) ->
            // Bound as a `val`: a name a pattern introduced is not a place to write to.
            declare(scope, name, v, assignable)
            true
        TypePat(test) -> is_kind(v, test)
        At(name, inner) ->
            // **The sub-pattern runs first, and the whole value is bound only if it took.** The
            // other order would leave the name bound after a failed arm -- which the arm's own
            // scope would throw away anyway, but only by accident rather than by rule.
            if !match_pattern(inner, v, scope, assignable) then return false

            declare(scope, name, v, assignable)
            true
        IntPat(want) -> same_literal(v, Int(want))
        RealPat(want) -> same_literal(v, Real(want))
        StrPat(want) -> v match
            // Compared against the sysl `string` directly, so a pattern never boxes one onto the
            // collected heap just to throw it away.
            Str(p) -> p.s == want
            _ -> false
        BoolPat(want) -> same_literal(v, Bool(want))
        NullPat -> v match
            Null -> true
            _ -> false
        ArrayPat(items, open, rest) -> match_array(items, open, rest, v, scope, assignable)
        ObjectPat(keys, values) -> match_object(keys, values, v, scope, assignable)
        OrPat(alts) ->
            for i in 0..<alts.len()
                if match_pattern(alts.at(i), v, scope, assignable) then return true

            false
end match_pattern

// `[a, b]` and `[first, ...rest]`.
private match_array(items: Buf[Pattern], open: bool, rest: Option[string], v: Value, scope: *EnvObj, assignable: bool) -> bool
    v match
        Array(xs) ->
            // A closed pattern must agree on length exactly; an open one treats the fixed patterns
            // as a floor.
            val fixed = items.len()

            if open
                if xs.items.len() < fixed then return false
            else
                if xs.items.len() != fixed then return false

            for i in 0..<fixed
                if !match_pattern(items.at(i), xs.items.at(i), scope, assignable) then return false

            // The tail is only gathered where it is named. `[a, ...]` allocates nothing.
            rest match
                Some(name) ->
                    var tail: Buf[Value] = buf()

                    for i in fixed..<xs.items.len()
                        tail.push(xs.items.at(i))

                    declare(scope, name, Array(new_array(tail)), assignable)
                None -> ()

            true
        _ -> false
end match_array

// `{ name: n }`.
//
// **An object pattern matches an object with *at least* these fields.** A record grows fields over
// its life, so a pattern that broke whenever one was added would be a pattern nobody could keep
// working -- and a program that wants exactness can ask `len(o)`.
private match_object(keys: Buf[string], values: Buf[Pattern], v: Value, scope: *EnvObj, assignable: bool) -> bool
    v match
        Object(fields) ->
            for i in 0..<keys.len()
                obj_get_name(fields, keys.at(i)) match
                    None -> return false
                    Some(field) -> if !match_pattern(values.at(i), field, scope, assignable) then return false

            true
        _ -> false
end match_object

// Whether a value is of a kind.
//
// **`num` is the only one that is not a single variant**, being the union of `int` and `real` --
// which is what a pattern guarding arithmetic wants, and is why it is in the list at all.
private is_kind(v: Value, test: TypeTest) -> bool
    test match
        IsNull -> v match
            Null -> true
            _ -> false
        IsBool -> v match
            Bool(_) -> true
            _ -> false
        IsInt -> v match
            Int(_) -> true
            _ -> false
        IsReal -> v match
            Real(_) -> true
            _ -> false
        IsNum -> v match
            Int(_) -> true
            Real(_) -> true
            _ -> false
        IsStr -> v match
            Str(_) -> true
            _ -> false
        IsArray -> v match
            Array(_) -> true
            _ -> false
        IsObject -> v match
            Object(_) -> true
            _ -> false
        IsFn -> v match
            Fn(_) -> true
            Native(_) -> true
            _ -> false
end is_kind
