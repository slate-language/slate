module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.slices.sort_by
import sysl.text.str_builder

// What running a program needs that is not the machine itself: equality, arithmetic, indexing,
// pattern matching, and calling.
//
// **This was `eval.sysl`, and it is what survived the tree-walker.** Every one of these was shared by
// the walker and the machine while both existed, which is why the port could not change them by
// accident -- a rewrite that reimplements settled semantics is a rewrite that changes them.
//
// **A fault still travels in the error channel.** The machine compiles `break`, `continue` and a
// block's value into jumps, so `Brk` and `Cont` no longer travel anywhere -- but `Ret` still leaves a
// native that called back into slate, and a fault still has to come out of a hook from inside a table
// lookup. `Result[Value, Signal]` is what carries both, and `?` is still what propagates them.

// Why a walk stopped early.
//
// The names avoid `Break`, `Continue` and `Return`, which `StmtKind` and `Tok` already have. Two
// enums may share a variant name and the expected type picks between them, but a reader should not
// have to work out which `Break` is meant.
enum Signal
    // A `return` on its way out of a call.
    Ret(v: Value)

    Brk
    Cont

    // Something the program did that it may not.
    //
    // **`src` is which file the span is an offset into**, and it travels with the fault rather than
    // being looked up when the fault is reported. A `Signal` outlives the statement that raised it —
    // an unhandled rejection is reported after the loop has drained, by which time the machine is
    // somewhere else entirely — so the file has to be captured where the span was.
    // **`value` is what a `catch` BINDS, where the fault carries one.** `throw v` of anything that is
    // not a string carries `v` itself, so a handler can sort faults by what went wrong rather than by
    // reading a sentence -- `catch NotFound(id)` is the pattern a `match` arm would be. `None` is the
    // other kind of fault: one the machine raised, and a `throw` of a string, both of which a `catch`
    // is handed as the object `fault_value` builds. `message` is filled either way, being what a
    // diagnostic says when nothing catches this.
    Fail(at: Span, src: usize, message: string, value: Option[Value])

    // `exit(n)` on its way out of everything.
    //
    // **A signal and not a call to the host's `exit`.** The driver collects what a program printed
    // and says it once the run is over, so a builtin that left the process where it stood would take
    // every line the program had written with it -- a script that prints its answer and then exits
    // would print nothing at all. Unwinding hands the status back to the driver, which prints first
    // and leaves afterwards.
    //
    // **It is not catchable, and that is the point of it being its own variant.** `guarded` matches
    // `Fail` and only `Fail`, so a `try` between the `exit` and the top passes this straight through:
    // a library cannot swallow a script's decision to stop, which is what would happen if `exit` were
    // a fault with a special message.
    Quit(at: Span, src: usize, status: long)

    // `skip("...")` on its way out of a test.
    //
    // **A variant of its own for `Quit`'s reason and not for a different one.** `guarded` matches
    // `Fail` and only `Fail`, so a `try` between the `skip` and the runner passes this straight
    // through: a test that leaves itself out cannot have that decision swallowed by a library it
    // called, which is exactly what would happen if a skip were a fault with a special message.
    Skip(at: Span, src: usize, reason: string)

    // An `await` set the running machine aside.
    //
    // **It travels in the error channel because that is the only channel that unwinds.** Suspending
    // means leaving `execute` without a value, and every `?` on the way out already knows how to pass
    // an `Err` along -- so a new outcome type would have rewritten forty call sites to say what one
    // variant says here. Nothing but the scheduler ever matches on it, and it never reaches a
    // program: the machine it belongs to is in `parked` by the time it is raised.
    Wait
end Signal

// What every step of the walk answers with.
type Step = Result[Value, Signal]

// A fault at a place, as the error channel wants it.
//
// Which file the machine is currently running code from, as an index into the unit's sources, is
// `current().current_source` -- see `vm_state.sysl`.

// A fault as a bare `Signal`, for the callers whose error channel is not a `Step`.
//
// **This is the ONE place a `Fail` is built**, which is what lets it learn the current file without
// 116 call sites saying so. `Fail` is otherwise only ever matched on.
failure(at: Span, message: string) -> Signal = Fail(at, current().current_source, message, None)

fault(at: Span, message: string) -> Step = Err(failure(at, message))

// A fault CARRYING a value, which is what `throw v` raises for a `v` that is not a string.
//
// **`message` is the sentence the value renders to** and is what an uncaught fault says; the value is
// what a `catch` binds. Both are filled here so that nothing downstream has to decide which of them a
// fault has.
value_failure(at: Span, message: string, v: Value) -> Signal = Fail(at, current().current_source, message, Some(v))

// **WHAT A THROWN VALUE MEANS IS DECIDED HERE AND NOWHERE ELSE**, because `throw` is not the only way
// a program raises one: `reject(v)` and `fail(p, v)` put the very same fault into a promise, and two
// answers to *is a string a sentence* would be two languages.
//
// **A STRING IS A SENTENCE AND EVERYTHING ELSE IS ITSELF.** A thrown string has nothing in it a
// handler could sort on, so it is flattened and the `catch` is handed the `{message, line, file}`
// object it has always been handed; anything else travels whole, so `catch NotFound(id)` can ask what
// went wrong rather than reading a sentence.
thrown_payload(v: Value) -> Option[Value] = v match
    Str(_) -> None
    other -> Some(other)

// The sentence that fault SAYS, which is what an uncaught one is reported as.
//
// **An object with a `message` is READ for that field rather than rendered**, which is what lets a
// library put a fault back with `throw e` without replacing it with a description of itself.
//
// **A VALUE IS WRITTEN THE WAY `print` WRITES IT, so a class that wrote a `toString` decides what its
// own fault says** -- the one diagnostic in slate that runs a program's own code. The rule the rest of
// them keep is kept here by the FALLBACK: where that hook faults in turn, the ordinary rendering is
// what is left, so the reader is told about the fault the program threw rather than about the one its
// `toString` raised on the way out.
//
// **It is worked out where the fault is RAISED and not where it is reported**, because that is the one
// place the value is certainly still the machine's: a `Signal` travels in a sysl local, which is no
// root, and a report happens after everything the unwind ran.
thrown_message(at: Span, v: Value) -> string = v match
    Str(p) -> p.s
    Object(o) ->
        obj_get_name(o, "message") match
            Some(Str(p)) -> p.s
            _ -> program_text(at, v)
    other -> program_text(at, other)

// The rendering `print` gives, with the diagnostic one where the program's own hook faulted.
private program_text(at: Span, v: Value) -> string = printed(v, at) match
    Ok(said) -> said
    Err(_) -> value_text(v)

// `exit(n)` as the error channel wants it, carrying the place it was asked for.
//
// **The place is carried for the one caller that renders a `Quit`, which is `slate test`.** `run`
// reads the status and never draws a diagnostic, so on the ordinary path this span is never looked
// at -- but a `@test` that calls `exit` is refused, and a refusal that pointed at byte zero would
// name the file's first line instead of the call. It learns the file the way `failure` does.
quit(at: Span, status: long) -> Step = Err(Quit(at, current().current_source, status))

// `skip(reason)` as the error channel wants it, learning the file the way `failure` does.
skipped(at: Span, reason: string) -> Step = Err(Skip(at, current().current_source, reason))

// -- what a call that was EXPECTED to fail answers with ------------------------------------------

// **A failure a caller is meant to deal with is a value, not an unwind.** A file that is not there
// is not a defect in the program asking for it; a name that is not defined is. So the two get two
// channels: this one, which the caller has to look at, and `catch`, which is there for the ones
// nothing could have anticipated. That is Rust's division and Swift's, and it is the reason building
// both was not a compromise -- unwinding cost the machine a handler stack, and this cost nothing at
// all, because slate objects already do everything a result needs doing.
//
// **An ordinary object, so `match` already takes it apart**: `r match { ok: true, value: v } -> ...`
// needs no syntax slate does not have.

// A call that worked, and what it answered.
ok_value(v: Value) -> Value
    val mark = root_mark()
    val o = new_object()

    hold(Object(o))
    hold(v)
    obj_put_name(o, "ok", Bool(true))
    obj_put_name(o, "value", v)
    release(mark)
    Object(o)
end ok_value

// A call that did not, and the sentence saying why.
//
// **Only the field that applies is there**, rather than both with one of them null. Reading `r.value`
// off a failure is then `undefined`, which slate already refuses to bind with a message naming the
// field -- so the mistake is caught where it is made instead of travelling as a null.
err_value(message: string) -> Value
    val mark = root_mark()
    val o = new_object()

    hold(Object(o))
    obj_put_name(o, "ok", Bool(false))
    obj_put_name(o, "error", str_value(message))
    release(mark)
    Object(o)
end err_value

// One end of a range, which has to be a whole number.
//
// Not `private`: the machine builds a range and `builtin.sysl` reports on one.
range_end(v: Value, at: Span, which: string) -> Result[long, Signal]
    v match
        Int(n) -> Ok(n)
        other -> Err(failure(at, s"${which} of a range is a whole number, and this is ${other.type_name()}"))

// Whether a value is the absent one.
is_absent(v: Value) -> bool = v match
    Undefined -> true
    _ -> false

// Whether `??` should reach for its default.
//
// **Both, which is JavaScript's rule and is the right one in practice.** In theory a `null` a program
// chose should survive a default, and slate can still say so -- `has` asks whether a field is there,
// which is the one question that still tells the two absences apart now that `==` does not. But the
// overwhelmingly common need is "if this is missing or empty, use that", and an operator that handled
// only half of it would be reached for and found wanting. The distinction stays where it earns its
// keep and is not made to earn it here.
//
// C#, Kotlin and Swift all fire on their single absent value; JavaScript fires on both because it has
// two. slate has two, so it fires on both.
is_nullish(v: Value) -> bool = v match
    Null -> true
    Undefined -> true
    _ -> false

// Refuse to keep absence.
//
// **This is the whole of what makes `undefined` second class**, and it is checked at every point a
// value is kept or handed on rather than at the point it is made: bound to a name, written to one,
// put in an array or an object, used as a key, or passed to a function.
//
// The alternative -- letting it flow like any other value -- is JavaScript's, and the reason it hurts
// is not that `undefined` exists but that it *travels*. It is stored, passed through three layers,
// and observed a long way from the lookup that made it, by which time nothing knows what was
// missing. Refusing it here means the program has to say what absence means where it arose, which is
// the one place it still knows.
//
// **THE VM IS A PARAMETER IN THE FORM THE INSTRUCTION LOOP USES, AND THE REFUSAL IS WHY.** The check
// itself reads nothing but the value; the sentence it builds needs the file the span belongs to,
// which is `current().current_source` -- and `current()` is a thread-local read, a `_tlv_get_addr`
// call on this platform that an optimiser is free to lift out of the branch it was written in and
// charge to every value the program ever binds, passes or stores. Handing the VM in takes it out of
// the question. `keepable` below is the same check for a caller with no VM in hand.
keepable_on(vm: *Vm, v: Value, at: Span, what: string) -> Result[unit, Signal]
    if is_absent(v)
        return Err(Fail(at, vm.current_source, s"this field is not there, and `undefined` cannot be ${what} -- give it a value with `??`, or ask `has` first", None))

    Ok(())
end keepable_on

// Whether a value may be kept, for a caller that is not already holding the VM.
keepable(v: Value, at: Span, what: string) -> Result[unit, Signal] = keepable_on(current(), v, at, what)

// -- entry point --------------------------------------------------------------------------------

// Where a diagnostic is, for putting a report in reading order across several files.
//
// **The file comes first and the index is the last resort**, which is `sh.sysl.parsing`'s own
// `Placed` with one field in front of it: sorting on the triple makes every key distinct, so an
// unstable sort still leaves two complaints about one place in the order they were made.
private struct Placed
    src: usize
    start: usize
    index: usize

// What running a program answers with.
struct Ran
    value: Value
    report: Report

    // Which file each diagnostic is about, in step with the report's own items.
    //
    // **A parallel list rather than a field on the `Diagnostic`.** `Diagnostic` belongs to
    // `sh.sysl.parsing`, which the sysl compiler, `json` and `ogol` all share, so a field there would
    // be paid for by every construction in the organisation for one consumer's benefit -- and the
    // same argument that keeps the file out of `Span` keeps it out of here. What makes the parallel
    // list safe is that a report is append-only and `Report.render` sorts a table of positions rather
    // than the report, so the items stay in the order they were added.
    srcs: Buf[usize]

    // Every file the program was made of, indexed by what `srcs` holds.
    sources: Buf[Source]

    // The lines the program printed, in order.
    output: &Buf[string]

    // What the program asked the shell to hear, where it asked at all.
    //
    // **Zero means nothing was asked, not that the program succeeded** -- a run that failed reports
    // that through the report, and the driver is what puts the two together. Only `exit(n)` puts
    // anything else here, which is why every construction that is answering a *complaint* passes
    // zero: there is no status to carry when the program never started.
    status: long

    ok(self) -> bool = !self.report.has_errors()

    // Every complaint rendered against the file it is actually about.
    //
    // **`Report.render` cannot do this and must not be asked to**: it takes one `Source` and renders
    // everything against it, which quotes the wrong line as soon as a program is more than one file.
    // Rendering per item is what `Report.at` exists for.
    //
    // Sorted by file and then by position, so the complaints about one file arrive together and in
    // reading order, with the files in the order they were read -- the entry first.
    render(self) -> string
        var order: Buf[Placed] = buf()

        for i in 0..<self.report.len()
            order.push(Placed(self.srcs.at(i), self.report.at(i).span.start, i))

        val xs = order.view()

        sort_by(xs, (p, q) -> p.src < q.src
            || (p.src == q.src && p.start < q.start)
            || (p.src == q.src && p.start == q.start && p.index < q.index))

        // The same handful `sh.sysl.parsing` prints, and for its reason: a grammar that resumes
        // after a mistake reports the same one several ways, and the twentieth is never read.
        val shown = if xs.len > ReportLimit then ReportLimit else xs.len
        var b = str_builder()

        for i in 0..<shown
            if i > 0 then b.push("\n")

            val at = xs[i]

            b.push(self.report.at(at.index).render(self.sources.at(at.src)))

        if shown < xs.len then b.push(s"\nshowing the first ${shown} of ${xs.len}\n")

        b.finish()
    end render

    // Everything printed, joined by newlines -- which is what a test compares against.
    printed(self) -> string
        var out = str_builder()

        for i in 0..<self.output.len()
            if i > 0 then out.push_char('\n')

            out.push(self.output.at(i))

        out.finish()
    end printed
end Ran

// How many complaints are printed before the rest are counted.
private const ReportLimit: usize = 5

// Where to point at a signal that escaped to the top.
signal_span(s: Signal) -> Span = s match
    Fail(at, _, _, _) -> at
    Quit(at, _, _) -> at
    Skip(at, _, _) -> at
    _ -> point(0)

// Which file a signal that escaped to the top is about.
//
// **Zero for the ones that carry no place**, which is the entry: a `break` outside a loop is a
// complaint about the program the user named, and there is nowhere better to point.
signal_source(s: Signal) -> usize = s match
    Fail(_, src, _, _) -> src
    Quit(_, src, _) -> src
    Skip(_, src, _) -> src
    _ -> 0

// Which file a signal is about, by NAME rather than by the index `signal_source` answers.
//
// **This is the one that survives a signal crossing to another thread.** `signal_source`'s index
// numbers THIS thread's own `running_unit().sources`, which an actor's thread never shares -- so a
// fault handed across as `(message, src)` would point at whatever the other thread's table happens
// to hold in that position. A name is the only part of the address that still means the same file
// once it is somewhere else.
signal_file(s: Signal) -> string
    val src = signal_source(s)
    val u = running_unit()

    if src < u.sources.len() then u.sources.at(src).name else ""
end signal_file

// The local index a file NAMED from elsewhere resolves to, for rebuilding a fault that crossed a
// thread into one this thread can render.
//
// **Index 0 for a name this thread never loaded**, which is not a guess dressed up as an answer --
// `Diagnostic.render` clamps a span past the end of whatever `Source` it is given rather than
// crashing, so the worst a name matching nothing does is point at the wrong line of the wrong
// file, never break. The ordinary case is the common one: an actor's declarations are compiled
// from the very source text its spawner already has open, so the name matches file 0 or whichever
// import carried the `actor` block.
local_source_of(file: string) -> usize
    val u = running_unit()

    for i in 0..<u.sources.len()
        if u.sources.at(i).name == file then return i

    0
end local_source_of

signal_message(s: Signal) -> string = s match
    Fail(_, _, m, _) -> m
    Ret(_) -> "`return` outside a function"
    Brk -> "`break` outside a loop"
    Cont -> "`continue` outside a loop"
    Wait -> "`await` suspended a call that had nowhere to come back to"

    // **Reached from `slate test` and from nowhere else.** `run` takes a `Quit` as the status the
    // shell is owed and never renders it; a `@test` that calls `exit` is asking to stop a run that is
    // not its own, so there it is a complaint about the test.
    Quit(_, _, n) -> s"`exit(${n})` was called, and a test may not stop the run it is part of"

    // **Reached where a `skip` escaped to somewhere with no test to leave out**, which is a program
    // run plainly rather than through `slate test`. The runner reads the reason off `skip_reason`
    // long before this, so a skipped test never renders it.
    Skip(_, _, why) -> s"`skip(\"${why}\")` was called outside a test -- only `slate test` has a test to leave out"

// Writing through `xs[i]` and `o[k]`.
store_at(container: Value, k: Value, v: Value, at: Span) -> Step
    container match
        Array(items) ->
            k match
                Int(i) ->
                    // **Asked before the bounds are**, so a frozen array answers what is actually
                    // wrong rather than complaining about a position that was perfectly good.
                    if items.frozen then return fault(at, frozen_array_complaint("xs[i] = v"))

                    if i < 0 || usize(i) >= items.items.len()
                        return fault(at, s"the index ${i} is outside an array of ${items.items.len()}")

                    items.items.set(usize(i), v)
                    Ok(Null)
                other -> fault(at, s"an array is indexed by an integer, and this is ${other.type_name()}")

        // **A buffer is written through at a position that is already there**, which is an array's
        // rule: `b[b.length] = v` is a fault and `push` is what grows one. What is stored is a byte,
        // so a number outside 0 to 255 is a mistake in the program rather than a truncation.
        Bytes(bs) ->
            k match
                Int(i) ->
                    if bs.frozen then return fault(at, frozen_bytes_complaint("b[i] = v"))

                    if i < 0 || usize(i) >= bs.data.len()
                        return fault(at, s"the index ${i} is outside ${bs.data.len()} bytes")

                    bs.data.set(usize(i), byte_of_value(v, at)?)
                    Ok(Null)
                other -> fault(at, s"bytes are indexed by an integer, and this is ${other.type_name()}")
        Object(fields) ->
            k match
                _ -> obj_put(fields, k, v, at)
        External(_) -> fault(at, js_host_only("writing a key on an external"))
        other -> fault(at, s"${other.type_name()} cannot be indexed")
end store_at

// Not `private`: `private` in sysl is private to the *file*, and the machine in `vm.sysl` runs the
// same operators the walker ran.
unary(op: Tok, v: Value, at: Span) -> Step
    op match
        Minus ->
            // **Negation is the one arithmetic that grows with no second operand**: the most
            // negative `long` has no positive twin, so `-(-9223372036854775808)` is a big integer.
            // `arith_big.sysl` owns the three prefix answers for that reason.
            negated_value(v, at) match
                Some(answer) -> return answer
                None -> ()

            // **The one unary operator an object may answer for**, and it is spelled `unary_-`
            // rather than `-` because it takes no other side: a type whose `-` has two operands has
            // said nothing about what `-v` should be.
            call_hook(v, "unary_-", buf(), at) match
                Some(answer) -> return answer
                None -> ()

            fault(at, s"`-` needs a number, and this is ${v.type_name()}")
        Bang -> Ok(Bool(!v.truthy()))
        Tilde ->
            complemented_value(v) match
                Some(answer) -> return Ok(answer)
                None -> fault(at, s"`~` needs a whole number, and this is ${v.type_name()}")
        _ -> fault(at, "this is not a prefix operator")
end unary

// The half of `binary` that works on operands already evaluated.
//
// **The machine reaches this and not `binary`**, because short-circuiting is a compile-time question
// there: `&&` becomes a jump that keeps the operand that decided, so by the time an operator runs
// both sides are values. Sharing the arithmetic rather than rewriting it is what stops the machine
// and the walker drifting apart while both exist.
on_values(op: Tok, a: Value, b: Value, at: Span) -> Step = op match
    EqEq -> Ok(Bool(same(a, b, at)?))
    BangEq -> Ok(Bool(!same(a, b, at)?))
    _ -> arith(op, a, b, at)
