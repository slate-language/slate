module dev.slatelang.slate

import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}

// WHICH SCOPE GETS WHICH BUILTIN -- and nothing else.
//
// **The list of them is gone and this file is an index of `install_` functions.** Every builtin used
// to be declared here, five hundred lines of `declare(env, "readFile", Native(NReadFile), false)`
// standing a long way from the code that implements it; a builtin now registers itself and declares
// itself where it is written, so `install_fs` is in the file that holds the file system and
// `install_lmdb` is in the file that holds LMDB. `native_fn.sysl` is the registry those calls reach.
//
// **What is left here is the thing that genuinely belongs to no subsystem**: the two scopes, the
// order they are filled in, and the two lists a scope is read back off -- `builtin_names()` for the
// JavaScript back end and `global_native` for the checker.
//
// **A subsystem can now be left out of a build by dropping one line below.** That is the whole of
// what opening the registry bought, and it is why this function is a list of calls rather than a
// list of names.

// Put every builtin in a scope, whether or not a module has taken it.
//
// **This is the scope one of slate's OWN modules is compiled against**, which is how `slate:time`
// gets at `now` -- a built-in module's chunk is a `LoadName` per export, and the export list is what
// says which names it takes out of here. See `stdlib.sysl`.
install_builtins(env: *EnvObj) = install_natives(env, true)

// process-wide: a name-to-id index over `natives`, built once on the first ask and never invalidated
// -- a native id is process-wide, so what this remembers is too.
private var named_natives: Map[string, NativeFn] = map()

// process-wide: whether the index above has been built.
private var named_natives_built: bool = false

// The native the GLOBAL of this name is bound to, or nothing where no global has that name.
//
// **What it exists to answer is whether a method IS the free function of its name**, which is what
// lets the checker read a method call's signature off the global one: `xs.map(f)` is `map(xs, f)`
// down to the very native, so `map`'s signature describes it exactly. `s.has(v)` is not `has(o, k)`
// -- a set's `has` is its own native and the global one takes an object -- so the global's
// signature there would refuse a program that runs. `method_signature` in `calls.sysl` compares the
// two natives rather than trusting the spelling.
//
// **Built once and read off the same `install_builtins` every other list here is read off**, so a
// builtin added to a subsystem's installer is in this table on the next build and there is no second
// list.
global_native(name: string) -> Option[NativeFn]
    if !named_natives_built
        val env = new_env(null)

        install_builtins(env)

        var walk = env.names.walk()

        loop
            walk.next() match
                None -> break
                Some(pair) -> pair.1 match
                    Native(f) -> named_natives.put(pair.0, f)
                    _ -> ()

        named_natives_built = true

    named_natives.get(name)
end global_native

// Put in the ones no built-in module has taken, which is the scope a PROGRAM'S own files run in.
//
// **The core shrinks as modules are added, and nothing here has to be re-listed for that**: one
// `if everything` guards each block that has moved, and those guards are inside the installers now
// -- so the two scopes come from one list and cannot drift into disagreeing about what a builtin is.
install_core(env: *EnvObj) = install_natives(env, false)

// Every builtin's name, in one sorted list.
//
// **The JavaScript back end wraps a program in a function whose parameters are these**, so that a
// builtin is a name a slate program can write without slate owning that name in the host's global
// scope. `js.sysl` is the caller and `docs/reference/javascript.md` says why it matters: an emitted
// program that took `globalThis.setTimeout` broke node's own `WebSocket`, whose handshake calls the
// global and expects the host's handle back -- and in a browser it would break every other script on
// the page.
//
// **It is read off the SCOPE and is not a second list**, which is what makes it survive the registry:
// a builtin declared by any installer is a parameter here on the next build, and the registry's own
// table is deliberately NOT what is read -- a native registered and declared into no scope is
// reachable by nothing and must not become a parameter.
builtin_names() -> Buf[string]
    val env = new_env(null)

    install_builtins(env)

    var out: Buf[string] = buf()
    var walk = env.names.walk()

    loop
        walk.next() match
            None -> break
            Some(pair) -> out.push(pair.0)

    // **Sorted, so the emitted program does not change with the order a map happened to walk in.**
    // A map's walk is deterministic for one set of keys, so this is about a READER: two builds whose
    // builtins differ by one name should differ by one parameter, and an unsorted list would move
    // every name after it.
    for i in 1..<out.len()
        val name = out.at(i)
        var j = i

        while j > 0 && out.at(j - 1) > name
            out.set(j, out.at(j - 1))
            j -= 1

        out.set(j, name)

    out
end builtin_names

// Every subsystem's installer, in one place, and `everything` is handed to each one that has names a
// built-in module has taken.
//
// **Registering is idempotent and declaring is not**, which is what lets this run once per program
// the process runs: `register` answers the id a name already has, so the table is built on the first
// call and every call after it only fills a scope.
//
// **A subsystem whose names are all a module's still registers them all.** `builtin_names()` asks for
// the whole scope, and a native that exists but is declared nowhere would be a name the JavaScript
// back end could not pass and the runtime would still answer to.
private install_natives(env: *EnvObj, everything: bool)
    // The handful that belong to no module.
    install_basics(env)
    install_text(env)
    install_case(env)
    install_numbers(env)
    install_array(env)
    install_reshape(env)
    install_json(env)
    install_assert(env)
    install_generator(env)

    // The event loop and the promises, which are node's names throughout.
    install_timers(env)
    install_combine(env)

    // Sets, maps and the weak pair: two constructors each and everything else a method.
    install_setmap(env)
    install_weak(env)

    // A declared type, once it is a value. Three methods and no global at all.
    install_shape()

    // **`fetch` stays native and global because HTTPS needs OpenSSL**, so the encrypted transport
    // stays where the binding is and a slate-level server owns the protocol and never the socket.
    install_fetch(env)

    // Which of the three hosts this is, what the host provides itself, and the WebSocket calls that
    // only a host with one can answer.
    install_host(env, everything)

    // The built-in modules, each of which took its names out of the core.
    install_fs(env, everything)
    install_net(env, everything)
    install_time(env, everything)
    install_format(env, everything)
    install_regex(env, everything)
    install_process(env, everything)
    install_spawn(env, everything)
    install_channel(env, everything)
    install_signals(env, everything)

    // The encodings. `slate:brotli`, `slate:gzip` and Zstandard beside it, whose names are the
    // format's own verbs because `compress` and `decompress` are already brotli's -- every built-in
    // module declares into one scope, so two of them cannot own a word.
    //
    // **A LINE HERE IS GATED WHERE ITS SUBSYSTEM IS.** An `install_` function lives in the file that
    // implements it, so a feature that takes the file out takes the function with it and the call has
    // to go too -- which is what keeps this index honest rather than naming something that is not
    // there. `install_gzip` and `install_image` stay, miniz and stb being vendored.
#if feature_brotli
    install_brotli(env, everything)
#endif
    install_gzip(env, everything)
#if feature_zstd
    install_zstd(env, everything)
#endif
    install_image(env, everything)

    // The stores and the wire protocols a module written in slate stands on.
#if feature_lmdb
    install_lmdb(env, everything)
#endif
    install_sqlite(env, everything)
    install_http_parse(env, everything)
#if feature_http2
    install_h2(env, everything)
#endif
#if feature_redis
    install_redis(env, everything)
#endif

    // `slate:crypto`, which is the first module here whose caller is a PACKAGE: a package cannot have
    // a native, so anything installed with `slate add` that speaks a protocol with a challenge in it
    // had no digest at all and no randomness at all.
    install_crypto(env, everything)
    install_argon2(env, everything)

    // `slate:window`, which is the one subsystem here that is not on a socket or in a file: the
    // platform's own web view, pumped from a libuv timer so that a window is a guest on the loop the
    // program already had.
#if feature_webview
    install_window(env, everything)
#endif
end install_natives
