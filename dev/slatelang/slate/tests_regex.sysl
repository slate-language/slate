module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// Regular expressions: PCRE2 under the interpreter, `RegExp` under `slate js`, and the translation
// between them.
//
// **Its own file rather than a section of `tests_lang.sysl`, because the JavaScript half doubled
// it.** The language tests there are about what a construct MEANS; these are about two engines
// meaning the same thing, which is a subject of its own and is where the measurements live.
// `tests/js/p20.sl` is the differential corpus and this is what stands in front of it.

// -- regular expressions ------------------------------------------------------------------------

// **The five things POSIX cannot do**, which are the reason slate is on PCRE2 rather than on sysl's
// own `sysl.regex`. Under POSIX extended syntax `\d` is a literal `d`, so the first of these would
// compile and quietly match nothing -- which is exactly the failure a binding is supposed to make
// impossible.
@test
A_REGULAR_EXPRESSION_IS_PERLS_AND_NOT_POSIXS()
    val p = "val digits = regex(\"\\\\d+\")\n" +
        "print(digits.find(\"abc123\").text)\n" +
        "print(regex(\"<(.+?)>\").find(\"<a><b>\").text)\n" +
        "print(regex(\"foo(?=bar)\").test(\"foobar\"), regex(\"foo(?=bar)\").test(\"foobaz\"))\n" +
        "print(regex(\"(?<=\\\\$)\\\\d+\").find(\"costs $42\").text)\n" +
        "print(regex(\"(\\\\w)\\\\1\").find(\"hello\").text)\n" +
        "print(regex(\"(?:ab)+\").find(\"abab\").text)\n"

    assert_eq(rx_out(p), "123\n<a>\ntrue false\n42\nll\nabab")
end A_REGULAR_EXPRESSION_IS_PERLS_AND_NOT_POSIXS

// **A match reports CHARACTER positions, and PCRE2 answers in bytes.** Every offset that crosses the
// boundary is converted, and a subject with a two-byte character in front of the match is the
// shortest thing that tells a converted offset from a raw one: `é` is one character and two bytes,
// so a binding that passed PCRE2's number straight through says 3 where slate must say 2.
@test
A_MATCH_REPORTS_CHARACTERS_AND_NOT_BYTES()
    val p = "val m = regex(\"cd\").find(\"éxcd\")\n" +
        "print(m.start, m.end)\n" +
        "print(len(\"éxcd\"))\n"

    assert_eq(rx_out(p), "2 4\n4")
end A_MATCH_REPORTS_CHARACTERS_AND_NOT_BYTES

// The groups, by number and by name, and the difference between a group that took no part and one
// that matched the empty string.
@test
A_MATCH_CARRIES_ITS_GROUPS_BY_NUMBER_AND_BY_NAME()
    val p = "val m = regex(\"(\\\\d+)-(\\\\w+)\").find(\"xx 42-abc\")\n" +
        "print(m.text, m.groups[1], m.groups[2], len(m.groups))\n" +
        "val n = regex(\"(?<year>\\\\d{4})-(?<month>\\\\d{2})\").find(\"on 2026-08\")\n" +
        "print(n.named.year, n.named.month)\n" +
        "val e = regex(\"(a)|(b)\").find(\"b\")\n" +
        "print(e.groups[1], e.groups[2])\n" +
        "val z = regex(\"(a*)b\").find(\"b\")\n" +
        "print(z.groups[1] == \"\", z.groups[1] == null)\n"

    assert_eq(rx_out(p), "42-abc 42 abc 3\n2026 08\nnull b\ntrue false")
end A_MATCH_CARRIES_ITS_GROUPS_BY_NUMBER_AND_BY_NAME

// `findAll` and `split`, including the empty-match rule every engine has to settle: `a*` against
// `"bb"` finds three, one before each character and one at the end.
@test
FIND_ALL_FINDS_EVERY_MATCH_AND_SPLIT_TAKES_WHAT_IS_BETWEEN()
    val p = "print(regex(\"\\\\w+\").findAll(\"one two three\").map((m) -> m.text).join(\",\"))\n" +
        "print(len(regex(\"a*\").findAll(\"bb\")))\n" +
        "print(regex(\"\\\\s*,\\\\s*\").split(\"a, b ,c\").join(\"|\"))\n" +
        "print(len(regex(\"x\").findAll(\"abc\")))\n"

    assert_eq(rx_out(p), "one,two,three\n3\na|b|c\n0")
end FIND_ALL_FINDS_EVERY_MATCH_AND_SPLIT_TAKES_WHAT_IS_BETWEEN

// **`replace` REPLACES EVERY MATCH**, which is where slate parts company with JavaScript. There a
// bare `replace` changes the first occurrence only unless the pattern carries `/g`, which is why
// `replaceAll` had to be added to the language two decades later. Here the bare verb does the whole
// job and `replaceFirst` is the one that stops.
@test
REPLACE_REPLACES_EVERY_MATCH_AND_REPLACE_FIRST_STOPS()
    val p = "val re = regex(\"(\\\\w+)@(\\\\w+)\")\n" +
        "print(re.replace(\"a@b and c@d\", \"$2 at $1\"))\n" +
        "print(re.replaceFirst(\"a@b and c@d\", \"$2 at $1\"))\n" +
        "print(regex(\"(a)|(b)\").replace(\"b\", \"[$1$2]\"))\n"

    assert_eq(rx_out(p), "b at a and d at c\nb at a and c@d\n[b]")
end REPLACE_REPLACES_EVERY_MATCH_AND_REPLACE_FIRST_STOPS

// **A pattern carries no position, so asking twice answers twice the same.** A JavaScript `/g`
// pattern holds a mutable `lastIndex`, so `re.test(s)` called twice on one string is `true` then
// `false` -- the language's single most reported surprise, and one that only appears on the second
// call. There is no state here to have that bug in.
@test
A_REGULAR_EXPRESSION_CARRIES_NO_POSITION()
    val p = "val re = regex(\"a\")\n" +
        "print(re.test(\"banana\"), re.test(\"banana\"), re.test(\"banana\"))\n" +
        "print(len(re.findAll(\"banana\")), len(re.findAll(\"banana\")))\n"

    assert_eq(rx_out(p), "true true true\n3 3")
end A_REGULAR_EXPRESSION_CARRIES_NO_POSITION

// The flags a program may write, and what each one does. `$` is JavaScript's here -- the very end,
// rather than also the position before a final newline.
@test
THE_FLAGS_ARE_I_M_S_AND_X()
    val p = "print(regex(\"hello\", \"i\").test(\"Hello\"))\n" +
        "print(regex(\"^b\", \"m\").find(\"a\\nb\").start)\n" +
        "print(regex(\"a.b\", \"s\").test(\"a\\nb\"))\n" +
        "print(regex(\"foo$\").test(\"foo\\n\"), regex(\"foo$\").test(\"foo\"))\n" +
        "val re = regex(\"a\", \"im\")\n" +
        "print(re.pattern(), re.flags())\n"

    assert_eq(rx_out(p), "true\n2\ntrue\nfalse true\na im")
end THE_FLAGS_ARE_I_M_S_AND_X

// **Two regular expressions written the same way are the same one**, because the table is keyed by
// the pattern and its flags -- so one is compiled once however many times it is written. That is
// visible as equality, and it is the reason a slot needs no generation where a socket's does.
@test
AN_IDENTICAL_PATTERN_IS_COMPILED_ONCE()
    val p = "print(regex(\"a\") == regex(\"a\"), regex(\"a\") == regex(\"b\"), regex(\"a\") == regex(\"a\", \"i\"))\n" +
        "print(regex(\"a+\", \"i\"))\n" +
        "val t = {}\n" +
        "t[regex(\"a\")] = 1\n" +
        "print(t[regex(\"a\")])\n"

    assert_eq(rx_out(p), "true false false\n/a+/i\n1")
end AN_IDENTICAL_PATTERN_IS_COMPILED_ONCE

// -- what goes wrong ------------------------------------------------------------------------------

// **A pattern that will not compile is a fault where it is written**, naming the offset PCRE2
// stopped at rather than going wrong somewhere later.
@test
A_PATTERN_THAT_WILL_NOT_COMPILE_SAYS_SO_WHERE_IT_IS_WRITTEN()
    assert(rx_fails("regex(\"a(b\")\n").contains("not a regular expression"),
           "an unclosed group is refused")
    assert(rx_fails("regex(\"a(b\")\n").contains("at 3 in the pattern"),
           "and the message says where PCRE2 stopped")
end A_PATTERN_THAT_WILL_NOT_COMPILE_SAYS_SO_WHERE_IT_IS_WRITTEN

// **`g` is the flag people will reach for, so it is refused by name.** A flag silently ignored would
// make `replace` look like it had worked for the wrong reason.
@test
THERE_IS_NO_G_FLAG_AND_SAYING_SO_IS_THE_POINT()
    val g = rx_fails("regex(\"a\", \"g\")\n")

    assert(g.contains("there is no `g` flag"), "the g flag is refused by name")
    assert(g.contains("already replaces every match"), "and the message says what to do instead")

    assert(rx_fails("regex(\"a\", \"q\")\n").contains("is not a regular expression flag"),
           "and any other letter is refused too")
end THERE_IS_NO_G_FLAG_AND_SAYING_SO_IS_THE_POINT

// **A pattern that would backtrack forever gives up instead.** `(a+)+$` against a subject with no
// `b` is the standard demonstration; node has no limit at all, so a program there stops answering
// where this one raises a fault naming the pattern.
@test
A_PATHOLOGICAL_PATTERN_GIVES_UP_RATHER_THAN_RUNNING_ON()
    var subject = ""

    for i in 0..<40
        subject += "a"

    val p = s"print(regex(\"(a+)+$$\").test(\"${subject}b\"))\n"
    val complaint = rx_fails(p)

    assert(complaint.contains("gave up"), "the match gives up")
    assert(complaint.contains("backtracking"), "and says why")

    // The same pattern on a subject it matches is unaffected.
    assert_eq(rx_out("print(regex(\"(a+)+$\").test(\"aaaa\"))\n"), "true")
end A_PATHOLOGICAL_PATTERN_GIVES_UP_RATHER_THAN_RUNNING_ON

// The receiver's kind decides which `replace` a call reaches, so a string's and a regular
// expression's never collide -- and a name belonging to neither is refused naming the kind.
@test
A_REGEX_METHOD_IS_NOT_A_STRING_METHOD()
    assert_eq(rx_out("print(\"a-a\".replace(\"a\", \"b\"))\n"), "b-b")
    assert_eq(rx_out("print(regex(\"a\").replace(\"a-a\", \"b\"))\n"), "b-b")

    assert(rx_fails("print(regex(\"a\").upper())\n").contains("upper"),
           "a name a regular expression does not answer to is refused")
    assert(rx_fails("print(\"abc\".findAll(\"a\"))\n").contains("findAll"),
           "and so is one only a regular expression answers to")
end A_REGEX_METHOD_IS_NOT_A_STRING_METHOD

// The checker knows the kind, so a method a regular expression does not have is refused before the
// program runs -- and `regex` is an annotation a program may write.
@test
THE_CHECKER_KNOWS_WHAT_A_REGULAR_EXPRESSION_IS()
    assert(rx_fails("val re = regex(\"a\")\nprint(re.upper())\n").contains("upper"),
           "a bad method on a known regex is caught")

    assert_eq(rx_out("f(re: regex, s) = re.test(s)\nprint(f(regex(\"\\\\d\"), \"a1\"))\n"), "true")
    assert_eq(rx_out("print(regex(\"a\") is regex, \"a\" is regex)\n"), "true false")
end THE_CHECKER_KNOWS_WHAT_A_REGULAR_EXPRESSION_IS

// -- the same patterns in the JavaScript back end -------------------------------------------------

// **`findAll`'s count must equal the number of substitutions `replace` makes**, and the two walks
// are independent: one is `sh.sysl.pcre2`'s own loop over `find_at` and the other is PCRE2's
// `SUBSTITUTE_GLOBAL`. They came apart in pcre2 0.1.1 over a ZERO-WIDTH pattern -- the loop compared
// a match's end against where the SEARCH began rather than where the match was FOUND, so an empty
// match found ahead of the cursor was counted twice and `/$/` reported two matches in `"abc"`.
//
// **`a*` and `x?` were RIGHT throughout**, which is what made it invisible: they match at the cursor,
// so the two offsets agree. Only a pattern that can match AHEAD of where the search started shows it.
@test
FIND_ALL_COUNTS_WHAT_REPLACE_SUBSTITUTES_OVER_A_ZERO_WIDTH_PATTERN()
    val p = "zero(pat, subject)\n" +
        "    val re = regex(pat)\n" +
        "    var subs = 0\n" +
        "    for c in re.replace(subject, \"#\").chars()\n" +
        "        if c == \"#\" then subs += 1\n" +
        "    print(len(re.findAll(subject)), subs)\n" +
        "zero(\"$\", \"abc\")\n" +
        "zero(\"^\", \"abc\")\n" +
        "zero(\"\\\\b\", \"ab cd\")\n" +
        "zero(\"\\\\B\", \"ab\")\n" +
        "zero(\"a*\", \"bb\")\n" +
        "zero(\"x?\", \"ab\")\n" +
        "zero(\"\", \"abc\")\n" +
        "zero(\"(?=b)\", \"abcb\")\n"

    assert_eq(rx_out(p), "1 1\n1 1\n4 4\n1 1\n3 3\n3 3\n4 4\n2 2")
end FIND_ALL_COUNTS_WHAT_REPLACE_SUBSTITUTES_OVER_A_ZERO_WIDTH_PATTERN

// **A smoke test standing in front of `tests/js/p20.sl`**, which is where the translation is really
// pinned. What this one buys is a failure that NAMES regular expressions: a p20 diff says the two
// back ends disagree somewhere, and a reader arriving at a red suite wants to know first whether the
// thing runs at all.
@test
slate_regex_IS_IN_THE_JAVASCRIPT_BACK_END_AND_ANSWERS_WHAT_THE_INTERPRETER_ANSWERS()
    assert_eq(node_said(patterned("print(regex(\"(\\\\d+)-(\\\\w+)\").find(\"xx 42-abc\").groups[1])")), "42")
    assert_eq(node_said(patterned("print(regex(\"a\") == regex(\"a\"), regex(\"a+\", \"i\"))")), "true /a+/i")
    assert_eq(node_said(patterned("print(regex(\"(\\\\w+)@(\\\\w+)\").replace(\"a@b\", \"$2 at $1\"))")),
              "b at a")
end slate_regex_IS_IN_THE_JAVASCRIPT_BACK_END_AND_ANSWERS_WHAT_THE_INTERPRETER_ANSWERS

// **The three constructs both engines take while MEANING DIFFERENT THINGS**, which are the only ones
// a program could get wrong with nothing refusing it. Each is asserted on BOTH back ends, because a
// translation that quietly changed one would be exactly as invisible as no translation at all.
@test
A_CONSTRUCT_THE_TWO_ENGINES_READ_DIFFERENTLY_IS_TRANSLATED_RATHER_THAN_HANDED_OVER()
    // `\s` is the six ASCII spaces under PCRE2 and every Unicode space under `RegExp`.
    val space = "print(regex(\"\\\\s\").test(\"\\u{a0}\"), regex(\"[\\\\S]\").test(\"\\u{a0}\"))\n"

    assert_eq(rx_out(space), "false true")
    assert_eq(node_said(patterned(space)), "false true")

    // `.` excludes the newline under PCRE2 and three more characters under `RegExp`.
    val dot = "print(regex(\"a.b\").test(\"a\\rb\"), regex(\"a.b\").test(\"a\\nb\"))\n"

    assert_eq(rx_out(dot), "true false")
    assert_eq(node_said(patterned(dot)), "true false")

    // A line breaks at a newline under `m` and nowhere else.
    val line = "print(regex(\"^b\", \"m\").test(\"a\\rb\"), regex(\"^b\", \"m\").test(\"a\\nb\"))\n"

    assert_eq(rx_out(line), "false true")
    assert_eq(node_said(patterned(line)), "false true")
end A_CONSTRUCT_THE_TWO_ENGINES_READ_DIFFERENTLY_IS_TRANSLATED_RATHER_THAN_HANDED_OVER

// **A construct `RegExp` does not have at all is refused where the pattern is written, NAMING it.**
// These are not work owed: a browser's regular expressions have no atomic group and no recursion, so
// the refusal says what the host does not have rather than "not yet". The interpreter compiles all
// four, which is the point -- the two back ends differ and a program is told exactly where.
@test
A_REGEX_CONSTRUCT_A_JAVASCRIPT_HOST_DOES_NOT_HAVE_IS_REFUSED_NAMING_IT()
    refuses("(?>a*)b", "`(?>`", "an atomic group")
    refuses("a*+b", "`*+`", "a possessive quantifier")
    refuses("a\\\\Kb", "`\\K`", "resetting where a match started")
    refuses("(?|(a)|(b))", "`(?|`", "a branch reset")
    refuses("\\\\((?:[^()]|(?R))*\\\\)", "`(?R`", "recursion into a pattern")
    refuses("(a)?(?(1)b|c)", "`(?(`", "a conditional group")
    refuses("\\\\Xa", "`\\X`", "an extended grapheme cluster")
end A_REGEX_CONSTRUCT_A_JAVASCRIPT_HOST_DOES_NOT_HAVE_IS_REFUSED_NAMING_IT

// The refusal, and the fact that the INTERPRETER takes the same pattern -- so a test that only
// checked the message would pass against a back end refusing everything.
private refuses(pattern: string, named: string, why: string)
    val said = node_said(patterned(s"print(regex(\"${pattern}\"))\n"))

    assert(said.contains(named), s"the refusal names ${named}, and said: ${said}")
    assert(said.contains(why), s"the refusal says why, and said: ${said}")
    assert(said.contains("is not something a JavaScript host"), s"and says whose limit it is: ${said}")
    assert(!rx_fails(s"print(regex(\"${pattern}\"))\n").contains("not a regular expression"),
           s"and the interpreter compiles /${pattern}/")
end refuses

// **A lookbehind is the one place `RegExp` is the LOOSER engine, and both back ends refuse alike.**
// PCRE2 will not take one whose length is unlimited and `RegExp` will take anything, so a pattern
// refused by the interpreter would otherwise compile under `slate js` -- the same defect as the
// others wearing the other face. A BOUNDED one compiles on both, which is what says the scan is not
// simply refusing every lookbehind it sees.
@test
AN_UNBOUNDED_LOOKBEHIND_IS_REFUSED_BY_BOTH_BACK_ENDS()
    val loose = "print(regex(\"(?<=ab*)c\"))\n"

    assert(rx_fails(loose).contains("lookbehind"), "PCRE2 refuses it")
    assert(node_said(patterned(loose)).contains("lookbehind"), "and so does the JavaScript back end")

    val bounded = "print(regex(\"(?<=ab?)c\").test(\"abc\"), regex(\"(?<=a{2,3})c\").test(\"aac\"))\n"

    assert_eq(rx_out(bounded), "true true")
    assert_eq(node_said(patterned(bounded)), "true true")
end AN_UNBOUNDED_LOOKBEHIND_IS_REFUSED_BY_BOTH_BACK_ENDS

// The flags a program may write are refused in the same words on both back ends, `g` by name.
@test
THE_FLAG_REFUSALS_READ_THE_SAME_ON_BOTH_BACK_ENDS()
    val g = "print(regex(\"a\", \"g\"))\n"
    val q = "print(regex(\"a\", \"q\"))\n"

    assert(node_said(patterned(g)).contains("there is no `g` flag"), "the g flag is refused by name")
    assert(node_said(patterned(g)).contains("already replaces every match"), "and says what to do instead")
    assert(node_said(patterned(q)).contains("is not a regular expression flag"), "and so is any other letter")
    assert(rx_fails(g).contains("there is no `g` flag"), "which is what the interpreter says too")
end THE_FLAG_REFUSALS_READ_THE_SAME_ON_BOTH_BACK_ENDS
