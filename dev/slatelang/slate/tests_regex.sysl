module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// Regular expressions: `sh.sysl.libregexp` under the interpreter, `RegExp` under `slate js`, and the
// claim that the two are one dialect.
//
// **Its own file rather than a section of `tests_lang.sysl`, because the JavaScript half doubled
// it.** The language tests there are about what a construct MEANS; these are about two engines
// meaning the same thing, which is a subject of its own. `tests/js/p20.sl` is the differential
// corpus and this is what stands in front of it.
//
// **Every expected value here was produced by running `node`**, not recalled: the claim slate makes
// is that its regular expressions are ECMAScript's, so the oracle has to be an ECMAScript engine.

// -- regular expressions ------------------------------------------------------------------------

// **A REGULAR EXPRESSION HANDED TO A PARAMETER ANNOTATED `regex` WAS REFUSED**, and only where the
// pass was certain of both sides -- an annotated parameter passed on to another one, where a value
// straight from `regex()` is an imported name and therefore `Any`. `fits` asks `is_kind_of`, which
// knew the six scalar kinds and fell through to `false` for this one, so the complaint read
// *"`g` takes regex here, and this is regex"*.
@test
A_REGULAR_EXPRESSION_FITS_A_PARAMETER_THAT_ASKS_FOR_ONE()
    val p = "import { regex } from slate:regex\n\n" +
        "g(y: regex) = 2\n\nf(x: regex) = g(x)\n\nprint(f(regex(\"a\")))\n"

    assert_eq(out(p), "2")

// **The five things POSIX cannot do**, which are the reason slate binds an engine rather than using
// sysl's own `sysl.regex`. Under POSIX extended syntax `\d` is a literal `d`, so the first of these
// would compile and quietly match nothing -- which is exactly the failure a binding is supposed to
// make impossible.
@test
A_REGULAR_EXPRESSION_IS_ECMASCRIPTS_AND_NOT_POSIXS()
    val p = "val digits = regex(\"\\\\d+\")\n" +
        "print(digits.find(\"abc123\").text)\n" +
        "print(regex(\"<(.+?)>\").find(\"<a><b>\").text)\n" +
        "print(regex(\"foo(?=bar)\").test(\"foobar\"), regex(\"foo(?=bar)\").test(\"foobaz\"))\n" +
        "print(regex(\"(?<=\\\\$)\\\\d+\").find(\"costs $42\").text)\n" +
        "print(regex(\"(\\\\w)\\\\1\").find(\"hello\").text)\n" +
        "print(regex(\"(?:ab)+\").find(\"abab\").text)\n"

    assert_eq(rx_out(p), "123\n<a>\ntrue false\n42\nll\nabab")
end A_REGULAR_EXPRESSION_IS_ECMASCRIPTS_AND_NOT_POSIXS

// **A match reports CHARACTER positions, and the engine answers in bytes.** Every offset that
// crosses the boundary is converted, and a subject with a two-byte character in front of the match
// is the shortest thing that tells a converted offset from a raw one: `é` is one character and two
// bytes, so a binding that passed the engine's number straight through says 3 where slate must say
// 2.
@test
A_MATCH_REPORTS_CHARACTERS_AND_NOT_BYTES()
    val p = "val m = regex(\"cd\").find(\"éxcd\")\n" +
        "print(m.start, m.end)\n" +
        "print(\"éxcd\".length)\n"

    assert_eq(rx_out(p), "2 4\n4")
end A_MATCH_REPORTS_CHARACTERS_AND_NOT_BYTES

// The groups, by number and by name, and the difference between a group that took no part and one
// that matched the empty string.
@test
A_MATCH_CARRIES_ITS_GROUPS_BY_NUMBER_AND_BY_NAME()
    val p = "val m = regex(\"(\\\\d+)-(\\\\w+)\").find(\"xx 42-abc\")\n" +
        "print(m.text, m.groups[1], m.groups[2], m.groups.length)\n" +
        "val n = regex(\"(?<year>\\\\d{4})-(?<month>\\\\d{2})\").find(\"on 2026-08\")\n" +
        "print(n.named.year, n.named.month)\n" +
        "val e = regex(\"(a)|(b)\").find(\"b\")\n" +
        "print(e.groups[1], e.groups[2])\n" +
        "val z = regex(\"(a*)b\").find(\"b\")\n" +
        "print(z.groups[1] == \"\", z.groups[1] == null)\n"

    assert_eq(rx_out(p), "42-abc 42 abc 3\n2026 08\nnull b\ntrue false")
end A_MATCH_CARRIES_ITS_GROUPS_BY_NUMBER_AND_BY_NAME

// `findAll` and `split`, including the empty-match rule every engine has to settle: `a*` against
// `"bb"` finds three, one before each character and one at the end.
@test
FIND_ALL_FINDS_EVERY_MATCH_AND_SPLIT_TAKES_WHAT_IS_BETWEEN()
    val p = "print(regex(\"\\\\w+\").findAll(\"one two three\").map((m) -> m.text).join(\",\"))\n" +
        "print(regex(\"a*\").findAll(\"bb\").length)\n" +
        "print(regex(\"\\\\s*,\\\\s*\").split(\"a, b ,c\").join(\"|\"))\n" +
        "print(regex(\"x\").findAll(\"abc\").length)\n"

    assert_eq(rx_out(p), "one,two,three\n3\na|b|c\n0")
end FIND_ALL_FINDS_EVERY_MATCH_AND_SPLIT_TAKES_WHAT_IS_BETWEEN

// **`replace` REPLACES EVERY MATCH**, which is where slate parts company with JavaScript. There a
// bare `replace` changes the first occurrence only unless the pattern carries `/g`, which is why
// `replaceAll` had to be added to the language two decades later. Here the bare verb does the whole
// job and `replaceFirst` is the one that stops.
@test
REPLACE_REPLACES_EVERY_MATCH_AND_REPLACE_FIRST_STOPS()
    val p = "val re = regex(\"(\\\\w+)@(\\\\w+)\")\n" +
        "print(re.replace(\"a@b and c@d\", \"$2 at $1\"))\n" +
        "print(re.replaceFirst(\"a@b and c@d\", \"$2 at $1\"))\n" +
        "print(regex(\"(a)|(b)\").replace(\"b\", \"[$1$2]\"))\n"

    assert_eq(rx_out(p), "b at a and d at c\nb at a and c@d\n[b]")
end REPLACE_REPLACES_EVERY_MATCH_AND_REPLACE_FIRST_STOPS

// **THE REPLACEMENT TEXT IS ECMASCRIPT'S `GetSubstitution`, WORD FOR WORD.** It was PCRE2's while
// the dialect was Perl's -- `$0` and `$name` were the spellings and a lone `$` was an error -- so
// this is the one part of the surface whose meaning changed rather than merely widening. `$<name>` is the named
// group, ``$` `` and `$'` are what stands either side of the match, and **anything else after a `$`
// is literal text**, a `$9` in a pattern with one group included.
@test
THE_REPLACEMENT_TEXT_IS_ECMASCRIPTS()
    val p = "print(regex(\"(?<x>a)\").replace(\"a\", \"[$<x>]\"))\n" +
        "print(regex(\"b\").replace(\"abc\", \"[$&|$`|$']\"))\n" +
        "print(regex(\"a\").replace(\"a\", \"$$\"))\n" +
        "print(regex(\"(a)\").replace(\"a\", \"[$9][$0]\"))\n" +
        "print(regex(\"(?<x>a)\").replace(\"a\", \"[$<nope>]\"))\n" +
        "print(regex(\"(a)\").replace(\"a\", \"[$<nope>]\"))\n"

    assert_eq(rx_out(p), "[a]\na[b|a|c]c\n$\n[$9][$0]\n[]\n[$<nope>]")
end THE_REPLACEMENT_TEXT_IS_ECMASCRIPTS

// **A pattern carries no position, so asking twice answers twice the same.** A JavaScript `/g`
// pattern holds a mutable `lastIndex`, so `re.test(s)` called twice on one string is `true` then
// `false` -- the language's single most reported surprise, and one that only appears on the second
// call. There is no state here to have that bug in.
@test
A_REGULAR_EXPRESSION_CARRIES_NO_POSITION()
    val p = "val re = regex(\"a\")\n" +
        "print(re.test(\"banana\"), re.test(\"banana\"), re.test(\"banana\"))\n" +
        "print(re.findAll(\"banana\").length, re.findAll(\"banana\").length)\n"

    assert_eq(rx_out(p), "true true true\n3 3")
end A_REGULAR_EXPRESSION_CARRIES_NO_POSITION

// The flags a program may write, and what each one does. `$` without `m` is the very end, and `.`
// under `s` takes the newline -- both ECMAScript's, which is what they now are on both back ends.
@test
THE_FLAGS_ARE_I_M_S_AND_U()
    val p = "print(regex(\"hello\", \"i\").test(\"Hello\"))\n" +
        "print(regex(\"^b\", \"m\").find(\"a\\nb\").start)\n" +
        "print(regex(\"a.b\", \"s\").test(\"a\\nb\"), regex(\"a.b\").test(\"a\\nb\"))\n" +
        "print(regex(\"foo$\").test(\"foo\\n\"), regex(\"foo$\").test(\"foo\"))\n" +
        "val re = regex(\"a\", \"im\")\n" +
        "print(re.pattern(), re.flags())\n" +
        "print(regex(\"a\", \"u\").test(\"a\"), regex(\"a\", \"u\").flags())\n"

    assert_eq(rx_out(p), "true\n2\ntrue false\nfalse true\na im\ntrue u")
end THE_FLAGS_ARE_I_M_S_AND_U

// **`u` IS ALWAYS SET WHETHER OR NOT IT WAS WRITTEN, AND THAT IS WHAT MAKES AN OFFSET A CHARACTER.**
// Without it ECMAScript matches over UTF-16 code units, so `.` takes half of an emoji, `^.$` says
// one character is two and `\p{...}` is not a property escape at all but the literal letters. slate
// indexes a string by character everywhere else, so the two back ends set it and the flag a program
// writes is not the flag the engine is given.
@test
THE_U_FLAG_IS_ALWAYS_SET_SO_A_PROPERTY_ESCAPE_NEEDS_NO_FLAG()
    val p = "print(regex(\"\\\\p{L}+\").find(\"42abc!\").text)\n" +
        "print(regex(\"\\\\P{Nd}\").test(\"5\"), regex(\"\\\\P{Nd}\").test(\"x\"))\n" +
        "print(regex(\"^.$\").test(\"\\u{1f600}\"))\n" +
        "print(regex(\".\").findAll(\"\\u{1f600}x\").length)\n" +
        "val m = regex(\"cd\").find(\"\\u{1f600}xcd\")\n" +
        "print(m.start, m.end, \"\\u{1f600}xcd\".length)\n" +
        "print(regex(\"\\\\w\").find(\"\\u{1f600}ab\").start)\n"

    assert_eq(rx_out(p), "abc\nfalse true\ntrue\n2\n2 4 4\n1")
end THE_U_FLAG_IS_ALWAYS_SET_SO_A_PROPERTY_ESCAPE_NEEDS_NO_FLAG

// **Two regular expressions written the same way are the same one**, because the table is keyed by
// the pattern and its flags -- so one is compiled once however many times it is written. That is
// visible as equality, and it is the reason a slot needs no generation where a socket's does.
@test
AN_IDENTICAL_PATTERN_IS_COMPILED_ONCE()
    val p = "print(regex(\"a\") == regex(\"a\"), regex(\"a\") == regex(\"b\"), regex(\"a\") == regex(\"a\", \"i\"))\n" +
        "print(regex(\"a+\", \"i\"))\n" +
        "val t = {}\n" +
        "t[regex(\"a\")] = 1\n" +
        "print(t[regex(\"a\")])\n"

    assert_eq(rx_out(p), "true false false\n/a+/i\n1")
end AN_IDENTICAL_PATTERN_IS_COMPILED_ONCE

// -- what goes wrong ------------------------------------------------------------------------------

// **A pattern that will not compile is a fault where it is written**, carrying the engine's own
// complaint rather than going wrong somewhere later.
@test
A_PATTERN_THAT_WILL_NOT_COMPILE_SAYS_SO_WHERE_IT_IS_WRITTEN()
    assert(rx_fails("regex(\"a(b\")\n").contains("not a regular expression"),
           "an unclosed group is refused")
    assert(rx_fails("regex(\"a(b\")\n").contains("expecting ')'"),
           "and the engine's own words say what was wrong")
    assert(node_said(patterned("print(regex(\"a(b\"))\n")).contains("not a regular expression"),
           "and the JavaScript back end says the same")
end A_PATTERN_THAT_WILL_NOT_COMPILE_SAYS_SO_WHERE_IT_IS_WRITTEN

// **A CONSTRUCT THAT IS PERL'S AND NOT ECMASCRIPT'S IS REFUSED ON BOTH BACK ENDS**, which is the
// whole of what moving off PCRE2 changed about what a program may write. Every one of these
// compiled under the interpreter while the dialect was Perl's and was refused by the JavaScript
// back end naming the construct; now neither engine has it, so both refuse and the pattern means one
// thing wherever it is read.
@test
A_PATTERN_THAT_IS_PERLS_AND_NOT_ECMASCRIPTS_IS_REFUSED_ON_BOTH_BACK_ENDS()
    refuses("a*+b")
    refuses("(?>a*)b")
    refuses("a\\\\Kb")
    refuses("(?|(a)|(b))")
    refuses("(a)?(?(1)b|c)")
    refuses("\\\\Xa")
    refuses("\\\\Aa")
    refuses("a\\\\z")
    refuses("(?P<x>a)(?P=x)")
    refuses("(?i)a")
    refuses("\\\\h")
    refuses("[[:alpha:]]")
end A_PATTERN_THAT_IS_PERLS_AND_NOT_ECMASCRIPTS_IS_REFUSED_ON_BOTH_BACK_ENDS

// Refused where it is written, by both back ends. **The two messages are each engine's own and are
// deliberately not compared** -- what is asserted is that a pattern either engine cannot read is a
// fault rather than something that goes wrong later.
private refuses(pattern: string)
    assert(rx_fails(s"print(regex(\"${pattern}\"))\n").contains("not a regular expression"),
           s"the interpreter refuses /${pattern}/")
    assert(node_said(patterned(s"print(regex(\"${pattern}\"))\n")).contains("not a regular expression"),
           s"and so does the JavaScript back end: /${pattern}/")
end refuses

// **`g` is the flag people will reach for, so it is refused by name**, and `y` and `x` with it: a
// flag silently ignored would make `replace` look like it had worked for the wrong reason.
@test
THERE_IS_NO_G_FLAG_AND_SAYING_SO_IS_THE_POINT()
    val g = rx_fails("regex(\"a\", \"g\")\n")

    assert(g.contains("there is no `g` flag"), "the g flag is refused by name")
    assert(g.contains("already replaces every match"), "and the message says what to do instead")

    val y = rx_fails("regex(\"a\", \"y\")\n")

    assert(y.contains("there is no `y` flag"), "the sticky flag is refused by name")
    assert(y.contains("carries no position"), "and says why there is nothing for it to mean")

    val x = rx_fails("regex(\"a b\", \"x\")\n")

    assert(x.contains("there is no `x` flag"), "the extended flag is refused by name")
    assert(x.contains("ECMAScript has no extended mode"), "and says whose rule that is")

    assert(rx_fails("regex(\"a\", \"q\")\n").contains("is not a regular expression flag"),
           "and any other letter is refused too")
end THERE_IS_NO_G_FLAG_AND_SAYING_SO_IS_THE_POINT

// **A pattern that would backtrack forever gives up instead, AND THE FAULT IS CATCHABLE.** `(a+)+$`
// against a subject with no `b` is the standard demonstration; a JavaScript host has no limit at
// all, so a program there stops answering where this one raises a fault naming the pattern. Every
// match here runs under `sh.sysl.libregexp`'s default step budget, which is what an overrun is.
@test
A_PATHOLOGICAL_PATTERN_GIVES_UP_RATHER_THAN_RUNNING_ON()
    var subject = ""

    for i in 0..<40
        subject += "a"

    val p = s"print(regex(\"(a+)+$$\").test(\"${subject}b\"))\n"
    val complaint = rx_fails(p)

    assert(complaint.contains("gave up"), "the match gives up")
    assert(complaint.contains("backtracking"), "and says why")

    // **It is an ordinary fault, so a program can take it.** A server matching a pattern somebody
    // sent is the case this exists for, and it wants to answer 400 rather than stop.
    val caught = s"try\n    regex(\"(a+)+$$\").test(\"${subject}b\")\n" +
        "catch e\n    print(e.message.contains(\"backtracking\"))\n"

    assert_eq(rx_out(caught), "true")

    // The same pattern on a subject it matches is unaffected.
    assert_eq(rx_out("print(regex(\"(a+)+$\").test(\"aaaa\"))\n"), "true")
end A_PATHOLOGICAL_PATTERN_GIVES_UP_RATHER_THAN_RUNNING_ON

// The receiver's kind decides which `replace` a call reaches, so a string's and a regular
// expression's never collide -- and a name belonging to neither is refused naming the kind.
@test
A_REGEX_METHOD_IS_NOT_A_STRING_METHOD()
    assert_eq(rx_out("print(\"a-a\".replace(\"a\", \"b\"))\n"), "b-b")
    assert_eq(rx_out("print(regex(\"a\").replace(\"a-a\", \"b\"))\n"), "b-b")

    assert(rx_fails("print(regex(\"a\").upper())\n").contains("upper"),
           "a name a regular expression does not answer to is refused")
    assert(rx_fails("print(\"abc\".findAll(\"a\"))\n").contains("findAll"),
           "and so is one only a regular expression answers to")
end A_REGEX_METHOD_IS_NOT_A_STRING_METHOD

// The checker knows the kind, so a method a regular expression does not have is refused before the
// program runs -- and `regex` is an annotation a program may write.
@test
THE_CHECKER_KNOWS_WHAT_A_REGULAR_EXPRESSION_IS()
    assert(rx_fails("val re = regex(\"a\")\nprint(re.upper())\n").contains("upper"),
           "a bad method on a known regex is caught")

    assert_eq(rx_out("f(re: regex, s) = re.test(s)\nprint(f(regex(\"\\\\d\"), \"a1\"))\n"), "true")
    assert_eq(rx_out("print(regex(\"a\") is regex, \"a\" is regex)\n"), "true false")
end THE_CHECKER_KNOWS_WHAT_A_REGULAR_EXPRESSION_IS

// -- the same patterns in the JavaScript back end -------------------------------------------------

// **`findAll`'s count must equal the number of substitutions `replace` makes**, and the two walks
// are independent on both back ends: here `find_all`'s loop against `replace_all`'s, there this
// runtime's loop against the host's `String.prototype.replace`. They came apart once already, in
// pcre2 0.1.1, over a ZERO-WIDTH pattern -- the loop compared a match's end against where the SEARCH
// began rather than where the match was FOUND, so an empty match found ahead of the cursor was
// counted twice and `/$/` reported two matches in `"abc"`.
//
// **`a*` and `x?` were RIGHT throughout**, which is what made it invisible: they match at the cursor,
// so the two offsets agree. Only a pattern that can match AHEAD of where the search started shows it.
@test
FIND_ALL_COUNTS_WHAT_REPLACE_SUBSTITUTES_OVER_A_ZERO_WIDTH_PATTERN()
    val p = "zero(pat, subject)\n" +
        "    val re = regex(pat)\n" +
        "    var subs = 0\n" +
        "    for c in re.replace(subject, \"#\").chars()\n" +
        "        if c == \"#\" then subs += 1\n" +
        "    print(re.findAll(subject).length, subs)\n" +
        "zero(\"$\", \"abc\")\n" +
        "zero(\"^\", \"abc\")\n" +
        "zero(\"\\\\b\", \"ab cd\")\n" +
        "zero(\"\\\\B\", \"ab\")\n" +
        "zero(\"a*\", \"bb\")\n" +
        "zero(\"x?\", \"ab\")\n" +
        "zero(\"\", \"abc\")\n" +
        "zero(\"(?=b)\", \"abcb\")\n"

    assert_eq(rx_out(p), "1 1\n1 1\n4 4\n1 1\n3 3\n3 3\n4 4\n2 2")
end FIND_ALL_COUNTS_WHAT_REPLACE_SUBSTITUTES_OVER_A_ZERO_WIDTH_PATTERN

// **A smoke test standing in front of `tests/js/p20.sl`**, which is where the two engines are really
// pinned against each other. What this one buys is a failure that NAMES regular expressions: a p20
// diff says the two back ends disagree somewhere, and a reader arriving at a red suite wants to know
// first whether the thing runs at all.
@test
slate_regex_IS_IN_THE_JAVASCRIPT_BACK_END_AND_ANSWERS_WHAT_THE_INTERPRETER_ANSWERS()
    assert_eq(node_said(patterned("print(regex(\"(\\\\d+)-(\\\\w+)\").find(\"xx 42-abc\").groups[1])")), "42")
    assert_eq(node_said(patterned("print(regex(\"a\") == regex(\"a\"), regex(\"a+\", \"i\"))")), "true /a+/i")
    assert_eq(node_said(patterned("print(regex(\"(\\\\w+)@(\\\\w+)\").replace(\"a@b\", \"$2 at $1\"))")),
              "b at a")
end slate_regex_IS_IN_THE_JAVASCRIPT_BACK_END_AND_ANSWERS_WHAT_THE_INTERPRETER_ANSWERS

// **THE THREE CONSTRUCTS THAT USED TO MEAN DIFFERENT THINGS IN THE TWO ENGINES NOW MEAN ONE THING**,
// and they are the reason the dialect moved rather than the translator being extended. `\s` was the
// six ASCII spaces under PCRE2 and every Unicode space under `RegExp`; `.` excluded the newline
// there and three more characters here; `^` and `$` under `m` broke a line in different places. Each
// is asserted on BOTH back ends, because agreement is the whole claim.
@test
A_SET_AN_ANCHOR_AND_A_DOT_MEAN_ONE_THING_ON_BOTH_BACK_ENDS()
    // `\s` is every Unicode space, which is what ECMAScript says it is.
    val space = "print(regex(\"\\\\s\").test(\"\\u{a0}\"), regex(\"[\\\\S]\").test(\"\\u{a0}\"))\n"

    assert_eq(rx_out(space), "true false")
    assert_eq(node_said(patterned(space)), "true false")

    // `.` excludes the newline, the carriage return and the two Unicode line separators.
    val dot = "print(regex(\"a.b\").test(\"a\\rb\"), regex(\"a.b\").test(\"a\\u{2028}b\"))\n"

    assert_eq(rx_out(dot), "false false")
    assert_eq(node_said(patterned(dot)), "false false")

    // And a line under `m` breaks at every one of them.
    val line = "print(regex(\"^b\", \"m\").test(\"a\\rb\"), regex(\"^b\", \"m\").test(\"a\\u{2028}b\"))\n"

    assert_eq(rx_out(line), "true true")
    assert_eq(node_said(patterned(line)), "true true")
end A_SET_AN_ANCHOR_AND_A_DOT_MEAN_ONE_THING_ON_BOTH_BACK_ENDS

// A subject that is not ASCII reports the same character positions on both back ends, which is two
// different conversions agreeing: byte offsets into characters in the interpreter, UTF-16 code units
// into characters under `slate js`.
@test
A_NON_ASCII_SUBJECT_REPORTS_THE_SAME_POSITIONS_ON_BOTH_BACK_ENDS()
    val p = "val m = regex(\"cd\").find(\"\\u{1f600}xcd\")\n" +
        "print(m.start, m.end, regex(\".\").findAll(\"\\u{1f600}x\").length)\n"

    assert_eq(rx_out(p), "2 4 2")
    assert_eq(node_said(patterned(p)), "2 4 2")
end A_NON_ASCII_SUBJECT_REPORTS_THE_SAME_POSITIONS_ON_BOTH_BACK_ENDS

// **A LOOKBEHIND OF ANY LENGTH IS TAKEN NOW, AND A SCOPED MODIFIER WITH IT**, which is the other
// direction of the same change: PCRE2 refused a lookbehind whose length was unlimited, so the
// JavaScript back end had to scan for one and refuse it too in order to agree. ECMAScript takes
// every lookbehind and has `(?i:…)`, so both back ends simply compile these.
@test
AN_UNBOUNDED_LOOKBEHIND_AND_A_SCOPED_MODIFIER_ARE_TAKEN_BY_BOTH_BACK_ENDS()
    val p = "print(regex(\"(?<=ab*)c\").test(\"abbc\"), regex(\"(?i:a)b\").test(\"Ab\"))\n"

    assert_eq(rx_out(p), "true true")
    assert_eq(node_said(patterned(p)), "true true")
end AN_UNBOUNDED_LOOKBEHIND_AND_A_SCOPED_MODIFIER_ARE_TAKEN_BY_BOTH_BACK_ENDS

// The flags a program may write are refused in the same words on both back ends, `g` by name.
@test
THE_FLAG_REFUSALS_READ_THE_SAME_ON_BOTH_BACK_ENDS()
    val g = "print(regex(\"a\", \"g\"))\n"
    val y = "print(regex(\"a\", \"y\"))\n"
    val q = "print(regex(\"a\", \"q\"))\n"

    assert(node_said(patterned(g)).contains("there is no `g` flag"), "the g flag is refused by name")
    assert(node_said(patterned(g)).contains("already replaces every match"), "and says what to do instead")
    assert(node_said(patterned(y)).contains("there is no `y` flag"), "and so is the sticky flag")
    assert(node_said(patterned(q)).contains("is not a regular expression flag"), "and so is any other letter")
    assert(rx_fails(g).contains("there is no `g` flag"), "which is what the interpreter says too")
end THE_FLAG_REFUSALS_READ_THE_SAME_ON_BOTH_BACK_ENDS
