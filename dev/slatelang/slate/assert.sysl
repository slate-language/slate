module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// What a test is written with: `assert`, `assertEq`, `assertFaults` and `skip`.
//
// **Cut out of `builtin.sysl` when that file passed a thousand lines**, on the section heading that
// was already there. Four names cross -- the four `do_*` below, which `dispatch_native` reaches --
// and the seam earns them: every other builtin answers a value, and these four decide whether a
// test PASSED, which is a different question and the only one that reads `skip_asked`.
//
// **The runner is `run.sysl` and the JavaScript half is `js_rt_builtins.sysl`**, which says the same
// sentences word for word; a change here is a change there.

// -- what a test is written with -------------------------------------------------------------------

// `assert(condition)` and `assert(condition, message)`.
//
// **A failed assertion raises**, which is what makes the runner's job three lines: it calls the test
// and reads the `Err`, and the fault already carries the line and the file it was raised at.
// Not `private`: `dispatch_native` in `builtin.sysl` reaches it for `NAssert`.
do_assert(args: Buf[Value], at: Span) -> Step
    if args.len() == 0 || args.len() > 2
        return fault(at, s"`assert` takes a condition and an optional message, and was given ${counted(args.len(), "argument")}")

    if args.at(0).truthy() then return Ok(Null)

    if args.len() == 2
        return fault(at, printed(args.at(1), at)?)

    fault(at, "this assertion does not hold")
end do_assert

// `skip(reason)` -- this test is not going to run here, and why.
//
// **It raises, which is `assert`'s design and matters more here.** A `skip` that merely recorded
// something would leave the rest of the test running, so every use of it would be `skip(...)` and a
// `return` on the next line -- and the day somebody forgets the `return` the test runs on a host it
// was written to be left out of and fails there for a reason nobody can read.
//
// **A reason is required.** A test left out with nothing said is one nobody ever puts back.
// Not `private`: `dispatch_native` in `builtin.sysl` reaches it for `NSkip`.
do_skip(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`skip` takes the reason this test is being left out, and was given ${counted(args.len(), "argument")}")

    args.at(0) match
        Str(p) ->
            skip_asked = true
            skip_reason = p.s
            skipped(at, p.s)
        other -> fault(at, s"`skip` takes a reason as text, and this is ${other.type_name()}")
end do_skip

// `assertEq(actual, expected)`.
//
// **Both sides are rendered into the message**, because the commonest thing a reader needs from a
// failed comparison is what the two were -- and a test that had to print them itself would be a test
// written twice.
// Not `private`: `dispatch_native` in `builtin.sysl` reaches it for `NAssertEq`.
do_assert_eq(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 && args.len() != 3
        return fault(at, s"`assertEq` takes what was got, what was wanted, and an optional message -- it was given ${counted(args.len(), "argument")}")

    if same(args.at(0), args.at(1), at)? then return Ok(Null)

    val said = if args.len() == 3 then s"${value_text(args.at(2))}: " else ""

    fault(at, s"${said}got ${show_value(args.at(0))}, wanted ${show_value(args.at(1))}")
end do_assert_eq

// `assertFaults(fn)` and `assertFaults(fn, message)` -- the call is supposed to raise.
//
// **The only assertion that cannot be written as a condition.** A fault leaves the test rather than
// answering false, so without this the shape is a `try` whose body ends in a complaint -- and a
// `try` that forgets that last line is a test which passes whatever the call does.
//
// **An `async` function's fault arrives a turn later, so this answers a PROMISE where it was given
// one** and the test awaits it. Reading the promise where it was answered would call every
// asynchronous fault a value; `FaultWatch` in `async.sysl` is the other half.
//
// **A `skip` and an `exit` travel straight through.** Neither is a fault the call was asked for: a
// skip is the test's whole verdict and `exit` is refused by the runner, and swallowing either here
// would take that decision away from the place that owns it.
// Not `private`: `dispatch_native` in `builtin.sysl` reaches it for `NAssertFaults`.
do_assert_faults(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 && args.len() != 2
        return fault(at, s"`assertFaults` takes a function of no arguments and an optional part of the message, and was given ${counted(args.len(), "argument")}")

    var wanted = ""

    if args.len() == 2
        args.at(1) match
            Str(p) -> wanted = p.s
            other -> return fault(at, s"`assertFaults` takes the part of the message it is looking for as text, and this is ${other.type_name()}")
    end if

    var none: Buf[Value] = buf()

    apply_callback(args.at(0), none, at, "assertFaults") match
        Err(Fail(_, _, m)) ->
            if wanted != "" && !m.contains(wanted)
                return fault(at, s"the fault said \"${m}\", wanted it to contain \"${wanted}\"")

            Ok(Null)
        Err(sig) -> Err(sig)
        Ok(v) -> v match
            Promise(pr) -> watched_fault(v, pr, wanted, at)
            other -> fault(at, s"expected a fault, got a value: ${show_value(other)}")
end do_assert_faults

// The promise the test awaits, watching the one the call answered.
private watched_fault(v: Value, pr: *PromiseObj, wanted: string, at: Span) -> Step
    val mark = root_mark()

    hold(v)

    val out = new_promise()

    hold(Promise(out))
    watch_for_fault(pr, out, wanted, at)
    release(mark)
    Ok(Promise(out))
end watched_fault
