module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.from_utf8_unchecked

// `from_utf8_unchecked` is imported because it is an ordinary `sysl.text` function as of 0.0.82 --
// it was one of the compiler's special forms, in scope everywhere, until then. Every lexeme here
// came out of a `Source` the lexer already walked, so the bytes are known well formed and there is
// nothing left to validate.

// Tokens to a tree.
//
// Recursive descent for the statements, and `sh.sysl.parsing`'s binding-power loop for the
// expressions -- which is the split nearly every hand-written front end takes, because statement
// forms are told apart by their first word and expressions are not.
//
// **The `TokenStream` the loop runs on is this parser, not its token cursor.** The package's own
// note says why it matters: a `led` callback is handed the `*S` it was called with, so making `S`
// the parser is what lets a callback reach the report and the source text. A grammar that made `S`
// the bare cursor would have callbacks that can read tokens and cannot complain about them.

// Everything the grammar needs in one place, so that a bare-arrow callback reaches all of it.
struct Parser
    toks: Tokens[Tok]
    src: Source
    report: Report

    // The definitions written under `@test`, in the order they were written.
    tests: Buf[string]

    // The types this file declared, in the order they were written.
    type_names: Buf[string]
    type_pats: Buf[Pattern]
    type_public: Buf[bool]

    // The names this file lets other files see, in the order they were written.
    //
    // **Gathered here rather than left in the tree.** `export` prefixes an ordinary binding or
    // definition and changes nothing about it, so the word adds a name to this list and hands the
    // statement on unchanged -- which is why `StmtKind` has no `Export`.
    exports: Buf[string]

    // How many `yield`s have been read since the body being parsed began.
    //
    // **Saved and restored around every body**, so a `yield` inside a lambda makes the lambda a
    // generator and not the definition it is written in. That is the whole of how a generator is
    // told from an ordinary function; there is no word on the definition to read.
    yields: usize

    // How many blocks deep the statement being read is.
    //
    // **`export` and `import` belong to a file and not to a block**, which is a rule the grammar has
    // to keep rather than the loader: a module's exports are known before it runs, and a name
    // exported from inside an `if` would not be. Zero is the top level of the file.
    depth: usize

    // The kind of the next token. `Eof` where there is none, so that no caller unwraps.
    peek(self) -> Tok = self.toks.peek() match
        Some(t) -> t.value
        None -> Eof

    // The kind of the token `n` further on, for the one lookahead slate's grammar needs.
    peek_kind_at(self, n: usize) -> Tok = self.toks.peek_at(n) match
        Some(t) -> t.value
        None -> Eof

    // The kind of the token just taken, which is what says whether a block has only now closed.
    prev(self) -> Tok
        if self.toks.position == 0 then return Eof

        self.toks.items.at(self.toks.position - 1).value
    end prev

    // Where the next token is.
    here(self) -> Span = self.toks.here()

    // Where the token just taken was.
    just_taken(self) -> Span = self.toks.previous()

    at(self, k: Tok) -> bool = self.peek() == k

    // Take the next token, whatever it is.
    bump(*self)
        self.toks.advance()

    // Take the next token if it is this one.
    accept(*self, k: Tok) -> bool
        if self.peek() != k then return false

        self.toks.advance()
        true
    end accept

    // Take the next token, complaining if it is not the one wanted.
    //
    // The complaint names what was wanted and quotes what was found, which is the shape
    // `expected`/`found_at` build and is why they are reached for rather than composed by hand.
    expect(*self, k: Tok, want: string) -> bool
        if self.accept(k) then return true

        val at = self.here()

        self.report.add(expected(at, want, self.found(at)))
        false
    end expect

    // What is at the cursor, as the `found ...` half of a complaint.
    //
    // A structural token has no text to quote -- the whole point of `Indent` is that it stands for
    // whitespace -- so it is named rather than shown.
    //
    // **The word "found" is NOT part of what this answers.** `expected` writes it, so a string here
    // that began with it rendered as *"found found the end of the line"*. `found_at`, which the last
    // arm hands back, is likewise a bare quoted lexeme.
    found(self, at: Span) -> string
        self.peek() match
            Eof -> "the end of the file"
            Newline -> "the end of the line"
            Indent -> "an indented block"
            Dedent -> "the end of a block"
            _ -> found_at(self.src, at)
    end found

    // Say something is wrong, and keep going.
    fault(*self, at: Span, message: string)
        self.report.add(error(at, message))

    // The text a token was written as.
    text(self, at: Span) -> string = from_utf8_unchecked(self.src.text(at))

    // The text of the token `n` further on, for a soft word that is only a keyword where one follows.
    text_at(self, n: usize) -> string = self.toks.peek_at(n) match
        Some(t) -> self.text(t.span)
        None -> ""

    // Whether the statement just parsed has ended.
    //
    // **A block closing ends the statement that contained it**, which is the case that is easy to
    // leave out: `if c` with an indented body is followed by a `Dedent` and by no `Newline`, the
    // newline having been spent inside the block. Without this an `if` statement and the line under
    // it would read as two statements on one line.
    end_of_statement(*self) -> bool
        if self.accept(Newline) then return true

        self.prev() == Dedent || self.at(Dedent) || self.at(Eof)
    end end_of_statement

    // Skip over newlines. Used where a construct spans lines but its parts are not statements.
    skip_newlines(*self)
        loop
            if !self.accept(Newline) then break
end Parser

impl TokenStream for Parser
    type Token = Spanned[Tok]

    look(self) -> Option[Spanned[Tok]] = self.toks.peek()

    take(*self) -> Option[Spanned[Tok]] = self.toks.advance()

// -- entry point --------------------------------------------------------------------------------

// What reading a whole file answers with.
struct Parsed
    program: Program
    report: Report

    ok(self) -> bool = !self.report.has_errors()
end Parsed

// Read a source into a tree.
//
// **The lexer's complaints and the parser's arrive together.** A file whose literal is malformed
// still has a shape, and reporting the shape's mistakes in the same pass is what stops a second run
// from being needed.
parse(src: Source) -> Parsed
    clear_bodies()
    parse_source(src)

// The same, over a file that is one of several.
//
// **It does NOT clear the body table, and that is the whole difference.** Bodies are interned into
// one table shared by the run, and a `Lambda` or a `Def` names one by its index there -- so a second
// file clearing the table would leave the first file's functions pointing at somebody else's code.
// `load_program` clears once, before it reads anything.
parse_source(src: Source) -> Parsed
    val lexed = lex(src)
    var p = Parser(lexed.tokens, src, lexed.report, buf(), buf(), buf(), buf(), buf(), 0, 0)
    val stmts = parse_stmts(&p, false)

    Parsed(Program(stmts, p.exports, p.type_names, p.type_pats, p.type_public, p.tests), p.report)
end parse_source

// A run of statements, to the end of the file or to the close of the block they are in.
//
// Not `private`: `define.sysl` parses a body, and a body is made of statements.
parse_stmts(p: *Parser, in_block: bool) -> Buf[Stmt]
    var stmts: Buf[Stmt] = buf()

    p.skip_newlines()

    loop
        if p.at(Eof) then break
        if in_block && p.at(Dedent) then break

        stmts.push(parse_stmt(p))

        if !p.end_of_statement()
            // The statement did not end where one has to. Say so once, then step past whatever is
            // there, so that the loop cannot spin on a token nothing consumes.
            p.fault(p.here(), "this is where the statement should have ended")
            p.bump()
        end if

        p.skip_newlines()
    end loop

    stmts
end parse_stmts

// -- statements ---------------------------------------------------------------------------------

// Not `private`: reached from `define.sysl`, a one-line body being a statement.
parse_stmt(p: *Parser) -> Stmt
    p.peek() match
        At -> parse_annotated(p)
        Import -> parse_import(p)
        Export -> parse_export(p)
        Val -> parse_binding(p, true)
        Var -> parse_binding(p, false)
        Return -> parse_return(p)
        Throw -> parse_throw(p)
        Break -> parse_break(p)
        Continue -> parse_continue(p)

        // **The loops are not here, because they are expressions**: `while`, `for`, `loop`, `do` and
        // the label one of them may carry all begin one, so they reach `nud` through
        // `parse_expr_stmt` like any other value.
        // **`async` is not on its own a definition.** `async f(x) = ...` defines one and
        // `async x -> x` is an expression, so the same shape check runs one token further along.
        Async ->
            if at_definition_from(p, 1) then parse_def(p) else parse_expr_stmt(p)
        _ ->
            if at_type_decl(p, 0) then parse_type_decl(p, false)
            elif at_class_decl(p, 0) then parse_class_decl(p, false)
            elif at_definition_from(p, 0) then parse_def(p)
            else parse_expr_stmt(p)
end parse_stmt

// Whether what stands at `i` is `type Name =`.
//
// **`type` is a SOFT word**, so a program may still call a variable `type`. Three tokens settle it
// and the parser has the cursor, which is the same test `end` gets and for the same reason.
private at_type_decl(p: *Parser, i: usize) -> bool
    if p.peek_kind_at(i) != Ident then return false
    if p.text_at(i) != "type" then return false
    if p.peek_kind_at(i + 1) != Ident then return false

    p.peek_kind_at(i + 2) == Assign
end at_type_decl

// `type Point = { x: num, y: num }`.
//
// **The right-hand side is an ordinary PATTERN**, read by the parser that reads a `match` arm's. That
// is the whole design: slate already had structural tests over object shapes, and a type is one of
// those given a name -- so `p is Point` is the `is` slate already had, and nothing new runs.
private parse_type_decl(p: *Parser, public: bool) -> Stmt
    val start = p.here()

    p.bump()

    val name = parse_name(p, "a name for the type")

    p.expect(Assign, "`=` and the shape the type stands for")

    val pat = parse_pattern(p)

    if p.depth != 0
        p.fault(start, "a type belongs to the top level of a file -- it is resolved while compiling, and one declared inside a block would not be there to resolve against")
    else
        p.type_names.push(name)
        p.type_pats.push(pat)
        p.type_public.push(public)

    stmt(start.to(p.just_taken()), TypeDecl(name, pat))
end parse_type_decl

// `val name = ...` and `var name = ...`.
// `val x = e`, and `val [a, b] = e` / `val { name } = e` where the value is taken apart.
//
// **The first token after the word decides, and nothing else does.** A `[` or a `{` can begin no
// name, so the two forms cannot be confused -- and reading a *pattern* in every case would change
// what an ordinary binding means: a bare name in pattern position is a type test where it names a
// type, so `val string = 5` would stop binding `string` and start testing against it. Keeping the
// plain case a name is what makes the feature free.
private parse_binding(p: *Parser, immutable: bool) -> Stmt
    val start = p.here()

    p.bump()

    if p.at(LBracket) || p.at(LBrace)
        val pat = parse_pattern(p)

        p.expect(Assign, "`=` and a value")

        val opened = parse_body(p)

        return stmt(start.to(p.just_taken()), Unpack(pat, opened, immutable))
    end if

    val name = parse_name(p, "a name for the binding")

    p.expect(Assign, "`=` and a value")

    val init = parse_body(p)

    stmt(start.to(p.just_taken()), if immutable then Val(name, init) else Var(name, init))
end parse_binding

// -- modules -------------------------------------------------------------------------------------

// `export` in front of a binding or a definition.
//
// **The word adds a name to the file's export list and changes nothing else**, which is why there is
// no `Export` node: the statement it prefixes is parsed by the very function that would have parsed
// it without the word, and compiles identically. What the export list is *for* is the object built
// at the end of the module's chunk, and that is the only place it is read.
//
// TypeScript's rule, taken deliberately: a name is private unless it says otherwise. The other
// direction -- everything public, with a way to hide -- is the one that cannot be changed later
// without breaking every program that relied on reaching in.
private parse_export(p: *Parser) -> Stmt
    val start = p.here()
    val top = p.depth == 0

    p.bump()

    if !top
        p.fault(start, "`export` belongs to the top level of a file -- what a module lets others see has to be known before it runs, and a name exported from inside a block would not be")

    // **`export type` is how a type crosses a file**, and it reads the same way every other export
    // does. A type that is not exported is this file's own, exactly as a `val` is.
    if at_type_decl(p, 0) then return parse_type_decl(p, top)

    // **`export class` exports the name once and it lands in two places**, because a class is two
    // things under one name: a value other files may reach, and a type other files may test against.
    // `parse_class_decl` writes the type half, so only the value half is left here.
    if at_class_decl(p, 0)
        val c = parse_class_decl(p, top)

        if top
            *c.kind match
                Val(name, _) -> p.exports.push(name)
                _ -> ()

        return c
    end if

    val s = p.peek() match
        Val -> parse_binding(p, true)
        Var -> parse_binding(p, false)

        // `export async f(x) = ...`. The shape check runs one token further along, exactly as
        // `parse_stmt`'s does, because `async` alone does not make a definition.
        Async -> if at_definition_from(p, 1) then parse_def(p) else bad_export(p, start)
        _ -> if at_definition_from(p, 0) then parse_def(p) else bad_export(p, start)

    if top
        *s.kind match
            Val(name, _) -> p.exports.push(name)
            Var(name, _) -> p.exports.push(name)
            Def(name, _, _, _, _) -> p.exports.push(name)
            _ -> ()

    s
end parse_export

// `export` in front of something that has no name to export.
private bad_export(p: *Parser, at: Span) -> Stmt
    p.fault(at, "`export` goes in front of a `val`, a `var` or a definition, and there is nothing here for it to name")
    parse_expr_stmt(p)

// `@test` in front of a definition.
//
// **The annotation adds a name to the file's test list and changes nothing else**, which is the same
// arrangement `export` has and for the same reason: the function it marks compiles exactly as it
// would have without it, so `StmtKind` needs nothing new.
//
// **`@` begins nothing else at the start of a statement.** It is a pattern operator, which is only
// ever read with a subject already to its left, so taking it here costs the grammar nothing.
private parse_annotated(p: *Parser) -> Stmt
    val start = p.here()
    val top = p.depth == 0

    p.bump()

    val word = parse_name(p, "an annotation name")

    if word != "test"
        p.fault(start.to(p.just_taken()), s"`@${word}` is not an annotation slate knows -- `@test` is the only one")

    if !top
        p.fault(start, "`@test` belongs to the top level of a file -- a test is found before the program runs, and one written inside a block would not be")

    // The annotation is written on its own line, as sysl's is.
    p.skip_newlines()

    val at_def = p.at(Async) && at_definition_from(p, 1) || at_definition_from(p, 0)

    if !at_def
        p.fault(p.here(), "`@test` goes in front of a definition -- a test is a function of no arguments")
        return parse_expr_stmt(p)
    end if

    val s = parse_def(p)

    if top && word == "test"
        *s.kind match
            Def(name, params, _, _, _) ->
                if params.len() != 0
                    p.fault(s.span, s"a test takes no arguments, and `${name}` takes ${params.len()}")

                p.tests.push(name)
            _ -> ()

    s
end parse_annotated

// `import { a, b as c } from "./util.sl"`, and `import * as util from "./util.sl"`.
//
// **No default export.** It is the part of TypeScript's module system its own users regret: a
// default has no name, so every importer invents one and the same thing is called four things
// across a codebase. Everything here is named where it is written and named again where it is read.
private parse_import(p: *Parser) -> Stmt
    val start = p.here()

    p.bump()

    if p.depth != 0
        p.fault(start, "`import` belongs to the top level of a file -- what a file depends on is worked out before it runs, so an import inside a block would have nothing to say")

    if p.accept(Star)
        expect_soft(p, "as")

        val alias = parse_name(p, "a name for the module")

        expect_soft(p, "from")

        val (path, path_at, origin) = parse_module_path(p)

        return stmt(start.to(p.just_taken()), ImportAll(path, path_at, origin, alias))
    end if

    var names: Buf[string] = buf()
    var locals: Buf[string] = buf()

    p.expect(LBrace, "`{` or `*`")

    if !p.at(RBrace)
        loop
            val n = parse_name(p, "an exported name")

            names.push(n)
            locals.push(if accept_soft(p, "as") then parse_name(p, "a name to call it here") else n)

            if !p.accept(Comma) then break
            if p.at(RBrace) then break
    end if

    p.expect(RBrace, "`}`")
    expect_soft(p, "from")

    val (path, path_at, origin) = parse_module_path(p)

    stmt(start.to(p.just_taken()), ImportNames(path, path_at, origin, names, locals))
end parse_import

// What an import names: a quoted path to a file, a bare word naming a package, or `slate:name` for
// one of slate's own.
//
// **THREE SYNTAXES RATHER THAN THREE READINGS OF ONE STRING.** Nothing already written changes
// meaning when a kind is added, and no reader has to work out whether a leading `./` was optional or
// whether a bare word is a package this time. `\"parsing\"` in quotes stays a file that does not
// exist, and a package may be called `http` without ever being confused for `slate:http` -- which is
// the ambiguity node shipped without and introduced the `node:` prefix to fix.
//
// **The colon form is bare where node's is quoted.** node writes `'node:http'` because every
// specifier there is a string and the prefix is what separates the two kinds *within* that one
// syntax; here a quoted path already means a file, so the prefix has to live outside the quotes. It
// costs the lexer nothing: `slate`, `:` and the name are three tokens slate already had.
//
// **The span is kept because every complaint about what was named is about this span** -- it cannot
// be read, it is not there, it closes a cycle, nothing depends on it -- and those are reported long
// after the token is gone.
private parse_module_path(p: *Parser) -> (string, Span, Origin) 
    val at = p.here()

    if p.at(Ident)
        val first = parse_name(p, "a package name")

        if !p.accept(Colon) then return (first, at, Origin.FromPackage)

        val name = parse_name(p, "the name of one of slate's own modules")
        val whole = at.to(p.just_taken())

        // **The family is named rather than assumed.** `node:` is the prefix a reader arriving from
        // node will try first, and answering "no such module" about the part after the colon would
        // send them to look for a module that is not the problem.
        if first != BuiltinNamespace
            p.fault(whole, s"`${first}:` names no family of modules -- slate's own are written `${BuiltinNamespace}:${name}`")

        return (name, whole, Origin.FromSlate)
    end if

    if !p.at(StrLit)
        p.report.add(expected(at, "a quoted path like `\"./util.sl\"`, a package name, or `slate:time`", p.found(at)))
        return ("", at, Origin.FromFile)

    p.bump()
    (read_str_at(p, at), at, Origin.FromFile)
end parse_module_path

// `from` and `as`, which are words only here.
//
// **Soft, where `import` and `export` are hard.** Both are read at a point where the parser already
// knows what it is looking for, so nothing has to be decided from the word alone -- and taking them
// as keywords would cost every program two perfectly ordinary names.
private accept_soft(p: *Parser, word: string) -> bool
    if !p.at(Ident) then return false
    if p.text(p.here()) != word then return false

    p.bump()
    true
end accept_soft

private expect_soft(p: *Parser, word: string) -> bool
    if accept_soft(p, word) then return true

    val at = p.here()

    p.report.add(expected(at, s"`${word}`", p.found(at)))
    false
end expect_soft

// `return`, with or without a value.
//
// **A bare `return` is told from one with a value by what follows it**, and slate needs no rule of
// its own for that: an expression cannot begin with a newline or with the end of a block, which is
// exactly what `starts_expr` answers.
private parse_return(p: *Parser) -> Stmt
    val start = p.here()

    p.bump()

    val value = if starts_expr(p.peek()) then Some(parse_expr(p)) else None

    stmt(start.to(p.just_taken()), Return(value))
end parse_return

// `throw v`.
//
// **The value is not optional**, so this needs none of `parse_return`'s reasoning about what may
// follow: a `throw` with nothing after it is a mistake, and saying so where it was written is better
// than raising a fault with nothing in it.
private parse_throw(p: *Parser) -> Stmt
    val start = p.here()

    p.bump()

    val value = parse_expr(p)

    stmt(start.to(p.just_taken()), Throw(value))
end parse_throw

// `break`, `break 'outer`, `break v`, and `break 'outer v`.
//
// A bare one is told from one with a value by what follows, exactly as `return` is: an expression
// cannot begin with a newline or with the end of a block.
private parse_break(p: *Parser) -> Stmt
    val start = p.here()

    p.bump()

    val label = accept_label(p)
    val value = if starts_expr(p.peek()) then Some(parse_expr(p)) else None

    stmt(start.to(p.just_taken()), StmtKind.Break(label, value))
end parse_break

private parse_continue(p: *Parser) -> Stmt
    val start = p.here()

    p.bump()

    stmt(start.to(p.just_taken()), StmtKind.Continue(accept_label(p)))

// The name a `break` or a `continue` gave, or the empty string for the innermost loop.
private accept_label(p: *Parser) -> string
    if !p.at(Label) then return ""

    val at = p.here()

    p.bump()

    // The apostrophe is part of the lexeme and no part of the name.
    label_name(p.text(at))
end accept_label

private label_name(text: string) -> string = from_utf8_unchecked(text.bytes[1..])

// `'outer while ...`, and the same for the other three loops.
//
// **A label is read only immediately before a loop's own keyword**, which is what keeps a stray one
// from being reported as something else entirely.
//
// Not `private`: `expr.sysl` reads one where a value is wanted.
parse_labelled(p: *Parser, at: Span) -> Expr
    val name = label_name(p.text(at))
    val kind = p.peek()

    if kind == While || kind == For || kind == Loop || kind == Do then p.bump()

    kind match
        While -> parse_while(p, name, at)
        For -> parse_for(p, name, at)
        Loop -> parse_loop(p, name, at)
        Do -> parse_do_while(p, name, at)
        _ ->
            p.report.add(expected(p.here(), "a loop for this label to name", p.found(p.here())))
            expr(at, Bad)
end parse_labelled

private parse_word_stmt(p: *Parser, k: StmtKind) -> Stmt
    val start = p.here()

    p.bump()

    stmt(start, k)

// `while cond` with a body.
//
// Not `private`: `expr.sysl` reads a loop wherever a value is wanted.
parse_while(p: *Parser, label: string, start: Span) -> Expr

    val cond = parse_expr(p)
    val body = parse_control_body(p, Do)
    val otherwise = loop_else(p)

    accept_end(p, While)
    expr(start.to(p.just_taken()), While(label, cond, body, otherwise))
end parse_while

// The `else` a loop may carry, which runs when it finished on its own rather than by `break`.
//
// **The same clause an `if` uses**, read from the next line, so a loop's `else` and a conditional's
// are one grammar rather than two that drift.
private loop_else(p: *Parser) -> Option[Expr]
    if !accept_on_next_line(p, Else) then return None

    Some(if p.at(Indent) then parse_block(p) else inline_stmt_body(p))

// `for name in iterable` with a body.
parse_for(p: *Parser, label: string, start: Span) -> Expr

    // `[` or `{` can begin no name, which is the whole of the decision -- see `parse_binding`.
    val at = p.here()
    val binding = if p.at(LBracket) || p.at(LBrace)
        parse_pattern(p)
    else
        pattern(at, Bind(parse_name(p, "a name for each element")))

    p.expect(In, "`in`")

    val iter = parse_expr(p)
    val body = parse_control_body(p, Do)
    val otherwise = loop_else(p)

    accept_end(p, For)
    expr(start.to(p.just_taken()), For(label, binding, iter, body, otherwise))
end parse_for

// `loop` with a body.
//
// The unconditional loop is a form of its own rather than `while true`, which is the rule sysl
// states for itself and slate follows: the form the language names says what is meant, and the
// condition that is always true is a condition a reader has to evaluate to find out there isn't one.
// `do body while cond` -- the loop whose body runs before its test.
//
// **There is no `end do`**, and that is sysl's reasoning rather than an omission: the trailing
// `while` already names where the body stopped, so a marker after it would close a block that has
// just been closed.
parse_do_while(p: *Parser, label: string, start: Span) -> Expr

    val body = if p.at(Indent) then parse_block(p) else inline_stmt_body(p)

    p.skip_newlines()
    p.expect(While, "`while` and the condition the loop repeats on")

    val cond = parse_expr(p)
    val otherwise = loop_else(p)

    expr(start.to(p.just_taken()), DoWhile(label, body, cond, otherwise))
end parse_do_while

parse_loop(p: *Parser, label: string, start: Span) -> Expr

    val body = parse_control_body(p, Do)

    // **No `else`, because an `else` runs when a loop finishes on its own and this one never does.**
    // sysl says the same in as many words.
    accept_end(p, Loop)
    expr(start.to(p.just_taken()), Loop(label, body))
end parse_loop
