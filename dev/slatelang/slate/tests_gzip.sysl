module dev.slatelang.slate
@tests

import sysl.text.Search

// `slate:gzip`, and the one thing a corpus file cannot check.
//
// **`tests/js/p22.sl` is where most of this module is pinned** -- the round trips, the container's
// refusals, the limit and every way a call can be wrong -- because all of that is one program whose
// output the two back ends must agree on byte for byte. What is here is what a corpus file has no
// way to ask: bytes packed on ONE back end and unpacked on the OTHER.
//
// **The compressed bytes themselves are never compared, and that is not a weakness.** miniz and a
// host's `CompressionStream` both write deflate and neither writes the same stream: the lengths
// differ, the header's spare fields differ, and both are correct. What must be true is that each
// reads the other, so the assertion is on what came back out.

private val Sample: string = "the quick brown fox jumps over the lazy dog, and then the quick brown fox again"

// A program that compresses `Sample` and prints the stream as an array literal, which is how bytes
// travel from one back end to the other.
private packing(name: string) -> string =
    "import { " + name + " } from slate:gzip\n" +
    "async main()\n" +
    "    print(\"[\" + join(map(await " + name + "(\"" + Sample + "\"), (b) -> string(b)), \",\") + \"]\")\n" +
    "main()\n"

// The other half: a program handed that literal, which says whether it read it and what it got.
private unpacking(name: string, bytes: string) -> string =
    "import { " + name + " } from slate:gzip\n" +
    "async main()\n" +
    "    val r = await " + name + "(" + bytes + ", 65536)\n" +
    "    print(r.ok, fromBytes(r.value).value)\n" +
    "main()\n"

@test
WHAT_THE_INTERPRETER_GZIPS_A_JAVASCRIPT_HOST_READS()
    val packed = out(packing("gzip")).trim()

    // The magic bytes and the method, so that a run which printed a complaint instead of a stream
    // fails here rather than inside node with a sentence about an array literal.
    assert(packed.starts_with("[31,139,8"))
    assert_eq(node_said(unpacking("gunzip", packed)), s"true ${Sample}")

@test
WHAT_A_JAVASCRIPT_HOST_GZIPS_THE_INTERPRETER_READS()
    val packed = node_said(packing("gzip")).trim()

    assert(packed.starts_with("[31,139,8"))
    assert_eq(out(unpacking("gunzip", packed)).trim(), s"true ${Sample}")

@test
WHAT_THE_INTERPRETER_DEFLATES_A_JAVASCRIPT_HOST_READS()
    val packed = out(packing("deflate")).trim()

    assert(packed.starts_with("[120,"))
    assert_eq(node_said(unpacking("inflate", packed)), s"true ${Sample}")

@test
WHAT_A_JAVASCRIPT_HOST_DEFLATES_THE_INTERPRETER_READS()
    val packed = node_said(packing("deflate")).trim()

    assert(packed.starts_with("[120,"))
    assert_eq(out(unpacking("inflate", packed)).trim(), s"true ${Sample}")

@test
THE_TWO_COMPRESSORS_DO_NOT_WRITE_THE_SAME_STREAM_AND_THE_TESTS_ABOVE_DO_NOT_ASK_THEM_TO()
    // **A control for the four above**, which would all pass if node's `gzip` were somehow the
    // interpreter's. It is not: this asserts the two streams differ somewhere, so that "each reads
    // the other" is a claim about two implementations rather than about one.
    //
    // **What is asserted is inequality and never a particular stream**, a compressor being free to
    // change what it writes between versions without changing what it means.
    assert(out(packing("gzip")).trim() != node_said(packing("gzip")).trim())

@test
A_BODY_THAT_WILL_NOT_INFLATE_IS_THE_ONE_SENTENCE_THE_TWO_BACK_ENDS_DO_NOT_SHARE()
    // **The container is read by slate on both hosts and the deflate stream is not**, so every
    // refusal about a header, a trailer or a limit is the same sentence -- and a body whose header
    // was fine and whose contents are not is the one case left. miniz says which of truncated and
    // corrupt it was; a host's decompressor throws one `TypeError` for both and this says so.
    // `docs/reference/javascript.md` carries the difference.
    val probe =
        "import { inflate } from slate:gzip\n" +
        "async main()\n" +
        "    print((await inflate([120, 156, 1, 2, 3, 4, 5], 64)).error)\n" +
        "main()\n"

    assert_eq(out(probe).trim(), "this is not a compressed stream at all")
    assert_eq(node_said(probe), "this compressed stream could not be read")

@test
slate_brotli_REFUSES_ON_A_JAVASCRIPT_HOST_NAMING_BROTLI_AND_WHAT_TO_USE_INSTEAD()
    // **It is not on `OWED` and must not go back**, which is `abbrev`'s case: no browser has a
    // brotli encoder and none is coming, so "not in the JavaScript back end yet" would be a promise
    // nobody can keep and a reader waiting for a release that is never cut.
    val said = node_said(
        "import { compress } from slate:brotli\nprint(len(compress(\"hello\", 5)))\n")

    assert(said.contains("`compress` is brotli, and a JavaScript host has no brotli encoder"))
    assert(said.contains("`slate:gzip` is the compression a browser has"))

@test
slate_brotli_STILL_WORKS_IN_THE_INTERPRETER_AND_IS_STILL_SYNCHRONOUS()
    // **The other half of the decision**: `slate:gzip` is promise-shaped because nothing held its
    // signature yet, and `slate:brotli`'s already exists -- so it was not touched, and a program
    // that compresses with brotli does not suddenly need an `async` function to do it.
    assert_eq(out("import { compress, decompress } from slate:brotli\n" +
        "val small = compress(\"hello hello hello\", 5)\n" +
        "print(fromBytes(decompress(small, 64).value).value)\n").trim(), "hello hello hello")
