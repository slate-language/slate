module dev.slatelang.slate

import sysl.buf.{Buf, buf_with_capacity}
import sysl.slices.sort

// The one sort that never needs slate's `<`: an array holding nothing but integers, ordered by no
// comparator.
//
// **Every other array goes through `merge_sort` in `array.sysl`**, which asks `on_values` for each
// comparison -- the general `<`, which has to be ready for a real beside an integer, text beside
// text, and a mixture it refuses in a sentence. An array of integers can meet none of those, so the
// question each step asks is one machine comparison, and the numbers are sorted as numbers: taken
// out of their `Value`s into a buffer of `long`s, put in order by `sysl.slices.sort`, and written
// back.
//
// **Unstable, and nothing can tell.** Stability is what keeps two elements the comparison calls
// equal in the order they came in, and two integers that compare equal are the same value -- there
// is no identity, no field, nothing a program could read to learn which of two `5`s went first. So
// the answer is exactly the one the stable merge would have given.
//
// **No comparator means no slate code runs**, so nothing can change the array while it is being
// ordered and nothing can allocate: the walk that `merge_sort` guards against cannot happen here.

// The integers of `a` in ascending order, or nothing where any element is not an `Int`.
//
// **A `Big` sends the whole array back to the general path**, rather than being ordered here: it is
// rare, and comparing it with an `Int` is the general `<`'s job.
sorted_ints(a: *ArrayObj) -> Option[Buf[long]]
    val n = a.items.len()
    var keys: Buf[long] = buf_with_capacity(n, 0)

    for i in 0..<n
        a.items.at(i) match
            Int(x) -> keys.push(x)
            _ -> return None

    var view = keys.view()

    sort(view)
    Some(keys)
end sorted_ints

// `keys` as integer values, in a buffer an array can be made from.
int_values(keys: Buf[long]) -> Buf[Value]
    var out: Buf[Value] = buf_with_capacity(keys.len(), Null)

    for i in 0..<keys.len()
        out.push(Int(keys.at(i)))

    out
end int_values
