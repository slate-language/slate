module dev.slatelang.slate
@tests

// The three reads an array loop is made of, each answered in place: `xs[i]` with a local index
// (`LoadSlotIndex`), `.length` off an array, a string or bytes (`read_field_site`), and a `for` over
// one name (`IterNextSlot`). What each ANSWERS is `tests/lang/indexwalk.sl`'s, asked of both back
// ends; what is here is the part only the interpreter can be asked -- that the fast path is the one
// taken, and what a turn costs.

// **A length read off an array, a string or bytes calls no builtin**, and the range beside it in the
// same program is the control that could disagree: it still goes through `length`, three hundred
// times, so a profile that had stopped counting altogether would fail here too.
@test
A_LENGTH_READ_OFF_AN_ARRAY_A_STRING_OR_BYTES_CALLS_NO_BUILTIN()
    profile_start()
    val printed = out("run()\n    val xs = [0, 1, 2]\n    val s = \"añb\"\n    val b = toBytes(\"añ\")\n    val r = 0..<5\n    var i = 0\n    var total = 0\n\n    while i < 300\n        total = total + xs.length + s.length + b.length\n        i = i + 1\n\n    var j = 0\n\n    while j < 300\n        total = total + r.length\n        j = j + 1\n\n    total\n\nprint(run())")
    profile_stop()

    // 300 × (3 + 3 + 3) and 300 × 5.
    assert_eq(printed, "4200")
    assert_eq(profile_call_count("length"), 300u64)
end A_LENGTH_READ_OFF_AN_ARRAY_A_STRING_OR_BYTES_CALLS_NO_BUILTIN

#if feature_profile

// The two loops `bench/arrays.sl` times, over an array of `n`.
private by_index(n: int) -> string = s"idx(xs)\n    var total = 0\n    var i = 0\n\n    while i < xs.length\n        total = total + xs[i]\n        i = i + 1\n\n    total\n\nval xs = array(0..<${n})\nprint(idx(xs))"
private by_walk(n: int) -> string = s"walk(xs)\n    var total = 0\n\n    for v in xs\n        total = total + v\n\n    total\n\nval xs = array(0..<${n})\nprint(walk(xs))"

// Every instruction a program ran, and what it printed.
private ran(program: string) -> (u64, string)
    profile_start()
    val printed = out(program)
    profile_stop()

    var n = 0u64
    val labels = profile_op_labels()

    for i in 0..<labels.len()
        n += profile_op_count(labels.at(i))

    (n, printed)
end ran

@test
AN_ARRAY_READ_AT_A_LOCAL_INDEX_IS_ONE_INSTRUCTION_WITH_THE_LOAD()
    profile_start()
    assert_eq(out(by_index(100)), "4950")
    profile_stop()

    assert_eq(profile_op_count("LoadSlotIndex"), 100u64)
    assert_eq(profile_op_count("GetIndex"), 0u64)

    // **The control: an index that is not a local is not folded**, and reads through `GetIndex`.
    profile_start()
    assert_eq(out("idx(xs)\n    var total = 0\n    var i = 0\n\n    while i < 100\n        total = total + xs[i + 0]\n        i = i + 1\n\n    total\n\nval xs = array(0..<100)\nprint(idx(xs))"), "4950")
    profile_stop()

    assert_eq(profile_op_count("LoadSlotIndex"), 0u64)
    assert_eq(profile_op_count("GetIndex"), 100u64)
end AN_ARRAY_READ_AT_A_LOCAL_INDEX_IS_ONE_INSTRUCTION_WITH_THE_LOAD

@test
A_FOR_OVER_ONE_NAME_WRITES_ITS_CELL_WITHOUT_A_DECLARE()
    profile_start()
    assert_eq(out(by_walk(100)), "4950")
    profile_stop()

    // One a turn and one more to leave, and the loop's name is never declared by an instruction of
    // its own -- the one `DeclareSlot` left is `total`'s.
    assert_eq(profile_op_count("IterNextSlot"), 101u64)
    assert_eq(profile_op_count("IterNext"), 0u64)
    assert_eq(profile_op_count("DeclareSlot"), 1u64)

    // **The control: a head that takes the element apart keeps `IterNext`**, the pattern binding
    // what it pushed.
    profile_start()
    assert_eq(out("pairs()\n    var total = 0\n\n    for [a, b] in [[1, 2], [3, 4]]\n        total = total + a + b\n\n    total\n\nprint(pairs())"), "10")
    profile_stop()

    assert_eq(profile_op_count("IterNext"), 3u64)
    assert_eq(profile_op_count("IterNextSlot"), 0u64)
end A_FOR_OVER_ONE_NAME_WRITES_ITS_CELL_WITHOUT_A_DECLARE

// **What a turn costs, asserted as the difference between two lengths** so the preamble drops out:
// eight instructions for `while i < xs.length` with `total + xs[i]` in it (nine before the index
// folded into its load), five for a `for` over one name (six before its `DeclareSlot` folded in).
@test
A_TURN_OF_THE_INDEX_LOOP_IS_EIGHT_INSTRUCTIONS_AND_OF_THE_WALK_FIVE()
    val i150 = ran(by_index(150))
    val i100 = ran(by_index(100))
    val w150 = ran(by_walk(150))
    val w100 = ran(by_walk(100))

    assert_eq(i150.1, "11175")
    assert_eq(w100.1, "4950")
    assert_eq((i150.0 - i100.0) / 50u64, 8u64)
    assert_eq((w150.0 - w100.0) / 50u64, 5u64)
end A_TURN_OF_THE_INDEX_LOOP_IS_EIGHT_INSTRUCTIONS_AND_OF_THE_WALK_FIVE

#endif
