module dev.slatelang.slate
@tests

import sh.sysl.gc
import sh.sysl.libuv
import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.fs.{read_bytes, write_text}
import sysl.text.{replace_all, str_builder, Search}

// What slate claims, run by `sysl test .`.

// -- helpers ----------------------------------------------------------------------------------

// The token kinds a snippet lexes to, as one space-separated line.
//
// **Spans are dropped here and asserted separately.** A test that pins both says nothing clearly
// when it fails: the whole list is printed and the reader has to find which half moved. The shape
// of the token stream is what nearly every one of these is about, so that is what they compare.
//
// **A string rather than the `Buf[Tok]` this naturally wants to be.** That began as a workaround --
// neither `Buf[T]` nor `[]T` was `Eq` before 0.0.82, so a failure could print which assertion broke
// and not what the two sides were. Both are `Eq` now, and a sequence is `Display` too, so the
// workaround is no longer forced; it stays because `"Val Newline Eof"` is a shorter thing to write
// forty times than a sequence literal is. The typed form would catch a typo in the expectation that
// this one cannot, which is the trade being made.
private kinds(text: string) -> string
    val r = lex(source_of("t", text))
    var out = str_builder()
    var t = r.tokens
    var first = true

    loop
        t.advance() match
            None -> break
            Some(x) ->
                if !first then out.push_char(' ')

                out.push(s"${x.value}")
                first = false

    out.finish()
end kinds

// Whether a snippet lexes with nothing to complain about.
private clean(text: string) -> bool = lex(source_of("t", text)).ok()

// The first complaint a snippet draws, rendered as the sentence a person would read.
private first_fault(text: string) -> string
    val src = source_of("t", text)
    val r = lex(src)

    if r.report.is_empty() then "" else r.report.render(src)
end first_fault

// -- words and operators ----------------------------------------------------------------------

@test
a_word_the_grammar_took_is_not_an_identifier()
    assert_eq(kinds("val"), "Val Newline Eof")
    assert_eq(kinds("var"), "Var Newline Eof")
    assert_eq(kinds("null"), "Null Newline Eof")

@test
a_word_the_grammar_did_not_take_is_an_identifier()
    assert_eq(kinds("value"), "Ident Newline Eof")
    assert_eq(kinds("iffy"), "Ident Newline Eof")
    assert_eq(kinds("_x1"), "Ident Newline Eof")

@test
end_is_a_soft_word_and_stays_an_identifier()
    // Taking `end` as a keyword would take the name away from every program that wanted it. The
    // parser decides what it means by what follows.
    assert_eq(kinds("end"), "Ident Newline Eof")

@test
a_two_byte_operator_is_read_before_its_first_byte()
    assert_eq(kinds("=="), "EqEq Newline Eof")
    assert_eq(kinds("="), "Assign Newline Eof")
    assert_eq(kinds("->"), "Arrow Newline Eof")
    assert_eq(kinds("-"), "Minus Newline Eof")
    assert_eq(kinds("<="), "LtEq Newline Eof")
    assert_eq(kinds("<"), "Lt Newline Eof")
    assert_eq(kinds("!="), "BangEq Newline Eof")
    assert_eq(kinds("!"), "Bang Newline Eof")
end a_two_byte_operator_is_read_before_its_first_byte

// -- literals ---------------------------------------------------------------------------------

@test
an_integer_and_a_real_are_told_apart()
    assert_eq(kinds("42"), "IntLit Newline Eof")
    assert_eq(kinds("4.2"), "RealLit Newline Eof")
    assert_eq(kinds("0x2a"), "IntLit Newline Eof")

@test
a_string_keeps_its_quotes_in_its_span()
    val r = lex(source_of("t", "\"hi\""))

    assert_eq(r.tokens.peek().unwrap().span, Span(0, 4))

@test
a_malformed_literal_is_reported_and_does_not_stop_the_line()
    assert(!clean("\"unclosed"))
    assert(!clean("\"\\q\""))

// -- layout -----------------------------------------------------------------------------------

@test
an_indented_run_opens_and_closes_one_block()
    assert_eq(kinds("a\n    b\n"), "Ident Indent Ident Newline Dedent Eof")

@test
two_lines_at_one_depth_are_separated_by_a_newline()
    assert_eq(kinds("a\nb\n"), "Ident Newline Ident Newline Eof")

@test
one_line_closes_as_many_blocks_as_it_dedents_past()
    assert_eq(kinds("a\n    b\n        c\nd\n"), "Ident Indent Ident Indent Ident Newline Dedent Dedent Ident Newline Eof")
end one_line_closes_as_many_blocks_as_it_dedents_past

@test
everything_still_open_closes_at_the_end_of_the_file()
    assert_eq(kinds("a\n    b\n        c\n"), "Ident Indent Ident Indent Ident Newline Dedent Dedent Eof")

@test
a_blank_line_is_not_a_line()
    // Neither a statement separator nor a block: there is nothing on it to separate.
    assert_eq(kinds("a\n\n\nb\n"), "Ident Newline Ident Newline Eof")

@test
a_comment_only_line_is_not_a_line_whatever_its_indentation()
    // A person who indents a comment to line up with the code below it did not mean to open a block.
    assert_eq(kinds("a\n        // note\nb\n"), "Ident Newline Ident Newline Eof")

@test
a_trailing_comment_ends_the_line_and_nothing_else()
    assert_eq(kinds("a // note\nb\n"), "Ident Newline Ident Newline Eof")

@test
a_newline_inside_brackets_is_not_a_line_ending()
    // The rule every language with both features implements the same way: count the brackets in the
    // lexer, and ignore line structure while the count is above zero.
    assert_eq(kinds("f(a,\n    b)\n"), "Ident LParen Ident Comma Ident RParen Newline Eof")
end a_newline_inside_brackets_is_not_a_line_ending

@test
a_line_lining_up_with_nothing_is_reported_rather_than_quietly_closed()
    // The one indentation mistake a person actually makes: a body pulled back to a column between
    // two open ones. Closing the nearest level quietly would turn it into a parse error elsewhere.
    val text = "a\n        b\n    c\n"

    assert(!clean(text))
    assert(first_fault(text).contains("lines up with no block"))
end a_line_lining_up_with_nothing_is_reported_rather_than_quietly_closed

@test
mixing_tabs_and_spaces_on_one_line_is_reported()
    assert(!clean("a\n \tb\n"))

@test
an_empty_file_has_no_structure_to_report()
    assert_eq(kinds(""), "Eof")
    assert_eq(kinds("\n\n"), "Eof")
    assert(clean(""))

// -- the parser -------------------------------------------------------------------------------

// A snippet's tree, in parenthesised prefix notation -- and the rendered complaint instead, where
// there was one.
//
// **Handing back the complaint is what stops a test passing on a tree built out of error nodes.**
// Rendering the tree regardless would print `<bad>`, which compares equal to an expectation that
// said `<bad>` -- a test asserting the parser failed the way it failed last time. A test that wants
// the error path asserts on `parse` directly, and several below do.
private good_tree(text: string) -> string
    val src = source_of("t", text)
    val r = parse(src)

    if !r.ok() then return r.report.render(src)

    show_program(r.program)
end good_tree

@test
precedence_comes_out_of_the_binding_powers()
    assert_eq(good_tree("1 + 2 * 3"), "(+ 1 (* 2 3))")
    assert_eq(good_tree("1 * 2 + 3"), "(+ (* 1 2) 3)")
    assert_eq(good_tree("a < b && c < d"), "(&& (< a b) (< c d))")
    assert_eq(good_tree("a || b && c"), "(|| a (&& b c))")
end precedence_comes_out_of_the_binding_powers

@test
arithmetic_groups_to_the_left()
    // Two numbers apart in the table is the whole of associativity: equal powers stop the inner
    // loop, so the second operator cannot take the first one's right-hand side.
    assert_eq(good_tree("8 - 4 - 2"), "(- (- 8 4) 2)")

@test
the_lambda_arrow_groups_to_the_right()
    // A function returning a function, rather than a parse error.
    assert_eq(good_tree("x -> y -> x + y"), "(fn(x) (fn(y) (+ x y)))")

@test
a_prefix_operator_binds_tighter_than_arithmetic_and_looser_than_a_field()
    assert_eq(good_tree("-a * b"), "(* (- a) b)")
    assert_eq(good_tree("-a.b"), "(- (. a b))")
    assert_eq(good_tree("!ok"), "(! ok)")

@test
calls_indexing_and_fields_chain()
    assert_eq(good_tree("f(1)(2)"), "(call (call f 1) 2)")
    assert_eq(good_tree("o.a.b"), "(. (. o a) b)")
    assert_eq(good_tree("xs[0][1]"), "(index (index xs 0) 1)")
    assert_eq(good_tree("o.f(1)"), "(call (. o f) 1)")

@test
a_grouping_changes_the_shape_and_leaves_no_node()
    assert_eq(good_tree("(1 + 2) * 3"), "(* (+ 1 2) 3)")

// -- literals and containers --------------------------------------------------------------------

@test
a_literal_is_decoded_from_the_span_the_lexer_proved()
    assert_eq(good_tree("42"), "42")
    assert_eq(good_tree("0x2a"), "42")
    assert_eq(good_tree("1_000"), "1000")
    assert_eq(good_tree("true"), "true")
    assert_eq(good_tree("null"), "null")

@test
a_string_arrives_with_its_escapes_decoded()
    assert_eq(good_tree("\"a\\tb\""), "\"a\tb\"")

@test
an_array_and_an_object_read_as_literals()
    assert_eq(good_tree("[1, 2, 3]"), "(array 1 2 3)")
    assert_eq(good_tree("[]"), "(array)")
    assert_eq(good_tree("{ a: 1, b: 2 }"), "(object a:1 b:2)")

@test
an_argument_list_may_be_broken_across_lines()
    // Not a rule of the grammar: the bracket depth made those newlines insignificant before the
    // parser saw anything.
    assert_eq(good_tree("f(1,\n  2)"), "(call f 1 2)")

// -- statements ---------------------------------------------------------------------------------

@test
the_two_bindings_are_told_apart()
    assert_eq(good_tree("val x = 1"), "(val x 1)")
    assert_eq(good_tree("var x = 1"), "(var x 1)")

@test
a_definition_is_told_from_a_call_by_what_follows_it()
    // The one place slate's grammar looks ahead, and what taking sysl's keyword-free function form
    // costs: the two are identical until the body.
    assert_eq(good_tree("add(a, b)\n    a + b"), "(def add(a b) (block (+ a b)))")
    assert_eq(good_tree("add(a, b)"), "(call add a b)")
    assert_eq(good_tree("double(x) = x * 2"), "(def double(x) (* x 2))")

@test
a_call_whose_arguments_are_not_names_is_never_a_definition()
    assert_eq(good_tree("f(a.b)"), "(call f (. a b))")
    assert_eq(good_tree("f(1)"), "(call f 1)")

@test
a_function_of_no_arguments_is_still_a_definition()
    assert_eq(good_tree("go()\n    1"), "(def go() (block 1))")

@test
a_block_is_a_run_of_statements_and_its_value_is_the_last()
    assert_eq(good_tree("f()\n    val a = 1\n    a + 1"), "(def f() (block (val a 1) (+ a 1)))")

@test
the_loops_read()
    assert_eq(good_tree("while a < 10\n    b"), "(while (< a 10) (block b))")
    assert_eq(good_tree("for x in xs\n    x"), "(for x xs (block x))")
    assert_eq(good_tree("loop\n    break"), "(loop (block (break)))")

@test
return_is_for_leaving_early_and_takes_a_value_or_not()
    assert_eq(good_tree("f()\n    return\n"), "(def f() (block (return)))")
    assert_eq(good_tree("f()\n    return 1\n"), "(def f() (block (return 1)))")

@test
assignment_is_a_statement_and_not_an_expression()
    assert_eq(good_tree("x = 1"), "(= x 1)")
    assert_eq(good_tree("o.f = 1"), "(= (. o f) 1)")
    assert_eq(good_tree("xs[0] = 1"), "(= (index xs 0) 1)")

@test
what_cannot_be_assigned_to_is_refused_where_it_is_written()
    val src = source_of("t", "1 + 1 = 2")
    val r = parse(src)

    assert(!r.ok())
    assert(r.report.render(src).contains("cannot be assigned to"))

// -- if ------------------------------------------------------------------------------------------

@test
if_has_an_inline_form_and_an_indented_one()
    // **A one-line branch is a block of one statement**, which is what lets it *be* a statement --
    // `if c then break`. The two forms therefore have the same shape, which is the point rather than
    // an artefact: one line and an indented block differ in how they are written and in nothing else.
    assert_eq(good_tree("if a then 1 else 2"), "(if a (block 1) (block 2))")
    assert_eq(good_tree("if a\n    1\nelse\n    2"), "(if a (block 1) (block 2))")

@test
elif_is_sugar_and_nests_into_the_else_of_the_one_before()
    // No node exists for it, so nothing downstream has to learn a rule about it.
    assert_eq(good_tree("if a\n    1\nelif b\n    2\nelse\n    3"),
        "(if a (block 1) (if b (block 2) (block 3)))")
end elif_is_sugar_and_nests_into_the_else_of_the_one_before

@test
an_if_without_an_else_has_no_second_branch()
    assert_eq(good_tree("if a\n    1"), "(if a (block 1))")

@test
a_statement_after_a_block_is_a_statement_and_not_a_continuation()
    // The case that is easy to leave out: a block closing ends the statement that contained it, the
    // newline having been spent inside the block.
    assert_eq(good_tree("if a\n    1\nb"), "(if a (block 1)) b")

// -- lambdas --------------------------------------------------------------------------------------

@test
a_lambda_takes_one_bare_parameter_or_a_parenthesised_list()
    assert_eq(good_tree("x -> x * 2"), "(fn(x) (* x 2))")
    assert_eq(good_tree("(a, b) -> a + b"), "(fn(a b) (+ a b))")
    assert_eq(good_tree("() -> 1"), "(fn() 1)")

@test
a_parenthesised_expression_is_not_mistaken_for_a_parameter_list()
    // The two are told apart by trying, because no single token distinguishes them.
    assert_eq(good_tree("(a + b) * 2"), "(* (+ a b) 2)")
    assert_eq(good_tree("(a)"), "a")

@test
a_lambda_may_have_an_indented_body()
    assert_eq(good_tree("val f = x ->\n    x + 1"), "(val f (fn(x) (block (+ x 1))))")

// -- recovery ---------------------------------------------------------------------------------

@test
a_parse_error_leaves_a_node_so_that_one_pass_reports_everything()
    val src = source_of("t", "val = 1\nval y = ")
    val r = parse(src)

    assert(!r.ok())

    // Both mistakes, from one run.
    assert(r.report.len() >= 2)
end a_parse_error_leaves_a_node_so_that_one_pass_reports_everything

// -- the interpreter ----------------------------------------------------------------------------

// What a program printed, joined by newlines -- or its complaint, where it had one.
private out(text: string) -> string
    val src = source_of("t", text)
    val r = run(src)

    if !r.ok() then return r.render()

    r.printed()
end out

// The complaint a program draws, rendered.
private fails(text: string) -> string
    val src = source_of("t", text)
    val r = run(src)

    if r.ok() then "" else r.render()
end fails

@test
arithmetic_promotes_an_integer_to_a_real_and_not_the_other_way()
    assert_eq(out("print(1 + 2)"), "3")
    assert_eq(out("print(7 / 2)"), "3")
    assert_eq(out("print(7.0 / 2)"), "3.5")
    assert_eq(out("print(2 + 0.5)"), "2.5")
    assert_eq(out("print(7 % 3)"), "1")
end arithmetic_promotes_an_integer_to_a_real_and_not_the_other_way

@test
dividing_by_zero_is_a_fault_and_not_a_crash()
    assert(fails("print(1 / 0)").contains("divides by zero"))
    assert(fails("print(1 % 0)").contains("remainder by zero"))

@test
strings_join_and_order()
    assert_eq(out("print(\"a\" + \"b\")"), "ab")
    assert_eq(out("print(\"a\" < \"b\")"), "true")

@test
an_operator_that_does_not_apply_names_both_sides()
    // **The machine's complaint, reached with a value the static pass cannot see.** `1 + "a"`
    // written out is now caught while compiling -- which is the same sentence, earlier, and has its
    // own test in the checker's section.
    assert(fails(Opaque + "print(anything(1) + \"a\")").contains("an integer and a string"))

// -- truthiness ---------------------------------------------------------------------------------

@test
only_false_and_null_are_false()
    // Zero and the empty string being false as well is the rule JavaScript and Python took, and it
    // is the one most often written about as a mistake.
    assert_eq(out("if 0\n    print(\"yes\")"), "yes")
    assert_eq(out("if \"\"\n    print(\"yes\")"), "yes")
    assert_eq(out("if null\n    print(\"no\")\nelse\n    print(\"yes\")"), "yes")
    assert_eq(out("if false\n    print(\"no\")\nelse\n    print(\"yes\")"), "yes")
end only_false_and_null_are_false

@test
the_logical_operators_short_circuit_and_answer_the_deciding_operand()
    assert_eq(out("print(null || \"fallback\")"), "fallback")
    assert_eq(out("print(\"set\" || \"fallback\")"), "set")
    assert_eq(out("print(false && boom())"), "false")

// -- bindings -----------------------------------------------------------------------------------

@test
a_val_is_written_once_and_a_var_is_not()
    assert_eq(out("var x = 1\nx = 2\nprint(x)"), "2")
    assert(fails("val x = 1\nx = 2").contains("written once"))

@test
an_undefined_name_is_a_fault_where_it_is_read()
    assert(fails("print(nope)").contains("`nope` is not defined"))
    assert(fails("nope = 1").contains("`nope` is not defined"))

@test
a_block_binds_in_a_scope_of_its_own()
    assert_eq(out("val x = 1\nif true\n    val x = 2\n    print(x)\nprint(x)"), "2\n1")

// -- functions and closures ---------------------------------------------------------------------

@test
a_blocks_value_is_its_trailing_expression()
    assert_eq(out("f()\n    val a = 1\n    a + 1\nprint(f())"), "2")

@test
return_leaves_early_from_inside_a_loop()
    // `Ret` passes through the loop untouched, which is what makes this work with nothing written
    // for it.
    assert_eq(out("f(xs)\n    for x in xs\n        if x > 1\n            return x\n    null\nprint(f([1, 2, 3]))"), "2")

@test
a_named_function_can_call_itself()
    // The name is bound before the closure is built, so the body sees it.
    assert_eq(out("fact(n)\n    if n <= 1 then 1 else n * fact(n - 1)\nprint(fact(5))"), "120")

@test
a_closure_keeps_seeing_writes_to_the_scope_it_captured()
    // The counter, which is the whole argument for the scope being a counted box.
    assert_eq(out("counter()\n    var n = 0\n    bump()\n        n = n + 1\n        n\n    bump\nval c = counter()\nprint(c(), c(), c())"),
        "1 2 3")
end a_closure_keeps_seeing_writes_to_the_scope_it_captured

@test
two_closures_over_one_scope_share_it()
    assert_eq(out("pair()\n    var n = 0\n    up()\n        n = n + 1\n        n\n    get()\n        n\n    [up, get]\nval p = pair()\nval u = p[0]\nval g = p[1]\nu()\nu()\nprint(g())"),
        "2")
end two_closures_over_one_scope_share_it

@test
two_calls_of_one_function_do_not_share_a_scope()
    assert_eq(out("counter()\n    var n = 0\n    bump()\n        n = n + 1\n        n\n    bump\nval a = counter()\nval b = counter()\na()\na()\nprint(a(), b())"),
        "3 1")
end two_calls_of_one_function_do_not_share_a_scope

@test
functions_are_values()
    assert_eq(out("twice(f, v) = f(f(v))\nprint(twice(x -> x * 3, 2))"), "18")
    assert_eq(out("val p = print\np(\"through a binding\")"), "through a binding")

@test
the_wrong_number_of_arguments_is_a_fault()
    // Reached through a value, since a call written out by name is now counted while compiling.
    assert(fails(Opaque + "f(a) = a\nanything(f)(1, 2)").contains("takes 1 arguments and was given 2"))

@test
calling_something_that_is_not_a_function_is_a_fault()
    assert(fails("val x = 1\nx()").contains("is not something that can be called"))

// -- arrays and objects ---------------------------------------------------------------------------

@test
an_array_is_a_reference_type()
    assert_eq(out("val a = [1]\nval b = a\npush(b, 2)\nprint(a)"), "[1, 2]")

@test
values_compare_by_their_contents_and_not_by_identity()
    assert_eq(out("print([1, [2]] == [1, [2]])"), "true")
    assert_eq(out("print({a: 1} == {a: 1})"), "true")
    assert_eq(out("print([1] == [2])"), "false")
    assert_eq(out("print(1 == 1.0)"), "true")

@test
an_index_outside_an_array_is_a_fault_and_not_an_absence()
    // A missing *field* is `undefined`, because a record grows fields over its life. A missing
    // *index* is a mistake, because an array's bounds are known -- so it faults rather than answering
    // an absence the program would then have to default.
    assert(fails("print([1, 2][5])").contains("outside an array of 2"))
    assert_eq(out("print({a: 1}.b ?? \"absent\")"), "absent")

@test
an_object_field_may_be_written_through_a_name_or_an_index()
    assert_eq(out("val o = {a: 1}\no.a = 2\nprint(o.a)"), "2")
    assert_eq(out("val o = {a: 1}\no[\"b\"] = 3\nprint(o.b)"), "3")

@test
an_array_element_may_be_written()
    assert_eq(out("val xs = [1, 2]\nxs[0] = 9\nprint(xs)"), "[9, 2]")

@test
a_string_prints_bare_and_shows_its_quotes_inside_a_container()
    assert_eq(out("print(\"hi\")"), "hi")
    assert_eq(out("print([\"hi\"])"), "[\"hi\"]")

// -- loops ----------------------------------------------------------------------------------------

@test
the_three_loops_run()
    assert_eq(out("var n = 0\nwhile n < 3\n    n = n + 1\nprint(n)"), "3")
    assert_eq(out("var n = 0\nfor x in [1, 2, 3]\n    n = n + x\nprint(n)"), "6")
    assert_eq(out("var n = 0\nloop\n    n = n + 1\n    if n > 2\n        break\nprint(n)"), "3")

@test
break_and_continue_reach_the_nearest_loop()
    assert_eq(out("var n = 0\nfor x in [1, 2, 3, 4]\n    if x == 3\n        break\n    n = n + x\nprint(n)"), "3")
    assert_eq(out("var n = 0\nfor x in [1, 2, 3]\n    if x == 2\n        continue\n    n = n + x\nprint(n)"), "4")

@test
break_outside_a_loop_reaches_the_top_and_is_reported()
    // A call is where `Ret` stops travelling and nothing else does, so this is not quietly swallowed
    // by the function it sits in.
    assert(fails("f()\n    break\nf()").contains("`break` outside a loop"))

@test
for_walks_an_array_and_says_so_when_given_anything_else()
    assert(fails("for x in 1\n    print(x)").contains("`for` walks an array"))

// -- the whole thing ------------------------------------------------------------------------------

@test
a_program_with_a_parse_error_is_not_run_at_all()
    // Running a tree with `Bad` nodes in it would produce a second, worse account of the same file.
    val src = source_of("t", "print(\"before\")\nval = 1")
    val r = run(src)

    assert(!r.ok())
    assert_eq(r.printed(), "")
end a_program_with_a_parse_error_is_not_run_at_all

@test
two_runs_do_not_share_output()
    // The reason the print buffer hangs off the run's `World` rather than being a module-level var.
    assert_eq(out("print(1)"), "1")
    assert_eq(out("print(2)"), "2")

// -- match --------------------------------------------------------------------------------------

@test
a_match_tries_its_arms_in_order()
    assert_eq(out("print(0 match\n    0 -> \"zero\"\n    _ -> \"other\")"), "zero")
    assert_eq(out("print(9 match\n    0 -> \"zero\"\n    _ -> \"other\")"), "other")

@test
a_match_reads_as_a_transformation_of_what_is_to_its_left()
    // `match` binds looser than arithmetic, so the sum is the subject rather than just `b`.
    assert_eq(good_tree("a + b match\n    _ -> 1"), "(match (+ a b) (_ (block 1)))")

@test
a_lambda_body_may_be_a_match_rather_than_the_lambda_being_matched()
    // And tighter than the arrow, which is the other half of where `match` sits in the table.
    assert_eq(good_tree("x -> x match\n    _ -> 1"), "(fn(x) (match x (_ (block 1))))")

@test
a_subject_matching_no_arm_is_a_fault_naming_it()
    // slate is dynamically typed, so there is no exhaustiveness pass and there cannot be one: the
    // set of values a name may hold is not known. A miss is a runtime fault, as Scala's is.
    assert(fails("5 match\n    0 -> 1").contains("no arm of this match applies to 5"))

@test
a_binding_pattern_takes_anything_and_a_wildcard_binds_nothing()
    assert_eq(out("print(7 match\n    n -> n * 2)"), "14")
    assert_eq(out("print(7 match\n    _ -> \"anything\")"), "anything")
    assert(fails("print(7 match\n    _ -> _)").contains("`_` is not defined"))

@test
a_name_a_pattern_bound_is_a_val()
    assert(fails("7 match\n    n ->\n        n = 8").contains("written once"))

@test
a_guard_reads_what_the_pattern_bound_and_can_refuse_the_arm()
    // The whole reason a guard beats an `if` in the body: a refused arm lets a later one try.
    assert_eq(out("print(-5 match\n    n if n < 0 -> \"negative\"\n    _ -> \"other\")"), "negative")
    assert_eq(out("print(5 match\n    n if n < 0 -> \"negative\"\n    _ -> \"other\")"), "other")

@test
a_guard_does_not_swallow_the_arms_arrow()
    // It is read at the arrow's own binding power, which stops the expression loop exactly there.
    assert_eq(good_tree("n match\n    x if x > 1 -> 2"), "(match n (x if (> x 1) (block 2)))")

// -- literal and alternative patterns -----------------------------------------------------------

@test
every_literal_is_a_pattern_including_a_negative_number()
    assert_eq(out("print(\"a\" match\n    \"a\" -> 1\n    _ -> 2)"), "1")
    assert_eq(out("print(true match\n    true -> 1\n    _ -> 2)"), "1")
    assert_eq(out("print(null match\n    null -> 1\n    _ -> 2)"), "1")
    assert_eq(out("print(-3 match\n    -3 -> 1\n    _ -> 2)"), "1")
    assert_eq(out("print(1.5 match\n    1.5 -> 1\n    _ -> 2)"), "1")

@test
alternatives_match_any_of_their_branches()
    assert_eq(out("print(\"sun\" match\n    \"sat\" | \"sun\" -> true\n    _ -> false)"), "true")
    assert_eq(out("print(\"wed\" match\n    \"sat\" | \"sun\" -> true\n    _ -> false)"), "false")

@test
an_alternative_may_not_bind_a_name()
    // `n | 0` would leave `n` bound down one path and not the other, and slate has no type system
    // to notice. Scala refuses the same thing for the same reason.
    assert(fails("1 match\n    n | 0 -> n").contains("may not bind a name"))

// -- array patterns -------------------------------------------------------------------------------

@test
an_array_pattern_matches_by_length_unless_it_is_open()
    assert_eq(out("print([1, 2] match\n    [a, b] -> a + b\n    _ -> 0)"), "3")
    assert_eq(out("print([1, 2, 3] match\n    [a, b] -> a + b\n    _ -> 0)"), "0")
    assert_eq(out("print([] match\n    [] -> \"empty\"\n    _ -> \"no\")"), "empty")

@test
a_rest_pattern_gathers_what_is_left_over()
    assert_eq(out("print([1, 2, 3] match\n    [first, ...rest] -> rest\n    _ -> null)"), "[2, 3]")
    assert_eq(out("print([1] match\n    [first, ...rest] -> rest\n    _ -> null)"), "[]")

@test
an_anonymous_rest_says_at_least_this_many_and_binds_nothing()
    assert_eq(out("print([1, 2, 3] match\n    [a, ...] -> a\n    _ -> 0)"), "1")
    assert_eq(out("print([] match\n    [a, ...] -> a\n    _ -> 0)"), "0")

@test
nothing_may_follow_a_rest_pattern()
    assert(fails("[1] match\n    [...r, last] -> 1").contains("nothing may follow it"))

@test
array_patterns_nest_and_recurse()
    assert_eq(out("sum(xs)\n    xs match\n        [] -> 0\n        [a, ...rest] -> a + sum(rest)\nprint(sum([1, 2, 3, 4]))"),
        "10")
end array_patterns_nest_and_recurse

// -- object patterns ------------------------------------------------------------------------------

@test
an_object_pattern_matches_an_object_with_at_least_these_fields()
    // A record grows fields over its life, so a pattern that broke when one was added would be a
    // pattern nobody could keep working.
    assert_eq(out("print({a: 1, b: 2} match\n    {a: x} -> x\n    _ -> 0)"), "1")
    assert_eq(out("print({b: 2} match\n    {a: x} -> x\n    _ -> 0)"), "0")

@test
an_object_pattern_may_name_a_field_as_shorthand_for_binding_it()
    assert_eq(out("print({name: \"ada\"} match\n    {name} -> name\n    _ -> \"none\")"), "ada")

@test
patterns_nest_to_any_depth()
    assert_eq(out("print({at: [1, 2]} match\n    {at: [x, y]} -> x + y\n    _ -> 0)"), "3")

// -- match as an expression -----------------------------------------------------------------------

@test
a_match_may_be_written_as_an_argument()
    // What `sh.sysl.parsing` 0.3.0 is for: a bracket used to suspend the off-side rule outright, so
    // the arms' newlines meant nothing and the block never opened.
    assert_eq(out("print(1 match\n    1 -> \"one\"\n    _ -> \"other\")"), "one")

@test
a_bracket_closes_the_block_its_match_opened()
    // The `)` is on the same line as the last arm, so no line ending will ever close that block.
    assert_eq(good_tree("f(x match\n    1 -> 2)"), "(call f (match x (1 (block 2))))")

@test
a_match_written_as_an_argument_has_to_be_the_last_argument()
    // Not a bug but a consequence: the arms' block is closed by the bracket, so anything between
    // the last arm and the `)` is inside the block. The diagnostic says so rather than complaining
    // about a stray comma in an arm.
    assert(fails("f(x match\n    1 -> 2, 9)").contains("has to be the last argument"))
end a_match_written_as_an_argument_has_to_be_the_last_argument

@test
a_newline_inside_brackets_still_means_nothing_where_no_block_opened()
    assert_eq(good_tree("f(1,\n  2)"), "(call f 1 2)")

@test
an_arm_may_have_an_indented_body()
    assert_eq(out("print(1 match\n    1 ->\n        val a = 2\n        a + 1\n    _ -> 0)"), "3")

@test
a_failed_arm_does_not_leak_what_its_pattern_bound()
    // Each arm gets a scope of its own, because a pattern binds as it goes and cannot know it will
    // fail until it has already written a name.
    assert(fails("[1, 2] match\n    [a, b, c] -> 1\n    _ -> a").contains("`a` is not defined"))

// -- type patterns and `@` --------------------------------------------------------------------

@test
a_bare_name_that_names_a_kind_tests_for_it()
    // sysl's bare-name rule, with `Value`'s variants standing in for the scrutinee's enum's.
    assert_eq(out("print(7 match\n    integer -> \"an integer\"\n    _ -> \"other\")"), "an integer")
    assert_eq(out("print(1.5 match\n    real -> \"a real\"\n    _ -> \"other\")"), "a real")
    assert_eq(out("print(\"hi\" match\n    string -> \"text\"\n    _ -> \"other\")"), "text")
    assert_eq(out("print(true match\n    boolean -> \"a boolean\"\n    _ -> \"other\")"), "a boolean")
    assert_eq(out("print([1] match\n    array -> \"an array\"\n    _ -> \"other\")"), "an array")
    assert_eq(out("print({a: 1} match\n    object -> \"an object\"\n    _ -> \"other\")"), "an object")
    assert_eq(out("print(print match\n    function -> \"a function\"\n    _ -> \"other\")"), "a function")
    assert_eq(out("print(null match\n    null -> \"nothing\"\n    _ -> \"other\")"), "nothing")
end a_bare_name_that_names_a_kind_tests_for_it

@test
a_bare_name_that_names_no_kind_still_binds()
    // The other half of the rule, and what keeps it from taking every name away.
    assert_eq(out("print(9 match\n    whatever -> whatever * 2)"), "18")

@test
number_is_the_union_of_the_two_number_kinds()
    // Not a `Value` variant, and it earns its place: an integer and a real are separate values, so
    // every pattern guarding arithmetic would be written twice without it.
    assert_eq(out("print(7 match\n    number -> \"a number\"\n    _ -> \"other\")"), "a number")
    assert_eq(out("print(1.5 match\n    number -> \"a number\"\n    _ -> \"other\")"), "a number")
    assert_eq(out("print(\"7\" match\n    number -> \"a number\"\n    _ -> \"other\")"), "other")
    assert_eq(out("print(7 match\n    real -> \"a real\"\n    _ -> \"other\")"), "other")
end number_is_the_union_of_the_two_number_kinds

@test
at_binds_the_whole_value_as_well_as_testing_it()
    assert_eq(out("print(7 match\n    n @ integer -> n * 2\n    _ -> 0)"), "14")
    assert_eq(out("print([1, 2] match\n    whole @ [a, b] -> whole\n    _ -> null)"), "[1, 2]")

@test
at_binds_nothing_when_its_sub_pattern_did_not_take()
    assert(fails("\"hi\" match\n    n @ integer -> n\n    _ -> n").contains("`n` is not defined"))

@test
a_type_pattern_makes_a_broad_guard_safe()
    // The case this feature exists for. `n if n < 0` binds anything, so the guard used to evaluate
    // `[3, 4] < 0` and fault; `n @ number if n < 0` cannot reach the guard with the wrong kind.
    val prog = "d(v)\n    v match\n        n @ number if n < 0 -> \"negative\"\n        _ -> \"other\"\nprint(d(-1), d([3, 4]), d(\"hi\"))"

    assert_eq(out(prog), "negative other other")
end a_type_pattern_makes_a_broad_guard_safe

@test
a_type_pattern_renders_as_the_word_that_was_written()
    assert_eq(good_tree("v match\n    n @ number -> 1\n    string -> 2"), "(match v (n@number (block 1)) (string (block 2)))")

@test
a_kind_name_is_only_special_in_a_pattern()
    // It is not a keyword: a program may still bind and read `int` as an ordinary name.
    assert_eq(out("val int = 3\nprint(int + 1)"), "4")
    assert_eq(out("array(n) = n * 2\nprint(array(4))"), "8")

// -- the collector ------------------------------------------------------------------------------

@test
a_cycle_is_collected_where_reference_counting_could_not_free_it()
    // **Every named function is a cycle**: `define` binds the closure into the very scope that
    // closure captured, so the scope holds the closure and the closure holds the scope. Nothing
    // declared that back-edge, so `weak` cannot help.
    //
    // **This test is a falsification rather than an assertion.** Twenty thousand turns, each making
    // two scopes and two closures, is far more than the four megabytes the heap has -- so if nothing
    // were collected `alloc` would answer null and the run would fault. Completing is the proof.
    val prog = "var n = 0\nvar total = 0\nwhile n < 20000\n    counter()\n        var c = 0\n        bump()\n            c = c + 1\n            c\n        bump\n    val f = counter()\n    total = total + f()\n    n = n + 1\nprint(total)"

    assert_eq(out(prog), "20000")
end a_cycle_is_collected_where_reference_counting_could_not_free_it

@test
the_heap_does_not_grow_with_garbage()
    // The same program, watched rather than merely survived: what is live at the end is a handful of
    // scopes, so the heap should be holding far less than the run allocated.
    val prog = "var n = 0\nwhile n < 20000\n    val xs = [1, 2, 3, 4, 5]\n    val o = { a: xs, b: \"some text\" }\n    n = n + 1\nprint(n)"

    assert_eq(out(prog), "20000")

    // Well under the 4 MB block, and under what 20,000 turns would have taken uncollected.
    assert(heap_used() < 1048576, "the heap is not full of garbage")
end the_heap_does_not_grow_with_garbage

@test
a_collection_does_not_lose_a_value_a_temporary_was_holding()
    // The shadow stack's job. A match subject, a half-built literal and a call's arguments all live
    // in sysl locals that the mark phase cannot see, so each is pushed before anything that may
    // collect.
    val prog = "keep(v) = v\nvar n = 0\nvar last = null\nwhile n < 5000\n    last = [n, \"text\", { k: n }] match\n        [a, s, o] -> keep([a, s, o.k])\n        _ -> null\n    n = n + 1\nprint(last)"

    assert_eq(out(prog), "[4999, \"text\", 4999]")
end a_collection_does_not_lose_a_value_a_temporary_was_holding

// -- cyclic values --------------------------------------------------------------------------------
//
// **None of these could be written before the value graph moved onto a tracing collector.** Under
// reference counting `a[0] = a` was a leak nothing could free, so no slate program built one and
// neither the printer nor `==` had ever been handed a structure that reaches itself. Both descended
// structurally, and both ran out of stack -- which sysl reports as a bare SIGSEGV carrying no
// message and none of the output already produced, filed as card 0299.

@test
an_array_that_reaches_itself_prints_as_an_ellipsis()
    assert_eq(out("var a = [1, 2]\na[0] = a\nprint(a)"), "[[...], 2]")

@test
an_object_that_reaches_itself_prints_as_an_ellipsis()
    // One field, so nothing here depends on what order a map walks in.
    assert_eq(out("var o = { a: 1 }\no.a = o\nprint(o)"), "{a: {...}}")

@test
a_value_appearing_twice_without_a_cycle_prints_in_full_both_times()
    // **The reason the printer records its PATH rather than everything it has seen.** A set of
    // everything seen would render the second `x` as `[...]`, which is a lie about a structure that
    // is perfectly finite and would have printed fine before any of this.
    assert_eq(out("val x = [1]\nprint([x, x])"), "[[1], [1]]")
    assert_eq(out("val x = { a: 1 }\nprint([x, x])"), "[{a: 1}, {a: 1}]")

@test
a_deeper_cycle_prints_at_the_point_it_closes()
    assert_eq(out("var a = [1]\nvar b = [a]\na[0] = b\nprint(b)"), "[[[...]]]")

@test
a_cyclic_value_can_be_compared_with_itself()
    // Identity settles it without a walk, which is what the address is for.
    assert_eq(out("var a = [1]\na[0] = a\nprint(a == a)"), "true")

@test
two_separately_built_cyclic_values_compare_by_their_shape()
    // The coinductive rule: on re-entering a pairing already underway, assume it holds. Both of
    // these descend forever without it.
    assert_eq(out("var b = [1]\nb[0] = b\nvar c = [1]\nc[0] = c\nprint(b == c)"), "true")
    assert_eq(out("var b = [1, 7]\nb[0] = b\nvar c = [1, 9]\nc[0] = c\nprint(b == c)"), "false")

@test
a_cycle_through_two_objects_compares_by_its_shape()
    val prog = "var x = { tag: \"x\" }\nvar y = { tag: \"y\" }\nx.next = y\ny.prev = x\nvar p = { tag: \"x\" }\nvar q = { tag: \"y\" }\np.next = q\nq.prev = p\nprint(x == p)"

    assert_eq(out(prog), "true")
end a_cycle_through_two_objects_compares_by_its_shape

@test
a_match_that_applies_to_nothing_can_report_a_cyclic_subject()
    // The failure message renders the subject, so the error path walked the same structure the
    // printer does and crashed on exactly the value a person needed to see.
    assert(fails("var a = [1]\na[0] = a\na match\n    9 -> 1").contains("no arm"))

// -- an object is keyed by any value --------------------------------------------------------------
//
// **This is where slate is deliberately less like JavaScript.** A JS `Map` keys an object by
// identity, so `m.set({a: 1}, 1)` and `m.get({a: 1})` miss each other. Keys here compare the way
// `==` does, which is what makes a general dictionary and a general set possible at all -- the
// choice Java and Scala make with `hashCode`/`equals`.

@test
a_key_may_be_any_value()
    val prog = "var t = {}\nt[1] = \"int\"\nt[\"s\"] = \"str\"\nt[true] = \"bool\"\nt[null] = \"null\"\nprint(t[1], t[\"s\"], t[true], t[null])"

    assert_eq(out(prog), "int str bool null")

@test
an_array_or_object_key_matches_by_shape_not_by_identity()
    // Two separately built arrays with the same contents are one key.
    assert_eq(out("var t = {}\nt[[1, 2]] = \"found\"\nprint(t[[1, 2]])"), "found")
    assert_eq(out("var t = {}\nt[{ x: 1 }] = \"found\"\nprint(t[{ x: 1 }])"), "found")

@test
a_number_key_does_not_split_by_how_it_was_written()
    // `1 == 1.0` is true, so they must be the same key -- the hash has to agree with `==` or one of
    // them is lost in its own table.
    assert_eq(out("var t = {}\nt[1] = \"a\"\nt[1.0] = \"b\"\nprint(t[1], len(t))"), "b 1")

@test
fields_keep_the_order_they_were_first_written()
    assert_eq(out("var o = { b: 1, a: 2 }\no.c = 3\nprint(keys(o))"), "[\"b\", \"a\", \"c\"]")

@test
rewriting_a_field_does_not_move_it()
    assert_eq(out("var o = { a: 1, b: 2 }\no.a = 9\nprint(keys(o), o.a)"), "[\"a\", \"b\"] 9")

@test
two_objects_with_the_same_fields_in_another_order_are_equal()
    // And therefore must hash alike, which is why `hash_object` sums rather than mixes in order.
    assert_eq(out("print({ a: 1, b: 2 } == { b: 2, a: 1 })"), "true")

    // The consequence that would break silently if the hash disagreed: one used as a key finds the
    // other.
    assert_eq(out("var t = {}\nt[{ a: 1, b: 2 }] = \"hit\"\nprint(t[{ b: 2, a: 1 }])"), "hit")

@test
a_table_grows_without_losing_anything()
    // Past the initial eight slots and several doublings, so growth and rehashing are exercised.
    val prog = "var t = {}\nvar i = 0\nwhile i < 200\n    t[i] = i * 2\n    i = i + 1\nvar sum = 0\nvar j = 0\nwhile j < 200\n    sum = sum + t[j]\n    j = j + 1\nprint(len(t), sum)"

    assert_eq(out(prog), "200 39800")

@test
a_key_that_reaches_itself_can_still_be_hashed()
    // The hash is depth-bounded, which is what makes this terminate. It stays consistent with `==`
    // because two equal values agree on their first eight levels too.
    val prog = "var a = [1]\na[0] = a\nvar t = {}\nt[a] = \"cyclic\"\nprint(t[a])"

    assert_eq(out(prog), "cyclic")

@test
a_missing_key_is_absent_whatever_its_kind()
    assert_eq(out("var t = {}\nprint(t[42] ?? \"a\", t[[1]] ?? \"b\", t.nope ?? \"c\")"), "a b c")
    assert_eq(out("var t = {}\nprint(t[42] == undefined, t.nope == undefined)"), "true true")

@test
an_object_prints_a_plain_name_bare_and_anything_else_as_a_value()
    assert_eq(out("var t = { a: 1 }\nt[2] = 3\nprint(t)"), "{a: 1, 2: 3}")
    assert_eq(out("var t = {}\nt[\"not a name\"] = 1\nprint(t)"), "{\"not a name\": 1}")

// -- an object may define its own hash and equals -------------------------------------------------
//
// **A field rather than new syntax**, because an object already holds closures. Java gives every
// object an overridable `hashCode`/`equals`; slate gives it two overridable fields, which is the same
// idea spelled in what the language already has. The default stays structural.

@test
an_object_can_say_what_it_considers_equal()
    val prog = "var a = { x: 1, tag: \"a\" }\na.equals = o -> o.x == a.x\nvar b = { x: 1, tag: \"b\" }\nprint(a == b, b == a)"

    // `a == b` consults a's hook and passes; `b == a` has no hook on the left and compares
    // structurally, which fails on the tag. Java's `a.equals(b)` is asymmetric in exactly this way.
    assert_eq(out(prog), "true false")

@test
a_pair_of_hooks_makes_two_objects_one_key()
    val prog = "point(x)\n    var p = { x: x, note: \"\" }\n    p.equals = o -> o.x == p.x\n    p.hash = () -> p.x\n    p\nval a = point(1)\nval b = point(1)\nb.note = \"different\"\nvar t = {}\nt[a] = \"stored\"\nprint(t[b], len(t))"

    assert_eq(out(prog), "stored 1")

@test
a_hash_that_does_not_answer_an_integer_is_reported()
    val prog = "var a = { x: 1 }\na.hash = () -> \"not a number\"\nvar t = {}\nt[a] = 1"

    assert(fails(prog).contains("`hash` must answer an integer"))

@test
a_fault_inside_a_hook_comes_back_out()
    // The reason hashing and equality carry a `Result` at all: a hook is slate code and slate code
    // can fault, which `sysl.container.Map`'s `Hash`/`Eq` have nowhere to report.
    val prog = "var a = { x: 1 }\na.hash = () -> nope\nvar t = {}\nt[a] = 1"

    assert(fails(prog).contains("`nope` is not defined"))

@test
a_literal_pattern_does_not_consult_a_hook()
    // A pattern is a shape test: `5 -> ...` asks whether the subject *is* five, not whether something
    // has been persuaded to say so.
    val prog = "var a = { x: 1 }\na.equals = o -> true\nprint(a match\n    5 -> \"claimed to be five\"\n    _ -> \"itself\")"

    assert_eq(out(prog), "itself")

@test
a_hook_that_is_not_a_function_is_ignored()
    // A field called `hash` holding a number is data, not an override.
    assert_eq(out("var a = { hash: 7 }\nvar b = { hash: 7 }\nprint(a == b)"), "true")

// -- the machine ----------------------------------------------------------------------------------
//
// **These were differential tests against the tree-walker until the walker was deleted.** Every one
// of them agreed on both before it went, and the expectations here are written out by hand rather
// than snapshotted -- a machine compared against its own output proves nothing.

@test
the_machine_runs_arithmetic_and_names()
    assert_eq(out("print(1 + 2 * 3)"), "7")
    assert_eq(out("val x = 4\nvar y = 5\ny = y + x\nprint(y)"), "9")
    assert_eq(out("print(7 / 2, 7.0 / 2, \"a\" + \"b\")"), "3 3.5 ab")

@test
the_machine_short_circuits_and_keeps_the_deciding_operand()
    // Compiled as a jump that does not pop, which is what makes `||` answer `1` rather than `true`.
    assert_eq(out("print(false && nope)"), "false")
    assert_eq(out("print(1 || nope)"), "1")
    assert_eq(out("print(null || \"fallback\")"), "fallback")

@test
the_machine_builds_containers()
    assert_eq(out("print([1, 2, 3])"), "[1, 2, 3]")
    assert_eq(out("val o = { a: 1, b: [2, 3] }\nprint(o.b[1], o.a, keys(o))"), "3 1 [\"a\", \"b\"]")
    assert_eq(out("var t = {}\nt[[1,2]] = \"k\"\nprint(t[[1,2]])"), "k")

@test
the_machine_runs_control_flow()
    assert_eq(out("var n = 0\nwhile n < 5\n    n = n + 1\nprint(n)"), "5")
    assert_eq(out("var s = 0\nfor x in [1,2,3,4]\n    s = s + x\nprint(s)"), "10")
    assert_eq(out("var n = 0\nloop\n    n = n + 1\n    if n > 3\n        break\nprint(n)"), "4")
    assert_eq(out("var s = 0\nfor x in [1,2,3,4]\n    if x == 2\n        continue\n    s = s + x\nprint(s)"), "8")

@test
the_machine_runs_functions_and_closures()
    assert_eq(out("double(x) = x * 2\nprint(double(21))"), "42")
    assert_eq(out("add(a, b)\n    a + b\nprint(add(1, 2))"), "3")
    assert_eq(out("counter()\n    var c = 0\n    bump()\n        c = c + 1\n        c\n    bump\nval f = counter()\nprint(f(), f(), f())"), "1 2 3")

@test
the_machine_runs_match()
    assert_eq(out("print(2 match\n    1 -> \"one\"\n    2 -> \"two\"\n    _ -> \"other\")"), "two")
    assert_eq(out("print([1, 2] match\n    [a, b] if a < b -> \"rising\"\n    _ -> \"no\")"), "rising")
    assert_eq(out("print({ k: 1 } match\n    { k: n } -> n\n    _ -> 0)"), "1")
    assert_eq(out("print(9 match\n    n @ number -> n * 2\n    _ -> 0)"), "18")
    assert_eq(out("print([1,2,3] match\n    [a, ...rest] -> a\n    _ -> 0)"), "1")

@test
the_machine_returns_early_from_inside_a_loop()
    assert_eq(out("first_even(xs)\n    for x in xs\n        if x % 2 == 0\n            return x\n    null\nprint(first_even([1,3,4,5]))"), "4")

// -- the event loop -------------------------------------------------------------------------------
//
// **A callback needs nothing from the machine.** It runs *from* the loop rather than from inside a
// half-evaluated expression, which is why all of this would have worked on the tree-walker too --
// `await` is the one that needed a machine.

@test
a_program_does_not_end_while_a_timer_is_pending()
    // node's rule: the process lives as long as something is scheduled.
    assert_eq(out("print(\"before\")\nsetTimeout(() -> print(\"after\"), 1)\nprint(\"last statement\")"),
              "before\nlast statement\nafter")

@test
timers_fire_in_the_order_their_delays_say()
    assert_eq(out("setTimeout(() -> print(\"late\"), 20)\nsetTimeout(() -> print(\"early\"), 1)"),
              "early\nlate")

@test
an_interval_repeats_until_it_is_cancelled()
    val prog = "var n = 0\nvar id = null\nbump()\n    n = n + 1\n    print(n)\n    if n == 3\n        clearInterval(id)\nid = setInterval(bump, 1)"

    assert_eq(out(prog), "1\n2\n3")

@test
a_timer_cancelled_before_it_fires_never_runs()
    assert_eq(out("val id = setTimeout(() -> print(\"never\"), 5)\nclearTimeout(id)\nprint(\"done\")"), "done")

@test
a_callback_sees_the_scope_it_was_written_in()
    // The whole of what makes it a closure, across a suspension of the program itself.
    assert_eq(out("val greeting = \"hello\"\nsetTimeout(() -> print(greeting), 1)"), "hello")

@test
a_callback_may_schedule_another_one()
    val prog = "var n = 0\nstep()\n    n = n + 1\n    print(n)\n    if n < 3\n        setTimeout(step, 1)\nsetTimeout(step, 1)"

    assert_eq(out(prog), "1\n2\n3")

@test
a_pending_callback_survives_a_collection()
    // **The reason `event.sysl` keeps a rooted table at all.** The only reference to this closure is
    // the one libuv holds, and the mark phase cannot see through an ARC box -- so without the table
    // the collector frees it and the timer calls into swept memory. The allocation between the two
    // is what forces a collection in the gap.
    val prog = "val message = \"survived\"\nsetTimeout(() -> print(message), 5)\nvar n = 0\nwhile n < 20000\n    val junk = [1, 2, 3, 4, 5]\n    n = n + 1\nprint(\"allocated\")"

    assert_eq(out(prog), "allocated\nsurvived")

@test
a_timer_needs_a_function_and_says_so()
    assert(fails("setTimeout(42, 1)").contains("a timer needs a function to call"))
    assert(fails("setTimeout(() -> 1, \"soon\")").contains("a delay is a number of milliseconds"))

@test
a_fault_inside_a_callback_is_reported()
    assert(fails("setTimeout(() -> nope, 1)").contains("`nope` is not defined"))

// -- telling absence from null ---------------------------------------------------------------------

@test
has_tells_an_absent_field_from_one_holding_null()
    // Absence and `null` are now different answers, so reading tells them apart -- but `has` is still
    // the way to ask without having to default first.
    assert_eq(out("val a = {}\nval b = { x: null }\nprint(has(a, \"x\"), has(b, \"x\"))"), "false true")
    assert_eq(out("val a = {}\nval b = { x: null }\nprint(has(a, \"x\"), has(b, \"x\"))"), "false true")

@test
has_works_for_any_kind_of_key()
    assert_eq(out("var t = {}\nt[[1,2]] = 1\nprint(has(t, [1,2]), has(t, [1,3]))"), "true false")
    assert_eq(out("var t = {}\nt[1] = 1\nprint(has(t, 1.0), has(t, 2))"), "true false")

@test
has_agrees_with_keys_and_survives_removal_of_a_value()
    assert_eq(out("var o = { a: 1 }\no.a = null\nprint(has(o, \"a\"), keys(o))"), "true [\"a\"]")

@test
has_needs_an_object_and_says_so()
    assert(fails(Opaque + "has(anything([1,2]), 0)").contains("`has` needs an object"))
    assert(fails(Opaque + "anything(has)({})").contains("`has` takes an object and a key"))

@test
nil_is_an_ordinary_name_now_that_nothing_takes_it()
    // The soft-word rule `end` already had: a word the grammar does not need belongs to the program.
    assert_eq(out("val nil = \"just a variable\"\nprint(nil)"), "just a variable")

// -- absence is second class ----------------------------------------------------------------------
//
// **`undefined` may be produced, compared and defaulted -- and kept nowhere.** The problem with
// JavaScript's is not that it exists but that it *travels*: an ordinary value flows into a field,
// through three layers, and is observed a long way from the lookup that made it, by which time
// nothing knows what was missing. Refusing to keep it means a program says what absence means where
// it arose, which is the one place it still knows.

@test
a_missing_field_is_absent_and_a_present_null_is_not()
    assert_eq(out("val o = { b: null }\nprint(o.nope == undefined, o.b == undefined, o.b == null)"), "true false true")

@test
absence_may_not_be_bound_to_a_name()
    assert(fails("val o = {}\nval x = o.nope").contains("cannot be bound to `x`"))
    assert(fails("val o = {}\nvar x = o.nope").contains("cannot be bound to `x`"))

@test
absence_may_not_be_written_to_anything()
    assert(fails("val o = {}\nvar p = {}\np.x = o.nope").contains("cannot be stored in `x`"))
    assert(fails("val o = {}\nvar xs = [1]\nxs[0] = o.nope").contains("cannot be stored"))
    assert(fails("val o = {}\nvar n = 1\nn = o.nope").contains("cannot be written to `n`"))

@test
absence_may_not_be_put_in_a_container_or_used_as_a_key()
    assert(fails("val o = {}\nval xs = [o.nope]").contains("cannot be put in an array"))
    assert(fails("val o = {}\nval p = { x: o.nope }").contains("cannot be put in an object"))
    assert(fails("val o = {}\nvar t = {}\nt[o.nope] = 1").contains("cannot be used as a key"))

@test
absence_may_not_be_passed_to_a_function()
    // The rule that makes the others hold: a parameter is a name, so passing it is binding it.
    assert(fails("val o = {}\nprint(o.nope)").contains("cannot be passed to a function"))

@test
absence_may_be_compared_and_defaulted_and_tested()
    // The three things left, and they are enough: ask what it is, say what it should be, or branch.
    assert_eq(out("val o = {}\nprint(o.nope == undefined)"), "true")
    assert_eq(out("val o = {}\nprint(o.nope ?? \"fallback\")"), "fallback")
    assert_eq(out("val o = {}\nif o.nope\n    print(\"yes\")\nelse\n    print(\"absent is false\")"), "absent is false")

@test
the_default_operator_asks_about_absence_and_not_truth()
    // **`??` is not `||`**, and this is the whole difference: zero and the empty string are values.
    assert_eq(out("val o = { z: 0, s: \"\" }\nprint(o.z ?? \"gone\", o.s ?? \"gone\", o.q ?? \"gone\")"), "0  gone")
    assert_eq(out("val o = { z: 0 }\nprint(o.z || \"gone\")"), "0")

@test
a_default_replaces_a_present_null_as_well_as_an_absent_field()
    // **JavaScript's rule, taken deliberately.** In theory a `null` a program chose should survive,
    // and slate can still say so with `has` or `== undefined`; in practice "missing or empty, use
    // that" is what the operator is reached for, and one that handled half of it would be a trap.
    assert_eq(out("val o = { x: null }\nprint(o.x ?? \"replaced\")"), "replaced")
    assert_eq(out("val o = {}\nprint(o.x ?? \"replaced\")"), "replaced")

    // And the distinction is still askable, which is where it earns its keep.
    assert_eq(out("val o = { x: null }\nprint(has(o, \"x\"), o.x == undefined)"), "true false")

@test
the_default_operator_binds_looser_than_or()
    assert_eq(good_tree("a ?? b || c"), "(?? a (|| b c))")

@test
a_runaway_recursion_is_reported_rather_than_crashing()
    // **A machine has to impose this, where a tree-walker got it imposed on it.** The walker recursed
    // in sysl, so this exhausted the host stack and died with no diagnostic and none of the output the
    // program had already produced. Frames are an array here, so slate owns the limit -- and a limit
    // slate owns is one slate can report, pointing at the call that went too deep.
    val r = fails("f()\n    f()\nf()")

    assert(r.contains("farther than slate will go"))

@test
output_printed_before_a_runaway_recursion_survives_it()
    // The half of the problem that cost the most: a crash used to take the evidence with it.
    val src = source_of("t", "print(\"before\")\nf()\n    f()\nf()")
    val r = run(src)

    assert(!r.ok())
    assert_eq(r.printed(), "before")
end output_printed_before_a_runaway_recursion_survives_it

@test
recursion_far_deeper_than_a_host_stack_still_works()
    // Frames are heap-allocated, so honest deep recursion is cheap -- this is far past where the
    // tree-walker would have died.
    assert_eq(out("down(n)\n    if n == 0\n        0\n    else\n        down(n - 1)\nprint(down(5000))"), "0")

// -- setting a line of execution aside --------------------------------------------------------------
//
// **The mechanism `await` will be built on, tested before there is anything to build.** A coroutine
// is possible only because a call's state is data here rather than sysl's own call stack, which is the
// whole reason the tree-walker was replaced.

@test
parking_and_unparking_round_trips_the_machine()
    reset_heap()
    reset_vm()

    vm.stack.push(Int(7))
    vm.stack.push(str_value("carried"))

    val id = park()

    assert_eq(vm.stack.len(), 0, "the caller gets a clean machine")

    unpark(id)

    assert_eq(vm.stack.len(), 2)
    assert_eq(value_text(vm.stack.at(1)), "carried")
end parking_and_unparking_round_trips_the_machine

@test
a_parked_machine_is_a_collector_root_like_a_running_one()
    // **The claim the whole design rests on.** A suspended call is not running and is not therefore
    // any less alive: everything it will touch when it resumes has to survive until then. After the
    // park, the only thing referring to this string is the parked machine -- so if `mark_vm` did not
    // walk `parked`, the collection below would free it and the read after would be of swept memory.
    reset_heap()
    reset_vm()

    vm.stack.push(str_value("still here"))

    val id = park()

    collect_now()

    unpark(id)

    assert_eq(value_text(vm.stack.at(0)), "still here")
end a_parked_machine_is_a_collector_root_like_a_running_one

@test
two_parked_machines_do_not_share_anything()
    reset_heap()
    reset_vm()

    vm.stack.push(str_value("first"))

    val a = park()

    vm.stack.push(str_value("second"))

    val b = park()

    collect_now()
    unpark(a)

    assert_eq(value_text(vm.stack.at(0)), "first")
    reset_vm()
end two_parked_machines_do_not_share_anything

// -- async and await --------------------------------------------------------------------------------

@test
async_and_await_are_words_of_their_own()
    assert_eq(kinds("async"), "Async Newline Eof")
    assert_eq(kinds("await"), "Await Newline Eof")

    // Neither is a soft word, so neither may be a name. `asynchronous` still is one, which is what
    // says the lexer compares whole runs rather than prefixes.
    assert_eq(kinds("asynchronous"), "Ident Newline Eof")

@test
the_tree_says_which_functions_are_async()
    assert_eq(good_tree("f(x) = x"), "(def f(x) x)")
    assert_eq(good_tree("async f(x) = x"), "(async-def f(x) x)")
    assert_eq(good_tree("async x -> x"), "(async-fn(x) x)")

@test
await_binds_like_the_other_prefix_operators()
    // At the same power as `-`, so it takes the call and not the sum: `await f() + 1` adds to what
    // was waited for. JavaScript groups it the same way.
    assert_eq(good_tree("async f() = await g() + 1"), "(async-def f() (+ (await (call g)) 1))")
    assert_eq(good_tree("async f() = await g(1)"), "(async-def f() (await (call g 1)))")

@test
async_in_front_of_something_that_is_not_a_function_is_refused()
    assert(fails("val x = async 5").contains("`async` goes in front of a function"))

@test
await_outside_an_async_function_is_refused()
    assert(fails("print(await 5)").contains("`await` belongs in an `async` function"))

    // Including in an ordinary function nested inside an async one -- `await` belongs to the function
    // it is written in, not to the one that called it.
    assert(fails("async outer()\n    inner() = await 5\n    inner()\nouter()").contains("`await` belongs in an `async` function"))

@test
an_async_function_answers_a_promise_and_its_caller_carries_on()
    // **The ordering node produces, and the whole point of the machine.** Everything above the first
    // `await` runs before the caller sees the promise; everything below it runs after the caller has
    // moved on.
    val prog = "async greet(name)\n    print(\"start\", name)\n    await sleep(2)\n    print(\"done\", name)\n    \"hello \" + name\nasync main()\n    print(await greet(\"ada\"))\nprint(\"before\")\nmain()\nprint(\"after\")"

    assert_eq(out(prog), "before\nstart ada\nafter\ndone ada\nhello ada")

@test
an_async_function_that_never_awaits_still_answers_a_promise()
    assert_eq(out("async f() = 7\nasync main()\n    print(await f())\nmain()"), "7")

@test
two_async_functions_run_at_the_same_time()
    // Two coroutines, each on a timer of its own, interleaving by when their sleeps come up.
    val prog = "async worker(name, ms, turns)\n    var i = 0\n    while i < turns\n        await sleep(ms)\n        print(name, i)\n        i = i + 1\n    name\nasync main()\n    val a = worker(\"a\", 8, 3)\n    val b = worker(\"b\", 20, 2)\n    print(\"both started\")\n    print(await a, await b)\nmain()"

    // `a` comes up at 8, 16 and 24 milliseconds and `b` at 20 and 40, so the two threads of output
    // cross with four milliseconds to spare on either side of every step.
    assert_eq(out(prog), "both started\na 0\na 1\nb 0\na 2\nb 1\na b")

@test
a_timer_and_an_await_interleave_by_time()
    val prog = "async work()\n    await sleep(10)\n    print(\"work done\")\nsetTimeout(() -> print(\"timer 5\"), 5)\nwork()\nsetTimeout(() -> print(\"timer 20\"), 20)\nprint(\"sync\")"

    assert_eq(out(prog), "sync\ntimer 5\nwork done\ntimer 20")

@test
await_of_a_plain_value_answers_it()
    assert_eq(out("async f() = await 7\nasync main()\n    print(await f())\nmain()"), "7")

@test
await_on_a_settled_promise_still_yields()
    // **A settled promise goes round the queue like any other**, so what was scheduled first runs
    // first. Continuing straight through would print `after` last, which is the ordering bug every
    // runtime that took the shortcut has had to undo.
    val prog = "async f()\n    await resolve(1)\n    print(\"resumed\")\nf()\nsetTimeout(() -> print(\"timer\"), 0)\nprint(\"sync\")"

    assert_eq(out(prog), "sync\nresumed\ntimer")

@test
an_async_lambda_may_be_written_with_the_arrow()
    assert_eq(out("val double = async x -> (await x) * 2\nasync main()\n    print(await double(21))\nmain()"), "42")
    assert_eq(out("val pair = async (a, b) -> (await a) + (await b)\nasync main()\n    print(await pair(1, 2))\nmain()"), "3")

@test
a_deep_chain_of_awaits_carries_a_value_back()
    val prog = "async down(n)\n    if n == 0\n        await sleep(1)\n        \"bottom\"\n    else\n        await down(n - 1)\nasync main()\n    print(await down(30))\nmain()"

    assert_eq(out(prog), "bottom")

@test
resolve_and_reject_make_a_promise_that_has_already_settled()
    assert_eq(out("async main()\n    print(await resolve(\"plain\"))\nmain()"), "plain")
    assert(fails("async main()\n    print(await reject(\"nope\"))\nasync top()\n    await main()\ntop()").contains("nope"))

@test
a_promise_prints_as_pending_and_then_as_its_value()
    val prog = "async main()\n    val p = sleep(2)\n    print(p)\n    await p\n    print(p)\nmain()"

    assert_eq(out(prog), "<promise pending>\n<promise null>")

    assert_eq(out("async main()\n    print(resolve(5))\nmain()"), "<promise 5>")

@test
a_promise_compares_by_identity()
    // Two promises that will settle to the same value are not the same promise, so `==` answers what
    // the addresses say -- which is the bargain a function already has.
    assert_eq(out("async main()\n    val a = resolve(1)\n    val b = resolve(1)\n    print(a == a, a == b)\nmain()"), "true false")

@test
a_fault_in_an_async_function_reaches_whoever_awaits_it()
    // With no `catch` in the language a failed promise ends the call that awaited it, and that call's
    // own promise fails in turn -- which is what a language with exceptions gets from unwinding.
    val prog = "async risky()\n    await sleep(1)\n    1 / 0\nasync middle()\n    await risky()\n    print(\"never\")\nasync top()\n    await middle()\ntop()"

    assert(fails(prog).contains("this divides by zero"))
    assert(!out(prog).contains("never"))

@test
a_failure_nothing_awaits_is_reported_rather_than_dropped()
    // **The one thing node gets wrong by default.** A promise that fails with nothing waiting on it
    // has nowhere to report to, so slate makes it the program's fault.
    val prog = "async risky()\n    await sleep(1)\n    print(\"about to fail\")\n    1 / 0\nrisky()\nprint(\"started\")"
    val said = fails(prog)

    assert(said.contains("nothing awaited"))
    assert(said.contains("this divides by zero"))

    // What the program printed before it went wrong survives the report, which `out` cannot show --
    // it answers the complaint once there is one.
    val r = run(source_of("t", prog))

    assert(!r.ok())
    assert_eq(r.printed(), "started\nabout to fail")

@test
a_failure_that_was_awaited_is_not_reported_twice()
    // The chain here ends in an `await`, so nothing is unhandled and the only complaint is the fault
    // itself -- once.
    val prog = "async risky()\n    await sleep(1)\n    1 / 0\nasync top()\n    await risky()\ntop()"
    val said = fails(prog)

    assert(said.contains("this divides by zero"))

@test
many_coroutines_parked_at_once_survive_a_collection()
    // **The claim `mark_vm` walking `parked` exists for.** Sixty lines of execution are suspended at
    // the same moment, each holding the only reference to sixty objects, and the allocation forces
    // collections while they are all set aside.
    val prog = "async one(i)\n    var junk = []\n    var k = 0\n    while k < 60\n        push(junk, { n: k + i, s: string(k) })\n        k = k + 1\n    await sleep(2)\n    len(junk) + junk[0].n\nasync main()\n    var started = []\n    var i = 0\n    while i < 60\n        push(started, one(i))\n        i = i + 1\n    var total = 0\n    var j = 0\n    while j < 60\n        total = total + await started[j]\n        j = j + 1\n    print(total)\nmain()"

    assert_eq(out(prog), "5370")

@test
sleeping_and_settling_check_what_they_are_given()
    assert(fails("async main()\n    await sleep(\"soon\")\nasync top()\n    await main()\ntop()").contains("`sleep` takes a number of milliseconds"))
    assert(fails("async main()\n    await sleep()\nasync top()\n    await main()\ntop()").contains("was given 0 arguments"))
    assert(fails("async main()\n    await resolve(1, 2)\nasync top()\n    await main()\ntop()").contains("`resolve` takes one argument"))

@test
a_promise_may_not_be_awaited_by_two_calls_and_see_different_answers()
    // One promise, two waiters: both are queued with what it held when it settled, so nothing that
    // happens afterwards can change what either sees.
    val prog = "async main()\n    val p = sleep(2)\n    val a = async () -> \"a:\" + string(await p)\n    val b = async () -> \"b:\" + string(await p)\n    print(await a(), await b())\nmain()"

    assert_eq(out(prog), "a:null b:null")

@test
a_for_loop_leaves_the_stack_where_it_found_it()
    // **`IterInit` keeps its subject and pushes a counter beside it**, and the compiler once believed
    // it consumed the subject -- so every `for` a program ran stranded one value on the operand stack
    // for the rest of the enclosing chunk. Nothing was ever *wrong*, which is why no test caught it:
    // the stack simply grew, until fifty thousand turns of a loop containing one segfaulted the
    // process with no output at all.
    //
    // A `while` around it is what makes the leak accumulate; the top-level `Ret` truncates to zero, so
    // measuring the depth after a run cannot see it.
    assert_eq(out("var n = 0\nwhile n < 50000\n    for x in [1]\n        n = n + 1\nprint(n)"), "50000")

    // The value the statement leaves is its own and not the subject it walked.
    assert_eq(out("val v =\n    for x in [1, 2]\n        x\nprint(v)"), "null")

// -- the syntax sysl has ----------------------------------------------------------------------------
//
// **Everything below is measured against sysl's own grammar**, which is where it came from: slate's
// syntax should be sysl's minus what a dynamically typed language with no pointers has no use for.

@test
a_one_line_body_is_a_statement_and_not_only_an_expression()
    // **The gap that was worth the most.** sysl's `body(keyword)` is `suite | inlineBody` where the
    // inline form is one statement, so `if n > 2 then break` is a line a person writes -- and a
    // `then` taking only an expression refuses it along with `then return` and `then continue`.
    assert_eq(out("var n = 0\nloop\n    n += 1\n    if n > 2 then break\nprint(n)"), "3")
    assert_eq(out("f(n)\n    if n > 2 then return \"big\"\n    \"small\"\nprint(f(5), f(1))"), "big small")
    assert_eq(out("var n = 0\nfor x in [1, 2, 3]\n    if x == 2 then continue\n    n += x\nprint(n)"), "4")

    // An arm's body follows the same rule, for the same reason.
    assert_eq(out("val v = for x in [1, 2, 3]\n    x match\n        2 -> break \"two\"\n        _ -> null\nprint(v)"), "two")

@test
do_introduces_a_one_line_loop_body()
    assert_eq(out("var n = 0\nwhile n < 3 do n += 1\nprint(n)"), "3")
    assert_eq(out("for x in [1, 2] do print(x)"), "1\n2")
    assert_eq(out("var n = 0\nloop do\n    n += 1\n    if n > 1 then break\nprint(n)"), "2")

@test
an_end_marker_closes_a_block_and_end_is_still_a_name()
    assert_eq(out("if true\n    print(\"y\")\nend if"), "y")
    assert_eq(out("var n = 0\nwhile n < 2\n    n += 1\nend while\nprint(n)"), "2")
    assert_eq(out("for x in [1]\n    print(x)\nend for"), "1")
    assert_eq(out("var n = 0\nloop\n    n += 1\n    if n > 0 then break\nend loop\nprint(n)"), "1")
    assert_eq(out("f(x)\n    x + 1\nend f\nprint(f(1))"), "2")

    // **`end` is a soft word**, matched only immediately before the construct it closes -- so a
    // program may still call something `end`, which is sysl's rule and the reason for the shape.
    assert_eq(out("val end = 5\nprint(end)"), "5")

@test
do_while_runs_its_body_before_it_tests()
    assert_eq(out("var n = 0\ndo n += 1 while n < 3\nprint(n)"), "3")
    assert_eq(out("var n = 0\ndo\n    n += 1\nwhile n < 3\nprint(n)"), "3")

    // The difference from a `while`: the body runs once whatever the condition says.
    assert_eq(out("var n = 10\ndo n += 1 while n < 3\nprint(n)"), "11")

    // `continue` goes to the test rather than to the top, which is why it is not desugared.
    assert_eq(out("var n = 0\nvar seen = 0\ndo\n    n += 1\n    if n < 3 then continue\n    seen += 1\nwhile n < 5\nprint(n, seen)"), "5 3")

@test
a_compound_assignment_evaluates_its_place_once()
    assert_eq(out("var n = 10\nn += 5\nn -= 1\nn *= 2\nn /= 7\nn %= 3\nprint(n)"), "1")
    assert_eq(out("var n = 6\nn &= 3\nn |= 8\nn ^= 1\nn <<= 2\nn >>= 1\nprint(n)"), "22")
    assert_eq(out("val o = { n: 1 }\no.n += 2\nprint(o.n)"), "3")
    assert_eq(out("val xs = [1, 2]\nxs[0] += 5\nprint(xs)"), "[6, 2]")

    // **The reason it is not desugared into `x = x + e`.** That rewriting evaluates the place twice,
    // so a place with a call in it would be reached twice.
    assert_eq(out("var calls = 0\nnext()\n    calls += 1\n    0\nval xs = [10]\nxs[next()] += 1\nprint(xs, calls)"), "[11] 1")

@test
several_places_are_written_at_once()
    // Every value is computed before any place is written, which is what makes a swap a swap.
    assert_eq(out("var a = 1\nvar b = 2\na, b = b, a\nprint(a, b)"), "2 1")
    assert_eq(out("val o = { x: 1, y: 2 }\no.x, o.y = o.y, o.x\nprint(o)"), "{x: 2, y: 1}")
    assert_eq(out("var a = 1\nvar b = 2\na, b += 10, 20\nprint(a, b)"), "11 22")

    assert(fails("var a = 1\nvar b = 2\na, b = 1").contains("writes 2 places and was given 1"))

@test
a_comma_after_an_expression_does_not_commit_to_an_assignment()
    // **It is read speculatively and commits only on the `=`.** A `match` written as a non-final
    // argument leaves a comma behind too, and a rule that committed here would answer that with a
    // sentence about assignment -- replacing the one diagnostic that says what is actually wrong.
    assert(fails("f(x match\n    1 -> 2, 9)").contains("has to be the last argument"))

@test
a_name_a_field_or_an_element_may_be_stepped()
    assert_eq(out("var n = 1\nprint(n++, n)"), "1 2")
    assert_eq(out("var n = 1\nprint(++n, n)"), "2 2")
    assert_eq(out("var n = 1\nprint(n--, n)"), "1 0")
    assert_eq(out("val o = { n: 5 }\nprint(o.n++, o.n)"), "5 6")
    assert_eq(out("val xs = [5]\nprint(--xs[0], xs)"), "4 [4]")

@test
the_bitwise_operators_bind_the_way_sysl_says()
    assert_eq(out("print(6 & 3, 6 | 3, 6 ^ 3, ~0)"), "2 7 5 -1")
    assert_eq(out("print(1 << 4, 32 >> 2)"), "16 8")

    // **A shift binds like a multiplication**, which is sysl's deliberate correction to C -- where
    // `1 << 2 + 3` groups in the way nobody predicts.
    assert_eq(out("print(1 << 2 + 3)"), "7")

    assert(fails("print(1.5 & 2)").contains("works on whole numbers"))
    assert(fails("print(1 << 99)").contains("a shift is by 0 to 63 places"))

@test
a_run_of_comparisons_is_one_comparison()
    assert_eq(out("print(1 < 2 < 3, 1 < 3 < 2, 3 == 3 < 5)"), "true false true")

    // **The middle operand is evaluated once**, which is the whole difference from writing the
    // conjunction out by hand.
    assert_eq(out("var calls = 0\nmid()\n    calls += 1\n    2\nprint(1 < mid() < 3, calls)"), "true 1")

@test
is_asks_a_pattern_where_a_condition_is_wanted()
    assert_eq(out("val v = [1, 2]\nprint(if v is array then \"arr\" else \"no\")"), "arr")
    assert_eq(out("print(3 is not string)"), "true")
    assert_eq(out("print(2 is 1 | 2 | 3, 9 is 1 | 2)"), "true false")
    assert_eq(out("print({ name: \"ada\" } is { name })"), "true")

    // **It sits between `&&` and the comparisons**, so this is two terms rather than an `is` against
    // a conjunction.
    assert_eq(out("val v = 5\nprint(v is number && v > 1)"), "true")

@test
a_range_is_a_value_and_a_for_walks_one()
    assert_eq(out("for i in 0..<3\n    print(i)"), "0\n1\n2")
    assert_eq(out("for i in 1..3 do print(i)"), "1\n2\n3")
    assert_eq(out("val r = 1..<4\nprint(r, len(r))"), "1..<4 3")

    // `1..3` and `1..<4` cover the same numbers, so they are equal -- and therefore hash alike, which
    // is what lets one find the other in a table.
    assert_eq(out("print(1..3 == 1..<4)"), "true")
    assert_eq(out("val o = {}\no[1..3] = \"a\"\nprint(o[1..<4])"), "a")

@test
an_end_left_out_of_a_range_is_taken_from_what_it_is_used_on()
    assert_eq(out("val xs = [1, 2, 3, 4, 5]\nprint(xs[1..<3], xs[2..], xs[..2], xs[..])"), "[2, 3] [3, 4, 5] [1, 2, 3] [1, 2, 3, 4, 5]")
    assert_eq(out("print(\"hello\"[1..<3])"), "el")

    // **A `for` refuses one**, since a walk with an end taken from nothing would never finish.
    assert(fails("for i in 1..\n    print(i)").contains("both ends"))
    assert(fails("print(len(1..))").contains("no length until it is used"))
    assert(fails("val xs = [1]\nprint(xs[0..<9])").contains("outside something 1 long"))

@test
an_inclusive_range_written_rusts_way_is_refused_by_name()
    // What the ordinary grammar would answer is a sentence about the open-ended range that parsed --
    // true about something else, and never mentioning the `=` that caused it.
    val said = fails("for i in 1..=3\n    print(i)")

    assert(said.contains("`..=` is not a range"))
    assert(said.contains("`a..<b`"))

@test
a_loop_is_an_expression_and_a_break_gives_it_its_value()
    assert_eq(out("val found = for x in [1, 5, 9] do if x > 3 then break x\nprint(found)"), "5")
    assert_eq(out("val v = for x in [1, 2] do x\nprint(v)"), "null")
    assert_eq(out("var n = 0\nval v = loop\n    n += 1\n    if n > 2 then break n * 10\nprint(v)"), "30")
    assert_eq(out("var n = 0\nval v = while true\n    n += 1\n    if n > 3 then break n\nprint(v)"), "4")

    // **The value is compiled before anything is unwound**, because the scopes about to close are the
    // ones holding the names it may use.
    assert_eq(out("val v = for x in [1, 2, 3]\n    if x == 2\n        val extra = x * 100\n        break extra\nprint(v)"), "200")

@test
a_loops_else_runs_when_it_finished_on_its_own()
    assert_eq(out("for x in [1, 2]\n    print(x)\nelse\n    print(\"all\")"), "1\n2\nall")
    assert_eq(out("for x in [1, 2, 3]\n    if x == 2 then break\nelse\n    print(\"never\")\nprint(\"after\")"), "after")
    assert_eq(out("var n = 0\nwhile n < 2 do n += 1\nelse\n    print(\"done\")\nprint(n)"), "done\n2")

@test
the_value_of_a_loops_else_is_the_loops_value()
    // **Checked against sysl rather than assumed.** The same two loops written in sysl answer `3` and
    // `-1`, so an `else` supplies a value rather than running for effect -- which is what makes the
    // search idiom read: `break` gives the answer that was found and `else` the one for none.
    val find = "find(xs, w)\n    for i in 0..<len(xs) do\n        if xs[i] == w then break i\n    else\n        -1\n"

    assert_eq(out(find + "print(find([1, 2, 3], 2), find([1], 9))"), "1 -1")
    assert_eq(out("var n = 0\nval v = while n < 2 do n += 1\nelse\n    \"done\"\nprint(v)"), "done")
    assert_eq(out("var n = 0\nval v = do n += 1 while n < 2\nelse\n    \"ended\"\nprint(v, n)"), "ended 2")

    // A loop with no `else` answers null, and one that broke answers what the `break` carried.
    assert_eq(out("print(for x in [1] do x)"), "null")
    assert_eq(out("val v = for x in [1, 2]\n    break \"broke\"\nelse\n    \"finished\"\nprint(v)"), "broke")

@test
a_label_says_which_loop_a_break_leaves()
    val prog = "var hits = 0\nval r = 'outer for x in [1, 2, 3]\n    for y in [1, 2, 3]\n        hits += 1\n        if x * y > 3 then break 'outer x * y\nprint(r, hits)"

    assert_eq(out(prog), "4 5")

    // A `continue` may name one too, and takes the next turn of *that* loop.
    assert_eq(out("var n = 0\n'outer for x in [1, 2]\n    for y in [1, 2]\n        if y == 1 then continue 'outer\n        n += 100\n    n += 1\nprint(n)"), "0")

    assert(fails("for x in [1]\n    break 'nope").contains("no enclosing loop is called `'nope`"))
    assert(fails("'here print(1)").contains("a loop for this label to name"))

@test
an_array_may_be_written_as_copies_of_one_value()
    assert_eq(out("print([0; 4], [1; 0])"), "[0, 0, 0, 0] []")
    assert(fails("print([0; -1])").contains("is not something to make"))
    assert(fails("print([0; \"x\"])").contains("a repeat count is a whole number"))

@test
with_answers_a_copy_rather_than_changing_what_it_was_given()
    assert_eq(out("val base = { a: 1, b: 2 }\nval next = base with { b: 20, c: 3 }\nprint(base, next)"),
              "{a: 1, b: 2} {a: 1, b: 20, c: 3}")

    // **A tail rather than a binary operator**, so it binds as tightly as a field selection does.
    assert_eq(out("val o = { n: 1 }\nprint(o with { n: 9 })"), "{n: 9}")
    assert(fails("print(5 with { a: 1 })").contains("`with` copies an object"))

@test
a_trailing_comma_is_allowed_in_every_list()
    assert_eq(out("f(a, b,) = a + b\nprint([1, 2,], { x: 1, }, f(1, 2,))"), "[1, 2] {x: 1} 3")
    assert_eq(out("val g = (a, b,) -> a + b\nprint(g(1, 2))"), "3")
    assert_eq(out("[1, 2,] match\n    [a, b,] -> print(a + b)"), "3")

@test
a_string_may_carry_the_values_written_into_it()
    assert_eq(out("val n = 5\nprint(s\"n is ${n}\")"), "n is 5")
    assert_eq(out("val a = 1\nval b = 2\nprint(s\"${a} and ${b} make ${a + b}\")"), "1 and 2 make 3")
    assert_eq(out("print(s\"plain\", s\"\")"), "plain ")

    // A hole renders as `print` would, so a container shows its contents.
    assert_eq(out("print(s\"${[1, 2]} ${null}\")"), "[1, 2] null")

    // **`s` is only a prefix where a quote follows**, so it stays an ordinary name.
    assert_eq(out("val s = 5\nprint(s)"), "5")

    // A doubled sigil is a literal one, which is the only way to write a `${` where a hole would
    // otherwise open. `sh.sysl.parsing` owns that rule, which is why it is Scala's spelling.
    assert_eq(out("print(s\"a $${x} b\")"), "a ${x} b")

    assert(fails("print(s\"unclosed ${x\")").contains("without closing"))

@test
a_hole_may_hold_anything_an_expression_may()
    assert_eq(out("print(s\"got ${ \"a}b\" } end\")"), "got a}b end")
    assert_eq(out("print(s\"o = ${ { a: 1 } }\")"), "o = {a: 1}")
    assert_eq(out("val n = 2\nprint(s\"outer ${ s\"inner ${n}\" }\")"), "outer inner 2")
    assert_eq(out("print(s\"${ if true then \"yes\" else \"no\" }\")"), "yes")

@test
a_complaint_inside_a_hole_points_at_the_hole()
    // **The reason a hole is parsed against a source padded out to its own offset.** Lexing its text
    // on its own would give spans measured from the hole, so every diagnostic in an interpolation
    // would name a column nobody could find.
    val said = fails("val a = 1\nprint(s\"x ${nope} y\")")

    assert(said.contains("`nope` is not defined"))
    assert(said.contains("2 | print(s\"x ${nope} y\")"))

@test
a_hole_with_nothing_in_it_complains_about_itself()
    // **It used to complain about the end of the file.** The sub-source a hole is parsed against is
    // the whole input with everything outside the hole blanked, so an empty hole lexes to one `Eof`
    // at the end of the *file* -- and the complaint pointed there, which for a string on line one
    // was `found the end of the file` at line three, under a blank line. True, and nowhere useful.
    val spaced = fails("val greeting = s\"hello ${ }\"")

    assert(spaced.contains("this interpolation has nothing in it"))
    assert(spaced.contains("1 | val greeting = s\"hello ${ }\""))
    assert(!spaced.contains("the end of the file"))

    // And with no space in it at all, which lexes to a different token stream.
    assert(fails("print(s\"a${}b\")").contains("this interpolation has nothing in it"))

// -- the file system ----------------------------------------------------------------------------

// **These are the only tests that touch a real disk**, so each of them gets a directory of its own
// and gives it back afterwards. A shared one would make two tests read each other's files, and
// inventing a path rather than asking for one is the race `mkdtemp` exists to avoid.
//
// `<dir>` anywhere in the program text is the directory that was made.
private in_scratch(text: string) -> string
    val dir = libuv.mkdtemp_sync("/tmp/slate-fs-XXXXXX").unwrap()
    val said = out(replace_all(text, "<dir>", dir))

    scrub(dir)
    said
end in_scratch

// The same, for a program expected to fail.
private fails_in_scratch(text: string) -> string
    val dir = libuv.mkdtemp_sync("/tmp/slate-fs-XXXXXX").unwrap()
    val said = fails(replace_all(text, "<dir>", dir))

    scrub(dir)
    said
end fails_in_scratch

// What one file-system call said went wrong, awaited and read off the result.
//
// **A call that fails is a call that ANSWERS now**, so this reads `.error` rather than reaching for
// the program's diagnostic -- which is the whole of what the retrofit changed.
private said_error(call: string) -> string =
    out(s"async main()\n    print((await ${call}).error)\nmain()")

// Everything a program left behind, and the directory with it.
private scrub(dir: string)
    libuv.scandir_sync(dir) match
        Ok(entries) ->
            for i in 0..<entries.len
                val path = s"${dir}/${entries[i].name}"

                // A directory refuses `unlink`, and telling the two apart that way costs nothing --
                // there is no shape of these tests where a second `stat` would be worth making.
                if libuv.unlink_sync(path).is_err() then scrub(path)
        Err(_) -> ()

    libuv.rmdir_sync(dir)
end scrub

@test
a_file_written_is_a_file_read_back()
    assert_eq(in_scratch("async main()\n    await writeFile(\"<dir>/a.txt\", \"hello slate\")\n    print((await readFile(\"<dir>/a.txt\")).value)\nmain()"), "hello slate")

    // A second write replaces what was there rather than appending to it.
    assert_eq(in_scratch("async main()\n    await writeFile(\"<dir>/a.txt\", \"long enough to notice\")\n    await writeFile(\"<dir>/a.txt\", \"short\")\n    print((await readFile(\"<dir>/a.txt\")).value)\nmain()"), "short")

    // Anything that is not a string is written as `print` would render it.
    assert_eq(in_scratch("async main()\n    await writeFile(\"<dir>/a.txt\", [1, 2, 3])\n    print((await readFile(\"<dir>/a.txt\")).value)\nmain()"), "[1, 2, 3]")

@test
the_answer_to_the_last_request_outstanding_is_still_handed_back()
    // **The bug this pins made the whole file system look like it did nothing.** A timer is a handle
    // and libuv counts it; an `fs` call is a *request*, and the turn of the loop that answers the
    // last one outstanding reports nothing active afterwards. The drain used to take that as its
    // signal to stop -- so the callback ran, the promise settled, and the coroutine awaiting it was
    // never handed the value, because handing it back is what the *next* turn does. A program that
    // awaited one file and printed the answer printed nothing at all and exited 0.
    assert_eq(in_scratch("async main()\n    await writeFile(\"<dir>/a.txt\", \"only\")\n    print((await readFile(\"<dir>/a.txt\")).value)\nmain()"), "only")

    // The same for a call that makes no request of its own to follow it.
    assert_eq(in_scratch("async main()\n    print(await exists(\"<dir>\"))\nmain()"), "true")

@test
every_file_system_call_answers_a_promise()
    // **There is no blocking form**, which is the one place slate is stricter than node: a call not
    // awaited answers a promise like any other, rather than a value.
    assert_eq(in_scratch("print(exists(\"<dir>\"))"), "<promise pending>")
    assert_eq(in_scratch("print(readDir(\"<dir>\"))"), "<promise pending>")

@test
read_bytes_reads_what_read_file_will_not()
    assert_eq(in_scratch("async main()\n    await writeFile(\"<dir>/a.txt\", \"AB\")\n    print((await readBytes(\"<dir>/a.txt\")).value)\nmain()"), "[65, 66]")

    // An empty file is an empty array rather than a failure.
    assert_eq(in_scratch("async main()\n    await writeFile(\"<dir>/a.txt\", \"\")\n    print((await readBytes(\"<dir>/a.txt\")).value, (await readFile(\"<dir>/a.txt\")).value)\nmain()"), "[] ")

@test
a_file_that_is_not_text_is_refused_by_name()
    // `/bin/ls` is not text on any machine this runs on, and reading it is the shortest way to say
    // so without writing bytes slate has no way to write.
    val said = out("async main()\n    print((await readFile(\"/bin/ls\")).error)\nmain()")

    assert(said.contains("is not text"))
    assert(said.contains("`readBytes`"))

@test
a_directory_is_made_listed_and_taken_away()
    val prog = "async main()\n    await mkdir(\"<dir>/sub\")\n    await writeFile(\"<dir>/sub/one\", \"1\")\n    print((await readDir(\"<dir>/sub\")).value)\n    await remove(\"<dir>/sub/one\")\n    print((await readDir(\"<dir>/sub\")).value)\n    await rmdir(\"<dir>/sub\")\n    print(await exists(\"<dir>/sub\"))\nmain()"

    assert_eq(in_scratch(prog), "[\"one\"]\n[]\nfalse")

@test
stat_says_how_big_a_file_is_and_what_kind_it_is()
    val prog = "async main()\n    await writeFile(\"<dir>/a.txt\", \"12345\")\n    val f = (await stat(\"<dir>/a.txt\")).value\n    val d = (await stat(\"<dir>\")).value\n    print(f.size, f.isFile, f.isDir)\n    print(d.isFile, d.isDir)\nmain()"

    assert_eq(in_scratch(prog), "5 true false\nfalse true")

@test
exists_answers_rather_than_failing()
    // **The whole of what this adds over `stat`.** Asking whether something is there and being made
    // to survive a failure to find out would be a question the language answered with an error.
    assert_eq(in_scratch("async main()\n    print(await exists(\"<dir>\"), await exists(\"<dir>/nope\"))\nmain()"), "true false")

@test
rename_moves_a_file_and_leaves_nothing_behind()
    val prog = "async main()\n    await writeFile(\"<dir>/a.txt\", \"kept\")\n    await rename(\"<dir>/a.txt\", \"<dir>/b.txt\")\n    print((await readDir(\"<dir>\")).value, (await readFile(\"<dir>/b.txt\")).value)\nmain()"

    assert_eq(in_scratch(prog), "[\"b.txt\"] kept")

@test
a_file_system_failure_is_ANSWERED_and_does_not_stop_the_program()
    // **The promise settles rather than rejecting**, so a program that does not look at the answer
    // carries on -- which is the point of the result and the thing that changed. Every one of these
    // still carries libuv's own sentence, because a program that cannot open a file wants to know
    // whether the path was wrong or the permissions were.
    assert(said_error("readFile(\"/no/such/file\")").contains("ENOENT"))
    assert(said_error("readDir(\"/no/such/dir\")").contains("cannot list /no/such/dir"))
    assert(said_error("mkdir(\"/no/such/dir\")").contains("cannot make /no/such/dir"))
    assert(said_error("stat(\"/no/such/file\")").contains("cannot stat /no/such/file"))
    assert(said_error("writeFile(\"/no/such/dir/x\", \"hi\")").contains("cannot write /no/such/dir/x"))
    assert(said_error("remove(\"/no/such/file\")").contains("cannot remove /no/such/file"))
    assert(said_error("rename(\"/no/such/file\", \"/tmp/x\")").contains("cannot rename /no/such/file"))

    // A directory that is not empty is the failure `rmdir` is for.
    val busy = in_scratch("async main()\n    await writeFile(\"<dir>/a.txt\", \"x\")\n    print((await rmdir(\"<dir>\")).error)\nmain()")

    assert(busy.contains("cannot remove"))

@test
a_program_that_ignores_a_failed_result_keeps_running()
    // **This is what the change bought.** The same program under the old surface stopped at the
    // first missing file with a diagnostic; nothing was awaiting the promise it rejected, so the
    // fault became the program's.
    val prog = "async main()\n    await readFile(\"/no/such/file\")\n    await mkdir(\"/no/such/dir\")\n    print(\"still here\")\nmain()"

    assert_eq(out(prog), "still here")

@test
a_result_is_taken_apart_by_an_ordinary_pattern()
    // **No syntax was added for this**, which is the argument for a result being an object: `match`
    // already destructures one by shape.
    val prog = "async main()\n    await readFile(\"/no/such/file\") match\n        { ok: true, value: v } -> print(v)\n        { error: e } -> print(\"no: \" + e)\nmain()"

    assert(out(prog).contains("no: cannot read /no/such/file"))

@test
a_file_system_builtin_says_what_it_wanted_when_given_something_else()
    assert(fails("async main()\n    await readFile(42)\nmain()").contains("`readFile` takes a path, and this is an integer"))
    assert(fails("async main()\n    await mkdir(null)\nmain()").contains("`mkdir` takes a path"))
    assert(fails("async main()\n    await readFile()\nmain()").contains("`readFile` takes one path and was given 0 arguments"))
    assert(fails("async main()\n    await writeFile(\"a\")\nmain()").contains("`writeFile` takes a path and its contents"))
    assert(fails("async main()\n    await rename(\"a\")\nmain()").contains("`rename` takes two paths"))

@test
requests_in_flight_together_all_answer()
    // Eight writes started before any of them is awaited, which is what the promises are for -- and
    // what a drain that stopped at the first quiet turn would have lost all but one of.
    val prog = "async main()\n    var ps = []\n    for i in 0..<8\n        push(ps, writeFile(\"<dir>/f\" + string(i), string(i)))\n    for p in ps\n        await p\n    val names = (await readDir(\"<dir>\")).value\n    var total = 0\n    for n in names\n        total = total + len((await readFile(\"<dir>/\" + n)).value)\n    print(len(names), total)\nmain()"

    assert_eq(in_scratch(prog), "8 8")

@test
the_collector_runs_while_a_request_is_outstanding()
    // **A pending request roots its promise through the table `event.sysl` keeps**, and nothing else
    // knows about it: the closure libuv holds captures a slot id rather than a value, precisely so
    // that a collection between the call and its answer cannot free what the answer is for.
    val prog = "async main()\n    val p = readFile(\"<dir>/a.txt\")\n    for i in 0..<2000\n        val junk = { a: i, b: [i, i, i], c: \"x\" + string(i) }\n    print((await p).value)\nmain()"
    val dir = libuv.mkdtemp_sync("/tmp/slate-fs-XXXXXX").unwrap()

    libuv.write_file_sync(s"${dir}/a.txt", "survived".bytes).unwrap()

    val said = out(replace_all(prog, "<dir>", dir))

    scrub(dir)
    assert_eq(said, "survived")

@test
timers_and_the_file_system_share_one_loop()
    // A handle and a request in the same drain, which is the case the two halves of `drain_events`
    // have to agree about.
    //
    // **This one passed while the file system did not work**, and that is worth knowing: a live
    // timer is an active handle, so the loop kept saying it had work and the request's answer was
    // never the thing that ended the drain. A file system test that has a timer in it cannot see
    // the bug above, which is why the tests that pin it have no timer.
    // **The order the two arrive in is not asserted, because it is not guaranteed.** A timer set
    // for a millisecond and a write that goes through a thread pool race, and which wins says
    // something about how busy the machine is rather than about slate. What *is* guaranteed is that
    // both arrive and neither is dropped, which is the claim worth pinning.
    val prog = "async main()\n    setTimeout(() -> print(\"timer\"), 1)\n    await writeFile(\"<dir>/a.txt\", \"file\")\n    print(await readFile(\"<dir>/a.txt\"))\n    await sleep(3)\nmain()"
    val said = in_scratch(prog)

    assert(said.contains("file"))
    assert(said.contains("timer"))

// -- the examples -------------------------------------------------------------------------------

// **The examples are reading material, and reading material rots.** Every one of them is a slate
// program the suite otherwise never runs, so a change to the language leaves them saying something
// that no longer compiles and nothing notices until somebody opens the file. A stale
// `person.missing` survived the `undefined` change exactly that way and had to be found by hand.
//
// **The path is relative to the project root**, which is where `sysl test .` runs.
private ran_clean(path: string) -> string
    read_bytes(path) match
        // **The diagnostic names the CAUSE and not the artifact**, which costs a line and saved
        // somebody an hour. These paths are relative, so the suite is only valid run from the
        // project root -- and invoked from anywhere else the failure was `cannot read
        // examples/tour.sl: no such file or directory`, which reads as a missing example. It is not:
        // the file is there and the working directory is wrong. An org sweep running
        // `sysl test <abs-dir>` from outside the tree hit exactly this and reported slate broken.
        Err(e) -> s"cannot read ${path}: ${e} -- this suite reads its examples by relative path, so it must be run from the project root (`sysl test .` there), not at it"
        Ok(bytes) ->
            val src = source(path, bytes)
            val r = run(src)

            if r.ok() then "" else r.render()
end ran_clean

@test
every_example_runs_with_nothing_to_report()
    assert_eq(ran_clean("examples/tour.sl"), "")
    assert_eq(ran_clean("examples/match.sl"), "")

    // **`files.sl` makes and removes a `scratch/` directory beside the project**, and does it in
    // that order so that running it twice is the same as running it once. A file left behind would
    // make the next run of this test fail on the `mkdir`.
    assert_eq(ran_clean("examples/files.sl"), "")

    // **`echo.sl` is a server and a client in one program**, and it closes both sockets -- which is
    // what stops this from hanging the suite rather than failing it.
    assert_eq(ran_clean("examples/echo.sl"), "")

    assert_eq(ran_clean("examples/objects.sl"), "")
    assert_eq(ran_clean("examples/types.sl"), "")
    assert_eq(ran_clean("examples/text.sl"), "")

    // **`testing.sl` is both an example and a fixture.** Run plainly it prints; run under
    // `slate test` it is six tests, which `every_test_in_the_testing_example_passes` checks.
    assert_eq(ran_clean("examples/testing.sl"), "")

    // **`try.sl` is the reading material for the other failure channel**, `files.sl` being the one
    // for results. Between them they run every shape a slate program handles a failure in.
    assert_eq(ran_clean("examples/try.sl"), "")

    // **`modules.sl` imports two files under `examples/lib/`**, which are modules and not examples:
    // they are not run on their own, and nothing here should look for them beside the others.
    assert_eq(ran_clean("examples/modules.sl"), "")

// -- TCP ------------------------------------------------------------------------------------------

// **A socket keeps the program alive, so a test that forgets to close one hangs the whole suite
// forever with nothing printed.** That is a bad enough failure to be worth three lines of insurance:
// every program here gets a watchdog timer that stops it with a complaint, and a `done()` to cancel
// the watchdog where the program is expected to finish. A test that stops finishing therefore fails
// in three seconds saying so, rather than never returning.
//
// The watchdog is cancelled and not merely ignored, because an uncancelled timer is itself a handle
// the loop would wait three seconds for.
//
// **It stops the program by naming something that does not exist**, so that its complaint cannot be
// mistaken for the one a test was looking for. A watchdog that divided by zero would have satisfied
// the assertion in `a_fault_in_a_socket_callback_stops_the_program` without the fault under test
// ever happening.
private netted(body: string) -> string =
    "stalled() = theProgramDidNotFinish\nval theGuard = setTimeout(stalled, 3000)\ndone() = clearTimeout(theGuard)\n" + body

// What a networked program printed.
private net_out(body: string) -> string = out(netted(body))

// The complaint a networked program drew.
private net_fails(body: string) -> string = fails(netted(body))

// An echo server, and the port it ended up on. Every test below opens with some version of this.
private const Echo: string = "serve(conn)\n    heard(chunk)\n        if chunk == null\n            close(conn)\n        else\n            send(conn, \"echo: \" + chunk)\n    onData(conn, heard)\nval server = listen(0, serve)\nval port = localPort(server)\n"

@test
a_client_and_a_server_talk_to_each_other()
    val body = Echo + "async main()\n    val c = (await connect(\"127.0.0.1\", port)).value\n    reply(chunk)\n        print(chunk)\n        close(c)\n        close(server)\n        done()\n    onData(c, reply)\n    await send(c, \"hello\")\nmain()"

    assert_eq(net_out(body), "echo: hello")

@test
a_port_of_zero_is_the_kernels_to_pick_and_local_port_says_which()
    // **The whole reason `localPort` exists.** A test that named a port would fail whenever anything
    // else on the machine happened to have it, which is the kind of failure nobody can reproduce.
    val body = "val s = listen(0, print)\nprint(localPort(s) > 0, localPort(s) < 65536)\nclose(s)\ndone()"

    assert_eq(net_out(body), "true true")

@test
the_end_of_a_stream_is_null_and_not_a_failure()
    // **libuv's own distinction, and the right one**: a peer closing its half is how a request
    // ordinarily ends, so it arrives as a value rather than as a fault.
    val body = "serve(conn)\n    heard(chunk)\n        send(conn, \"bye\")\n        close(conn)\n    onData(conn, heard)\nval server = listen(0, serve)\nasync main()\n    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n    reply(chunk)\n        if chunk == null\n            print(\"end\")\n            close(c)\n            close(server)\n            done()\n        else\n            print(chunk)\n    onData(c, reply)\n    await send(c, \"go\")\nmain()"

    assert_eq(net_out(body), "bye\nend")

@test
on_bytes_reads_a_socket_that_carries_something_other_than_text()
    val body = Echo + "async main()\n    val c = (await connect(\"127.0.0.1\", port)).value\n    reply(chunk)\n        if chunk != null\n            print(chunk)\n            close(c)\n            close(server)\n            done()\n    onBytes(c, reply)\n    await send(c, \"AB\")\nmain()"

    assert_eq(net_out(body), "[101, 99, 104, 111, 58, 32, 65, 66]")

@test
several_connections_are_served_at_once()
    val body = Echo + "var heardBack = 0\nasync one(n)\n    val c = (await connect(\"127.0.0.1\", port)).value\n    var got = null\n    reply(chunk)\n        if chunk != null\n            got = chunk\n            heardBack = heardBack + 1\n            close(c)\n    onData(c, reply)\n    await send(c, string(n))\n    await sleep(20)\n    got\nasync main()\n    val a = one(1)\n    val b = one(2)\n    val d = one(3)\n    print(await a, await b, await d)\n    print(heardBack)\n    close(server)\n    done()\nmain()"

    assert_eq(net_out(body), "echo: 1 echo: 2 echo: 3\n3")

@test
a_closed_socket_is_not_whatever_took_its_slot()
    // **A use-after-free wearing an integer's clothes, and it was silent.** A spent slot is reused,
    // so a socket named by its position alone came to mean whatever took the position next: the
    // closed socket compared *equal* to the live one, and `localPort` on it answered the live one's
    // port. Every id a program is handed carries the generation that claimed the slot, and a
    // generation is never reused.
    val body = "val a = listen(0, print)\nclose(a)\nval b = listen(0, print)\nprint(a == b)\nclose(b)\ndone()"

    assert_eq(net_out(body), "false")

    // And the closed one is refused by name rather than answering about the live one.
    val used = "val a = listen(0, print)\nclose(a)\nval b = listen(0, print)\nlocalPort(a)"

    assert(net_fails(used).contains("this socket is closed, and `localPort` needs an open one"))

@test
a_cancelled_timers_id_cancels_nothing_else()
    // **The same defect, found in the same place and older.** `setTimeout` handed back a slot
    // number, so cancelling an already-cancelled timer cancelled whatever had since taken the slot
    // -- and the program waiting on that second timer simply never heard from it.
    val body = "val first = setTimeout(() -> print(\"first\"), 3000)\nclearTimeout(first)\nsetTimeout(() -> print(\"second\"), 1)\nclearTimeout(first)\ndone()"

    assert_eq(net_out(body), "second")

@test
connecting_to_nothing_is_ANSWERED_and_does_not_stop_the_program()
    // A refused connection is the ordinary case a client has to handle, so it settles the promise
    // with a result rather than rejecting it -- and the program is still running afterwards.
    val body = "async main()\n    val r = await connect(\"127.0.0.1\", 1)\n    print(r.ok)\n    print(r.error)\n    done()\nmain()"
    val said = net_out(body)

    assert(said.contains("false"))
    assert(said.contains("cannot connect to 127.0.0.1:1"))
    assert(said.contains("ECONNREFUSED"))

@test
a_port_already_taken_is_refused_by_name()
    val body = "val a = listen(0, print)\nlisten(localPort(a), print)"

    assert(net_fails(body).contains("EADDRINUSE"))

@test
a_socket_builtin_says_what_it_wanted_when_given_something_else()
    assert(net_fails("listen(\"x\", print)").contains("`listen` takes a port number, and this is a string"))
    assert(net_fails("listen(80)").contains("`listen` takes a port and a function, and was given 1 arguments"))
    assert(net_fails("listen(0, 5)").contains("`listen` needs a function to call with each connection"))
    assert(net_fails("listen(99999, print)").contains("a port is between 0 and 65535, and this is 99999"))
    assert(net_fails("connect(1, 2)").contains("`connect` takes an address, and this is an integer"))
    assert(net_fails("send(5, \"x\")").contains("`send` takes a socket, and this is an integer"))
    assert(net_fails("close(5)").contains("`close` takes a socket, and this is an integer"))
    assert(net_fails("localPort(5)").contains("`localPort` takes a socket, and this is an integer"))
    assert(net_fails("onData(5, print)").contains("`onData` takes a socket, and this is an integer"))
    assert(net_fails("onBytes(5, print)").contains("`onBytes` takes a socket, and this is an integer"))

@test
closing_a_socket_twice_is_not_an_error()
    // A server closing its connections and a read callback closing its own at end-of-stream is the
    // ordinary way to write this, so the second close must not be a failure.
    val body = "val s = listen(0, print)\nclose(s)\nclose(s)\nprint(\"fine\")\ndone()"

    assert_eq(net_out(body), "fine")

@test
a_fault_in_a_socket_callback_stops_the_program()
    // **There is no statement to attach it to** -- the loop is not running one -- so it is reported
    // against the whole run, as a timer's fault is. It also has to stop a program whose server would
    // otherwise keep the loop alive forever.
    val body = "serve(conn)\n    onData(conn, chunk -> 1 / 0)\nval server = listen(0, serve)\nasync main()\n    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n    await send(c, \"boom\")\nmain()"

    assert(net_fails(body).contains("this divides by zero"))

@test
the_collector_runs_while_a_connection_is_open()
    // **A socket's slot roots the slate callback the program gave it**, and nothing else does: the
    // sysl closure libuv holds captures the slot and the generation, so a collection between the
    // call and the answer cannot free what the answer is for.
    val body = Echo + "async main()\n    val c = (await connect(\"127.0.0.1\", port)).value\n    reply(chunk)\n        if chunk != null\n            print(chunk)\n            close(c)\n            close(server)\n            done()\n    onData(c, reply)\n    for i in 0..<3000\n        val junk = { a: i, b: [i, i], c: \"x\" + string(i) }\n    await send(c, \"survived\")\nmain()"

    assert_eq(net_out(body), "echo: survived")

@test
a_second_reader_replaces_the_first()
    // What makes a protocol that changes what it expects halfway through writable at all.
    val body = Echo + "async main()\n    val c = (await connect(\"127.0.0.1\", port)).value\n    second(chunk)\n        print(\"second:\", chunk)\n        close(c)\n        close(server)\n        done()\n    first(chunk)\n        print(\"never\")\n    onData(c, first)\n    onData(c, second)\n    await send(c, \"once\")\nmain()"

    assert_eq(net_out(body), "second: echo: once")

// -- the heap -------------------------------------------------------------------------------------

// A program run against a heap small enough to fill quickly, and the complaint it drew.
//
// **The limit is put back afterwards**, so nothing after this runs in a megabyte by accident -- which
// would turn an unrelated failure into a mystery about memory.
private in_small_heap(text: string) -> string
    set_heap_limit(1048576)

    val said = fails(text)

    set_heap_limit(268435456)
    said
end in_small_heap

@test
a_program_that_outruns_the_heap_is_told_rather_than_crashed()
    // **This was a bare SIGSEGV, with no diagnostic and none of the output the program had already
    // produced.** A full heap answers `null`, and every constructor wrote straight through it --
    // `alloc_or_collect` set `heap_exhausted` and returned null, and `new_str` did `o.s = s`. The
    // flag is read at the *next* statement boundary, which the process never reached.
    //
    // A reserve object of each kind, taken while the heap is empty and rooted for the life of the
    // program, is what a full heap is answered with now: somewhere real to write, so that the
    // statement finishes and the boundary reports it against the line that asked.
    // **The heap is shrunk for this rather than the program made bigger.** Filling 256 MiB to find
    // out what happens at the end of it takes five seconds; filling one megabyte takes no time, and
    // the behaviour under test is the same. `HeapBytes` is the ceiling and `heap_limit` is the
    // setting, which is what makes that possible.
    val prog = "var kept = []\nfor i in 0..<40000\n    push(kept, { a: i, b: [i, i, i], c: \"x\" + string(i) })\nprint(\"never got here\")"
    val said = in_small_heap(prog)

    assert(said.contains("this program has run out of memory"))

    // And it names the statement, which is the whole reason the flag is read where it is.
    assert(said.contains("push(kept,"))

@test
the_heap_is_usable_again_after_a_program_has_exhausted_it()
    // The reserves are taken back after every `dispose`, so a program that ran out of memory does
    // not leave the next one without an answer to a full heap -- which, before the reserves existed,
    // is what running two programs in one process would have meant.
    assert(in_small_heap("var kept = []\nfor i in 0..<40000\n    push(kept, { a: i, b: [i, i, i], c: \"x\" + string(i) })").contains("run out of memory"))
    assert_eq(out("print(\"fine\")"), "fine")
    assert_eq(out("var xs = []\nfor i in 0..<500\n    push(xs, { a: i })\nprint(len(xs))"), "500")

@test
collecting_costs_what_the_garbage_costs_and_not_what_the_program_does()
    // **The threshold read the wrong number, and then compared it against a fixed one.** `gc.used`
    // is the bump high-water mark and never falls, so `used > 256KiB` asks "has this heap EVER grown
    // that far" -- true forever once true. The interpreter then ran a full mark-sweep at *every
    // statement* for the rest of the program, reclaiming almost nothing each time.
    //
    // Reading `gc.live_size` fixes half of it. A fixed threshold is the other half: a program whose
    // genuine live set sits above the constant goes straight back into the same loop. So the
    // threshold is raised to a multiple of what survived each collection.
    //
    // This program holds a stable live set and then does fifty thousand statements that allocate
    // nothing at all, so a correct collector has nothing to do for the whole second half of it.
    val prog = "var kept = []\nfor i in 0..<3000\n    push(kept, { a: i })\nvar t = 0\nfor i in 0..<50000\n    t = t + i\nprint(t, len(kept))"

    assert_eq(out(prog), "1249975000 3000")

    // The old rule collected once per statement, which is upwards of fifty thousand times here. The
    // bound is loose on purpose -- what is being pinned is the *shape*, that collecting tracks
    // allocation rather than execution, and not a particular count.
    assert(collections < 100, s"collected ${collections} times for a program that allocates 3000 objects")

@test
a_live_set_that_keeps_growing_is_still_collected()
    // The other side of the same rule: a raised threshold must not become a licence to stop
    // collecting. This one drops everything it makes, so the live set stays small and the collector
    // has to keep giving the storage back -- a program that allocates 60,000 objects into a heap
    // that holds far fewer only finishes if it is being collected throughout.
    val prog = "var last = null\nfor i in 0..<60000\n    last = { a: i, b: [i, i, i] }\nprint(last.a)"

    assert_eq(out(prog), "59999")
    assert(collections > 0, "a program that allocates sixty thousand objects has to have collected")

// -- a block as a lambda's body, where the lambda is written ---------------------------------------

@test
an_arrow_at_the_end_of_a_line_opens_a_block_inside_brackets()
    // **A newline inside a bracket pair means nothing**, which is what makes `f(a,\n b)` work and is
    // also what stopped a callback from being written where it is passed. `->` is nominated to the
    // layout the way `match` is, so the line after it counts and the block opens.
    val prog = "each(items, f)\n    for x in items\n        f(x)\neach([1, 2, 3], x ->\n    val doubled = x * 2\n    print(x, doubled))"

    assert_eq(out(prog), "1 2\n2 4\n3 6")

    // Nested, which is the shape a server's connection handler has.
    val nested = "each(items, f)\n    for x in items\n        f(x)\neach([1, 2], a ->\n    each([10, 20], b ->\n        print(a, b)))"

    assert_eq(out(nested), "1 10\n1 20\n2 10\n2 20")

@test
a_one_line_lambda_is_unchanged()
    assert_eq(out("apply(f, v) = f(v)\nprint(apply(x -> x * 3, 2))"), "6")
    assert_eq(out("val f = x -> x + 1\nprint(f(1))"), "2")

@test
an_arrow_written_mid_line_does_not_open_a_block_on_a_later_one()
    // **The reason `->` is nominated only at the end of a line.** `opens_block` means "the next
    // newline counts", and the flag survives until a newline is actually met -- so an arrow written
    // mid-line would hand it to whatever line came next, opening a block at that line's column which
    // the closing bracket would then have to close.
    val prog = "apply(f, v) = f(v)\nprint(apply(x -> x, 1),\n      apply(x -> x + 1, 1))"

    assert_eq(out(prog), "1 2")

    // The same for `match`, which is nominated on the same condition.
    assert_eq(out("print(1,\n      2)"), "1 2")

@test
an_arrow_still_ends_the_line_when_a_comment_follows_it()
    val prog = "each(items, f)\n    for x in items\n        f(x)\neach([1], x -> // what to do with each\n    print(x))"

    assert_eq(out(prog), "1")

@test
a_block_lambda_has_to_be_the_last_argument()
    // **Inherent rather than a gap in the layout**: the block runs to the end of its last line, and
    // in `setTimeout(() ->\n    ...\n    print(x), 1)` that line ends `, 1)`. A bracket closes the
    // blocks opened inside it, but the `,` arrives first and there is nothing sensible for it to
    // mean. Every callback slate itself takes -- `listen`, `onData`, `onBytes`, `each` -- takes the
    // function last, so this is only reachable with node's `setTimeout(fn, ms)` order.
    val said = fails("setTimeout(() ->\n    print(\"a\")\n    print(\"b\"), 1)")

    assert(said.contains("this is where the statement should have ended"))

    // Written on one line it is fine, which is the answer for that argument order.
    assert_eq(out("setTimeout(() -> print(\"late\"), 1)\nprint(\"first\")"), "first\nlate")

@test
a_match_arms_arrow_does_not_open_a_block_of_its_own()
    // `match` opens the block the arms live in, and each arm's `->` is followed by its body on the
    // same line -- so the end-of-line condition keeps the arrow from opening a second one.
    assert_eq(out("print(2 match\n    1 -> \"one\"\n    2 -> \"two\"\n    _ -> \"many\")"), "two")

    // An arm whose body IS a block still works, which is that arrow legitimately ending its line.
    assert_eq(out("2 match\n    2 ->\n        val a = 1\n        print(a + 1)\n    _ -> print(\"no\")"), "2")

// -- the file system, blocking ---------------------------------------------------------------------

@test
the_blocking_calls_need_no_async_function_at_all()
    // **The point of them.** Not one `async`, `await` or promise in the program — a script whose job
    // is three file operations in order gains nothing from a promise and pays for it in an `async`
    // function that exists only to hold an `await`.
    val body = "mkdirSync(\"<dir>/sub\")\nwriteFileSync(\"<dir>/sub/a.txt\", \"hello sync\")\nprint(readFileSync(\"<dir>/sub/a.txt\").value)\nprint(readDirSync(\"<dir>/sub\").value)"

    assert_eq(in_scratch(body), "hello sync\n[\"a.txt\"]")

@test
each_blocking_call_answers_what_its_promise_would_have()
    // The two halves are meant to agree on everything but the waiting, so this asserts the pair
    // against each other rather than against a written-out expectation.
    val both = "writeFileSync(\"<dir>/a.txt\", \"12345\")\nasync main()\n    print(readFileSync(\"<dir>/a.txt\").value == (await readFile(\"<dir>/a.txt\")).value)\n    print(readBytesSync(\"<dir>/a.txt\").value == (await readBytes(\"<dir>/a.txt\")).value)\n    print(readDirSync(\"<dir>\").value == (await readDir(\"<dir>\")).value)\n    print(existsSync(\"<dir>\") == await exists(\"<dir>\"))\n    val a = statSync(\"<dir>/a.txt\").value\n    val b = (await stat(\"<dir>/a.txt\")).value\n    print(a.size == b.size, a.isFile == b.isFile, a.isDir == b.isDir)\nmain()"

    assert_eq(in_scratch(both), "true\ntrue\ntrue\ntrue\ntrue true true")

@test
a_blocking_failure_is_answered_exactly_as_the_promise_would_have()
    // **The two halves differ in the waiting and in nothing else.** A blocking call that fails
    // answers the same `{ ok: false, error }` its promise-shaped twin settles with, so a program
    // reads one the way it reads the other.
    assert(out("print(readFileSync(\"/no/such/file\").error)").contains("cannot read /no/such/file"))
    assert(out("print(readDirSync(\"/no/such\").error)").contains("cannot list /no/such"))
    assert(out("print(mkdirSync(\"/no/such/dir\").error)").contains("cannot make /no/such/dir"))
    assert(out("print(renameSync(\"/no/such\", \"/tmp/x\").error)").contains("cannot rename /no/such"))
    assert(out("print(statSync(\"/no/such\").error)").contains("cannot stat /no/such"))
    assert(out("print(removeSync(\"/no/such\").error)").contains("cannot remove /no/such"))

    // And a file that is not text points at the blocking reader, not the asynchronous one.
    val said = out("print(readFileSync(\"/bin/ls\").error)")

    assert(said.contains("is not text"))
    assert(said.contains("`readBytesSync`"))

    // Nothing above stopped the program, which is the whole difference from what this used to be.
    assert_eq(out("readFileSync(\"/no/such/file\")\nprint(\"still here\")"), "still here")

@test
exists_sync_answers_rather_than_failing()
    assert_eq(in_scratch("print(existsSync(\"<dir>\"), existsSync(\"<dir>/nope\"))"), "true false")

@test
a_blocking_builtin_says_what_it_wanted_when_given_something_else()
    assert(fails("readFileSync(42)").contains("`readFileSync` takes a path, and this is an integer"))
    assert(fails("readFileSync()").contains("`readFileSync` takes one path and was given 0 arguments"))
    assert(fails("writeFileSync(\"a\")").contains("`writeFileSync` takes a path and its contents"))
    assert(fails("renameSync(\"a\")").contains("`renameSync` takes two paths"))
    assert(fails("mkdirSync(null)").contains("`mkdirSync` takes a path"))

@test
the_blocking_calls_do_not_keep_the_program_alive()
    // A promise-shaped call claims a slot that the loop counts; a blocking one has nothing
    // outstanding when it returns, so a program made only of these ends at its last statement.
    assert_eq(in_scratch("writeFileSync(\"<dir>/a.txt\", \"x\")\nprint(\"done\")"), "done")

// -- modules ---------------------------------------------------------------------------------------

// **A program is as many files as it imports, and these are the tests that can tell.** Everything
// about a fault carrying its file is invisible while a program is one file -- the answer is always
// source zero and always right -- so the whole of that machinery is unchecked until something here
// runs. `a_fault_in_an_imported_file_is_reported_against_that_file` is the one that pins it.
//
// **The fixtures are real files under `tests/mods/`**, read by relative path exactly as the examples
// are, so what runs is the resolution a person gets: a path relative to the importing file, a
// directory walked with `..`, a file that is genuinely not there.

// What a program on disk printed.
private ran_out(path: string) -> string
    read_bytes(path) match
        Err(e) -> s"cannot read ${path}: ${e} -- this suite reads its fixtures by relative path, so it must be run from the project root (`sysl test .` there), not at it"
        Ok(bytes) ->
            val r = run(source(path, bytes))

            if r.ok() then r.printed() else r.render()
end ran_out

// The complaint a program on disk drew, and the empty string where it drew none.
private ran_fault(path: string) -> string
    read_bytes(path) match
        Err(e) -> s"cannot read ${path}: ${e} -- this suite reads its fixtures by relative path, so it must be run from the project root (`sysl test .` there), not at it"
        Ok(bytes) ->
            val r = run(source(path, bytes))

            if r.ok() then "" else r.render()
end ran_fault

@test
a_file_may_use_what_another_one_exports()
    // `greeting as hi` renames on the way in, which is the half of the syntax a plain import hides.
    assert_eq(ran_out("tests/mods/main.sl"), "hello\n42")

@test
a_star_import_is_an_ordinary_object()
    // **No new `Value` variant and nothing new for the collector**: a module is an `ObjectObj`, so
    // `util.double` is the field selection a program writes for itself.
    assert_eq(ran_out("tests/mods/star.sl"), "hello\n8\ngo!")

@test
a_path_is_relative_to_the_importing_file_and_not_the_working_directory()
    // `uses_deep.sl` imports `deep/nested.sl`, which imports `../util.sl` -- so the `..` is resolved
    // against the file the import is written in. Resolved against the working directory it would
    // have looked for `util.sl` one level above the project.
    assert_eq(ran_out("tests/mods/uses_deep.sl"), "12")

@test
what_a_module_did_not_export_is_not_visible()
    // A module runs in a scope of its own under the builtins, so its top-level `val` is its own.
    // Without that the files would share one scope and every name would leak into every other file.
    val said = ran_fault("tests/mods/private.sl")

    assert(said.contains("`greeting` is not defined"))

@test
asking_for_a_name_a_module_does_not_export_is_a_diagnostic()
    // **Caught while compiling, which is the whole reason the message can be this good.** Left to
    // run time it arrives as an absent field, so the complaint would be about `undefined` being
    // bound to a name -- true, and about the wrong thing.
    val said = ran_fault("tests/mods/no_such_export.sl")

    assert(said.contains("does not export `secret`"))
    assert(said.contains("`greeting`"))
    assert(said.contains("`double`"))

@test
a_fault_in_an_imported_file_is_reported_against_that_file()
    // **THE test the source-carrying fault exists for.** `uses_faulty.sl` line 1 is its import and
    // `faulty.sl` line 1 is the definition that goes wrong, so a fault stamped with the wrong file
    // would quote the import statement at the same line number and read as perfectly plausible.
    // What makes this able to fail is the second file's own text appearing under the caret.
    val said = ran_fault("tests/mods/uses_faulty.sl")

    assert(said.contains("`missing_name` is not defined"))
    assert(said.contains("tests/mods/faulty.sl"))
    assert(said.contains("export boom() = missing_name + 1"))
    assert(!said.contains("import { boom }"))

@test
what_a_program_printed_before_a_fault_in_an_imported_file_survives()
    // The import runs the other file's top level, so the entry has already printed by the time the
    // call into it goes wrong.
    read_bytes("tests/mods/uses_faulty.sl") match
        Err(e) -> assert(false, s"cannot read the fixture: ${e}")
        Ok(bytes) ->
            val r = run(source("tests/mods/uses_faulty.sl", bytes))

            assert(!r.ok())
            assert_eq(r.printed(), "before")

@test
a_parse_error_in_an_imported_file_is_reported_against_that_file()
    val said = ran_fault("tests/mods/uses_hole.sl")

    assert(said.contains("tests/mods/syntax_hole.sl"))
    assert(said.contains("expected an expression"))

@test
a_circle_of_imports_is_refused_and_names_the_chain()
    // **Refused rather than allowed with partial initialisation**, which is node's answer and a
    // famous source of confusion. Refusing can be relaxed later; half-built modules cannot be
    // un-shipped.
    val said = ran_fault("tests/mods/cycle_a.sl")

    assert(said.contains("closes a circle"))
    assert(said.contains("tests/mods/cycle_a.sl"))
    assert(said.contains("tests/mods/cycle_b.sl"))

@test
a_file_importing_itself_closes_the_smallest_circle()
    assert(ran_fault("tests/mods/self.sl").contains("closes a circle"))

@test
a_module_path_says_where_it_starts()
    // **A quoted string is a file and an unquoted word is a package**, so a quoted name with no
    // `./` in front of it is a file path that does not say where it starts -- and the message says
    // both ways out, since which one was meant is exactly what is unclear.
    val said = ran_fault("tests/mods/bare.sl")

    assert(said.contains("has to be written `\"./util.sl\"`"))
    assert(said.contains("an unquoted `util.sl` is how a package is named"))

@test
a_module_that_is_not_there_is_named_by_the_import_that_wanted_it()
    val said = ran_fault("tests/mods/absent.sl")

    assert(said.contains("cannot read `tests/mods/not_here.sl`"))
    assert(said.contains("tests/mods/absent.sl"))

@test
a_module_two_files_import_runs_once()
    // The diamond: `diamond.sl` imports `left.sl` and `right.sl`, and both import `base.sl`, whose
    // top level prints. A loader that read by import rather than by file would print twice.
    assert_eq(ran_out("tests/mods/diamond.sl"), "base ran\nleft sees base\nright sees base")

@test
export_and_import_belong_to_the_top_level_of_a_file()
    val said = ran_fault("tests/mods/in_block.sl")

    assert(said.contains("`export` belongs to the top level"))
    assert(said.contains("`import` belongs to the top level"))

@test
export_goes_in_front_of_something_with_a_name()
    // `export left_name = ...` is an assignment and not a binding, and this is the message it draws.
    // It was written by accident while these fixtures were being made, which is the best argument
    // for the message being a clear one.
    assert(fails("export val x = 1\nexport y = 2").contains("`export` goes in front of a `val`"))

@test
a_closure_a_module_exports_keeps_its_own_modules_state()
    // `bump` closes over a `var` its module never exported, so the count is the module's and the
    // importing file cannot reach it except by calling.
    assert_eq(ran_out("tests/mods/uses_counter.sl"), "1\n2")

@test
an_async_function_may_be_awaited_across_a_module_boundary()
    assert_eq(ran_out("tests/mods/uses_waits.sl"), "42")

@test
what_a_module_exports_is_a_snapshot_taken_when_it_finishes()
    // **Where slate parts company with TypeScript's live bindings, deliberately.** A module's
    // exports are an ordinary object built as the file ends, so a `var` the module changes
    // afterwards is not seen changing from outside: `m.count` stays 0 while the module's own
    // `count` becomes 1. Pinned rather than left to be discovered.
    assert_eq(ran_out("tests/mods/uses_snapshot.sl"), "0\n1\n0")

@test
a_module_object_survives_a_collection()
    // `module_values` is a root the tracer walks, and nothing else refers to a module's exports --
    // so without it the object would be swept out from under the program that imported it.
    val printed = ran_out("tests/mods/gc_main.sl")

    assert(collections > 0, "a program that allocates eighty thousand strings has to have collected")
    assert_eq(printed, "kept across a collection\n[\"item 0\", \"item 1\", \"item 2\"]")

// -- lexical paths ---------------------------------------------------------------------------------

@test
a_path_is_normalised_without_asking_the_filesystem_anything()
    assert_eq(normalize_path("./util.sl"), "util.sl")
    assert_eq(normalize_path("a/./b/../c.sl"), "a/c.sl")
    assert_eq(normalize_path("a//b.sl"), "a/b.sl")
    assert_eq(normalize_path("a/b/../../c.sl"), "c.sl")

    // A leading `..` cannot be simplified without knowing where the path starts from, so it stays.
    assert_eq(normalize_path("../a.sl"), "../a.sl")
    assert_eq(normalize_path("../../a.sl"), "../../a.sl")
    assert_eq(normalize_path("a/../../b.sl"), "../b.sl")

    // The root has no parent, which is the one case where a leading `..` does go away.
    assert_eq(normalize_path("/../a.sl"), "/a.sl")
    assert_eq(normalize_path("/a/b/../c.sl"), "/a/c.sl")

    // A path that normalises to nothing is the working directory rather than the empty string.
    assert_eq(normalize_path("a/.."), ".")

@test
an_import_resolves_against_the_file_it_was_written_in()
    assert_eq(resolve_import("tests/mods/main.sl", "./util.sl"), "tests/mods/util.sl")
    assert_eq(resolve_import("tests/mods/deep/nested.sl", "../util.sl"), "tests/mods/util.sl")

    // A file in the working directory has no directory part, and an import from it is bare.
    assert_eq(resolve_import("main.sl", "./util.sl"), "util.sl")

    // An absolute path ignores where it was written.
    assert_eq(resolve_import("tests/mods/main.sl", "/tmp/util.sl"), "/tmp/util.sl")

// -- a fault's file, once there are several -------------------------------------------------------

// **These are the edge-case pass, and one of them found a real bug.** A fault carries the file its
// span belongs to, and the machine keeps that in step with the chunk it is running -- but a *nested*
// run returns into the middle of an outer chunk whose own `chunk_ix` never changed, so the outer one
// carried on stamping its faults with the callee's file. Every one of these runs a fault through a
// different path back into a caller.

@test
a_fault_after_a_nested_run_belongs_to_the_file_that_raised_it()
    // **The regression test for the bug the edge-case pass found.** An `async` call is routed
    // through `start_async`, which runs a chunk of its own -- and afterwards a fault in the *entry*
    // was reported against `waits.sl`, at a line number that happened to exist and was blank.
    // Nothing about that message says it is pointing at the wrong file, which is why it is pinned
    // by the text of the line and not only by the name.
    val said = ran_fault("tests/mods/after_call.sl")

    assert(said.contains("`missing_in_the_entry` is not defined"))
    assert(said.contains("tests/mods/after_call.sl"))
    assert(!said.contains("tests/mods/waits.sl"))

@test
a_fault_after_a_hook_ran_belongs_to_the_calling_file()
    // The other way a nested run happens: a user `hash` is slate code called from inside a table
    // lookup, which is a native. The fault afterwards is the entry's.
    val said = ran_fault("tests/mods/uses_hook.sl")

    assert(said.contains("`another_missing_name` is not defined"))
    assert(said.contains("tests/mods/uses_hook.sl"))
    assert(!said.contains("tests/mods/hooked.sl"))

@test
a_fault_inside_a_hook_a_module_defined_names_that_module()
    val said = ran_fault("tests/mods/uses_bad_hook.sl")

    assert(said.contains("`not_a_name_here` is not defined"))
    assert(said.contains("tests/mods/bad_hook.sl"))

@test
an_error_inside_an_interpolation_in_an_imported_file_names_that_file()
    // A hole is parsed over a `sub_source`, which carries the enclosing file's name and offsets --
    // so the only thing that can put this in the right file is the loader recording which file the
    // report came from.
    assert(ran_fault("tests/mods/uses_interp.sl").contains("tests/mods/interp_hole.sl"))

@test
a_fault_in_a_modules_top_level_stops_the_program_before_the_entry_runs()
    read_bytes("tests/mods/uses_toplevel_fault.sl") match
        Err(e) -> assert(false, s"cannot read the fixture: ${e}")
        Ok(bytes) ->
            val r = run(source("tests/mods/uses_toplevel_fault.sl", bytes))

            assert(!r.ok())
            assert(r.render().contains("tests/mods/toplevel_fault.sl"))

            // The entry never ran at all: its first statement is a `print`.
            assert_eq(r.printed(), "")

@test
a_report_across_several_files_is_still_cut_at_five()
    // `Ran.render` does its own sorting and its own truncation, because `Report.render` renders
    // everything against one `Source` and there is no longer one.
    assert(ran_fault("tests/mods/many_faults.sl").contains("showing the first 5 of 6"))

// -- what modules do NOT change -------------------------------------------------------------------

@test
a_module_with_no_exports_is_an_empty_object()
    // `import {}` is legal and takes nothing, which is how a file is run for its effect alone.
    assert_eq(ran_out("tests/mods/uses_empty.sl"), "{}\n0")

@test
imports_may_chain()
    // A imports B imports C. Post-order is what makes C's exports exist by the time B is compiled.
    assert_eq(ran_out("tests/mods/chain_a.sl"), "B over C")

@test
an_import_list_may_span_lines_and_end_with_a_comma()
    // The brackets suspend the off-side rule, which is `sh.sysl.parsing`'s layout doing its job and
    // costs the grammar nothing here.
    assert_eq(ran_out("tests/mods/trailing.sl"), "6 hello")

@test
an_import_binds_where_it_is_written()
    // **slate hoists nothing, and an import is no exception.** A function called above its own
    // definition is `not defined` in exactly the same way, so this is one rule rather than two --
    // and the alternative, hoisting imports alone, would be the surprising one.
    assert(ran_fault("tests/mods/late_import.sl").contains("`double` is not defined"))

@test
an_imported_name_is_an_ordinary_binding()
    // Redeclaring shadows it, and importing the same name twice is not an error, because slate
    // already allows both of those for any binding. The module system adds no rule of its own.
    assert_eq(ran_out("tests/mods/collide.sl"), "5")
    assert_eq(ran_out("tests/mods/twice_imported.sl"), "4")
    assert_eq(ran_out("tests/mods/uses_twice_exported.sl"), "2")

@test
a_module_may_pass_on_what_it_imported()
    assert_eq(ran_out("tests/mods/uses_reexport.sl"), "14 mine")

@test
a_timer_a_module_starts_is_run_by_the_same_loop()
    // The loop drains once, after every module has run -- so a module's own timer is not a special
    // case and does not need one.
    assert_eq(ran_out("tests/mods/uses_timer.sl"), "loaded\nfrom the module's own timer")

// -- try and catch ---------------------------------------------------------------------------------

// **Unwinding already existed; what `try` adds is a place to stop it.** A fault has left the
// instruction loop as an `Err` since the machine was written, so catching one is not a new mechanism
// -- it is a record of what the world looked like where the `try` began, and re-entering the loop
// there. The tests that matter most are the ones where something ELSE leaves the body: a `return`, a
// `break`, an `await`. Each of those is a way for a handler to be left behind, and a handler left
// behind is worse than a missing one.

@test
a_catch_answers_where_the_body_faulted()
    assert_eq(out("print(1 catch e -> 2)"), "1")
    assert_eq(out("print(boom catch e -> 2)"), "2")
    assert_eq(out("print(1 / 0 catch e -> -1)"), "-1")

@test
the_block_form_and_the_postfix_form_are_one_thing()
    // Both build a `TryCatch`, so nothing downstream learns there are two -- which is what slate
    // already does for `if`'s one-line and indented forms.
    assert_eq(good_tree("x catch e -> 0"), "(try x catch e 0)")
    assert_eq(good_tree("try\n    x\ncatch e\n    0"), "(try (block x) catch e (block 0))")

@test
a_fault_is_an_ordinary_object_saying_where_it_was()
    // **No new kind of value**, which is the same answer modules got: slate objects already sort,
    // print and go in arrays, so a fault is one.
    assert_eq(out("val e = boom catch e -> e\nprint(e.message)"), "`boom` is not defined")
    assert_eq(out("val e = boom catch e -> e\nprint(e.line)"), "1")
    assert_eq(out("val e = boom catch e -> e\nprint(e.file)"), "t")

@test
a_fault_raised_several_calls_deep_is_caught_at_the_top()
    val prog = "deep(n) = if n == 0 then bottom else deep(n - 1)\nprint(deep(5) catch e -> e.message)"

    assert_eq(out(prog), "`bottom` is not defined")

@test
the_name_a_catch_binds_is_its_own()
    // `PushScope`/`PopScope` around the handler, so nothing leaks past it.
    assert(fails("val v = boom catch e -> 1\nprint(e)").contains("`e` is not defined"))

@test
a_try_that_does_not_fault_leaves_nothing_owed()
    // **The silent one.** A `return` written inside a `try` skips its `PopHandler`, and a handler
    // outliving the frame it was made in names an instruction nobody is standing at -- so the next
    // fault anywhere in the program would be restored into a function that has already returned.
    // `Frame.handlers` is what stops it, and this is what would notice.
    val prog = "f() =\n    try\n        return 1\n    catch e\n        2\nprint(f())\nafterwards"
    val said = fails(prog)

    assert(said.contains("`afterwards` is not defined"))
    assert(!said.contains("2"))

@test
breaking_out_of_a_try_drops_its_handler()
    // The same hazard by the other route: `break` leaves the body without running `PopHandler`, and
    // `unwind_to` is what emits them.
    val prog = "g() =\n    for i in 1..5\n        try\n            break\n        catch e\n            0\n    \"done\"\nprint(g())\nafterwards"
    val said = fails(prog)

    assert(said.contains("`afterwards` is not defined"))

@test
a_try_in_a_loop_catches_each_turn_of_it()
    val prog = "var out = []\nfor i in 1..4\n    try\n        if i == 2 then nope\n        push(out, i)\n    catch e\n        push(out, \"caught\")\nprint(out)"

    assert_eq(out(prog), "[1, \"caught\", 3, 4]")

@test
a_break_out_of_a_try_still_leaves_the_loop()
    val prog = "var out = []\nfor i in 1..5\n    try\n        if i == 3 then break\n        push(out, i)\n    catch e\n        push(out, \"caught\")\nprint(out)"

    assert_eq(out(prog), "[1, 2]")

@test
a_fault_in_a_handler_reaches_the_one_outside_it()
    val prog = "val v = try\n    try\n        boom\n    catch inner\n        deeper\ncatch outer\n    outer.message\nprint(v)"

    assert_eq(out(prog), "`deeper` is not defined")

@test
a_try_may_be_written_where_a_value_is_wanted()
    // **The layout pass again.** Brackets suspend the off-side rule, so `try` and a `catch`'s name
    // are nominated to `opens_block` exactly as `match` is -- otherwise the arms of a `try` written
    // as an argument would be inside a bracket pair where a newline means nothing.
    assert_eq(out("print(try\n    boom\ncatch e\n    \"caught\")"), "caught")
    assert_eq(out("var xs = []\npush(xs, try\n    1 / 0\ncatch e\n    -1)\nprint(xs)"), "[-1]")

@test
a_try_with_nothing_to_handle_the_fault_is_refused()
    assert(fails("try\n    boom").contains("a `try` needs a `catch`"))

@test
a_fault_in_a_callback_is_not_caught_by_the_call_that_scheduled_it()
    // **A callback runs from the loop, long after the `try` around `setTimeout` has finished.** That
    // is inherent rather than a gap: there is no statement of the program's to attach the fault to,
    // which is why the loop reports it against the line that wrote the callback.
    val said = fails("try\n    setTimeout(() -> nope, 1)\ncatch e\n    print(\"not this\")\nprint(\"scheduled\")")

    assert(said.contains("`nope` is not defined"))
    assert(!said.contains("not this"))

@test
a_caught_fault_costs_nothing_the_collector_cannot_give_back()
    // A fault is an object, so catching twenty thousand of them allocates twenty thousand -- and the
    // handler's own scope is a root only while it is owed.
    assert_eq(out("var n = 0\nvar i = 0\nwhile i < 20000\n    n += missing catch e -> 1\n    i += 1\nprint(n)"), "20000")

// -- catching across a suspension and across a file ------------------------------------------------

@test
a_failed_promise_is_caught_by_the_call_that_awaited_it()
    // **The case the whole arrangement is for.** A coroutine's handlers went into `parked` with it,
    // so the fault has to be given to the machine after it is put back -- not made into an `Err` by
    // the scheduler, which has no handlers and did not write the `await`.
    // **`reject` is how a promise is made to fail now**, the file system having stopped doing it:
    // an expected failure is a result, and a rejection is for the ones that are not.
    val prog = "async main() =\n    val t = await reject(\"deliberate\") catch e -> s\"recovered from ${e.message}\"\n    print(t)\nmain()"

    assert_eq(out(prog), "recovered from deliberate")

@test
the_block_form_catches_across_an_await_too()
    val prog = "async main() =\n    try\n        await reject(\"deliberate\")\n        print(\"never\")\n    catch e\n        print(\"caught\")\nmain()"

    assert_eq(out(prog), "caught")

@test
a_caught_rejection_is_not_also_an_unhandled_one()
    // Awaiting a promise marks it handled, and catching what it raised settles the matter -- so the
    // drain has nothing left to report at the end.
    val prog = "async main() =\n    val t = await reject(\"deliberate\") catch e -> \"fine\"\n    print(t)\nmain()"
    val r = run(source_of("t", prog))

    assert(r.ok(), s"a caught rejection was still reported: ${r.render()}")

@test
a_fault_caught_from_another_file_says_which_file_raised_it()
    // The fault carries its own source, so unwinding across a module boundary does not lose it.
    assert_eq(ran_out("tests/mods/catches.sl"), "tests/mods/raises.sl:1 `not_a_name_in_here` is not defined")

// -- @test ------------------------------------------------------------------------------------------

// **A test runner needs a fault to be survivable, which is why this could not have been built
// first.** Before `catch` there was no way to run a second test after the first one failed: a fault
// stopped the machine and took the run with it. The runner is that mechanism used from sysl rather
// than from slate -- `apply` the test, read the `Err`, report it, carry on.
//
// The fixtures are real files under `tests/suite/`, because what is being tested includes discovery
// and the way one file's tests do not become another's.

private tested(path: string) -> Tested
    read_bytes(path) match
        Err(e) ->
            var none: Buf[TestRan] = buf()

            Tested(s"cannot read ${path}: ${e} -- this suite reads its fixtures by relative path, so it must be run from the project root", none)
        Ok(bytes) -> run_tests(source(path, bytes))
end tested

// What one named test in a file had to say, or a sentence saying it was not there.
private verdict(t: Tested, name: string) -> string
    for i in 0..<t.results.len()
        if t.results.at(i).name == name then return t.results.at(i).said

    s"no test called `${name}` ran"
end verdict

@test
a_test_beside_the_code_reaches_what_that_file_kept_private()
    // The reason `@test` is allowed in an ordinary file at all: slate's module is a *file*, so a
    // separate test file could never see a private name. sysl's `tests.sysl` is inside the module
    // directory for the same reason.
    val t = tested("tests/suite/lib.sl")

    assert_eq(t.report, "")
    assert_eq(t.passed(), 2)
    assert_eq(t.failed(), 0)

@test
a_test_file_reaches_what_the_module_exported()
    val t = tested("tests/suite/lib_test.sl")

    assert_eq(t.report, "")
    assert_eq(t.passed(), 2)

@test
an_imported_modules_tests_do_not_run_again_for_the_file_importing_it()
    // **The claim `is_entry` exists for.** `lib_test.sl` imports `lib.sl`, which has two tests of
    // its own -- so a runner that registered every module's would report four here, and walking a
    // directory would run `lib.sl`'s twice over.
    val t = tested("tests/suite/lib_test.sl")

    assert_eq(t.results.len(), 2)
    assert_eq(verdict(t, "it_multiplies_by_the_factor"), "no test called `it_multiplies_by_the_factor` ran")

@test
a_failing_assertion_names_both_sides_and_where_it_was()
    val t = tested("tests/suite/failing.sl")
    val said = verdict(t, "an_assertion_that_does_not_hold")

    assert(said.contains("got 6, wanted 7"))
    assert(said.contains("tests/suite/failing.sl:6"))

@test
a_test_that_faults_rather_than_asserting_is_a_failure_like_any_other()
    // Nothing about the runner is specific to assertions: it reads the `Err` the machine hands back,
    // and an assertion is only a native that raises one.
    val said = verdict(tested("tests/suite/failing.sl"), "a_fault_rather_than_an_assertion")

    assert(said.contains("`no_such_name` is not defined"))

@test
what_a_failing_test_printed_is_kept_and_shown()
    val t = tested("tests/suite/failing.sl")
    var printed = ""

    for i in 0..<t.results.len()
        if t.results.at(i).name == "one_that_prints_before_it_fails" then printed = t.results.at(i).printed

    assert_eq(printed, "context the reader wants")

@test
an_async_test_is_waited_for_rather_than_called_a_pass()
    // **Calling an `async` test hands back a promise that has not settled**, so a runner that read
    // the answer straight away would call every asynchronous test a pass whatever it did. The loop
    // is drained and the promise is read afterwards.
    val said = verdict(tested("tests/suite/failing.sl"), "an_async_one_that_fails")

    assert(said.contains("got 1, wanted 2"))

@test
one_file_of_the_run_failing_to_load_does_not_stop_the_others()
    // A file that will not compile has no working tests to speak of, so it is reported as the file
    // failing rather than as every test in it failing for the same reason.
    val t = tested("tests/suite/unloadable.sl")

    assert(t.report != "")
    assert_eq(t.results.len(), 0)

@test
a_run_reports_the_passes_beside_the_failures()
    val t = tested("tests/suite/failing.sl")

    assert_eq(t.passed(), 1)
    assert_eq(t.failed(), 4)

@test
an_assertion_says_what_it_was_given_when_it_does_not_hold()
    assert(fails("assert(false)").contains("this assertion does not hold"))
    assert(fails("assert(1 == 2, \"the numbers differ\")").contains("the numbers differ"))
    assert(fails("assert()").contains("`assert` takes a condition"))

    // A string is quoted where a number is not, which is what says the two are different kinds.
    assert(fails("assertEq(\"6\", 6)").contains("got \"6\", wanted 6"))
    assert(fails("assertEq([1], [2])").contains("got [1], wanted [2]"))
    assert(fails("assertEq(1, 2, \"the counts\")").contains("the counts: got 1, wanted 2"))
    assert(fails("assertEq(1)").contains("`assertEq` takes what was got"))

    // And one that holds answers nothing and carries on.
    assert_eq(out("assert(true)\nassertEq(2, 2)\nprint(\"through\")"), "through")

@test
a_test_annotation_is_refused_where_it_cannot_be_honoured()
    assert(fails("@test\nnot_a_definition").contains("`@test` goes in front of a definition"))
    assert(fails("@test\nwith_args(x) = 1").contains("a test takes no arguments, and `with_args` takes 1"))
    assert(fails("@bench\nf() = 1").contains("`@bench` is not an annotation slate knows"))
    assert(fails("if true\n    @test\n    f() = 1").contains("`@test` belongs to the top level"))

@test
every_test_in_the_testing_example_passes()
    // **The example is reading material and reading material rots**, exactly as the others do -- and
    // this one rots in a way running it plainly would not notice, since a plain run calls no test.
    val t = tested("examples/testing.sl")

    assert_eq(t.report, "")
    assert_eq(t.failed(), 0, s"the testing example has a failing test: ${verdict(t, "widen_clamps_every_element")}")
    assert_eq(t.passed(), 6)

@test
a_test_marked_in_a_program_that_is_merely_run_is_an_ordinary_function()
    // `slate foo.sl` registers the tests and calls none of them, so `@test` costs a program that is
    // not being tested one closure and nothing else.
    assert_eq(out("@test\nchecks() =\n    assert(false)\nprint(\"ran the program, not the test\")"), "ran the program, not the test")

// -- prototypes -------------------------------------------------------------------------------------

// **`proto` is an ordinary field, which is the whole design.** slate already looked `hash` and
// `equals` up by name, so a well-known field is the mechanism the language had rather than a new one:
// no syntax, no new `Value` variant, and `with` works on it like anything else.
//
// **The receiver rule is the part that needed thought.** A method stored on the object has captured
// what it needs -- `p.equals = o -> o.x == p.x` is what slate has always written -- and one shared
// through a proto cannot have, there being one of it for every instance. So the shared kind is handed
// the object and the captured kind is not, and that is not a special case: it is the actual
// difference between the two.

private const Pointish: string = "val Point = {\n    dist: self -> self.x * self.x + self.y * self.y,\n    kind: \"a point\"\n}\npoint(x, y) = { x: x, y: y, proto: Point }\n"

@test
a_method_on_a_proto_is_given_the_object_it_was_found_on()
    assert_eq(out(Pointish + "print(point(3, 4).dist())"), "25")

@test
a_proto_supplies_plain_fields_and_not_only_methods()
    assert_eq(out(Pointish + "print(point(1, 1).kind)"), "a point")

@test
a_field_on_the_object_shadows_the_protos()
    assert_eq(out(Pointish + "print({ x: 1, y: 1, proto: Point, kind: \"mine\" }.kind)"), "mine")

@test
a_captured_method_is_still_given_no_receiver()
    // **The compatibility claim, and the reason the rule is written this way.** Every hook slate had
    // before protos existed is a closure that captured its object, and `apply` faults on an arity
    // mismatch -- so a receiver passed to one of those would have broken every one of them.
    val prog = "f() =\n    var o = { n: 5 }\n    o.double = () -> o.n * 2\n    o\nprint(f().double())"

    assert_eq(out(prog), "10")

@test
a_method_taken_off_an_object_is_the_bare_function()
    // `o.m` is a `GetField` and hands back what it found; only `o.m(...)` passes a receiver. Taking a
    // method off an object and calling it later is allowed, and what you get is what you took.
    assert_eq(out(Pointish + "val p = point(3, 4)\nval f = p.dist\nprint(f(p))"), "25")

@test
a_proto_may_have_a_proto()
    val prog = "val Shape = { describe: self -> s\"${self.kind} of ${self.area()}\", kind: \"shape\" }\nval Square = { proto: Shape, kind: \"square\", area: self -> self.side * self.side }\nprint({ side: 4, proto: Square }.describe())"

    // The method on the outer proto calls one the inner proto supplies, which is dispatch through
    // the chain rather than a name resolved where it was written.
    assert_eq(out(prog), "square of 16")

@test
a_proto_is_the_nominal_identity_and_needs_no_syntax()
    // `p is Point` cannot mean this -- a bare name in pattern position is a binding, which is sysl's
    // rule and slate's. `p.proto == Point` is an ordinary expression and says it exactly.
    assert_eq(out(Pointish + "print(point(1, 2).proto == Point)"), "true")
    assert_eq(out(Pointish + "print({ x: 1 }.proto == Point)"), "false")

@test
a_hook_may_come_from_a_proto()
    // What makes a proto a place for shared *behaviour*: one `hash` and one `equals` serving every
    // object that delegates to them, so two objects with different data are one key.
    val prog = "val Keyed = { hash: () -> 7, equals: o -> true }\nvar t = {}\nt[{ v: 1, proto: Keyed }] = \"stored\"\nprint(t[{ v: 2, proto: Keyed }], len(t))"

    assert_eq(out(prog), "stored 1")

@test
a_circle_of_protos_is_a_sentence_rather_than_a_hang()
    // A `proto` is an ordinary field, so a program can point one at itself -- and a lookup that
    // misses would otherwise walk forever with nothing to report.
    val said = fails("var o = { n: 1 }\no.proto = o\nprint(o.missing)")

    assert(said.contains("`proto` chain is more than 64 deep"))
    assert(said.contains("which means it is a circle"))

@test
calling_a_field_that_is_not_there_says_so()
    assert(fails("print({ n: 1 }.nope())").contains("`nope` is not a field of this object"))

    // **A builtin's set of names is closed, so a miss names the KIND rather than the field.** An
    // object grows fields over its life and a missing one is an ordinary state; an integer's method
    // list is fixed, and a name that is not on it is a mistake at the call.
    assert(fails("print(5 .nope())").contains("`nope` is not something an integer can do"))

@test
a_proto_costs_one_table_rather_than_one_closure_per_object()
    // **The measurement the design is for.** Three methods written as captured closures cost three
    // closures per instance; on a proto they cost three once. Six thousand objects is over the line
    // one way and inside it the other.
    //
    // **Run against a fixed four megabytes rather than whatever the heap happens to be**, so the
    // numbers mean something a year from now. This test was written against a 4 MiB heap, failed the
    // day the heap became 16 MiB and again the day it became 256, which is two more times than a
    // measurement should have to be re-derived.
    val captured = "make(x) =\n    var o = { x: x }\n    o.a = () -> o.x\n    o.b = () -> o.x\n    o.c = () -> o.x\n    o\nvar xs = []\nvar i = 0\nwhile i < 6000\n    push(xs, make(i))\n    i += 1\nprint(len(xs))"
    val shared = "val P = { a: self -> self.x, b: self -> self.x, c: self -> self.x }\nvar xs = []\nvar i = 0\nwhile i < 6000\n    push(xs, { x: i, proto: P })\n    i += 1\nprint(len(xs))"

    set_heap_limit(4194304)

    val crowded = fails(captured)
    val roomy = out(shared)

    set_heap_limit(268435456)

    assert(crowded.contains("run out of memory"), "six thousand objects with captured methods now fit in four megabytes, so the cost of a closure has changed")
    assert_eq(roomy, "6000")

// -- types -------------------------------------------------------------------------------------------

// **A type is a named PATTERN, and that is the whole design.** slate already had structural tests
// over object shapes, so a type is one of those given a name -- `p is Point` is the `is` slate always
// had, and nothing of a type exists at run time.
//
// It is TypeScript's `type`, deliberately: the same declaration, the same structural reading. What
// differs is that slate's is not erased, so one declaration serves both the pattern and the check at
// a boundary -- which is the pair TypeScript users write twice, once as a `type` and once as a zod
// schema.

private const Shapes: string = "type Point = { x: number, y: number }\ntype Named = { name: string }\n"

// A value handed over through something the CHECKER cannot see the type of.
//
// **A run-time check exists for the values that arrive from outside the program**, and once the
// static pass reports the ones it can see, a test of the run-time check has to hand over one it
// cannot. An unannotated function answers `any` by design and permanently, so this is a stable way
// to say "a value whose type nobody wrote down" rather than a trick played on a limitation.
private const Opaque: string = "anything(v) = v\n"

@test
a_type_is_a_named_pattern()
    assert_eq(out(Shapes + "print({ x: 1, y: 2 } is Point)"), "true")
    assert_eq(out(Shapes + "print({ x: 1 } is Point)"), "false")

@test
a_type_matches_an_object_that_has_at_least_those_fields()
    // The object pattern's own rule, inherited rather than restated: a record grows fields over its
    // life, and a test that broke whenever one was added would be one nobody could keep working.
    assert_eq(out(Shapes + "print({ x: 1, y: 2, z: 3 } is Point)"), "true")

@test
a_type_stands_where_a_match_arm_does()
    val prog = Shapes + "describe(v) = v match\n    Point -> \"a point\"\n    Named -> \"named\"\n    _ -> \"other\"\nprint(describe({ x: 1, y: 2 }), describe({ name: \"bob\" }), describe(5))"

    assert_eq(out(prog), "a point named other")

@test
a_type_may_be_written_in_terms_of_another()
    val prog = Shapes + "type Line = { a: Point, b: Point }\nval p = { x: 1, y: 2 }\nprint({ a: p, b: p } is Line, { a: p, b: { x: 1 } } is Line)"

    assert_eq(out(prog), "true false")

@test
a_bare_name_that_names_no_type_still_binds()
    // **sysl's rule, and slate had it already**: a bare identifier in pattern position is a test when
    // it names something and a binding otherwise. Declaring a type is what makes the name name
    // something; nothing else about patterns changed.
    assert_eq(out("print(5 match\n    anything -> s\"bound ${anything}\")"), "bound 5")

@test
a_parameter_may_say_what_it_takes_and_is_told_where_it_arrived()
    // **The whole reason to write one.** The complaint lands where the value was handed over rather
    // than wherever it was first used wrongly, which is most of what a type buys a dynamic language.
    assert_eq(out(Shapes + "area(p: Point) = p.x * p.y\nprint(area({ x: 3, y: 4 }))"), "12")

    val said = fails(Shapes + Opaque + "area(p: Point) = p.x * p.y\nprint(area(anything({ x: 1 })))")

    assert(said.contains("`p` was declared Point, and was given {x: 1}"))

@test
an_unannotated_function_is_the_tree_it_always_was()
    // The body is left alone where nothing was annotated, so nothing pays for the feature.
    assert_eq(good_tree("f(x) = x + 1"), "(def f(x) (+ x 1))")
    assert(good_tree("f(x: number) = x + 1").contains("(check x number)"))

@test
a_type_declared_inside_a_block_is_refused()
    assert(fails("if true\n    type T = { a: number }").contains("a type belongs to the top level of a file"))

@test
a_type_may_annotate_more_than_one_parameter_and_hold_brackets()
    // The lookahead that tells a definition from a call has to skip an annotation's pattern with its
    // brackets balanced, which is what this would catch.
    val prog = "type Pair = { a: number, b: number }\nboth(p: Pair, q: { xs: array }) = p.a + len(q.xs)\nprint(both({ a: 1, b: 2 }, { xs: [1, 2] }))"

    assert_eq(out(prog), "3")

// -- types across a file -----------------------------------------------------------------------

@test
an_exported_type_crosses_a_file()
    // **`export type` is how an interface leaves the file it was written in**, which is most of what
    // an interface is for. Nothing of it reaches run time: the compiler drops the binding, the module
    // having no field of that name, and resolves the name where it stands in a pattern instead.
    assert_eq(ran_out("tests/mods/uses_types.sl"), "true\nfalse\n12\nbound 5\ntrue false")

@test
a_type_that_was_not_exported_stays_in_its_own_file()
    // In the importing file `Secret` is an ordinary binding, which is what the fixture's third line
    // shows -- and the file that declared it still tests with it.
    val said = ran_out("tests/mods/uses_types.sl")

    assert(said.contains("bound 5"))

@test
asking_for_a_type_a_file_does_not_export_is_the_same_diagnostic_as_any_other()
    // `Secret` is declared in `shapes.sl` without `export`, so it is no more importable than an
    // unexported `val` -- and the message lists what the file does offer, `Point` among it, which is
    // what says a type counts as an export rather than being invisible to the check.
    val said = ran_fault("tests/mods/wants_private_type.sl")

    assert(said.contains("does not export `Secret`"))
    assert(said.contains("`Point`"))
    assert(said.contains("`origin`"))

// -- text, counted in characters ----------------------------------------------------------------

// **A slate string is a sequence of CHARACTERS and never of bytes**, which is the user's call and
// the only defensible one: `len("日本語")` answering nine and `"日本語"[0..<1]` answering a third of
// a character are facts about UTF-8 leaking through a language that has no business exposing it.
//
// Both of those were the behaviour until this landed, so every test here would have failed before it
// and several are as much regression tests as they are specifications.

@test
a_string_is_measured_in_characters()
    assert_eq(out("print(len(\"日本語\"))"), "3")
    assert_eq(out("print(len(\"héllo\"))"), "5")
    assert_eq(out("print(len(\"\"))"), "0")

@test
a_string_is_cut_at_character_boundaries()
    // Cut by bytes these answer half a character each, which is what they used to do.
    assert_eq(out("print(\"日本語\"[0..<1])"), "日")
    assert_eq(out("print(\"日本語\"[1..])"), "本語")
    assert_eq(out("print(\"héllo\"[0..<2])"), "hé")

@test
a_character_is_a_string_of_one()
    // **There is still no character type**, so indexing answers a string -- which is Python's answer
    // and is what lets `s[i]`, `chars` and `split` all hand back the same kind of thing.
    assert_eq(out("print(\"日本語\"[2])"), "語")
    assert_eq(out("print(\"héllo\"[1])"), "é")
    assert(fails("print(\"abc\"[5])").contains("the index 5 is outside a string of 3 characters"))

@test
chars_takes_a_string_apart()
    assert_eq(out("print(chars(\"añb\"))"), "[\"a\", \"ñ\", \"b\"]")
    assert_eq(out("print(chars(\"\"))"), "[]")

@test
split_and_join_are_the_two_directions()
    assert_eq(out("print(split(\"a,b,,c\", \",\"))"), "[\"a\", \"b\", \"\", \"c\"]")
    assert_eq(out("print(join([\"a\", \"b\"], \"-\"))"), "a-b")

    // Anything that is not a string joins as `print` would render it.
    assert_eq(out("print(join([1, true, \"x\"], \" \"))"), "1 true x")

    // An empty separator splits into characters, which is what every language answering this at all
    // answers -- and saves reaching for `chars` under another name.
    assert_eq(out("print(split(\"abc\", \"\"))"), "[\"a\", \"b\", \"c\"]")

@test
searching_answers_positions_a_person_would_count()
    // **In characters.** `indexOf("héllo", "llo")` is 2 by character and 3 by byte, which is the
    // shortest input that tells the two apart.
    assert_eq(out("print(indexOf(\"héllo\", \"llo\"))"), "2")
    assert_eq(out("print(lastIndexOf(\"abcabc\", \"b\"))"), "4")

    // **Null rather than -1**, because slate has a null and the operators that go with it.
    assert_eq(out("print(indexOf(\"hello\", \"z\"))"), "null")
    assert_eq(out("print(indexOf(\"hello\", \"z\") ?? 0)"), "0")

    assert_eq(out("print(contains(\"hello\", \"ell\"), contains(\"hello\", \"z\"))"), "true false")
    assert_eq(out("print(startsWith(\"hello\", \"he\"), endsWith(\"hello\", \"lo\"))"), "true true")

@test
trimming_takes_whitespace_off_the_ends()
    assert_eq(out("print(\"[\" + trim(\"  hi \\t \") + \"]\")"), "[hi]")
    assert_eq(out("print(\"[\" + trimStart(\"  hi  \") + \"]\")"), "[hi  ]")
    assert_eq(out("print(\"[\" + trimEnd(\"  hi  \") + \"]\")"), "[  hi]")
    assert_eq(out("print(\"[\" + trim(\"   \") + \"]\")"), "[]")

@test
replacing_and_repeating()
    assert_eq(out("print(replace(\"a-b-c\", \"-\", \"+\"))"), "a+b+c")
    assert_eq(out("print(repeat(\"ab\", 3))"), "ababab")
    assert_eq(out("print(repeat(\"ab\", 0))"), "")

    // Replacing nothing would put the new text between every pair of characters, which is never what
    // was meant.
    assert(fails("print(replace(\"abc\", \"\", \"x\"))").contains("cannot replace the empty string"))
    assert(fails("print(repeat(\"a\", -1))").contains("a count that is not negative"))

@test
CASE_CONVERSION_IS_ASCII_AND_SAYS_SO()
    // **A KNOWN LIMIT, pinned so that it is a decision rather than a surprise.** `sysl.text`'s
    // `to_upper` is ASCII by design and documents itself as such -- a Unicode case table is above
    // that layer and slate has none. So `é` comes back untouched, which is wrong for a language that
    // has just been told to count in characters, and is worth a card rather than a quiet paper-over.
    assert_eq(out("print(upper(\"abc\"), lower(\"ABC\"))"), "ABC abc")
    assert_eq(out("print(upper(\"héllo\"))"), "HéLLO")
    assert_eq(out("print(lower(\"HÉLLO\"))"), "hÉllo")

// -- numbers -----------------------------------------------------------------------------------

@test
num_reads_a_number_out_of_a_string()
    // **A whole number where it was written as one**, which is the distinction slate keeps
    // everywhere else and would be odd to drop here.
    assert_eq(out("print(number(\"42\"), number(\"-7\"))"), "42 -7")
    assert_eq(out("print(number(\"3.5\"))"), "3.5")
    assert_eq(out("print(number(\"nope\"), number(\"\"))"), "null null")

    // A number given to it is already one.
    assert_eq(out("print(number(7), number(1.5))"), "7 1.5")

@test
integer_and_real_move_between_the_two_kinds()
    assert_eq(out("print(integer(3.7), integer(-3.7), integer(4))"), "3 -3 4")
    assert_eq(out("print(real(3))"), "3")
    assert(fails("print(integer(\"3\"))").contains("`number` is what reads one out of a string"))

@test
rounding_keeps_the_kind_it_was_given()
    // An integer is already whole, so all four leave one alone rather than making it a real.
    assert_eq(out("print(floor(3.7), ceil(3.2), round(3.5), trunc(-3.7))"), "3 4 4 -3")
    assert_eq(out("print(floor(3), ceil(3), round(3), trunc(3))"), "3 3 3 3")

@test
the_arithmetic_a_program_reaches_for()
    assert_eq(out("print(abs(-4), abs(-4.5))"), "4 4.5")
    assert_eq(out("print(sqrt(16), pow(2, 10))"), "4 1024")
    assert(fails("print(sqrt(-1))").contains("a number that is not negative"))

@test
min_and_max_take_as_many_as_they_are_given()
    assert_eq(out("print(min(3, 1, 2), max(3, 1, 2))"), "1 3")
    assert_eq(out("print(min(5))"), "5")

    // **Integers in, integer out.** A `min` answering a real for two integers would make every use
    // of it in an index a conversion.
    assert_eq(out("print(min(1.5, 2))"), "1.5")
    assert(fails("print(min())").contains("at least one number"))

@test
a_text_builtin_says_what_it_wanted_when_given_something_else()
    assert(fails(Opaque + "print(anything(len)())").contains("`len` takes one argument"))
    assert(fails(Opaque + "print(split(anything(5), \",\"))").contains("`split` takes a string"))
    assert(fails(Opaque + "print(join(anything(5), \",\"))").contains("`join` takes an array"))
    assert(fails(Opaque + "print(trim(anything(5)))").contains("`trim` takes a string"))
    assert(fails(Opaque + "print(anything(upper)())").contains("`upper` takes one string"))
    assert(fails(Opaque + "print(abs(anything(\"x\")))").contains("`abs` takes a number"))

// -- optional and union types ---------------------------------------------------------------------

// **Annotating a parameter is optional per PARAMETER**, and a type may be a union -- including one
// with `null` in it, which is how a parameter says it will take nothing.
//
// The union case needed a fix rather than a feature. A name standing in a pattern is a type where one
// was declared and a binding otherwise, and which it is cannot be known while parsing -- so the
// parser's "no alternative may bind" check refused `Point | null` before anything had a chance to
// resolve it. The check now runs where the answer exists.

@test
a_parameter_list_may_annotate_some_and_not_others()
    assert_eq(out("type Point = { x: number }\nmixed(a, b: Point, c) = s\"${a} ${b.x} ${c}\"\nprint(mixed(1, { x: 2 }, 3))"), "1 2 3")

@test
a_type_may_be_a_union_and_may_include_null()
    val prog = "type Point = { x: number, y: number }\ntype MaybePoint = Point | null\nhere(p: MaybePoint) = if p == null then \"nowhere\" else s\"at ${p.x}\"\nprint(here({ x: 1, y: 2 }), here(null))"

    assert_eq(out(prog), "at 1 nowhere")

    // And what the union does not cover is still refused where the value arrives.
    val said = fails("type Point = { x: number, y: number }\ntype MaybePoint = Point | null\n" + Opaque + "here(p: MaybePoint) = 1\nprint(here(anything(5)))")

    assert(said.contains("`p` was declared MaybePoint, and was given 5"))

@test
a_union_may_be_written_over_several_shapes()
    val prog = "type Shape = { side: number } | { radius: number } | null\nprint({ side: 2 } is Shape, { radius: 1 } is Shape, null is Shape, 5 is Shape)"

    assert_eq(out(prog), "true true true false")

@test
an_alternative_that_really_binds_is_still_refused()
    // **The check the parser used to make, moved to where the answer exists.** `n | 0` would leave
    // `n` bound down one path and not the other, and slate has no type system to notice -- so it is
    // refused, and now says what to write instead.
    val said = fails("print(5 match\n    n | 0 -> \"bound\"\n    _ -> \"no\")")

    assert(said.contains("an alternative of a pattern may not bind a name"))
    assert(said.contains("write a type where one was meant"))

@test
a_compile_time_complaint_stops_the_program_as_a_parse_error_does()
    // The compiler had nothing to complain *with* until types existed: everything before then was a
    // parse error or something a `FailWith` carried to run time. This one is knowable while compiling
    // and has no value to attach itself to, so it needed a channel of its own.
    val r = run(source_of("t", "print(5 match\n    n | 0 -> 1\n    _ -> 2)"))

    assert(!r.ok())
    assert_eq(r.printed(), "")

// -- a type is a shape, not a destructuring ---------------------------------------------------------

// **A type is a named pattern, so nothing stopped one holding a bare name -- and a bare name binds.**
// `type Tagged = { x: n }` introduced `n` at every site that used the type, including out of an `is`
// into the surrounding scope. A declaration that reads as a shape should not put a name in scope.
//
// It is also what the union rule already said: an alternative may not bind, for the same reason. A
// whole type being allowed to was the inconsistency rather than the rule.

@test
a_type_may_not_bind_a_name()
    val said = fails("type Tagged = { x: n }\nprint({ x: 1 } is Tagged)")

    assert(said.contains("a type is a shape, so `Tagged` may not bind `n`"))

@test
a_type_that_bound_a_name_used_to_leak_it_into_the_enclosing_scope()
    // **The behaviour the refusal exists to stop, written down so the reason survives.** `is` binds
    // into the scope it is written in, which is what makes `x is Pat` useful -- and a *type* holding
    // a binding turned that into a name appearing from a declaration somewhere else entirely.
    val said = fails("type Tagged = { x: n }\nprint({ x: 1 } is Tagged)\nprint(n)")

    assert(said.contains("may not bind"))
    assert(!said.contains("`n` is not defined"))

@test
a_type_written_in_terms_of_itself_is_refused_and_says_so()
    // **A latent one, found by the same check.** `resolve_pattern` gives up at 32 levels and hands
    // back the unresolved name -- which is a binding, so the type silently became "anything" that
    // deep. Refusing it says what is actually wrong rather than leaving a shape that quietly matches.
    val said = fails("type T = { next: T }\nprint(1)")

    assert(said.contains("`T` is written in terms of itself"))
    assert(said.contains("rather than one that nests without end"))

@test
a_type_over_other_types_is_still_ordinary()
    // The check must not catch a type that merely names another, which is the common case.
    val prog = "type Pt = { x: number, y: number }\ntype Line = { a: Pt, b: Pt }\nval p = { x: 1, y: 2 }\nf(q: Pt) = q.x\nprint({ a: p, b: p } is Line, f(p))"

    assert_eq(out(prog), "true 1")

@test
a_pattern_outside_a_type_may_still_bind_as_it_always_could()
    // Nothing about ordinary patterns changed: `is` and a `match` arm bind, which is what they are
    // for. The rule is about a *declaration*.
    assert_eq(out("print({ x: 7 } match\n    { x: v } -> v)"), "7")
    assert_eq(out("val ok = { x: 7 } is { x: v }\nprint(ok, v)"), "true 7")

// -- an annotation that names nothing ---------------------------------------------------------------

// **A CHECK THAT QUIETLY PASSES IS WORSE THAN NO CHECK, because the reader believes it.** A bare name
// in pattern position is a binding where it names no type, and a binding matches anything -- so an
// annotation naming a type that does not exist accepted every value and bound the type's name inside
// the function. Found by asking what `f(x: string)` did back when slate's word was `str`.

@test
an_annotation_naming_no_type_is_refused()
    val said = fails("h(x: Undeclared) = 1\nprint(h(9))")

    assert(said.contains("`Undeclared` is not a type, so `x: Undeclared` would check nothing"))
    assert(said.contains("declare it with `type`"))

@test
an_annotation_refusal_guesses_what_was_meant()
    // The words another language would have taught a reader, guessed at the moment of the mistake
    // rather than left to a list in a manual.
    assert(fails("f(x: str) = x").contains("slate's word is `string`"))
    assert(fails("f(x: num) = x").contains("slate's word is `number`"))
    assert(fails("f(x: bool) = x").contains("slate's word is `boolean`"))
    assert(fails("f(x: fn) = x").contains("slate's word is `function`"))
    assert(fails("f(x: int) = x").contains("slate's word is `integer`"))
    assert(fails("f(x: float) = x").contains("slate's word is `real`"))

@test
an_annotation_may_not_bind_anywhere_inside_itself()
    // Not only the bare form: a shape holding a binding checks less than it appears to.
    assert(fails("f(p: { x: n }) = p.x").contains("would check nothing"))

@test
the_type_test_words_are_string_and_number()
    // **The user's call**, so that a reader coming from anywhere else writes what they expect. The
    // builtins keep their own names and do not collide: a word in pattern position is read by
    // `type_test_named` and nowhere else.
    assert_eq(out("print(\"a\" is string, 1 is number, 1.5 is number)"), "true true true")
    assert_eq(out("f(x: string) = x\ng(n: number) = n\nprint(f(\"hi\"), g(3))"), "hi 3")
    assert(fails(Opaque + "f(x: string) = x\nprint(f(anything(1)))").contains("`x` was declared string, and was given 1"))

    // `str` renders and `num` parses, both still functions.
    assert_eq(out("print(string(42) + \"!\", number(\"42\") + 1)"), "42! 43")

@test
a_type_word_tests_in_a_pattern_and_converts_in_an_expression()
    // **The two positions never overlap**, so one word does both: a word in pattern position is read
    // by `type_test_named` and nowhere else.
    assert_eq(out("print(string(123), string(1.5), string(true), string([1, 2]))"), "123 1.5 true [1, 2]")
    assert_eq(out("print(number(\"42\"), integer(3.9), real(3))"), "42 3 3")
    assert_eq(out("print(1 is integer, 1.5 is real, true is boolean, (() -> 1) is function)"), "true true true true")

@test
boolean_is_truthiness_and_slates_truthiness_is_not_javascripts()
    // **Only `null`, `undefined` and `false` are falsy**, which is Lua's rule and slate's own `if`.
    // A reader from JavaScript will expect `boolean(0)` to be false; it is not, and `if 0` agrees.
    assert_eq(out("print(boolean(null), boolean(false), boolean(0), boolean(\"\"), boolean([]))"), "false false true true true")
    assert_eq(out("print(if 0 then \"t\" else \"f\", if \"\" then \"t\" else \"f\")"), "t t")

// -- what a call answers, and `any` -----------------------------------------------------------------

// **`-> type` had to come first, because nothing downstream of a call can be checked without it.**
// It is read where a parameter's annotation is read and wraps the body the same way, so `Def` and
// `Lambda` learn nothing and neither does anything that reads them.
//
// The check it emits today is a runtime one, testing what the body left on the stack. What it is
// *for* is the static pass that will read `Type` instead.

@test
a_definition_may_say_what_it_answers()
    assert_eq(out("double(x: number) -> number = x * 2\nprint(double(4))"), "8")
    assert_eq(out("greet(who: string) -> string\n    s\"hello ${who}\"\nprint(greet(\"world\"))"), "hello world")
    assert_eq(out("count(xs: array) -> integer = len(xs)\nprint(count([1, 2, 3]))"), "3")

@test
answering_the_wrong_kind_is_a_fault_where_it_was_answered()
    val said = fails("name(p: { id: number }) -> string = p.id\nprint(name({ id: 7 }))")

    assert(said.contains("this answers string, and gave back 7"))

@test
a_result_annotation_naming_no_type_is_refused_and_points_at_itself()
    // **At the annotation, not at the body.** The wrapped expression is the whole function; what a
    // reader has to change is the `-> Nope`.
    val said = fails("bad(x) -> Nope = x")

    assert(said.contains("`Nope` is not a type, so `-> Nope` would check nothing"))
    assert(said.contains("1 | bad(x) -> Nope = x"))

@test
any_is_a_type_and_matches_everything()
    // **What an unannotated thing is**, and the shape a gradual system has to have: slate is
    // dynamically typed at the edges and always will be, so `any` is a claim about a value rather
    // than a refusal to make one.
    assert_eq(out("f(x: any) -> any = x\nprint(f(1), f(\"s\"), f(null))"), "1 s null")
    assert_eq(out("print(1 is any, null is any, [] is any)"), "true true true")

@test
a_type_is_read_off_an_annotation_and_said_back()
    // **`Type` is not `Pattern`, which is the whole reason it exists** -- a pattern tests a value and
    // a type describes one. One annotation makes both: the pattern goes to the machine and the type
    // stays for the checker. This is what proves the fork works before anything reads the far side.
    assert_eq(type_text("number"), "number")
    assert_eq(type_text("any"), "any")
    assert_eq(type_text("array"), "array")
    assert_eq(type_text("{ x: number, y: string }"), "{ x: number, y: string }")
    assert_eq(type_text("string | null"), "string | null")
    assert_eq(type_text("{ a: { b: boolean } }"), "{ a: { b: boolean } }")

// The type an annotation describes, read through the parser the way a definition's would be.
private type_text(annotation: string) -> string
    val src = source_of("t", s"f(x: ${annotation}) = x")
    val r = parse(src)

    if !r.ok() then return r.report.render(src)

    for i in 0..<r.program.stmts.len()
        *r.program.stmts.at(i).kind match
            Def(_, _, body, _) -> return first_annotation(body_at(body))
            _ -> ()

    "no definition"
end type_text

private first_annotation(body: Expr) -> string
    *body.kind match
        Block(stmts) ->
            for i in 0..<stmts.len()
                *stmts.at(i).kind match
                    CheckType(_, _, pat) -> return show_type(type_from_pattern(pat))
                    _ -> ()

            "no annotation"
        _ -> "no block"
end first_annotation

// -- arrays, and the method syntax a builtin type answers to ---------------------------------------

@test
an_array_is_walked_by_a_function()
    assert_eq(out("print(map([1, 2, 3], x -> x * 2))"), "[2, 4, 6]")
    assert_eq(out("print(filter([1, 2, 3, 4], x -> x % 2 == 0))"), "[2, 4]")
    assert_eq(out("print(reduce([1, 2, 3], (a, b) -> a + b, 0))"), "6")
    assert_eq(out("print(map([], x -> x))"), "[]")
    assert_eq(out("print(filter([], x -> true))"), "[]")

    // The starting value is what an empty fold answers, which is why it is required.
    assert_eq(out("print(reduce([], (a, b) -> a + b, 99))"), "99")

@test
a_CALLBACK_IS_HANDED_THE_VALUE_AND_NOTHING_ELSE()
    // **The defect this rules out is JavaScript's most quoted one**: `["1","2","3"].map(parseInt)`
    // answers `[1, NaN, NaN]` there, because `map` passes the index as a second argument and
    // `parseInt` reads it as a radix. A one-argument builtin is exactly what a reader expects to be
    // able to pass, so slate passes one argument.
    assert_eq(out("print(map([\"1\", \"2\", \"3\"], number))"), "[1, 2, 3]")

    // `apply` faults on an arity mismatch, so a two-argument function is refused rather than
    // silently fed an index.
    assert(fails("print(map([1], (a, b) -> a))").contains("takes 2 arguments and was given 1"))

@test
a_fault_inside_a_callback_is_the_programs_fault()
    // It travels out of the builtin exactly as any other does, carrying the line it was raised at.
    assert(fails("print(map([1, 2], x -> x.nope))").contains("`nope` is not something an integer can do"))
    assert(fails("print(filter([1], x -> nope))").contains("`nope`"))

@test
find_and_findIndex_answer_null_rather_than_a_sentinel()
    assert_eq(out("print(find([1, 5, 9], x -> x > 4))"), "5")
    assert_eq(out("print(findIndex([1, 5, 9], x -> x > 4))"), "1")

    // **Null and not -1**, which is the call `indexOf` already made: slate has a null and the `??`
    // that goes with it, so a sentinel would be an invented one a reader has to know.
    assert_eq(out("print(find([1, 2], x -> x > 9))"), "null")
    assert_eq(out("print(findIndex([1, 2], x -> x > 9))"), "null")
    assert_eq(out("print(findIndex([1, 2], x -> x > 9) ?? 0)"), "0")

@test
every_and_some_stop_as_soon_as_the_answer_is_settled()
    assert_eq(out("print(every([2, 4], x -> x % 2 == 0))"), "true")
    assert_eq(out("print(every([2, 3], x -> x % 2 == 0))"), "false")
    assert_eq(out("print(some([1, 2], x -> x > 1))"), "true")
    assert_eq(out("print(some([1, 2], x -> x > 9))"), "false")

    // What the two questions mean about nothing.
    assert_eq(out("print(every([], x -> false))"), "true")
    assert_eq(out("print(some([], x -> true))"), "false")

    // Stopping early is observable: the callback is not reached for what came after the answer.
    assert_eq(out("var n = 0\nprint(some([1, 2, 3], x -> \n    n = n + 1\n    x == 1))\nprint(n)"), "true\n1")

@test
SORTING_ORDERS_NUMBERS_AS_NUMBERS()
    // **JavaScript's most quoted defect.** `[10, 9].sort()` answers `[10, 9]` there, because the
    // default comparator renders both to text and compares those -- so "10" comes before "9". A
    // comparator should be needed only where the answer is genuinely ambiguous, and two numbers are
    // not.
    assert_eq(out("print(sorted([10, 9, 100, 1]))"), "[1, 9, 10, 100]")
    assert_eq(out("print(sorted([\"b\", \"a\", \"c\"]))"), "[\"a\", \"b\", \"c\"]")
    assert_eq(out("print(sorted([2.5, 1.5]))"), "[1.5, 2.5]")

    // A mixture has no order, and saying so beats inventing one.
    assert(fails("print(sorted([1, \"a\"]))").contains("does not apply to"))

@test
A_COMPARATOR_ANSWERS_A_BOOLEAN_BECAUSE_ZERO_IS_TRUE_HERE()
    assert_eq(out("print(sorted([1, 3, 2], (a, b) -> a > b))"), "[3, 2, 1]")

    // **The reason it cannot be JavaScript's number.** Only `null`, `undefined` and `false` are
    // false in slate, so `0` is true -- a comparator answering -1, 0 or 1 would read as "yes, yes,
    // yes" and sort nothing, with no complaint anywhere. A boolean cannot be misread, and anything
    // else is refused in a sentence naming what arrived.
    assert(fails("print(sorted([2, 1], (a, b) -> 1))").contains("a comparator answers whether the first value comes before the second"))
    assert(fails("print(sorted([2, 1], (a, b) -> 0))").contains("answered an integer"))

@test
sorting_is_stable_so_two_orderings_compose()
    // **An unstable sort loses the first ordering**, which is the whole reason a program sorts
    // twice. Merge sort is what makes this true rather than an accident of the input.
    val prog = "val xs = [{ n: \"b\", g: 1 }, { n: \"a\", g: 1 }, { n: \"c\", g: 0 }]\n" +
        "val byName = sorted(xs, (p, q) -> p.n < q.n)\n" +
        "print(map(sorted(byName, (p, q) -> p.g < q.g), p -> p.n))"

    assert_eq(out(prog), "[\"c\", \"a\", \"b\"]")

@test
THE_BARE_VERB_CHANGES_THE_ARRAY_AND_THE_PARTICIPLE_ANSWERS_A_NEW_ONE()
    // **JavaScript's `sort` and `reverse` mutate while `map` and `filter` do not, and nothing in
    // the name says which.** Python's `sorted(xs)` against `xs.sort()` is the fix, and slate holds
    // that convention for both pairs.
    assert_eq(out("val xs = [3, 1, 2]\nval ys = sorted(xs)\nprint(xs, ys)"), "[3, 1, 2] [1, 2, 3]")
    assert_eq(out("val xs = [3, 1, 2]\nsort(xs)\nprint(xs)"), "[1, 2, 3]")
    assert_eq(out("val xs = [1, 2, 3]\nval ys = reversed(xs)\nprint(xs, ys)"), "[1, 2, 3] [3, 2, 1]")
    assert_eq(out("val xs = [1, 2, 3]\nreverse(xs)\nprint(xs)"), "[3, 2, 1]")

@test
A_MUTATOR_NEVER_ANSWERS_THE_ARRAY_IT_CHANGED()
    // **So a mutation cannot be chained and mistaken for a fresh array.** JavaScript hands the array
    // back from `sort`, `reverse` and `push` alike, which is what makes its mutating and
    // non-mutating operations indistinguishable at the call site.
    assert_eq(out("print(sort([2, 1]))"), "null")
    assert_eq(out("print(reverse([1, 2]))"), "null")
    assert_eq(out("print(push([1], 2))"), "null")
    assert_eq(out("print(clear([1]))"), "null")
    assert_eq(out("print(insert([1], 0, 9))"), "null")

    // The two that take something out answer what they took, which is not the array.
    assert_eq(out("print(pop([1, 2]))"), "2")
    assert_eq(out("print(removeAt([1, 2], 0))"), "1")

@test
an_array_is_changed_in_place_by_name()
    assert_eq(out("val xs = [1]\npush(xs, 2)\nprint(xs)"), "[1, 2]")
    assert_eq(out("val xs = [1, 2, 3]\nprint(pop(xs), xs)"), "3 [1, 2]")
    assert_eq(out("val xs = [1, 3]\ninsert(xs, 1, 2)\nprint(xs)"), "[1, 2, 3]")
    assert_eq(out("val xs = [1, 2, 3]\nprint(removeAt(xs, 1), xs)"), "2 [1, 3]")
    assert_eq(out("val xs = [1, 2]\nclear(xs)\nprint(xs, len(xs))"), "[] 0")

    // A position past the end is a fault naming how many places there are.
    assert(fails("insert([1], 5, 0)").contains("was given the position 5, and this array has 1 places"))
    assert(fails("removeAt([1], 3)").contains("was given the position 3"))
    assert(fails("insert([1], -1, 0)").contains("the position -1"))

@test
POPPING_AN_EMPTY_ARRAY_IS_A_FAULT_AND_NOT_AN_ABSENT_VALUE()
    // **JavaScript answers `undefined`, which travels.** slate's `undefined` is the one value that
    // may not travel, so the honest answer is to say it where it happened rather than to hand back
    // something the next line has to refuse.
    assert(fails("pop([])").contains("there is nothing to pop off an empty array"))
    assert(fails("removeAt([], 0)").contains("there is nothing to remove from an empty array"))

@test
arrays_are_joined_flattened_and_added_up()
    assert_eq(out("print(concat([1], [2, 3]))"), "[1, 2, 3]")
    assert_eq(out("print(concat([1]))"), "[1]")
    assert_eq(out("print(concat([], []))"), "[]")

    // **One level and not all of them**, which is what JavaScript's default depth is: flattening a
    // tree of unknown depth is a different question, and doing it by accident to an array of pairs
    // loses the pairs.
    assert_eq(out("print(flat([[1, 2], [3]]))"), "[1, 2, 3]")
    assert_eq(out("print(flat([[[1]], [2]]))"), "[[1], 2]")
    assert_eq(out("print(flat([1, [2]]))"), "[1, 2]")

    assert_eq(out("print(sum([1, 2, 3]))"), "6")
    assert_eq(out("print(sum([]))"), "0")
    assert_eq(out("print(sum([1, 0.5]))"), "1.5")

    assert(fails("print(concat([1], 2))").contains("`concat` joins arrays, and one of these is an integer"))

@test
searching_an_array_uses_the_same_words_searching_a_string_does()
    // One question asked of two kinds, dispatched on what it was given rather than spelled twice.
    assert_eq(out("print(contains([1, 2], 2), contains(\"ab\", \"b\"))"), "true true")
    assert_eq(out("print(indexOf([1, 2, 1], 1), indexOf(\"aba\", \"a\"))"), "0 0")
    assert_eq(out("print(lastIndexOf([1, 2, 1], 1), lastIndexOf(\"aba\", \"a\"))"), "2 2")
    assert_eq(out("print(indexOf([1], 9))"), "null")

    // Equality is slate's, so a structure is found by what it holds and not by identity.
    assert_eq(out("print(contains([{ n: 1 }], { n: 1 }))"), "true")

@test
A_BUILTIN_METHOD_IS_THE_FREE_FUNCTION_WITH_THE_RECEIVER_IN_FRONT()
    // One implementation, one set of argument checks, one diagnostic -- reachable two ways.
    assert_eq(out("print([1, 2].map(x -> x + 1))"), "[2, 3]")
    assert_eq(out("print(map([1, 2], x -> x + 1))"), "[2, 3]")
    assert_eq(out("print([3, 1].sorted())"), "[1, 3]")
    assert_eq(out("print(\"a,b\".split(\",\"))"), "[\"a\", \"b\"]")
    assert_eq(out("print(\" x \".trim().upper())"), "X")
    assert_eq(out("print([1, 2].len(), \"ab\".len())"), "2 2")
    assert_eq(out("print((3.7).floor(), (0 - 2).abs())"), "3 2")

    // A method on its own is the plain builtin, exactly as `o.m` on an object is the plain function.
    assert_eq(out("val f = [1].len\nprint(f([1, 2, 3]))"), "3")

@test
A_METHOD_IS_LOOKED_UP_BY_THE_KIND_OF_THE_RECEIVER()
    // **The refusal names the kind, not the argument.** Reaching `upper` and complaining about what
    // it was given would send the reader to look at the value when what is wrong is the call.
    assert(fails("print([1].upper())").contains("`upper` is not something an array can do"))
    assert(fails("print(\"a\".push(1))").contains("`push` is not something a string can do"))
    assert(fails("print((1).map(x -> x))").contains("`map` is not something an integer can do"))
    assert(fails("print(true.len())").contains("`len` is not something a boolean can do"))

    // The same sentence without the call, since a builtin's set of names is closed either way.
    assert(fails("print([1].nope)").contains("`nope` is not something an array can do"))

@test
A_PROGRAM_MAY_NOT_ADD_TO_A_BUILTIN_TYPES_METHODS()
    // **The table is in the interpreter and is not an object a program can reach**, which settles by
    // construction what JavaScript settles by convention. Patching `Array.prototype` is what every
    // `hasOwnProperty` guard in node's ecosystem is defending against; slate has nowhere to patch.
    assert(fails("[1].proto = { double: xs -> xs }").contains("a field belongs to an object, and this is an array"))
    assert(fails("val p = [1].proto").contains("`proto` is not something an array can do"))

    // A program that wants its own array operation writes a function, which is what a function is
    // for -- and it composes with the builtins without being one.
    assert_eq(out("second(xs) = xs[1]\nprint(second([1, 2, 3].map(x -> x * 10)))"), "20")

@test
AN_OBJECTS_NAMES_BELONG_TO_THE_PROGRAM_AND_NOT_TO_A_TABLE()
    // **An object is deliberately absent from the method table.** A builtin answering there would
    // make every object claim to have a `keys`, a `len` and a `has` that nothing put on it -- so
    // `o.keys ?? fallback` would stop working for exactly those names, silently and only for those.
    // Objects already have a method mechanism, which is `proto`.
    assert_eq(out("print({ n: 1 }.keys ?? \"absent\")"), "absent")
    assert_eq(out("print(keys({ n: 1 }), len({ n: 1 }))"), "[\"n\"] 1")
    assert(fails("print({ n: 1 }.keys())").contains("`keys` is not a field of this object"))

    // And a proto is how an object gets one, unchanged by any of this.
    assert_eq(out("val shape = { area: s -> s.w * s.h }\nprint({ proto: shape, w: 2, h: 3 }.area())"), "6")

@test
a_builtin_walking_an_array_survives_a_collection_inside_its_callback()
    // **A sysl `Buf` of values is not a root**, so a callback that allocates could collect
    // everything mapped so far. The result array is a collected object and is held, and each answer
    // is pushed into it as it arrives -- which is what makes it reachable.
    val prog = "val xs = []\n" +
        "for i in 0..<400\n" +
        "    push(xs, i)\n" +
        "val ys = map(xs, i -> s\"item ${i} of ${len(xs)}\")\n" +
        "print(len(ys), ys[0], ys[399])"

    assert_eq(out(prog), "400 item 0 of 400 item 399 of 400")

@test
an_argument_of_the_wrong_kind_says_what_was_wanted()
    assert(fails(Opaque + "map(anything(1), x -> x)").contains("`map` takes an array, and this is an integer"))
    assert(fails(Opaque + "anything(map)([1])").contains("`map` takes an array and a function, and was given 1 arguments"))
    assert(fails(Opaque + "anything(reduce)([1], (a, b) -> a)").contains("an array, a function and a starting value"))
    assert(fails("sorted([1], 2, 3)").contains("an array and an optional comparator"))
    assert(fails(Opaque + "sum(anything(\"a\"))").contains("`sum` takes an array"))

@test
A_CALLBACK_THAT_CHANGES_THE_ARRAY_IT_IS_WALKING_IS_TOLD_SO()
    // **Without this it is a sysl panic**, naming a `Buf` index and no line of the program: the loop
    // bound is read once, so an element removed part-way through leaves the next read past the end.
    // JavaScript's answer is quieter and worse -- `map` visits whatever survives and leaves holes,
    // so the mistake becomes a short array nobody traces back to the callback that caused it.
    val said = fails("val xs = [1, 2, 3, 4]\nprint(map(xs, x -> \n    pop(xs)\n    x))")

    assert(said.contains("this array was changed while `map` was walking it"))

    // The message names the fix, since a reader who believes it still has to know what to do.
    assert(said.contains("walk a copy of it, or build a new array"))

    // Every walk that can reach a program is guarded, not only the written-callback ones.
    assert(fails("val xs = [1, 2]\nfilter(xs, x -> \n    clear(xs)\n    true)").contains("`filter` was walking it"))
    // Written with the function named first, a block lambda having to be the last argument.
    val folding = "val xs = [1, 2]\nval f = (a, b) -> \n    pop(xs)\n    a\nreduce(xs, f, 0)"

    assert(fails(folding).contains("`reduce` was walking it"))
    assert(fails("val xs = [1, 2]\nfind(xs, x -> \n    push(xs, 3)\n    false)").contains("`find` was walking it"))
    assert(fails("val xs = [1, 2]\nevery(xs, x -> \n    pop(xs)\n    true)").contains("`every` was walking it"))
    assert(fails("val xs = [3, 1, 2, 5, 4]\nsort(xs, (a, b) -> \n    pop(xs)\n    a < b)").contains("`sort` was walking it"))

    // Including the ones whose only re-entry is a user `equals` reached from `same`.
    val hooked = "val probe = { n: 1, equals: o -> \n    clear(xs)\n    false }\n" +
        "val xs = [probe, probe, probe]\n" +
        "print(contains(xs, { n: 1 }))"

    assert(fails(hooked).contains("`contains` was walking it"))

// -- a binding that takes a value apart -------------------------------------------------------------

@test
a_binding_may_take_an_array_or_an_object_apart()
    assert_eq(out("val [a, b] = [1, 2]\nprint(a, b)"), "1 2")
    assert_eq(out("val { name, born } = { name: \"Ada\", born: 1815 }\nprint(name, born)"), "Ada 1815")

    // The long form renames, and the short one is the shorthand every language with this grows.
    assert_eq(out("val { name: who } = { name: \"Grace\" }\nprint(who)"), "Grace")

    // The same patterns a `match` arm is written with, so nesting and `...` come for free.
    assert_eq(out("val [first, ...rest] = [1, 2, 3]\nprint(first, rest)"), "1 [2, 3]")
    assert_eq(out("val { p: { q } } = { p: { q: 7 } }\nprint(q)"), "7")
    assert_eq(out("val [[m, n]] = [[1, 2]]\nprint(m, n)"), "1 2")

@test
a_destructuring_var_may_be_written_to_and_a_val_may_not()
    assert_eq(out("var [x, y] = [1, 2]\nx = 10\nprint(x, y)"), "10 2")
    assert(fails("val [a] = [1]\na = 2").contains("`a` is a `val`, so it is written once"))

    // A gathered tail follows the same rule as the names beside it.
    assert_eq(out("var [h, ...t] = [1, 2, 3]\nt = []\nprint(h, t)"), "1 []")

@test
A_BINDING_THAT_DOES_NOT_FIT_IS_A_FAULT_SAYING_WHICH_HALF_IS_WRONG()
    // **A `match` arm that does not fit needs no sentence and a binding does**, there being no next
    // arm to try. JavaScript answers `undefined` for a field that is not there and carries on, which
    // is the same absence-that-travels slate refuses everywhere else.
    assert(fails("val [a, b] = [1]").contains("this binding takes 2 elements out of an array, and this one has 1"))
    assert(fails("val [a, ...r] = []").contains("takes at least 1 elements"))
    assert(fails("val { a } = { b: 1 }").contains("this object has no field called `a`, which this binding takes out of it"))
    assert(fails("val [a] = 5").contains("this binding takes an array apart, and this is an integer"))
    assert(fails("val { a } = 5").contains("this binding takes an object apart, and this is an integer"))

    // Right shape, wrong contents -- the two halves are different sentences.
    assert(fails("val [1, b] = [2, 3]").contains("this array has the right number of elements, and one of them does not fit"))

@test
THE_FIRST_TOKEN_DECIDES_SO_AN_ORDINARY_BINDING_IS_UNCHANGED()
    // **A bare name in pattern position is a type test where it names a type**, so reading every
    // binding as a pattern would stop `val string = 5` binding `string` and start testing against
    // it. A `[` or a `{` can begin no name, which is the whole of the decision.
    assert_eq(out("val string = 5\nprint(string)"), "5")
    assert_eq(out("val number = \"x\"\nprint(number)"), "x")
    assert_eq(out("for string in [1, 2]\n    print(string)"), "1\n2")

@test
a_for_head_may_take_each_element_apart()
    assert_eq(out("for [a, b] in [[1, 2], [3, 4]]\n    print(a, b)"), "1 2\n3 4")
    assert_eq(out("for { n } in [{ n: 1 }, { n: 2 }]\n    print(n)"), "1\n2")

    // An element that does not fit is the same fault a binding is, and names the turn it happened on.
    assert(fails("for [a, b] in [[1, 2], [3]]\n    print(a)").contains("takes 2 elements out of an array, and this one has 1"))

@test
an_object_is_walked_as_keys_values_or_pairs()
    assert_eq(out("print(keys({ a: 1, b: 2 }))"), "[\"a\", \"b\"]")
    assert_eq(out("print(values({ a: 1, b: 2 }))"), "[1, 2]")
    assert_eq(out("print(entries({ a: 1 }))"), "[[\"a\", 1]]")

    // **The pairs are what make a destructuring `for` head pay for itself.** In the order the fields
    // were first written, which is the order `keys` already answers in.
    assert_eq(out("for [k, v] in entries({ a: 1, b: 2 })\n    print(k, v)"), "a 1\nb 2")
    assert_eq(out("print(entries({}))"), "[]")
    assert(fails(Opaque + "entries(anything([1]))").contains("`entries` needs an object, and this is an array"))

// -- reading a field that may not be there -----------------------------------------------------

@test
optional_chaining_answers_null_where_there_is_nothing_to_read()
    assert_eq(out("print({ a: { b: 7 } }?.a?.b)"), "7")
    assert_eq(out("val n = null\nprint(n?.a)"), "null")
    assert_eq(out("print({ a: 1 }.missing?.b)"), "null")

    // It composes with `??`, which is what makes the pair worth having: one says where absence is
    // allowed and the other says what to do about it.
    assert_eq(out("val n = null\nprint(n?.a ?? \"gone\")"), "gone")

@test
QDOT_GUARDS_ITS_OWN_LINK_AND_NOT_THE_REST_OF_THE_CHAIN()
    // **Kotlin's rule rather than JavaScript's.** `a?.b.c` reads `b` off `a` or answers null, and
    // then asks `.c` of whatever that was. slate's rule about absence everywhere is that it stops at
    // the boundary it arose at, and one character quietly excusing a whole line is the opposite of
    // that -- so the reader writes `a?.b?.c` and says where each one is allowed.
    val said = fails("val n = null\nprint(n?.a.b)")

    assert(said.contains("there is nothing here to read `b` from"))

    // **The message names `?.` rather than the field**, because what is wrong is one link earlier.
    // "`b` is not something null can do" is true and sends the reader to look at the wrong thing.
    assert(said.contains("`?.` answers null where a value may be missing"))
    assert_eq(out("val n = null\nprint(n?.a?.b)"), "null")

@test
an_optional_method_call_does_not_evaluate_its_arguments()
    assert_eq(out("print({ greet: () -> \"hi\" }?.greet())"), "hi")
    assert_eq(out("val n = null\nprint(n?.greet())"), "null")

    // **Which is what makes the guard worth having over a test afterwards.** A written-out
    // `if n != null then n.greet(side())` says the same thing; `n?.greet(side())` says it once.
    val prog = "var calls = 0\nside() = \n    calls = calls + 1\n    1\n" +
        "val n = null\nprint(n?.greet(side()), calls)"

    assert_eq(out(prog), "null 0")

@test
an_optional_field_may_not_be_assigned_to()
    // There is no answer to what writing into absence should do, and JavaScript agrees.
    assert(fails("val o = { a: 1 }\no?.a = 2").contains("this cannot be assigned to"))

// -- JSON ----------------------------------------------------------------------------------------

@test
json_maps_onto_slates_own_values_because_they_are_the_same_seven_things()
    val prog = "val r = parseJSON(\"{\\\"name\\\": \\\"Ada\\\", \\\"tags\\\": [1, 2.5, true, null]}\")\n" +
        "print(r.ok, r.value.name, r.value.tags[1], r.value.tags[3])"

    assert_eq(out(prog), "true Ada 2.5 null")

    // Both kinds of number survive, which is the whole reason `sh.sysl.json` has two variants: a
    // real cannot hold an identifier past 2^53 and a long cannot hold 0.5.
    assert_eq(out("print(parseJSON(\"[1, 1.5]\").value)"), "[1, 1.5]")
    assert_eq(out("print(toJSON({ a: [1, 2] }))"), "{\"a\":[1,2]}")
    assert_eq(out("print(toJSON(parseJSON(\"{\\\"a\\\":1}\").value))"), "{\"a\":1}")

    // The second argument lays it out for a person.
    assert_eq(out("print(toJSON({ a: 1 }, 2))"), "{\n  \"a\": 1\n}")

@test
A_DOCUMENT_THAT_WILL_NOT_PARSE_IS_A_RESULT_AND_A_VALUE_THAT_WILL_NOT_RENDER_IS_A_FAULT()
    // **slate's two channels applied to the two directions, which genuinely differ.** Text arriving
    // from a file, a socket or a person is a condition every caller was going to handle; a function
    // or a circle in a value the program built itself is a defect in that program. `JSON.parse` and
    // `JSON.stringify` both throw, so node treats the two alike.
    assert_eq(out("print(parseJSON(\"{oops}\").ok)"), "false")

    // **The whole rendering and not just the headline.** A JSON document is usually machine-written
    // and long, so a bare "expected a string" says nothing a person can act on.
    val said = out("print(parseJSON(\"{oops}\").error)")

    assert(said.contains("expected a string"))
    assert(said.contains("{oops}"))

    // And the other direction faults, naming the thing that has no encoding.
    assert(fails("toJSON({ f: () -> 1 })").contains("there is no JSON for a function"))
    assert(fails("toJSON(print)").contains("there is no JSON for a function"))

@test
A_VALUE_WITH_NO_JSON_FORM_IS_NAMED_RATHER_THAN_DROPPED()
    // **Where slate parts company with node.** `JSON.stringify` drops a function and an `undefined`
    // silently from an object and turns them into `null` inside an array, so a request body goes out
    // with a field missing and nothing anywhere says which.
    assert(fails("toJSON([() -> 1])").contains("there is no JSON for a function"))

    // A circle is a fault with a sentence rather than a hang.
    assert(fails("val o = { a: 1 }\no.self = o\ntoJSON(o)").contains("this object holds itself, so there is no JSON for it"))
    assert(fails("val xs = []\npush(xs, xs)\ntoJSON(xs)").contains("this array holds itself"))

    // A JSON name is a string and a slate key is any value, so a key that is not one has no
    // encoding -- rendering it as text would make `{ 1: "a" }` and `{ "1": "a" }` one document.
    assert(fails("val o = {}\no[1] = \"x\"\ntoJSON(o)").contains("a JSON name is a string, and this object has a key that is an integer"))

@test
json_says_what_it_wanted_when_given_something_else()
    assert(fails(Opaque + "parseJSON(anything(5))").contains("`parseJSON` takes a string, and this is an integer"))
    assert(fails(Opaque + "anything(parseJSON)()").contains("takes one string and was given 0 arguments"))
    assert(fails("toJSON()").contains("a value and an optional indent"))
    assert(fails("toJSON({}, \"two\")").contains("takes an indent as a number, and this is a string"))
    assert(fails("toJSON({}, 40)").contains("indents by 0 to 16 spaces, and this is by 40"))

// -- what the compiler can say without running the program -----------------------------------------

@test
AN_ANNOTATED_PARAMETER_IS_CHECKED_WHERE_THE_CALL_IS_WRITTEN()
    // **The whole point of the pass: the same complaint, earlier.** The run-time check is still
    // there and still fires for a value that arrived from outside; this catches the ones written
    // down, which are the ones a person could have been told about before running anything.
    assert(fails("f(x: string) = x\nprint(f(42))").contains("`f` takes string here, and this is integer"))
    assert(fails("f(n: number) = n\nprint(f(\"s\"))").contains("takes number here, and this is string"))
    assert(fails("f(xs: array) = xs\nprint(f(\"no\"))").contains("takes array here, and this is string"))

    // The complaint points at the ARGUMENT rather than at the call, which is the thing to change.
    assert(fails("f(x: string) = x\nprint(f(42))").contains("^^"))

@test
AN_INTEGER_DOES_NOT_FIT_A_REAL_BECAUSE_THE_MACHINE_SAYS_SO()
    // **`fits` mirrors `is_kind` and may not drift from it.** Arithmetic promotes an integer to a
    // real and a type test does not, so `f(x: real)` given `1` faults when it runs -- and a checker
    // that let it through would be describing a language slate is not.
    assert(fails("f(r: real) = r\nprint(f(1))").contains("takes real here, and this is integer"))
    assert(fails("f(i: integer) = i\nprint(f(1.5))").contains("takes integer here, and this is real"))
    assert_eq(out("f(n: number) = n\nprint(f(1), f(1.5))"), "1 1.5")

    // A real anywhere in the arithmetic makes the answer a real, which is slate's promotion. Saying
    // `number` there would be true and too weak, and would refuse this.
    assert_eq(out("f(r: real) = r\nprint(f(1.0 * 2), f(2 * 1.5))"), "2 3")

@test
THE_ARITY_OF_A_CALL_IS_COUNTED_WHILE_COMPILING()
    assert(fails("f(a, b) = a\nf(1)").contains("`f` takes 2 arguments and this gives it 1"))
    assert(fails("val g = (a, b) -> a\ng(1, 2, 3)").contains("takes 2 arguments and this gives it 3"))

    // **A count that is wrong makes every argument's position a guess**, so nothing else about the
    // call is said -- four type errors for one missing argument is the commonest way a checker
    // becomes a thing to work around.
    val said = fails("f(a: string, b: string) = a\nf(1)")

    assert(said.contains("takes 2 arguments"))
    assert(!said.contains("takes string here"))

@test
AN_OBJECT_LITERAL_AT_THE_CALL_IS_CHECKED_AND_ONE_THROUGH_A_NAME_IS_NOT()
    // **The conservative boundary of this pass, and it is a decision rather than an omission.** An
    // object is mutable and a field may be added to it anywhere, so a shape recorded when it was
    // built is a claim that goes out of date with nothing local saying so -- and a stale shape is
    // too NARROW, which would refuse a program that runs.
    val shapes = "type P = { x: number, y: number }\nd(p: P) = p.x + p.y\n"

    assert(fails(shapes + "print(d({ x: 1 }))").contains("takes { x: number, y: number } here, and this is { x: integer }"))

    // A literal with MORE than was asked for still fits, which is the object pattern's rule and has
    // to be the type's too or one annotation would mean two things.
    assert_eq(out(shapes + "print(d({ x: 1, y: 2, z: 3 }))"), "3")

    // Through a name it is not checked, however it was built -- and the run-time check still is.
    assert_eq(out(shapes + "val built = { x: 1 }\nbuilt.y = 2\nprint(d(built))"), "3")

@test
AN_OPERATOR_THAT_CANNOT_MEET_IS_REFUSED_WHILE_COMPILING()
    assert(fails("print(1 + \"a\")").contains("`+` does not apply to integer and string"))
    assert(fails("f(s: string) = s * 2\nf(\"a\")").contains("`*` does not apply to string and integer"))

    // Only where both sides are known. Anything less certain is left to the machine.
    assert_eq(out("anything(v) = v\nprint(anything(1) + 1)"), "2")
    assert_eq(out("print(\"a\" + \"b\", 1 + 1, 1 + 1.5)"), "ab 2 2.5")

@test
THE_CHECKER_MAY_ONLY_REPORT_WHAT_THE_MACHINE_WOULD_ALSO_REFUSE()
    // **The rule the whole pass is built on.** A checker that is sometimes wrong is worse than no
    // checker, because a program then has to be written around it -- so everything the walk is
    // unsure of is `any`, which fits everything.
    //
    // Each of these is a legal program, and each is one the pass could have got wrong.

    // A `var` is `any` whatever it held, because this pass does not follow assignments.
    assert_eq(out("takes(s: string) = s\nvar v = 1\nv = \"text\"\nprint(takes(v))"), "text")

    // A builtin has no type here, so a call to one is never checked.
    assert_eq(out("print(len(\"abc\"), sorted([2, 1]))"), "3 [1, 2]")

    // A name a pattern bound is unknown, so nothing is said about it.
    assert_eq(out("takes(n: number) = n\nprint(5 match\n    bound -> takes(bound))"), "5")

    // `function` says callable and nothing about arity, so counting against it would refuse this.
    assert_eq(out("apply1(f: function) = f(1)\nprint(apply1(x -> x * 2))"), "2")

    // Mutual recursion works because every definition in a block is noted before any is walked.
    assert_eq(out("down(n: integer) = if n <= 0 then 0 else up(n - 1)\nup(n: integer) = down(n - 1)\nprint(down(4))"), "0")

@test
a_static_complaint_stops_the_program_the_way_a_parse_error_does()
    // It goes through `compile_faults`, which `run` and `prepare` both fold in, so nothing of the
    // program runs -- including the part before the mistake.
    val said = fails("print(\"before\")\nf(x: string) = x\nprint(f(1))")

    assert(said.contains("takes string here"))
    assert(!said.contains("before"))

@test
A_BUILTIN_HAS_A_SIGNATURE_AND_A_CALL_TO_ONE_IS_CHECKED()
    assert(fails("print(upper(5))").contains("`upper` takes string here, and this is integer"))
    assert(fails("print(keys([1]))").contains("`keys` takes object here, and this is array"))
    assert(fails("print(map({ a: 1 }, x -> x))").contains("`map` takes array here"))
    assert(fails("print(len(\"a\", \"b\"))").contains("`len` takes 1 arguments and this gives it 2"))
    assert(fails("print(split(\"a,b\"))").contains("`split` takes 2 arguments and this gives it 1"))

    // What a builtin ANSWERS flows on, which is where a signature pays for itself twice.
    assert(fails("f(s: string) = s\nval n = len(\"abc\")\nprint(f(n))").contains("takes string here, and this is integer"))

@test
A_POSITION_THAT_MAY_BE_NULL_SAYS_SO_IN_ITS_TYPE()
    // **A real check rather than a nicety.** `indexOf` answers a position or nothing, so handing its
    // answer straight to a parameter wanting a number is a fault the machine would raise -- and the
    // union is what lets the compiler see it first.
    assert(fails("f(n: number) = n\nprint(f(indexOf(\"abc\", \"z\")))").contains("this is integer | null"))

    // And `??` is what a program writes instead, which the pass leaves alone.
    assert_eq(out("f(n: number) = n\nprint(f(indexOf(\"abc\", \"b\") ?? 0))"), "1")

@test
ONLY_THE_BUILTINS_WITH_A_FIXED_ARITY_HAVE_A_SIGNATURE()
    // `print`, `assert`, `min`, `max`, `concat`, `sorted`, `sort` and `toJSON` all take a range of
    // counts, and a signature saying one number would refuse the other -- so they say nothing.
    assert_eq(out("print(min(1, 2), max(1, 2, 3), concat([1], [2], [3]))"), "1 3 [1, 2, 3]")
    assert_eq(out("val xs = [2, 1]\nprint(sorted(xs), sorted(xs, (a, b) -> a > b))"), "[1, 2] [2, 1]")
    assert_eq(out("print(toJSON({ a: 1 }), toJSON({ a: 1 }, 1))"), "{\"a\":1} {\n \"a\": 1\n}")

@test
A_NAME_A_PROGRAM_TAKES_FOR_ITSELF_SHADOWS_THE_BUILTINS_SIGNATURE()
    // **Seeded into the outermost scope, so everything a program binds is found first.** Without
    // this, `for len in xs` would leave `len` looking like the builtin and the next call would be
    // counted against the wrong thing.
    assert_eq(out("val len = 5\nprint(len)"), "5")
    assert_eq(out("for len in [1, 2]\n    print(len)"), "1\n2")
    assert_eq(out("mine(len) = len(1, 2)\nprint(mine((a, b) -> a + b))"), "3")
    assert_eq(out("print(5 match\n    upper -> upper)"), "5")
    assert_eq(out("val [len, keys] = [1, 2]\nprint(len, keys)"), "1 2")

    // An imported name too, which is `any` and therefore no longer a builtin's signature.
    assert_eq(ran_out("tests/mods/uses_len.sl"), "9")

@test
A_TEST_NARROWS_THE_NAME_IT_TESTED()
    // **The feature a reader coming from TypeScript looks for first.** `x is string` makes `x` a
    // string for as long as the test held, so a call inside the branch is checked against that.
    val setup = "takes_string(s: string) = s\ntakes_number(n: number) = n\n"

    assert(fails(setup + "f(x) = if x is number then takes_string(x) else 0\nf(1)").contains("takes string here, and this is number"))
    assert_eq(out(setup + "f(x) = if x is string then takes_string(x) else 0\nprint(f(\"a\"))"), "a")

    // A `match` arm narrows its subject by the same rule, the arm only running where it took.
    val armed = setup + "f(x) = x match\n    string -> takes_number(x)\n    _ -> 0\nf(\"a\")"

    assert(fails(armed).contains("takes number here, and this is string"))

    // `&&` narrows by both, which is what the second operand is already inside when it runs.
    assert(fails(setup + "f(x) = if x is string && len(x) > 0 then takes_number(x) else 0\nf(\"a\")").contains("takes number here, and this is string"))

    // A negated test narrows the OTHER branch, which is the same rule read backwards.
    assert(fails(setup + "f(x) = if x is not string then 0 else takes_number(x)\nf(\"a\")").contains("takes number here, and this is string"))

@test
A_VAR_IS_NEVER_NARROWED_BECAUSE_THE_BRANCH_MAY_WRITE_TO_IT()
    // **A stale narrowing is too NARROW, which refuses a program that runs** -- so the environment
    // records whether a name may be written to, and a mutable one is left alone however it tested.
    val prog = "takes_string(s: string) = s\nvar m = 1\nif m is number\n    m = \"text\"\n    print(takes_string(m))"

    assert_eq(out(prog), "text")

@test
a_definition_is_checked_against_what_it_promised_to_answer()
    assert(fails("f() -> string = 1").contains("this was declared to answer string, and answers integer"))
    assert_eq(out("f(n: integer) -> integer = n * 2\nprint(f(3))"), "6")

    // A block body answers `any` here and is left alone, which is also what keeps an early `return`
    // out of it -- nothing about a block's value is known, so nothing is claimed.
    assert(fails("f() -> string =\n    val x = 1\n    x\nprint(f())").contains("this answers string, and gave back 1"))

@test
an_async_definition_answers_a_promise_and_not_what_its_body_says()
    // **So a result annotation on one describes the awaited value rather than the call.** Believing
    // the annotation at the call site would make `takes_string(fetchIt(1))` look right when what
    // arrives is a promise -- and, worse, would make `await`ing it look wrong.
    val prog = "takes_string(s: string) = s\n" +
        "async fetchIt(n: integer) -> string = \"got \" + string(n)\n" +
        "async main() = print(takes_string(await fetchIt(1)))\n" +
        "main()"

    assert_eq(out(prog), "got 1")

    // The body is still checked against what it promised, which is where the annotation is true.
    assert(fails("async f() -> string = 1\nf()").contains("declared to answer string, and answers integer"))

@test
EVERY_BUILTIN_WITH_A_SIGNATURE_ACCEPTS_ITS_ORDINARY_USE()
    // **A wrong parameter or result type refuses a program that runs, and this is what would notice.**
    // Every seeded builtin is called the way a program calls it, and each answer is fed on to
    // another; one bad entry in `install_builtin_types` makes this refuse to compile.
    val prog = "val xs = [3, 1, 2]\nval o = { a: 1, b: 2 }\nval s = \"hello world\"\n" +
        "print(len(xs), len(o), len(s), len(0..<3))\n" +
        "print(map(xs, x -> x * 2), filter(xs, x -> x > 1), reduce(xs, (a, b) -> a + b, 0))\n" +
        "print(find(xs, x -> x > 1), findIndex(xs, x -> x > 1), every(xs, x -> x > 0), some(xs, x -> x > 2))\n" +
        "print(reversed(xs), flat([[1]]), sum(xs))\n" +
        "print(keys(o), values(o), entries(o), has(o, \"a\"))\n" +
        "print(split(s, \" \"), join(xs, \",\"), upper(s), trim(\"  x  \"), replace(s, \"l\", \"L\"), repeat(\"ab\", 2))\n" +
        "print(startsWith(s, \"he\"), endsWith(s, \"ld\"), contains(s, \"lo\"), contains(xs, 3))\n" +
        "print(indexOf(s, \"o\") ?? 0, lastIndexOf(xs, 1) ?? 0)\n" +
        "print(abs(0 - 2), floor(2.7), ceil(2.1), round(2.5), trunc(2.9))\n" +
        "print(string(1), boolean(0), parseJSON(\"{}\").ok, chars(\"ab\"))\n" +
        "push(xs, 9)\ninsert(xs, 0, 0)\nprint(removeAt(xs, 0), pop(xs))\nreverse(xs)\nclear(xs)\n" +
        "print(upper(trim(\"  x  \")), len(split(s, \" \")))"

    val said = out(prog)

    assert(!said.contains("error"), said)
    assert(said.contains("3 2 11 3"))

    // And the variadic ones, which have no signature and must go on having none.
    assert_eq(out("print(min(1, 2), max(1, 2, 3), concat([1], [2]), sorted([2, 1]), toJSON({}))"), "1 3 [1, 2] [1, 2] {}")

@test
THE_PROGRAMS_THE_CHECKER_COULD_HAVE_GOT_WRONG_AND_DOES_NOT()
    // Each line here is a legal program the pass had a way to refuse, and every one of them was
    // written down because a first cut of the pass did refuse it.
    val decls = "identity(v) = v\ntakes_number(n: number) = n\ntakes_real(r: real) = r\n" +
        "takes_int(i: integer) = i\ntakes_string(t: string) = t\ntakes_fn(f: function) = f(1)\n"

    // `number` accepts both kinds, and a real anywhere in the arithmetic makes the answer a real.
    assert_eq(out(decls + "print(takes_number(1), takes_number(1.5), takes_number(1 + 2))"), "1 1.5 3")
    assert_eq(out(decls + "print(takes_real(1.0 * 2), takes_real(2 * 1.5))"), "2 3")

    // A `number` on the answering side may be either, so it is refused against neither.
    assert_eq(out(decls + "half(x) = x / 2\nprint(takes_int(2 * 3), takes_real(1.0))"), "6 1")

    // `function` says callable and nothing about arity.
    assert_eq(out(decls + "print(takes_fn(x -> x * 2))"), "2")

    // An unannotated function answers `any`, which fits everywhere.
    assert_eq(out(decls + "print(takes_string(identity(\"z\")), takes_int(identity(1)))"), "z 1")

    // An object literal with more than was asked for fits; one reached through a name is not judged.
    val shapes = "type P = { x: number, y: number }\nd(p: P) = p.x + p.y\n"

    assert_eq(out(shapes + "print(d({ x: 1, y: 2, z: 3 }))"), "3")
    assert_eq(out(shapes + "val b = { x: 1 }\nb.y = 2\nprint(d(b))"), "3")

// -- the manifest ----------------------------------------------------------------------------------

// A manifest's value, rendered as JSON so that one string says the whole shape.
private conf(text: string) -> string
    val src = source_of("package.sl", text)
    val m = read_manifest(src)

    if !m.ok() then return s"REFUSED: ${m.report.render(src)}"

    s"${m.value()}"
end conf

// What a manifest that is refused says. Empty where it was accepted, so that a test asserting a
// refusal cannot pass by the file being fine.
private conf_error(text: string) -> string
    val src = source_of("package.sl", text)
    val m = read_manifest(src)

    if m.ok() then "" else m.report.render(src)
end conf_error

@test
A_MANIFEST_IS_slate_SYNTAX_READ_AS_DATA()
    // The seven things slate's value model has, which are the seven JSON has, which is the whole
    // reason the manifest is written in slate rather than in a format brought in from outside.
    assert_eq(conf("{}"), "{}")
    assert_eq(conf("{ name: \"slate\", version: \"0.0.1\" }"), "{\"name\":\"slate\",\"version\":\"0.0.1\"}")
    assert_eq(conf("{ on: true, off: false, missing: null }"), "{\"on\":true,\"off\":false,\"missing\":null}")
    assert_eq(conf("{ n: 1, x: 1.5 }"), "{\"n\":1,\"x\":1.5}")
    assert_eq(conf("{ xs: [1, \"two\", [3]] }"), "{\"xs\":[1,\"two\",[3]]}")

    // Nesting is the shape a dependency table wants, and it costs nothing.
    assert_eq(conf("{ deps: { parsing: { version: \"0.4.0\" } } }"),
        "{\"deps\":{\"parsing\":{\"version\":\"0.4.0\"}}}")

@test
A_MANIFEST_MAY_BE_COMMENTED_WHICH_IS_MOST_OF_WHY_IT_IS_NOT_JSON()
    // slate's own `package.hocon` is about three fifths comment. A manifest format a person cannot
    // annotate would have been the wrong trade whatever else it got right, and JSON -- which is
    // otherwise free here, `json.sysl` being already in the tree -- fails on this alone.
    val m = "// what this project is\n" +
        "{\n" +
        "    name: \"slate\",  // the package, and the executable\n" +
        "    version: \"0.0.1\"\n" +
        "}\n"

    assert_eq(conf(m), "{\"name\":\"slate\",\"version\":\"0.0.1\"}")

@test
A_NUMBER_WRITTEN_NEGATIVE_IS_ONE_NUMBER()
    // `-1` is a `Unary` in the tree, the lexer having no signed literal, so a pass that refused
    // every operator would refuse a number a person wrote as a number.
    assert_eq(conf("{ a: -1, b: -1.5 }"), "{\"a\":-1,\"b\":-1.5}")

    // And the gate is narrow: the operand has to be a literal itself.
    assert(conf_error("{ a: -(1 + 1) }").contains("in front of a number and nothing else"))
    assert(conf_error("{ a: !true }").contains("the only operator a manifest may use"))

@test
A_MANIFEST_IS_PARSED_AND_NEVER_RUN_SO_IT_REFUSES_CODE()
    // **Each refusal names what the thing IS.** "not a literal" is true of every one of these and
    // sends the reader to stare at a line whose problem it has not named.
    assert(conf_error("{ a: b }").contains("the name `b`"))
    assert(conf_error("{ a: f(1) }").contains("this is a call"))
    assert(conf_error("{ a: () -> 1 }").contains("a function"))
    assert(conf_error("{ a: 1 + 1 }").contains("a `+` between two things"))
    assert(conf_error("{ a: s\"v${1}\" }").contains("an interpolated string"))
    assert(conf_error("{ a: o.f }").contains("a field being read off something"))
    assert(conf_error("{ a: if true then 1 else 2 }").contains("an `if`"))
    assert(conf_error("{ a: undefined }").contains("no written form"))

    // The note says why, once, rather than each message carrying the whole rationale.
    assert(conf_error("{ a: b }").contains("parsed and never run"))

@test
A_MANIFEST_IS_ONE_OBJECT_AND_THE_CARET_GOES_WHERE_THE_READER_MUST_LOOK()
    assert(conf_error("").contains("this file is empty"))
    assert(conf_error("").contains("`{}`"))

    // **The second statement, not the first.** A file with two things in it is nearly always one
    // object closed too early, and the object itself is fine to look at.
    val two = "{ a: 1 }\n{ b: 2 }\n"

    assert(conf_error(two).contains("a second statement after it"))
    assert(conf_error(two).contains("closed it sooner than it looks"))
    assert(conf_error(two).contains("2 | { b: 2 }"))

    // A statement that is not an expression at all is named for what it is.
    assert(conf_error("val name = \"slate\"").contains("a `val` binding `name`"))
    assert(conf_error("f() = 1").contains("a definition of `f`"))

@test
A_REPEATED_KEY_IS_REFUSED_RATHER_THAN_QUIETLY_RESOLVED()
    // First-wins and last-wins both discard something a person wrote. JSON leaves this undefined and
    // every reader picks differently, which is the outcome a manifest most needs to avoid.
    val said = conf_error("{ a: 1, a: 2 }")

    assert(said.contains("`a` is written twice"))
    assert(said.contains("rather than choosing one of them"))

    // **The caret is on the second KEY, and which of the two it sits under is the whole point.** A
    // complaint about a key that pointed at its value would send the reader to look at `2`, which is
    // a perfectly good value -- so the position is asserted rather than merely the presence of a
    // caret, which was true before the spans were carried and said nothing.
    assert(said.contains("package.sl:1:9"))
    assert(said.contains("  |         ^"))

@test
A_FILE_THAT_WILL_NOT_PARSE_REPORTS_THE_PARSERS_COMPLAINT_AND_NOT_THE_PASSES()
    // Reporting "this is not data" about wreckage would send the reader one level in from where the
    // problem is, which is the failure mode this repo's diagnostic rule is written against.
    val said = conf_error("{ a: }")

    assert(said.contains("expected an expression"))
    assert(!said.contains("a manifest is data"))

@test
EVERY_MANIFEST_THE_READER_ACCEPTS_IS_ALSO_A_slate_EXPRESSION()
    // **This is the forward-compatibility claim, run rather than asserted.** The restriction is a
    // pass over slate's own tree, so a manifest is a slate expression that happens to be data --
    // which is what lets the file later be allowed to compute without any manifest written today
    // having to change. If the two ever disagreed there would be a format to migrate after all.
    val cases = ["{}", "{ a: 1 }", "{ a: -1, b: -1.5 }", "{ xs: [1, \"two\", [3]] }",
        "{ on: true, off: false, missing: null }", "{ deps: { p: { version: \"0.4.0\" } } }"]

    for i in 0..<cases.len
        val text = cases[i]

        // `toJSON` renders what the machine built; `conf` renders what the reader built. They are
        // two independent walks of the same source and they have to agree.
        assert_eq(conf(text), out(s"print(toJSON(${text}))"))

@test
A_MANIFEST_WITH_SEVERAL_MISTAKES_IN_IT_REPORTS_SEVERAL()
    // **The walk carries on after a refusal**, so a person editing a manifest is told everything
    // wrong with it in one go rather than being handed the first fault and coming back for the rest.
    // That is what the `Null` a failed item leaves behind is for: it is never read, `ok` being what
    // the caller checks.
    val said = conf_error("{ a: b, c: f(1), d: 1 + 1 }")

    assert(said.contains("the name `b`"))
    assert(said.contains("a call"))
    assert(said.contains("a `+` between two things"))

@test
THE_RESTRICTION_HOLDS_AT_EVERY_DEPTH_AND_NOT_ONLY_THE_TOP()
    // A pass that checked only the outermost object would let a manifest smuggle a call in three
    // levels down, which is exactly where nobody would look for it.
    assert(conf_error("{ a: { b: { c: f() } } }").contains("a call"))
    assert(conf_error("{ a: [1, [2, [g]]] }").contains("the name `g`"))

    // The same for a repeated key, which is a per-object question asked at every object.
    assert(conf_error("{ outer: { k: 1, k: 2 } }").contains("`k` is written twice"))

@test
A_MANIFEST_TAKES_slates_WHOLE_LITERAL_SYNTAX_INCLUDING_THE_PARTS_JSON_HAS_NOT()
    // Every one of these is a thing a person writing a version or a size would reach for, and JSON
    // has none of them. They arrive free, the reader being slate's own.
    assert_eq(conf("{ big: 1_000_000 }"), "{\"big\":1000000}")
    assert_eq(conf("{ mask: 0x10 }"), "{\"mask\":16}")
    assert_eq(conf("{ xs: [1, 2,], o: { a: 1, } }"), "{\"xs\":[1,2],\"o\":{\"a\":1}}")
    assert_eq(conf("{ empty_list: [], empty_obj: {} }"), "{\"empty_list\":[],\"empty_obj\":{}}")

@test
A_FILE_HOLDING_ONLY_COMMENTS_IS_AN_EMPTY_MANIFEST_AND_SAYS_SO()
    // The reading a person takes from silence here is "my file was ignored", so the message has to
    // be the same one an empty file gets rather than nothing at all.
    assert(conf_error("// nothing here yet\n").contains("this file is empty"))
    assert(conf_error("\n\n   \n").contains("this file is empty"))

@test
A_MANIFEST_KEY_IS_A_NAME_OR_A_STRING_WHICH_MAKES_IT_A_SUPERSET_OF_JSON()
    // The bare form is what a manifest writes nearly every time, and reads like a record.
    assert_eq(conf("{ parsing: { git: \"github.com/sysl-lang/parsing\" } }"),
        "{\"parsing\":{\"git\":\"github.com/sysl-lang/parsing\"}}")

    // **The quoted form is the only way to write the keys slate objects have always held.** A key
    // with a dot in it, a key that is a reserved word, the empty key: every one of them is an
    // ordinary key at run time, and before this the literal syntax had no way to say any of them.
    assert_eq(conf("{ \"a.b\": 1, \"if\": 2, \"\": 3 }"), "{\"a.b\":1,\"if\":2,\"\":3}")

    // **So a JSON document is a manifest.** That is what lets a machine-written file -- a lockfile,
    // or whatever `slate add` rewrites -- be read back by the reader that reads a hand-written one,
    // rather than the package system growing a second reader for its own output.
    assert_eq(conf("{\"name\": \"slate\", \"deps\": [{\"v\": \"0.4.0\"}], \"ok\": true, \"n\": null}"),
        "{\"name\":\"slate\",\"deps\":[{\"v\":\"0.4.0\"}],\"ok\":true,\"n\":null}")

    // JSON's number and string forms are slate's too, which is the rest of the superset claim and
    // was checked rather than assumed.
    assert_eq(conf("{\"a\": 1e2, \"b\": 1.5e-3, \"c\": \"x\\u0041y\", \"d\": \"p\\/q\"}"),
        "{\"a\":100.0,\"b\":0.0015,\"c\":\"xAy\",\"d\":\"p/q\"}")

    // **THE TWO READERS DISAGREE ABOUT `1e2`, AND THAT IS PINNED RATHER THAN PAPERED OVER.** slate
    // reads it as a REAL, exponent notation being how a real is written; `sh.sysl.json` reads it as
    // an INTEGER, its own note preferring exactness for an integral value. JSON has one numeric
    // production and says nothing about storage, so neither is unfaithful -- but a consumer that
    // switches on integer-versus-real gets a different answer depending on which reader saw the
    // file, and that is worth knowing before something depends on it.
    assert_eq(conf("{ \"a\": 1e2 }"), "{\"a\":100.0}")
    assert_eq(out("print(parseJSON(\"{\\\"a\\\": 1e2}\").value)"), "{a: 100}")

    // JSON's top level is any value at all, and the reader takes one.
    assert_eq(conf("[1, 2]"), "[1,2]")
    assert_eq(conf("42"), "42")

    // **The one place it is deliberately NOT a superset.** JSON permits a repeated name and leaves
    // the outcome undefined, which is why every JSON reader picks differently. A manifest refuses.
    assert(conf_error("{\"a\": 1, \"a\": 2}").contains("written twice"))

@test
A_REALISTIC_MANIFEST_READS_TO_WHAT_IT_LOOKS_LIKE()
    // slate's own dependencies, written as the manifest this reader is for. The point of the test is
    // that the file below is what a person would actually type -- comments, nesting, a trailing
    // comma -- and it needs nothing said about it beyond what is here.
    val m = "// slate -- a language stressor written in sysl.\n" +
        "{\n" +
        "    name: \"slate\",\n" +
        "    version: \"0.0.1\",\n" +
        "\n" +
        "    // The oldest compiler this builds with, not the newest available.\n" +
        "    sysl: \"0.0.82\",\n" +
        "\n" +
        "    dependencies: {\n" +
        "        parsing: { git: \"github.com/sysl-lang/parsing\", version: \"0.4.0\" },\n" +
        "        gc: { git: \"github.com/sysl-lang/gc\", version: \"0.2.2\" },\n" +
        "    },\n" +
        "\n" +
        "    requires: { heap: true },\n" +
        "}\n"

    assert_eq(conf(m), "{\"name\":\"slate\",\"version\":\"0.0.1\",\"sysl\":\"0.0.82\"," +
        "\"dependencies\":{\"parsing\":{\"git\":\"github.com/sysl-lang/parsing\",\"version\":\"0.4.0\"}," +
        "\"gc\":{\"git\":\"github.com/sysl-lang/gc\",\"version\":\"0.2.2\"}},\"requires\":{\"heap\":true}}")

@test
READING_A_MANIFEST_TOUCHES_NOTHING_OF_THE_MACHINE()
    // **The claim `manifest.sysl` makes, run rather than argued.** A manifest is read by tools that
    // have not chosen to trust it -- a resolver working out what to fetch is reading a file that
    // arrived with the thing it is deciding whether to fetch -- so the reader has to be the lexer,
    // the parser and a walk, and nothing else. `gc.used` is the heap's bump high-water mark and
    // never falls, so it is exactly the witness: if the reader built one collected object, it moves.
    val before = gc.used(&slate_heap)

    assert_eq(conf("{ name: \"slate\", deps: { p: { version: \"0.4.0\" } }, xs: [1, 2, 3] }"),
        "{\"name\":\"slate\",\"deps\":{\"p\":{\"version\":\"0.4.0\"}},\"xs\":[1,2,3]}")

    // A refusal walks the same tree and renders a diagnostic, which is the other path through.
    assert(conf_error("{ a: f(1) }").contains("a call"))

    assert_eq(gc.used(&slate_heap), before,
        "reading a manifest allocated on the collected heap, so it is not free of the machine")

// -- string keys ------------------------------------------------------------------------------------

// What a value prints as, and then what THAT prints as. The two have to agree, which is the whole of
// the round-trip claim: slate's printed form of an object is a slate expression.
private reprint(text: string) -> string = out(s"print(${out(s"print(${text})")})")

@test
A_KEY_IS_A_NAME_OR_A_STRING_AND_THE_QUOTED_FORM_REACHES_KEYS_THE_BARE_ONE_CANNOT()
    // **slate objects have always been keyed by any value at all** -- `table.sysl` says so and
    // `o["a.b"] = 1` has always worked. What was missing was a way to WRITE those keys in a literal,
    // which is what this adds. It is not a second spelling of a name: it is the only spelling for a
    // key that is not one.
    assert_eq(out("print({ \"a.b\": 1, \"if\": 2, \"\": 3, plain: 4 })"),
        "{\"a.b\": 1, \"if\": 2, \"\": 3, plain: 4}")

    // Read back with the accessor that has always reached them.
    assert_eq(out("val o = { \"a.b\": 1, \"if\": 2, \"\": 3 }\nprint(o[\"a.b\"], o[\"if\"], o[\"\"])"), "1 2 3")

    // A quoted key that IS a name is the same key as the bare one, not a second entry beside it.
    assert_eq(out("print({ \"a\": 1 })"), "{a: 1}")
    assert_eq(out("val o = { \"a\": 1 }\nprint(o.a)"), "1")

@test
A_KEY_THAT_IS_A_RESERVED_WORD_PRINTS_QUOTED_WHICH_IT_DID_NOT_BEFORE()
    // **The printer emitted a form the parser refused.** `plain_name` asked only whether the key was
    // name-SHAPED, so `if` printed bare -- and `{if: 2}` is not a program. It now asks the lexer what
    // it would do with the word, which is the only answer that cannot drift from the lexer itself.
    assert_eq(out("var o = {}\no[\"if\"] = 1\no[\"while\"] = 2\no[\"true\"] = 3\nprint(o)"),
        "{\"if\": 1, \"while\": 2, \"true\": 3}")

    // `end` is a SOFT word -- it reaches the parser as an `Ident` -- so it prints bare and reads
    // back, which is the case that says the check is asking the lexer rather than a list of its own.
    assert_eq(out("var o = {}\no[\"end\"] = 1\nprint(o)"), "{end: 1}")

@test
AN_OBJECT_OF_STRING_KEYS_PRINTS_AS_TEXT_slate_READS_BACK()
    // **The claim, run rather than asserted.** Printing is not a debugging convenience if what comes
    // out cannot be read back; this is what makes an object's printed form a value again.
    assert_eq(reprint("{ \"a.b\": 1, \"if\": 2, \"\": 3, plain: 4 }"),
        "{\"a.b\": 1, \"if\": 2, \"\": 3, plain: 4}")
    assert_eq(reprint("parseJSON(\"{\\\"a.b\\\": 1, \\\"if\\\": 2}\").value"), "{\"a.b\": 1, \"if\": 2}")
    assert_eq(reprint("{ a: [1, { \"x.y\": true }], b: null }"), "{a: [1, {\"x.y\": true}], b: null}")

@test
A_KEY_THAT_IS_NOT_A_STRING_AT_ALL_CANNOT_ROUND_TRIP_AND_IS_NOT_PRETENDED_TO()
    // **A number key prints bare and stays bare**, because quoting it would be a lie: `{ "42": 1 }`
    // is a different object from the one with the integer 42 as its key. `json.sysl` refuses the
    // same case for the same reason -- rendering the key as text would make two documents one.
    // So the round-trip claim above is about objects whose keys are strings, and this is the edge.
    assert_eq(out("var o = {}\no[42] = 1\nprint(o)"), "{42: 1}")
    assert_eq(fails("print({ 42: 1 })"), fails("print({ 42: 1 })"))
    assert(fails("print({ 42: 1 })").contains("expected a field name"))

@test
A_QUOTED_KEY_WORKS_WHEREVER_A_BARE_ONE_DOES_EXCEPT_AFTER_A_DOT()
    // `with` copies an object with fields changed, and takes the same keys a literal does.
    assert_eq(out("print({ a: 1 } with { \"b.c\": 2 })"), "{a: 1, \"b.c\": 2}")

    // A pattern takes them too, so a value with such a key can be taken apart.
    assert_eq(out("val { \"a.b\": ab, plain } = { \"a.b\": 1, plain: 2 }\nprint(ab, plain)"), "1 2")

    // **A FIELD ACCESS deliberately does NOT.** `o."a.b"` is refused; such a key is reached with
    // `o["a.b"]`, which slate has always had. Every language with this distinction draws it here,
    // and a dot that took a string would be a second way to write an index and nothing more.
    assert(fails("val o = { \"a.b\": 1 }\nprint(o.\"a.b\")").contains("a field name"))

@test
A_QUOTED_KEY_IN_A_PATTERN_HAS_NO_SHORTHAND_AND_SAYS_WHAT_TO_WRITE()
    // `{ name }` binds `name`. `{ "a.b" }` has no name in it to bind, so it is refused where it is
    // written rather than at the point where an invented name turned out not to exist.
    val said = fails("val { \"a.b\" } = { \"a.b\": 1 }\nprint(1)")

    assert(said.contains("is not a name, so this has to say what to bind it to"))
    assert(said.contains("\"a.b\": some_name"))

@test
A_PRINTED_STRING_IS_ESCAPED_SO_THAT_WHAT_COMES_OUT_CAN_BE_READ_BACK()
    // **Two defects that predate quoted keys and are the same one.** A `"` inside a string was
    // emitted raw, so `["a"b"]` came out and is not a program; a backslash was emitted raw, so a
    // string holding `\` and `f` printed as `"e\f"` and reads back as a formfeed. Printing is not a
    // debugging convenience if what comes out means something else when read.
    assert_eq(out("print([\"a\\\"b\", \"c\\nd\", \"e\\\\f\", \"g\\th\"])"),
        "[\"a\\\"b\", \"c\\nd\", \"e\\\\f\", \"g\\th\"]")

    // A control byte with no short escape takes the `\xHH` form, which slate's lexer reads.
    assert_eq(out("print([\"\\x01\"])"), "[\"\\x01\"]")

    // **A string prints bare at the top level**, where there is nothing to be ambiguous with, so
    // escaping is a quoted-position rule and not a property of the string.
    assert_eq(out("print(\"a\\\"b\")"), "a\"b")

    // Text outside ASCII is copied through as bytes rather than rebuilt as characters -- rebuilding
    // is how accented text turns into mojibake.
    assert_eq(out("print([\"café\"])"), "[\"café\"]")
    assert_eq(reprint("[\"café\", \"a\\\"b\", \"c\\nd\"]"), "[\"café\", \"a\\\"b\", \"c\\nd\"]")

    // The same holds of a key, which is what makes the round-trip claim hold for every string key
    // and not only the tidy ones.
    assert_eq(reprint("{ \"a\\nb\": 1, \"q\\\"r\": 2, \"café\": 3 }"),
        "{\"a\\nb\": 1, \"q\\\"r\": 2, \"café\": 3}")

@test
A_KEY_WRITTEN_TWICE_IN_ONE_LITERAL_KEEPS_THE_LAST_AND_THE_TWO_SPELLINGS_ARE_ONE_KEY()
    // **A quoted key that is a name IS the bare key**, not a second entry beside it, which is the
    // thing that would make the superset claim false if it were otherwise.
    assert_eq(out("print({ a: 1, \"a\": 2 })"), "{a: 2}")
    assert_eq(out("print(len({ a: 1, \"a\": 2 }))"), "1")

    // The manifest reader refuses what the literal quietly resolves, which is the difference between
    // a program -- where last-wins is the ordinary rule for a thing written twice -- and a file a
    // tool has to believe.
    assert(conf_error("{ a: 1, \"a\": 2 }").contains("written twice"))

// -- the command line ------------------------------------------------------------------------------

// The driver, run with its report collected rather than printed.
//
// **This is what `run_cli` taking somewhere to say things buys.** The status a shell would have seen
// is asserted here, in-process, with nothing reaching the terminal -- where before the driver
// printed straight out and answered nothing, so neither half of it could be pinned by a test at all.
//
// **THE `sink` IS NOT CEREMONY: a sysl closure captures BY VALUE.** Written the obvious way, as
// `line -> lines.push(line)`, the closure carries its own copy of the buffer and every push lands in
// it -- so the calls all succeed, nothing is reported, and `lines` is empty at the end. A pointer is
// captured by value too, and that is the whole difference: what it points at is the one buffer.
private cli_status(args: []string) -> int
    var lines: Buf[string] = buf()
    val sink = &lines

    run_cli(args, (line: string) -> sink.push(line))
end cli_status

// The same run, read for what it said.
private cli_said(args: []string) -> string
    var lines: Buf[string] = buf()
    val sink = &lines

    run_cli(args, (line: string) -> sink.push(line))

    var out = str_builder()

    for i in 0..<lines.len()
        if i > 0 then out.push("\n")

        out.push(lines.at(i))

    out.finish()
end cli_said

@test
A_SHELL_CAN_TELL_WHETHER_slate_SUCCEEDED()
    // **slate used to exit 0 on every failure** -- a syntax error, a missing file, a run-time fault
    // and a failing test alike -- so a shell, a `make` rule or a CI step could not tell a program
    // that ran from one that did not. Nothing here is about the wording of a diagnostic; it is about
    // the one number the rest of the world reads.
    val dir = libuv.mkdtemp_sync("/tmp/slate-cli-XXXXXX").unwrap()

    write_text(s"${dir}/ok.sl", "print(\"hi\")\n").unwrap()
    write_text(s"${dir}/bad.sl", "print(\n").unwrap()
    write_text(s"${dir}/faults.sl", "val xs = []\nxs[3]\n").unwrap()

    // Asked for nothing at all. **A distinct status from a program that failed**: this one is the
    // caller's own bug rather than news about a program.
    assert_eq(cli_status(["slate"]), 2)
    assert(cli_said(["slate"]).contains("usage: slate <program.sl>"))

    assert_eq(cli_status(["slate", s"${dir}/ok.sl"]), 0)
    assert_eq(cli_said(["slate", s"${dir}/ok.sl"]), "hi")

    assert_eq(cli_status(["slate", s"${dir}/bad.sl"]), 1)
    assert_eq(cli_status(["slate", s"${dir}/faults.sl"]), 1)

    // A file that is not there is the driver's own failure, and it still has to be one.
    assert_eq(cli_status(["slate", s"${dir}/nope.sl"]), 1)
    assert(cli_said(["slate", s"${dir}/nope.sl"]).contains("cannot read"))

    scrub(dir)

@test
A_TEST_RUN_TELLS_THE_SHELL_WHETHER_IT_PASSED()
    val dir = libuv.mkdtemp_sync("/tmp/slate-cli-XXXXXX").unwrap()

    write_text(s"${dir}/pass.sl", "@test\nholds()\n    assert(true)\n").unwrap()

    assert_eq(cli_status(["slate", "test", dir]), 0)

    write_text(s"${dir}/fail.sl", "@test\ndoes_not()\n    assert(false)\n").unwrap()

    assert_eq(cli_status(["slate", "test", dir]), 1)

    scrub(dir)

    // **A file the runner could not even load counts as a failure**, and it is a separate count from
    // a test that ran and said no -- a test step that reported success because the suite would not
    // compile is the worst answer available to it.
    val broken = libuv.mkdtemp_sync("/tmp/slate-cli-XXXXXX").unwrap()

    write_text(s"${broken}/bad.sl", "@test\nholds(\n").unwrap()

    assert_eq(cli_status(["slate", "test", broken]), 1)

    scrub(broken)

    // **And finding nothing to run is a failure too.** The usual cause is a path that is wrong, and
    // a green test step that tested nothing is worse than a red one.
    val empty = libuv.mkdtemp_sync("/tmp/slate-cli-XXXXXX").unwrap()

    assert_eq(cli_status(["slate", "test", empty]), 1)
    assert(cli_said(["slate", "test", empty]).contains("no .sl files"))

    scrub(empty)

// -- the manifest read as a project ----------------------------------------------------------------

// A project, flattened to one line so that a test says the whole of what was read.
private proj(text: string) -> string
    val f = read_project_text("package.sl", text)

    if !f.ok() then return s"REFUSED: ${proj_said(text)}"

    val p = f.project
    var out = str_builder()

    out.push(s"${p.name} ${p.version}")

    if p.main != "" then out.push(s" main=${p.main}")

    for i in 0..<p.dependencies.len()
        val d = p.dependencies.at(i)

        out.push(s" ${d.name}@${d.version}<-${d.git}")

    out.finish()
end proj

// Everything the reader had to say about a project, warnings included -- so a test asserting a
// warning cannot pass by the file having been refused outright.
private proj_said(text: string) -> string
    val src = source_of("package.sl", text)
    val f = read_project(src)

    if f.report.is_empty() then "" else f.report.render(src)
end proj_said

@test
A_MANIFEST_IS_READ_AS_A_PROJECT_AND_NOT_ONLY_AS_DATA()
    assert_eq(proj("{ name: \"a\", version: \"0.1.0\" }"), "a 0.1.0")
    assert_eq(proj("{ name: \"a\", version: \"0.1.0\", main: \"go.sl\" }"), "a 0.1.0 main=go.sl")

    val full = "{ name: \"a\", version: \"0.1.0\", dependencies: {\n" +
        "    parsing: { git: \"github.com/sysl-lang/parsing\", version: \"0.4.0\" },\n" +
        "    gc: { git: \"github.com/sysl-lang/gc\", version: \"0.2.2\" },\n" +
        "} }"

    assert_eq(proj(full),
        "a 0.1.0 parsing@0.4.0<-github.com/sysl-lang/parsing gc@0.2.2<-github.com/sysl-lang/gc")

    // **`dependencies` left out is no dependencies, not a mistake.** A project that depends on
    // nothing is the ordinary starting state and writing an empty object to say so is ceremony.
    assert_eq(proj("{ name: \"a\", version: \"0.1.0\", dependencies: {} }"), "a 0.1.0")

@test
A_COMPLAINT_ABOUT_A_PROJECT_POINTS_AT_A_KEY_RATHER_THAN_NAMING_ONE()
    // **This is what the spans in `Doc` are carried for.** A schema layer over a plain `Json` could
    // say which key was wrong and could not point at it, and a misspelt key and a value of the wrong
    // kind are the mistakes people actually make in a config file -- so the carets matter most
    // exactly here, at the layer that would have been cheapest to leave without them.
    val said = proj_said("{ name: \"a\", version: \"0.1.0\", main: 3 }")

    assert(said.contains("`main` is a string, and this one is a whole number"))
    assert(said.contains("write it in quotes"))
    assert(said.contains("package.sl:1:32"))

    // The caret sits on the KEY and not on the value, which is the value that is fine.
    assert(said.contains("| { name: \"a\", version: \"0.1.0\", main: 3 }"))
    assert(said.contains("  |                                ^^^^ write it in quotes"))

@test
A_MISSING_KEY_NAMES_THE_OBJECT_IT_IS_MISSING_FROM()
    // **There is nothing in the file to put a caret under for a key nobody wrote**, so the caret
    // goes on the object that should have held it and the sentence says which kind of object that
    // is. `every project says one` under a caret sitting on a dependency would send the reader to
    // the wrong object entirely.
    val missing = proj_said("{ name: \"a\" }")

    assert(missing.contains("`version` is missing, and every project says one"))

    // One character wide, on the brace: the object's own span is the whole object, and underlining
    // a forty-line manifest to say something is absent from it names nothing.
    assert(missing.contains("package.sl:1:1"))
    assert(missing.contains("  | ^ nothing here writes `version`"))
    assert(proj_said("{ version: \"0.1.0\" }").contains("`name` is missing, and every project says one"))

    val dep = proj_said("{ name: \"a\", version: \"0.1.0\", dependencies: { p: { git: \"g\" } } }")

    assert(dep.contains("`version` is missing, and every dependency says one"))
    assert(!dep.contains("every project says one"))

@test
A_KEY_NOTHING_KNOWS_IS_A_WARNING_SO_A_MANIFEST_MAY_OUTLIVE_THE_slate_READING_IT()
    // **The asymmetry is deliberate.** A manifest written for a later slate, or carrying a key some
    // other tool reads, would otherwise stop working on an older one -- and a package system whose
    // files only ever read forwards cannot be upgraded halfway. The typo is still said out loud.
    val said = proj_said("{ name: \"a\", version: \"0.1.0\", versoin: \"0.2.0\" }")

    assert(said.contains("warning: a project says nothing about `versoin`"))
    assert(said.contains("a later slate may give it a meaning"))
    assert(!said.contains("error:"))

    // A warning alone is a file that read, so the project is still there and still answers.
    assert_eq(proj("{ name: \"a\", version: \"0.1.0\", versoin: \"0.2.0\" }"), "a 0.1.0")

    // The same rule one level down.
    val dep = proj_said("{ name: \"a\", version: \"0.1.0\", dependencies: { p: { git: \"g\", version: \"1\", brunch: \"x\" } } }")

    assert(dep.contains("the dependency `p` says nothing about `brunch`"))
    assert(!dep.contains("error:"))

@test
A_PROJECT_THAT_IS_THE_WRONG_SHAPE_SAYS_WHAT_SHAPE_IT_IS()
    assert(proj_said("[1, 2]").contains("a project is an object, and this is a list"))
    assert(proj_said("42").contains("a project is an object, and this is a whole number"))
    assert(proj_said("\"hello\"").contains("a project is an object, and this is a string"))

    val deps = proj_said("{ name: \"a\", version: \"0.1.0\", dependencies: [1] }")

    assert(deps.contains("`dependencies` is an object of one entry per package, and this is a list"))

    val one = proj_said("{ name: \"a\", version: \"0.1.0\", dependencies: { gc: \"0.2.2\" } }")

    assert(one.contains("and `gc` is a string"))
    assert(one.contains("write `{ git: \"github.com/owner/repo\", version: \"0.1.0\" }`"))

@test
A_FILE_THAT_IS_NOT_DATA_IS_NOT_ALSO_COMPLAINED_ABOUT_AS_A_PROJECT()
    // One mistake, one complaint. `manifest.sysl` has already said what is wrong in the words that
    // fit it, and adding "and it is not a project either" would be the second message this repo's
    // diagnostic rule is written against.
    val said = proj_said("{ name: f(1) }")

    assert(said.contains("a manifest is data, and this is a call"))
    assert(!said.contains("a project is an object"))
    assert(!said.contains("is missing"))

@test
A_PROJECT_REPORTS_EVERYTHING_WRONG_WITH_IT_AND_NOT_THE_FIRST_THING()
    // A person editing a config file wants the whole list, having to go back to the same file for
    // each one being the thing that makes a strict format tiresome.
    val said = proj_said("{ versoin: \"0.1.0\", main: 3, dependencies: { p: { git: \"g\" }, q: \"1\" } }")

    assert(said.contains("`name` is missing"))
    assert(said.contains("`version` is missing, and every project says one"))
    assert(said.contains("`main` is a string"))
    assert(said.contains("`version` is missing, and every dependency says one"))
    assert(said.contains("says nothing about `versoin`"))

    // **Six of them, and the report prints five.** That is `Report.limit`, the organisation's own
    // convention, and a manifest is not the place to argue with it -- what matters is that the count
    // is said, so a reader knows to look again rather than believing the list is complete.
    assert(said.contains("showing the first 5 of 6"))

@test
slate_deps_READS_A_PROJECT_OFF_THE_DISK_AND_SAYS_WHAT_IT_FOUND()
    // **The fixture is a real file read by relative path**, as `tests/mods/` and `examples/` are,
    // because the thing being tested is what a person gets by pointing slate at a directory.
    assert_eq(cli_status(["slate", "deps", "tests/pkg"]), 0)
    // **`-- not fetched` on both, and that is the honest state**: nothing downloads packages yet,
    // so a coordinate that resolves is a coordinate and not a directory of code.
    assert_eq(cli_said(["slate", "deps", "tests/pkg"]),
        "example 0.1.0\n  main: main.sl\n" +
        "  parsing 0.4.0 (github.com/sysl-lang/parsing) -- not fetched\n" +
        "  gc 0.2.2 (github.com/sysl-lang/gc) -- not fetched")

    // A directory with no manifest in it is a failure, and the message names the file it wanted.
    assert_eq(cli_status(["slate", "deps", "tests/mods"]), 1)
    assert(cli_said(["slate", "deps", "tests/mods"]).contains("tests/mods/package.sl"))

@test
slate_deps_FAILS_ON_A_MANIFEST_THAT_IS_WRONG_AND_PASSES_ONE_THAT_ONLY_WARNS()
    val dir = libuv.mkdtemp_sync("/tmp/slate-pkg-XXXXXX").unwrap()

    write_text(s"${dir}/package.sl", "{ name: \"a\" }\n").unwrap()

    assert_eq(cli_status(["slate", "deps", dir]), 1)
    assert(cli_said(["slate", "deps", dir]).contains("`version` is missing"))

    // **A report of warnings alone is a successful run**, which is the rule `Report.has_errors`
    // exists to state and the reason a forward-compatible key does not break a build.
    write_text(s"${dir}/package.sl", "{ name: \"a\", version: \"1\", nobody_knows: 1 }\n").unwrap()

    assert_eq(cli_status(["slate", "deps", dir]), 0)
    assert(cli_said(["slate", "deps", dir]).contains("says nothing about `nobody_knows`"))
    assert(cli_said(["slate", "deps", dir]).contains("a 1"))

    scrub(dir)

// -- packages ---------------------------------------------------------------------------------------

// A program run with the package cache pointed at the fixture tree.
//
// **The cache is a setting for the same reason the heap size is**: the behaviour under test is
// identical whatever directory it reads, and a suite that read the real `~/.slate/pkg` would pass or
// fail on what a previous run had happened to download. `tests/cache/` is a package cache checked in.
private with_packages(path: string) -> string
    set_package_cache("tests/cache")

    val said = ran_out(path)

    set_package_cache("")
    said
end with_packages

// The same, for a program expected to be refused.
// `slate deps`, run against the fixture cache rather than whatever is in `~/.slate/pkg`.
private deps_said(dir: string) -> string
    set_package_cache("tests/cache")

    val said = cli_said(["slate", "deps", dir])

    set_package_cache("")
    said
end deps_said

private deps_status(dir: string) -> int
    set_package_cache("tests/cache")

    val code = cli_status(["slate", "deps", dir])

    set_package_cache("")
    code
end deps_status

private packages_fault(path: string) -> string
    set_package_cache("tests/cache")

    val said = ran_fault(path)

    set_package_cache("")
    said
end packages_fault

// A one-file project written into a scratch directory, run against the fixture cache.
private scratch_project(manifest: string, program: string) -> string
    val dir = libuv.mkdtemp_sync("/tmp/slate-proj-XXXXXX").unwrap()

    write_text(s"${dir}/package.sl", manifest).unwrap()
    write_text(s"${dir}/app.sl", program).unwrap()
    set_package_cache("tests/cache")

    val said = ran_fault(s"${dir}/app.sl")

    set_package_cache("")
    scrub(dir)
    said
end scratch_project

@test
A_PACKAGE_IS_AN_UNQUOTED_NAME_AND_A_FILE_IS_A_QUOTED_PATH()
    // **The two are different syntax rather than two readings of one string.** That is further from
    // node's rule than a `./` prefix would have been, and it is the point: nothing already written
    // changes meaning, and no reader has to work out whether a leading `./` was optional.
    assert_eq(kinds("import { a } from pkg"), "Import LBrace Ident RBrace Ident Ident Newline Eof")

    // A quoted name with no `./` is still a file, and still refused -- but the message now offers
    // both ways out, because which was meant is exactly what is unclear.
    val said = ran_fault("tests/mods/bare.sl")

    assert(said.contains("has to be written `\"./util.sl\"`"))
    assert(said.contains("an unquoted `util.sl` is how a package is named"))

@test
A_PACKAGE_IMPORT_RESOLVES_THROUGH_THE_PROJECTS_OWN_MANIFEST()
    // `tests/proj/` is a project; `tests/cache/` is a package cache. Neither existed until packages
    // did, and between them they are the whole of what a fetch will eventually fill in.
    assert_eq(with_packages("tests/proj/app.sl"), "hello world (greet 2)\nHELLO WORLD (GREET 2)")

@test
THE_PROJECT_IS_FOUND_BY_WALKING_UP_FROM_THE_FILE()
    // A program works wherever it sits in its tree and wherever it is run from, which is the rule
    // every tool with a project file uses. `deep.sl` is two directories below the `package.sl`.
    assert_eq(with_packages("tests/proj/one/two/deep.sl"), "hello world (greet 2)")

@test
A_FILE_UNDER_NO_PROJECT_DEPENDS_ON_NOTHING_AND_THE_MESSAGE_SAYS_SO()
    // **Not an error in itself** -- a single file that imports nothing is a perfectly good slate
    // program, and nearly every test in this suite is one. It is an error only when such a file
    // names a package, and then the useful thing to say is why there is nothing to look in.
    val dir = libuv.mkdtemp_sync("/tmp/slate-lone-XXXXXX").unwrap()

    write_text(s"${dir}/lone.sl", "import { x } from parsing\n").unwrap()
    set_package_cache("tests/cache")

    val said = ran_fault(s"${dir}/lone.sl")

    set_package_cache("")
    scrub(dir)

    assert(said.contains("nothing this project depends on is called `parsing`"))
    assert(said.contains("there is no `package.sl` above this file"))

@test
A_PACKAGE_NOBODY_DECLARED_IS_NAMED_ALONGSIDE_THE_ONES_THAT_WERE()
    // The mistyped-name case, and the one thing a reader wants next: what there was to choose from.
    val said = scratch_project(
        "{ name: \"p\", version: \"1\", dependencies: { greet: { git: \"github.com/example/greet\", version: \"1.0.0\" } } }\n",
        "import { hello } from greeet\n")

    assert(said.contains("nothing this project depends on is called `greeet`"))
    assert(said.contains("It depends on `greet`"))

@test
A_PROJECT_THAT_DECLARES_NOTHING_SAYS_THAT_RATHER_THAN_LISTING_NOTHING()
    val said = scratch_project("{ name: \"p\", version: \"1\" }\n", "import { hello } from greet\n")

    assert(said.contains("declares no dependencies"))

@test
A_PACKAGE_THAT_IS_NOT_IN_THE_CACHE_SAYS_SO_RATHER_THAN_LOOKING_UNKNOWN()
    // **Two different failures that would otherwise read alike.** A name nothing declared is a typo
    // in the manifest; a declared name with no directory behind it is a fetch that has not happened
    // -- and since nothing fetches yet, that is the ordinary state and the message says which.
    val said = scratch_project(
        "{ name: \"p\", version: \"1\", dependencies: { ghost: { git: \"github.com/example/ghost\", version: \"9.9.9\" } } }\n",
        "import { x } from ghost\n")

    assert(said.contains("`ghost` 9.9.9 is not in tests/cache/github.com/example/ghost/@v9.9.9"))
    assert(said.contains("nothing fetches packages yet"))

@test
TWO_VERSIONS_OF_ONE_PACKAGE_TAKE_THE_NEWER_AND_SAY_SO()
    // **The one case exact pinning does not settle.** `tests/proj` asks for greet 1.0.0 and `loud`
    // asks for 2.0.0, and what the program actually gets is 2 -- which the run above proves by
    // printing it, so this is not a claim about the resolver made only by the resolver.
    val said = deps_said("tests/proj")

    assert(said.contains("greet 2.0.0 (github.com/example/greet)"))
    assert(said.contains("`greet` is wanted at 1.0.0 and at 2.0.0 -- using 2.0.0, which is the newer"))

    // **The warning says what it costs, not only what it did.** The action is to bump the older
    // dependency; a warning a reader cannot act on is worse than none.
    assert(said.contains("has not been tried against it"))

    // A conflict is not a failure -- that was the choice made over a hard error.
    assert_eq(deps_status("tests/proj"), 0)

@test
A_PACKAGE_WITH_NO_main_HAS_NOTHING_TO_IMPORT_AND_SAYS_WHICH_FILE_TO_FIX()
    // `main` is optional for a project, since an application may simply be run by naming its file.
    // **It is not optional for something being imported**, there being nothing else that says which
    // of a package's files is the package -- and the complaint names the manifest to add it to.
    val said = scratch_project(
        "{ name: \"p\", version: \"1\", dependencies: { quiet: { git: \"github.com/example/quiet\", version: \"1.0.0\" } } }\n",
        "import { x } from quiet\n")

    assert(said.contains("`quiet` does not say `main` in its `package.sl`"))
    assert(said.contains("nothing to import from it"))

@test
A_PACKAGE_MAY_BE_IMPORTED_WHOLE_AS_WELL_AS_BY_NAME()
    // `import * as g from greet` -- the same resolution, through the other half of the syntax, which
    // is the half a change like this is most likely to leave behind.
    assert_eq(with_packages("tests/proj/whole.sl"), "hello world (greet 2)")

@test
A_VERSION_IS_COMPARED_AS_NUMBERS_AND_NOT_AS_TEXT()
    // `0.10.0` is later than `0.9.0`, which comparing the text gets backwards -- and getting it
    // backwards would silently hand a program the older of two packages.
    assert(newer_version("0.10.0", "0.9.0"))
    assert(!newer_version("0.9.0", "0.10.0"))

    assert(newer_version("1.0.0", "0.99.99"))
    assert(newer_version("1.2.3", "1.2.2"))
    assert(!newer_version("1.2.3", "1.2.3"))

    // A missing part counts as zero, so `1.2` and `1.2.0` are the same version.
    assert(!newer_version("1.2", "1.2.0"))
    assert(!newer_version("1.2.0", "1.2"))
    assert(newer_version("1.2.1", "1.2"))

    // **A part that is not a number is compared as TEXT, which is not semver's rule** -- semver
    // sorts `1.0.0-rc1` before `1.0.0` and this sorts it after. Nothing writes a prerelease today
    // and versions are exact, so all this decides is which of two exact versions a conflict keeps.
    // It is the first thing to replace if ranges ever arrive.
    assert(newer_version("1.0.0-rc1", "1.0.0"))

@test
slate_deps_SHOWS_THE_RESOLVED_GRAPH_AND_NOT_THE_MANIFESTS_OWN_LIST()
    // What a program gets includes everything its dependencies drag in, so printing the manifest
    // back would be printing the question rather than the answer. `loud` was never written in
    // `tests/proj/package.sl`'s own dependencies at the version shown -- it brought `greet 2` with it.
    val said = deps_said("tests/proj")

    assert(said.contains("app 0.1.0"))
    assert(said.contains("loud 1.0.0 (github.com/example/loud)"))
    assert(!said.contains("greet 1.0.0"))

// -- slate.sum ---------------------------------------------------------------------------------------

// A directory holding the named files, for hashing.
private tree_of(names: []const string, bodies: []const string) -> string
    val dir = libuv.mkdtemp_sync("/tmp/slate-tree-XXXXXX").unwrap()

    for i in 0..<names.len
        write_text(s"${dir}/${names[i]}", bodies[i]).unwrap()

    dir
end tree_of

private hash_of(names: []const string, bodies: []const string) -> string
    val dir = tree_of(names, bodies)
    val h = tree_hash(dir).unwrap()

    scrub(dir)
    h
end hash_of

@test
A_TREE_HASH_IS_THE_SAME_ANSWER_TWICE_AND_A_DIFFERENT_ONE_FOR_DIFFERENT_CONTENTS()
    val a = hash_of(["one.sl", "two.sl"], ["export x = 1\n", "export y = 2\n"])
    val again = hash_of(["one.sl", "two.sl"], ["export x = 1\n", "export y = 2\n"])

    assert_eq(a, again)

    // **The order the file system hands entries back is not the order they are hashed in**, or two
    // machines would disagree about identical trees. Written the other way round, same answer.
    assert_eq(hash_of(["two.sl", "one.sl"], ["export y = 2\n", "export x = 1\n"]), a)

    assert(hash_of(["one.sl", "two.sl"], ["export x = 1\n", "export y = 3\n"]) != a,
        "changing a file did not change the hash")

    assert(a.contains("sha256:"))

@test
A_TREE_HASH_COVERS_THE_PATHS_AND_NOT_ONLY_THE_BYTES()
    // **Renaming a file has to change the answer.** A hash over contents alone would say a package
    // whose entry point had been moved was the package it used to be.
    val a = hash_of(["one.sl"], ["export x = 1\n"])
    val b = hash_of(["other.sl"], ["export x = 1\n"])

    assert(a != b, "renaming a file did not change the hash")

@test
A_TREE_HASH_FRAMES_EVERY_PIECE_SO_TWO_TREES_CANNOT_BE_MADE_TO_AGREE()
    // **The attack a naive concatenation allows.** `{"ab", "c"}` and `{"a", "bc"}` are the same
    // stream of bytes, so a hash that ran them together would call two different trees identical --
    // which is exactly the claim a sum file must never get wrong. The length and the NUL are what
    // stop it.
    val a = hash_of(["f", "g"], ["ab", "c"])
    val b = hash_of(["f", "g"], ["a", "bc"])

    assert(a != b, "two different trees hashed the same, so the framing is not doing its job")

@test
A_DIRECTORY_THAT_IS_NOT_THERE_HAS_NO_HASH_RATHER_THAN_AN_EMPTY_ONE()
    // Nothing fetches yet, so an absent package is the ordinary state -- and answering the hash of
    // nothing would make an unfetched package look like one whose contents were empty.
    assert(tree_hash("/tmp/there-is-no-such-directory-here").is_none())

@test
A_SUM_FILE_IS_READ_LINE_BY_LINE_AND_A_LINE_IT_CANNOT_READ_IS_SKIPPED()
    val dir = libuv.mkdtemp_sync("/tmp/slate-sum-XXXXXX").unwrap()

    write_text(s"${dir}/slate.sum",
        "github.com/example/greet v1.0.0 sha256:aaaa\n" +
        "\n" +
        "this line is not three fields\n" +
        "github.com/example/loud v2.3.4 sha256:bbbb\n").unwrap()

    val sums = read_sums(dir)

    assert_eq(sums.entries.len(), 2)

    // **The `v` belongs to the tag and not to the version**, which is the same distinction the
    // cache directory draws with its `@v`.
    assert_eq(sums.at("github.com/example/greet", "1.0.0").unwrap().hash, "sha256:aaaa")
    assert_eq(sums.at("github.com/example/loud", "2.3.4").unwrap().hash, "sha256:bbbb")

    assert(sums.at("github.com/example/greet", "9.9.9").is_none())

    // **A line it cannot read is skipped rather than refused**, so a later slate adding a column
    // does not break an older one reading the same file.
    assert_eq(read_sums("/tmp/there-is-no-such-directory-here").entries.len(), 0)

    scrub(dir)

@test
A_SUM_FILE_IS_WRITTEN_SORTED_SO_TWO_MACHINES_PRODUCE_THE_SAME_FILE()
    var es: Buf[SumEntry] = buf()

    es.push(SumEntry("github.com/example/loud", "1.0.0", "sha256:bbbb"))
    es.push(SumEntry("github.com/example/greet", "2.0.0", "sha256:cccc"))
    es.push(SumEntry("github.com/example/greet", "1.0.0", "sha256:aaaa"))

    assert_eq(render_sums(Sums(es)),
        "github.com/example/greet v1.0.0 sha256:aaaa\n" +
        "github.com/example/greet v2.0.0 sha256:cccc\n" +
        "github.com/example/loud v1.0.0 sha256:bbbb\n")

@test
A_PACKAGE_IS_CHECKED_AGAINST_WHAT_WAS_RECORDED_AND_ONLY_A_CHANGE_IS_A_FAILURE()
    val dir = tree_of(["a.sl"], ["export x = 1\n"])
    val hash = tree_hash(dir).unwrap()
    val pkg = Package("thing", "1.0.0", "github.com/example/thing", dir)

    var recorded: Buf[SumEntry] = buf()

    recorded.push(SumEntry("github.com/example/thing", "1.0.0", hash))

    check_package(Sums(recorded), pkg) match
        Same -> ()
        other -> assert(false, "a package matching its record did not check out")

    // **Not in the file is not a failure**: it is what every package looks like before anything has
    // recorded it, and the hash comes back so a caller can offer to.
    var empty: Buf[SumEntry] = buf()

    check_package(Sums(empty), pkg) match
        Unrecorded(h) -> assert_eq(h, hash)
        other -> assert(false, "an unrecorded package was not reported as unrecorded")

    // **A change IS the failure this file exists for.**
    var wrong: Buf[SumEntry] = buf()

    wrong.push(SumEntry("github.com/example/thing", "1.0.0", "sha256:something-else"))

    check_package(Sums(wrong), pkg) match
        Changed(was, now) ->
            assert_eq(was, "sha256:something-else")
            assert_eq(now, hash)
        other -> assert(false, "a package that had changed was not reported as changed")

    scrub(dir)

    // Nothing in the cache to hash. Not a failure either -- nothing fetches yet.
    check_package(Sums(empty), pkg) match
        Absent -> ()
        other -> assert(false, "a package that is not there was not reported as absent")

@test
slate_deps_SAYS_NOTHING_WHEN_EVERY_PACKAGE_MATCHES_ITS_RECORD()
    // `tests/proj/slate.sum` holds the fixture cache's real hashes, so a clean check is silent.
    val said = deps_said("tests/proj")

    assert(!said.contains("slate.sum"))
    assert_eq(deps_status("tests/proj"), 0)

    // **The file keeps `greet` at 1.0.0, which nothing depends on any more.** That is the
    // append-only property, and it is the whole reason a sum file catches a version that changed
    // under you after you have moved off it -- a lockfile holds only the current answer and has
    // nothing to compare against.
    val sums = read_sums("tests/proj")

    assert(sums.at("github.com/example/greet", "1.0.0").is_some())
    assert(sums.at("github.com/example/greet", "2.0.0").is_some())

@test
A_PACKAGE_WHOSE_CONTENTS_CHANGED_FAILS_THE_COMMAND_AND_NAMES_BOTH_HASHES()
    // **The one thing in the whole package system that fails a command.** Built in a scratch tree
    // rather than by editing the checked-in fixture, so a failure here cannot leave the repo dirty.
    val cache = libuv.mkdtemp_sync("/tmp/slate-cache-XXXXXX").unwrap()
    val home = s"${cache}/github.com/example/thing/@v1.0.0"

    libuv.mkdir_sync(s"${cache}/github.com", 493).unwrap()
    libuv.mkdir_sync(s"${cache}/github.com/example", 493).unwrap()
    libuv.mkdir_sync(s"${cache}/github.com/example/thing", 493).unwrap()
    libuv.mkdir_sync(home, 493).unwrap()

    write_text(s"${home}/package.sl", "{ name: \"thing\", version: \"1.0.0\", main: \"t.sl\" }\n").unwrap()
    write_text(s"${home}/t.sl", "export x = 1\n").unwrap()

    val proj = libuv.mkdtemp_sync("/tmp/slate-proj-XXXXXX").unwrap()

    write_text(s"${proj}/package.sl",
        "{ name: \"p\", version: \"1\", dependencies: { thing: { git: \"github.com/example/thing\", version: \"1.0.0\" } } }\n").unwrap()

    set_package_cache(cache)

    // Record what is there now.
    write_text(s"${proj}/slate.sum", s"github.com/example/thing v1.0.0 ${tree_hash(home).unwrap()}\n").unwrap()

    assert_eq(cli_status(["slate", "deps", proj]), 0)

    // Then change it under the record.
    write_text(s"${home}/t.sl", "export x = 2\n").unwrap()

    val said = cli_said(["slate", "deps", proj])

    assert_eq(cli_status(["slate", "deps", proj]), 1)
    assert(said.contains("DOES NOT MATCH slate.sum"))
    assert(said.contains("it was recorded as"))
    assert(said.contains("and is now"))

    // **The message says both readings of what happened**, because a reader cannot tell them apart
    // and the two want opposite responses.
    assert(said.contains("changed after it was first fetched"))
    assert(said.contains("the copy in the cache has been edited"))

    set_package_cache("")
    scrub(proj)
    scrub(cache)
