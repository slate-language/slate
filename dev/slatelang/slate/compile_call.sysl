module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// The two calls that are not the ordinary ones: a call guarded with `?.()`, a member's included,
// and a call through a computed key, `o[k](a)`. Cut out of `compile_expr.sysl`, which compiles the plain call and
// `o.m(a)` and reaches these two from its `Call` arm; the argument helpers both use are there.

// `f?.(a, b)` -- the callee is worked out, and where it is nullish the whole call answers `null`
// with the arguments left unevaluated.
//
// **The guard is on the callee and nowhere else.** A callee that IS there and is not a function
// faults exactly as a plain call does, which is the line every guarded link in slate draws: `?.`
// answers for an absence and never for a wrong kind.
//
// **`o.m?.(a)` and `o[k]?.(a)` pass `o` exactly where `o.m(a)` and `o[k](a)` would**, which is
// JavaScript's rule: the guard is on the MEMBER, and a member that is there is called as the method
// it is. Only the value taken off on its own, `val f = o.m`, is unbound.
//
// Not `private`: `compile_expr.sysl`'s `Call` arm is the caller.
compile_guarded_call(u: *Unit, e: *Emit, callee: Expr, args: Buf[Expr], at: Span)
    *callee.kind match
        Field(target, name, optional) ->
            compile_taken_call(u, e, target, None, name, optional, args, at)
            return
        Index(target, key, optional) ->
            compile_taken_call(u, e, target, Some(key), "", optional, args, at)
            return
        _ -> ()

    e.in_spine = true

    compile_expr(u, e, callee)
    e.chain.push(push_n(e, JumpIfAbsentKeep(0), at, 0, 0))

    if has_spread(args)
        refuse_named_spread(args, at)
        compile_spread_args(u, e, args, at)
        push_n(e, CallSpread, at, 2, 1)
    else
        val count = call_count(e, args)

        for i in 0..<args.len()
            compile_expr(u, e, arg_value(args.at(i)))

        push_n(e, CallFn(count, u32(arg_names_of(u, args, at))), at, args.len() + 1, 1)
end compile_guarded_call

// `o[k](a)`, which passes `o` exactly where `o.k(a)` would -- JavaScript's rule, and the one
// `o[k]` reading what `o.k` reads makes the only consistent one.
//
// **TWO CALLS AND A JUMP, because whether a receiver goes is a fact about the value.** `CallFn`
// carries its count, so `ArrangeIndexed` falls through to a call of one more where the member was
// delegated to and jumps to a call of exactly what was written where it was not. The stack differs
// by one between the two, which is why the emitter's height is put back at the second.
//
// Not `private`: `compile_expr.sysl`'s `Call` arm is the caller.
compile_indexed_call(u: *Unit, e: *Emit, target: Expr, key: Expr, optional: bool, args: Buf[Expr], at: Span)
    e.in_spine = true

    compile_expr(u, e, target)
    unveil_operand(e, target.span)

    // `o?.[k](a)` works out neither the key nor the arguments where there is nothing to call on.
    if optional then e.chain.push(push_n(e, JumpIfAbsentKeep(0), at, 0, 0))

    compile_expr(u, e, key)
    unveil_operand(e, key.span)

    if has_spread(args)
        refuse_named_spread(args, at)
        compile_spread_args(u, e, args, at)
        push_n(e, ArrangeIndexedSpread, at, 3, 2)
        push_n(e, CallSpread, at, 2, 1)
        return
    end if

    val count = call_count(e, args)
    val argc = args.len()

    for i in 0..<argc
        compile_expr(u, e, arg_value(args.at(i)))

    val names = arg_names_of(u, args, at)
    val standing = e.sp
    val arranged = push_n(e, ArrangeIndexed(u32(argc), 0), at, 0, 0)

    // **The receiver is a value the stack already held**, so the proof `count` carries about the
    // written arguments covers it too -- and its name, where the call named any, is a blank in
    // front of the ones written.
    push_n(e, CallFn((count & KeptArgs) | u32(argc + 1), u32(receiving(u, names))), at, argc + 2, 1)

    val done = put(e, Jump(0), at)

    patch(e, arranged, here(e))
    e.sp = standing - 1
    push_n(e, CallFn(count, u32(names)), at, argc + 1, 1)
    patch(e, done, here(e))
end compile_indexed_call

// `o.m?.(a)` -- `key` is `None` and `name` the member -- and `o[k]?.(a)`.
//
// **The member is taken BEFORE the arguments**, which is what lets the guard fire with none of them
// worked out; whether `o` goes is then a fact standing on the stack, and `ArrangeTaken` chooses
// between two calls with it exactly as `ArrangeIndexed` does.
private compile_taken_call(u: *Unit, e: *Emit, target: Expr, key: Option[Expr], name: string, optional: bool, args: Buf[Expr], at: Span)
    e.in_spine = true

    compile_expr(u, e, target)
    unveil_operand(e, target.span)

    // `o?.m?.(a)` guards `o` first, and works out not even the key where it is missing.
    if optional then e.chain.push(push_n(e, JumpIfAbsentKeep(0), at, 0, 0))

    key match
        Some(k) ->
            compile_expr(u, e, k)
            unveil_operand(e, k.span)
        None -> push_n(e, PushStr(intern_str(u, name)), at, 0, 1)

    e.chain.push(push_n(e, TakeMember(0), at, 2, 3))

    if has_spread(args)
        refuse_named_spread(args, at)
        compile_spread_args(u, e, args, at)
        push_n(e, ArrangeTakenSpread, at, 4, 2)
        push_n(e, CallSpread, at, 2, 1)
        return
    end if

    val count = call_count(e, args)
    val argc = args.len()

    for i in 0..<argc
        compile_expr(u, e, arg_value(args.at(i)))

    val names = arg_names_of(u, args, at)
    val standing = e.sp
    val arranged = push_n(e, ArrangeTaken(u32(argc), 0), at, 1, 0)

    push_n(e, CallFn((count & KeptArgs) | u32(argc + 1), u32(receiving(u, names))), at, argc + 2, 1)

    val done = put(e, Jump(0), at)

    patch(e, arranged, here(e))
    e.sp = standing - 2
    push_n(e, CallFn(count, u32(names)), at, argc + 1, 1)
    patch(e, done, here(e))
end compile_taken_call

// The names a call wrote with a positional blank in front of them for the receiver, or zero where
// it named none.
private receiving(u: *Unit, names: usize) -> usize
    if names == 0 then return 0

    var all: Buf[string] = buf()
    val written = u.arg_names.at(names)

    all.push("")

    for i in 0..<written.len()
        all.push(written.at(i))

    intern_arg_names(u, all)
end receiving
