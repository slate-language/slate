module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.fs.{remove_file, write_text}
import sysl.process.capture
import sysl.text.Search

// Dates and times, and running another program.
//
// Eight temporal types rather than JavaScript's one, which is where its famous defects come from.

// -- dates and times ----------------------------------------------------------------------------

@test
AN_INSTANT_HAS_NO_YEAR_UNTIL_A_ZONE_IS_NAMED()
    // **The whole design in one assertion.** JavaScript's `new Date()` answers something that will
    // tell you a year, reading the host's zone to do it -- so the same program says one thing on the
    // developer's machine and another on the server, with nothing in it naming a zone. slate refuses
    // the question and the message says what to write instead.
    assert_eq(time_out("print(now() is instant)"), "true")
    assert(time_fails("print(now().year())").contains("`year` is not something an instant can do"))
    assert_eq(time_out("print(now().at(utc) is zoned)"), "true")
    assert_eq(time_out("print(now().at(utc).year() > 2000)"), "true")

@test
A_DURATION_MOVES_THE_TIMELINE_AND_A_PERIOD_MOVES_THE_CALENDAR()
    // **The flagship difference, and the reason there are two length types.** The clocks in Toronto
    // go forward at 2am on the 8th of March 2026. A day after Saturday morning is Sunday morning --
    // the same wall clock, 23 hours of timeline later. Twenty-four hours after Saturday morning is
    // an hour later on the clock. Both are right, and a library with one type has to pick one.
    val setup = "val z = zone(\"America/Toronto\").value\n" +
        "val t = dateTime(2026, 3, 7, 9, 0).at(z).value\n"

    assert_eq(time_out(setup + "print((t + days(1)).string())"), "2026-03-08T09:00:00-04:00[America/Toronto]")
    assert_eq(time_out(setup + "print((t + hours(24)).string())"), "2026-03-08T10:00:00-04:00[America/Toronto]")

    // And the difference between the two answers is exactly the hour the clocks took.
    assert_eq(time_out(setup + "print(((t + hours(24)) - (t + days(1))).string())"), "1h")

@test
AN_INSTANT_MAY_NOT_BE_MOVED_BY_A_CALENDAR()
    // A period is a calendar step and an instant has no calendar, so there is no answer to give --
    // and the message names the fix rather than only refusing.
    assert(time_fails("print(now() + days(1))").contains("an instant has no calendar to move by"))
    assert_eq(time_out("print((epochSeconds(0) + hours(2)).string())"), "1970-01-01T02:00:00Z")

@test
MONTHS_AND_DAYS_ARE_TWO_SCALES_AND_NEVER_CONVERT()
    // **A month is 28, 29, 30 or 31 days**, so any number `months(1).days()` answered would be wrong
    // somewhere. Zero is the honest answer: the period has no days in it. Weeks and days do convert,
    // a week always being seven.
    assert_eq(time_out("print(months(1).days())"), "0")
    assert_eq(time_out("print(days(30).months())"), "0")
    assert_eq(time_out("print(weeks(2).days())"), "14")
    assert_eq(time_out("print(years(1).months())"), "12")
    assert_eq(time_out("print(months(18).years())"), "1")
    assert_eq(time_out("print((years(1) + months(2) + days(3)).string())"), "1y 2mo 3d")

@test
ADDING_A_MONTH_CLAMPS_TO_THE_END_OF_THE_MONTH()
    // JavaScript's `setMonth` overflows: the 31st of January plus a month is the 3rd of March.
    // Clamping is what keeps "the last day of the month" landing on a last day.
    assert_eq(time_out("print((date(2026, 1, 31) + months(1)).string())"), "2026-02-28")
    assert_eq(time_out("print((date(2024, 1, 31) + months(1)).string())"), "2024-02-29")
    assert_eq(time_out("print((date(2026, 1, 31) + days(1)).string())"), "2026-02-01")

@test
A_DATE_THE_CALENDAR_DOES_NOT_HAVE_IS_A_FAULT_AND_TEXT_IS_A_RESULT()
    // **The two-channel rule.** Three numbers written in the program are the program's own defect;
    // text arriving from a file or a person is a condition every caller was going to handle.
    assert(time_fails("print(date(2026, 2, 30))").contains("there is no such date"))
    assert_eq(time_out("print(parseDate(\"2026-02-30\").ok)"), "false")
    assert_eq(time_out("print(parseDate(\"2026-02-28\").value.string())"), "2026-02-28")

@test
A_WALL_READING_A_ZONE_SKIPS_IS_REFUSED_RATHER_THAN_GUESSED_AT()
    // 02:30 on the 8th of March 2026 is a reading no clock in Toronto ever showed. Every mainstream
    // library answers with something anyway; this one says so, and says what to write to choose.
    val gap = "val z = zone(\"America/Toronto\").value\nval dt = dateTime(2026, 3, 8, 2, 30)\n"

    assert_eq(time_out(gap + "print(dt.at(z).ok)"), "false")
    assert(time_out(gap + "print(dt.at(z).error)").contains("never happens"))
    assert_eq(time_out(gap + "print(dt.at(z, \"after\").value.string())"), "2026-03-08T03:30:00-04:00[America/Toronto]")

@test
AN_HOUR_THAT_HAPPENS_TWICE_NAMES_TWO_INSTANTS_AND_THE_PROGRAM_PICKS()
    // The other side of the same transition: on the 1st of November the clocks go back, so 01:30 is
    // shown twice and the two readings are an hour apart on the timeline.
    val twice = "val z = zone(\"America/Toronto\").value\nval dt = dateTime(2026, 11, 1, 1, 30)\n"

    assert_eq(time_out(twice + "print(dt.at(z).ok)"), "false")
    assert(time_out(twice + "print(dt.at(z).error)").contains("happens twice"))
    assert_eq(time_out(twice + "print(dt.at(z, \"earlier\").value.offset().hours())"), "-4")
    assert_eq(time_out(twice + "print(dt.at(z, \"later\").value.offset().hours())"), "-5")
    assert_eq(time_out(twice + "print((dt.at(z, \"later\").value - dt.at(z, \"earlier\").value).string())"), "1h")

@test
A_ZONED_READING_ORDERS_BY_ITS_INSTANT_AND_IS_EQUAL_ONLY_IN_ITS_OWN_ZONE()
    // **`<` and `==` genuinely ask different questions here.** Nine in the morning in Toronto and
    // nine in the morning in Tokyo are different readings and neither is before the other, so
    // equality has to be stricter than the ordering. Java draws the line in the same place.
    val two = "val a = dateTime(2026, 6, 1, 9, 0).at(zone(\"America/Toronto\").value).value\n" +
        "val b = a.at(zone(\"Asia/Tokyo\").value)\n"

    assert_eq(time_out(two + "print(a == b)"), "false")
    assert_eq(time_out(two + "print(a < b, b < a)"), "false false")
    assert_eq(time_out(two + "print(a.instant() == b.instant())"), "true")
    assert_eq(time_out(two + "print(a.hour(), b.hour())"), "9 22")

@test
A_DATE_AND_A_DATETIME_AT_MIDNIGHT_ARE_NOT_EQUAL()
    // Different kinds of answer, as an integer and a string of digits are. A program that means to
    // compare them says which one it meant.
    assert_eq(time_out("print(date(2026, 8, 28) == dateTime(2026, 8, 28, 0, 0))"), "false")
    assert_eq(time_out("print(date(2026, 8, 28) == date(2026, 8, 28))"), "true")
    assert_eq(time_out("print(months(1) == days(30))"), "false")

@test
A_TEMPORAL_VALUE_IS_A_TABLE_KEY_AND_DOES_NOT_COLLIDE_ACROSS_KINDS()
    // A hash must agree with `==` wherever `==` is defined, so each kind is salted rather than
    // hashing its bare number: `date(1970, 1, 2)` is the number 1 and so is `micros(1)`.
    val keys = "val t = {}\nt[date(1970, 1, 2)] = \"a date\"\nt[micros(1)] = \"a duration\"\n"

    assert_eq(time_out(keys + "print(t[date(1970, 1, 2)], t[micros(1)])"), "a date a duration")

@test
A_TIME_OF_DAY_HAS_NO_ARITHMETIC()
    // 23:30 plus an hour is 00:30 the next day, or a fault, and nothing about a bare reading says
    // which was meant. Combining it with a date first makes the question answer itself.
    assert(time_fails("print(time(23, 30) + hours(1))").contains("does not apply"))
    assert_eq(time_out("print(time(9, 30) < time(10, 0))"), "true")
    assert_eq(time_out("print(date(2026, 8, 28).at(time(9, 30)).string())"), "2026-08-28T09:30:00")

@test
A_NUMBER_MAKES_A_LENGTH_AND_A_LENGTH_ANSWERS_HOW_MANY()
    // One word per unit; the receiver decides which question it is. That falls out of the rule
    // `method.sysl` already runs on rather than being a case in it.
    assert_eq(time_out("print(2.hours() == hours(2))"), "true")
    assert_eq(time_out("print((hours(1) + minutes(30)).minutes())"), "90")
    assert_eq(time_out("print((hours(1) + minutes(30)).string())"), "1h 30m")
    assert_eq(time_out("print((minutes(90) * 2).hours())"), "3")
    assert_eq(time_out("print(seconds(-45).string(), micros(0).string())"), "-45s 0s")

@test
A_DURATION_CANNOT_BE_ASKED_HOW_MANY_DAYS_IT_IS()
    // The absence is the design: 24 hours is not a day. `hours(48).days()` would be a number that is
    // wrong twice a year, and the type that means "a day" is `period`.
    // **The refusal comes from the METHOD TABLE and not from the builtin**, which is the better of
    // the two sentences: it names the receiver rather than sending the reader to look at what they
    // passed. `days(hours(48))` written the long way says the other one.
    assert(time_fails("print(hours(48).days())").contains("`days` is not something a duration can do"))
    assert(time_fails("print(days(hours(48)))").contains("takes a whole number or a period"))

@test
THE_EPOCH_WORDS_NAME_THEIR_UNIT_BECAUSE_NO_DEFAULT_IS_SAFE()
    // JavaScript counts milliseconds and Unix counts seconds, and every program that has moved a
    // timestamp between the two has had this bug once.
    assert_eq(time_out("print(epochSeconds(0).string())"), "1970-01-01T00:00:00Z")
    assert_eq(time_out("print(epochMillis(1000).epochSeconds())"), "1")
    assert_eq(time_out("print(epochSeconds(1756400000).epochMillis())"), "1756400000000")

@test
A_ZONE_IS_A_RESULT_BECAUSE_ITS_NAME_USUALLY_COMES_FROM_OUTSIDE()
    assert_eq(time_out("print(zone(\"Nowhere/Atall\").ok)"), "false")
    assert(time_out("print(zone(\"Nowhere/Atall\").error)").contains("there is no zone called"))
    assert_eq(time_out("print(zone(\"UTC\").value == utc)"), "true")

    // A fixed offset is a zone in every sense a reading cares about, which is what keeps this at
    // eight types rather than nine.
    assert_eq(time_out("print(epochSeconds(0).at(zone(\"+05:30\").value).string())"), "1970-01-01T05:30:00+05:30")

    // **A name that could name a file is refused before anything is read.** `zone(name)` takes a
    // string a program may have read from a file, and a `..` in it would otherwise name any file on
    // the host -- read, and then complained about as a malformed zone.
    assert(time_out("print(zone(\"../../etc/passwd\").error)").contains("is not the name of a zone"))

@test
A_FIXED_OFFSET_DOES_NOT_NAME_ITSELF_TWICE()
    // `...Z[UTC]` says one thing twice. The bracket is for a zone whose rules the offset alone does
    // not identify, which is exactly the named ones.
    assert_eq(time_out("print(epochSeconds(0).at(utc).string())"), "1970-01-01T00:00:00Z")
    assert_eq(time_out("print(epochSeconds(0).at(zone(\"America/Toronto\").value).string())"),
        "1969-12-31T19:00:00-05:00[America/Toronto]")

@test
THE_FORMAT_PATTERN_IS_THE_ONE_FROM_THE_USERS_OWN_LIBRARY()
    // `io.github.edadma.datetime`'s dialect: moment-flavoured, with `|bars|` around literal text
    // where moment uses square brackets.
    val d = "val t = dateTime(2026, 8, 28, 17, 24, 15).at(zone(\"America/Toronto\").value).value\n"

    assert_eq(time_out(d + "print(t.format(\"YYYY-MM-DD\"))"), "2026-08-28")
    assert_eq(time_out(d + "print(t.format(\"WWWW, MMMM D, Y |at| h12:mm a\"))"), "Friday, August 28, 2026 at 5:24 pm")
    assert_eq(time_out(d + "print(t.format(\"WWW MMM DD YY hh:mm:ss A\"))"), "Fri Aug 28 26 17:24:15 PM")
    assert_eq(time_out(d + "print(t.format(\"DDD\"))"), "240")
    assert_eq(time_out(d + "print(t.format(\"z zz zzz zzzz\"))"), "-04:00 -0400 EDT America/Toronto")

    // **`Z` is still a literal**, which is why the zone elements are lower case: the original
    // library's ISO pattern has to keep meaning what it meant.
    assert_eq(time_out("print(dateTime(2026, 8, 28, 17, 24, 15).format(\"YYYY-MM-DDThh:mm:ss.fffZ\"))"),
        "2026-08-28T17:24:15.000Z")

@test
TWELVE_HOUR_TIME_IS_TWELVE_AT_MIDNIGHT_AND_AT_NOON()
    // The one defect carried over from the Scala library: `if (hours > 12) hours - 12 else hours`
    // renders 00:30 as `0:30 am`, where every clock in the world shows `12:30 am`.
    assert_eq(time_out("print(time(0, 30).format(\"h12:mm a\"))"), "12:30 am")
    assert_eq(time_out("print(time(12, 30).format(\"h12:mm a\"))"), "12:30 pm")
    assert_eq(time_out("print(time(13, 5).format(\"hh12:mm a\"))"), "01:05 pm")
    assert_eq(time_out("print(time(0, 0).format(\"hh:mm\"))"), "00:00")

@test
A_PATTERN_ELEMENT_THE_VALUE_DOES_NOT_HAVE_IS_REFUSED_NOT_ZERO_FILLED()
    // A date rendered as `00:00` is a midnight the program never meant, and it is exactly the kind
    // of value that then gets compared, stored and reported on.
    assert(time_fails("print(date(2026, 8, 28).format(\"hh:mm\"))").contains("has no time of day"))
    assert(time_fails("print(time(9, 0).format(\"YYYY\"))").contains("has no date"))
    assert(time_fails("print(dateTime(2026, 8, 28, 9, 0).format(\"zzzz\"))").contains("only a zoned reading knows its zone"))
    assert(time_fails("print(now().format(\"YYYY\"))").contains("an instant has no calendar to format"))

    // A run of a letter that is not an element of that length says what the element is.
    assert(time_fails("print(date(2026, 8, 28).format(\"YYY\"))").contains("a year is `Y`, `YY` or `YYYY`"))
    assert(time_fails("print(date(2026, 8, 28).format(\"|open\"))").contains("never closes it"))

@test
THE_PARTS_OF_A_READING_ARE_ASKED_FOR_BY_NAME()
    // **`weekday` answers a name, not a number**, because a number needs a second convention saying
    // which day the week starts on and no two libraries agree. JavaScript's `getDay()` is the
    // weekday and its `getDate()` is the day of the month, three characters apart.
    val d = "val d = date(2026, 8, 28)\n"

    assert_eq(time_out(d + "print(d.year(), d.month(), d.day())"), "2026 8 28")
    assert_eq(time_out(d + "print(d.weekday(), d.monthName())"), "Friday August")
    assert_eq(time_out(d + "print(d.dayOfYear(), d.daysInMonth(), d.isLeapYear())"), "240 31 false")
    assert_eq(time_out("print(date(2024, 2, 1).isLeapYear(), date(2024, 2, 1).daysInMonth())"), "true 29")
    assert_eq(time_out("print(time(9, 30, 15).hour(), time(9, 30, 15).minute(), time(9, 30, 15).second())"), "9 30 15")

@test
THE_START_OF_A_UNIT_IS_ONE_CALL_AND_A_WEEK_STARTS_ON_MONDAY()
    // ISO 8601's answer, and the one the rest of the world uses. Everything grouped by month in a
    // report is written with this.
    assert_eq(time_out("print(date(2026, 8, 28).startOf(\"month\").string())"), "2026-08-01")
    assert_eq(time_out("print(date(2026, 8, 28).startOf(\"year\").string())"), "2026-01-01")
    assert_eq(time_out("print(date(2026, 8, 28).startOf(\"week\").string())"), "2026-08-24")
    assert_eq(time_out("print(dateTime(2026, 8, 28, 17, 24, 15).startOf(\"hour\").string())"), "2026-08-28T17:00:00")
    assert(time_fails("print(date(2026, 8, 28).startOf(\"hour\"))").contains("a date has no hour"))
    assert(time_fails("print(date(2026, 8, 28).startOf(\"fortnight\"))").contains("`startOf` takes"))

@test
ON_OR_AFTER_IS_WHAT_EVERY_TUESDAY_MEANS_GIVEN_A_STARTING_POINT()
    assert_eq(time_out("print(date(2026, 8, 28).onOrAfter(\"monday\").string())"), "2026-08-31")
    assert_eq(time_out("print(date(2026, 8, 28).onOrAfter(\"friday\").string())"), "2026-08-28")
    assert(time_fails("print(date(2026, 8, 28).onOrAfter(\"someday\"))").contains("is not one"))

@test
EVERY_TEMPORAL_VALUE_PRINTS_AS_TEXT_slate_READS_BACK()
    // The four with no zone in them round-trip through their own parser, which is what ISO 8601 is
    // for. A duration and a period are written for a person and are not claimed to read back.
    assert_eq(time_out("print(parseDate(date(2026, 8, 28).string()).value == date(2026, 8, 28))"), "true")
    assert_eq(time_out("print(parseTime(time(9, 30, 15).string()).value == time(9, 30, 15))"), "true")

    val dt = "dateTime(2026, 8, 28, 9, 30, 15)"

    assert_eq(time_out(s"print(parseDateTime(${dt}.string()).value == ${dt})"), "true")
    assert_eq(time_out("print(parseTimestamp(epochSeconds(0).string()).value == epochSeconds(0))"), "true")
    assert_eq(time_out("print(parseTimestamp(\"nonsense\").ok)"), "false")

@test
EVERY_TEMPORAL_KIND_IS_TESTABLE_BY_ITS_OWN_WORD()
    // The type word is the test, which is the rule slate already had for `string` and `number`.
    assert_eq(time_out("print(now() is instant, hours(1) is duration, days(1) is period)"), "true true true")
    assert_eq(time_out("print(date(2026, 8, 28) is date, time(9, 0) is time, utc is zone)"), "true true true")
    assert_eq(time_out("print(dateTime(2026, 8, 28, 9, 0) is dateTime)"), "true")
    assert_eq(time_out("print(now().at(utc) is zoned, now().at(utc) is instant)"), "true false")

@test
A_DELAY_MAY_BE_WRITTEN_AS_A_DURATION()
    // `sleep(2.seconds())` says what `sleep(2000)` cannot. The number form stays, being node's and
    // being what every program here already says.
    assert_eq(time_out("async main() = await sleep(millis(1))\nmain()\nprint(\"slept\")"), "slept")
    assert(time_fails("sleep(\"soon\")").contains("a number of milliseconds or a duration"))

@test
MONOTONIC_IS_A_DURATION_AND_IS_WHAT_AN_ELAPSED_TIME_IS_MEASURED_WITH()
    // The wall clock can be set backwards; this one cannot, so it is what a measurement subtracts
    // from itself. It answers a duration rather than an instant because it names no point in time.
    assert_eq(time_out("print(monotonic() is duration)"), "true")
    assert_eq(time_out("val a = monotonic()\nprint((monotonic() - a).micros() >= 0)"), "true")

@test
THE_LOCAL_ZONE_ALWAYS_ANSWERS_BECAUSE_THERE_IS_ALWAYS_AN_ANSWER()
    // Not a result, where `zone` is one: the whole table where `/etc/localtime` can be read, and
    // libc's offset where it cannot. A host misconfigured about its own zone is not something a
    // slate program can do anything about.
    assert_eq(time_out("print(localZone() is zone)"), "true")
    assert_eq(time_out("print(now().at(localZone()) is zoned)"), "true")

// -- running another program ---------------------------------------------------------------------

@test
RUN_CAPTURES_WHAT_A_PROGRAM_PRINTED_AND_THE_STATUS_IT_LEFT()
    val r = "async main()\n" +
        "    val r = await run(\"echo\", [\"hello\", \"world\"])\n" +
        "    print(r.value.status, r.value.signal, r.value.out.trim())\n" +
        "main()\n"

    assert_eq(proc_out(r), "0 null hello world")

    // **The two streams are kept apart**, which is what a caller reporting a failure needs: the
    // message is on one and the answer is on the other.
    val both = "async main()\n" +
        "    val r = await run(\"/bin/sh\", [\"-c\", \"echo said; echo complained >&2; exit 3\"])\n" +
        "    print(r.value.status, r.value.out.trim(), r.value.err.trim())\n" +
        "main()\n"

    assert_eq(proc_out(both), "3 said complained")

@test
A_CHILD_THAT_FAILED_IS_A_SUCCESS_AND_A_MISSING_PROGRAM_IS_NOT()
    // Rust's split and `sysl.process`'s: a non-zero status is the answer to the question that was
    // asked, and an error means there was no child at all. A caller has to be able to tell "the
    // program said no" from "there is no such program".
    val failed = "async main()\n" +
        "    val r = await run(\"false\", [])\n" +
        "    print(r.ok, r.value.status)\n" +
        "main()\n"

    assert_eq(proc_out(failed), "true 1")

    // **THIS IS THE ONE THAT SEGFAULTED.** `deny_request` surrenders the slot and surrendering
    // clears the slot's copy of the promise, so reading the promise *afterwards* answered
    // `Promise(null)` -- which the machine dereferenced, killing the process with no diagnostic at
    // all. It is the failure path of every call that can be refused before it starts, and `run` is
    // the first one that meets it routinely: a program that is not installed is refused by `spawn`
    // on the spot, where libuv answers nearly everything else asynchronously.
    val missing = "async main()\n" +
        "    val r = await run(\"no-such-program-anywhere\", [])\n" +
        "    print(r.ok, r.error)\n" +
        "main()\n"

    assert_eq(proc_out(missing), "false cannot run `no-such-program-anywhere`: ENOENT: no such file or directory")

@test
A_CHILD_RUNS_WHERE_IT_IS_TOLD_AND_WITH_THE_ENVIRONMENT_IT_IS_GIVEN()
    val where = "async main()\n" +
        "    val r = await run(\"/bin/pwd\", [], { cwd: \"/tmp\" })\n" +
        "    print(r.value.out.trim().endsWith(\"/tmp\"))\n" +
        "main()\n"

    assert_eq(proc_out(where), "true")

    // **The environment REPLACES rather than adds**, which is libuv's behaviour and the sharper of
    // the two: a program that wants to add a variable reads what it needs with `env(name)` and
    // passes it through, and one that wants a child with an empty environment has no other way to
    // say so.
    val environment = "async main()\n" +
        "    val r = await run(\"/bin/sh\", [\"-c\", \"echo $GREETING\"], { env: { GREETING: \"hi\", PATH: \"/bin\" } })\n" +
        "    print(r.value.out.trim())\n" +
        "main()\n"

    assert_eq(proc_out(environment), "hi")

@test
A_CHILD_THAT_RUNS_TOO_LONG_IS_STOPPED_WHERE_THE_CALLER_ASKED()
    // A timeout is the caller saying they are no longer willing to wait, so the signal is `SIGKILL`
    // and not one the child may ignore -- an ignored signal would leave the promise pending exactly
    // as it was. The limit is written as a duration, which is what that type is for.
    val slow = "async main()\n" +
        "    val r = await run(\"sleep\", [\"5\"], { timeout: millis(200) })\n" +
        "    print(r.ok, r.error)\n" +
        "main()\n"

    // **Both imports, and the composition is the point**: this test is about a child and about a
    // duration, so it names `slate:process` and `slate:time` by nesting the two helpers.
    assert_eq(proc_out(timed(slow)), "false `sleep` took too long and was stopped")

@test
A_CHILDS_STANDARD_INPUT_IS_CLOSED_RATHER_THAN_INHERITED()
    // **A test that would HANG if this were wrong**, which is why it is worth having: `cat` with an
    // inherited descriptor waits for input nobody is going to type, and the whole suite waits with
    // it. Closed means the child reads end of file at once and finishes.
    val fed = "async main()\n" +
        "    val r = await run(\"cat\", [])\n" +
        "    print(r.value.status, len(r.value.out))\n" +
        "main()\n"

    assert_eq(proc_out(fed), "0 0")

@test
RUN_REFUSES_ARGUMENTS_THAT_ARE_NOT_WHAT_IT_TAKES()
    assert(proc_fails("run(42, [])").contains("`run` takes a command"))
    assert(proc_fails("run(\"echo\", \"hi\")").contains("takes the arguments as an array"))
    assert(proc_fails("run(\"echo\", [1, 2])").contains("takes its arguments as strings"))
    assert(proc_fails("run(\"echo\", [], 7)").contains("takes its options as an object"))
    assert(proc_fails("run(\"echo\", [], { timeout: \"soon\" })").contains("`timeout` is a duration"))
    assert(proc_fails("run(\"echo\", [], { env: { A: 1 } })").contains("an environment variable is a string"))

@test
A_PROGRAM_MAY_READ_ITS_OWN_ENVIRONMENT_AND_NOT_WRITE_IT()
    // Reading only: setting a variable changes what every later `run` inherits and what anything
    // else in the process sees, from anywhere in a program, which is a global variable wearing a
    // string's clothes. A child that needs a different environment is given one at the call.
    assert_eq(proc_out("print(env(\"PATH\") != null)"), "true")
    assert_eq(proc_out("print(env(\"SLATE_NOTHING_IS_SET_HERE\"))"), "null")
    // **The wrong kind is now caught before it runs**, `env` having a signature the checker knows.
    // The run-time check is still there and still matters -- a name that arrives from a file is a
    // value nobody wrote down -- so it is pinned through `Opaque`, which is what an unannotated
    // function answers and is stable rather than a trick played on a limitation.
    assert(proc_fails("print(env(42))").contains("`env` takes string here, and this is integer"))
    assert(proc_fails(Opaque + "print(env(anything(42)))").contains("`env` takes a variable name"))

// -- what the checker learned from the temporal types -------------------------------------------

@test
A_METHOD_NAME_IS_REFUSED_BEFORE_IT_RUNS_WHERE_THE_KIND_IS_KNOWN()
    // **The most useful thing this pass does**, and it is sound because it asks the machine's own
    // question: `methods_of` is the table `builtin_method` dispatches through, so what the checker
    // refuses is exactly what the machine refuses and a name added to a kind is added in one place.
    assert(fails("f(s: string) = s.push(1)").contains("`push` is not something a string can do"))
    assert(fails("f(d: date) = d.hour()").contains("`hour` is not something a date can do"))
    assert(time_fails("print(now().year())").contains("`year` is not something an instant can do"))
    assert(fails("f(n: integer) = n.upper()").contains("`upper` is not something an integer can do"))

    // **A receiver nothing is known about is left alone**, which is most of an unannotated program:
    // the machine still refuses it, at the call.
    assert_eq(out(Opaque + "print(anything(\"ab\").upper())"), "AB")
    assert(fails(Opaque + "print(anything(\"ab\").push(1))").contains("`push` is not something a string can do"))

    // **An object is never asked about**, its names being the program's own.
    assert_eq(out("val o = { greet: () -> \"hi\" }\nprint(o.greet())"), "hi")

@test
AN_ANNOTATION_MAY_NAME_A_TEMPORAL_KIND_AND_IT_IS_CHECKED()
    assert_eq(time_out("f(d: date) = d.year()\nprint(f(date(2026, 8, 28)))"), "2026")
    assert(time_fails("f(d: date) = d.year()\nprint(f(\"nope\"))").contains("takes date here, and this is string"))

    // **A date fits nothing but a date.** There is no promotion among the eight as there is between
    // an integer and a real -- each tests one variant of `Value` and no two overlap.
    // **`now()` is the temporal value whose type the checker knows**, its result naming no argument;
    // `date(y, m, d)` is variable-arity and has no signature, so the machine catches that one.
    assert(time_fails("f(d: dateTime) = d\nprint(f(now()))").contains("takes dateTime here, and this is instant"))
    assert(time_fails("f(d: dateTime) = d\nprint(f(date(2026, 8, 28)))").contains("`d` was declared dateTime, and was given 2026-08-28"))
    // **`days(1)` has no type the checker knows**, `days` making a period from a number and reading
    // one back from a period -- so a signature naming one result would refuse the other, and it has
    // none. The machine catches this one, which is the division working as intended: the checker
    // moves a fault earlier where it can and stays quiet where it cannot.
    assert(time_fails("f(t: duration) = t\nprint(f(days(1)))").contains("`t` was declared duration, and was given 1d"))

@test
THE_CHECKER_SAYS_NOTHING_ABOUT_TEMPORAL_ARITHMETIC()
    // **It refused `monotonic() - a` the first time it was tried**, which is the one mistake this
    // pass may not make. What the operators mean over the eight kinds is a table in `time.sysl`, and
    // a second copy here would be a second thing to keep in step.
    assert_eq(time_out("val a = monotonic()\nprint((monotonic() - a).micros() >= 0)"), "true")
    assert_eq(time_out("print((date(2026, 1, 1) + months(1)).string())"), "2026-02-01")
    assert_eq(time_out("print((hours(1) * 2).hours())"), "2")

    // The machine still refuses what has no meaning.
    assert(time_fails("print(now() + days(1))").contains("an instant has no calendar to move by"))

@test
A_BUILTIN_OF_NO_ARGUMENTS_IS_COUNTED_WHERE_ITS_ANSWER_IS_KNOWN()
    // `FunctionType(no params, any result)` is the bare word `function` and says nothing, so a
    // no-argument builtin can only be counted where its result is named -- which `now`, `monotonic`
    // and `localZone` all are.
    assert(time_fails("print(now(5))").contains("`now` takes 0 arguments and this gives it 1"))
    assert_eq(time_out("print(now() is instant)"), "true")

@test
env_ANSWERS_A_STRING_OR_NOTHING_AND_THE_UNION_IS_A_REAL_CHECK()
    // Handing it straight to something that wants a string is a fault the machine would raise, and
    // the union is what lets the compiler see it first. `?? ""` is what a program writes instead.
    assert(proc_fails("f(s: string) = s\nprint(f(env(\"PATH\")))").contains("takes string here, and this is string | null"))
    assert_eq(proc_out("f(s: string) = len(s) > 0\nprint(f(env(\"PATH\") ?? \"\"))"), "true")

// -- the half of `slate:time` the JavaScript back end has ----------------------------------------

@test
THE_CLOCK_READS_WHOLE_MILLISECONDS_SO_THE_TWO_BACK_ENDS_AGREE()
    // **The host clock here has microseconds and `Date.now()` has nothing finer than a
    // millisecond.** Left alone, a program that printed a timestamp showed six fractional digits
    // under one back end and three under the other -- a difference nobody asked for that turns up in
    // a log file rather than in a test. The VALUE keeps its microseconds; it is the clock that is
    // coarser, which is why the second line below still reads back every digit.
    assert_eq(time_out("print(now().epochMicros() % 1000)"), "0")
    assert_eq(time_out("print(epochMicros(1000000001).epochMicros())"), "1000000001")

@test
AN_INSTANT_STILL_REFUSES_at_AND_format_WELL_ON_BOTH_BACK_ENDS()
    // **`at` and `format` are in the instant's method table SO THAT THEY REFUSE WELL**, and what
    // each refuses with changed when the calendar arrived: `at` now takes a zone and the complaint
    // is about the argument, and `format` says an instant has no calendar and names the fix. Left
    // out of the table entirely, the answer would be "`at` is not something an instant can do" --
    // true, and sending the reader to look at a name they wrote correctly.
    //
    // **`at` is also the one name a built-in module shares with an array's**, and the two back ends
    // keep them apart differently: the interpreter looks a method up by the KIND of its receiver
    // and has two natives, where a module's name is a plain global in the emitted program and there
    // can be only one. So the JavaScript `at` tests its first argument, which is what `do_at` does
    // too -- and that agreement is what this asserts.
    val said = "an instant is read at a zone, and this is a time"

    assert(time_fails("print(epochSeconds(0).at(time(9, 30)))").contains(said))
    assert(node_said(timed("print(epochSeconds(0).at(time(9, 30)))")).contains(said))

    val nocal = "an instant has no calendar to format -- read it in a zone first"

    assert(time_fails("print(epochSeconds(0).format(\"YYYY\"))").contains(nocal))
    assert(node_said(timed("print(epochSeconds(0).format(\"YYYY\"))")).contains(nocal))

    assert_eq(node_said(timed("print([1, 2, 3].at(-1), [1, 2, 3].at(0))")), "3 1")
    assert_eq(time_out("print([1, 2, 3].at(-1), [1, 2, 3].at(0))"), "3 1")

@test
A_DELAY_IS_A_DURATION_ON_BOTH_BACK_ENDS()
    // `sleep(2.seconds())` reads better than `sleep(2000)`, and until the JavaScript back end had
    // durations at all it could only refuse one. Its own check ran ahead of `wantDelay` and was
    // still refusing after they arrived.
    assert_eq(time_out("async main()\n    await sleep(millis(5))\n    print(\"slept\")\nmain()"), "slept")
    assert_eq(node_said(timed("async main()\n    await sleep(millis(5))\n    print(\"slept\")\nmain()")), "slept")
    assert_eq(node_said(timed("setTimeout(() -> print(\"fired\"), millis(1))")), "fired")

@test
A_METHOD_A_KIND_DOES_NOT_HAVE_IS_REFUSED_IN_ONE_SENTENCE_ON_BOTH_BACK_ENDS()
    // One fault with two spellings: the interpreter said "`push` is not something a string can do"
    // and the emitted program said "a string cannot `push`". A program's own tests are written
    // against whichever back end its author ran, so the two have to say the same words.
    assert(fails("anything(v) = v\nprint(anything(\"abc\").push(1))").contains(
        "`push` is not something a string can do"))
    assert(node_said("anything(v) = v\nprint(anything(\"abc\").push(1))").contains(
        "`push` is not something a string can do"))

@test
THE_CALENDAR_IS_IN_THE_JAVASCRIPT_BACK_END_AND_ANSWERS_WHAT_THE_INTERPRETER_ANSWERS()
    // **A smoke test standing in front of `tests/js/p18.sl`**, which is where the calendar is really
    // pinned -- two hundred lines of it, diffed line for line. What this one buys is a failure that
    // NAMES the calendar: a p18 diff of two hundred lines says the two back ends disagree somewhere,
    // and a reader arriving at a red suite wants to know first whether the thing runs at all.
    val setup = "val z = zone(\"America/Toronto\").value\n" +
        "val t = epochSeconds(1719792000).at(z)\n"

    assert_eq(node_said(timed(setup + "print(t.string())")),
        "2024-06-30T20:00:00-04:00[America/Toronto]")
    assert_eq(node_said(timed(setup + "print(t.year(), t.monthName(), t.weekday())")), "2024 June Sunday")
    assert_eq(node_said(timed(setup + "print(t.format(\"YYYY-MM-DD hh:mm z\"))")), "2024-06-30 20:00 -04:00")
    assert_eq(node_said(timed(setup + "print((t + days(1)).string(), (t + hours(24)).string())")),
        "2024-07-01T20:00:00-04:00[America/Toronto] 2024-07-01T20:00:00-04:00[America/Toronto]")
    assert_eq(node_said(timed("print(parseDate(\"2024-02-30\").error)")),
        "cannot read \"2024-02-30\" as a date: day is out of range")

@test
THE_TWO_CALENDAR_NAMES_A_JAVASCRIPT_HOST_CANNOT_ANSWER_SAY_WHY_RATHER_THAN_NOT_YET()
    // **`abbrev` and `isDST` are not owed work and the sentence must not say they are.** A reader
    // who believes "not in the JavaScript back end yet" waits for a release that is never coming, so
    // each names the thing the host does not have. Both are measured claims: `Intl` carries CLDR
    // display names rather than IANA abbreviations (67 of 84 readings disagree), and it exposes no
    // daylight-saving flag at all -- the offset-comparison rule every JavaScript date library uses
    // instead is wrong in both directions, missing a zone permanently on daylight time and inventing
    // one for a zone that moved its standard offset mid-year.
    val setup = "val z = zone(\"America/Toronto\").value\nval t = epochSeconds(1719792000)\n"

    assert_eq(time_out(setup + "print(z.abbrev(t), z.isDST(t))"), "EDT true")

    val said = node_said(timed(setup + "print(z.abbrev(t))"))

    assert(said.contains("a JavaScript host has none"))
    assert(said.contains("Intl"))
    assert(!said.contains("yet"))

    val dst = node_said(timed(setup + "print(z.isDST(t))"))

    assert(dst.contains("a JavaScript host has none"))
    assert(!dst.contains("yet"))

    // `zzz` in a pattern is the abbreviation under another spelling, so it refuses with the same
    // sentence rather than with a complaint about the pattern.
    assert(node_said(timed(setup + "print(t.at(z).format(\"zzz\"))")).contains("a JavaScript host has none"))
    assert_eq(time_out(setup + "print(t.at(z).format(\"zzz\"))"), "EDT")

@test
A_ZONED_READING_ANSWERS_THE_EPOCH_WORDS_ITS_METHOD_TABLE_PROMISES()
    // A name in `zoned`'s table that the implementation refused, found while writing the same table
    // for the other back end: `do_epoch` took an integer or an instant, and a zoned reading carries
    // one. The refusal read "takes a whole number or an instant" about a value that has an instant
    // in it, which is the kind of true that sends a reader nowhere.
    val setup = "val z = zone(\"UTC\").value\nval t = epochSeconds(1719792000).at(z)\n"

    assert_eq(time_out(setup + "print(t.epochSeconds(), t.epochMillis(), t.epochMicros())"),
        "1719792000 1719792000000 1719792000000000")

@test
A_LENGTH_MULTIPLIES_FROM_EITHER_SIDE_AND_BOTH_KINDS_DO()
    // `days(3) * 2` worked and `2 * days(3)` was refused, while a duration took both spellings --
    // an asymmetry between the two length types that nothing in the design asks for.
    assert_eq(time_out("print((days(3) * 2).string(), (2 * days(3)).string())"), "6d 6d")
    assert_eq(time_out("print((hours(1) * 2).string(), (2 * hours(1)).string())"), "2h 2h")
    assert_eq(time_out("print((2 * (months(1) + days(2))).string())"), "2mo 4d")

@test
AN_OFFSET_IS_REFUSED_NAMING_THE_ONE_SPELLING_THAT_IS_ACCEPTED()
    // The message used to offer `-0400` as well, and `-0400` is refused: `sysl.time`'s reader wants
    // the colon. A diagnostic naming a spelling the very next attempt is refused for is worse than
    // one naming none.
    assert_eq(time_out("print(zone(\"+05:30\").value.string())"), "+05:30")
    assert(time_out("print(zone(\"-0400\").error)").contains("an offset is written `+05:30`"))
    assert(!time_out("print(zone(\"-0400\").error)").contains("or `-0400`"))

@test
monotonic_IS_A_CLOCK_THAT_ONLY_GOES_FORWARD_ON_BOTH_BACK_ENDS()
    // **The one temporal builtin whose two implementations are entirely unrelated**: the interpreter
    // reads the host's monotonic clock through `sysl.posix.time` and the emitted program reads
    // `performance.now()`. What they have to agree about is not a number -- nothing about a clock
    // reading is reproducible -- but the SHAPE of the answer and the guarantee: a duration, going
    // forward, by about as long as the program actually waited.
    val program = "async main()\n" +
        "    val a = monotonic()\n" +
        "    await sleep(millis(20))\n" +
        "    val b = monotonic()\n" +
        "    print(b - a is duration, b > a, millis(b - a) >= 15, millis(b - a) < 5000)\n" +
        "main()\n"

    assert_eq(time_out(program), "true true true true")
    assert_eq(node_said(timed(program)), "true true true true")

@test
fetch_IS_THE_LAST_GLOBAL_THE_JAVASCRIPT_BACK_END_STILL_OWES()
    // **A test that is a REMINDER as much as a check**, and it is written to fail the day the work is
    // done. `globals.md` describes `fetch` as node's name and the browser's, which reads as a promise
    // that it works in both -- and under `slate js` it refuses. A browser HAS `fetch`, so this is one
    // of the names the user's rule says may not refuse: work owed rather than something the host
    // lacks, and the only thing to write is the wrapper shaping the host's answer into slate's
    // `{ ok, value }`.
    //
    // **When that wrapper lands this test fails**, which is the point: whoever writes it is then
    // holding the one page that has to change with it.
    // **Called rather than merely named**: the stub `OWED` installs is a function, so printing the
    // name succeeds and says nothing. What refuses is the call.
    assert(node_said("print(fetch(\"http://127.0.0.1:1/\"))")
        .contains("`fetch` is not in the JavaScript back end yet"))
