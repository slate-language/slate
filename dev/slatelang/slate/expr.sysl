module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{str_builder, from_utf8_unchecked}

// Expressions, by binding power.
//
// Nine near-identical recursive-descent functions -- `parse_or`, `parse_and`, `parse_equality`, and
// so on down to `parse_primary` -- are what this replaces with one number per operator. Prefix
// operators, calls, indexing, field access and the lambda arrow all come out of the callbacks being
// free to read whatever they like, so none of them is a case in the loop.

// The whole of slate's precedence table.
//
// **Associativity is the difference between the two numbers and nothing else**: recurse at the
// operator's own power and it groups to the left, one below it and it groups to the right. The only
// right-associative operator slate has is the lambda arrow, so that `x -> y -> x + y` reads as a
// function returning a function rather than as a parse error.
private power_of(k: Tok) -> Power
    k match
        Arrow -> right_assoc(5)

        // **`match` sits between the arrow and everything else, and both neighbours are load
        // bearing.** Below every arithmetic operator, so `a + b match` transforms the sum rather
        // than just `b` -- a match is a transformation of the thing to its left, which is Scala's
        // reason and sysl's. Above the arrow, so `x -> y match` gives the lambda a body that
        // matches, rather than matching on the lambda.
        Match -> left_assoc(6)

        // **`catch` sits beside `match`, and for `match`'s reason.** It is a transformation of the
        // thing to its left, so it binds looser than every arithmetic operator -- `a + b catch ...`
        // guards the sum -- and tighter than the lambda arrow, so `x -> risky() catch e -> 0` gives
        // the lambda a body that guards rather than guarding the lambda.
        Catch -> left_assoc(6)

        OrOr -> left_assoc(10)

        // **Looser than `||`, so `a ?? b || c` reads as `a ?? (b || c)`.** JavaScript refuses to mix
        // the two without parentheses at all; slate gives them an order instead, since a program that
        // writes both usually means the defaulting to happen last.
        QQ -> left_assoc(9)
        AndAnd -> left_assoc(20)

        // **`is` sits between `&&` and the comparisons**, which is sysl's placement and is load
        // bearing at both ends: the subject and the pattern are each held tighter than the `&&` that
        // joins one test to the next, so `a is P && b > 0` is two terms rather than an `is` against a
        // conjunction.
        Is -> left_assoc(25)

        // **Every comparison is one level, because a chain of them is ONE comparison.** `a < b < c`
        // is `a < b && b < c` with `b` evaluated once, which is sysl's rule and mathematics'. Giving
        // `==` a level of its own would make `a == b < c` group instead of chain.
        EqEq -> left_assoc(30)
        BangEq -> left_assoc(30)
        Lt -> left_assoc(30)
        LtEq -> left_assoc(30)
        Gt -> left_assoc(30)
        GtEq -> left_assoc(30)

        // A range is tighter than a comparison and looser than the bitwise operators, so `a..b == c`
        // compares the range and `a..b|c` ranges over the disjunction. sysl's order exactly.
        DotDot -> left_assoc(35)
        DotDotLt -> left_assoc(35)

        Pipe -> left_assoc(40)
        Caret -> left_assoc(42)
        Amp -> left_assoc(44)
        Plus -> left_assoc(50)
        Minus -> left_assoc(50)
        Star -> left_assoc(60)
        Slash -> left_assoc(60)
        Percent -> left_assoc(60)

        // **A shift binds like a multiplication**, which is sysl's deliberate correction to C -- where
        // `a & b == c` and `1 << 2 + 3` both group in the way nobody predicts.
        Shl -> left_assoc(60)
        Shr -> left_assoc(60)

        // `++` and `--` after a value are postfix, so they bind as tightly as a call does.
        PlusPlus -> left_assoc(80)
        MinusMinus -> left_assoc(80)

        // Calls, indexing and field access are postfix: they bind tighter than any arithmetic, so
        // `-f(x)` negates the result and `a.b + c` adds to the field.
        LParen -> left_assoc(80)
        LBracket -> left_assoc(80)
        Dot -> left_assoc(80)
        QDot -> left_assoc(80)

        // **A tail rather than a binary operator**, so it binds as tightly as a field selection and
        // `a + b with { ... }` changes `b` rather than the sum. sysl says the same.
        With -> left_assoc(80)

        // Anything else is not an infix operator, and answering zero is how the loop knows to stop.
        _ -> left_assoc(0)
end power_of

// How tightly a prefix operator holds its operand.
//
// It sits above every binary operator and below the postfix ones, which is what makes `-a * b` read
// as `(-a) * b` and `-a.b` as `-(a.b)`.
private const PrefixPower: u8 = 70

// An expression, at the outermost level.
parse_expr(p: *Parser) -> Expr = parse_expr_bp(p, 0)

// An expression that stops before a lambda arrow.
//
// **This exists for a match arm's guard, and the bug it fixes is worth keeping written down.** A
// guard is followed by the arm's `->`, and an ordinary `parse_expr` reads that arrow as the start of
// a lambda: `n if n < 0 -> "negative"` parsed as a guard of `n < (0 -> "negative")` and complained
// that a lambda's parameter must be a name. Running at the arrow's own left power stops the loop
// exactly there, which is what binding powers are for.
parse_expr_before_arrow(p: *Parser) -> Expr = parse_expr_bp(p, power_of(Arrow).left)

// An expression that stops before an `is`.
//
// **This exists for a class header, and it is the arrow bug wearing a different operator.** `class
// Square from Shape is Drawable` has a base and then a promise, and an ordinary `parse_expr` reads
// the `is` as the test it usually is -- so the base came out as `Shape is Drawable` and the header
// ended, with the complaint landing on the comma of the next promise. Running at `is`\'s own left
// power stops the base exactly where it should. A base that really is an `is` test wants parentheses,
// which is what they are for.
parse_expr_before_is(p: *Parser) -> Expr = parse_expr_bp(p, power_of(Is).left)

// An expression, at a given binding power.
//
// `pratt` answers `None` only where the stream was already empty; slate's always ends in `Eof`, so
// the `None` arm is unreachable in practice and is written rather than unwrapped.
private parse_expr_bp(p: *Parser, min_bp: u8) -> Expr
    pratt(p, min_bp, nud, led, lbp) match
        Some(e) -> e
        None -> expr(p.here(), Bad)

// What the loop asks of a token it is thinking of taking.
private lbp(t: Spanned[Tok]) -> u8 = power_of(t.value).left

// -- prefix position ----------------------------------------------------------------------------

// A token that begins an expression.
//
// The loop has already taken it, so what arrives here is the token and a cursor standing after it.
private nud(t: Spanned[Tok], p: *Parser) -> Expr
    t.value match
        IntLit -> expr(t.span, ExprKind.IntLit(read_int_at(p, t.span)))
        RealLit -> expr(t.span, ExprKind.RealLit(read_real_at(p, t.span)))
        StrLit -> expr(t.span, ExprKind.StrLit(read_str_at(p, t.span)))
        StrInterp -> interpolated(p, t)
        True -> expr(t.span, BoolLit(true))
        False -> expr(t.span, BoolLit(false))
        Null -> expr(t.span, NullLit)
        Undefined -> expr(t.span, UndefinedLit)
        Ident -> expr(t.span, Name(p.text(t.span)))
        Minus -> prefix(p, t, Minus)
        Bang -> prefix(p, t, Bang)
        Tilde -> prefix(p, t, Tilde)
        PlusPlus -> pre_inc_dec(p, t, true)
        MinusMinus -> pre_inc_dec(p, t, false)

        // `..b` and `..` -- a range with its low end left out. In prefix position there is nothing to
        // its left, which is the whole of what tells it from the infix form.
        DotDot -> open_range(p, t, true)
        DotDotLt -> open_range(p, t, false)
        Await ->
            val inner = parse_expr_bp(p, PrefixPower)

            expr(t.span.to(inner.span), Await(inner))

        // `yield e`, and bare `yield` where nothing follows it on the line.
        //
        // **A bare one is `yield null`**, so the node always has an operand and nothing downstream
        // carries an `Option`. What tells them apart is whether an expression can start here at all,
        // which the token table already answers for every word in the grammar.
        Yield ->
            p.yields += 1

            if !starts_expr(p.peek())
                return expr(t.span, Yield(expr(t.span, NullLit)))

            // **`yield` TAKES THE WHOLE EXPRESSION, where `await` takes one operand.** The two look
            // alike and group oppositely, which is JavaScript's rule and Python's and is not
            // arbitrary: `await f() + 1` waits for the call and adds to the answer, so binding
            // tightly is right; `yield x * x` means yielding the product, and binding tightly makes
            // it `(yield x) * x` -- which yields the wrong value and then multiplies by whatever the
            // caller sent back. That is what it did, and it faulted one turn later on `null * 2`,
            // pointing at the yield and blaming the multiplication.
            //
            // A yield used *inside* a larger expression is bracketed -- `(yield x) + 1` -- which is
            // what JavaScript requires for the same reason.
            val inner = parse_expr(p)

            expr(t.span.to(inner.span), Yield(inner))
        Async -> async_lambda(p, t)
        LParen -> parenthesised(p, t)
        LBracket -> array_literal(p, t)
        LBrace -> object_literal(p, t)
        If -> if_expression(p, t)
        Try -> try_expression(p, t)

        // The loops, which are expressions here as they are in sysl.
        While -> parse_while(p, "", t.span)
        For -> parse_for(p, "", t.span)
        Loop -> parse_loop(p, "", t.span)
        Do -> parse_do_while(p, "", t.span)
        Label -> parse_labelled(p, t.span)
        _ ->
            p.report.add(expected(t.span, "an expression", p.found(t.span)))
            expr(t.span, Bad)
end nud

private prefix(p: *Parser, t: Spanned[Tok], op: Tok) -> Expr
    val rhs = parse_expr_bp(p, PrefixPower)

    expr(t.span.to(rhs.span), Unary(op, rhs))

// `(e)`, or the parameter list of a lambda.
//
// **The two are told apart by trying, because no amount of lookahead at one token distinguishes
// them**: `(a, b) -> a + b` and `(a + b)` both start `(` `Ident`. The cursor is marked, the
// parameter shape is attempted, and a failure winds it back -- which the token cursor supports
// directly and which costs nothing, the tokens being already in memory.
private parenthesised(p: *Parser, t: Spanned[Tok]) -> Expr
    if closes_on_an_arrow(p)
        lambda_params(p) match
            Some(found) -> return lambda_body(p, t.span, found.0, found.1, found.2)

            // A bracket that closes on an arrow and is still not a parameter list is a parameter
            // list somebody wrote wrongly, and `lambda_params` has already said what is wrong with
            // it. What is left is to parse the brackets as what they look like.
            None -> ()

    val inner = parse_expr(p)

    p.expect(RParen, "`)`")

    // A grouping is not a node: it exists to change how its contents parse, and it has already done
    // that by the time this returns.
    inner
end parenthesised

// Whether the bracket just opened is closed by a `)` with an arrow after it.
//
// **THIS IS A LOOKAHEAD BECAUSE THE ATTEMPT CANNOT BE UNDONE.** Winding the token cursor back is
// free, but a diagnostic the attempt produced along the way is already in the report and stays
// there -- so `({ body: o.z })` was refused with *"expected `}`, found `.`"*, which is the
// destructuring-pattern parser complaining that a pattern's field is not a name, about brackets
// that were never a parameter list. An object literal in brackets whose fields are anything but
// plain values could not be written at all.
//
// The scan is over tokens already in memory and stops at the bracket's own close, so what it costs
// is the length of the brackets and it runs only for a grouping -- a call's argument list is a
// postfix and never comes here.
private closes_on_an_arrow(p: *Parser) -> bool
    val m = p.toks.mark()
    var depth = 1
    var found = false

    loop
        if p.at(Eof) then break

        if p.at(LParen) || p.at(LBracket) || p.at(LBrace)
            depth += 1
        elif p.at(RBracket) || p.at(RBrace)
            depth -= 1
        elif p.at(RParen)
            depth -= 1

            if depth == 0
                p.bump()
                found = p.at(Arrow)
                break

        p.bump()

    p.toks.reset(m)
    found
end closes_on_an_arrow

// A parenthesised list of nothing but names, followed by an arrow -- consumed if that is what is
// there, and wound back to the opening bracket if it is not.
private lambda_params(p: *Parser) -> Option[(Buf[string], Buf[Expr], Buf[Stmt])]
    val m = p.toks.mark()
    var params: Buf[string] = buf()
    var defaults: Buf[Expr] = buf()
    var unpacks: Buf[Stmt] = buf()

    if !p.at(RParen)
        loop
            // **A parameter may take its argument apart here too**, on the same first-token rule a
            // binding uses: a `{` or a `[` can begin no name. The pattern is parsed rather than
            // skipped, and a pattern that will not parse winds the cursor back like anything else
            // here -- `({ a: 1 })` is an object in brackets and not a lambda.
            var named = "this parameter"

            if p.at(LBrace) || p.at(LBracket)
                params.push(unpacked_param(p, &unpacks, params.len()))
            elif !p.at(Ident)
                p.toks.reset(m)
                return None
            else
                named = s"`${p.text(p.here())}`"

                params.push(p.text(p.here()))
                p.bump()

            read_default(p, &defaults, named)

            if !p.accept(Comma) then break
            if p.at(RParen) then break
    end if

    if !p.accept(RParen) || !p.accept(Arrow)
        p.toks.reset(m)
        return None

    Some((params, defaults, unpacks))
end lambda_params

// The body of a lambda, once its parameters are known.
private lambda_body(p: *Parser, start: Span, params: Buf[string], defaults: Buf[Expr], unpacks: Buf[Stmt]) -> Expr
    val outer_yields = p.yields
    val body = if p.at(Indent) then parse_block(p) else parse_expr_bp(p, power_of(Arrow).right)
    val yielded = p.yields > outer_yields

    p.yields = outer_yields
    expr(start.to(body.span), Lambda(params, defaults, intern_body(with_checks(unpacks, body), yielded), false))

// `async x -> ...` and `async (a, b) -> ...`.
//
// **The lambda is parsed first and marked afterwards**, at the outermost binding power rather than at
// `PrefixPower`: the arrow is the loosest operator slate has, so a prefix that held its operand
// tightly would stop before reaching it and `async x -> x` would read as `async x` followed by a
// stray arrow. What comes back has to be a lambda, and saying so is the whole of the check.
private async_lambda(p: *Parser, t: Spanned[Tok]) -> Expr
    val inner = parse_expr(p)

    *inner.kind match
        Lambda(params, defaults, body, _) -> expr(t.span.to(inner.span), Lambda(params, defaults, body, true))
        _ ->
            p.fault(inner.span, "`async` goes in front of a function")
            expr(t.span.to(inner.span), Bad)
end async_lambda

// `[a, b, c]`. A newline inside the brackets is not a line ending, so nothing here handles one.
//
// **`...xs` among the elements is the `Spread` node a call's arguments already carry**, put in a
// second position rather than given a second spelling. An argument list and an array literal are the
// same problem -- a run of written values with arrays folded in between them -- so `compile_expr`
// builds both with the one routine.
private array_literal(p: *Parser, t: Spanned[Tok]) -> Expr
    var items: Buf[Expr] = buf()

    if !p.at(RBracket)
        loop
            if p.at(Spread)
                val at = p.here()

                p.bump()

                val inner = parse_expr(p)

                items.push(expr(at.to(inner.span), Spread(inner)))
            else
                items.push(parse_expr(p))

            // `[v; n]` -- one value and a count, which is a different form from a list and is told
            // apart by the `;` after the first element.
            if items.len() == 1 && p.accept(Semi)
                val count = parse_expr(p)

                p.expect(RBracket, "`]`")

                val whole = t.span.to(p.just_taken())

                // **The two forms mean opposite things about one array and cannot be combined.**
                // `[v; n]` makes `n` copies of one value; `...xs` takes the elements out of one. A
                // reader writing `[...xs; 3]` wants a repeat of something and this is not where to
                // say it, so the refusal names both rather than reporting a stray `;`.
                *items.at(0).kind match
                    Spread(_) ->
                        p.fault(whole, "`[v; n]` repeats one value and `...` spreads an array apart -- one array cannot be both")

                        return expr(whole, Bad)
                    _ -> ()

                return expr(whole, ArrayRepeat(items.at(0), count))

            if !p.accept(Comma) then break
            if p.at(RBracket) then break

    p.expect(RBracket, "`]`")

    expr(t.span.to(p.just_taken()), ArrayLit(items))
end array_literal

// `base with { f: v, ... }` -- a copy with fields changed.
//
// **A copy is the point.** An object is a reference type here, so a program that wants to change one
// in place just writes to it; what it has no other way to say is "the same but for this", which is
// what an immutable-minded reader reaches for and what a shared object makes dangerous to fake.
private with_fields(p: *Parser, base: Expr) -> Expr
    var keys: Buf[string] = buf()
    var values: Buf[Expr] = buf()

    // **The right-hand side may be an ordinary expression**, and then the fields are whatever that
    // object turns out to hold. It is also what `{ ...a, ...b }` is built out of: an object
    // literal desugars each of its spreads into one of these, so there is one merge in the language
    // and two ways to reach it.
    if !p.at(LBrace)
        // **ONE BELOW `with`'s OWN POWER, AND THAT IS NOT AN OFF-BY-ONE.** `with` binds as tightly as
        // a field selection -- deliberately, so `a + b with c` changes `b` rather than the sum -- and
        // `.`, `[` and `(` are at that same power. Parsing the right-hand side at `with`'s *right*
        // power therefore stops before a `.`, and `header with claims.header` came out as
        // `(header with claims).header`: the merge happened, its answer was thrown away, and what
        // came back was the field. Nothing failed and the wrong object was returned.
        //
        // A chain then groups to the right -- `a with b with c` is `a with (b with c)` -- which for a
        // merge is the same answer either way, since `c` wins over `b` wins over `a` under both.
        val other = parse_expr_bp(p, power_of(With).left - 1)

        return expr(base.span.to(other.span), WithAll(base, other, false))

    p.expect(LBrace, "`{` and the fields to change")

    if !p.at(RBrace)
        loop
            keys.push(parse_key(p, "a field name"))
            p.expect(Colon, "`:` and a value")
            values.push(parse_expr(p))

            if !p.accept(Comma) then break
            if p.at(RBrace) then break

    p.expect(RBrace, "`}`")

    expr(base.span.to(p.just_taken()), WithFields(base, keys, values))
end with_fields

// `{ name: value, ... }`.
//
// **A key is a name, or a string where the key is not a name.** The bare form is what makes an
// object literal read like a record and is what a program writes nearly every time; the quoted form
// is the only way to write the keys slate objects have always been able to hold -- `"a.b"`, `"if"`,
// `""`. With it the literal syntax is a superset of JSON's object syntax, which is what lets a
// machine-written file be read back by the reader that reads a hand-written one.
private object_literal(p: *Parser, t: Spanned[Tok]) -> Expr
    var keys: Buf[string] = buf()
    var key_spans: Buf[Span] = buf()
    var values: Buf[Expr] = buf()

    // What the entries before the last `...` came to. While it is `None` no spread has been met and
    // what is being read is the ordinary literal, which is what the great majority of them are.
    var built: Option[Expr] = None

    if !p.at(RBrace)
        loop
            if p.at(Spread)
                p.bump()

                val other = parse_expr(p)

                built = Some(expr(t.span.to(p.just_taken()),
                    WithAll(object_so_far(built, keys, key_spans, values, t.span.to(p.just_taken())), other, true)))

                keys = buf()
                key_spans = buf()
                values = buf()
            else
                val key_at = p.here()

                keys.push(parse_key(p, "a field name"))
                key_spans.push(key_at.to(p.just_taken()))

                p.expect(Colon, "`:` and a value")

                values.push(parse_expr(p))

            if !p.accept(Comma) then break
            if p.at(RBrace) then break

    p.expect(RBrace, "`}`")

    object_so_far(built, keys, key_spans, values, t.span.to(p.just_taken()))
end object_literal

// The entries read so far as one expression: the literal itself where no `...` has been met, and
// otherwise what has been merged, with any fields written since the last one laid over it.
//
// **This is where `{ a: 1, ...o, b: 2 }` becomes `{ a: 1 } with o with { b: 2 }`**, which is the
// same object by the same rule -- a later entry wins over an earlier one, and a field already
// present keeps the place it had. Desugaring here rather than carrying a spread into the tree means
// nothing downstream learns a new shape, and it means the meaning can be checked by writing the
// longhand and comparing.
private object_so_far(built: Option[Expr], keys: Buf[string], key_spans: Buf[Span], values: Buf[Expr], at: Span) -> Expr
    built match
        Some(b) ->
            if keys.len() == 0 then b else expr(at, WithFields(b, keys, values))
        None -> expr(at, ObjectLit(keys, key_spans, values))
end object_so_far

// `if c then a else b`, and the indented form.
//
// **An `if` with no `else` used for its value is `null` rather than a mistake.** slate is
// dynamically typed, so there is no type for the missing branch to disagree with -- which is the
// one place its rules are simpler than sysl's rather than the same.
private if_expression(p: *Parser, t: Spanned[Tok]) -> Expr
    val cond = parse_expr(p)

    if p.accept(Then)
        // **A one-line branch is a STATEMENT**, so `if n > 2 then break` is what it reads as. See
        // `parse_control_body`: this is the same rule, spelled here because an `if` reads its `else`
        // in the middle rather than at the end.
        val a = if p.at(Indent) then parse_block(p) else inline_stmt_body(p)
        val b = else_branch(p)

        accept_end(p, If)
        return expr(t.span.to(p.just_taken()), IfExpr(cond, a, b))
    end if

    val a = parse_block(p)
    val b = else_branch(p)

    accept_end(p, If)
    expr(t.span.to(p.just_taken()), IfExpr(cond, a, b))
end if_expression

// `try` with an indented body and a `catch` under it.
//
// **The block form and the postfix form make the same node**, so nothing downstream learns that
// there are two. slate already does this for `if`, whose one-line and indented forms are one
// `IfExpr`, and for every control-flow body.
private try_expression(p: *Parser, t: Spanned[Tok]) -> Expr
    val body = if p.at(Indent) then parse_block(p) else inline_stmt_body(p)

    if !accept_on_next_line(p, Catch)
        p.fault(p.here(), "a `try` needs a `catch` -- there is no `finally`, and a `try` with nothing to handle the fault would only be hiding where it came from")
        return expr(t.span.to(p.just_taken()), Bad)
    end if

    val name = parse_name(p, "a name for the fault")
    val handler = if p.at(Indent) then parse_block(p) else inline_stmt_body(p)

    accept_end(p, Try)
    expr(t.span.to(p.just_taken()), TryCatch(body, name, handler))
end try_expression

// `x catch e -> y` -- the same thing written where a value is wanted.
//
// The body after the arrow is read exactly as a lambda's is, which is what lets it be a block: `->`
// opens one where it ends the line, so a handler may run to several statements without the `try`
// form being reached for.
private catch_tail(p: *Parser, lhs: Expr) -> Expr
    val name = parse_name(p, "a name for the fault")

    p.expect(Arrow, "`->` and what to do about the fault")

    val handler = if p.at(Indent) then parse_block(p) else parse_expr_bp(p, power_of(Arrow).right)

    expr(lhs.span.to(handler.span), TryCatch(lhs, name, handler))
end catch_tail

// The `elif` chain and the `else`, if either is there.
//
// **`elif` is sugar and nests into the `else` of the one before it**, so no node exists for it and
// nothing downstream has to learn a rule about it. That is the arrangement sysl states for its own
// `elif` and the reason given there holds here.
// **Both may open a one-line body**, as sysl's do: `elif` takes the same `then` an `if` does, and an
// `else` written on the same line as its `if` takes a statement rather than a block.
private else_branch(p: *Parser) -> Option[Expr]
    val start = p.here()

    if accept_on_next_line(p, Elif)
        val cond = parse_expr(p)
        val a = parse_control_body(p, Then)
        val b = else_branch(p)

        return Some(expr(start.to(p.just_taken()), IfExpr(cond, a, b)))
    end if

    if !accept_on_next_line(p, Else) then return None

    Some(if p.at(Indent) then parse_block(p) else inline_stmt_body(p))
end else_branch

// -- infix and postfix position -----------------------------------------------------------------

// A token with an expression already to its left.
//
// The loop has taken the operator, so a callback reads only its right-hand side -- which is what
// makes every binary operator one line and every postfix one a small function.
private led(lhs: Expr, t: Spanned[Tok], p: *Parser) -> Expr
    t.value match
        LParen -> call(p, lhs)
        LBracket -> index(p, lhs)
        Dot -> field(p, lhs, false)
        QDot -> field(p, lhs, true)
        Arrow -> arrow(p, lhs, t)
        PlusPlus -> expr(lhs.span.to(t.span), IncDec(lhs, true, false))
        MinusMinus -> expr(lhs.span.to(t.span), IncDec(lhs, false, false))
        Is -> is_test(p, lhs)
        With -> with_fields(p, lhs)
        DotDot -> range_to(p, lhs, true)
        DotDotLt -> range_to(p, lhs, false)
        Match ->
            val arms = parse_arms(p)

            expr(lhs.span.to(p.just_taken()), MatchExpr(lhs, arms))
        Catch -> catch_tail(p, lhs)
        _ ->
            if is_comparison(t.value) then return comparison(p, lhs, t)

            val rhs = parse_expr_bp(p, power_of(t.value).right)

            expr(lhs.span.to(rhs.span), Binary(t.value, lhs, rhs))
end led

private is_comparison(k: Tok) -> bool
    k == EqEq || k == BangEq || k == Lt || k == LtEq || k == Gt || k == GtEq

// A run of comparisons, which is one comparison however long it is.
//
// **Two operands stay an ordinary `Binary`**, so the overwhelmingly common case costs nothing and
// the chain node exists only where there is a chain to hold.
private comparison(p: *Parser, lhs: Expr, t: Spanned[Tok]) -> Expr
    val power = power_of(t.value).right
    var operands: Buf[Expr] = buf()
    var ops: Buf[Tok] = buf()

    operands.push(lhs)
    ops.push(t.value)
    operands.push(parse_expr_bp(p, power))

    loop
        if !is_comparison(p.peek()) then break

        ops.push(p.peek())
        p.bump()
        operands.push(parse_expr_bp(p, power))

    if ops.len() == 1
        return expr(lhs.span.to(operands.at(1).span), Binary(ops.at(0), lhs, operands.at(1)))

    expr(lhs.span.to(operands.at(operands.len() - 1).span), Compare(operands, ops))
end comparison

// `a..b` and `a..<b`, and the form whose high end is left out.
//
// **A range is non-associative**, so the high end is read at a power that stops before another `..`:
// `a..b..c` is a mistake rather than a nest, which is what sysl's grammar says by writing each end as
// the level below.
private range_to(p: *Parser, lhs: Expr, inclusive: bool) -> Expr
    val power = power_of(DotDot).left

    if !starts_expr(p.peek())
        return expr(lhs.span.to(p.just_taken()), Range(Some(lhs), None, inclusive))

    val hi = parse_expr_bp(p, power)

    expr(lhs.span.to(hi.span), Range(Some(lhs), Some(hi), inclusive))
end range_to

private open_range(p: *Parser, t: Spanned[Tok], inclusive: bool) -> Expr
    if !starts_expr(p.peek())
        return expr(t.span, Range(None, None, inclusive))

    val hi = parse_expr_bp(p, power_of(DotDot).left)

    expr(t.span.to(hi.span), Range(None, Some(hi), inclusive))
end open_range

// `x is Pat`, `x is not Pat`, and `x is A | B`.
//
// **`not` is a soft word**, read only here: it stays an ordinary name everywhere else, which is what
// sysl does with both halves and what slate can still do with this one.
private is_test(p: *Parser, lhs: Expr) -> Expr
    val negated = if p.at(Ident) && p.text_at(0) == "not"
        p.bump()
        true
    else
        false

    val pat = parse_pattern(p)

    expr(lhs.span.to(pat.span), IsPattern(lhs, pat, negated))
end is_test

private pre_inc_dec(p: *Parser, t: Spanned[Tok], up: bool) -> Expr
    val target = parse_expr_bp(p, PrefixPower)

    expr(t.span.to(target.span), IncDec(target, up, true))

// `f(a, b)`.
private call(p: *Parser, callee: Expr) -> Expr
    var args: Buf[Expr] = buf()

    if !p.at(RParen)
        loop
            // **`...xs` is an argument list worked out while running.** An array literal reads one
            // the same way and an object literal desugars one into `with`; what is peculiar to this
            // position is that an argument list built at run time has no other spelling at all,
            // `apply` not being something a program can reach.
            if p.at(Spread)
                val at = p.here()

                p.bump()

                val inner = parse_expr(p)

                args.push(expr(at.to(inner.span), Spread(inner)))
            else
                args.push(parse_expr(p))

            if !p.accept(Comma) then break
            if p.at(RParen) then break

    p.expect(RParen, "`)`")

    expr(callee.span.to(p.just_taken()), Call(callee, args))
end call

// `xs[i]`.
private index(p: *Parser, target: Expr) -> Expr
    val key = parse_expr(p)

    p.expect(RBracket, "`]`")

    expr(target.span.to(p.just_taken()), Index(target, key))
end index

// `o.name`.
private field(p: *Parser, target: Expr, optional: bool) -> Expr
    val name = parse_name(p, "a field name")

    expr(target.span.to(p.just_taken()), Field(target, name, optional))

// `x -> body`, where the parameter was already read as a name.
//
// **The left-hand side arrives as a built `Name` node and is taken apart again**, which is what the
// binding-power loop costs for a form whose left side is a binder rather than an operand. The
// alternative -- looking ahead for the arrow before reading the name -- would put slate's one
// lookahead in two places instead of one.
private arrow(p: *Parser, lhs: Expr, t: Spanned[Tok]) -> Expr
    var params: Buf[string] = buf()

    *lhs.kind match
        Name(n) -> params.push(n)
        _ -> p.fault(lhs.span, "a lambda's parameter is a name")

    // A single unbracketed parameter is a bare name, there being no other way to write one -- a
    // pattern there would have been read as an expression long before the arrow was seen, and a
    // default would have been read as an assignment.
    lambda_body(p, lhs.span, params, buf(), buf())
end arrow

// `s"a ${b} c"` taken apart into the pieces it renders.
//
// **The taking apart is `read_interpolated`'s and the parsing is slate's**, which is the right seam:
// where a hole starts and stops is a question every grammar with interpolation answers the same way
// and most answer wrongly, and what a hole *says* is this grammar's alone.
private interpolated(p: *Parser, t: Spanned[Tok]) -> Expr
    // Started on the quote rather than on the `s`, which is what the reader below expects.
    var s = Scanner(p.src.bytes, t.span.start + 1)

    val parts = read_interpolated(&s, u8('"'), "${".bytes, u8('}')) match
        Ok(v) -> v
        Err(_) -> return expr(t.span, Bad)

    var pieces: Buf[Expr] = buf()

    for i in 0..<parts.chunks.len()
        val chunk = parts.chunks.at(i)

        // **Nothing is kept for an empty run**, so `s"${a}${b}"` renders two pieces rather than five.
        if chunk != "" then pieces.push(expr(t.span, ExprKind.StrLit(chunk)))

        if i < parts.holes.len() then pieces.push(hole_expr(p, parts.holes.at(i)))

    expr(t.span, Interp(pieces))
end interpolated

// One hole's expression, read at the offsets it occupies in the file it was written in.
//
// **`sub_source` is what keeps a complaint inside a hole pointing at the right character.** Lexing
// the hole's text on its own would give spans measured from the hole, so every diagnostic in an
// interpolation would name a line and column nobody could find.
private hole_expr(p: *Parser, at: Span) -> Expr
    val sub = sub_source(p.src, at)
    val lexed = lex(sub)
    // A hole is an expression and never a statement, so the depth it starts at only has to be
    // somewhere `export` is refused. One says that and needs no thought.
    var inner = Parser(lexed.tokens, sub, lexed.report, buf(), buf(), buf(), buf(), buf(), 0, 1)

    // **The blanking is indentation as far as the layout pass is concerned**, so the hole opens a
    // block before its first token. Stepping over that is what makes the offsets free: everything
    // inside then lines up against its own column, which is what a nested block in one wants anyway.
    if inner.at(Indent) then inner.bump()

    // **A hole with nothing in it complains about ITSELF, and used to complain about the end of the
    // file.** The sub-source is the whole input with everything outside the hole blanked, so an
    // empty hole lexes to a single `Eof` at the end of the *file* -- and `parse_expr`'s complaint
    // then pointed there, which for `s"hello ${ }"` on line one was `found the end of the file` at
    // line three. Every word of that was true and it sent the reader to a blank line.
    if inner.at(Eof)
        p.report.add(error(at, "this interpolation has nothing in it -- a `${}` holds an expression whose value goes in the string"))
        return expr(at, Bad)

    val e = parse_expr(&inner)

    // Whatever the hole complained about is the program's complaint.
    p.report.absorb(inner.report)
    e
end hole_expr

// -- literals ---------------------------------------------------------------------------------

// **A literal is decoded here rather than in the lexer**, from the span the lexer proved was well
// formed. The readers are the toolkit's, run a second time over the same bytes: an allocation-free
// pass over a dozen characters, in exchange for a token type that carries no payload.
//
// Not `private`: `pattern.sysl` decodes the same literals, a pattern having them too.

read_int_at(p: *Parser, at: Span) -> long
    var s = scanner(p.src.text(at))

    read_number(&s) match
        Ok(Int(v)) -> long(v)
        _ -> 0

read_real_at(p: *Parser, at: Span) -> real
    var s = scanner(p.src.text(at))

    read_number(&s) match
        Ok(Real(v)) -> v
        Ok(Int(v)) -> real(v)
        _ -> 0.0

read_str_at(p: *Parser, at: Span) -> string
    var s = scanner(p.src.text(at))

    read_quoted(&s, u8('"')) match
        Ok(v) -> v
        _ -> ""
