module dev.slatelang.slate

// What the lexer answers with: a kind, and nothing else.
//
// **A token carries no payload, and that is a decision rather than an omission.** The name in an
// identifier, the digits in a number and the bytes in a string are all *already* in the input, and
// every token comes with the `Span` that says where. So a variant carrying a `string` would be a
// second copy of text the parser can read back whenever it wants it, and the enum would stop being
// a bare one -- which costs both of the things the compiler gives a bare enum for free: `==`, and a
// `Display` that names the variant. Reading the lexeme back off the source is what Clang and rustc
// do for the same reason.
//
// The consequence to know while reading `parse.sysl`: **decoding a literal is the parser's job**, not
// the lexer's. The lexer proves a literal is well formed and says where it is; the parser opens a
// scanner on that span when it needs the value.
// `Eq` is absent from the clause on purpose: a simple enum is one already, its value being its
// discriminant, and asking for it is refused in as many words.
enum Tok derives Display
    // Literals. The span is the whole lexeme, quotes included for a string.
    //
    // **The `Lit` suffixes say what these are, and are not there to dodge a clash.** Two enums may
    // carry a variant of one name -- `sh.sysl.parsing`'s `Number` also has `Int` and `Real`, and
    // this file imports that package wholesale -- because the expected type is what picks between
    // them, and where nothing supplies one the compiler says so and asks for `Tok.Int`. What the
    // suffix buys is a reader who can tell a token that *is* a number from the number itself.
    IntLit
    RealLit
    StrLit

    // `s"a ${b} c"` -- the whole literal, holes and all. **One token rather than a run of them**,
    // because the pieces are already in the source and the parser reads them back off the span, which
    // is the same bargain every other literal here takes.
    StrInterp
    Ident

    // Words. `end` is deliberately absent -- see the note below.
    Val
    Var
    If
    Then
    Elif
    Else
    While
    For
    In
    Loop
    Do
    Match
    Break
    Continue
    Return
    True
    False
    Null
    Undefined

    // `async` marks a function that answers a promise; `await` waits for one.
    Async
    Await

    // `yield`, which is a prefix operator like `await` and is what makes a function a generator.
    Yield

    // `;`, which separates a value from its count in `[v; n]`.
    Semi

    // `base with { f: v }` -- a copy with fields changed. A hard word for the same reason `is` is.
    With

    // `'outer` -- the name a loop carries, so that a `break` can name which one it leaves.
    Label

    // `try` and `catch`.
    //
    // **`catch` is a HARD word for the reason `is` and `with` are**, and not by preference: it is an
    // infix operator, and `pratt` asks a token for its left binding power without handing over the
    // stream -- so a word that is an operator only sometimes cannot be told apart at the point the
    // answer is needed. `try` follows it rather than being argued separately: a language with one of
    // them reserved and the other not would be a strange thing to explain.
    Try
    Catch

    // **`throw` is what makes `catch` reachable from a program.** A library written in slate that
    // could catch a fault but never make one could report nothing of its own, and a `catch` block
    // could not put back what it decided not to handle.
    Throw

    // `import { a } from "./util.sl"` and `export val x = ...`.
    //
    // **Both are hard words, where `from` and `as` beside them are soft.** A file's first word
    // decides what the whole statement is, so the two that lead one are worth a word of the
    // language; `from` and `as` are read only at a point where the parser already knows what it is
    // looking for, so taking them would cost every program a pair of ordinary names for nothing.
    Import
    Export

    // `x is Pat` -- a pattern where a condition is wanted.
    //
    // **A hard word here where sysl keeps it soft**, and the reason is the binding-power loop rather
    // than a preference: `pratt` asks a token for its left power without handing over the stream, so
    // a word that is only an operator sometimes cannot be told apart at the point the answer is
    // needed. `not` stays soft, being read only after this.
    Is

    // Grouping and separators.
    LParen
    RParen
    LBracket
    RBracket
    LBrace
    RBrace
    Comma
    Colon
    Dot
    Arrow

    // `...`, which gathers what is left of an array in a pattern. Read before `.`, or it would be
    // three field selections.
    Spread

    // An element written in the source -- `<div class="x">hello {name}</div>` -- which slate calls
    // slx, after tsx.
    //
    // **`<` opens one only where an operand is expected, and that is the whole of the ambiguity.**
    // `<` is otherwise always an infix operator, so in prefix position it can begin nothing else;
    // slate has no `<T>` generics, which is the reason TypeScript had to make `.tsx` a separate parse
    // mode from `.ts`. `opens_element` in `lex.sysl` is the test, and it asks only what the previous
    // token was.
    //
    // **A tag's name is scanned by the lexer rather than assembled by the parser**, because an
    // attribute may be written `data-id` and a tag `<my-widget>` -- a hyphen that would otherwise be
    // a subtraction. Inside a tag the lexer reads a name as one run and pushes an `Ident` for it.
    SlxOpen
    SlxCloseOpen
    SlxTagEnd
    SlxSelfEnd

    // A run of characters between tags. **Kept raw**, holes and line breaks and all: what it comes
    // to after the whitespace rule is the parser's to work out, which is the same bargain every
    // other literal here takes.
    SlxText

    // `|`, which separates the alternatives of a pattern. Read after `||`.
    Pipe

    // `@`, which binds the whole of what a pattern matched as well as its parts.
    At

    // Operators.
    Assign
    Plus
    Minus
    Star
    Slash
    Percent
    EqEq
    BangEq
    Lt
    LtEq
    Gt
    GtEq
    AndAnd
    OrOr

    // `??`, which answers the left unless it is absent.
    QQ

    // `?.` -- read a field only where there is something to read it from.
    QDot

    // `?` on its own, which marks a field of an object pattern as one the subject need not have.
    // It is read in a pattern and nowhere else: there is no prefix or infix `?` in an expression,
    // so an ordinary program never meets this token.
    Question
    Bang

    // Compound assignment: `a += b` is `a = a + b`, with `a` evaluated once.
    PlusEq
    MinusEq
    StarEq
    SlashEq
    PercentEq
    AmpEq
    PipeEq
    CaretEq
    ShlEq
    ShrEq

    // `++` and `--`, which read before `+=`/`-=` and before `+`/`-`/`->`.
    PlusPlus
    MinusMinus

    // Bitwise. `|` is `Pipe` above, which a pattern's alternatives already use -- there is nothing
    // for the two to be ambiguous with, a pattern having no arithmetic in it.
    Amp
    Caret
    Tilde
    Shl
    Shr

    // Ranges. `..<` is read before `..`, and `...` before both.
    DotDot
    DotDotLt

    // Structure, supplied by the layout pass rather than by any character in the file.
    Newline
    Indent
    Dedent
    Eof
end Tok

// **`end` is not a keyword and must not become one.** sysl treats it as a *soft* word -- an ordinary
// identifier everywhere except immediately before a construct keyword -- so that a program may still
// call a variable `end`. Slate follows that, which means the lexer emits `Ident` for it and the
// parser decides by what comes next. Making it a `Tok` of its own would be the easy thing and would
// take the name away from every program that wanted it.

// Whether a token can begin an expression.
//
// This is what lets the parser tell a *definition* from a *call* without backtracking, and it is the
// one piece of lookahead slate's grammar needs.
starts_expr(t: Tok) -> bool
    t match
        IntLit -> true
        RealLit -> true
        StrLit -> true
        StrInterp -> true
        Ident -> true
        True -> true
        False -> true
        Null -> true
        Undefined -> true

        // `async` begins one only as a lambda's marker; `await` is an ordinary prefix operator.
        Async -> true
        Await -> true
        Yield -> true
        If -> true

        // **Every loop is an expression**, so each of these begins one -- and so does the label a
        // loop may carry, which is only ever written immediately before one.
        While -> true
        For -> true
        Loop -> true
        Do -> true
        Label -> true
        LParen -> true
        LBracket -> true
        LBrace -> true
        Minus -> true
        Bang -> true
        _ -> false
end starts_expr
