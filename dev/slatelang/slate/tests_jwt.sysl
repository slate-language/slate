module dev.slatelang.slate
@tests

// `slate:jwt` -- JSON Web Tokens, written in slate over two signing natives.
//
// **Every one of these signs or checks a real token**: there is no way to test a JWT library
// that does not, and a test that compared against a recorded string would be pinning this
// implementation's output rather than the format.

@test
A_TOKEN_SIGNED_WITH_A_SECRET_VERIFIES_WITH_THE_SAME_SECRET()
    // **The round trip, on the algorithm nearly every token uses.** A secret rather than a key pair,
    // which is what HS256 means and why it is the one to be careful with -- the same string signs and
    // checks, so anything that can verify a token can also mint one.

    val text = "import { sign, verify, decode } from slate:jwt\nval token = sign({ sub: \"alice\", role: \"admin\" }, \"a secret\", \"HS256\")\nval r = verify(token, \"a secret\", \"HS256\")\n\nprint(r.ok, r.value.sub, r.value.role)\nprint(len(split(token, \".\")))\n"

    assert_eq(out(text),
        "true alice admin\n3")

@test
A_TOKEN_WHOSE_PAYLOAD_WAS_CHANGED_DOES_NOT_VERIFY()
    // **A payload changed by one character stops verifying**, which is the whole point of the
    // signature and the one thing a test of a JWT library must actually run.

    val text = "import { sign, verify, decode } from slate:jwt\nval token = sign({ role: \"user\" }, \"a secret\", \"HS256\")\nval parts = split(token, \".\")\nval forged = parts[0] + \".\" + parts[1] + \"x.\" + parts[2]\nval r = verify(forged, \"a secret\", \"HS256\")\n\nprint(r.ok, r.error)\n"

    assert_eq(out(text),
        "false the signature is not this key's")

@test
A_TOKEN_IS_REFUSED_WHERE_ITS_HEADER_DISAGREES_WITH_WHAT_WAS_ASKED_FOR()
    // **THE `alg` HEADER GETS NO VOTE, AND THIS IS THE HOLE THAT CHECK EXISTS FOR.** A verifier that
    // read the algorithm out of the token accepts whatever an attacker wrote there -- `alg: none` was
    // accepted by most libraries for years, and the RS256-public-key-as-an-HMAC-secret confusion turns
    // a *published* key into a signing key. The caller says what it expects and a token that disagrees
    // is refused before a signature is checked at all.

    val text = "import { sign, verify, decode } from slate:jwt\nval token = sign({ sub: \"a\" }, \"a secret\", \"HS256\")\nval r = verify(token, \"a secret\", \"HS512\")\n\nprint(r.ok, r.error)\n"

    assert_eq(out(text),
        "false this token says it is HS256 and HS512 was expected")

@test
A_TOKEN_CLAIMING_NO_ALGORITHM_IS_REFUSED()
    // The other side of the same rule: a token with no algorithm at all in its header is not a token
    // this will read, however well formed the rest of it is.

    val text = "import { sign, verify, decode } from slate:jwt\nval forged = \"eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJhZG1pbiJ9.\"\nval r = verify(forged, \"a secret\", \"HS256\")\n\nprint(r.ok, r.error)\n"

    assert_eq(out(text),
        "false this token says it is none and HS256 was expected")

@test
A_TOKEN_SIGNED_WITH_A_PRIVATE_KEY_VERIFIES_WITH_THE_PUBLIC_ONE()
    // **RS256: signed with a private key and checked with the public one.** The pair is the same one
    // the TLS tests use, with the public half derived from it -- which is what a real deployment does
    // too, publishing a JWKS the verifier fetches.

    val text = "import { sign, verify, decode } from slate:jwt\nimport { readFileSync } from slate:fs\nval secret = readFileSync(\"tests/tls/key.pem\").value\nval public = readFileSync(\"tests/tls/pub.pem\").value\n\nval token = sign({ sub: \"bob\" }, secret, \"RS256\")\nval r = verify(token, public, \"RS256\")\nval other = verify(token, readFileSync(\"tests/tls/other-pub.pem\").value, \"RS256\")\n\nprint(r.ok, r.value.sub)\nprint(other.ok)\n"

    assert_eq(out(text),
        "true bob\nfalse")

@test
A_TOKEN_IS_REFUSED_WHEN_IT_HAS_EXPIRED_AND_WHEN_IT_HAS_NOT_STARTED()
    // **`exp` and `nbf` are checked against the clock, and both are optional.** A token that has
    // expired and one that has not started are two different sentences, because they mean two
    // different things to whoever is holding it.

    val text = "import { sign, verify, decode } from slate:jwt\nimport { epochSeconds, now } from slate:time\nval when = epochSeconds(now())\n\nval expired = sign({ sub: \"a\", exp: when - 60 }, \"s\", \"HS256\")\nval early = sign({ sub: \"a\", nbf: when + 3600 }, \"s\", \"HS256\")\nval fine = sign({ sub: \"a\", exp: when + 3600, nbf: when - 60 }, \"s\", \"HS256\")\n\nprint(verify(expired, \"s\", \"HS256\").error)\nprint(verify(early, \"s\", \"HS256\").error)\nprint(verify(fine, \"s\", \"HS256\").ok)\n"

    assert_eq(out(text),
        "this token expired\nthis token is not valid yet\ntrue")

@test
EXTRA_HEADER_FIELDS_ARE_WRITTEN_TO_THE_HEADER_AND_NOT_TO_THE_CLAIMS()
    // **`header` in the claims is how a `kid` is said**, and it is taken out rather than signed as a
    // claim -- a payload with a field called `header` in it would be a surprising thing to find in a
    // token you signed.

    val text = "import { sign, verify, decode } from slate:jwt\nval token = sign({ sub: \"a\", header: { kid: \"2026-08\" } }, \"s\", \"HS256\")\nval d = decode(token)\n\nprint(toJSON(d.value.header))\nprint(has(d.value.claims, \"header\"), d.value.claims.sub)\n"

    assert_eq(out(text),
        "{\"alg\":\"HS256\",\"typ\":\"JWT\",\"kid\":\"2026-08\"}\nfalse a")

@test
decode_READS_A_TOKEN_WITHOUT_CHECKING_ANY_OF_IT()
    // **`decode` reads a token nobody has verified**, which is what a program needs to find the `kid`
    // that says which key to fetch -- and is the one function here a program must never decide
    // anything with. The name is as loud as a name can be about that.

    val text = "import { sign, verify, decode } from slate:jwt\nval forged = \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhZG1pbiJ9.bm90YXNpZ25hdHVyZQ\"\nval d = decode(forged)\n\nprint(d.ok, d.value.header.alg, d.value.claims.sub)\nprint(verify(forged, \"s\", \"HS256\").ok)\n"

    assert_eq(out(text),
        "true HS256 admin\nfalse")

@test
A_TOKEN_CARRIES_TEXT_THAT_IS_NOT_ASCII_AND_EVERY_TAIL_LENGTH()
    // **base64url is written in slate, so its edges are worth running**: a claim whose text is not
    // ASCII exercises the byte handling both ways, and the three tail lengths are what a hand-written
    // encoder gets wrong.

    val text = "import { sign, verify, decode } from slate:jwt\nvar ok = true\n\nfor n in 0..<40\n    val claims = { note: repeat(\"é\", n) }\n    val r = verify(sign(claims, \"s\", \"HS256\"), \"s\", \"HS256\")\n\n    if !r.ok || r.value.note != claims.note\n        ok = false\n\nprint(ok)\n"

    assert_eq(out(text),
        "true")

@test
RUBBISH_WHERE_A_TOKEN_WAS_EXPECTED_IS_AN_ANSWER_RATHER_THAN_A_FAULT()
    // A token that is not three pieces, one whose pieces are not base64url, and one whose payload is
    // not JSON: all of them are ordinary things to receive from outside, so all of them are answers
    // rather than faults.

    val text = "import { sign, verify, decode } from slate:jwt\nprint(verify(\"not-a-token\", \"s\", \"HS256\").error)\nprint(verify(\"a.b\", \"s\", \"HS256\").error)\nprint(verify(\"!!!.eyJhIjoxfQ.x\", \"s\", \"HS256\").error)\nprint(decode(\"eyJhbGciOiJIUzI1NiJ9.bm90anNvbg.x\").error)\n"

    assert_eq(out(text),
        "a token is three pieces separated by dots, and this has 1\n" +
            "a token is three pieces separated by dots, and this has 2\n" +
            "the header of this token is not base64url\n" +
            "the claims of this token is not JSON")
