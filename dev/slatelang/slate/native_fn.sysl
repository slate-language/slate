module dev.slatelang.slate

import sh.sysl.libuv
import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}

// The REGISTRY every builtin is dispatched through: a name, and the function that runs it.
//
// **It was a closed `enum NativeFn` of five hundred arms until the registry landed**, and the three
// files that made a builtin had to agree: an arm here, a `declare` in `natives.sysl`, and an arm of
// a 371-line match in `builtin.sysl`. Adding one meant editing all three and a subsystem could not
// be left out of a build without editing the first and the third by hand. Now a builtin is
// `register(name, go)` where its implementation is written, so a subsystem's natives, their
// registration and the scope they are declared into are one block in one file.
//
// **A `Value` holds an ID and not the function, and that is not a compromise.** A callable in a
// concrete slot is `&Fn(…)`, which is a counted box -- so a function in the `Native` arm would put
// reference counting into the one type the interpreter copies on every operation, and a finalizer on
// every object that can hold a value. An id is a plain integer, so `Value` stays what it was:
// equality is an integer comparison, hashing is an integer, and the collector has nothing new to
// look at.
//
// **The id is ONE PAST the slot it names, so zero means "never registered".** A `var` holding a
// native's id is zero until its `install_` function has run, and a zero that indexed the first
// entry would silently be `print` -- which is the kind of aliasing that costs an afternoon. It
// faults with a sentence instead.

// **THE REGISTRY IS READ BY EVERY THREAD AT ONCE, WHICH IS WHAT DECIDES ITS SHAPE.** An actor is a
// second runtime on a second OS thread, and both dispatch builtins while the other is running -- so
// the table a dispatch reads has to be one that neither reference counting nor a reallocation can
// move under it. Reference counting in sysl is NOT atomic, so a value copied out of a shared table by
// two threads at once has its count torn and is freed while the other thread is using it; a `Buf`
// that grows replaces its storage, which is worse again. Both are avoided here rather than locked
// against, a lock on the dispatch being a lock on every builtin call slate makes:
//
// - **the function table is a FIXED module array of `&sync Fn`.** A module array never moves, and
//   `&sync` is sysl's atomically counted reference -- so reading a slot to call it is safe from any
//   number of threads without a lock;
// - **the name and id tables are ordinary counted `Buf`/`Map`s, read and written under
//   `registry_lock`.** They are touched once per name per program load and never by a dispatch.

// What a `Value.Native` holds: a builtin's id, one past its slot in the table.
type NativeFn = u32

// A builtin's arguments, as a WINDOW onto the operand stack they are standing on.
//
// **Nothing is copied and nothing is held, because the stack is already a root.** A call used to pop
// its arguments into a fresh `Buf` -- one `malloc`, one free, one copy of every argument and one
// shadow-stack hold each, on every call of every builtin a program makes. They stand where the
// instruction left them instead, and the dispatch cuts them off once the builtin has answered.
//
// **AN INDEX AND NOT A POINTER, WHICH IS THE WHOLE OF ITS SAFETY.** A builtin that calls back into
// slate -- `map`, `filter`, `sort` with a comparator -- runs that callback on the SAME operand
// stack, pushing above the arguments standing here; a stack deep enough to grow replaces its
// storage, so a pointer or a slice taken before the callback names freed memory after it. An index
// survives a reallocation, and `at` reads the running machine's stack afresh every time.
struct Args
    // Where the first argument stands, as an index into the running machine's operand stack.
    base: usize

    // How many of them there are.
    count: usize

    // The `i`th argument. The caller has already checked there is one -- `len` is how.
    at(self, i: usize) -> Value = machine().stack.at(self.base + i)

    // The `i`th argument, read through a VM the builtin already holds. **`at` finds the running
    // machine through a thread-local on every read**, and a builtin that reads three arguments and
    // checks two of them pays for five; one that takes `current()` once pays for one.
    on(self, vm: *Vm, i: usize) -> Value = vm.machine.stack.at(self.base + i)

    len(self) -> usize = self.count

    is_empty(self) -> bool = self.count == 0

    // The first `n` of them, as a window of their own, for a builtin that hands its work to another
    // one that takes fewer arguments. A window is two numbers, so this costs nothing.
    take(self, n: usize) -> Args = Args(self.base, if n < self.count then n else self.count)

// What a builtin runs, as the table holds it.
//
// **`&sync` and not `&Fn`, and that is the whole of the thread safety.** An ordinary `&Fn` is a
// counted box whose count is bumped without an atomic, so one slot read by two VMs at once loses
// counts and frees the box under the thread still calling it.
type NativeGo = &sync Fn(Args, Span) -> Step

// How many builtins the table has room for. Registration faults past it rather than growing, a table
// that grows being one that can move while another thread is reading it.
const MaxNatives: usize = 1024

// process-wide: the function for every id, in registration order, and `None` for a slot no name has
// been given yet. A fixed array so that the storage a dispatch reads never moves, and `&sync` so that
// reading one costs an atomic rather than a lock.
private var native_go: [MaxNatives]Option[NativeGo] = [None; MaxNatives]

// process-wide: the name every id was registered under, for a diagnostic to read back. Written and
// read under `registry_lock`.
//
// **The name is for a reader rather than for dispatch** -- a diagnostic, and the answer to "what did
// this program actually install". `render.sysl` prints every builtin as `<function>`, and
// `builtin_names()` reads the scope rather than this table, so nothing a slate program can see
// depends on it.
private var native_names: Buf[string] = buf()

// process-wide: the id each name was given, which is the index into both tables above. Written and
// read under `registry_lock`.
private var native_ids: Map[string, NativeFn] = map()

// process-wide: what the two counted tables above are read and written under. A dispatch never takes
// it -- only registration, and the two lookups a test asks.
private var registry_lock: &sync libuv.Mutex = libuv.mutex().expect("a lock for the builtin registry")

// Put a builtin in the registry and answer its id.
//
// **Registering a name twice answers the FIRST id rather than making a second entry**, which is what
// lets an `install_` function be called once per program the process runs -- `install_builtins` is,
// and the suite runs thousands of programs in one process, one per VM -- without the table growing
// without bound or an id moving under a `var` that already holds it.
//
// **The function is written into its slot BEFORE the name is published**, so a thread that can find
// an id can call it: the id is only reachable through `native_ids`, and that is written last.
register(name: string, go: NativeGo) -> NativeFn
    registry_lock.lock()

    val id = native_ids.get(name) match
        Some(known) -> known
        None ->
            native_names.push(name)

            val fresh = u32(native_names.len())

            if usize(fresh) > MaxNatives
                print("panic: slate registered more than", MaxNatives, "builtins")
                exit(1)

            native_go[usize(fresh) - 1] = Some(go)
            native_ids.put(name, fresh)
            fresh

    registry_lock.unlock()
    id
end register

// Run the builtin an id names.
//
// **One indirection and no match over builtins.** A builtin's id is its slot, so what used to be a
// 371-line match over every arm of a closed enum is a bounds check and a call through the slot the
// registry already holds.
run_native(f: NativeFn, args: Args, at: Span) -> Step
    if f == 0u32 || usize(f) > MaxNatives
        return fault(at, "this builtin was never registered, which is a defect in slate itself")

    native_go[usize(f) - 1] match
        None -> fault(at, "this builtin was never registered, which is a defect in slate itself")
        Some(go) -> go(args, at)
end run_native

// Run something that takes a builtin's arguments, over values made up here rather than written at a
// call site.
//
// **THE VALUES GO ONTO THE OPERAND STACK AND COME OFF AGAIN, BECAUSE THERE IS NOWHERE ELSE AN `Args`
// CAN POINT.** A window is an index into the running machine's stack, so anything that is not a call
// instruction -- a builtin building arguments for another one, a callback reached from `apply`, a
// property read -- has to put them there first. It is the same buffer the dispatch used to make on
// every builtin call, kept by the handful of callers that genuinely have one.
//
// **The cut is skipped after a park**, as `run_chunk`'s is: a suspended call swapped the running
// machine for a fresh one and this height belongs to the other stack.
with_args(vals: Buf[Value], at: Span, go: &Fn(Args, Span) -> Step) -> Step
    val vm = machine()
    val base = vm.stack.len()

    for i in 0..<vals.len()
        vm.stack.push(vals.at(i))

    val answer = go(Args(base, vals.len()), at)

    answer match
        Err(Wait) -> ()
        _ -> vm.stack.truncate(base)

    answer
end with_args

// The name a builtin was registered under.
native_name(f: NativeFn) -> string
    registry_lock.lock()

    val name = if f == 0u32 || usize(f) > native_names.len()
        "(unregistered)"
    else
        native_names.at(usize(f) - 1)

    registry_lock.unlock()
    name
end native_name

// How many arguments a call gave a METHOD past the value it is about.
//
// **A METHOD TAKEN OFF A VALUE HANDS BACK THE BARE FUNCTION**, which is the receiver rule in
// `docs/reference/objects.md`: `o.m` is the same value `o.m()` reaches, with the receiver as an
// ordinary first argument. So a call is free to leave the receiver out -- `val f = n.toString` and
// then `f()` arrives here with an EMPTY window -- and `args.len() - 1` is an unsigned subtraction,
// which answers 18446744073709551615 rather than "none". Every sentence that counts past a receiver
// printed that number for such a call.
//
// **A call that named no receiver is told THAT, and not a count**, because it is a different
// mistake from giving the method too many arguments: the reader believed the method was bound to
// the value they took it off, and what they want to be sent to is the argument list.
past_receiver(name: string, args: Args, at: Span) -> Result[usize, Signal]
    if args.is_empty()
        return Err(failure(at, s"`${name}` is a method, so the value it is about is its first argument -- and this call gave nothing"))

    Ok(args.len() - 1)
end past_receiver

// The builtin registered under this name, where there is one.
//
// **A name here is not a name a PROGRAM can write.** A native reachable only as a method is
// registered under a qualified name -- `Map.get`, `Set.add`, `Regex.test` -- because the registry is
// keyed by name and a set's `has` and an object's `has` are two different functions.
native_of(name: string) -> Option[NativeFn]
    registry_lock.lock()

    val id = native_ids.get(name)

    registry_lock.unlock()
    id
end native_of
