module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// Definitions, assignment, and the body of either.
//
// **Split out of `parse.sysl` at the point the grammar stops being local.** Everything up to here
// reads a construct its first token names; a definition is told from a call only by looking ahead
// past the whole parameter list, which is what the first function below does and what taking sysl's
// keyword-free function form costs.
//
// Four names here are not `private` because `parse.sysl` reaches them, and two of its own are not
// because this file reaches back: `parse_stmts` and `parse_stmt`, a body being made of statements.

// Whether the cursor is on a function definition rather than on a call.
//
// **This is the one place slate's grammar needs to look ahead, and it is what taking sysl's
// keyword-free function form costs.** `add(a, b)` is a definition when a body follows it and a call
// when one does not, and the two are identical up to that point. So the shape is checked without
// committing: a name, a parenthesised list of nothing but names, and then `=` or an indented block.
//
// Reading it as a *call* first and reinterpreting on seeing the body was the alternative, and it is
// worse in the one way that matters -- `f(a.b)` would parse and then have to be un-parsed, and the
// complaint about it would come from a function that no longer knows a definition was expected.
// **`start` is where the name would be**, which is one further along after an `async`.
at_definition_from(p: *Parser, start: usize) -> bool
    if p.peek_kind_at(start) != Ident then return false
    if p.peek_kind_at(start + 1) != LParen then return false

    var i = start + 2

    // An empty list is a definition of a function of no arguments.
    if p.peek_kind_at(i) == RParen
        return body_follows(p, i + 1)

    loop
        // **A `var` before a parameter is stepped over here and judged in `parse_def`.** A call cannot
        // hold a bare `var` anywhere, so admitting one costs this lookahead nothing -- and where it
        // stands outside a class\'s `new`, the complaint that says so is much better than "this is not
        // a definition".
        if p.peek_kind_at(i) == Var then i += 1

        // **A parameter may be a pattern**, and a `{` or a `[` can begin no name -- the same first
        // token that tells `val { a }` from `val a`. The group is stepped over with its brackets
        // balanced, exactly as an annotation is, since what tells a definition from a call is still
        // only what follows the `)`.
        if p.peek_kind_at(i) == LBrace || p.peek_kind_at(i) == LBracket
            var nest: usize = 0

            loop
                val k = p.peek_kind_at(i)

                if k == Eof then return false

                if k == LBrace || k == LBracket || k == LParen
                    nest += 1
                elif k == RBrace || k == RBracket || k == RParen
                    nest -= 1

                    if nest == 0
                        i += 1
                        break

                i += 1
        elif p.peek_kind_at(i) != Ident
            return false
        else
            i += 1

        // **`p: Point` still leaves a definition told from a call by what follows the `)`**, so all
        // this has to do is find the end of the list.
        if p.peek_kind_at(i) == Colon
            past_group(p, i + 1) match
                Some(at) -> i = at
                None -> return false

        // **And `n = 0` is stepped over the same way**, for the same reason: a default is an
        // expression, and what tells a definition from a call is still only what follows the `)`.
        if p.peek_kind_at(i) == Assign
            past_group(p, i + 1) match
                Some(at) -> i = at
                None -> return false

        p.peek_kind_at(i) match
            Comma ->
                i += 1

                // A trailing comma still closes the list, so the `)` after one is a definition.
                if p.peek_kind_at(i) == RParen then return body_follows(p, i + 1)
            RParen -> return body_follows(p, i + 1)
            _ -> return false
    end loop
end at_definition_from

// Where a parameter's annotation or default ends: the `,` or the `)` that closes it.
//
// **Brackets are counted rather than scanning for the first `,`**, because both a pattern and an
// expression may hold one of their own -- `p: { a: int, b: int }` and `n = f(1, 2)` each hide a
// comma from a scan that does not count. `None` is text that runs out first, which is not a
// definition and not anything else either.
private past_group(p: *Parser, from: usize) -> Option[usize]
    var i = from
    var depth: usize = 0

    loop
        val k = p.peek_kind_at(i)

        if k == Eof then return None

        if k == LBrace || k == LBracket || k == LParen
            depth += 1
        elif k == RBrace || k == RBracket
            if depth == 0 then return None

            depth -= 1
        elif k == RParen
            if depth == 0 then return Some(i)

            depth -= 1
        elif k == Comma && depth == 0
            return Some(i)

        i += 1
end past_group

// Whether what sits at `i` is a function body.
//
// **A result annotation stands between the `)` and the body**, so it is stepped over the way a
// parameter's is -- with brackets balanced, since `-> { a: number }` is a shape like any other.
private body_follows(p: *Parser, i: usize) -> bool
    var at = i

    if p.peek_kind_at(at) == Arrow
        at += 1

        var depth: usize = 0

        loop
            val k = p.peek_kind_at(at)

            if k == Eof then return false

            if k == LBrace || k == LBracket || k == LParen
                depth += 1
            elif k == RBrace || k == RBracket || k == RParen
                if depth == 0 then return false

                depth -= 1
            elif depth == 0 && (k == Assign || k == Indent)
                break

            at += 1
        end loop
    end if

    val k = p.peek_kind_at(at)

    k == Assign || k == Indent

// Whether each parameter of the definition just read was written `var`, parallel to its `params`.
//
// **A module-level buffer rather than a field on `Def`**, for the reason annotations are not on `Def`
// either: only one caller in the language wants the answer, and every pass downstream would otherwise
// carry a `Buf[bool]` it never reads. `parse_def` writes it LAST, after its body -- so a definition
// nested inside that body has already had its turn and the outer one's answer is the one left.
private var param_declares: Buf[bool] = buf()

// Whether a `var` parameter is legal where the definition being read stands.
//
// **It is legal in a class's `new` and nowhere else.** Elsewhere it would be a parameter that quietly
// wrote a field on an object the function has no business knowing about.
private var allow_declaring_params: bool = false

// `name(a, b)` with a body.
parse_def(p: *Parser) -> Stmt
    val start = p.here()
    val is_async = p.accept(Async)
    val name = parse_name(p, "a name for the function")

    p.expect(LParen, "`(`")

    var params: Buf[string] = buf()
    var declares: Buf[bool] = buf()
    var checks: Buf[Stmt] = buf()
    var defaults: Buf[Expr] = buf()

    if !p.at(RParen)
        loop
            if p.at(LBrace) || p.at(LBracket)
                params.push(unpacked_param(p, &checks, params.len()))
                declares.push(false)
                read_default(p, &defaults, "this parameter")

                if !p.accept(Comma) then break
                if p.at(RParen) then break

                continue
            end if

            // **`new(var side)` declares a field and takes it in one place**, which is TypeScript's
            // parameter property wearing slate's word for "one of these per object".
            val declaring = p.at(Var)

            if declaring
                if !allow_declaring_params
                    p.fault(p.here(), "`var` in a parameter list declares a field on the object being made, which only a class's `new` is making -- an ordinary function takes a value and writes nothing")

                p.bump()

            val pname = parse_name(p, "a parameter name")

            params.push(pname)
            declares.push(declaring)

            // **`p: Point` becomes a statement at the top of the body**, which is what keeps
            // annotations off `Def` and `Lambda` and off everything downstream that reads them. What
            // it buys is the whole point of writing one: the complaint arrives where the value was
            // handed over rather than wherever it was first used wrongly.
            if p.accept(Colon)
                val tname = if p.at(Ident) then p.text(p.here()) else ""
                val tat = p.here()
                val tpat = parse_pattern(p)

                checks.push(stmt(tat.to(p.just_taken()), CheckType(pname, tname, tpat)))

            // **The default is read AFTER the annotation**, so `n: int = 0` reads left to right the
            // way it is said aloud: what it is, then what it is when nobody says.
            read_default(p, &defaults, s"`${pname}`")

            if !p.accept(Comma) then break
            if p.at(RParen) then break

    p.expect(RParen, "`)`")

    // **`-> type` says what a call answers, and nothing downstream of a call can be checked without
    // it.** It is read here rather than being a field on `Def` for the reason a parameter's is: the
    // body is wrapped, and the tree keeps one shape.
    val result = if p.accept(Arrow)
        val rname = if p.at(Ident) then p.text(p.here()) else ""
        val rat = p.here()

        Some((rname, rat, parse_pattern(p)))
    else
        None

    // Two body forms, and the `=` is what tells them apart: `double(x) = x * 2` puts the result on
    // the line, and an indented block puts it in a run of statements. sysl has both for the same
    // reason -- a body should not have to change shape when it outgrows a line -- and `=` may open
    // an indented block too, which needs nothing here because `parse_body` looks for the `Indent`.
    p.accept(Assign)

    // **The count is put back to zero for this body and restored after it**, which is what makes the
    // question "did *this* body yield" rather than "has anything yielded yet".
    val outer_yields = p.yields

    val checked = with_checks(checks, parse_body(p))

    val body = result match
        Some(r) -> expr(checked.span, Ensures(checked, r.0, r.2))
        None -> checked

    accept_end_named(p, name)
    // **Restored, not merely compared**, so that a lambda written inside this body has already put
    // the count back and cannot make its enclosing definition look like a generator.
    val yielded = p.yields > outer_yields

    p.yields = outer_yields
    param_declares = declares
    stmt(start.to(p.just_taken()), Def(name, params, defaults, intern_body(body, yielded), is_async))
end parse_def

// `= expr` after a parameter, if it is there, and the refusal that keeps `defaults` trailing.
//
// **What is being kept true is that ONE number says how many arguments must be given.** A parameter
// with a default standing before one without could never actually be left out -- leaving it out
// would slide every later argument one place left -- so a language that allowed it would either
// have to say so at every call or quietly mean something other than what it reads as. Refusing it
// where it is written is the only answer that costs nobody anything.
//
// Not `private`: `expr.sysl` reads a lambda's parameters and wants the same rule.
read_default(p: *Parser, defaults: *Buf[Expr], named: string)
    val at = p.here()

    if p.accept(Assign)
        defaults.push(parse_expr(p))
        return

    if defaults.len() != 0
        p.fault(at, s"${named} has no default and comes after one that has -- a parameter that may be left out has to come last, or leaving it out would leave a gap the arguments after it cannot fill")
end read_default

// A parameter written as a pattern: a name nothing can collide with, and the statement that takes
// the argument apart under it.
//
// Not `private`: `expr.sysl` reads a lambda's parameters and wants the same desugar.
//
// **The desugar is the annotation's, and taking it was the whole of the work.** `p: Point` already
// becomes a `CheckType` at the top of the body, so `Def` and `Lambda` carry names and nothing else;
// a destructuring parameter becomes an `Unpack` in the same place, and the machine, the arity check,
// the checker and every pass downstream learn nothing. Reading it as a real pattern parameter would
// have meant a `Buf[Pattern]` on two nodes and a new case in everything that walks one.
//
// **The hidden name is unspellable on purpose.** A parameter list is a scope a program's own names
// go into, and a synthetic one that could be written would shadow -- or be shadowed by -- something
// a person wrote. `(0)` is not an identifier, so nothing can name it and nothing has to be reserved.
unpacked_param(p: *Parser, checks: *Buf[Stmt], index: usize) -> string
    val at = p.here()
    val pat = parse_pattern(p)
    val name = s"(${index})"

    checks.push(stmt(at.to(p.just_taken()), Unpack(pat, expr(at, Name(name)), true)))
    name
end unpacked_param

// A body with its parameters' checks run before it.
//
// **The body is left alone where nothing was annotated**, so an unannotated function is the same
// tree it always was and costs not one instruction more.
//
// Not `private`: a lambda's parameters may be patterns too, and `expr.sysl` wraps its body the same
// way.
with_checks(checks: Buf[Stmt], body: Expr) -> Expr
    if checks.len() == 0 then return body

    var stmts: Buf[Stmt] = buf()

    for i in 0..<checks.len()
        stmts.push(checks.at(i))

    // The body's own value is the function's, so it goes last and the checks are only statements.
    stmts.push(stmt(body.span, Eval(body)))
    expr(body.span, Block(stmts))
end with_checks

// An expression on its own, or an assignment to one -- to one place, or to several.
parse_expr_stmt(p: *Parser) -> Stmt
    val start = p.here()
    val target = parse_expr(p)

    // **A comma here can only be a multi-assignment**, since nothing below a statement admits a bare
    // comma. One target would be an ordinary assignment written the long way, so two is what commits.
    if p.at(Comma) then return parse_multi_assign(p, start, target)

    val op = assign_op(p)

    if op == Eof
        return stmt(start.to(p.just_taken()), Eval(target))

    val value = parse_body(p)

    if !assignable(target)
        p.fault(target.span, "this cannot be assigned to")

    stmt(start.to(p.just_taken()), Assign(op, target, value))
end parse_expr_stmt

// `a, b = b, a`, and the compound forms of it.
private parse_multi_assign(p: *Parser, start: Span, first: Expr) -> Stmt
    // **Read speculatively, and commit only on the `=`.** A comma after an expression is a
    // multi-assignment far more often than not, but it is also what a `match` written as a
    // non-final argument leaves behind -- and a rule that committed here would answer that with a
    // sentence about assignment, replacing the one diagnostic that says what is actually wrong.
    val m = p.toks.mark()
    var targets: Buf[Expr] = buf()

    targets.push(first)

    loop
        if !p.accept(Comma) then break

        targets.push(parse_expr(p))

    val op = assign_op(p)

    if op == Eof
        p.toks.reset(m)
        return stmt(start.to(p.just_taken()), Eval(first))

    var values: Buf[Expr] = buf()

    loop
        values.push(parse_expr(p))

        if !p.accept(Comma) then break

    for i in 0..<targets.len()
        if !assignable(targets.at(i))
            p.fault(targets.at(i).span, "this cannot be assigned to")

    if targets.len() != values.len()
        p.fault(start.to(p.just_taken()),
            s"this writes ${targets.len()} places and was given ${values.len()} values")

    stmt(start.to(p.just_taken()), MultiAssign(op, targets, values))
end parse_multi_assign

// The assignment operator at the cursor, consumed -- or `Eof` where there is not one.
//
// **`Assign` stands for the plain form and the arithmetic operator for a compound one**, so that
// `x += e` reaches the compiler as the operator it is rather than as a rewritten `x = x + e`. The
// difference that makes is that the place is evaluated once.
//
// `Eof` as the "none" answer rather than an `Option`, because every caller immediately compares.
private assign_op(p: *Parser) -> Tok
    if p.accept(Assign) then return Assign
    if p.accept(PlusEq) then return Plus
    if p.accept(MinusEq) then return Minus
    if p.accept(StarEq) then return Star
    if p.accept(SlashEq) then return Slash
    if p.accept(PercentEq) then return Percent
    if p.accept(AmpEq) then return Amp
    if p.accept(PipeEq) then return Pipe
    if p.accept(CaretEq) then return Caret
    if p.accept(ShlEq) then return Shl
    if p.accept(ShrEq) then return Shr

    Eof
end assign_op

// What may stand on the left of an `=`.
//
// The check is here rather than in the interpreter so that the tree handed on is one whose targets
// are known good, and so that the complaint points at the expression rather than at the moment it
// was evaluated.
private assignable(e: Expr) -> bool
    *e.kind match
        Name(_) -> true
        // **`o?.f = v` is refused**, there being no answer to what it should do when `o` is
        // nothing -- writing into absence is not a thing to do quietly, and JavaScript agrees.
        Field(_, _, optional) -> !optional
        Index(_, _) -> true
        _ -> false
end assignable

// -- bodies -------------------------------------------------------------------------------------

// A **value's** body: an indented block, or a single expression on the same line.
//
// **`=` is not consumed here.** A binding writes its own, and a construct whose body is a block has
// none, so the two are kept apart by their callers.
//
// This is what a binding and a function take. A *control-flow* body is the one below, and the
// difference is that it takes a statement.
parse_body(p: *Parser) -> Expr
    if p.at(Indent) then parse_block(p) else parse_expr(p)

// A control-flow construct's body: an indented block, or one statement after the introducer.
//
// **The one-line body is a STATEMENT, not an expression, and that is the whole reason this exists.**
// `if n > 2 then break` is the shape a loop is written in, and a `then` taking only an expression
// refuses it -- along with `then return x` and `then continue`. sysl's `body(keyword)` is
// `suite | inlineBody` where `inlineBody` is one statement, and this is that rule.
//
// **The introducer is required for a one-line body and optional before a block**, which is again
// sysl's: a following newline and indent already say unambiguously where the body is, so `while c`
// needs no `do` -- but `while c n = n + 1` would have nothing marking where the header stopped.
//
// Not `private`: `expr.sysl` gives `elif` its body.
parse_control_body(p: *Parser, intro: Tok) -> Expr
    if !p.accept(intro) then return parse_block(p)

    if p.at(Indent) then parse_block(p) else inline_stmt_body(p)

// One statement standing where a block would, wrapped as the block of one it is.
//
// Not `private`: `expr.sysl` gives `if`'s branches their one-line forms.
inline_stmt_body(p: *Parser) -> Expr
    p.depth += 1

    val s = parse_stmt(p)

    p.depth -= 1

    var one: Buf[Stmt] = buf()

    one.push(s)
    expr(s.span, Block(one))
end inline_stmt_body

// `end if`, `end while`, `end for`, `end loop` -- optional, and only where the construct's own word
// follows.
//
// **`end` stays a SOFT word**, which is what this shape is for: it is looked at rather than consumed
// until both tokens are known, so a program that names a variable `end` is untouched. Newlines are
// skipped over on the same terms -- looked past, and only stepped over once the marker is certain.
//
// Not `private`: `expr.sysl` closes an `if`.
accept_end(p: *Parser, word: Tok) -> bool
    var i: usize = 0

    while p.peek_kind_at(i) == Newline
        i += 1

    if p.peek_kind_at(i) != Ident then return false
    if p.peek_kind_at(i + 1) != word then return false
    if p.text_at(i) != "end" then return false

    for _ in 0..<(i + 2)
        p.bump()

    true
end accept_end

// A word that continues a construct from the line below it -- `elif`, `else`, and `while` closing a
// `do`. **Newlines are looked past and only stepped over once the word is certain**, so the newline
// that ends a statement is left alone where the construct really has ended. This is sysl's
// `onNextLine`.
//
// Not `private`: `expr.sysl` reads `elif` and `else` with it.
accept_on_next_line(p: *Parser, k: Tok) -> bool
    var i: usize = 0

    while p.peek_kind_at(i) == Newline
        i += 1

    if p.peek_kind_at(i) != k then return false

    for _ in 0..<(i + 1)
        p.bump()

    true
end accept_on_next_line

// `end <name>` after a function, which is the marker a declaration carries instead of a keyword.
private accept_end_named(p: *Parser, name: string) -> bool
    var i: usize = 0

    while p.peek_kind_at(i) == Newline
        i += 1

    if p.peek_kind_at(i) != Ident then return false
    if p.peek_kind_at(i + 1) != Ident then return false
    if p.text_at(i) != "end" then return false

    // **The name has to match**, so that a function ending with `end` and the next declaration's
    // name on the following line is not read as a marker.
    if p.text_at(i + 1) != name then return false

    for _ in 0..<(i + 2)
        p.bump()

    true
end accept_end_named

// An indented run of statements, whose value is its trailing expression.
//
// Not `private`, because `private` in sysl is private to the *file*: `expr.sysl` reads this to give
// a lambda and an `if` their indented forms.
parse_block(p: *Parser) -> Expr
    val start = p.here()

    if !p.expect(Indent, "an indented block")
        return expr(start, Bad)

    p.depth += 1

    val stmts = parse_stmts(p, true)

    p.depth -= 1

    p.expect(Dedent, "the end of the block")

    expr(start.to(p.just_taken()), Block(stmts))
end parse_block

// One identifier, or a complaint and an empty name.
// A key in an object literal, an object pattern or a `with`.
//
// **A key is a name, or a string where the key is not a name**, which is JavaScript's rule and
// Python's and JSON's. It is not two spellings of one thing: slate objects are keyed by any value at
// all, so `"a.b"`, `"if"` and `""` are perfectly ordinary keys that the literal syntax simply had no
// way to write. The printer has always emitted them quoted, so before this the printer could produce
// text the parser refused -- `print` of an object built by `parseJSON` being the ordinary way to see
// it.
//
// **A field ACCESS is deliberately not included.** `o."a.b"` is not accepted anywhere; a key that is
// not a name is reached with `o["a.b"]`, which slate has always had and which every language with
// this distinction uses.
parse_key(p: *Parser, want: string) -> string
    val at = p.here()

    if !p.at(StrLit) then return parse_name(p, want)

    p.bump()
    read_str_at(p, at)
end parse_key

// -- classes ---------------------------------------------------------------------------------------

// Whether what stands at `i` is `class Name`.
//
// **`class` is a SOFT word**, as `type` and `end` are, so a program may still call a variable
// `class`. Two tokens settle it: a bare name followed by another bare name begins nothing else in
// slate, there being no juxtaposition anywhere in the grammar.
at_class_decl(p: *Parser, i: usize) -> bool
    if p.peek_kind_at(i) != Ident then return false
    if p.text_at(i) != "class" then return false

    p.peek_kind_at(i + 1) == Ident
end at_class_decl

// Everything a class body is being gathered into.
//
// **A struct rather than a dozen pointers**, one loop filling all of it. The two halves are the whole
// design: `keys` is what the CLASS holds, shared by everything made from it, and `fields` is what each
// OBJECT holds, one per object.
private struct ClassBody
    keys: Buf[string]
    key_spans: Buf[Span]
    values: Buf[Expr]

    fields: Buf[string]
    field_spans: Buf[Span]
    inits: Buf[Expr]
    has_init: Buf[bool]

    // The `new` a program wrote, kept whole until the field list is complete -- a member may declare a
    // field below the constructor that reads it.
    maker_at: Span
    maker_params: Buf[string]
    maker_defaults: Buf[Expr]
    maker_declares: Buf[bool]
    maker_body: usize
    has_maker: bool
end ClassBody

// The name a constructor holds the object under while it is being made.
//
// **Unspellable on purpose**, for the reason a destructured parameter's is: the names in a body are
// the program's, and a synthetic one that could be written would shadow something a person wrote.
private const Made: string = "(new)"

// `class Square from Shape`, and the members written under it.
//
// **Most of it is sugar over the object a program could already write.** `class` binds a `val` to an
// object literal, `from` is the `proto` field, and a method is a field holding a function -- so the
// checker, the compiler, the machine and `show_program` are handed the object, and the receiver rule
// that was already there does the dispatch.
//
// **What the sugar buys is a method written in slate's ordinary definition syntax.** A field's value
// is an expression, so a method in a literal is a lambda and its body is whatever fits after `->`; a
// definition's body may be an indented run of statements. That is the difference between a class of
// twenty methods reading like twenty functions and reading like twenty fields.
//
// **The two words carry the distinction that bites.** `val` is the class's, one of it however many
// objects there are; `var` is each object's, and its initialiser runs once per object. Reading them
// the other way round is Python's oldest trap -- a mutable default shared by every instance -- and
// here the words say which is which.
//
// **A class also gives slate its one NOMINAL identity**, which is why the name is registered as a
// type: `p is Square` asks whether this object was made from that class, which no structural pattern
// can ask and which `p.proto == Square` gets wrong twice over -- `==` on objects is deep, so it
// answers true for any class holding the same fields, and it looks only one link up the chain.
parse_class_decl(p: *Parser, public: bool) -> Stmt
    val start = p.here()
    val top = p.depth == 0

    p.bump()

    val name = parse_name(p, "a name for the class")

    var b = ClassBody(buf(), buf(), buf(), buf(), buf(), buf(), buf(), start, buf(), buf(), buf(), 0, false)

    // **`from` takes an EXPRESSION rather than a name**, because the field it becomes takes one: a
    // base may arrive under an import alias, out of a module object, or be chosen at run time. The
    // word is soft here too -- it is the same `from` an import already reads.
    if p.at(Ident) && p.text(p.here()) == "from"
        val at = p.here()

        p.bump()
        b.keys.push("proto")
        b.key_spans.push(at)
        b.values.push(parse_expr_before_is(p))

    // **`is Drawable` is TypeScript\'s `implements`, and it is a promise rather than an inheritance.**
    // `from` gives a class its behaviour; this gives it nothing at all and only checks -- so a class
    // may promise as many types as it likes and descend from one.
    var promised: Buf[string] = buf()
    var promises: Buf[Pattern] = buf()

    if p.accept(Is)
        loop
            promised.push(if p.at(Ident) then p.text(p.here()) else "")
            promises.push(parse_pattern(p))

            if !p.accept(Comma) then break

    if p.at(Indent) then class_members(p, name, &b)

    accept_end_named(p, name)

    val span = start.to(p.just_taken())

    make_constructor(p, name, &b, span)

    if !top
        p.fault(start, "a class belongs to the top level of a file -- its name is a type as well as a value, and one declared inside a block would not be there for `is` to resolve against")
    else
        p.type_names.push(name)
        p.type_pats.push(pattern(span, ProtoPat(name)))
        p.type_public.push(public)

    val made = expr(span, ObjectLit(b.keys, b.key_spans, b.values))

    if promises.len() == 0 then return stmt(span, Val(name, made))

    // **The object is bound UNDER THE CLASS\'S OWN NAME inside a block, checked there, and answered.**
    // Naming the temporary after the class is the whole trick: `CheckType` reads the name out of the
    // scope and puts it in its complaint, so what a reader gets is *"`Square` was declared Drawable,
    // and was given ..."* rather than a sentence about an unspellable binding. The block\'s value is
    // the object, which the outer `val` binds where the class really lives.
    var checked: Buf[Stmt] = buf()

    checked.push(stmt(span, Val(name, made)))

    for i in 0..<promises.len()
        checked.push(stmt(promises.at(i).span, CheckType(name, promised.at(i), promises.at(i))))

    checked.push(stmt(span, Eval(expr(span, Name(name)))))

    stmt(span, Val(name, expr(span, Block(checked))))
end parse_class_decl

// The members under a class, which are slate's ordinary declarations.
private class_members(p: *Parser, cls: string, b: *ClassBody)
    p.expect(Indent, "an indented block")

    p.depth += 1
    p.skip_newlines()

    loop
        if p.at(Eof) then break
        if p.at(Dedent) then break

        one_member(p, cls, b)

        if !p.end_of_statement()
            p.fault(p.here(), "this is where the member should have ended")
            p.bump()

        p.skip_newlines()
    end loop

    p.depth -= 1
    p.expect(Dedent, "the end of the class")
end class_members

// Whether a class already has something under this name, on either side.
//
// **A member written twice is refused rather than won by the last one.** An object literal lets a
// later key win, which is right for data assembled from parts; a class body is one declaration a
// person sat down and wrote, and two of a name in it are a mistake nobody meant and that nothing else
// would ever report. The two halves share one namespace because an object reaches both through the
// same `.`, so a field and a method of one name would be one of them and silently not the other.
private taken_name(b: *ClassBody, name: string) -> bool
    for i in 0..<b.keys.len()
        if b.keys.at(i) == name then return true

    for i in 0..<b.fields.len()
        if b.fields.at(i) == name then return true

    false
end taken_name

// One member: a `var` field, a `val` the class holds, or a definition.
private one_member(p: *Parser, cls: string, b: *ClassBody)
    val at = p.here()

    if p.at(Var)
        p.bump()

        val name_at = p.here()
        val fname = parse_name(p, "a name for the field")
        val named = name_at.to(p.just_taken())
        val init = if p.accept(Assign) then Some(parse_body(p)) else None

        if taken_name(b, fname)
            p.fault(named, s"`${fname}` is given twice in class `${cls}`")
            return
        end if

        declare_field(b, fname, named, init)
        return
    end if

    if p.at(Val)
        p.bump()

        val name_at = p.here()
        val vname = parse_name(p, "a name for the member")
        val named = name_at.to(p.just_taken())

        p.expect(Assign, "`=` and a value")

        val value = parse_body(p)

        // **A mutable literal here is refused, and the message names the fix.** One `val` serves every
        // object the class makes, so an array or an object written under it is pushed to and written
        // into by all of them at once -- which is what a reader coming from TypeScript, where `items =
        // []` is per-instance, will least expect. Refusing only a LITERAL is deliberate: a shared
        // object bound outside the class and named here is sharing somebody asked for.
        *value.kind match
            ArrayLit(_) -> shared_mutable(p, cls, vname, named)
            ArrayRepeat(_, _) -> shared_mutable(p, cls, vname, named)
            ObjectLit(_, _, _) -> shared_mutable(p, cls, vname, named)
            _ -> ()

        if taken_name(b, vname)
            p.fault(named, if vname == "proto" then s"class `${cls}` says `from` and also gives a `proto`, and those are the same field -- keep whichever says it better" else s"`${vname}` is given twice in class `${cls}`")
            return
        end if

        b.keys.push(vname)
        b.key_spans.push(named)
        b.values.push(value)
        return
    end if

    if !(p.at(Async) && at_definition_from(p, 1) || at_definition_from(p, 0))
        p.fault(at, "a class body holds definitions, `val`s and `var`s -- a method is written `area(self) = self.side * self.side`, a field each object gets `var side`, and a value the class itself carries `val kind = \"square\"`")
        parse_expr_stmt(p)
        return
    end if

    // **`var` in a parameter list is legal here and nowhere else**, so the gate is opened around the
    // constructor and shut again whatever the read turns up.
    val naming = if p.at(Async) then p.text_at(1) else p.text_at(0)
    val outer = allow_declaring_params

    allow_declaring_params = naming == "new"

    val s = parse_def(p)
    val declares = param_declares

    allow_declaring_params = outer

    *s.kind match
        Def(name, params, defaults, body, is_async) ->
            if taken_name(b, name)
                p.fault(s.span, s"`${name}` is given twice in class `${cls}`")
                return
            end if

            if name != "new"
                b.keys.push(name)
                b.key_spans.push(s.span)
                b.values.push(expr(s.span, Lambda(params, defaults, body, is_async)))
                return
            end if

            if is_async
                p.fault(s.span, s"a constructor cannot be `async` -- `new` answers the object, and an `async` one would answer a promise with the object still to come. Give class `${cls}` an ordinary `new` and let a caller await whatever it needs")

            b.maker_at = s.span
            b.maker_params = params
            b.maker_defaults = defaults
            b.maker_declares = declares
            b.maker_body = body
            b.has_maker = true

            for i in 0..<params.len()
                if declares.at(i)
                    if taken_name(b, params.at(i))
                        p.fault(s.span, s"`${params.at(i)}` is given twice in class `${cls}`")
                    else
                        declare_field(b, params.at(i), s.span, None)
        _ -> ()
end one_member

private declare_field(b: *ClassBody, name: string, at: Span, init: Option[Expr])
    b.fields.push(name)
    b.field_spans.push(at)

    init match
        Some(e) ->
            b.inits.push(e)
            b.has_init.push(true)
        None ->
            b.inits.push(expr(at, NullLit))
            b.has_init.push(false)
end declare_field

private shared_mutable(p: *Parser, cls: string, name: string, at: Span)
    p.fault(at, s"`${name}` is a `val`, so class `${cls}` holds one of it and every object made from the class shares that one -- an array or an object written here is pushed to and written into by all of them at once. Write `var ${name} = ...` for one per object, or bind it outside the class where the sharing is what was meant")

// The object a constructor answers: every declared field it can fill, and the class as its proto.
//
// **The initialiser is the EXPRESSION, put here rather than evaluated once**, which is the whole of
// what `var` buys over `val`: `var tags = []` gives every object its own array, and the same words
// under `val` would have given them all one.
//
// `assigned` names the fields a parameter supplies. Anything else with an initialiser takes it, and a
// field with neither is simply absent -- which is what a dynamically typed language has instead of
// TypeScript's definite-assignment check, and it faults at the first read rather than at the make.
//
// **A generated constructor names every field, so that middle case is a written `new(var w, var h)`
// and nothing else**: there, the fields the parameter list did not name are filled from their own
// declarations. A generated one carries each initialiser as that parameter's default instead, which
// runs in the head of the chunk and is the same expression evaluated the same number of times.
private instance_of(cls: string, b: *ClassBody, assigned: Buf[string], at: Span) -> Expr
    var keys: Buf[string] = buf()
    var key_spans: Buf[Span] = buf()
    var values: Buf[Expr] = buf()

    for i in 0..<b.fields.len()
        val f = b.fields.at(i)
        var taken = false

        for j in 0..<assigned.len()
            if assigned.at(j) == f then taken = true

        if taken
            keys.push(f)
            key_spans.push(b.field_spans.at(i))
            values.push(expr(b.field_spans.at(i), Name(f)))
        elif b.has_init.at(i)
            keys.push(f)
            key_spans.push(b.field_spans.at(i))
            values.push(b.inits.at(i))

    keys.push("proto")
    key_spans.push(at)
    values.push(expr(at, Name(cls)))

    expr(at, ObjectLit(keys, key_spans, values))
end instance_of

// The `new` a class ends up with: the one it wrote, or the one its field declarations imply.
private make_constructor(p: *Parser, cls: string, b: *ClassBody, at: Span)
    if !b.has_maker
        // **A class that declares nothing gets no constructor**, rather than one answering an object
        // with nothing in it. `{ proto: Square }` compiles, runs, and faults later at the first field
        // nobody set, which moves the complaint away from the mistake -- and `{ side: 4, proto: Square }`
        // is still how such a class is instantiated, exactly as it was before classes existed.
        if b.fields.len() == 0 then return

        // **Every declared field is a parameter: the ones with no initialiser first, then the ones
        // with, each carrying its initialiser as its default.** A field the class gives a value may
        // therefore be given another one at the call, which is what `Box.new(7, ["a"])` reads as in
        // every language that has this; and leaving it out means exactly what it meant before, since
        // a default is worked out at the call and so runs once per object.
        //
        // **Where an initialised field was declared first, the parameter order is NOT the declaration
        // order**, a default having to be trailing: `var kind = "plain"` above `var side` gives
        // `new(side, kind = "plain")`. The alternative was to refuse that class the way Python
        // refuses the same shape in a dataclass, which would break classes that compile today to buy
        // a rule nobody asked for.
        //
        // **An initialiser may read a field to its left in that order**, because the defaults are
        // bound in order like any others -- so `var w` then `var area = w * w` works, and did not
        // before.
        var params: Buf[string] = buf()
        var defaults: Buf[Expr] = buf()

        for i in 0..<b.fields.len()
            if !b.has_init.at(i) then params.push(b.fields.at(i))

        for i in 0..<b.fields.len()
            if b.has_init.at(i)
                params.push(b.fields.at(i))
                defaults.push(b.inits.at(i))

        add_maker(b, at, params, expr(at, Lambda(params, defaults, intern_body(instance_of(cls, b, params, at), false), false)))
        return
    end if

    var assigned: Buf[string] = buf()

    for i in 0..<b.maker_declares.len()
        if b.maker_declares.at(i) then assigned.push(b.maker_params.at(i))

    if assigned.len() != 0
        // `new(var side)`: the object is made from the declarations, and the body runs for its effect
        // with `self` bound to what is being made. That is TypeScript's constructor, and it is the
        // one shape where a body has an object to talk about -- an ordinary `new` is called before
        // there is one, which is why it is handed no receiver.
        var stmts: Buf[Stmt] = buf()

        stmts.push(stmt(b.maker_at, Val(Made, instance_of(cls, b, assigned, b.maker_at))))
        stmts.push(stmt(b.maker_at, Val("self", expr(b.maker_at, Name(Made)))))
        stmts.push(stmt(b.maker_at, Eval(body_at(b.maker_body))))
        stmts.push(stmt(b.maker_at, Eval(expr(b.maker_at, Name(Made)))))

        add_maker(b, b.maker_at, b.maker_params, expr(b.maker_at, Lambda(b.maker_params, b.maker_defaults, intern_body(expr(b.maker_at, Block(stmts)), false), false)))
        return
    end if

    if b.fields.len() != 0
        p.fault(b.maker_at, s"class `${cls}` declares fields with `var`, so its `new` has to name the ones it takes -- `new(var ${b.fields.at(0)})` declares and assigns in one place, and the rest are filled from their own declarations. A `new` that builds the object itself leaves nothing to fill them")

    // The plain form, which is what a class with no declared fields has: the body's value is the
    // object, and it is given the class as its proto on the way out. **It is written to rather than
    // copied** -- `with` would have said the same thing in one node and allocated a second object for
    // every instance, on the one path where allocation is measured.
    var stmts: Buf[Stmt] = buf()

    stmts.push(stmt(b.maker_at, Val(Made, body_at(b.maker_body))))
    stmts.push(stmt(b.maker_at, Assign(Tok.Assign, expr(b.maker_at, Field(expr(b.maker_at, Name(Made)), "proto", false)), expr(b.maker_at, Name(cls)))))
    stmts.push(stmt(b.maker_at, Eval(expr(b.maker_at, Name(Made)))))

    add_maker(b, b.maker_at, b.maker_params, expr(b.maker_at, Lambda(b.maker_params, b.maker_defaults, intern_body(expr(b.maker_at, Block(stmts)), false), false)))
end make_constructor

private add_maker(b: *ClassBody, at: Span, params: Buf[string], value: Expr)
    b.keys.push("new")
    b.key_spans.push(at)
    b.values.push(value)
end add_maker

parse_name(p: *Parser, want: string) -> string
    val at = p.here()

    if !p.at(Ident)
        p.report.add(expected(at, want, p.found(at)))
        return ""

    p.bump()
    p.text(at)
end parse_name
