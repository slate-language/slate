module dev.slatelang.slate
@tests

import sysl.text.Search

// `slate:crypto`'s Argon2id -- the one hash in that module meant to be slow.
//
// **Every test here that hashes pays the real cost**, which is 19 MiB and two passes, because that
// is the algorithm and a test that skipped it would be testing the string format alone. So the ones
// that can be written against a record made by hand are: `argon2NeedsRehash` and both refusals parse
// the record and never derive anything from it.

// A well-formed record nothing here made, for the tests that need a record rather than a password.
// Sixteen bytes of `0x02` and thirty-two of `0x03`, base64 without padding, which is the format's
// one idiosyncrasy.
private val AWeakRecord: string =
    "$argon2id$v=19$m=8,t=1,p=1$AgICAgICAgICAgICAgICAg$AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM"

// The same record claiming just under four gibibytes of working memory.
private val AGreedyRecord: string =
    "$argon2id$v=19$m=4000000,t=2,p=1$AgICAgICAgICAgICAgICAg$AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM"

@test
A_PASSWORD_VERIFIES_AGAINST_ITS_OWN_RECORD_AND_NOTHING_ELSE()
    // The round trip, and the whole of what a login does.

    val text = "val stored = await argon2(\"correct horse\")\nprint(await argon2Verify(stored, \"correct horse\"))\nprint(await argon2Verify(stored, \"correct horsf\"))\n"

    assert_eq(pw_out(text), "true\nfalse")

@test
TWO_RECORDS_OF_ONE_PASSWORD_DIFFER_BECAUSE_THE_SALT_IS_FRESH()
    // **A fresh sixteen bytes of kernel randomness per call**, which is why hashing one password
    // twice gives two different records and both of them verify. A salt that repeated would let one
    // precomputed table break every account at once, and two identical records would say at a glance
    // which users share a password.

    val text = "val a = await argon2(\"same\")\nval b = await argon2(\"same\")\nprint(a == b)\nprint(await argon2Verify(a, \"same\"), await argon2Verify(b, \"same\"))\n"

    assert_eq(pw_out(text), "false\ntrue true")

@test
A_RECORD_SAYS_WHAT_IT_WAS_MADE_WITH()
    // **The parameters travel inside the string**, which is what lets them be raised later without
    // invalidating a single existing password. Six fields, the first empty because the record begins
    // with the separator.

    val text = "val stored = await argon2(\"x\")\nprint(startsWith(stored, \"$argon2id$v=19$m=19456,t=2,p=1$\"))\nprint(split(stored, \"$\").length)\n"

    assert_eq(pw_out(text), "true\n6")

@test
argon2NeedsRehash_ANSWERS_AGAINST_WHAT_A_CALL_WRITES_TODAY()
    // **This is how parameters are raised.** A record made with eight blocks is below what the
    // defaults write and one just made is not -- so a server asks after a successful verify, while
    // the plaintext is still in hand, and re-hashes the ones that answer `true`.

    val text = "print(argon2NeedsRehash(\"" + AWeakRecord + "\"))\nprint(argon2NeedsRehash(await argon2(\"x\")))\n"

    assert_eq(pw_out(text), "true\nfalse")

@test
THE_PARAMETERS_ARE_A_RECORD_AND_THE_HEAVY_PROFILE_IS_TWO_OF_THEM()
    // 64 MiB and three passes, for something hashed rarely and worth more than a session: a
    // key-encrypting key, a recovery code, a root credential. **It is two numbers rather than a
    // second name**, because once the numbers are parameters at all, a name for one particular pair
    // of them is a second way to say the same thing.
    //
    // **And `argon2NeedsRehash` has to be told the same numbers**, or a server on 64 MiB would be
    // measuring its own records against 19 and told every one of them was fine.

    val text =
        "val heavy = { memoryCost: 65536, timeCost: 3 }\n" +
        "val stored = await argon2(\"root\", heavy)\n" +
        "print(startsWith(stored, \"$argon2id$v=19$m=65536,t=3,p=1$\"))\n" +
        "print(await argon2Verify(stored, \"root\"), argon2NeedsRehash(stored, heavy))\n"

    assert_eq(pw_out(text), "true\ntrue false")

@test
A_GIVEN_SALT_MAKES_THE_RECORD_REPRODUCIBLE()
    // **The one parameter here that is a footgun, and it is accepted anyway** -- a published test
    // vector and a record being reproduced from another implementation both need it, and there would
    // otherwise be no way to say either. The whole point of the default is that this is NOT it.
    //
    // **The vector is the record itself**, which is what makes this a test of the derivation rather
    // than of the format: the bytes after the last separator are Argon2id's answer for this password,
    // this salt and these parameters, and nothing in slate could produce them by accident.

    val text =
        "val a = await argon2(\"correct horse\", { salt: \"slatefixedsalt16\" })\n" +
        "print(a)\n" +
        "print(a == await argon2(\"correct horse\", { salt: \"slatefixedsalt16\" }))\n"

    assert_eq(pw_out(text),
        "$argon2id$v=19$m=19456,t=2,p=1$c2xhdGVmaXhlZHNhbHQxNg$AHKqLZu6JLVdr2IcuZSTe+WL/ssowvLUCAhCNFmYOek\ntrue")

@test
THE_SHORTER_TAG_AND_THE_SECOND_LANE_TRAVEL_IN_THE_RECORD_TOO()
    // `hashLength` and `parallelism` are the other two, and both are read back out of the record by
    // `argon2Verify` rather than being remembered anywhere.

    val text =
        "val stored = await argon2(\"pw\", { hashLength: 16, parallelism: 2, memoryCost: 32 })\n" +
        "print(startsWith(stored, \"$argon2id$v=19$m=32,t=2,p=2$\"))\n" +
        "print(split(stored, \"$\")[5].length)\n" +
        "print(await argon2Verify(stored, \"pw\"), await argon2Verify(stored, \"no\"))\n"

    assert_eq(pw_out(text), "true\n22\ntrue false")

@test
A_RECORD_THAT_IS_NOT_A_RECORD_IS_A_FAULT_AND_NOT_A_FAILED_LOGIN()
    // **THE ONE CONFUSION A LOGIN PATH MUST NOT HAVE.** A wrong password is `false` and a stored
    // record that will not parse is a fault, because the second is a defect in whatever wrote the
    // column -- collapsing them would make a corrupted row read as an intruder, and the server would
    // answer 401 to a user whose password was right.

    assert(pw_fails("print(await argon2Verify(\"hello\", \"x\"))").contains("is not an Argon2 record"))
    assert(pw_fails("print(argon2NeedsRehash(\"hello\"))").contains("is not an Argon2 record"))
    assert(pw_fails("print(await argon2Verify(\"\", \"x\"))").contains("is not an Argon2 record"))

@test
THE_TWO_ARGUMENTS_THE_OTHER_WAY_ROUND_ARE_CAUGHT_RATHER_THAN_ANSWERED_false()
    // **Both arguments are text, so a swap would answer `false` forever and never say why.** It is
    // the one mistake this surface can make silently -- node's bcrypt takes the password first and
    // this takes the record first -- so a second argument that *is* a record while the first is not
    // can only be the pair the other way round, and it is named rather than counted as a bad login.

    val text = "val stored = await argon2(\"pw\")\nprint(await argon2Verify(\"pw\", stored))\n"

    assert(pw_fails(text).contains("takes the stored record first and the password second"))

@test
A_RECORD_ASKING_FOR_MORE_MEMORY_THAN_ANY_REAL_ONE_IS_REFUSED()
    // **A record names its own memory cost and this program allocates what it names**, so one that
    // arrived from somewhere it should not have could ask for every byte the machine has. The
    // ceiling is a gibibyte, far above the 64 MiB the heaviest recommendation reaches and far below
    // what would take the process down.

    val said = pw_fails("print(await argon2Verify(\"" + AGreedyRecord + "\", \"x\"))")

    assert(said.contains("3906 MiB"))
    assert(said.contains("more than any real Argon2 parameter reaches"))

@test
A_PARAMETER_THAT_IS_NOT_ONE_IS_REFUSED_RATHER_THAN_IGNORED()
    // **The worst shape this mistake has is a login that was thought to have been strengthened and
    // was not**, which is why an unknown key is a complaint rather than a key nobody read.
    //
    // The bounds are refusals too. A `memoryCost` below `8 * parallelism` is a parameter set Argon2
    // itself will not run, and one above a gibibyte is the ceiling above said from the other end.

    assert(pw_fails("await argon2(\"x\", { memoryCosts: 65536 })")
        .contains("`memoryCosts` is not one of `argon2`'s parameters -- there are `memoryCost`, `timeCost`, `parallelism`, `hashLength` and `salt`"))
    assert(pw_fails("await argon2(\"x\", { memoryCost: 4 })").contains("`memoryCost` runs from 8 to 1048576 and this is 4"))
    assert(pw_fails("await argon2(\"x\", { timeCost: 0 })").contains("`timeCost` runs from 1 to 4294967295 and this is 0"))
    assert(pw_fails("await argon2(\"x\", { hashLength: 3 })").contains("`hashLength` runs from 4 to 64 and this is 3"))
    assert(pw_fails("await argon2(\"x\", { memoryCost: \"lots\" })").contains("`memoryCost` is a whole number, and this is a string"))
    assert(pw_fails("await argon2(\"x\", { salt: \"short\" })").contains("an Argon2 salt is between 8 and 32 bytes, and this is 5"))
    assert(pw_fails("await argon2(\"x\", { salt: 7 })").contains("`salt` is text or bytes, and this is an integer"))
    assert(pw_fails("await argon2(\"x\", 65536)").contains("`argon2` takes its parameters as a record, and this is an integer"))

@test
THE_THREE_NAMES_SAY_WHAT_THEY_TAKE()
    // The ordinary arity and type complaints, which are the ones a person actually meets.

    assert(pw_fails("argon2()").contains("`argon2` takes a password and, if it is not to use the defaults, its parameters -- and was given 0 arguments"))
    assert(pw_fails("argon2(42)").contains("`argon2` takes the password as text, and this is an integer"))
    assert(pw_fails("argon2(\"a\", {}, 1)").contains("`argon2` takes a password and, if it is not to use the defaults, its parameters -- and was given 3 arguments"))
    assert(pw_fails("argon2Verify(\"a\")").contains("`argon2Verify` takes a stored record and a password, and was given 1 argument"))
    assert(pw_fails("argon2NeedsRehash()").contains("`argon2NeedsRehash` takes a stored record and, if they are not the defaults, the parameters to measure it against -- and was given 0 arguments"))

@test
A_SERVER_ANSWERS_SOMEBODY_ELSE_WHILE_IT_IS_HASHING()
    // **THIS IS THE CLAIM THE THREAD POOL IS FOR, AND IT COST TWO TESTS TO STATE HONESTLY.**
    //
    // The first version served two requests and asserted the fast one finished first. It passed --
    // and it passed just as well against a build that derived on the loop, which is what a NEGATIVE
    // CONTROL said and reading never would have. The reason is that `await` suspends either way, so
    // an ordering between two handlers says nothing about where the work happened: the loop is free
    // once the blocking call has RETURNED, and the slow handler is waiting on a round trip by then
    // whichever way it was run.
    //
    // **What actually differs is how long the loop is blocked, so that is what this counts.** A
    // repeating timer at 10 ms across a 64 MiB derivation ticks dozens of times where the loop is
    // free and cannot tick at all where it is not. It is not a duration being pinned -- the
    // assertion is "more than five", against an expectation near thirty and a blocked build's zero,
    // which is a margin a loaded machine cannot close.

    val body =
        "var ticks = 0\n" +

        // **A lambda's one-line body is an EXPRESSION, so an assignment cannot be one** -- a rule of
        // slate's that gets rediscovered every time one of these programs is written.
        "tick()\n" +
        "    ticks = ticks + 1\n" +
        "async main()\n" +
        "    val clock = setInterval(tick, 10)\n" +
        "    await argon2(\"a password worth waiting for\", { memoryCost: 65536, timeCost: 3 })\n" +
        "    clearInterval(clock)\n" +
        "    print(ticks > 5)\n" +
        "    done()\n" +
        "main()\n"

    assert_eq(ticking_out(body), "true")
end A_SERVER_ANSWERS_SOMEBODY_ELSE_WHILE_IT_IS_HASHING
