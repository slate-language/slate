module dev.slatelang.slate

import sh.sysl.parsing.*
import sh.sysl.libwebp
import sh.sysl.stb
import sysl.buf.{Buf, buf}

// Images -- what a site that takes photographs and avatars from the people using it needs, and no
// more than that.
//
// **Six names: `readImage`, `imageShape`, `resizeImage`, `encodePNG`, `encodeJPEG` and
// `encodeWebP`.** Most of that is bound over `sh.sysl.stb`, which carries Sean Barrett's
// `stb_image`, `stb_image_write` and `stb_image_resize2` as vendored headers -- so those need
// nothing installed. WebP is the exception and is `sh.sysl.libwebp`, over an installed libwebp.
//
// ## An image is a RECORD, and that is what makes the six compose
//
// `{ width, height, channels, pixels }`, where `pixels` is a byte array of `width * height *
// channels` -- rows packed, top row first, and the channels interleaved. `readImage` answers one,
// `resizeImage` takes one and answers one, and the three encoders take one. So a thumbnail is
// `encodeJPEG(resizeImage(readImage(upload).value, 200, 200), 80)` and nothing in the middle is a
// handle a program has to give back.
//
// **The alternative was an opaque handle**, which is what every handle in slate already is and is
// what `sh.sysl.stb` hands its own callers -- and it is wrong here. The pixels are the *point*: a
// program wants to look at them, store them, send them, or build one itself and encode it. An
// image behind a handle would need a reader, a writer and a maker before it could do any of that,
// and the record needs none.
//
// ## Which formats, and which library reads each
//
// **PNG, JPEG, GIF and WebP in; PNG, JPEG and WebP out.** stb reads six more -- BMP, TGA, PSD, PIC,
// PNM and Radiance -- and they arrive here for free, the format being recognised from the bytes
// rather than from anything the caller says. A GIF decodes to its **first frame**; there is no
// animation, which is stb's own line.
//
// **WebP IS THE ONE FORMAT THAT IS NOT stb's**, and it had to be bound separately: WebP is VP8 in a
// RIFF container, a video codec's worth of code, which is exactly what stb is not. It is worth the
// dependency because it is what a modern browser writes -- a phone's photograph re-encoded by a
// page before upload is usually WebP, so without it the commonest upload a form meets is the one
// `readImage` refuses.
//
// **The twelve-byte RIFF header is what routes a file**, read by `libwebp.is_webp` before stb is
// asked anything: WebP is the one format here whose decoder is chosen rather than found, because
// stb would answer *unknown image type* and there would be nothing left to try. Everything else
// still reaches stb, which recognises its own.
//
// **AN ANIMATED WebP IS REFUSED AND SAYS WHY.** Its frames live in `ANMF` chunks that only
// `libwebpdemux` -- a second library with a second `pkg-config` name -- knows how to walk, so
// `readImage` and `imageShape` both answer libwebp's own sentence rather than a decode failure. A
// GIF's first frame and a WebP animation are deliberately different answers: stb reads the first
// frame of one and nothing here reads any frame of the other.
//
// ## The two channels, exactly as JSON and brotli draw them
//
// **`readImage` and `imageShape` answer a result and the other four fault.** Bytes that came from
// somewhere else -- an upload, a file, a request body -- are not a defect in the program reading
// them, so a corrupt JPEG is a `400` to answer rather than something to catch. The four that take
// an image already hold a value the program built, so a mismatched shape or a width of zero is a
// mistake in the program and faults where it is written.
//
// ## The size guard is `imageShape`, and it is why that name exists
//
// A decoded image is `width * height * channels` bytes however small the file was, and a PNG of a
// few kilobytes can say it is 20,000 by 20,000 -- 1.2 GB of pixels from a request body nobody
// looked at. `imageShape` reads that out of the header without decoding anything, which is the same
// job `unzstd`'s limit does for a compression bomb and is the call to make before `readImage` on
// anything that arrived over a socket.

// -- reading what a program handed over ------------------------------------------------------------

// The bytes of an image. **Text is refused rather than taken as UTF-8**, which is where this differs
// from `zstd` and `compress`: those two encode text a program is holding, and no string anybody
// writes is a PNG. A caller with a string of bytes has `toBytes`.
private image_source(v: Value, at: Span, name: string) -> Result[Buf[u8], Signal]
    v match
        Array(a) -> bytes_of(a, at, name)
        other -> Err(failure(at, s"`${name}` takes the bytes of an image, and this is ${other.type_name()}"))

private image_whole(v: Value, at: Span, name: string, what: string) -> Result[long, Signal]
    v match
        Int(n) -> Ok(n)
        other -> Err(failure(at, s"`${name}` takes ${what} as a whole number, and this is ${other.type_name()}"))

// How many channels a decode should answer, as the count a caller writes.
//
// **`readImage(bytes)` converts nothing and `readImage(bytes, 4)` converts to RGBA**, which is the
// call an avatar pipeline makes: a page's uploads are greyscale, RGB and RGBA in whatever mixture
// the people using it happened to have, and code that composites or scales them wants one shape.
private image_channels(n: long, at: Span) -> Result[stb.Channels, Signal] =
    n match
        1 -> Ok(stb.Channels.Grey)
        2 -> Ok(stb.Channels.GreyAlpha)
        3 -> Ok(stb.Channels.Rgb)
        4 -> Ok(stb.Channels.Rgba)
        other -> Err(failure(at, s"an image has 1 to 4 channels -- grey, grey and alpha, RGB, RGBA -- and this is ${other}"))

// How `resize` is to read the channels it is handed. **A layout is not a count**, which is the trap
// `sh.sysl.stb`'s own `Layout` exists to close, so the number is turned into one here rather than
// passed through.
private image_layout(channels: long, at: Span) -> Result[stb.Layout, Signal] =
    channels match
        1 -> Ok(stb.Layout.Grey)
        2 -> Ok(stb.Layout.GreyAlpha)
        3 -> Ok(stb.Layout.Rgb)
        4 -> Ok(stb.Layout.Rgba)
        other -> Err(failure(at, s"an image has 1 to 4 channels, and this says ${other}"))

// What a decode, an encode or a resize objected to, as a sentence.
//
// **`Refused` carries stb's own words and they are passed through** -- *unknown image type*, *bad
// png sig*, *outofdata* -- because each says more than any paraphrase of it would, and they say
// different things to whoever sent the bytes.
//
// **An EMPTY reason is a real answer from stb and gets the sentence without the colon.** A PNG cut
// short in its chunk header has its four type bytes read past the end, and stb builds the reason out
// of the bytes it did get -- so a cut landing on a zero leaves the string empty, and a dangling
// colon would send the reader looking for the missing half of a message that has none.
private why_not_image(e: stb.Error) -> string = e match
    stb.Error.Refused(why) ->
        if why == "" then "this image could not be read" else s"this image could not be read: ${why}"
    stb.Error.TooLarge -> "this is larger than the image decoder can be told about"
    stb.Error.NoMemory -> "there was not enough memory to decode this image"
    stb.Error.Shape(needed) -> s"the pixels do not match the dimensions -- ${needed} bytes were needed"
    other -> "this image could not be read"

// What libwebp objected to, as a sentence.
//
// **libwebp's own words are passed through whole rather than being wrapped**, which is the same
// judgement `Refused` above makes about stb's: they are complete sentences and each says something
// different to whoever sent the bytes -- *the WebP data stops before the image does* is a partial
// upload to retry, where *the WebP image data is damaged* is not. The animation sentence names the
// library that would be needed to read one, which is the only useful thing anybody can be told
// about it.
private why_not_webp(e: libwebp.Error) -> string = e.message()

// -- the channels a WebP has and the channels a caller asked for -------------------------------------

// One grey channel from three colour ones, by `stb_image`'s own weights.
//
// **77, 150 and 29 over 256**, which is `stbi__compute_y`. A second set of weights here would make
// `readImage(upload, 1)` mean one thing for a PNG and another for a WebP, and which one a caller
// got would depend on what somebody happened to upload.
private grey_of(r: u8, g: u8, b: u8) -> u8 = u8((int(r) * 77 + int(g) * 150 + int(b) * 29) >> 8)

// The same pixels at another channel count, following `stb_image`'s `stbi__convert_format`.
//
// **libwebp decodes to three channels or four and to nothing else**, WebP having no greyscale mode
// at all, so one and two are reached by converting what came back. An added alpha is opaque and a
// dropped one is dropped rather than composited, both of which are what stb does.
private converted(px: []const u8, from: usize, to: usize) -> []u8
    val count = px.len / from
    var dst: []u8 = [u8(0); count * to]

    for i in 0..<count
        val s = i * from
        val d = i * to
        val r = px[s]
        val g = if from >= 3 then px[s + 1] else r
        val b = if from >= 3 then px[s + 2] else r
        val a: u8 = if from == 2 then px[s + 1] elif from == 4 then px[s + 3] else 255

        if to == 1
            dst[d] = grey_of(r, g, b)
        elif to == 2
            dst[d] = grey_of(r, g, b)
            dst[d + 1] = a
        else
            dst[d] = r
            dst[d + 1] = g
            dst[d + 2] = b

            if to == 4 then dst[d + 3] = a

    dst
end converted

// How many channels a WebP is taken to have when nobody said.
//
// **The alpha in the header decides**, which is `Channels.Source` read the only way it can be read
// for a format with no channel count in it: a file carrying transparency answers four and one that
// does not answers three. That matches what stb answers for a PNG of either kind.
private webp_source_channels(info: libwebp.Info) -> usize = if info.has_alpha then 4 else 3

// A WebP decoded and converted to the count a caller asked for.
//
// **Three or four is decoded directly and one or two is converted from three or four**, so nothing
// is decoded twice and an image with alpha keeps it as far as the answer allows.
private decode_webp(data: []const u8, want: usize) -> Result[Value, libwebp.Error]
    val base: usize = if want == 3 then 3 else 4
    val img = if base == 3 then libwebp.decode_rgb(data)? else libwebp.decode_rgba(data)?

    if want == base then return Ok(image_value(img.width, img.height, int(base), img.pixels()))

    Ok(image_value(img.width, img.height, int(want), converted(img.pixels(), base, want)))
end decode_webp

// -- what a program is handed back -----------------------------------------------------------------

private image_bytes(bytes: []const u8) -> Value
    var items: Buf[Value] = buf()

    for i in 0..<bytes.len
        items.push(Int(long(bytes[i])))

    Array(new_array(items))
end image_bytes

// `{ width, height, channels, pixels }`, which is what every one of the five reads or writes.
//
// **The array is made and HELD before the record is**, because `new_object` may collect and a
// `Value` in a sysl local is not a root.
private image_value(width: int, height: int, channels: int, pixels: []const u8) -> Value
    val mark = root_mark()
    val px = image_bytes(pixels)

    hold(px)

    val o = new_object()

    hold(Object(o))
    obj_put_name(o, "width", Int(long(width)))
    obj_put_name(o, "height", Int(long(height)))
    obj_put_name(o, "channels", Int(long(channels)))
    obj_put_name(o, "pixels", px)
    release(mark)
    Object(o)
end image_value

// An image a program is handing back in, read out of the record and checked against itself.
//
// **The pixels are measured against the dimensions here rather than left to stb**, which is never
// told how long the slice is and would read past its end. `sh.sysl.stb` makes the same check one
// layer down for its own callers; this one is what turns it into a sentence naming both numbers.
private struct Shot
    width: int
    height: int
    channels: int
    pixels: Buf[u8]
end Shot

private shot_of(v: Value, at: Span, name: string) -> Result[Shot, Signal]
    val o = v match
        Object(o) -> o
        other -> return Err(failure(at, s"`${name}` takes an image -- a record with `width`, `height`, `channels` and `pixels` -- and this is ${other.type_name()}"))

    val width = shot_number(o, "width", at, name)?
    val height = shot_number(o, "height", at, name)?
    val channels = shot_number(o, "channels", at, name)?

    if width < 1 || height < 1
        return Err(failure(at, s"an image is at least one pixel each way, and this one is ${width} by ${height}"))

    if channels < 1 || channels > 4
        return Err(failure(at, s"an image has 1 to 4 channels, and this says ${channels}"))

    val pixels = obj_get_name(o, "pixels") match
        Some(Array(a)) -> bytes_of(a, at, s"${name}'s pixels")?
        Some(other) -> return Err(failure(at, s"an image's `pixels` is an array of bytes, and this is ${other.type_name()}"))
        None -> return Err(failure(at, s"`${name}` was given a record with no `pixels` in it"))

    val needed = usize(width) * usize(height) * usize(channels)

    if pixels.len() < needed
        return Err(failure(at, s"this image says it is ${width} by ${height} with ${channels} channels, which is ${needed} bytes, and it carries ${pixels.len()}"))

    Ok(Shot(int(width), int(height), int(channels), pixels))
end shot_of

private shot_number(o: *ObjectObj, field: string, at: Span, name: string) -> Result[long, Signal] =
    obj_get_name(o, field) match
        Some(Int(n)) -> Ok(n)
        Some(other) -> Err(failure(at, s"an image's `${field}` is a whole number, and this is ${other.type_name()}"))
        None -> Err(failure(at, s"`${name}` was given a record with no `${field}` in it -- an image is `{ width, height, channels, pixels }`"))

// -- reading -----------------------------------------------------------------------------------------

// `readImage(bytes)` or `readImage(bytes, channels)` -- a result carrying the image, or the sentence
// saying why not.
do_read_image(args: Buf[Value], at: Span) -> Step
    if args.len() < 1 || args.len() > 2
        return fault(at, s"`readImage` takes the bytes of an image and optionally how many channels to answer, and was given ${counted(args.len(), "argument")}")

    val source = image_source(args.at(0), at, "readImage")?
    val want =
        if args.len() == 2
            image_channels(image_whole(args.at(1), at, "readImage", "the channel count")?, at)?
        else
            stb.Channels.Source

    // **WebP is routed by its header rather than tried and caught**, stb having nothing to say about
    // one but *unknown image type*. Everything else still goes to stb, which recognises its own.
    if libwebp.is_webp(source.view())
        val info = libwebp.probe(source.view()) match
            Ok(shape) -> shape
            Err(e) -> return Ok(err_value(why_not_webp(e)))

        if info.animated then return Ok(err_value(why_not_webp(libwebp.Error.Animated)))

        val asked = if want == stb.Channels.Source then webp_source_channels(info) else usize(want.code())

        return decode_webp(source.view(), asked) match
            Ok(img) ->
                val mark = root_mark()

                hold(img)

                val made = ok_value(img)

                hold(made)
                release(mark)
                Ok(made)
            Err(e) -> Ok(err_value(why_not_webp(e)))

    stb.decode(source.view(), want) match
        Ok(img) ->
            val mark = root_mark()
            val made = ok_value(image_value(img.width, img.height, img.channels, img.pixels()))

            hold(made)
            release(mark)
            Ok(made)
        Err(e) -> Ok(err_value(why_not_image(e)))
end do_read_image

// `imageShape(bytes)` -- `{ width, height, channels }` from the header alone, without decoding.
//
// **This is the guard against a decompression bomb wearing a picture's clothes.** The pixels are
// `width * height * channels` bytes whatever the file weighed, so a 4 KB PNG claiming 20,000 by
// 20,000 is 1.2 GB the moment anything decodes it. Reading the shape first is what lets a handler
// answer `413` instead.
do_image_shape(args: Buf[Value], at: Span) -> Step
    if args.len() != 1
        return fault(at, s"`imageShape` takes the bytes of an image, and was given ${counted(args.len(), "argument")}")

    val source = image_source(args.at(0), at, "imageShape")?

    // **A WebP's header carries no channel count**, WebP being RGB or RGBA and nothing else, so the
    // alpha flag is what answers -- the same number `readImage` will hand back for the same file,
    // which is the only property of this call worth guaranteeing. **An animation is refused here as
    // well as at the decode**: a shape a caller could then not decode is worse than no shape at all.
    if libwebp.is_webp(source.view())
        return libwebp.probe(source.view()) match
            Ok(info) ->
                if info.animated then return Ok(err_value(why_not_webp(libwebp.Error.Animated)))

                val mark = root_mark()
                val o = new_object()

                hold(Object(o))
                obj_put_name(o, "width", Int(long(info.width)))
                obj_put_name(o, "height", Int(long(info.height)))
                obj_put_name(o, "channels", Int(long(webp_source_channels(info))))

                val made = ok_value(Object(o))

                hold(made)
                release(mark)
                Ok(made)
            Err(e) -> Ok(err_value(why_not_webp(e)))

    stb.probe(source.view()) match
        Ok(shape) ->
            val mark = root_mark()
            val o = new_object()

            hold(Object(o))
            obj_put_name(o, "width", Int(long(shape.width)))
            obj_put_name(o, "height", Int(long(shape.height)))
            obj_put_name(o, "channels", Int(long(shape.channels)))

            val made = ok_value(Object(o))

            hold(made)
            release(mark)
            Ok(made)
        Err(e) -> Ok(err_value(why_not_image(e)))
end do_image_shape

// -- scaling -------------------------------------------------------------------------------------------

// `resizeImage(image, width, height)` -- the same image at another size, 8 bits a channel.
//
// **The filtering happens in sRGB space**, which is stb's own default and is the right answer for
// every 8-bit image a page holds: averaging two sRGB bytes as though they were quantities of light
// is what makes a naively downscaled photograph come out too dark.
do_resize_image(args: Buf[Value], at: Span) -> Step
    if args.len() != 3
        return fault(at, s"`resizeImage` takes an image, a width and a height, and was given ${counted(args.len(), "argument")}")

    val shot = shot_of(args.at(0), at, "resizeImage")?
    val width = image_whole(args.at(1), at, "resizeImage", "the width")?
    val height = image_whole(args.at(2), at, "resizeImage", "the height")?

    if width < 1 || height < 1
        return fault(at, s"a resized image is at least one pixel each way, and this asks for ${width} by ${height}")

    // stb takes every length as an `int`, and a run away multiplication here would be the thing that
    // allocated a terabyte -- so the answer's size is checked before anything is asked for it.
    if width > 65535 || height > 65535
        return fault(at, s"a resized image is at most 65535 pixels each way, and this asks for ${width} by ${height}")

    val layout = image_layout(long(shot.channels), at)?
    val needed = usize(width) * usize(height) * usize(shot.channels)
    var dst: []u8 = [0; needed]

    stb.resize(shot.pixels.view(), shot.width, shot.height, dst, int(width), int(height), layout) match
        Ok(_) ->
            val mark = root_mark()
            val made = image_value(int(width), int(height), shot.channels, dst)

            hold(made)
            release(mark)
            Ok(made)
        Err(e) -> fault(at, why_not_image(e))
end do_resize_image

// -- writing --------------------------------------------------------------------------------------------

// `encodePNG(image)` -- a whole PNG file, as bytes. Lossless, and what to reach for unless the
// image is a photograph.
do_encode_png(args: Buf[Value], at: Span) -> Step
    if args.len() != 1
        return fault(at, s"`encodePNG` takes an image, and was given ${counted(args.len(), "argument")}")

    val shot = shot_of(args.at(0), at, "encodePNG")?

    stb.encode_png(shot.pixels.view(), shot.width, shot.height, shot.channels) match
        Ok(file) ->
            val mark = root_mark()
            val made = image_bytes(file.bytes())

            hold(made)
            release(mark)
            Ok(made)
        Err(e) -> fault(at, s"this image could not be encoded: ${e.message()}")
end do_encode_png

// `encodeJPEG(image, quality)` -- a whole JPEG file, as bytes.
//
// **The quality is written at every call**, which is `zstd`'s level and `compress`'s quality and the
// same argument: it is the one number a caller has to think about, and no single value is right
// often enough to be the quiet one. 80 is a photograph on a page, 60 a thumbnail, 95 something to
// be edited again.
//
// stb's encoder is a baseline one -- no progressive mode, no subsampling control -- which is small,
// fast, and read by everything.
do_encode_jpeg(args: Buf[Value], at: Span) -> Step
    if args.len() != 2
        return fault(at, s"`encodeJPEG` takes an image and a quality from 1 to 100, and was given ${counted(args.len(), "argument")}")

    val shot = shot_of(args.at(0), at, "encodeJPEG")?
    val quality = image_whole(args.at(1), at, "encodeJPEG", "the quality")?

    if quality < 1 || quality > 100
        return fault(at, s"a JPEG quality runs from 1 to 100 and this is ${quality}")

    stb.encode_jpg(shot.pixels.view(), shot.width, shot.height, shot.channels, int(quality)) match
        Ok(file) ->
            val mark = root_mark()
            val made = image_bytes(file.bytes())

            hold(made)
            release(mark)
            Ok(made)
        Err(e) -> fault(at, s"this image could not be encoded: ${e.message()}")
end do_encode_jpeg

// `encodeWebP(image, quality)` or `encodeWebP(image, { lossless: true })` -- a whole WebP file, as
// bytes.
//
// **Two forms rather than two names**, which is `encodeJPEG`'s shape kept: the second argument is
// still what a caller has to think about, and lossless is a value that argument can take rather
// than a different call. A separate `encodeLosslessWebP` would be a sixth name in a module whose
// whole argument for `resizeImage` over `resize` is that names are scarce.
//
// **Lossy WebP is roughly a quarter smaller than a JPEG at the same quality and keeps an alpha
// channel**, which JPEG cannot -- so it is what to reach for on a page. Lossless beats PNG by about
// a fifth, and is the form to write where a PNG would have been.

// What `encodeWebP`'s second argument said.
private enum WebpMode
    Lossy(quality: long)
    Lossless

// The second argument, read as one or the other.
//
// **An unknown key is refused rather than ignored**, which is `h2Session`'s rule and is what makes
// `{ lossles: true }` a complaint instead of a file silently encoded lossily.
private webp_mode(v: Value, at: Span) -> Result[WebpMode, Signal]
    val o = v match
        Int(n) ->
            if n < 1 || n > 100
                return Err(failure(at, s"a WebP quality runs from 1 to 100 and this is ${n}"))

            return Ok(WebpMode.Lossy(n))
        Object(o) -> o
        other -> return Err(failure(at, s"`encodeWebP` takes an image and either a quality from 1 to 100 or `{ lossless: true }`, and this is ${other.type_name()}"))

    for i in 0..<o.entries.len()
        val entry = o.entries.at(i)

        if !entry.dead
            val key = entry.key match
                Str(k) -> k.s
                other -> return Err(failure(at, s"an option is named, and this is ${other.type_name()}"))

            if key != "lossless"
                return Err(failure(at, s"`${key}` is not one of `encodeWebP`'s options -- there is one, `lossless`"))

    obj_get_name(o, "lossless") match
        Some(Bool(b)) ->
            if b
                Ok(WebpMode.Lossless)
            else
                Err(failure(at, "`{ lossless: false }` says nothing about the quality -- write the number instead, as `encodeWebP(image, 80)`"))
        Some(other) -> Err(failure(at, s"`lossless` is true or false, and this is ${other.type_name()}"))
        None -> Err(failure(at, "`encodeWebP` was given a record with no `lossless` in it -- the two forms are a quality from 1 to 100 and `{ lossless: true }`"))
end webp_mode

// Which of libwebp's four encoders the channel count and the mode name between them.
private webp_file(px: []const u8, width: int, height: int, channels: usize,
                  mode: WebpMode) -> Result[&libwebp.Encoded, libwebp.Error] =
    mode match
        WebpMode.Lossless ->
            if channels == 3
                libwebp.encode_lossless_rgb(px, width, height)
            else
                libwebp.encode_lossless_rgba(px, width, height)
        WebpMode.Lossy(quality) ->
            if channels == 3
                libwebp.encode_rgb(px, width, height, f32(quality))
            else
                libwebp.encode_rgba(px, width, height, f32(quality))

do_encode_webp(args: Buf[Value], at: Span) -> Step
    if args.len() != 2
        return fault(at, s"`encodeWebP` takes an image and either a quality from 1 to 100 or `{ lossless: true }`, and was given ${counted(args.len(), "argument")}")

    val shot = shot_of(args.at(0), at, "encodeWebP")?
    val mode = webp_mode(args.at(1), at)?

    // **There is no greyscale WebP**, the format being RGB or RGBA and nothing else, so one channel
    // is widened to three and two to four -- which is what a browser decoding the file would have
    // shown anyway. Three and four go through the same conversion unchanged; it is a byte move over
    // a buffer `shot_of` has already copied out of the slate array, and paying it uniformly is
    // cheaper to read than a branch that skips it.
    val wide: usize = if shot.channels == 1 then 3 elif shot.channels == 2 then 4 else usize(shot.channels)
    val px = converted(shot.pixels.view(), usize(shot.channels), wide)

    webp_file(px, shot.width, shot.height, wide, mode) match
        Ok(file) ->
            val mark = root_mark()
            val made = image_bytes(file.bytes())

            hold(made)
            release(mark)
            Ok(made)
        Err(e) -> fault(at, s"this image could not be encoded: ${e.message()}")
end do_encode_webp
