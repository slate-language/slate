module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// NARROWING, THE THREE FORMS TYPESCRIPT HAS AND SLATE LACKED -- `assert`, a bare value's truth, and
// a path of fields.
//
// **A file of its own beside `tests_narrow.sysl`** because the third form has a rule the others do
// not: what makes a path's narrowing stale is not an assignment the block can see but anything that
// RUNS between the test and the read. Half the tests here are a narrowing being dropped, and every one
// of those comes with the control that shows the narrowing was there to drop.

// A function answering `object | null`, which is the type every refusal below is about.
val MaybeObject: string = "f(s: string) -> object | null = if s == \"\" then null else { a: 1 }\n"

// The same, with a `val` holding it in a field -- a shape the checker keeps, nothing else holding
// the object or writing to it.
val HeldInField: string = MaybeObject + "val o = { m: f(\"x\") }\n"

val Unnarrowed: string = "`keys` takes object | array here, and this is object | null"

@test
AN_ASSERT_NARROWS_THE_LINES_BELOW_IT()
    // **`assert(c)` is `if !c then throw …` written as a call**, so what follows knows `c` held.
    assert_eq(out(MaybeObject + "val m = f(\"x\")\nassert(m != null)\nprint(keys(m))"), "[\"a\"]")

    // With a message, by truth, and by an `is` test -- inside a function as much as at the top.
    assert_eq(out(MaybeObject + "val m = f(\"x\")\nassert(m != null, \"m was null\")\nprint(keys(m))"), "[\"a\"]")
    assert_eq(out(MaybeObject + "val m = f(\"x\")\nassert(m)\nprint(keys(m))"), "[\"a\"]")
    assert_eq(out("g(x: string | number)\n    assert(x is string)\n    upper(x)\nprint(g(\"a\"))"), "A")

    // **The machine still refuses what the assertion does not hold for**, which is what makes the
    // narrowing below it true.
    assert(fails(MaybeObject + "val m = f(\"\")\nassert(m != null)\nprint(keys(m))").contains("this assertion does not hold"))

@test
AN_ASSERT_OF_SOMETHING_ELSE_NARROWS_NOTHING()
    assert(fails(MaybeObject + "val m = f(\"x\")\nassert(1 == 1)\nprint(keys(m))").contains(Unnarrowed))

    // What the condition says is what is known, and here it says the opposite.
    assert(fails(MaybeObject + "val m = f(\"x\")\nassert(m == null)\nprint(keys(m))").contains("and this is null"))

    // **A program's own `assert` promises nothing** -- it may well return on false.
    assert(fails(MaybeObject + "assert(c) = c\nval m = f(\"x\")\nassert(m != null)\nprint(keys(m))").contains(Unnarrowed))

    // Nor does one used for its value rather than as a statement.
    assert(fails(MaybeObject + "val m = f(\"x\")\nval ok = assert(m != null)\nprint(keys(m))").contains(Unnarrowed))

@test
A_BARE_VALUE_IN_A_CONDITION_NARROWS_BY_ITS_TRUTH()
    // **The true side takes `null` away**, slate's truthiness being JavaScript's.
    assert_eq(out(MaybeObject + "val m = f(\"x\")\nprint(if m then keys(m) else 0)"), "[\"a\"]")

    // **And the false side takes away what is never false**: an object is always true, so an
    // `object | null` that tested false is the null.
    assert(fails(MaybeObject + "val m = f(\"x\")\nprint(if m then 0 else keys(m))").contains("and this is null"))

    // `!`, `&&`, `||` and an early exit all read it the same way.
    assert_eq(out(MaybeObject + "g(s: string)\n    val m = f(s)\n    if !m then return 0\n    keys(m).length\nprint(g(\"x\"), g(\"\"))"), "1 0")
    assert_eq(out(MaybeObject + "val m = f(\"x\")\nprint(m && keys(m))"), "[\"a\"]")
    assert_eq(out(MaybeObject + "val m = f(\"\")\nprint(!m || keys(m))"), "true")
    assert_eq(out(MaybeObject + "g(s: string)\n    val m = f(s)\n    if m then keys(m).length else -1\nprint(g(\"x\"), g(\"\"))"), "1 -1")

@test
A_VALUE_THAT_MAY_BE_EMPTY_IS_NOT_NARROWED_ON_ITS_FALSE_SIDE()
    // **`""` and `0` are false too**, so a string or a number that tested false may still be one --
    // claiming the null there would refuse the program that handed the empty string over.
    val takes = "t(s: string) = s\nn(i: integer) = i\n"

    assert(fails(takes + "g(x: string | null) = if x then 0 else t(x)\ng(null)").contains("`t` takes string here, and this is string | null"))
    assert(fails(takes + "g(x: integer | null) = if x then 0 else n(x)\ng(null)").contains("`n` takes integer here, and this is integer | null"))

    // The true side is still narrowed, which is what says the false side was looked at.
    assert_eq(out(takes + "g(x: string | null) = if x then t(x) else \"-\"\nprint(g(\"a\"), g(\"\"), g(null))"), "a - -")
    assert_eq(out(takes + "g(x: integer | null) = if x then n(x) else -1\nprint(g(3), g(0), g(null))"), "3 -1 -1")

@test
A_TESTED_PATH_IS_NARROWED()
    // **The control first**: unnarrowed, the read is refused.
    assert(fails(HeldInField + "print(keys(o.m))").contains(Unnarrowed))

    assert_eq(out(HeldInField + "if o.m != null then print(keys(o.m))"), "[\"a\"]")
    assert_eq(out(HeldInField + "if o.m == null then print(0) else print(keys(o.m))"), "[\"a\"]")
    assert_eq(out(HeldInField + "if o.m then print(keys(o.m))"), "[\"a\"]")
    assert_eq(out(HeldInField + "assert(o.m != null)\nprint(keys(o.m))"), "[\"a\"]")
    assert_eq(out(HeldInField + "print(o.m != null && keys(o.m))"), "[\"a\"]")

    // An early exit, and a path deeper than one field.
    assert_eq(out(MaybeObject + "g(s: string)\n    val o = { m: f(s) }\n    if o.m == null then return 0\n    keys(o.m).length\nprint(g(\"x\"), g(\"\"))"), "1 0")
    assert_eq(out(MaybeObject + "val a = { b: { c: f(\"x\") } }\nif a.b.c != null then print(keys(a.b.c))"), "[\"a\"]")

    // **The narrowing is a claim that can still be wrong**, so the wrong use is still refused.
    assert(fails("t(n: number) = n\ng(o) = if o.m is string then t(o.m) else 0\ng({ m: \"a\" })").contains("`t` takes number here, and this is string"))
    assert(fails(HeldInField + "if o.m == null then print(keys(o.m))").contains("and this is null"))

@test
A_CALL_ENDS_A_PATH_NARROWING_WHICH_IS_STRICTER_THAN_TYPESCRIPT()
    // **A call may change any object it can reach**, so nothing it could have changed is still known
    // after it -- a plain function, a method, a call in the condition after the test.
    assert(fails(HeldInField + "g() = 0\nif o.m != null\n    g()\n    print(keys(o.m))").contains(Unnarrowed))
    assert(fails(HeldInField + "val xs = [1]\nif o.m != null\n    xs.push(2)\n    print(keys(o.m))").contains(Unnarrowed))
    assert(fails(HeldInField + "g() = true\nif o.m != null && g() then print(keys(o.m))").contains(Unnarrowed))

    // The control: the same lines with no call between.
    assert_eq(out(HeldInField + "if o.m != null\n    val n = 2\n    print(keys(o.m), n)"), "[\"a\"] 2")

    // **The order is the RUN's**: an argument read before another argument's call keeps its
    // narrowing, and one read after it does not.
    assert_eq(out(HeldInField + "pair(a: object, b) = keys(a)\ng() = 0\nif o.m != null then print(pair(o.m, g()))"), "[\"a\"]")
    assert(fails(HeldInField + "pair(a, b: object) = keys(b)\ng() = 0\nif o.m != null then print(pair(g(), o.m))").contains("and this is object | null"))

    // **An `await` lets other code run**, which is a call by another name.
    assert(fails(HeldInField + "g() = 0\nasync h()\n    if o.m != null\n        await g()\n        print(keys(o.m))\nh()").contains(Unnarrowed))

@test
A_PATH_NARROWED_OUTSIDE_A_FUNCTION_OR_A_LOOP_IS_NOT_KNOWN_INSIDE_IT()
    // **A function runs whenever it is called**, so the test around its definition proves nothing.
    assert(fails(HeldInField + "if o.m != null\n    val k = () -> keys(o.m)\n    print(k())").contains(Unnarrowed))

    // **A loop's second turn reads after its first turn ran**, every call in it included.
    assert(fails(HeldInField + "if o.m != null\n    for i in 0..<2\n        print(keys(o.m))").contains(Unnarrowed))

    // A test INSIDE either one narrows there as anywhere else.
    assert_eq(out(HeldInField + "val k = () -> if o.m != null then keys(o.m) else []\nprint(k())"), "[\"a\"]")
    assert_eq(out(HeldInField + "for i in 0..<2\n    if o.m != null then print(keys(o.m))"), "[\"a\"]\n[\"a\"]")

@test
A_WRITE_TO_THE_ROOT_A_PREFIX_OR_THE_PATH_ENDS_ITS_NARROWING()
    // **Each of these programs RUNS**, the write having made the field a number -- so a narrowing
    // left standing over the write would refuse it. The first is the control that shows the
    // narrowing was there to drop.
    val t = "t(n: number) = n\n"

    assert(fails(t + "g(o)\n    var p = o\n    if p.m is string\n        return t(p.m)\n    0\ng({ m: \"a\" })").contains("`t` takes number here, and this is string"))

    // The root itself, written to.
    assert_eq(out(t + "g(o)\n    var p = o\n    if p.m is string\n        p = { m: 1 }\n        return t(p.m)\n    0\nprint(g({ m: \"a\" }))"), "1")

    // A prefix of the path, and the path.
    assert_eq(out(t + "g(a)\n    if a.b.c is string\n        a.b = { c: 1 }\n        return t(a.b.c)\n    0\nprint(g({ b: { c: \"x\" } }))"), "1")
    assert_eq(out(t + "g(a)\n    if a.b.c is string\n        a.b.c = 1\n        return t(a.b.c)\n    0\nprint(g({ b: { c: \"x\" } }))"), "1")

    // **And a field written through ANOTHER name for the same object** -- which no rule about the
    // path's own spelling could see, and is why a field write ends every path.
    assert_eq(out(t + "g(a)\n    if a.b.c is string\n        val q = a.b\n        q.c = 1\n        return t(a.b.c)\n    0\nprint(g({ b: { c: \"x\" } }))"), "1")

    // A write through an index is one too.
    assert_eq(out(t + "g(a)\n    if a.b.c is string\n        a[\"b\"] = { c: 1 }\n        return t(a.b.c)\n    0\nprint(g({ b: { c: \"x\" } }))"), "1")

@test
A_ROOT_DECLARED_AGAIN_IS_ANOTHER_ROOT()
    // **An inner `o` is another `o`**, so the outer one's narrowing says nothing about its `m`.
    assert(fails(HeldInField + "if o.m != null\n    val o = { m: null }\n    print(keys(o.m))").contains("and this is null"))

@test
THE_NARROWED_PROGRAMS_RUN_THE_SAME_UNDER_slate_js()
    // **Both hosts run this one checker, and the narrowing changes nothing about what runs** -- so
    // what these programs print has to be the same printed by node.
    val prog = MaybeObject + "val m = f(\"x\")\nassert(m != null)\nprint(keys(m))\nval o = { m: f(\"x\") }\nif o.m then print(keys(o.m))\nif !m then print(0) else print(keys(m))\nval e = f(\"\")\nprint(if e then 1 else e)"
    val said = "[\"a\"]\n[\"a\"]\n[\"a\"]\nnull"

    assert_eq(out(prog), said)
    assert_eq(node_said(prog), said)
