module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// What a program does to an array, and the table that lets it be written as a method.
//
// **Every one of these is an ordinary function whose first argument is the array**, so `map(xs, f)`
// and `xs.map(f)` are the same call written two ways. That is the whole of slate's method syntax on
// a builtin type: there is no array object, no prototype in the heap and no bound method -- only a
// name looked up by the kind of the receiver, and the receiver passed in front.
//
// **A MUTATOR NEVER ANSWERS THE ARRAY IT CHANGED.** `sort` and `reverse` answer nothing; `pop` and
// `removeAt` answer what they took out. That is the rule that stops `ys = xs.sort()` reading as a
// fresh array when it is the same one -- JavaScript hands the array back from both, which is what
// makes its mutating and non-mutating operations indistinguishable at the call site. The other half
// of the same rule is in the naming: **the bare verb changes the array and the participle answers a
// new one**, so `sort` against `sorted` and `reverse` against `reversed`. Python draws the line in
// exactly these two places.

// -- the shapes these all take --------------------------------------------------------------------

private array_of(v: Value, at: Span, name: string) -> Result[*ArrayObj, Signal] = v match
    Array(a) -> Ok(a)
    other -> Err(failure(at, s"`${name}` takes an array, and this is ${other.type_name()}"))

// **A count is a FLOOR, not a target** -- `wants` in `text.sysl`, and the call rule the language
// follows everywhere: a surplus is dropped and only a count the call did not reach is refused.
private takes(args: Args, n: usize, at: Span, name: string, what: string) -> Result[unit, Signal]
    if args.len() < n then return Err(failure(at, s"`${name}` takes ${what}, and was given ${counted(args.len(), "argument")}"))

    Ok(())

private index_of_value(v: Value, at: Span, name: string, n: usize) -> Result[usize, Signal] = v match
    Int(i) ->
        if i < 0 || usize(i) > n
            Err(failure(at, s"`${name}` was given the position ${i}, and this array has ${n} places to put one"))
        else
            Ok(usize(i))
    other -> Err(failure(at, s"`${name}` takes a position, and this is ${other.type_name()}"))

// Whether the array is still the length the walk started at.
//
// **A CALLBACK MAY CHANGE THE ARRAY IT IS WALKING, AND WITHOUT THIS THAT IS A PANIC.** The loop
// bound is read once, so an element removed part-way through leaves the next read past the end --
// which sysl reports as `index 2 past the 2 elements of a Buf`, with no line, no file and nothing
// naming the program. JavaScript's answer is quieter and worse: `map` visits whatever survives and
// leaves holes for the rest, so the mistake becomes a short array nobody traces back.
//
// **The diagnostic names the fix**, because the reader who believes the message still has to know
// what to do: walk a copy, or build a new array rather than changing this one.
private walk_changed(at: Span, name: string) -> Signal =
    failure(at, s"this array was changed while `${name}` was walking it -- walk a copy of it, or build a new array rather than changing this one")

// Call a function on one element, the way JavaScript's array methods call one.
//
// **THE ELEMENT, ITS POSITION AND THE ARRAY, AND THE CALLBACK TAKES AS MANY OF THEM AS IT
// DECLARES.** All three are supplied and the call drops what the function cannot bind, so
// `x -> x * 2` reads exactly as it did and `(x, i) -> x + i` reads the index without a `for` loop
// beside it. A callback declaring a fourth is refused, and the sentence names this native.
//
// **A BUILTIN HANDED OVER BY NAME STILL GETS THE ELEMENT ALONE**, which is `apply_walk_callback`'s
// `1` and is where JavaScript's `map(parseInt)` goes wrong.
//
// **The array is the one the walk was handed**, so a callback may look at what it has not reached
// yet -- and changing it under the walk is caught by `walk_changed` rather than left to run short.
private call_on(f: Value, v: Value, i: usize, xs: Value, at: Span, name: string) -> Step
    var three: Buf[Value] = buf()

    three.push(v)
    three.push(Int(long(i)))
    three.push(xs)
    apply_walk_callback(f, three, 1, at, name)

// -- walking an array with a function ---------------------------------------------------------------

// `map(xs, f)` -- every element put through `f`, as a new array.
//
// **The result array is made first and held, and each answer is pushed into it as it arrives.** A
// sysl `Buf` of values is not a root, so a callback that allocates could collect everything mapped
// so far; the array is traced, and pushing into it is what keeps them.
do_map(args: Args, at: Span) -> Step
    takes(args, 2, at, "map", "an array and a function")?

    val xs = array_of(args.at(0), at, "map")?
    val mark = root_mark()
    val out = new_array(buf())

    hold(Array(out))

    val n = xs.items.len()

    for i in 0..<n
        call_on(args.at(1), xs.items.at(i), i, args.at(0), at, "map") match
            Ok(v) -> array_push(out, v)
            Err(e) ->
                release(mark)
                return Err(e)

        if xs.items.len() != n
            release(mark)
            return Err(walk_changed(at, "map"))

    release(mark)
    Ok(Array(out))
end do_map

// `filter(xs, f)` -- the elements `f` says yes to, in the order they were in.
do_filter(args: Args, at: Span) -> Step
    takes(args, 2, at, "filter", "an array and a function")?

    val xs = array_of(args.at(0), at, "filter")?
    val mark = root_mark()
    val out = new_array(buf())

    hold(Array(out))

    val n = xs.items.len()

    for i in 0..<n
        val kept = call_on(args.at(1), xs.items.at(i), i, args.at(0), at, "filter") match
            Ok(v) -> v.truthy()
            Err(e) ->
                release(mark)
                return Err(e)

        if xs.items.len() != n
            release(mark)
            return Err(walk_changed(at, "filter"))

        if kept then array_push(out, xs.items.at(i))

    release(mark)
    Ok(Array(out))
end do_filter

// `reduce(xs, f, start)` -- `f` folded over the array from the left.
//
// **The starting value is required, and that is deliberate.** JavaScript's is optional and reducing
// an empty array without one raises a `TypeError` from inside the library -- a failure mode that
// exists only because the argument was made optional. Requiring it removes the case.
//
// **The running answer goes in FRONT of what every other callback is handed**, which is
// JavaScript's order: the accumulator, the element, its position and the array.
do_reduce(args: Args, at: Span) -> Step
    takes(args, 3, at, "reduce", "an array, a function and a starting value")?

    val xs = array_of(args.at(0), at, "reduce")?
    val mark = root_mark()
    var acc = args.at(2)

    hold(acc)

    val n = xs.items.len()

    for i in 0..<n
        var four: Buf[Value] = buf()

        four.push(acc)
        four.push(xs.items.at(i))
        four.push(Int(long(i)))
        four.push(args.at(0))

        apply_walk_callback(args.at(1), four, 2, at, "reduce") match
            Ok(v) ->
                acc = v

                // The previous accumulator is dead and the new one has to be reachable across the
                // next call, so the shadow stack is wound back to the mark and re-pushed each turn
                // rather than growing by one for every element.
                release(mark)
                hold(acc)
            Err(e) ->
                release(mark)
                return Err(e)

        if xs.items.len() != n
            release(mark)
            return Err(walk_changed(at, "reduce"))

    release(mark)
    Ok(acc)
end do_reduce

// `find(xs, f)` and `findIndex(xs, f)` -- the first element `f` says yes to, or where it is.
//
// **Absent is `null` and not -1**, which is the same call `indexOf` makes and for the same reason:
// slate has a null and the operators that go with it, so a sentinel would be an invented one.
do_find(args: Args, at: Span, want_index: bool, from_end: bool) -> Step
    val name = if from_end
        if want_index then "findLastIndex" else "findLast"
    else
        if want_index then "findIndex" else "find"

    takes(args, 2, at, name, "an array and a function")?

    val xs = array_of(args.at(0), at, name)?

    val n = xs.items.len()

    for i in 0..<n
        // **The walk runs backwards for the `Last` pair and is otherwise the same function**, so the
        // two directions cannot answer differently about anything but which one they found first.
        val k = if from_end then n - 1 - i else i
        val hit = call_on(args.at(1), xs.items.at(k), k, args.at(0), at, name)?.truthy()

        if xs.items.len() != n then return Err(walk_changed(at, name))

        if hit then return Ok(if want_index then Int(long(k)) else xs.items.at(k))

    Ok(Null)
end do_find

// `every(xs, f)` and `some(xs, f)`, which stop as soon as the answer is settled.
//
// Empty answers `true` for `every` and `false` for `some`, which is what the two questions mean
// about nothing and is what every language answers.
do_quantify(args: Args, at: Span, want_every: bool) -> Step
    val name = if want_every then "every" else "some"

    takes(args, 2, at, name, "an array and a function")?

    val xs = array_of(args.at(0), at, name)?

    val n = xs.items.len()

    for i in 0..<n
        val said = call_on(args.at(1), xs.items.at(i), i, args.at(0), at, name)?.truthy()

        if xs.items.len() != n then return Err(walk_changed(at, name))

        if said != want_every then return Ok(Bool(!want_every))

    Ok(Bool(want_every))
end do_quantify

// -- order ------------------------------------------------------------------------------------------

// Whether `a` comes before `b`, by a program's rule or by slate's own.
//
// **A COMPARATOR ANSWERS A BOOLEAN, NOT A NUMBER**, and the reason is slate's truthiness. Only
// `null`, `undefined` and `false` are false here, so **zero is true** -- a JavaScript-style
// comparator answering -1, 0 or 1 would read as "yes, yes, yes" and sort nothing, silently. A
// boolean cannot be misread, `(a, b) -> a.age < b.age` is what the reader was going to write anyway,
// and anything else is refused in a sentence.
private comes_first(cmp: Value, a: Value, b: Value, at: Span, name: string) -> Result[bool, Signal]
    if is_nullish(cmp)
        // **Numbers order as numbers.** `[10, 9]` sorted answers `[9, 10]`, where JavaScript's
        // default answers `[10, 9]` -- it renders both to text and compares those. slate's `<` is
        // the rule, so two numbers compare as numbers, two strings as text, and a mixture is a
        // fault naming both kinds rather than an arbitrary answer.
        return on_values(Lt, a, b, at)? match
            Bool(x) -> Ok(x)
            other -> Err(failure(at, s"these cannot be put in order, being ${other.type_name()}"))

    var two: Buf[Value] = buf()

    two.push(a)
    two.push(b)

    apply_callback(cmp, two, at, name)? match
        Bool(x) -> Ok(x)
        other -> Err(failure(at, s"a comparator answers whether the first value comes before the second, and this answered ${other.type_name()}"))
end comes_first

// Merge sort, which is what makes the order STABLE -- two elements the comparator calls equal come
// out in the order they went in. An unstable sort makes `sorted(sorted(xs, byName), byAge)` lose the
// first ordering, which is the whole reason a program sorts twice.
//
// **Both arrays are collected objects and both are held by the caller**, so every value in flight is
// traced. A scratch `Buf` would not be, and a comparator is a program that allocates.
private merge_sort(a: *ArrayObj, scratch: *ArrayObj, lo: usize, hi: usize, cmp: Value, n: usize, at: Span, name: string) -> Result[unit, Signal]
    if hi - lo < 2 then return Ok(())

    val mid = lo + (hi - lo) / 2

    merge_sort(a, scratch, lo, mid, cmp, n, at, name)?
    merge_sort(a, scratch, mid, hi, cmp, n, at, name)?

    var i = lo
    var j = mid
    var k = lo

    loop
        if k >= hi then break

        // **The right side is taken only where it comes STRICTLY first**, which is what makes the
        // sort stable: a tie leaves the left run in front, and the left run is the earlier one.
        var take_right = i >= mid

        if !take_right && j < hi
            take_right = comes_first(cmp, a.items.at(j), a.items.at(i), at, name)?

            // A comparator is a program, and a program may change the array it is ordering.
            if a.items.len() != n then return Err(walk_changed(at, name))

        if take_right
            scratch.items.set(k, a.items.at(j))
            j += 1
        else
            scratch.items.set(k, a.items.at(i))
            i += 1

        k += 1

    for n in lo..<hi
        a.items.set(n, scratch.items.at(n))

    Ok(())
end merge_sort

// `sort(xs)` changes the array; `sorted(xs)` answers a new one. Both take an optional comparator.
do_sort(args: Args, at: Span, in_place: bool) -> Step
    val name = if in_place then "sort" else "sorted"

    if args.len() != 1 && args.len() != 2
        return fault(at, s"`${name}` takes an array and an optional comparator, and was given ${counted(args.len(), "argument")}")

    val given = array_of(args.at(0), at, name)?
    val cmp: Value = if args.len() == 2 then args.at(1) else Null
    val mark = root_mark()
    val target = if in_place then given else new_array(copy_of(given))

    hold(Array(target))

    val scratch = new_array(copy_of(target))

    hold(Array(scratch))

    val n = target.items.len()
    val outcome = merge_sort(target, scratch, 0, n, cmp, n, at, name)

    release(mark)
    outcome?

    // **Nothing is handed back from the mutating form**, so a sorted-in-place array cannot be
    // mistaken for a fresh one at the call site.
    Ok(if in_place then Null else Array(target))
end do_sort

// `reverse(xs)` changes the array; `reversed(xs)` answers a new one.
do_reverse(args: Args, at: Span, in_place: bool) -> Step
    val name = if in_place then "reverse" else "reversed"

    takes(args, 1, at, name, "an array")?

    val xs = array_of(args.at(0), at, name)?
    val n = xs.items.len()

    if !in_place
        val mark = root_mark()
        val out = new_array(buf())

        hold(Array(out))

        for i in 0..<n
            array_push(out, xs.items.at(n - 1 - i))

        release(mark)
        return Ok(Array(out))
    end if

    for i in 0..<n / 2
        val other = xs.items.at(n - 1 - i)

        xs.items.set(n - 1 - i, xs.items.at(i))
        xs.items.set(i, other)

    Ok(Null)
end do_reverse

// -- changing an array in place ---------------------------------------------------------------------

// `pop(xs)` -- the last element, taken off.
//
// **An empty array is a fault and not an absent value.** Popping nothing is a defect in the program:
// JavaScript answers `undefined`, which travels, and slate's `undefined` is exactly the value that
// may not travel -- so the honest answer is to say so where it happened.
do_pop(args: Args, at: Span) -> Step
    takes(args, 1, at, "pop", "an array")?

    val xs = array_of(args.at(0), at, "pop")?

    xs.items.pop() match
        Some(v) -> Ok(v)
        None -> fault(at, "there is nothing to pop off an empty array")
end do_pop

// `insert(xs, i, v)` -- put a value at a position, sliding the rest along.
do_insert(args: Args, at: Span) -> Step
    takes(args, 3, at, "insert", "an array, a position and a value")?

    val xs = array_of(args.at(0), at, "insert")?

    keepable(args.at(2), at, "stored")?
    array_insert(xs, index_of_value(args.at(1), at, "insert", xs.items.len())?, args.at(2))
    Ok(Null)
end do_insert

// `removeAt(xs, i)` -- take the element at a position out, and answer it.
do_remove_at(args: Args, at: Span) -> Step
    takes(args, 2, at, "removeAt", "an array and a position")?

    val xs = array_of(args.at(0), at, "removeAt")?
    val n = xs.items.len()

    if n == 0 then return fault(at, "there is nothing to remove from an empty array")

    Ok(xs.items.remove(index_of_value(args.at(1), at, "removeAt", n - 1)?))
end do_remove_at

// `clear(xs)` -- empty it.
//
// Named `do_clear_array` here because `do_clear` is already the timers'; the two are unrelated and
// the slate names are `clear` and `clearTimeout`.
do_clear_array(args: Args, at: Span) -> Step
    takes(args, 1, at, "clear", "an array")?

    args.at(0) match
        Bytes(b) ->
            b.data.clear()
            return Ok(Null)
        _ -> ()

    array_of(args.at(0), at, "clear")?.items.clear()
    Ok(Null)
end do_clear_array

// -- making one array out of others -------------------------------------------------------------

private copy_of(a: *ArrayObj) -> Buf[Value]
    var items: Buf[Value] = buf()

    for i in 0..<a.items.len()
        items.push(a.items.at(i))

    items
end copy_of

// `concat(a, b, ...)` -- every element of every array given, in one new array.
do_concat(args: Args, at: Span) -> Step
    if args.len() == 0 then return fault(at, "`concat` takes at least one array and was given none")

    // **BYTES JOIN BYTES AND ARRAYS JOIN ARRAYS, and which one this is is decided by the FIRST
    // argument** -- the receiver, `b.concat(c)` being `concat(b, c)`. Mixing the two would have to
    // pick an answer for `concat([1], toBytes("a"))`, and there is no reading of that a program meant.
    args.at(0) match
        Bytes(_) -> return do_bytes_concat(args, at)
        _ -> ()

    val mark = root_mark()
    val out = new_array(buf())

    hold(Array(out))

    for i in 0..<args.len()
        args.at(i) match
            Array(a) -> for j in 0..<a.items.len() do array_push(out, a.items.at(j))
            other ->
                release(mark)
                return fault(at, s"`concat` joins arrays, and one of these is ${other.type_name()}")

    release(mark)
    Ok(Array(out))
end do_concat

// `flat(xs)` -- one level of nesting undone.
//
// **One level and not all of them**, which is JavaScript's default and the right one: a program that
// flattens a tree of unknown depth is asking a different question, and doing it by accident to an
// array of arrays of pairs loses the pairs.
do_flat(args: Args, at: Span) -> Step
    takes(args, 1, at, "flat", "an array")?

    val xs = array_of(args.at(0), at, "flat")?
    val mark = root_mark()
    val out = new_array(buf())

    hold(Array(out))

    for i in 0..<xs.items.len()
        xs.items.at(i) match
            Array(inner) -> for j in 0..<inner.items.len() do array_push(out, inner.items.at(j))
            other -> array_push(out, other)

    release(mark)
    Ok(Array(out))
end do_flat

// WHERE A NEGATIVE INDEX POINTS, which is what `at` and `slice` are for.
//
// **A negative index counts back from the END** -- `-1` is the last element -- which is the whole
// reason JavaScript grew `at` beside `xs[i]`, that syntax having no room for it. Anything not a
// whole number is a fault naming what arrived.
// Not `private`: `text.sysl`'s `indexOf` reads its third argument by this rule too, and two
// readings of "a position, counting a negative one back from the end" would be two places for the
// negative case to be got wrong.
from_either_end(v: Value, at: Span, name: string, n: usize) -> Result[long, Signal] = v match
    Int(i) -> Ok(if i < 0 then long(n) + i else i)
    other -> Err(failure(at, s"`${name}` takes a position, and this is ${other.type_name()}"))

// The position as the program WROTE it, which is what a complaint about one out of range says.
//
// **A folded position names a number nobody wrote.** `at(-9)` on three elements folds to `-6`, so a
// sentence built from `from_either_end`'s answer sends the reader looking for where `-6` came from
// -- and the two back ends disagreed, the JavaScript runtime having reported the written one all
// along. The other arm cannot be reached: `from_either_end` has already refused anything but an
// integer, and every caller asks it first.
// Not `private`: `text.sysl` and `bytes.sysl` complain about the same position by the same rule, and
// two readings of "what the program wrote" would be two places for the folding to creep back in.
as_written(v: Value) -> long = v match
    Int(i) -> i
    _ -> 0

// A position clamped into the array, which is what SLICING means: asking for more than is there
// gives what is there. **`at` does not clamp** -- it is asking for one element, and a program that
// asked for one that is not there has made a mistake worth a sentence.
private clamped(i: long, n: usize) -> usize
    if i < 0 then return 0
    if usize(i) > n then return n

    usize(i)
end clamped

// `slice(xs, from)` and `slice(xs, from, to)` -- a new array of the part between two positions.
//
// **`to` is exclusive and both ends clamp**, which is JavaScript's rule and Python's: a slice is a
// question about whatever part of the array is there, so `slice(xs, 0, 100)` is the whole of it
// rather than a fault. An empty answer where the ends cross, rather than a reversed one.
do_slice(args: Args, at: Span) -> Step
    if args.len() != 2 && args.len() != 3
        return fault(at, s"`slice` takes an array, a position and an optional end, and was given ${counted(args.len(), "argument")}")

    args.at(0) match
        Bytes(_) -> return do_bytes_slice(args, at)
        _ -> ()

    val xs = array_of(args.at(0), at, "slice")?
    val n = xs.items.len()
    val lo = clamped(from_either_end(args.at(1), at, "slice", n)?, n)

    val hi = if args.len() == 3
        clamped(from_either_end(args.at(2), at, "slice", n)?, n)
    else
        n

    val mark = root_mark()
    val out = new_array(buf())

    hold(Array(out))

    if hi > lo
        for i in lo..<hi
            array_push(out, xs.items.at(i))

    release(mark)
    Ok(Array(out))
end do_slice

// `at(xs, i)` -- one element, counted from either end.
//
// **Out of range is a FAULT and not an absent value**, which is `xs[i]`'s rule and `pop`'s:
// JavaScript answers `undefined`, which travels, and slate's `undefined` is exactly the value that
// may not. What `at` adds over `xs[i]` is the negative index and nothing else.
do_array_at(args: Args, at: Span) -> Step
    takes(args, 2, at, "at", "an array and a position")?

    val xs = array_of(args.at(0), at, "at")?
    val n = xs.items.len()
    val i = from_either_end(args.at(1), at, "at", n)?

    if i < 0 || usize(i) >= n
        return fault(at, s"`at` was given the position ${as_written(args.at(1))}, and this array has ${n} of them")

    Ok(xs.items.at(usize(i)))
end do_array_at

// `shift(xs)` -- the FIRST element, taken off.
//
// `pop`'s twin, and empty is a fault for `pop`'s reason.
do_shift(args: Args, at: Span) -> Step
    takes(args, 1, at, "shift", "an array")?

    val xs = array_of(args.at(0), at, "shift")?

    if xs.items.len() == 0 then return fault(at, "there is nothing to shift off an empty array")

    Ok(xs.items.remove(0))
end do_shift

// `unshift(xs, v)` -- put a value at the front.
//
// **Nothing is handed back**, which is `push`'s rule rather than JavaScript's: there, `unshift`
// answers the new length, which is a number nobody reads and which makes the call look like it
// produced something.
do_unshift(args: Args, at: Span) -> Step
    takes(args, 2, at, "unshift", "an array and a value")?

    val xs = array_of(args.at(0), at, "unshift")?

    keepable(args.at(1), at, "stored")?
    array_insert(xs, 0, args.at(1))
    Ok(Null)
end do_unshift

// `flatMap(xs, f)` -- every element put through `f`, with one level of the result undone.
//
// **`map` then `flat` in one walk**, which is what it is for: a function answering nothing for some
// elements and several for others is the case neither of them handles alone.
do_flat_map(args: Args, at: Span) -> Step
    takes(args, 2, at, "flatMap", "an array and a function")?

    val xs = array_of(args.at(0), at, "flatMap")?
    val mark = root_mark()
    val out = new_array(buf())

    hold(Array(out))

    val n = xs.items.len()

    for i in 0..<n
        call_on(args.at(1), xs.items.at(i), i, args.at(0), at, "flatMap") match
            Ok(v) -> v match
                Array(inner) -> for j in 0..<inner.items.len() do array_push(out, inner.items.at(j))
                other -> array_push(out, other)
            Err(e) ->
                release(mark)
                return Err(e)

        if xs.items.len() != n
            release(mark)
            return Err(walk_changed(at, "flatMap"))

    release(mark)
    Ok(Array(out))
end do_flat_map

// `forEach(xs, f)` -- `f` on every element, for what it does rather than what it answers.
//
// **Nothing is handed back**, so it cannot be mistaken for `map`. `for x in xs` is the idiom and
// this is what a CHAIN ends with, which is the case the loop does not cover.
do_for_each(args: Args, at: Span) -> Step
    takes(args, 2, at, "forEach", "an array and a function")?

    val xs = array_of(args.at(0), at, "forEach")?
    val n = xs.items.len()

    for i in 0..<n
        call_on(args.at(1), xs.items.at(i), i, args.at(0), at, "forEach")?

        if xs.items.len() != n then return Err(walk_changed(at, "forEach"))

    Ok(Null)
end do_for_each

// `sum(xs)` -- every element added up, starting from the integer zero.
//
// So an empty array sums to `0` and an array of reals to a real, `+` being what does the promoting.
do_sum(args: Args, at: Span) -> Step
    takes(args, 1, at, "sum", "an array")?

    val xs = array_of(args.at(0), at, "sum")?
    var total: Value = Int(0)

    for i in 0..<xs.items.len()
        total = on_values(Plus, total, xs.items.at(i), at)?

    Ok(total)
end do_sum

// -- the questions an array answers about its contents --------------------------------------------

// `contains(xs, v)` on an array, which `contains` on a string already answers about text.
do_array_contains(args: Args, at: Span) -> Step
    takes(args, 2, at, "contains", "an array and what to look for")?

    val xs = array_of(args.at(0), at, "contains")?

    val n = xs.items.len()

    for i in 0..<n
        // `same` reaches a user `equals` where an element has one, so this walk can be changed
        // under its own feet exactly as one over a written callback can.
        val found = same(xs.items.at(i), args.at(1), at)?

        if xs.items.len() != n then return Err(walk_changed(at, "contains"))

        if found then return Ok(Bool(true))

    Ok(Bool(false))
end do_array_contains

// `indexOf(xs, v)` and `lastIndexOf(xs, v)` on an array, with an optional position to start from --
// the position found, or `null`.
//
// **A negative position counts back from the end and one past the end finds nothing**, which is the
// rule `slice` and `at` already read a position by; `from_either_end` is that one rule.
do_array_index_of(args: Args, at: Span, last: bool) -> Step
    val name = if last then "lastIndexOf" else "indexOf"

    if args.len() != 2 && args.len() != 3
        return fault(at, s"`${name}` takes an array, what to look for and an optional position, and was given ${counted(args.len(), "argument")}")

    val xs = array_of(args.at(0), at, name)?
    val n = xs.items.len()

    val asked = if args.len() == 3
        from_either_end(args.at(2), at, name, n)?
    else
        if last then long(n) else long(0)

    if n == 0 then return Ok(Null)

    if last
        if asked < 0 then return Ok(Null)

        var k = if asked >= long(n) then n - 1 else usize(asked)

        loop
            val found = same(xs.items.at(k), args.at(1), at)?

            if xs.items.len() != n then return Err(walk_changed(at, name))

            if found then return Ok(Int(long(k)))
            if k == 0 then break

            k -= 1

        Ok(Null)
    else
        if asked >= long(n) then return Ok(Null)

        val start = if asked < 0 then 0 else usize(asked)

        for k in start..<n
            val found = same(xs.items.at(k), args.at(1), at)?

            if xs.items.len() != n then return Err(walk_changed(at, name))

            if found then return Ok(Int(long(k)))

        Ok(Null)
end do_array_index_of

// -- an object as pairs ----------------------------------------------------------------------------

// `values(o)` and `entries(o)` -- the other two ways to walk an object, `keys` being the first.
//
// **`entries` is what makes a destructuring `for` head worth having**: `for [k, v] in entries(o)` is
// the loop every program over a record wants, and without the pairs there is nothing to take apart.
// In the order the fields were first written, which the table preserves and `keys` already relies on.
//
// **AN ARRAY ANSWERS THE SAME THREE, AND ITS KEY IS THE POSITION.** `entries(xs)` is
// `[[0, x0], [1, x1], ...]`, which is what makes `for [i, x] in xs.entries()` the indexed walk --
// the one loop slate had no spelling for, `for i, x in xs` being refused by the syntax rule and a
// map already walking as pairs. It is JavaScript's `Array.prototype.entries` with an array in place
// of the iterator, which is the decision `keys`, `values` and `entries` on a MAP already took.
do_object_parts(args: Args, at: Span, paired: bool) -> Step
    val name = if paired then "entries" else "values"

    takes(args, 1, at, name, "an object or an array")?

    args.at(0) match
        Array(xs) ->
            val mark = root_mark()
            val out = new_array(buf())

            hold(Array(out))

            // The length is read afresh each turn for `do_map`'s reason: nothing here calls back
            // into slate, so it cannot change -- and reading it once would still be a bound this
            // loop does not need.
            for i in 0..<xs.items.len()
                if paired
                    var pair: Buf[Value] = buf()

                    pair.push(Int(long(i)))
                    pair.push(xs.items.at(i))
                    array_push(out, Array(new_array(pair)))
                else
                    array_push(out, xs.items.at(i))

            release(mark)
            Ok(Array(out))
        Object(o) ->
            val mark = root_mark()
            val out = new_array(buf())

            hold(Array(out))

            // Walked over the table's own entries rather than through `keys` and a lookup each --
            // the order is the same one and a hash per field would buy nothing.
            for i in 0..<o.entries.len()
                val e = o.entries.at(i)

                if !e.dead && walked_key(o, e.key)
                    if paired
                        var pair: Buf[Value] = buf()

                        pair.push(e.key)
                        pair.push(e.value)
                        array_push(out, Array(new_array(pair)))
                    else
                        array_push(out, e.value)

            release(mark)
            Ok(Array(out))
        other -> fault(at, s"`${name}` needs an object or an array, and this is ${other.type_name()}")
end do_object_parts

// -- anything walkable, as an array ----------------------------------------------------------------

// `array(x)` -- everything `x` yields, in an array.
//
// **THE TYPE WORD IS THE CONVERSION, which is the rule `string`, `integer`, `real` and `boolean`
// already follow**, so there is no `Array` namespace to hang a `from` off and none is wanted: slate
// spells a conversion as the name of the type being converted to, and `array` was the one type word
// with no conversion behind it.
//
// **What it takes is exactly what `for` walks and `...` spreads** -- `walked_values` is the one
// answer all three read, so a generator, a range, a set, a map and a buffer cannot come to mean
// different things in the three places a program asks for their contents. A map yields its PAIRS,
// which is what `for [k, v] in m` already unpacks.
//
// **An array given to it is COPIED rather than handed back**, which is what a conversion means
// everywhere else and is what `values(xs)` answers too: a caller writing `array(xs)` to get
// something it may change would otherwise be changing the original.
private do_array_of(args: Args, at: Span) -> Step
    takes(args, 1, at, "array", "something to walk")?

    val mark = root_mark()
    val out = new_array(buf())

    hold(Array(out))

    val outcome = walked_into(out, args.at(0), at, "`array`", "takes")

    release(mark)
    outcome?
    Ok(Array(out))
end do_array_of

// -- what this file registers ---------------------------------------------------------------------

// **Arrays.** Every one of these is also reachable as a method -- `xs.map(f)` is `map(xs, f)`, and
// `method.sysl` is the whole of the difference. **The bare verb changes the array and the participle
// answers a new one**, so `sort` against `sorted` and `reverse` against `reversed`, and a mutation
// never hands the array back.
var n_pop: NativeFn = 0
var n_insert: NativeFn = 0
var n_remove_at: NativeFn = 0
var n_clear: NativeFn = 0
var n_map: NativeFn = 0
var n_filter: NativeFn = 0
var n_reduce: NativeFn = 0
var n_find: NativeFn = 0
var n_find_index: NativeFn = 0
var n_every: NativeFn = 0
var n_some: NativeFn = 0
var n_sort: NativeFn = 0
var n_sorted: NativeFn = 0
var n_reverse: NativeFn = 0
var n_reversed: NativeFn = 0
var n_concat: NativeFn = 0
var n_flat: NativeFn = 0
var n_sum: NativeFn = 0

// The eight an array answers that it did not before. **`at` and `slice` count from the END where
// the index is negative**, which is the whole reason JavaScript grew `at` beside `xs[i]`. `at`
// itself is `calendar.sysl`'s native, one name a reading of an instant answers too.
var n_slice: NativeFn = 0
var n_shift: NativeFn = 0
var n_unshift: NativeFn = 0
var n_flat_map: NativeFn = 0
var n_for_each: NativeFn = 0
var n_find_last: NativeFn = 0
var n_find_last_index: NativeFn = 0

// **The other two ways to walk an object -- and the same two ways to walk an ARRAY.** `entries` is
// what makes a destructuring `for` head worth having: `for [k, v] in entries(o)` is the loop every
// program over a record wants, and `for [i, x] in xs.entries()` is the indexed walk over an array.
var n_values: NativeFn = 0
var n_entries: NativeFn = 0

// **The type word that had no conversion behind it.** `array(x)` walks anything a `for` walks.
var n_array_of: NativeFn = 0

install_array(env: *EnvObj)
    n_pop = register("pop", do_pop)
    n_insert = register("insert", do_insert)
    n_remove_at = register("removeAt", do_remove_at)
    n_clear = register("clear", do_clear_array)
    n_map = register("map", do_map)
    n_filter = register("filter", do_filter)
    n_reduce = register("reduce", do_reduce)
    n_find = register("find", (args, at) -> do_find(args, at, false, false))
    n_find_index = register("findIndex", (args, at) -> do_find(args, at, true, false))
    n_find_last = register("findLast", (args, at) -> do_find(args, at, false, true))
    n_find_last_index = register("findLastIndex", (args, at) -> do_find(args, at, true, true))
    n_every = register("every", (args, at) -> do_quantify(args, at, true))
    n_some = register("some", (args, at) -> do_quantify(args, at, false))
    n_sort = register("sort", (args, at) -> do_sort(args, at, true))
    n_sorted = register("sorted", (args, at) -> do_sort(args, at, false))
    n_reverse = register("reverse", (args, at) -> do_reverse(args, at, true))
    n_reversed = register("reversed", (args, at) -> do_reverse(args, at, false))
    n_concat = register("concat", do_concat)
    n_flat = register("flat", do_flat)
    n_slice = register("slice", do_slice)
    n_shift = register("shift", do_shift)
    n_unshift = register("unshift", do_unshift)
    n_flat_map = register("flatMap", do_flat_map)
    n_for_each = register("forEach", do_for_each)
    n_sum = register("sum", do_sum)
    n_values = register("values", (args, at) -> do_object_parts(args, at, false))
    n_entries = register("entries", (args, at) -> do_object_parts(args, at, true))
    n_array_of = register("array", do_array_of)

    declare(env, "pop", Native(n_pop), false)
    declare(env, "insert", Native(n_insert), false)
    declare(env, "removeAt", Native(n_remove_at), false)
    declare(env, "clear", Native(n_clear), false)
    declare(env, "map", Native(n_map), false)
    declare(env, "filter", Native(n_filter), false)
    declare(env, "reduce", Native(n_reduce), false)
    declare(env, "find", Native(n_find), false)
    declare(env, "findIndex", Native(n_find_index), false)
    declare(env, "every", Native(n_every), false)
    declare(env, "some", Native(n_some), false)
    declare(env, "sort", Native(n_sort), false)
    declare(env, "sorted", Native(n_sorted), false)
    declare(env, "reverse", Native(n_reverse), false)
    declare(env, "reversed", Native(n_reversed), false)
    declare(env, "concat", Native(n_concat), false)
    declare(env, "flat", Native(n_flat), false)
    declare(env, "slice", Native(n_slice), false)
    declare(env, "shift", Native(n_shift), false)
    declare(env, "unshift", Native(n_unshift), false)
    declare(env, "flatMap", Native(n_flat_map), false)
    declare(env, "forEach", Native(n_for_each), false)
    declare(env, "findLast", Native(n_find_last), false)
    declare(env, "findLastIndex", Native(n_find_last_index), false)
    declare(env, "sum", Native(n_sum), false)
    declare(env, "values", Native(n_values), false)
    declare(env, "entries", Native(n_entries), false)
    declare(env, "array", Native(n_array_of), false)

    // **`toReversed` IS `reversed` UNDER JAVASCRIPT'S SPELLING and is the same native**, rather than
    // a second implementation that could come to answer differently. slate's own naming rule is the
    // bare verb against the participle -- `reverse` changes the array and `reversed` answers a new
    // one -- and JavaScript reached the same pair with `reverse` and `toReversed`; where a choice is
    // arbitrary slate spells it as JavaScript does, so both names are here and neither is deprecated.
    declare(env, "toReversed", Native(n_reversed), false)
end install_array
