module dev.slatelang.slate
@tests

import sysl.buf.{Buf, buf}
import sysl.text.{Search, StrBuilder, cstring, from_utf8_unchecked, str_builder}

// The C surface in `embed.sysl`, driven from sysl with the pointers a C caller would hand it.
//
// **These exercise the exported functions and not the archive**: `sysl build-c` is a minute of
// compiling, so the archive and a C `main` linked against it are `scripts/embed-check.sh`, which the
// release runs. What is pinned here is what those functions do -- the status, the diagnostic, which VM
// a run lands on -- with the text crossing as `*u8` and a length exactly as it crosses from C.

// A program with a name, as C hands them over: two pointers and two lengths.
private evaluated(h: *Embedded, program: string, name: string) -> i32
    val text = cstring(program)
    val file = cstring(name)

    embed_eval(h, text.ptr, text.len, file.ptr, file.len)

// The diagnostic the handle holds, as a string.
private complaint_of(h: *Embedded) -> string =
    from_utf8_unchecked(embed_error(h)[0..<embed_error_len(h)])

@test
A_PROGRAM_THAT_RUNS_TO_THE_END_ANSWERS_ZERO_AND_LEAVES_NO_COMPLAINT()
    val h = embed_new(0)

    assert_eq(evaluated(h, "val n = 6 * 7", "host.sl"), 0)
    assert_eq(embed_error_len(h), 0)
    assert_eq(complaint_of(h), "")
    embed_free(h)

@test
A_PROGRAM_SLATE_REFUSES_ANSWERS_ONE_AND_THE_DIAGNOSTIC_NAMES_THE_FILE_THE_CALLER_GAVE()
    val h = embed_new(0)

    assert_eq(evaluated(h, "nope()", "host.sl"), 1)

    val said = complaint_of(h)

    assert(said.contains("`nope` is not defined"), s"the diagnostic is the ordinary one: ${said}")
    assert(said.contains("host.sl"), s"and it names the caller's file: ${said}")
    assert_eq(embed_error_len(h), said.len)
    embed_free(h)

// The second line is reached only if the first ran, which is what says the program was executed
// rather than merely parsed.
@test
A_FAULT_AFTER_A_STATEMENT_THAT_RAN_IS_STILL_REPORTED_AGAINST_ITS_OWN_LINE()
    val h = embed_new(0)

    assert_eq(evaluated(h, "val n = 6 * 7\nnope(n)", "host.sl"), 1)
    assert(complaint_of(h).contains("host.sl:2:"), s"the fault is on line two: ${complaint_of(h)}")
    embed_free(h)

@test
THE_STATUS_A_PROGRAM_EXITS_WITH_IS_THE_ANSWER_AND_IS_NOT_A_COMPLAINT()
    val h = embed_new(0)

    assert_eq(evaluated(h, "import { exit } from slate:process\nexit(3)", "host.sl"), 3)
    assert_eq(embed_error_len(h), 0)
    embed_free(h)

// A run that fails and then one that succeeds, on one handle: the complaint is the LAST run's.
@test
A_RUN_THAT_SUCCEEDS_CLEARS_THE_COMPLAINT_THE_ONE_BEFORE_IT_LEFT()
    val h = embed_new(0)

    assert_eq(evaluated(h, "nope()", "host.sl"), 1)
    assert(embed_error_len(h) > 0)
    assert_eq(evaluated(h, "val ok = true", "host.sl"), 0)
    assert_eq(embed_error_len(h), 0)
    embed_free(h)

// The program's own VM is exactly where it was left: an embedded run lands on the handle's VM and
// on nothing else, which is `tests_vm_state.sysl`'s second-VM witness asked of the C door.
@test
AN_EMBEDDED_RUN_TOUCHES_NOTHING_OF_THE_VM_THIS_PROCESS_RUNS_ITS_OWN_PROGRAM_ON()
    reset_vm()
    current().output.clear()
    current().output.push("what the program's own VM was holding")

    val modules_before = current().module_values.len()
    val h = embed_new(0)

    assert_eq(evaluated(h, "val n = 6 * 7", "host.sl"), 0)
    embed_free(h)

    assert_eq(current().output.len(), 1, "the program's own output buffer is its own")
    assert_eq(current().output.at(0), "what the program's own VM was holding")
    assert_eq(current().module_values.len(), modules_before, "and so is its module table")
    current().output.clear()

// Three handles made and freed in turn, each running a program: a record that was freed is never
// read again, and a fresh one is not the old one's storage still holding a VM.
@test
HANDLES_ARE_MADE_AND_FREED_IN_TURN_WITHOUT_ONE_READING_ANOTHERS_STORAGE()
    for i in 0..<3
        val h = embed_new(4194304)

        assert_eq(evaluated(h, "val xs = []\nfor i in 0..<1000\n    push(xs, i)", "host.sl"), 0)
        assert_eq(embed_error_len(h), 0)
        embed_free(h)

// The table holds `MaxEmbedded` handles: one more is null rather than a crash, and freeing one gives
// its slot to the next.
@test
A_FULL_TABLE_ANSWERS_NULL_AND_A_FREED_SLOT_IS_TAKEN_AGAIN()
    var live: Buf[*Embedded] = buf()

    for i in 0..<MaxEmbedded
        val h = embed_new(1048576)

        assert(h != null, s"handle ${i} of ${MaxEmbedded} was made")
        live.push(h)

    assert(embed_new(1048576) == null, "one past the table is refused")

    embed_free(live.at(0))

    val again = embed_new(1048576)

    assert(again != null, "a freed slot is taken again")
    assert_eq(evaluated(again, "val n = 1", "host.sl"), 0)
    embed_free(again)

    for i in 1..<MaxEmbedded
        embed_free(live.at(i))

// A handle freed twice, and a pointer the table never handed out, are both ignored.
@test
FREEING_A_HANDLE_TWICE_OR_A_POINTER_NEVER_HANDED_OUT_DOES_NOTHING()
    val h = embed_new(0)

    embed_free(h)
    embed_free(h)
    embed_free(null)

    val next = embed_new(0)

    assert_eq(evaluated(next, "val ok = true", "host.sl"), 0)
    embed_free(next)

// -- one handle is one session ------------------------------------------------------------------

// A call on the handle, answered as its status and what it printed, one line each: `"0|42"`.
private printed_by(h: *Embedded, program: string) -> string
    var lines = str_builder()
    val code = embed_eval_with(h, program, "host.sl", line -> kept(line, &lines))

    s"${code}|${lines.finish()}"

private kept(line: string, into: *StrBuilder)
    if into.bytes.len() > 0 then into.push("\n")

    into.push(line)

@test
A_val_ONE_CALL_BOUND_IS_READ_BY_THE_NEXT()
    val h = embed_new(0)

    assert_eq(printed_by(h, "val x = 41"), "0|")
    assert_eq(printed_by(h, "print(x + 1)"), "0|42")
    embed_free(h)

@test
A_FUNCTION_ONE_CALL_DEFINED_IS_CALLED_BY_THE_NEXT()
    val h = embed_new(0)

    assert_eq(printed_by(h, "double(n) = n * 2"), "0|")
    assert_eq(printed_by(h, "print(double(21))"), "0|42")
    embed_free(h)

// The class is a value in the shared scope AND a type the next call's patterns resolve against,
// which are two different tables -- `is` would compile as a binding without the second.
@test
A_CLASS_ONE_CALL_DECLARED_IS_BUILT_AND_TESTED_BY_THE_NEXT()
    val h = embed_new(0)

    assert_eq(printed_by(h, "class Point\n    var x\n    var y"), "0|")
    assert_eq(printed_by(h, "val p = Point.new(1, 2)\nprint(p is Point)\nprint(p.x + p.y)\nprint(3 is Point)"),
              "0|true\n3\nfalse")
    embed_free(h)

// An import binds its names at the top level like any other binding, so the next call has them; an
// import written again reads the module the first one ran rather than running it a second time.
@test
AN_IMPORT_ONE_CALL_MADE_IS_THERE_FOR_THE_NEXT_AND_MAY_BE_WRITTEN_AGAIN()
    val h = embed_new(0)

    assert_eq(printed_by(h, "import { cpus } from slate:process"), "0|")
    assert_eq(printed_by(h, "print(cpus() > 0)"), "0|true")
    assert_eq(printed_by(h, "import { cpus } from slate:process\nprint(cpus() > 0)"), "0|true")
    embed_free(h)

@test
TWO_HANDLES_ARE_TWO_SESSIONS_AND_A_REFUSAL_ON_ONE_LEAVES_THE_OTHER_ALONE()
    val a = embed_new(0)
    val b = embed_new(0)

    assert_eq(printed_by(a, "val x = 1"), "0|")
    assert_eq(printed_by(b, "print(x)"), "1|")

    val said = complaint_of(b)

    assert(said.contains("`x` is not defined"), s"the other handle never bound it: ${said}")
    assert_eq(printed_by(a, "print(x)"), "0|1")
    embed_free(a)
    embed_free(b)

@test
A_REFUSED_CALL_BETWEEN_TWO_GOOD_ONES_LEAVES_THE_SESSION_AS_IT_WAS()
    val h = embed_new(0)

    assert_eq(printed_by(h, "val x = 1"), "0|")
    assert_eq(printed_by(h, "nope("), "1|")
    assert(embed_error_len(h) > 0)
    assert_eq(printed_by(h, "print(x)"), "0|1")
    assert_eq(embed_error_len(h), 0)
    embed_free(h)

// A compile refusal that got as far as compiling a module it imported takes the module back out, so
// the next call's imports still read the right module's exports.
@test
A_CALL_THE_CHECKER_REFUSES_AFTER_AN_IMPORT_COMPILED_LEAVES_THE_MODULES_IN_STEP()
    val h = embed_new(0)

    assert_eq(printed_by(h, "import { cpus } from slate:process\nnope()"), "1|")
    assert_eq(printed_by(h, "val n = 1\nprint(n)"), "0|1")
    assert_eq(printed_by(h, "import { cpus } from slate:process\nprint(cpus() > 0)"), "0|true")
    embed_free(h)

// **A name an earlier call bound shadows the builtin of that name, in the checker as in the machine.**
// `count` carries a fixed signature, so a check that still saw the builtin under the session's own
// `count` would refuse `count()` for its count of arguments -- and the machine would have called the
// session's function. The checker may only refuse what the machine would.
@test
A_SESSION_FUNCTION_NAMED_LIKE_A_BUILTIN_IS_WHAT_A_LATER_C_CALL_CHECKS_AGAINST()
    val h = embed_new(0)

    assert_eq(printed_by(h, "count() = 7"), "0|")
    assert_eq(printed_by(h, "print(count())"), "0|7")
    assert_eq(printed_by(h, "print(count(1))"), "0|7")
    embed_free(h)

@test
A_SESSION_val_NAMED_LIKE_A_BUILTIN_SHADOWS_IT_FOR_A_LATER_C_CALL()
    val h = embed_new(0)

    assert_eq(printed_by(h, "val unique = (a, b, c) -> a + b + c"), "0|")
    assert_eq(printed_by(h, "print(unique(1, 2, 3))"), "0|6")
    embed_free(h)

// Within one program the definition shadows the builtin as it always has.
@test
A_BUILTIN_SHADOWED_WITHIN_ONE_C_CALL_IS_STILL_THE_PROGRAMS_OWN()
    val h = embed_new(0)

    assert_eq(printed_by(h, "count() = 7\nprint(count())"), "0|7")
    embed_free(h)

// A builtin the session never rebound keeps its signature, so the check still runs for a session.
@test
A_BUILTIN_NO_C_CALL_REBOUND_IS_STILL_CHECKED_IN_A_LATER_CALL()
    val h = embed_new(0)

    assert_eq(printed_by(h, "count() = 7"), "0|")
    assert_eq(printed_by(h, "print(unique())"), "1|")

    val said = complaint_of(h)

    assert(said.contains("unique"), s"the ordinary sentence names the builtin: ${said}")
    embed_free(h)

// A function reads the session's top level by name, so a later call that writes or rebinds a name
// is what the function sees -- not a copy the defining call kept of it.
@test
A_FUNCTION_SEES_WHAT_A_LATER_CALL_WROTE_OR_REBOUND()
    val h = embed_new(0)

    assert_eq(printed_by(h, "var n = 0\nval k = 1\nbump() =\n    n = n + 1\n    n\nshow() = k"), "0|")
    assert_eq(printed_by(h, "n = 10\nval k = 2"), "0|")
    assert_eq(printed_by(h, "print(bump())\nprint(show())"), "0|11\n2")
    embed_free(h)

// Lua's rule: what ran before the fault stays bound.
@test
A_FAULT_AFTER_A_BINDING_KEEPS_THE_BINDING()
    val h = embed_new(0)

    assert_eq(printed_by(h, "val y = 2\nval empty = []\nempty.pop()"), "1|")
    assert(complaint_of(h).contains("host.sl:3:"), s"the fault is the pop: ${complaint_of(h)}")
    assert_eq(printed_by(h, "print(y)"), "0|2")
    embed_free(h)

// A function one call defined faults in a later call, and the diagnostic is drawn against the text
// it was written in -- which the session has kept.
@test
A_FAULT_IN_A_FUNCTION_AN_EARLIER_CALL_DEFINED_POINTS_AT_THAT_CALLS_TEXT()
    val h = embed_new(0)

    assert_eq(evaluated(h, "\n\nlast(xs) = xs.pop()", "defs.sl"), 0)
    assert_eq(printed_by(h, "last([])"), "1|")
    assert(complaint_of(h).contains("defs.sl:3:"), s"drawn against the defining call: ${complaint_of(h)}")
    embed_free(h)

// The session's heap is collected as a program's is: every call rebinds `big`, so what the earlier
// ones built is garbage and the live figure stays near one array's worth.
@test
TWO_HUNDRED_CALLS_EACH_BUILDING_AN_ARRAY_DO_NOT_GROW_THE_HEAP_WITHOUT_BOUND()
    val h = embed_new(0)

    for i in 0..<200
        assert_eq(printed_by(h, "val big = []\nfor i in 0..<5000\n    big.push(i)"), "0|")

    assert_eq(printed_by(h, "print(big.length)"), "0|5000")

    // Measured after a collection, so the figure is what the session still reaches rather than what
    // the schedule has not got round to.
    val was = enter(&h.vm)

    collect_now()

    val live = heap_in_use()

    leave(was)
    assert(live < 4194304, s"the heap holds ${live} bytes after 200 calls")
    embed_free(h)

// **The drain waits for the timer**, node's rule and `run`'s: a call does not return while its own
// timer is pending, so the call that armed it is the one that prints, and the next call sees nothing
// left over.
@test
A_TIMER_A_CALL_ARMS_FIRES_BEFORE_THAT_CALL_RETURNS()
    val h = embed_new(0)

    assert_eq(printed_by(h, "setTimeout(() -> print(\"later\"), 10)\nprint(\"now\")"), "0|now\nlater")
    assert_eq(printed_by(h, "print(\"next\")"), "0|next")
    embed_free(h)

@test
THE_VERSION_THE_C_SURFACE_ANSWERS_IS_THE_ONE_slate_REPORTS()
    val p = embed_version()

    assert_eq(from_utf8_unchecked(p[0..<SlateVersion.len]), SlateVersion)
    assert_eq(p[SlateVersion.len], 0u8, "and it is NUL-terminated")

// -- values and calls (`embed_values.sysl`) --------------------------------------------------------

// A string handed over as C hands one: a pointer and a length.
private text_handle(h: *Embedded, s: string) -> u64
    val c = cstring(s)

    embed_string(h, c.ptr, c.len)

// A top-level name, asked for as C asks.
private global(h: *Embedded, name: string) -> u64
    val c = cstring(name)

    embed_global(h, c.ptr, c.len)

// A field, asked for and set as C does.
private field(h: *Embedded, object: u64, key: string) -> u64
    val c = cstring(key)

    embed_get(h, object, c.ptr, c.len)

private set(h: *Embedded, object: u64, key: string, v: u64) -> i32
    val c = cstring(key)

    embed_set(h, object, c.ptr, c.len, v)

// The bytes a string handle points at, read back as C would: the pointer and the byte count.
private string_of(h: *Embedded, v: u64) -> string =
    from_utf8_unchecked(embed_string_ptr(h, v)[0..<embed_string_len(h, v)])

// What `slate_show` rendered, through its pointer and its length.
private shown(h: *Embedded, v: u64) -> string
    val p = embed_show(h, v)

    from_utf8_unchecked(p[0..<embed_show_len(h)])

// A call with the arguments laid out as C lays them: an array of handles and a count.
private call(h: *Embedded, f: u64, args: Buf[u64], out: *u64) -> i32
    if args.len() == 0 then return embed_call(h, f, null, 0, out)

    var laid: [8]u64 = [0; 8]

    for i in 0..<args.len()
        laid[i] = args.at(i)

    embed_call(h, f, &laid[0], args.len(), out)
end call

@test
EVERY_SCALAR_C_MAKES_READS_BACK_AS_ITS_OWN_KIND_AND_VALUE()
    val h = embed_new(0)
    val i = embed_int(h, -42)
    val r = embed_real(h, 2.5)
    val yes = embed_bool(h, 7)
    val no = embed_bool(h, 0)
    val nothing = embed_null(h)
    val s = text_handle(h, "héllo")

    assert(i != 0 && r != 0 && yes != 0 && no != 0 && nothing != 0 && s != 0, "no handle is ever 0")
    assert_eq(embed_kind(h, i), 2)
    assert_eq(embed_to_int(h, i), -42)
    assert_eq(embed_kind(h, r), 3)
    assert_eq(embed_to_real(h, r), 2.5)
    assert_eq(embed_kind(h, yes), 1)
    assert_eq(embed_to_bool(h, yes), 1)
    assert_eq(embed_to_bool(h, no), 0)
    assert_eq(embed_kind(h, nothing), 0)
    assert_eq(embed_kind(h, s), 4)
    assert_eq(embed_string_len(h, s), 6usize, "a length in bytes, and é is two of them")
    assert_eq(string_of(h, s), "héllo")
    assert_eq(embed_kind(h, 0), -1, "0 is no value")

    embed_release(h, i)

    assert_eq(embed_kind(h, i), -1, "and neither is a released handle")
    embed_free(h)

@test
A_FUNCTION_ONE_EVAL_DEFINED_IS_CALLED_FROM_C_WITH_A_VALUE_C_MADE()
    val h = embed_new(0)

    assert_eq(evaluated(h, "double(n) = n * 2", "lib.sl"), 0)

    val f = global(h, "double")

    assert_eq(embed_kind(h, f), 7)

    var args: Buf[u64] = buf()
    var out: u64 = 0

    args.push(embed_int(h, 21))

    assert_eq(call(h, f, args, &out), 0)
    assert_eq(embed_error_len(h), 0usize)
    assert_eq(embed_to_int(h, out), 42)
    embed_free(h)

@test
A_STRING_GOES_IN_FROM_C_AND_A_STRING_COMES_BACK()
    val h = embed_new(0)

    assert_eq(evaluated(h, "greet(name) = \"hi \" + name", "lib.sl"), 0)

    var args: Buf[u64] = buf()
    var out: u64 = 0

    args.push(text_handle(h, "Zoë"))

    assert_eq(call(h, global(h, "greet"), args, &out), 0)
    assert_eq(embed_kind(h, out), 4)
    assert_eq(string_of(h, out), "hi Zoë")
    embed_free(h)

@test
AN_ARRAY_C_BUILT_IS_SUMMED_BY_slate_AND_AN_ARRAY_slate_ANSWERS_IS_READ_BY_C()
    val h = embed_new(0)

    assert_eq(evaluated(h, "sum(xs)\n    var total = 0\n    for x in xs\n        total += x\n    total\nthree() = [1, 2, 3]", "lib.sl"), 0)

    val xs = embed_array(h)

    assert_eq(embed_push(h, xs, embed_int(h, 1)), 0)
    assert_eq(embed_push(h, xs, embed_int(h, 2)), 0)
    assert_eq(embed_push(h, xs, embed_int(h, 3)), 0)
    assert_eq(embed_push(h, embed_int(h, 5), embed_int(h, 3)), 1, "only an array takes a push")
    assert_eq(embed_len(h, xs), 3usize)

    var args: Buf[u64] = buf()
    var out: u64 = 0

    args.push(xs)

    assert_eq(call(h, global(h, "sum"), args, &out), 0)
    assert_eq(embed_to_int(h, out), 6)

    var answer: u64 = 0

    assert_eq(call(h, global(h, "three"), buf(), &answer), 0)
    assert_eq(embed_kind(h, answer), 5)
    assert_eq(embed_len(h, answer), 3usize)
    assert_eq(embed_to_int(h, embed_at(h, answer, 1)), 2)
    assert_eq(embed_at(h, answer, 3), 0u64, "past the end is no value")
    embed_free(h)

@test
AN_OBJECT_C_BUILT_IS_READ_BY_slate_AND_AN_OBJECT_slate_ANSWERS_IS_READ_BY_C()
    val h = embed_new(0)

    assert_eq(evaluated(h, "nameOf(p) = p.name\npoint() = { x: 1, y: 2 }", "lib.sl"), 0)

    val person = embed_object(h)

    assert_eq(set(h, person, "name", text_handle(h, "Ada")), 0)
    assert_eq(set(h, embed_null(h), "name", embed_null(h)), 1, "only an object takes a field")

    var args: Buf[u64] = buf()
    var out: u64 = 0

    args.push(person)

    assert_eq(call(h, global(h, "nameOf"), args, &out), 0)
    assert_eq(string_of(h, out), "Ada")

    var answer: u64 = 0

    assert_eq(call(h, global(h, "point"), buf(), &answer), 0)
    assert_eq(embed_kind(h, answer), 6)
    assert_eq(embed_to_int(h, field(h, answer, "y")), 2)
    assert_eq(field(h, answer, "z"), 0u64, "a field it does not have is no value")
    embed_free(h)

@test
A_CALL_FROM_C_THAT_FAULTS_ANSWERS_ONE_AND_SAYS_WHERE_IN_THE_FUNCTIONS_OWN_FILE()
    val h = embed_new(0)

    assert_eq(evaluated(h, "val a = 1\nboom(n)\n    throw \"it went wrong\"", "lib.sl"), 0)

    var args: Buf[u64] = buf()
    var out: u64 = 99

    args.push(embed_int(h, 1))

    assert_eq(call(h, global(h, "boom"), args, &out), 1)
    assert_eq(out, 0u64, "no answer is written")

    val said = complaint_of(h)

    assert(said.contains("it went wrong"), s"the fault's own sentence: ${said}")
    assert(said.contains("lib.sl:3:"), s"at the line in the file the function was written in: ${said}")
    embed_free(h)

@test
A_NAME_NOTHING_DEFINED_IS_NO_VALUE_TO_C_AND_A_CALL_OF_A_NUMBER_IS_REFUSED_IN_A_SENTENCE()
    val h = embed_new(0)

    assert_eq(global(h, "nowhere"), 0u64)

    var out: u64 = 0

    assert_eq(call(h, embed_int(h, 3), buf(), &out), 1)
    assert(complaint_of(h).contains("is not something that can be called"), complaint_of(h))
    assert_eq(call(h, 0, buf(), &out), 1)
    assert(complaint_of(h).contains("names no value"), complaint_of(h))
    embed_free(h)

@test
AN_ASYNC_FUNCTION_CALLED_FROM_C_RUNS_THROUGH_ITS_AWAIT_TO_ITS_ANSWER()
    val h = embed_new(0)

    assert_eq(evaluated(h, "async twice(n)\n    val got = await resolve(n)\n    got * 2", "lib.sl"), 0)

    var args: Buf[u64] = buf()
    var out: u64 = 0

    args.push(embed_int(h, 4))

    assert_eq(call(h, global(h, "twice"), args, &out), 0, complaint_of(h))
    assert_eq(embed_kind(h, out), 2)
    assert_eq(embed_to_int(h, out), 8)
    embed_free(h)

// The values C holds are made, a call allocates enough to collect many times, and every one still
// reads what it held -- which is the table being a root. Then everything is released and the round
// run again, and the table never grows past the size the first round took it to -- which is the free
// list.
@test
WHAT_C_HOLDS_SURVIVES_A_CALL_THAT_COLLECTS_AND_A_RELEASED_SLOT_IS_REUSED()
    val h = embed_new(0)

    assert_eq(evaluated(h, "churn(n)\n    var count = 0\n    for i in 0..<n\n        val o = { i: i, tag: [i, \"t\"] }\n        count += o.i - i + 1\n    count", "churn.sl"), 0)

    var high: usize = 0

    for round in 0..<50
        var made: Buf[u64] = buf()

        val s = text_handle(h, "kept across a collection")
        val xs = embed_array(h)
        val o = embed_object(h)

        embed_push(h, xs, text_handle(h, "a"))
        embed_push(h, xs, embed_real(h, 1.5))
        set(h, o, "k", text_handle(h, "v"))

        val f = global(h, "churn")
        var args: Buf[u64] = buf()
        var out: u64 = 0

        args.push(embed_int(h, 200000))

        val before = h.vm.collections

        assert_eq(call(h, f, args, &out), 0, complaint_of(h))
        assert(h.vm.collections > before, "the call collected")
        assert_eq(embed_to_int(h, out), 200000)
        assert_eq(string_of(h, s), "kept across a collection")
        assert_eq(shown(h, xs), "[\"a\", 1.5]")
        assert_eq(string_of(h, field(h, o, "k")), "v")

        if round == 0 then high = h.vm.host_held.len()

        assert(h.vm.host_held.len() <= high, s"round ${round} held ${h.vm.host_held.len()} slots, past ${high}")

        // Every handle this round made, the ones read back above included, handed back.
        for id in 1..<h.vm.host_held.len()
            made.push(u64(id))

        for id in made.view()
            embed_release(h, id)

        embed_release(h, s)
    end for

    embed_free(h)
end WHAT_C_HOLDS_SURVIVES_A_CALL_THAT_COLLECTS_AND_A_RELEASED_SLOT_IS_REUSED

@test
AN_ARRAY_SHOWN_TO_C_READS_AS_slate_PRINTS_IT()
    val h = embed_new(0)

    assert_eq(evaluated(h, "mixed() = [1, \"two\", [3.5, null], { k: true }]", "lib.sl"), 0)

    var out: u64 = 0

    assert_eq(call(h, global(h, "mixed"), buf(), &out), 0)
    assert_eq(shown(h, out), "[1, \"two\", [3.5, null], {k: true}]")
    embed_free(h)
