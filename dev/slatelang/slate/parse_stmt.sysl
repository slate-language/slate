module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{from_utf8_unchecked, str_builder}

// The statement forms, one function per word a statement can begin with -- and the two that connect
// files, `import` and `export`.
//
// **Cut out of `parse.sysl` when that file passed a thousand lines**, on the heading that was
// already there and where nothing crosses at all: everything left there is the parser ITSELF -- the
// `Parser` struct, the `TokenStream` it implements, and where a parse begins -- and everything here
// is one form after another, told apart by its first word. `parse_stmts` calls `parse_stmt` across
// the cut and both were public already, `define.sysl` having reached for the second of them.
//
// **An expression is `expr.sysl` and a definition is `define.sysl`**, both of which this file calls
// into: a statement is where a scope closes, so the complaint about a `_` that never became a
// parameter is raised here rather than in either of them.

// -- statements ---------------------------------------------------------------------------------

// One statement, with the complaint about a `_` that found no function to be a parameter of.
//
// **This is where the check belongs because a statement is where the last scope closes.** An
// argument, a bracketed group and a right-hand side are all inside one, so a `_` still unclaimed
// when a statement ends has nowhere left to go.
//
// Not `private`: reached from `define.sysl`, a one-line body being a statement.
parse_stmt(p: *Parser) -> Stmt
    val s = one_stmt(p)

    ph_unbound(p)
    s
end parse_stmt

private one_stmt(p: *Parser) -> Stmt
    // **A clause is read before anything else and leaves `clauses_ok` alone**, so a run of them at
    // the head of a body stays a run; everything below puts the flag down, and the words go back to
    // being ordinary names for the rest of the body.
    if at_contract_clause(p) then return parse_clause(p)

    p.clauses_ok = false

    p.peek() match
        At -> parse_annotated(p)
        Import -> parse_import(p)
        Export -> parse_export(p)
        Val -> parse_binding(p, true)
        Var -> parse_binding(p, false)
        Return -> parse_return(p)
        Throw -> parse_throw(p)
        Break -> parse_break(p)
        Continue -> parse_continue(p)

        // **The loops are not here, because they are expressions**: `while`, `for`, `loop`, `do` and
        // the label one of them may carry all begin one, so they reach `nud` through
        // `parse_expr_stmt` like any other value.
        // **`async` is not on its own a definition.** `async f(x) = ...` defines one and
        // `async x -> x` is an expression, so the same shape check runs one token further along.
        Async ->
            if at_definition_from(p, 1) then parse_def(p) else parse_expr_stmt(p)
        _ ->
            if at_external_decl(p, 0) then parse_external_decl(p)
            elif at_type_decl(p, 0) then parse_type_decl(p, false)
            elif at_class_decl(p, 0) then parse_class_decl(p, false)
            elif at_data_decl(p, 0) then parse_data_decl(p, false)
            elif at_definition_from(p, 0) then parse_def(p)
            else parse_expr_stmt(p)
end one_stmt

// Whether what stands at `i` is `external name`.
//
// **`external` is a SOFT word, as `type` and `class` are**, so a program that already calls something
// `external` stays a program: two tokens settle it, and a name followed by another name begins
// nothing else in the grammar.
private at_external_decl(p: *Parser, i: usize) -> bool
    if p.peek_kind_at(i) != Ident then return false
    if p.text_at(i) != "external" then return false

    p.peek_kind_at(i + 1) == Ident
end at_external_decl

// `external localStorage`, and `external clipboard = "navigator.clipboard"`.
//
// **The declaration says where a value came from and nothing about what it can do.** There is no
// signature to write and none to keep in step with a host that changes underneath it -- what the
// value can do is asked of the host at the moment a program asks, which is the whole of the design.
private parse_external_decl(p: *Parser) -> Stmt
    val start = p.here()

    p.bump()

    // **The top-level rule is `import`'s and is here for the same reason**: what a file is built on
    // is read before anything runs, and a declaration inside a block would be one the reader of the
    // file's first page could not see.
    if p.depth != 0
        p.fault(start, "`external` belongs to the top level of a file -- what a file takes from its host is read before anything in it runs, so a declaration inside a block would have nothing to say")

    val name = parse_name(p, "a name for the host value")

    if !p.accept(Assign) then return stmt(start.to(p.just_taken()), ExternalDecl(name, name))

    val at = p.here()

    if !p.at(StrLit)
        p.report.add(expected(at, "a quoted path like `\"navigator.clipboard\"`", p.found(at)))
        return stmt(start.to(p.just_taken()), ExternalDecl(name, name))

    p.bump()

    val path = read_str_at(p, at)

    if !dotted_names(path)
        p.fault(at, s"`${path}` is not a path to a host value -- a path is a name, or names with `.` between them, and everything else about a value is an operation on it rather than part of where it was found")

    stmt(start.to(p.just_taken()), ExternalDecl(name, path))
end parse_external_decl

// Whether a path is one name, or names with `.` between them, and nothing else.
private dotted_names(path: string) -> bool
    if path == "" then return false

    var here: usize = 0

    for i in 0..<path.bytes.len
        val c = path.bytes[i]

        if c == u8('.')
            if here == 0 then return false

            here = 0
        else
            val ok = if here == 0 then is_ident_start(c) || c == u8('$') else is_ident_cont(c) || c == u8('$')

            if !ok then return false

            here = here + 1
    end for

    here > 0
end dotted_names

// Whether what stands at `i` is `type Name =`.
//
// **`type` is a SOFT word**, so a program may still call a variable `type`. Three tokens settle it
// and the parser has the cursor, which is the same test `end` gets and for the same reason.
private at_type_decl(p: *Parser, i: usize) -> bool
    if p.peek_kind_at(i) != Ident then return false
    if p.text_at(i) != "type" then return false
    if p.peek_kind_at(i + 1) != Ident then return false

    // `type Pair[A, B] = ...` -- the same list of bare names `at_definition_from` steps over, read by
    // the same helper and for the same reason: `type` is a soft word, so a program using it as a
    // variable name has to stay a program.
    var j = i + 2

    // **`names_end` counts from the start of the token list and `peek_kind_at` counts from the
    // cursor**, so the position is added on the way in and taken off the way out. Handing it a
    // relative index reads every token from the wrong place, which for a file's FIRST statement is
    // the same place -- so it works until the second one.
    if p.peek_kind_at(j) == LBracket
        names_end(p.toks, p.toks.position + j, LBracket, RBracket, Comma, Ident) match
            Some(past) -> j = past - p.toks.position
            None -> return false

    p.peek_kind_at(j) == Assign
end at_type_decl

// `type Point = { x: num, y: num }`.
//
// **The right-hand side is an ordinary PATTERN**, read by the parser that reads a `match` arm's. That
// is the whole design: slate already had structural tests over object shapes, and a type is one of
// those given a name -- so `p is Point` is the `is` slate already had, and nothing new runs.
private parse_type_decl(p: *Parser, public: bool) -> Stmt
    val start = p.here()

    p.bump()

    val name = parse_name(p, "a name for the type")

    // `type Pair[A, B] = { first: A, second: B }`, and a use of it says what it is generic over.
    val type_params: Buf[string] = if p.at(LBracket) then type_parameters(p) else buf()

    p.expect(Assign, "`=` and the shape the type stands for")

    push_type_params(type_params)

    val body = parse_type(p)

    pop_type_params()

    // **The parameters are registered WITH the pattern rather than beside it**, so a generic type
    // travels between files the way every other type does -- a registered pattern is what an import
    // brings across, and nothing had to learn to carry a second table next to it.
    val pat = if type_params.is_empty()
        body
    else
        pattern(body.span, GenericPat(type_params, body))

    if p.depth != 0
        p.fault(start, "a type belongs to the top level of a file -- it is resolved while compiling, and one declared inside a block would not be there to resolve against")
    else
        p.type_names.push(name)
        p.type_pats.push(pat)
        p.type_public.push(public)

    stmt(start.to(p.just_taken()), TypeDecl(name, pat))
end parse_type_decl

// `val name = ...` and `var name = ...`.
// `val x = e`, and `val [a, b] = e` / `val { name } = e` where the value is taken apart.
//
// **The first token after the word decides, and nothing else does.** A `[` or a `{` can begin no
// name, so the two forms cannot be confused -- and reading a *pattern* in every case would change
// what an ordinary binding means: a bare name in pattern position is a type test where it names a
// type, so `val string = 5` would stop binding `string` and start testing against it. Keeping the
// plain case a name is what makes the feature free.
private parse_binding(p: *Parser, immutable: bool) -> Stmt
    val start = p.here()

    p.bump()

    if p.at(LBracket) || p.at(LBrace)
        val pat = parse_pattern(p)

        p.expect(Assign, "`=` and a value")

        val opened = parse_body(p)

        return stmt(start.to(p.just_taken()), Unpack(pat, opened, immutable))
    end if

    val name = parse_name(p, "a name for the binding")

    // **`val x: T = e` is the binding plus the check a PARAMETER already turns into**, so nothing
    // new runs: the annotation becomes a `CheckType` standing immediately after the binding, tested
    // where the value arrives, and the two travel as a `Group` because one line of source wrote both.
    //
    // **On a `var` it is TypeScript's `let`: the declared type is what the name IS, and every
    // assignment is checked against it.** An unannotated `var` is still the union of everything ever
    // assigned to it, which is what the checker can work out for itself -- an annotation is the
    // reader saying the thing they want held to, and the wider type is the one they meant.
    var declared: Option[Stmt] = None

    if p.accept(Colon)
        val tat = p.here()
        val tpat = parse_type(p)
        val said = tat.to(p.just_taken())

        declared = Some(stmt(said, CheckType(name, p.text(said), tpat)))

    p.expect(Assign, "`=` and a value")

    // **A binding's value is one of the three places a `_` becomes a function**, so
    // `val longer = _.length > 3` names a predicate without writing its parameter twice.
    val mark = ph_open(p)
    val init = ph_close(p, mark, parse_body(p))
    val at = start.to(p.just_taken())
    val bound = stmt(at, if immutable then Val(name, init) else Var(name, init))

    declared match
        None -> bound
        Some(check) ->
            var both: Buf[Stmt] = buf()

            both.push(bound)
            both.push(check)

            stmt(at, Group(both))
end parse_binding

// -- modules -------------------------------------------------------------------------------------

// `export` in front of a binding or a definition.
//
// **The word adds a name to the file's export list and changes nothing else**, which is why there is
// no `Export` node: the statement it prefixes is parsed by the very function that would have parsed
// it without the word, and compiles identically. What the export list is *for* is the object built
// at the end of the module's chunk, and that is the only place it is read.
//
// TypeScript's rule, taken deliberately: a name is private unless it says otherwise. The other
// direction -- everything public, with a way to hide -- is the one that cannot be changed later
// without breaking every program that relied on reaching in.
private parse_export(p: *Parser) -> Stmt
    val start = p.here()
    val top = p.depth == 0

    p.bump()

    if !top
        p.fault(start, "`export` belongs to the top level of a file -- what a module lets others see has to be known before it runs, and a name exported from inside a block would not be")

    // **`export type` is how a type crosses a file**, and it reads the same way every other export
    // does. A type that is not exported is this file's own, exactly as a `val` is.
    //
    // **It lands in two places, as `export class` does**, a type being a shape other files may test
    // against and a value other files may hold. `parse_type_decl` writes the type half, so only the
    // value half is left here.
    if at_type_decl(p, 0)
        val t = parse_type_decl(p, top)

        if top
            *t.kind match
                TypeDecl(name, _) -> p.exports.push(name)
                _ -> ()

        return t
    end if

    // **`export class` exports the name once and it lands in two places**, because a class is two
    // things under one name: a value other files may reach, and a type other files may test against.
    // `parse_class_decl` writes the type half, so only the value half is left here.
    if at_class_decl(p, 0)
        val c = parse_class_decl(p, top)

        if top
            *c.kind match
                Val(name, _) -> p.exports.push(name)
                _ -> ()

        return c
    end if

    // **`export data` exports EVERY name it wrote**, which is what makes it different from a class:
    // one line declares the data type and one value for each variant, and a file importing `Shape`
    // and not `Circle` could match nothing. `parse_data_decl` has already written all of their type
    // halves, so what is left here is their value halves -- and a group holds nothing but `val`s.
    if at_data_decl(p, 0)
        val d = parse_data_decl(p, top)

        if top
            *d.kind match
                Group(stmts) ->
                    for i in 0..<stmts.len()
                        *stmts.at(i).kind match
                            Val(name, _) -> p.exports.push(name)
                            _ -> ()
                _ -> ()

        return d
    end if

    val s = p.peek() match
        Val -> parse_binding(p, true)
        Var -> parse_binding(p, false)

        // `export async f(x) = ...`. The shape check runs one token further along, exactly as
        // `parse_stmt`'s does, because `async` alone does not make a definition.
        Async -> if at_definition_from(p, 1) then parse_def(p) else bad_export(p, start)
        _ -> if at_definition_from(p, 0) then parse_def(p) else bad_export(p, start)

    if top
        *s.kind match
            Val(name, _) -> p.exports.push(name)
            Var(name, _) -> p.exports.push(name)
            Def(name, _, _, _, _) -> p.exports.push(name)
            _ -> ()

    s
end parse_export

// `export` in front of something that has no name to export.
private bad_export(p: *Parser, at: Span) -> Stmt
    p.fault(at, "`export` goes in front of a `val`, a `var` or a definition, and there is nothing here for it to name")
    parse_expr_stmt(p)

// `@test` in front of a definition, and the four annotations that say what runs around one.
//
// **The annotation adds a name to one of the file's lists and changes nothing else**, which is the
// same arrangement `export` has and for the same reason: the function it marks compiles exactly as
// it would have without it, so `StmtKind` needs nothing new.
//
// **`@` begins nothing else at the start of a statement.** It is a pattern operator, which is only
// ever read with a subject already to its left, so taking it here costs the grammar nothing.
private parse_annotated(p: *Parser) -> Stmt
    val start = p.here()
    val top = p.depth == 0

    p.bump()

    val word = parse_name(p, "an annotation name")

    if !is_annotation(word)
        p.fault(start.to(p.just_taken()), s"`@${word}` is not an annotation slate knows -- ${AnnotationChoices}")

    if !top
        p.fault(start, s"`@${word}` belongs to the top level of a file -- what a file's tests are, and what runs around them, is found before the program runs, and one written inside a block would not be")

    // The annotation is written on its own line, as sysl's is.
    p.skip_newlines()

    val at_def = p.at(Async) && at_definition_from(p, 1) || at_definition_from(p, 0)

    if !at_def
        p.fault(p.here(), s"`@${word}` goes in front of a definition -- a test, and everything that runs around one, is a function of no arguments")
        return parse_expr_stmt(p)
    end if

    val s = parse_def(p)

    if top && is_annotation(word)
        *s.kind match
            Def(name, params, _, _, _) ->
                if params.len() != 0
                    val what = if word == "test" then "a test" else s"`@${word}`"

                    p.fault(s.span, s"${what} takes no arguments, and `${name}` takes ${params.len()}")

                if word == "test" then p.tests.push(name) else claim_hook(p, word, name, s.span)
            _ -> ()

    s
end parse_annotated

// Every annotation there is, in the sentence a wrong one is refused with.
private const AnnotationChoices: string = "`@test`, `@setup`, `@teardown`, `@setupAll` and `@teardownAll` are the ones there are"

private is_annotation(word: string) -> bool =
    word == "test" || word == "setup" || word == "teardown" || word == "setupAll" || word == "teardownAll"

// One `@setup`, `@teardown`, `@setupAll` or `@teardownAll` to a file, and a second names both.
//
// **Refused rather than taken as a replacement.** Two `@setup`s in one file is somebody reading half
// the file and adding what they thought was missing, and quietly running only the second is the one
// outcome that would leave the first's work undone with nothing to read about it.
private claim_hook(p: *Parser, word: string, name: string, at: Span)
    val had =
        if word == "setup" then p.setup
        elif word == "teardown" then p.teardown
        elif word == "setupAll" then p.setup_all
        else p.teardown_all

    if had != ""
        p.fault(at, s"a file has one `@${word}` at most, and `${had}` is already it -- `${name}` would be the second")
        return
    end if

    if word == "setup" then p.setup = name
    elif word == "teardown" then p.teardown = name
    elif word == "setupAll" then p.setup_all = name
    else p.teardown_all = name
end claim_hook

// `import { a, b as c } from "./util.sl"`, `import * as util from "./util.sl"`, and
// `import styles from "./button.css"`.
//
// **No default export.** It is the part of TypeScript's module system its own users regret: a
// default has no name, so every importer invents one and the same thing is called four things
// across a codebase. Everything here is named where it is written and named again where it is read.
//
// **A BARE NAME IS AN ASSET AND NOT A DEFAULT, AND THE EXTENSION IS WHAT SAYS SO.** A file that is
// not slate source has no exports to take a name out of -- it is one value, so one name is the only
// shape the import could have -- and that is exactly the reading a default export does not have. The
// two are told apart by the specifier and never by what the writer meant: `"./button.css"` is an
// asset and `"./util.sl"` is a module, each refused in the other's form with a sentence saying which
// spelling it wanted.
private parse_import(p: *Parser) -> Stmt
    val start = p.here()

    p.bump()

    if p.depth != 0
        p.fault(start, "`import` belongs to the top level of a file -- what a file depends on is worked out before it runs, so an import inside a block would have nothing to say")

    // **The asset form is read where a `{` or a `*` was expected**, so nothing already written can
    // change meaning: `import` followed by a bare name was a parse error until 0.0.30.
    if p.at(Ident)
        val name = parse_name(p, "a name for what the file holds")

        expect_soft(p, "from")

        val (path, path_at, origin) = parse_module_path(p)

        if origin != Origin.FromFile
            p.fault(path_at, s"`${name}` names a FILE beside this one, so it is written in quotes -- an unquoted specifier is a package or one of slate's own modules, and neither of those is a file to read")
        elif ends_with_sl(path)
            p.fault(path_at, s"`${path}` is slate source, and slate has no default export -- write `import { ... } from \"${path}\"` and name what you want out of it")

        return stmt(start.to(p.just_taken()), ImportAsset(path, path_at, name))
    end if

    if p.accept(Star)
        expect_soft(p, "as")

        val alias = parse_name(p, "a name for the module")

        expect_soft(p, "from")

        val (path, path_at, origin) = parse_module_path(p)

        refuse_asset_as_module(p, path, path_at, origin)

        return stmt(start.to(p.just_taken()), ImportAll(path, path_at, origin, alias))
    end if

    var names: Buf[string] = buf()
    var locals: Buf[string] = buf()

    p.expect(LBrace, "`{`, `*` or a name")

    if !p.at(RBrace)
        loop
            val n = parse_name(p, "an exported name")

            names.push(n)
            locals.push(if accept_soft(p, "as") then parse_name(p, "a name to call it here") else n)

            if !p.accept(Comma) then break
            if p.at(RBrace) then break
    end if

    p.expect(RBrace, "`}`")
    expect_soft(p, "from")

    val (path, path_at, origin) = parse_module_path(p)

    refuse_asset_as_module(p, path, path_at, origin)

    stmt(start.to(p.just_taken()), ImportNames(path, path_at, origin, names, locals))
end parse_import

// The other half of the extension rule: a file that is not slate source has no names in it.
//
// **Said HERE rather than left to the loader**, because the loader would go on to parse a stylesheet
// as slate and report a syntax error in somebody's CSS -- true, and about the wrong thing entirely.
private refuse_asset_as_module(p: *Parser, path: string, path_at: Span, origin: Origin)
    if origin != Origin.FromFile then return
    if ends_with_sl(path) then return

    p.fault(path_at, s"`${path}` is not slate source, so there are no names in it to take -- write `import <name> from \"${path}\"` and the whole file arrives as a string")

// What an import names: a quoted path to a file, a bare word naming a package, or `slate:name` for
// one of slate's own.
//
// **THREE SYNTAXES RATHER THAN THREE READINGS OF ONE STRING.** Nothing already written changes
// meaning when a kind is added, and no reader has to work out whether a leading `./` was optional or
// whether a bare word is a package this time. `\"parsing\"` in quotes stays a file that does not
// exist, and a package may be called `http` without ever being confused for `slate:http` -- which is
// the ambiguity node shipped without and introduced the `node:` prefix to fix.
//
// **The colon form is bare where node's is quoted.** node writes `'node:http'` because every
// specifier there is a string and the prefix is what separates the two kinds *within* that one
// syntax; here a quoted path already means a file, so the prefix has to live outside the quotes. It
// costs the lexer nothing: `slate`, `:` and the name are three tokens slate already had.
//
// **The span is kept because every complaint about what was named is about this span** -- it cannot
// be read, it is not there, it closes a cycle, nothing depends on it -- and those are reported long
// after the token is gone.
private parse_module_path(p: *Parser) -> (string, Span, Origin) 
    val at = p.here()

    if p.at(Ident)
        val first = parse_name(p, "a package name")

        // **A slash names one of the package's OTHER modules**, `lath/dom`, and the whole of it is
        // carried as the specifier -- `package_entry` is what splits it, because it is the manifest
        // that says which modules there are and the parser has never read one.
        //
        // The loop takes more than one slash so that `a/b/c` is a specifier this rejects by name
        // rather than a parse error two tokens later, and it costs a line.
        if p.at(Slash)
            var spec = str_builder()

            spec.push(first)

            while p.accept(Slash)
                spec.push("/")
                spec.push(parse_name(p, "a module inside the package"))

            return (spec.finish(), at.to(p.just_taken()), Origin.FromPackage)
        end if

        if !p.accept(Colon) then return (first, at, Origin.FromPackage)

        val name = parse_name(p, "the name of one of slate's own modules")
        val whole = at.to(p.just_taken())

        // **The family is named rather than assumed.** `node:` is the prefix a reader arriving from
        // node will try first, and answering "no such module" about the part after the colon would
        // send them to look for a module that is not the problem.
        if first != BuiltinNamespace
            p.fault(whole, s"`${first}:` names no family of modules -- slate's own are written `${BuiltinNamespace}:${name}`")

        return (name, whole, Origin.FromSlate)
    end if

    if !p.at(StrLit)
        p.report.add(expected(at, "a quoted path like `\"./util.sl\"`, a package name, or `slate:time`", p.found(at)))
        return ("", at, Origin.FromFile)

    p.bump()
    (read_str_at(p, at), at, Origin.FromFile)
end parse_module_path

// `from` and `as`, which are words only here.
//
// **Soft, where `import` and `export` are hard.** Both are read at a point where the parser already
// knows what it is looking for, so nothing has to be decided from the word alone -- and taking them
// as keywords would cost every program two perfectly ordinary names.
private accept_soft(p: *Parser, word: string) -> bool
    if !p.at(Ident) then return false
    if p.text(p.here()) != word then return false

    p.bump()
    true
end accept_soft

private expect_soft(p: *Parser, word: string) -> bool
    if accept_soft(p, word) then return true

    val at = p.here()

    p.report.add(expected(at, s"`${word}`", p.found(at)))
    false
end expect_soft

// `return`, with or without a value.
//
// **A bare `return` is told from one with a value by what follows it**, and slate needs no rule of
// its own for that: an expression cannot begin with a newline or with the end of a block, which is
// exactly what `starts_expr` answers.
private parse_return(p: *Parser) -> Stmt
    val start = p.here()

    p.bump()

    var value: Option[Expr] = None

    if starts_expr(p.peek())
        val mark = ph_open(p)

        value = Some(ph_close(p, mark, parse_expr(p)))

    stmt(start.to(p.just_taken()), Return(value))
end parse_return

// `throw v`.
//
// **The value is not optional**, so this needs none of `parse_return`'s reasoning about what may
// follow: a `throw` with nothing after it is a mistake, and saying so where it was written is better
// than raising a fault with nothing in it.
private parse_throw(p: *Parser) -> Stmt
    val start = p.here()

    p.bump()

    val value = parse_expr(p)

    stmt(start.to(p.just_taken()), Throw(value))
end parse_throw

// `break`, `break 'outer`, `break v`, and `break 'outer v`.
//
// A bare one is told from one with a value by what follows, exactly as `return` is: an expression
// cannot begin with a newline or with the end of a block.
private parse_break(p: *Parser) -> Stmt
    val start = p.here()

    p.bump()

    val label = accept_label(p)
    val value = if starts_expr(p.peek()) then Some(parse_expr(p)) else None

    stmt(start.to(p.just_taken()), StmtKind.Break(label, value))
end parse_break

private parse_continue(p: *Parser) -> Stmt
    val start = p.here()

    p.bump()

    stmt(start.to(p.just_taken()), StmtKind.Continue(accept_label(p)))

// The name a `break` or a `continue` gave, or the empty string for the innermost loop.
private accept_label(p: *Parser) -> string
    if !p.at(Label) then return ""

    val at = p.here()

    p.bump()

    // The apostrophe is part of the lexeme and no part of the name.
    label_name(p.text(at))
end accept_label

private label_name(text: string) -> string = from_utf8_unchecked(text.bytes[1..])

// `'outer while ...`, and the same for the other three loops.
//
// **A label is read only immediately before a loop's own keyword**, which is what keeps a stray one
// from being reported as something else entirely.
//
// Not `private`: `expr.sysl` reads one where a value is wanted.
parse_labelled(p: *Parser, at: Span) -> Expr
    val name = label_name(p.text(at))
    val kind = p.peek()

    if kind == While || kind == For || kind == Loop || kind == Do then p.bump()

    kind match
        While -> parse_while(p, name, at)
        For -> parse_for(p, name, at)
        Loop -> parse_loop(p, name, at)
        Do -> parse_do_while(p, name, at)
        _ ->
            p.report.add(expected(p.here(), "a loop for this label to name", p.found(p.here())))
            expr(at, Bad)
end parse_labelled

private parse_word_stmt(p: *Parser, k: StmtKind) -> Stmt
    val start = p.here()

    p.bump()

    stmt(start, k)

// `while cond` with a body.
//
// Not `private`: `expr.sysl` reads a loop wherever a value is wanted.
parse_while(p: *Parser, label: string, start: Span) -> Expr

    val cond = parse_expr(p)
    val body = parse_control_body(p, Do)
    val otherwise = loop_else(p)

    accept_end(p, While)
    expr(start.to(p.just_taken()), While(label, cond, body, otherwise))
end parse_while

// The `else` a loop may carry, which runs when it finished on its own rather than by `break`.
//
// **The same clause an `if` uses**, read from the next line, so a loop's `else` and a conditional's
// are one grammar rather than two that drift.
private loop_else(p: *Parser) -> Option[Expr]
    if !accept_on_next_line(p, Else) then return None

    Some(if p.at(Indent) then parse_block(p) else inline_stmt_body(p))

// `for name in iterable` with a body, and `for await name in source`.
//
// **`await` is read here rather than by the expression parser**, so it is a word this head takes and
// not an operand: `for await x in xs` has nothing for `await` to apply to, and reading it as one
// would draw *"expected a name for each element"* pointing at the `await` -- true, and about the
// wrong thing.
parse_for(p: *Parser, label: string, start: Span) -> Expr
    val waits = p.accept(Await)

    // `[` or `{` can begin no name, which is the whole of the decision -- see `parse_binding`.
    val at = p.here()
    val binding = if p.at(LBracket) || p.at(LBrace)
        parse_pattern(p)
    else
        pattern(at, Bind(parse_name(p, "a name for each element")))

    p.expect(In, "`in`")

    val iter = parse_expr(p)
    val body = parse_control_body(p, Do)
    val otherwise = loop_else(p)

    accept_end(p, For)
    expr(start.to(p.just_taken()), For(label, binding, iter, body, otherwise, waits))
end parse_for

// `loop` with a body.
//
// The unconditional loop is a form of its own rather than `while true`, which is the rule sysl
// states for itself and slate follows: the form the language names says what is meant, and the
// condition that is always true is a condition a reader has to evaluate to find out there isn't one.
// `do body while cond` -- the loop whose body runs before its test.
//
// **There is no `end do`**, and that is sysl's reasoning rather than an omission: the trailing
// `while` already names where the body stopped, so a marker after it would close a block that has
// just been closed.
parse_do_while(p: *Parser, label: string, start: Span) -> Expr

    val body = if p.at(Indent) then parse_block(p) else inline_stmt_body(p)

    p.skip_newlines()
    p.expect(While, "`while` and the condition the loop repeats on")

    val cond = parse_expr(p)
    val otherwise = loop_else(p)

    expr(start.to(p.just_taken()), DoWhile(label, body, cond, otherwise))
end parse_do_while

parse_loop(p: *Parser, label: string, start: Span) -> Expr

    val body = parse_control_body(p, Do)

    // **No `else`, because an `else` runs when a loop finishes on its own and this one never does.**
    // sysl says the same in as many words.
    accept_end(p, Loop)
    expr(start.to(p.just_taken()), Loop(label, body))
end parse_loop
