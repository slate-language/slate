module dev.slatelang.slate

import sysl.buf.{Buf, buf}
import sysl.fs.{entries, exists, is_dir, make_dir_all, write_text}
import sysl.path.{file_name, join, normalize, parent}
import sysl.text.{replace_all}

// `slate new --template <template> <directory>` -- a project to start from.
//
// **A template is files carried in the binary** (`template_sluice.sysl`), written into a directory
// that is new or empty and nowhere else -- so nothing a person already has is ever overwritten, and
// the command needs no network. Fetching what the project depends on is `slate install`'s, which is
// the first thing the command tells the reader to run.

// One file a template writes: where, relative to the project, and what is in it.
//
// Not `private`: `template_sluice.sysl` makes them.
struct Planted
    path: string
    text: string
end Planted

// The templates there are, in the order a refusal names them.
private val TemplateNames: []string = ["sluice"]

// The files of the template called `name`, or nothing for a name that is not one.
private template_files(name: string) -> Option[Buf[Planted]] =
    if name == "sluice" then Some(sluice_template()) else None

// Not `private`: `run_cli` in `main.sysl` calls it.
new_command(args: []string, say: string -> unit) -> int
    var template = ""
    var dirs: Buf[string] = buf()
    var i: usize = 2

    while i < args.len
        val a = args[i]

        if a == "--template"
            if i + 1 >= args.len
                say("slate: `--template` takes the name of one: " + templates_text())

                return Misused
            end if

            template = args[i + 1]
            i += 2
        elif a.starts_with("-")
            say(s"slate: `slate new` has no option `${a}`")
            new_usage(say)

            return Misused
        else
            dirs.push(a)
            i += 1
        end if
    end while

    if template == ""
        say("slate: `slate new` takes a template: " + templates_text())
        new_usage(say)

        return Misused
    end if

    if dirs.len() != 1
        say("slate: `slate new` takes one directory to make the project in")
        new_usage(say)

        return Misused
    end if

    val files = template_files(template) match
        Some(fs) -> fs
        None ->
            say(s"slate: there is no template called `${template}` -- " + templates_text())

            return Misused

    planted(template, dirs.at(0), files, say)
end new_command

private new_usage(say: string -> unit) = say("usage: slate new --template <template> <directory>")

private templates_text() -> string
    var out = "the templates are"

    for i in 0..<TemplateNames.len
        out = out + (if i == 0 then " " else ", ") + s"`${TemplateNames[i]}`"

    out

// Write the template into `dir`, and say what to do next.
private planted(template: string, dir: string, files: Buf[Planted], say: string -> unit) -> int
    val name = file_name(normalize(dir)).unwrap_or("")

    if !plain_project_name(name)
        say(s"slate: `${name}` is not a name a project can have -- it names the package and its database, so it is letters, digits, `-` and `_`, beginning with a letter")

        return Misused
    end if

    // **New or empty, and nothing else.** A template written over a project would replace a
    // `package.sl` and a `main.sl` somebody wrote, and the only way to be sure that cannot happen is
    // to refuse a directory that holds anything at all.
    if exists(dir)
        if !is_dir(dir)
            say(s"slate: `${dir}` is already there and is not a directory")

            return Failed
        end if

        val there = entries(dir) match
            Ok(names) -> names.len()
            Err(e) ->
                say(s"slate: cannot read ${dir}: ${e}")

                return Failed

        if there > 0
            say(s"slate: `${dir}` is already there and is not empty, and `slate new` writes only into a new or empty directory")

            return Failed
        end if
    end if

    for i in 0..<files.len()
        val f = files.at(i)
        val path = join(dir, f.path)

        make_dir_all(parent(path).unwrap_or(dir)) match
            Err(e) ->
                say(s"slate: cannot make the directory for ${path}: ${e}")

                return Failed
            Ok(_) -> ()

        write_text(path, replace_all(f.text, "@NAME@", name)) match
            Err(e) ->
                say(s"slate: cannot write ${path}: ${e}")

                return Failed
            Ok(_) -> ()

    say(s"made ${dir} from the `${template}` template")
    say("")
    say("next:")
    say(s"  cd ${dir}")
    say(step("slate install", "fetch what package.sl depends on"))
    say(step(s"createdb ${name}", "make the database .env names"))
    say(step("slate run migrate", "make its tables"))
    say(step("slate run --watch main.sl", "serve it, and start it again on every save"))
    say("")
    say("`slate test tests` runs its tests, which need no database.")

    Fine
end planted

// One line of what to do next: the command, and what it is for in a column beside it.
private step(command: string, why: string) -> string
    var out = "  " + command

    while out.bytes.len < 30
        out = out + " "

    out + why

// Whether `name` can be a project's: it is written into `package.sl` and into the database URL, so
// it has to be plain in both.
private plain_project_name(name: string) -> bool
    if name.bytes.len == 0 then return false

    for i in 0..<name.bytes.len
        val c = name.bytes[i]
        val letter = (c >= u8('a') && c <= u8('z')) || (c >= u8('A') && c <= u8('Z'))
        val other = (c >= u8('0') && c <= u8('9')) || c == u8('-') || c == u8('_')

        if i == 0 && !letter then return false
        if !letter && !other then return false

    true
