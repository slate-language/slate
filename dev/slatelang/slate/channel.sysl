module dev.slatelang.slate

import sh.sysl.gc
import sh.sysl.json
import sh.sysl.libuv
import sh.sysl.libuv.Handle
import sh.sysl.libuv.Stream
import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.env
import sysl.text.from_utf8

// A channel -- the wire both ends of one speak, and this program's own end of the one it was started
// with.
//
// **It is `spawn.sysl`'s other half and was cut out of it at a thousand lines.** What is here is
// everything that is true of a channel whichever end of it a program is holding: the framing, the
// socket that may travel with a message, and the two questions each end has to answer about the
// other before one can. `spawn.sysl` keeps the child -- starting one, watching it, and what a
// supervisor calls -- and reaches this file for the wire.
//
// **The seam is the `is_child` flag, which is why these functions take one.** A child's inbox and
// this program's own are two tables of two shapes, and everything between a run of bytes and a
// delivered message is otherwise the same code; a flag is what lets there be one copy of it, and it
// is the reason `deliver_lines`, `take_socket` and `orphan_check` read both tables rather than
// living beside either one.
//
// ## The format
//
// One JSON value per line, on a descriptor named in the child's environment. **A message arrives
// whole or not at all**: a partial line is held until its newline arrives, and a line that is not
// JSON stops the program naming the channel rather than being dropped where nobody would see it.
//
// ## And a socket may travel with a message
//
// A supervisor accepts every connection itself and hands each one to a worker, which is what a
// cluster is where the kernel refuses `reusePort`. The descriptor crosses as ancillary data on the
// pipe, so **both ends must be ipc pipes** and **both programs must be on the same host** -- node
// passes a handle over its own channel and through a protocol only another node speaks. Each end
// says which host it is on: the parent through the environment, the child through the first line it
// writes.

// This program's own end of the channel, where it was started with one.
//
// **One channel and one slot, because a program has one parent.** There is nothing to close it with
// and nothing that hands the slot back, so unlike a child it needs no generation.
struct Channel
    live: bool
    pipe: Option[&libuv.Pipe]
    open: bool
    inbox: Buf[u8]

    // Sockets taken off the channel and not yet handed to a message, exactly as a child's are.
    socks: Buf[Value]

    // Which host the program that started this one is running on, out of the environment it was
    // given -- `""` where it said nothing, which is what a program started by something that is not
    // slate gets.
    peer: string

    on_message: Value

    // The event slot that keeps the program alive while the channel is open. **A worker's whole job
    // is to wait to be told something**, so a program with an open channel is a program with work
    // outstanding -- and the channel ending, which is what the parent going away looks like, is what
    // lets it exit. node's rule, arrived at from the same place.
    keep: usize

var channels: Buf[Channel] = buf()

// The slot `channel()` has already opened, so that asking twice answers the same thing.
var own_channel: Option[usize] = None

// The name the descriptor arrives under. **`NODE_CHANNEL_FD` under another name**, and it has to be
// a name: a descriptor number is not something a program can discover about itself.
val ChannelVariable: string = "SLATE_CHANNEL_FD"

// The descriptor the child is given, which is the slot after the three every program has.
val ChannelFd: int = 3

// The name the PARENT's host arrives under, and the two answers it can hold.
//
// **A socket may only be passed between two programs running on the same host**, the descriptor
// crossing a Unix domain socket in one case and node's own channel in the other -- so each end has
// to know what the other is before it writes one. The child learns the parent's host here, at the
// spawn, where there is nothing to wait for; the parent learns the child's from the line `channel()`
// writes as soon as it opens, which is why a socket may be sent to a child only once that child has
// said something.
val HostVariable: string = "SLATE_CHANNEL_HOST"

// This back end's name in that variable and in the line a channel opens with.
val HostName: string = "native"

// The other back end's, which is the one a socket may not be passed to from here.
val OtherHost: string = "js"

// A peer that spoke and was not a slate program, so nothing more will be learned about it.
val HostUnknown: string = "?"

// The line `channel()` writes first, which is how a parent finds out what its child is.
//
// **A fixed byte string rather than a value put through `toJSON`**, so that both back ends write
// exactly the same line and each recognises the other's by comparing text. It is swallowed rather
// than delivered, and only ever where a child has not said anything yet -- so a program whose own
// first message happens to look like this is only misread if it is also the first thing it sends.
private hello_line(host: string) -> string = "{\"$slate\":\"" + host + "\"}"

// Put this program's own end back to nothing, so that one program's channel cannot be seen by the
// next. `forget_children` in `spawn.sysl` calls it, the two tables going together.
forget_channels()
    for i in 0..<channels.len()
        var ch = channels.at(i)

        if ch.live
            ch.pipe match
                Some(p) -> p.close(() -> ())
                None -> ()

        ch.live = false
        ch.pipe = None
        ch.socks = buf()
        ch.on_message = Null
        channels.set(i, ch)

    channels = buf()
    own_channel = None
end forget_channels

// Mark what this program's own end can still reach, which `mark_children` asks for.
mark_channels(h: *gc.Heap)
    for i in 0..<channels.len()
        mark_value(h, channels.at(i).on_message)

        for j in 0..<channels.at(i).socks.len()
            mark_value(h, channels.at(i).socks.at(j))

// Read a channel until it ends, handing the bytes on as they arrive.
//
// **A failed read is an end and not a fault**, which is `run`'s rule for a child's output and holds
// here for a better reason: a channel fails when the peer goes, and the peer going is the ordinary
// end of a conversation rather than a defect in either program.
// Not `private`: `spawn.sysl` reads a child's end of the channel with this one.
read_channel(p: &libuv.Pipe, on_bytes: &Fn([]const u8) -> unit,
                     on_socket: &Fn(Value) -> unit, on_end: &Fn() -> unit)
    p.read_start((r) ->
        r match
            Data(bytes) ->
                // **The handles come out before the bytes go in**, and there is no other place they
                // could: a pending handle is there for the length of this callback and is gone by
                // the next turn of the loop. Queuing it here and pairing it with a message below is
                // what makes `onMessage(value, socket)` the same call on both back ends.
                take_pending(p, on_socket)
                on_bytes(bytes)
            End ->
                p.close(() -> ())
                on_end()
            Failed(_) ->
                p.close(() -> ())
                on_end()) match
        Err(_) ->
            p.close(() -> ())
            on_end()
        Ok(_) -> ()

// Take every handle waiting on a channel, as a socket the program can use.
//
// **Only ever called from inside the read callback**, which is the only place `pending_count` is
// anything but zero. A handle that is not a socket stops the program: nothing sends one, so it is a
// defect somewhere rather than news about the world, and quietly closing it would leave a supervisor
// waiting for a worker that was never given the connection.
private take_pending(p: &libuv.Pipe, on_socket: &Fn(Value) -> unit)
    while p.pending_count() > 0
        if p.pending_type() != libuv.HANDLE_TCP
            loop_fault = Some(failure(point(0), "something that is not a socket arrived on the channel"))
            return

        val taken = libuv.tcp() match
            Err(e) ->
                loop_fault = Some(failure(point(0), s"a socket arriving on the channel could not be taken: ${e}"))
                return
            Ok(t) -> t

        p.accept_pending(taken) match
            Err(e) ->
                taken.close(() -> ())
                loop_fault = Some(failure(point(0), s"a socket arriving on the channel could not be taken: ${e}"))
                return
            Ok(_) -> ()

        on_socket(hold_socket(taken, Null))

// A socket that arrived with nothing to carry it, which nothing this program can go on doing.
//
// **A message carries at most one socket, and the pairing is what says which.** A read that brought
// a handle brings the bytes it was attached to with it, so a socket still queued once every whole
// line has been delivered and nothing is left half-read is either a handle sent with no message or
// a second one sent with a message that already had its own.
// Not `private`: `spawn.sysl` asks it after every read on a child's channel.
orphan_check(id: usize, is_child: bool)
    val waiting = if is_child then children.at(id).socks.len() else channels.at(id).socks.len()
    val partial = if is_child then children.at(id).inbox.len() else channels.at(id).inbox.len()

    if waiting > 0 && partial == 0
        loop_fault = Some(failure(point(0), "a socket arrived on the channel with no message to carry it"))

// Close every socket that never found a message, giving its slot back with it.
// Not `private`: `spawn.sysl` gives up a child's queued sockets when its channel ends.
drop_socks(held: Buf[Value])
    for i in 0..<held.len()
        close_socket(held.at(i), point(0)) match
            Err(_) -> ()
            Ok(_) -> ()

// The socket the next message on a channel is carrying, and `Null` where it carries none.
private take_socket(id: usize, is_child: bool) -> Value
    val held = if is_child then children.at(id).socks else channels.at(id).socks

    if held.len() == 0 then return Null

    var rest: Buf[Value] = buf()

    for i in 1..<held.len() do rest.push(held.at(i))

    if is_child
        var c = children.at(id)

        c.socks = rest
        children.set(id, c)
    else
        var ch = channels.at(id)

        ch.socks = rest
        channels.set(id, ch)

    held.at(0)

// -- the child's own end --------------------------------------------------------------------------

// `channel()` -- this program's end of the channel it was started with, or `null`.
//
// **`null` rather than a fault, because a program may be run both ways.** The same file is a worker
// under a supervisor and a script somebody typed the name of, and asking which it is now is the
// whole point of the call.
do_channel(args: Buf[Value], at: Span) -> Step
    if args.len() != 0
        return fault(at, s"`channel` takes nothing at all, and was given ${counted(args.len(), "argument")}")

    own_channel match
        Some(id) -> return Ok(ChannelVal(id))
        None -> ()

    val named = env.get(ChannelVariable) match
        Some(v) -> v
        None -> return Ok(Null)

    val fd = parse_fd(named) match
        Some(n) -> n
        None -> return fault(at, s"`${ChannelVariable}` names the channel's descriptor and holds `${named}`, which is not one")

    // **An ipc pipe, for `start_child`'s reason**: this is the end a socket arrives on.
    val p = libuv.pipe(true) match
        Err(e) -> return fault(at, s"the channel on descriptor ${fd} could not be opened: ${e}")
        Ok(p) -> p

    p.open(fd) match
        Err(e) ->
            p.close(() -> ())
            return fault(at, s"the channel on descriptor ${fd} could not be opened: ${e}")
        Ok(_) -> ()

    // **The slot is claimed so that the loop has work**, which is what keeps a worker running
    // between one message and the next. `repeating` is true for `hold_socket`'s reason: nothing
    // ever fires it, and the flag is what stops a slot being spent by a callback that runs.
    val keep = claim(Pending(Null, Null, null, None, None, true, true, 0))
    val id = channels.len()

    // **Which host the parent is on comes out of the environment**, where it was put at the spawn --
    // so a worker knows before it does anything whether a socket can go back up the channel, and
    // there is nothing to wait for.
    val parent_host = env.get(HostVariable) match
        Some(v) -> v
        None -> ""

    channels.push(Channel(true, Some(p), true, buf(), buf(), parent_host, Null, keep))
    own_channel = Some(id)

    read_channel(p, (bytes) -> channel_bytes(id, bytes), (v) -> channel_socket(id, v),
                 () -> channel_end(id))

    // **And this program says what IT is, first thing.** The parent cannot learn it any other way:
    // it started a command, and what that command turned out to be is only knowable from what it
    // says. The line is swallowed at the other end rather than delivered.
    var hello: Buf[u8] = buf()
    val greeting = hello_line(HostName) + "\n"

    for i in 0..<greeting.bytes.len do hello.push(greeting.bytes[i])

    p.write(hello.view()) match
        Err(_) -> ()
        Ok(_) -> ()

    Ok(ChannelVal(id))
end do_channel

// The descriptor a variable names, where it names one.
private parse_fd(text: string) -> Option[int]
    if text.bytes.len == 0 then return None

    var n: long = 0

    for i in 0..<text.bytes.len
        val b = text.bytes[i]

        if b < 0x30u8 || b > 0x39u8 then return None

        n = n * 10 + long(b - 0x30u8)

        if n > 65535 then return None

    Some(int(n))

// Bytes off this program's own channel.
private channel_bytes(id: usize, bytes: []const u8)
    if id >= channels.len() then return

    var ch = channels.at(id)

    if !ch.live || !ch.open then return

    for b in bytes do ch.inbox.push(b)

    channels.set(id, ch)
    deliver_lines(id, false)
    orphan_check(id, false)

// A socket off this program's own channel.
private channel_socket(id: usize, v: Value)
    if id >= channels.len() then return

    var ch = channels.at(id)

    if !ch.live || !ch.open then return

    ch.socks.push(v)
    channels.set(id, ch)

// The parent has gone, or closed its end.
//
// **The slot goes with it, and that is what lets a worker exit.** A program whose supervisor has
// finished has nobody to be told anything by, so the thing keeping it alive is exactly what has
// ended.
private channel_end(id: usize)
    if id >= channels.len() then return

    var ch = channels.at(id)

    if !ch.live then return

    ch.open = false
    ch.pipe = None
    ch.inbox = buf()
    drop_socks(ch.socks)
    ch.socks = buf()
    channels.set(id, ch)
    surrender(ch.keep)

// -- messages, in and out --------------------------------------------------------------------------

// Hand every whole message in the buffer to whoever is listening.
//
// **A message arrives whole or not at all.** A read is a run of bytes and not a message: two
// messages arrive in one read as often as half of one does, so the newline is what decides where a
// message ends and a partial line waits for the rest of itself.
// Not `private`: `spawn.sysl` hands a child's bytes over with this one.
deliver_lines(id: usize, is_child: bool)
    var going = true

    while going
        val bytes = if is_child then children.at(id).inbox else channels.at(id).inbox
        var cut: Option[usize] = None

        for i in 0..<bytes.len()
            if bytes.at(i) == 0x0au8 && cut.is_none()
                cut = Some(i)

        cut match
            None -> going = false
            Some(end) ->
                var line: Buf[u8] = buf()
                var rest: Buf[u8] = buf()

                for i in 0..<end do line.push(bytes.at(i))
                for i in (end + 1)..<bytes.len() do rest.push(bytes.at(i))

                if is_child
                    var c = children.at(id)

                    c.inbox = rest
                    children.set(id, c)
                else
                    var ch = channels.at(id)

                    ch.inbox = rest
                    channels.set(id, ch)

                if !deliver_one(id, is_child, line) then going = false

// One message, decoded and handed over. False where the program has been stopped by what was on the
// channel, so that the rest of the buffer is not walked afterwards.
//
// **A line that is not JSON stops the program naming the channel.** The alternative is dropping it,
// which is the one answer that leaves nothing to look at: the sender is another program of the same
// system, so a message that will not decode is a defect somebody can fix rather than input from the
// outside world.
private deliver_one(id: usize, is_child: bool, line: Buf[u8]) -> bool
    // A carriage return before the newline, so that a sender written for a line-based protocol on
    // another platform is not a fault.
    var trimmed = line

    if trimmed.len() > 0 && trimmed.at(trimmed.len() - 1) == 0x0du8
        var shorter: Buf[u8] = buf()

        for i in 0..<(trimmed.len() - 1) do shorter.push(trimmed.at(i))

        trimmed = shorter

    if trimmed.len() == 0 then return true

    val at = if is_child then children.at(id).at else point(0)

    val text = from_utf8(trimmed.view()) match
        Ok(t) -> t
        Err(_) ->
            loop_fault = Some(failure(at, "a message on the channel is not text"))
            return false

    // **The line a channel opens with says which host the child is on, and is swallowed.** Only a
    // child's first line is read this way -- once anything has been heard the question is settled,
    // and a program whose own messages look like this is misread only in its very first one.
    if is_child && children.at(id).peer == ""
        var c = children.at(id)

        if text == hello_line(HostName)
            c.peer = HostName
        else if text == hello_line(OtherHost)
            c.peer = OtherHost
        else
            c.peer = HostUnknown

        children.set(id, c)

        if c.peer != HostUnknown then return true

    val src = source_of("channel", text)

    val decoded = json.parse(src) match
        Err(d) ->
            loop_fault = Some(failure(at, s"a message on the channel is not JSON: ${d.render(src)}"))
            return false
        Ok(j) -> j

    val mark = root_mark()

    val v = slate_of_json(decoded, at) match
        Ok(x) -> x
        Err(s) ->
            release(mark)
            loop_fault = Some(s)
            return false

    hold(v)

    val fn = if is_child then children.at(id).on_message else channels.at(id).on_message

    // **The socket is the second argument and `null` where there is none**, which is node's shape:
    // `process.on('message', (msg, handle) => …)`. A handler written with one parameter is unchanged
    // by this, a call dropping the arguments a function did not ask for.
    call_with(fn, v, "onMessage", Some(take_socket(id, is_child)))
    release(mark)
    true
end deliver_one

// Call what a program registered, with one argument. `Null` is nobody to call and not an error.
//
// **A fault inside it stops the program**, as it does for a timer and a socket and for the same
// reason: the loop is not running a statement, so there is nothing to attach the complaint to but
// the whole run.
// Not `private`: `spawn.sysl` calls `onExit` through it.
call_with(fn: Value, v: Value, name: string, also: Option[Value] = None)
    fn match
        Null -> return
        _ -> ()

    var args: Buf[Value] = buf()
    val mark = root_mark()

    hold(fn)
    hold(v)
    args.push(v)

    also match
        Some(x) ->
            hold(x)
            args.push(x)
        None -> ()

    apply_callback(fn, args, point(0), name) match
        Ok(_) -> ()
        Err(s) -> loop_fault = Some(s)

    release(mark)
end call_with

// The bytes of one message, framed: the JSON and the newline that ends it.
// Not `private`: `child.send` frames its message here.
framed(v: Value, at: Span) -> Result[Buf[u8], Signal]
    var path: Buf[*u8] = buf()
    val j = json_of_slate(v, at, &path)?
    val text = s"${j}"

    var out: Buf[u8] = buf()

    for i in 0..<text.bytes.len do out.push(text.bytes[i])

    out.push(0x0au8)
    Ok(out)

// Write one message to a channel, and say what happened.
//
// **A write that cannot be made is a RESULT and not a fault**, which is the one decision here that
// is not obvious. A worker dying while its supervisor was writing to it is the ordinary shape of a
// process ending, and a supervisor that had to wrap every `send` in a `try` to survive one is a
// supervisor nobody would write. What faults is a value that is not a message at all -- that is a
// defect in the program rather than news about the world, and it is `toJSON`'s own split.
// Not `private`: `child.send` writes through it.
write_message(p: Option[&libuv.Pipe], open: bool, bytes: Buf[u8], why: string) -> Step
    if !open then return Ok(err_value(why))

    p match
        None -> Ok(err_value(why))
        Some(pipe) ->
            pipe.write(bytes.view()) match
                Err(e) -> Ok(err_value(s"this message could not be sent: ${e}"))
                Ok(_) -> Ok(ok_value(Null))

// Why a socket may not be passed to a peer, and `None` where it may.
//
// **The two programs have to be on the same host**, a descriptor crossing a Unix domain socket here
// and node's own channel there, with no way for one to hand anything to the other. Neither is a
// failure to report through the result: the program asked for something that cannot be done, which
// is what a fault is for, and it would be a mistake in the program on every run rather than news
// about a worker that has died.
private handles_refused(peer: string, is_child: bool) -> Option[string]
    if peer == HostName then return None

    val who = if is_child then "this child" else "the program that started this one"

    if peer == OtherHost
        return Some(s"${who} is running on the JavaScript host and this program on the interpreter, so a socket cannot cross the channel")

    if peer == HostUnknown
        return Some(s"${who} is not a slate program, so a socket cannot cross the channel")

    if is_child
        return Some("this child has not said what it is yet -- a socket may be passed to a child once that child has sent its first message")

    Some(s"${who} did not say which host it is running on, so a socket cannot cross the channel")

// Write one message with a socket attached, and give this program's own copy of it up.
//
// **The copy is given up in the write callback and not before**, because the descriptor is
// duplicated when libuv reaches the `sendmsg` rather than when the write is queued -- closing it any
// earlier sends the peer a socket that is already gone. It IS given up, though, and that is node's
// rule too: what crossed is a duplicate, so leaving both open would have two programs reading one
// connection and each seeing half of it.
// Not `private`: `child.send(value, socket)` writes through it.
write_with_socket(p: Option[&libuv.Pipe], open: bool, bytes: Buf[u8], sock: Value,
                          peer: string, is_child: bool, at: Span, why: string) -> Step
    val (id, gen) = sock match
        Socket(i, g) -> (i, g)
        other -> return fault(at, s"`send` passes on a socket, and this is ${other.type_name()}")

    handles_refused(peer, is_child) match
        Some(sentence) -> return fault(at, sentence)
        None -> ()

    val handle = socket_at(id, gen) match
        None -> return fault(at, "this socket is closed, and `send` needs an open one to pass on")
        Some(h) -> h

    if !open then return Ok(err_value(why))

    p match
        None -> Ok(err_value(why))
        Some(pipe) ->
            pipe.write_handle(bytes.view(), handle, (r) ->
                r match
                    Err(_) -> ()
                    Ok(_) -> ()

                close_socket(sock, point(0)) match
                    Err(_) -> ()
                    Ok(_) -> ()) match
                Err(e) -> Ok(err_value(s"this message could not be sent: ${e}"))
                Ok(_) -> Ok(ok_value(Null))

// The channel a builtin was handed.
private channel_of(v: Value, at: Span, name: string) -> Result[usize, Signal]
    v match
        ChannelVal(id) ->
            if id >= channels.len() || !channels.at(id).live
                return Err(failure(at, s"this channel was opened by another program, and `${name}` needs this one's"))

            Ok(id)
        other -> Err(failure(at, s"`${name}` is something a channel does, and this is ${other.type_name()}"))

// `channel().send(value)` and `channel().send(value, socket)` -- one message back to whoever started
// this program, with a connection beside it where one was given.
do_channel_send(args: Buf[Value], at: Span) -> Step
    if args.len() < 2 || args.len() > 3
        return fault(at, s"`send` takes one message and optionally a socket to pass on, and was given ${counted(args.len() - 1, "argument")}")

    val id = channel_of(args.at(0), at, "send")?
    val ch = channels.at(id)
    val bytes = framed(args.at(1), at)?

    if args.len() == 3
        return write_with_socket(ch.pipe, ch.open, bytes, args.at(2), ch.peer, false, at,
                                 "this channel is closed")

    write_message(ch.pipe, ch.open, bytes, "this channel is closed")
end do_channel_send

// `channel().onMessage(fn)` -- what to call for every message the parent sends.
do_channel_on_message(args: Buf[Value], at: Span) -> Step
    if args.len() != 2
        return fault(at, s"`onMessage` takes a function to call, and was given ${counted(args.len() - 1, "argument")}")

    val id = channel_of(args.at(0), at, "onMessage")?

    args.at(1) match
        Fn(_) -> ()
        other -> return fault(at, s"`onMessage` needs a function to call, and this is ${other.type_name()}")

    var ch = channels.at(id)

    ch.on_message = args.at(1)
    channels.set(id, ch)
    Ok(Null)
end do_channel_on_message
