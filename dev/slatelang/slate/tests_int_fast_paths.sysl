module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// The places an integer is answered without the general machinery: `sorted` and `sort` on an array
// of nothing but integers with no comparator (`array_sort.sysl`), and a table's hash and key
// comparison on an integer key (`table.sysl`'s `key_hash` and `keys_match`).
//
// **Every test here is a statement that the short road gives the long road's answer**, so each one
// sits beside the neighbouring case that still takes the long road: a real among the integers, a
// big integer, a NaN, a class deciding its own `==` and `hash`.

// -- sorting integers -------------------------------------------------------------------------------

// **The shapes a sort gets wrong at its edges**: nothing, one, all equal, and both ends of a `long`.
@test
INTEGERS_SORT_AT_THEIR_EDGES()
    assert_eq(out("print(sorted([]), sorted([7]), sorted([3, 3, 3]))"), "[] [7] [3, 3, 3]")
    assert_eq(out("print(sorted([5, -2, 0, 9223372036854775807, -9223372036854775807 - 1, 5]))"),
        "[-9223372036854775808, -2, 0, 5, 5, 9223372036854775807]")
end INTEGERS_SORT_AT_THEIR_EDGES

// **More than the insertion cutoff, so the partitioning is what is exercised**, and every value is
// asked for: a sort that lost or duplicated one would still put 0 first and 100 last.
@test
A_HUNDRED_INTEGERS_SORT_AND_NONE_IS_LOST()
    val prog = raw"""
    val xs = []
    var i = 0

    while i < 100
        push(xs, (i * 37) % 101)
        i = i + 1

    val ys = sorted(xs)
    var ok = ys.length == 100
    var j = 1

    while j < 100
        if ys[j - 1] >= ys[j] then ok = false
        j = j + 1

    print(ok, ys[0], ys[99])
    """

    assert_eq(out(prog), "true 0 100")
end A_HUNDRED_INTEGERS_SORT_AND_NONE_IS_LOST

// **One element that is not an `Int` sends the whole array down the general road**, and the answer
// is the one that road always gave: a real among integers orders as a number, a big integer orders
// as a number, and a NaN compares false both ways, which leaves it where the merge puts it.
@test
AN_ARRAY_THAT_IS_NOT_ALL_INTEGERS_SORTS_AS_BEFORE()
    assert_eq(out("print(sorted([3, 1.5, 2]))"), "[1.5, 2, 3]")
    assert_eq(out("print(sorted([2, (1 << 70), 1, -(1 << 70)]))"),
        "[-1180591620717411303424, 1, 2, 1180591620717411303424]")
    assert_eq(out("print(sorted([2, 0.0 / 0.0, 1]))"), "[2, NaN, 1]")
    assert(fails("print(sorted([1, \"a\"]))").contains("does not apply to"), "a mixture is still refused")
end AN_ARRAY_THAT_IS_NOT_ALL_INTEGERS_SORTS_AS_BEFORE

// **`sort` writes the order into the array it was given and answers nothing; `sorted` leaves its
// argument alone** -- the integer road keeps both halves of that rule.
@test
SORT_CHANGES_THE_ARRAY_AND_SORTED_DOES_NOT()
    assert_eq(out("val xs = [3, 1, 2]\nval r = xs.sort()\nprint(xs, r)"), "[1, 2, 3] null")
    assert_eq(out("val ys = [2, 1]\nprint(sorted(ys), ys)"), "[1, 2] [2, 1]")
    assert(fails("val xs = freeze([2, 1])\nxs.sort()\n").contains("this array is frozen, and `sort` would change it"), "a frozen array is still refused")
end SORT_CHANGES_THE_ARRAY_AND_SORTED_DOES_NOT

// A comparator is still asked, integers or not.
@test
A_COMPARATOR_STILL_DECIDES_FOR_INTEGERS()
    assert_eq(out("print(sorted([1, 3, 2], (a, b) -> a > b))"), "[3, 2, 1]")
    assert(fails("print(sorted([2, 1], (a, b) -> 0))").contains("answered an integer"), "and is still held to a boolean")
end A_COMPARATOR_STILL_DECIDES_FOR_INTEGERS

// -- integer keys -----------------------------------------------------------------------------------

// **Past the size where a table grows an index**, so the probe is what finds each key; a real equal to
// an integer is still the same key, both for reading and for writing, and a rewritten key keeps its
// place.
@test
INTEGER_KEYS_ARE_FOUND_IN_AN_INDEXED_TABLE()
    val prog = raw"""
    val m = Map()
    var k = 0

    while k < 50
        m.set(k, k * 2)
        k = k + 1

    print(m.get(10), m.get(10.0), m.has(49), m.has(50), m.get(99), m.size)
    m.set(10.0, 7)
    print(m.get(10), m.size, m.keys()[0..<3])
    """

    assert_eq(out(prog), "20 20 true false null 50\n7 50 [0, 1, 2]")
end INTEGER_KEYS_ARE_FOUND_IN_AN_INDEXED_TABLE

// **A set of integers, a real that equals one, and a big integer**: the short comparison answers
// only for two `Int`s, and the others still meet `same`.
@test
A_SET_OF_INTEGERS_STILL_MEETS_REALS_AND_BIG_INTEGERS()
    val prog = raw"""
    val s = Set()

    s.add(2)
    s.add(1)
    s.add(2.0)
    s.add(1 << 70)
    print(s.values(), s.has(1 << 70), s.has(2.0), s.has(3))
    """

    assert_eq(out(prog), "[2, 1, 1180591620717411303424] true true false")
end A_SET_OF_INTEGERS_STILL_MEETS_REALS_AND_BIG_INTEGERS

// **A class's own `hash` and `==` are still consulted**, in a table big enough to be indexed, and an
// integer key asked of it finds none of the objects -- the integer road answers only integer against
// integer.
@test
A_CLASS_KEY_STILL_DECIDES_ITS_OWN_EQUALITY_BESIDE_INTEGER_KEYS()
    val prog = raw"""
    class P
        var n

        ==(self, o) = o is P && o.n % 10 == self.n % 10
        hash(self) = self.n % 10

    val m = Map()
    var i = 0

    while i < 30
        m.set(P(i), i)
        i = i + 1

    m.set(3, "three")
    print(m.size, m.get(P(3)), m.has(P(13)), m.get(3))
    """

    assert_eq(out(prog), "11 23 true three")
end A_CLASS_KEY_STILL_DECIDES_ITS_OWN_EQUALITY_BESIDE_INTEGER_KEYS
