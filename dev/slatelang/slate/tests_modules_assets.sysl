module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// Importing a file that is not slate, and a test that is not for this host.
//
// **Cut out of `tests_modules.sysl` when that file passed a thousand lines, by subject, and nothing
// crosses**: the fixtures are real files read by relative path, and none of that file's helpers is
// used here.

// -- importing a file that is not slate ------------------------------------------------------------

// **The specifier's EXTENSION is the whole of what tells a module from an asset**, and both halves of
// that rule are tested here: a `.css` may not be asked for names, and a `.sl` may not be asked for a
// default. Everything else about an asset is the loader reading a file and the compiler interning the
// string it read.

@test
AN_IMPORT_OF_A_FILE_THAT_IS_NOT_SLATE_BRINGS_IT_IN_AS_A_STRING()
    // `tests/assets/button.css` is 76 bytes and begins `.button`, so this pins the length and the
    // first characters rather than a substring that could match a partial read.
    assert_eq(ran_out("tests/assets/uses_css.sl"), "72\n.button")

@test
AN_ASSET_THAT_IS_NOT_THERE_IS_REFUSED_BEFORE_THE_PROGRAM_RUNS_AND_NAMES_BOTH_FILES()
    val said = ran_fault("tests/assets/missing.sl")

    assert(said.contains("cannot read `tests/assets/nowhere.css`"), said)
    assert(said.contains("tests/assets/missing.sl"), said)

@test
AN_ASSET_THAT_IS_NOT_UTF_8_IS_REFUSED_RATHER_THAN_MANGLED()
    // **slate has one text type and it is UTF-8**, so there is no value a PNG could arrive as -- and
    // answering replacement characters would put a corrupted string into the program with nothing
    // said. The refusal names what a program taking bytes actually wants.
    val said = ran_fault("tests/assets/binary.sl")

    assert(said.contains("is not UTF-8 text"), said)
    assert(said.contains("`readBytes`"), said)

@test
THE_TWO_IMPORT_FORMS_ARE_REFUSED_IN_EACH_OTHERS_SPELLING()
    // **Said by the PARSER**, so a stylesheet is never handed to the lexer: left to the loader, this
    // would have reported a syntax error in somebody's CSS -- true, and about the wrong thing.
    assert(fails("import { helper } from \"./button.css\"\n")
        .contains("is not slate source, so there are no names in it to take"))
    assert(fails("import * as s from \"./button.css\"\n")
        .contains("is not slate source, so there are no names in it to take"))
    assert(fails("import util from \"./util.sl\"\n")
        .contains("slate has no default export"))

    // And an asset is a quoted path and nothing else: a package and one of slate's own are modules.
    assert(fails("import styles from lath\n").contains("names a FILE beside this one"))
    assert(fails("import styles from slate:http\n").contains("names a FILE beside this one"))

@test
AN_ASSET_IMPORTED_FROM_A_PACKAGE_IS_THE_PACKAGES_OWN_RELATIVE_IMPORT()
    // **This is what a component library shipping a `.css` beside its `.slx` does**, and it needed
    // nothing of the package system: the file travels with the package, the package's own module
    // imports it by a relative path, and what a consumer sees is an exported string.
    val said = scratch_project_out(
        "{ name: \"p\", version: \"1\", dependencies: { kit: { git: \"github.com/example/kit\", version: \"1.0.0\" } } }\n",
        "import { style } from kit/extra\n\nprint(style())\n")

    assert_eq(said, ".panel { display: grid; }\n")

@test
AN_ASSET_ARRIVES_BYTE_FOR_BYTE_IN_THE_JAVASCRIPT_BACK_END_TOO()
    // **The emitted program carries the text as a literal**, so what a browser gets is the file and
    // not a re-encoding of it. The length is asserted as well as the opening, a re-encoding being
    // exactly the failure that keeps a prefix and changes a byte in the middle.
    // `node_said` writes its probe into `tests/`, so the specifier is relative to that -- and what
    // it asserts is the answer the interpreter gave the same file two tests above.
    val probe = "import styles from \"./assets/button.css\"\nprint(styles.length)\nprint(styles[0..<7])\n"

    assert_eq(node_said(probe), "72\n.button")

// -- a test that is not for this host --------------------------------------------------------------

@test
a_test_may_leave_itself_out_and_the_run_says_so()
    // **A third verdict and not a kind of pass**, so a suite that quietly stopped running half of
    // itself cannot report a page of greens. `tests/suite/skipping.sl` has one of each.
    val t = tested("tests/suite/skipping.sl")

    assert_eq(t.report, "")
    assert_eq(t.passed(), 1)
    assert_eq(t.left_out(), 3)
    assert_eq(t.failed(), 0)

@test
a_skip_carries_its_reason_and_an_async_one_carries_it_too()
    // **The asynchronous case is why the reason is written down where `skip` was called** rather than
    // read off the signal: a `skip` inside an `async` test travels out of the coroutine and settles
    // its promise as a rejection, which keeps the sentence and loses which variant it was.
    val t = tested("tests/suite/skipping.sl")

    assert_eq(verdict(t, "a_test_that_is_not_for_this_host"), "this host has no wings")
    assert_eq(verdict(t, "an_async_test_that_is_not_for_this_host_either"), "still no wings, one turn later")

    // **A `catch` does not get one**, which is `exit`'s rule: a test's decision to leave itself out
    // cannot be swallowed by a library it called. The test asserts something false after the catch,
    // so a build that let the `catch` have it fails rather than passing quietly.
    assert_eq(verdict(t, "a_skip_is_not_something_a_catch_can_swallow"),
        "a library cannot take this decision away")

@test
a_skip_outside_a_test_says_which_command_has_one_to_leave_out()
    assert(fails("skip(\"nothing to leave out\")").contains("was called outside a test"))
    assert(fails("@test\nt() = skip(1)").contains("`skip` takes string here"))
