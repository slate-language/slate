module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// The tree the parser builds and the interpreter walks.
//
// **Every node is a span and a kind, rather than an enum whose every variant carries a `Span`
// field.** The two say the same thing, and the split is what keeps the span from having to be
// destructured in each of the twenty-odd arms that only wanted the parts. It is also what makes the
// recursion one type wide: a child is a `&Expr`, never a `&`-of-one-variant.
//
// **A block is an expression, and that is the whole of slate's statement/expression story.** sysl's
// own rule is that a block's value is its trailing expression; slate takes it, so `return` is for
// leaving early and nothing else, and an `if` used for its value is the same `if` used for effect.

// An expression, with where it was written.
struct Expr
    span: Span
    kind: &ExprKind
end Expr

// What an expression is.
//
// The `&Expr` children are what make this a tree. A recursive enum through a reference is the shape
// `reference/types.md` states for exactly this, and the indirection is what gives the enum a size.
enum ExprKind
    // Literals. A number has already been decoded by the time it is here.
    IntLit(v: long)
    RealLit(v: real)
    StrLit(v: string)
    BoolLit(v: bool)
    NullLit

    // `undefined`, written so that a program can compare against it.
    UndefinedLit

    // A name being read.
    Name(name: string)

    // `...xs` in an argument list, and nowhere else.
    //
    // **It is a node rather than a flag beside the argument** because the parser builds one list and
    // `Call` reads one list; a parallel `Buf[bool]` would be a second thing to keep in step, and
    // every walk over the tree would have to carry it. Nothing outside a call's arguments builds
    // one, `{ ...o }` and `[...xs, y]` being `o with { ... }` and `concat` -- see the note against
    // spread in the repo's own file.
    Spread(inner: Expr)

    // `name = value` in an argument list, and nowhere else.
    //
    // **A node beside the others rather than a parallel list of names**, which is `Spread`'s
    // arrangement and is here for `Spread`'s reason: the parser builds one list and `Call` reads one
    // list. It is unwrapped where a call is compiled, so nothing further in knows it existed.
    Named(name: string, value: Expr)

    // `-x`, `!x`
    Unary(op: Tok, rhs: Expr)

    // `a + b`, and every other infix operator. `&&` and `||` are here too and are *not* ordinary
    // binaries at evaluation time -- they short-circuit, which the evaluator knows and this does not
    // need to record.
    Binary(op: Tok, lhs: Expr, rhs: Expr)

    // `f(a, b)`
    Call(callee: Expr, args: Buf[Expr])

    // `xs[i]`
    Index(target: Expr, key: Expr)

    // `o.name`
    // `o.f`, and `o?.f` which answers `null` where `o` has nothing to read from.
    //
    // **`?.` GUARDS ITS OWN LINK AND NOT THE REST OF THE CHAIN**, which is Kotlin's rule rather than
    // JavaScript's: `a?.b.c` reads `b` off `a` or answers `null`, and then asks `.c` of whatever
    // that was -- so a nullish `a` faults at `.c` and the reader writes `a?.b?.c`. The rule slate
    // takes everywhere about absence is that it stops at the boundary it arose at, and a `?.` that
    // silently covered every link after it would be the opposite of that: one character, written
    // once, quietly excusing a whole line.
    Field(target: Expr, name: string, optional: bool)

    // `[a, b, c]`
    ArrayLit(items: Buf[Expr])

    // `[v; n]` -- an array of `n` copies of one value. The value is evaluated once.
    ArrayRepeat(value: Expr, count: Expr)

    // `s"a ${b} c"` -- the pieces, in order, each rendered and joined. A literal chunk arrives as a
    // `StrLit` piece, so there is one list rather than two interleaved ones.
    Interp(pieces: Buf[Expr])

    // `base with { f: v }` -- a copy of an object with some fields changed.
    WithFields(base: Expr, keys: Buf[string], values: Buf[Expr])

    // `base with other` -- the same copy, where the fields to change are a value rather than written
    // out. **The literal form is not sugar for this one**: it names its keys at compile time, so a
    // key that is not a name is refused where it is written, and this cannot check anything.
    // `base with other`, and what `{ ...other }` desugars to.
    //
    // **`spread` is carried for the DIAGNOSTIC and for nothing else.** The two spellings mean the
    // same merge, but a reader who wrote `...` and is told about a `with` goes looking for one they
    // never wrote -- which is the failure this repo judges a message by.
    WithAll(base: Expr, other: Expr, spread: bool)

    // `{ a: 1, b: 2 }`. Parallel buffers rather than one of triples, because the interpreter builds
    // a map from the keys and the values and never wants either of the other two together.
    //
    // **The key spans are carried for the sake of complaints ABOUT a key**, which is a thing only a
    // reader of data ever makes: an unknown key, a repeated one, a key whose value is the wrong
    // kind. Pointing such a complaint at the value would send the reader to stare at something that
    // is fine, which is the one thing a diagnostic here may not do. Nothing that runs reads them.
    ObjectLit(keys: Buf[string], key_spans: Buf[Span], values: Buf[Expr])

    // An object that is a DATA VALUE: built, and then closed to writing.
    //
    // **Only the `data` desugar makes one, and there is no syntax for it.** A data value does not
    // change, which is what lets one be a key in a table, be compared by what it holds, and be copied
    // with `with` rather than reached into -- so the sealing belongs to the declaration rather than
    // being something a program remembers to ask for.
    //
    // **A node rather than a flag on `ObjectLit`**, because every pass that reads a literal would
    // then carry a boolean it does not read; and rather than a call to a hidden builtin, because
    // `show_program` would print a name nobody can type.
    DataLit(inner: Expr)

    // `x -> x * 2`, and the multi-parameter form `(a, b) -> a + b`. `async` in front makes it answer
    // a promise instead of a value, which is the only thing that lets its body `await`.
    //
    // **`defaults` covers the LAST of the parameters and may not reach past them.** A parameter with
    // a default that came before one without would be a parameter nothing could ever leave out, so
    // the parser refuses it -- which is what makes "how many must be given" a single number.
    Lambda(params: Buf[string], defaults: Buf[Expr], body: usize, is_async: bool)

    // `a < b < c` -- a run of comparisons that is ONE comparison, not a nest of them.
    //
    // **`operands` is one longer than `ops`**, which is the whole shape: each operator joins the pair
    // either side of it, and the middle operand is evaluated once and shared. A two-operand
    // comparison is an ordinary `Binary` and never reaches here.
    Compare(operands: Buf[Expr], ops: Buf[Tok])

    // `a..b`, `a..<b`, and either end left out.
    Range(lo: Option[Expr], hi: Option[Expr], inclusive: bool)

    // `x is Pat`, `x is not Pat`. The alternatives of a `|` are the pattern's own, which is what
    // makes the spelling here and in a `match` arm the same grammar rather than two that drift.
    IsPattern(subject: Expr, pat: Pattern, negated: bool)

    // `++x` / `x++` / `--x` / `x--`. `up` says which, and `before` says whether the value is the one
    // after the change or the one before it.
    IncDec(target: Expr, up: bool, before: bool)

    // `await e`, which suspends the call it is written in until `e` settles.
    //
    // **A prefix operator rather than a keyword form**, at the same binding power as `-` and `!`: so
    // `await f()` waits for the call's result and `await a + b` adds to what was waited for, which is
    // JavaScript's grouping and the one a reader coming from it expects.
    Await(inner: Expr)

    // `yield e`, and bare `yield`, which the parser gives a `null`.
    //
    // **A function is a generator BECAUSE it holds one of these**, which is Python's rule and needs
    // no second word on the definition. It is exact rather than a heuristic: a nested function's body
    // is interned by index rather than sitting in this tree, so a walk of one body cannot see into
    // another and `yield` inside a lambda makes the lambda the generator.
    Yield(inner: Expr)

    // `if c then a else b`, and the indented form. The `else` is optional, and an `if` without one
    // used for its value is `null` -- slate is dynamically typed, so there is no type for the missing
    // branch to disagree with.
    IfExpr(cond: Expr, then_branch: Expr, else_branch: Option[Expr])

    // `subject match` with an indented list of arms.
    MatchExpr(subject: Expr, arms: Buf[Arm])

    // **The loops are EXPRESSIONS, as sysl's are**, and that is what makes `break x` mean something:
    // a loop answers null when it finishes on its own and whatever a `break` carried when it does
    // not, so `val found = for x in xs do if p(x) then break x` is an ordinary binding.
    //
    // **Each carries an optional `else`, which runs when the loop finished on its own** -- Python's
    // rule, and sysl's. `loop` has none, since it never finishes on its own.
    While(label: string, cond: Expr, body: Expr, otherwise: Option[Expr])
    // `for x in xs` and `for [a, b] in pairs`.
    //
    // **The head is a PATTERN even where it is one name**, the parser building a `Bind` for the
    // plain case rather than reading it as a pattern would -- a bare name in pattern position is a
    // type test where it names a type, and `for string in xs` must go on binding `string`. The
    // compiler takes the one-name case back off with a `Bind` arm, so an ordinary loop still emits
    // the single `DeclareVal` it always did.
    // **`waits` is `for await x in it`**, which asks the subject for its next value and awaits the
    // answer. A flag rather than a variant of its own: every pass that walks a `For` -- `flow.sysl`'s
    // exhaustive `walk` above all -- goes on working without an arm, and what the two forms share is
    // everything but where the element comes from.
    For(label: string, binding: Pattern, iter: Expr, body: Expr, otherwise: Option[Expr], waits: bool)
    Loop(label: string, body: Expr)

    // `do body while cond` -- the loop that runs its body before it tests. Kept apart from `While`
    // rather than desugared into one, because `continue` in it goes to the *test* and not to the top.
    DoWhile(label: string, body: Expr, cond: Expr, otherwise: Option[Expr])

    // An indented run of statements, whose value is its trailing expression.
    Block(stmts: Buf[Stmt])

    // The check a function's `-> type` turns into: its body's value, tested on the way out.
    //
    // **A wrapper around the body rather than a field on `Def`**, which is the same arrangement a
    // parameter's annotation has and keeps return types out of `Def`, `Lambda` and everything that
    // reads them. The value is left where it was; only a fault comes of a failure.
    Ensures(value: Expr, type_name: string, pat: Pattern)

    // `try ... catch e ...` and `x catch e -> y`, which are one node because they are one thing.
    //
    // **An expression, so it has a value**, which is the body's if the body finished and the
    // handler's if it did not. That is what lets the postfix form stand on the right of a binding:
    // `val text = readFileSync(p) catch e -> ""`.
    TryCatch(body: Expr, name: string, handler: Expr)

    // Something was wrong here.
    //
    // **A node rather than a `Result`, and `pratt.sysl` argues the case in its own header.** A
    // parser that answers an error stops at the first mistake, so a file with two typos takes two
    // runs to fix. A node keeps the tree shaped, keeps the parser going, and lets one pass report
    // everything -- and the interpreter never sees one, because a program that produced any is not
    // run at all.
    Bad
end ExprKind

// One arm of a `match`: a pattern, an optional guard, and what to do.
//
// **The guard is part of the arm rather than part of the pattern**, and that is not a detail: a
// guard is an ordinary expression evaluated *after* the pattern's names are bound, so it can read
// them. Folding it into the pattern would put an expression inside a tree that otherwise holds
// none, and would leave the binding order unsaid.
struct Arm
    pattern: Pattern
    guard: Option[Expr]
    body: Expr
end Arm

// The kinds a bare name in pattern position may test for.
//
// **`num` is the one that is not a `Value` variant**, and it earns its place: an integer and a real
// are separate values in slate, so every piece of arithmetic a pattern wants to guard is written
// twice without it. It is the union of `int` and `real` and nothing else.
enum TypeTest derives Display
    IsNull
    IsBool
    IsInt
    IsReal
    IsNum
    IsStr
    IsArray
    IsObject
    IsFn

    // The eight temporal kinds. **Every kind a value can be is testable**, which is what makes the
    // type word the conversion and the test in one -- and the cost is the one this rule always has:
    // `date`, `time` and `zone` in pattern position now test rather than bind, as `string` and
    // `number` already did.
    IsInstant
    IsDuration
    IsDate
    IsTime
    IsDateTime
    IsZone
    IsZoned
    IsPeriod
    IsRegex

    // A declared type, as a value. **The word tests for a shape and never against one** -- `s is
    // shape` asks whether `s` is one of these, and asking whether a value fits a particular shape is
    // `s.test(v)`, which is a method because it takes two things.
    IsShape

    // A generator, which is testable for the reason every other kind is: the word is the test.
    IsGen

    // A promise. **It was the one kind with no word, and that was an omission rather than a
    // decision** -- `generator` and `regex` are each here because the rule above says every kind a
    // value can be is testable, and a promise is a value slate hands back from every `async` function
    // and every `pending`. Without it a program could not ask whether what it was given needs
    // awaiting, which is the question TypeScript answers with `x instanceof Promise`.
    IsPromise
end TypeTest

// Which kind a bare name names, if it names one at all.
//
// **A name that is not one of these is a binding**, which is the bare-name rule's other half. The
// list is closed and small on purpose: a program that wants a test slate has no word for writes a
// guard.
type_test_named(name: string) -> Option[TypeTest]
    if name == "null" then Some(IsNull)
    elif name == "boolean" then Some(IsBool)
    elif name == "integer" then Some(IsInt)
    elif name == "real" then Some(IsReal)
    elif name == "number" then Some(IsNum)
    elif name == "string" then Some(IsStr)
    elif name == "array" then Some(IsArray)
    elif name == "object" then Some(IsObject)
    elif name == "function" then Some(IsFn)
    elif name == "instant" then Some(IsInstant)
    elif name == "duration" then Some(IsDuration)
    elif name == "date" then Some(IsDate)
    elif name == "time" then Some(IsTime)
    elif name == "dateTime" then Some(IsDateTime)
    elif name == "zone" then Some(IsZone)
    elif name == "zoned" then Some(IsZoned)
    elif name == "period" then Some(IsPeriod)
    elif name == "generator" then Some(IsGen)
    elif name == "promise" then Some(IsPromise)
    elif name == "regex" then Some(IsRegex)
    elif name == "shape" then Some(IsShape)
    else None
end type_test_named

// How a kind is written, for a rendered tree and for a complaint.
type_test_text(t: TypeTest) -> string
    t match
        IsNull -> "null"
        IsBool -> "boolean"
        IsInt -> "integer"
        IsReal -> "real"
        IsNum -> "number"
        IsStr -> "string"
        IsArray -> "array"
        IsObject -> "object"
        IsFn -> "function"
        IsInstant -> "instant"
        IsDuration -> "duration"
        IsDate -> "date"
        IsTime -> "time"
        IsDateTime -> "dateTime"
        IsZone -> "zone"
        IsZoned -> "zoned"
        IsPeriod -> "period"
        IsGen -> "generator"
        IsPromise -> "promise"
        IsRegex -> "regex"
        IsShape -> "shape"
end type_test_text

// A pattern, with where it was written.
struct Pattern
    span: Span
    kind: &PatKind
end Pattern

// What a pattern tests.
//
// **slate is dynamically typed, so nothing here is checked before the program runs.** There is no
// exhaustiveness pass and there cannot be one: the set of values a name may hold is not known, so a
// subject matching no arm is a runtime fault, the way Scala's `MatchError` is. What that buys is
// that a pattern may test a *shape* -- an array of two, an object with a `name` -- which a static
// exhaustiveness check would have nothing to enumerate over.
enum PatKind
    // `_`, which matches and binds nothing.
    Wild

    // A bare name, which matches anything and binds it.
    Bind(name: string)

    // A bare name that named one of slate's kinds, which matches any value of that kind.
    //
    // **This is sysl's bare-name rule, and the analogy is exact rather than loose.** sysl says a
    // bare identifier in pattern position is a *nullary-variant pattern* when it names a nullary
    // variant of the scrutinee's enum, and a binding otherwise. slate's scrutinee is always a
    // `Value`, and `Value`'s variants are precisely `int`, `str`, `array` and the rest -- so the
    // same rule, applied to the same shape, gives a type test and costs no new syntax.
    //
    // What it costs is what sysl's costs: those eight words cannot be *binding* names in a pattern.
    // `n @ int` is how a program tests and names at once, which is again sysl's spelling.
    TypePat(test: TypeTest)

    // `n @ pat`, which binds the whole value as well as whatever the sub-pattern bound.
    At(name: string, inner: Pattern)

    // A literal, which matches a value equal to it.
    IntPat(v: long)
    RealPat(v: real)
    StrPat(v: string)
    BoolPat(v: bool)
    NullPat

    // `[a, b]`, `[first, ...rest]`, and `[first, ...]`.
    //
    // **Two fields rather than one, because "may be longer" and "binds the tail" are separate
    // questions.** `open` says the fixed patterns are a floor rather than an exact length; `rest`
    // says whether what is left over is given a name. `[a, ...]` is open and binds nothing, which
    // is the arm that means "at least one, and I do not care about the others" -- spelling it
    // `[a, ..._]` to reach a single field would have been a wildcard that is not one.
    // **`defaults` runs beside `items` and is the same length**, holding the expression written
    // after a `=` where one was and nothing where it was not. A defaulted element is OPTIONAL: the
    // array may stop before it and the pattern still fits.
    ArrayPat(items: Buf[Pattern], open: bool, rest: Option[string], defaults: Buf[Option[Expr]])

    // `{ name: n, born: _ }`. It matches an object that has *at least* these fields, which is the
    // useful reading: a record grows fields over its life, and a pattern that broke whenever one was
    // added would be a pattern nobody could keep working.
    //
    // **`defaults` and `optional` are two questions and the second one is why they are two buffers.**
    // Both make a field one the subject need not have; they differ in what happens then. A `default`
    // says *what to bind* when it is absent, which only a binding can use -- so `{ xs = [] }` is
    // refused in a `match` arm, where there is nothing to bind and an arm that matched every object
    // would be a trap. A `?` says *nothing at all* happens when it is absent, which only a test can
    // use -- so `{ pinned? }` is refused in a binding, where a name left unbound is a fault waiting
    // for the line that reads it.
    //
    // **So the pair reads: `=` is for a pattern that binds, `?` is for a pattern that tests**, and a
    // field is allowed to be missing where either is set. They were one buffer until `?` existed,
    // `defaults.at(i).is_some()` having been the whole of "may this be absent".
    ObjectPat(keys: Buf[string], values: Buf[Pattern], defaults: Buf[Option[Expr]], optional: Buf[bool])

    // `array of string`, and `object of integer`: a container every one of whose elements fits.
    //
    // **The element pattern is what an array pattern's `...` could never say.** `[string, ...]` tests
    // the elements it writes and lets the rest through, so a list of unknown length -- the commonest
    // thing in a request body -- had no spelling at all: `["a", 2] is [string, ...]` was **true**.
    //
    // **An EMPTY container fits, and that is the reading a test wants.** Every element of nothing is
    // a string, and a shape that refused `[]` would refuse the ordinary answer to a query that found
    // nothing. A caller wanting at least one says so with an intersection -- `[any, ...] & array of
    // string` -- which is `&` earning its place a second time and is why no floor is written here.
    //
    // **It binds nothing and may not**, an element pattern running once per element: a name would be
    // bound to whichever element ran last, which is a value nobody asked for. `refuse_binding_under`
    // is where that is said.
    EveryPat(container: TypeTest, element: Pattern)

    // `integer -> integer`, `(A, B) -> C`, and `() -> C`: a function, said in terms of what it takes
    // and what it answers.
    //
    // **IT IS READ IN A TYPE POSITION AND NOWHERE ELSE, because `->` is also the `match` arm arrow.**
    // An arm's `string -> "a"` would otherwise read as a function from `string` to the literal type
    // `"a"` -- both halves being perfectly good types -- and the arm's body would be gone. So
    // `parse_type` reads this and `parse_pattern` does not, which is the one place the two grammars
    // part company.
    //
    // **What it tests at run time is callability and the count**, and it cannot test more: the types
    // of a function's parameters are not a question about a value that has arrived, they are a
    // question about every call that will ever be made. Those are the checker's, which is where
    // writing one down pays -- a lambda handed to a parameter of this type gets its own parameters
    // typed from it, and what it does with them is checked.
    FnPat(params: Buf[Pattern], result: Pattern)

    // `T`, where the enclosing definition or type declaration wrote `[T]`.
    //
    // **A TYPE PARAMETER IS ERASED AT RUN TIME AND SOLVED IN THE CHECKER, and those are two halves
    // of one decision.** Nothing at run time can test that two arguments were the same type -- the
    // machine sees values, not the calls that will be made -- so the pattern this compiles to
    // matches anything, exactly as `any` does. What a type parameter buys is what the CHECKER can do
    // with it: `first[T](xs: array of T) -> T` says the answer is a string when the array was one,
    // and `map2[A, B](xs: array of A, f: A -> B)` types the lambda's parameter from the array beside
    // it.
    //
    // **The parser decides what is one, which is why this is a kind of its own rather than a name
    // looked up later.** A bare name in a type is a declared type or a mistake; a name the
    // definition's own `[...]` introduced is neither, and only the parser knows the difference --
    // so it says so here and nothing downstream has to guess.
    TypeVarPat(name: string)

    // `type Pair[A, B] = { first: A, second: B }` -- what the declaration registers.
    //
    // **It is the DECLARATION and never the use**, and it never survives resolution: a use names it
    // with `Pair[string, integer]`, and `resolve_pattern` substitutes the arguments through `inner`
    // and hands back an ordinary pattern. So nothing that matches a value ever meets one.
    GenericPat(params: Buf[string], inner: Pattern)

    // `Pair[string, integer]` -- a generic type, with the types it was given.
    //
    // **Resolved rather than matched**, for the reason above: the declaration may be written below
    // the use and may arrive from another file, so the substitution has to wait until every type is
    // registered -- which is the moment `resolve_pattern` runs.
    AppliedPat(name: string, args: Buf[Pattern])

    // `1 | 2 | 3`. No alternative may bind a name -- see `parse_pattern`.
    OrPat(alts: Buf[Pattern])

    // `Authed & Noted`. Every part must match, and `|`'s dual.
    //
    // **A part MAY bind, where an alternative may not, and the asymmetry is the whole difference
    // between the two.** An alternative leaves a name bound down one path and not the other, so
    // every use of it below is a name that may or may not exist. Every part of an intersection runs,
    // so what one binds is bound whenever the pattern matched at all -- and `{ id } & { name }`
    // binding both is the reading anybody would expect.
    //
    // **It earns its place where layers of a composition accumulate fields.** A guard that adds a
    // `user` and one that replaces a `body` leave a value the handler wants to describe, and without
    // this the combined shape is written out by hand and drifts from the guards that make it.
    AndPat(parts: Buf[Pattern])

    // `p is Point`, where `Point` is a class: whether the value's `proto` chain reaches the object
    // that class bound.
    //
    // **A class registers its name as a type whose shape is this**, which is why `is`, an annotation
    // and `export` all work on one without a line of their own. The name is looked up in the scope
    // the match is running in rather than being captured, for the reason a `LoadName` is: a pattern
    // lives in the unit's table and is shared by every frame that reaches it.
    //
    // **`fields` is what the class was made from, and it is what lets a pattern take one apart.** It
    // is not written in any pattern -- the declaration puts it here. A class whose `new` builds its
    // object by hand names no fields for slate to know about, and leaves this empty.
    //
    // **`positional` is whether `Point(x, y)` may be written, and it is a SEPARATE question from
    // whether the names are known.** Taking a class apart by position promises that the pattern
    // binds what the call sets, which holds only while the constructor's parameter list *is* this
    // list -- `new(var x, scale)` takes two arguments and makes an object with one field, so no
    // positional pattern over it could mean what the call beside it means. Naming the fields is
    // still perfectly well-defined there, so `Point { x }` is allowed and checked.
    ProtoPat(name: string, fields: Buf[string], positional: bool)

    // `Shape` -- any variant of a data declaration, and the list of which they are.
    //
    // **It matches exactly as `ProtoPat` does** and is a separate kind only because it carries
    // `variants`. That list is what lets the checker say a `match` over a `Shape` has left one out,
    // and it travels between files for free: a type's registered pattern is what an import brings
    // across, so nothing had to learn to carry a second table beside it.
    DataPat(name: string, variants: Buf[string])

    // `Circle(r)`, `Point(x, y)`, `Circle`, and `Empty` -- something made from `name`, with the
    // fields it was made from taken apart by position.
    //
    // **It serves a class exactly as it serves a data variant, because the two ask the same
    // question.** A variant and a class both answer "was this made from that", and both know the
    // order their maker takes its fields in; where those two facts come from differs, and nothing
    // downstream of `resolve_pattern` can tell which kind of declaration filled them in. The name
    // says variant because that is where the node started.
    //
    // **`items` and `keys` are never both written by the same hand.** The parser fills `items` from
    // what stands in the brackets and leaves `keys` empty; the declaration registers the reverse, a
    // pattern with the field names and no sub-patterns, which is what a bare `Circle` in an
    // annotation or an `is` resolves to. `resolve_pattern` marries them and is where an arity that
    // does not match the declaration is refused.
    //
    // **`singleton` is a variant that declared no fields**, which is a value rather than a maker --
    // so the test is identity with that one object rather than a walk up a chain to it. No class is
    // ever a singleton: a class is a maker whatever it declares.
    VariantPat(name: string, items: Buf[Pattern], keys: Buf[string], singleton: bool)

    // `Point { x: a, y }` and `Circle { r }` -- something made from `name`, with its fields taken
    // apart BY NAME.
    //
    // **`inner` is an ordinary `ObjectPat` and is matched by the ordinary object machinery**, so
    // shorthand, defaults and nesting all work here the day they work there and nothing had to be
    // written twice. What this node adds is the nominal half: the value must also have been made
    // from `name`, which the object pattern alone cannot ask.
    //
    // **The pairing is also what lets a MISSPELLED FIELD be refused.** `{ raduis: r }` on its own is
    // a legal pattern that simply never matches, because any object may lack any field; written
    // against a declaration that lists its fields, `resolve_pattern` has something to check it
    // against and says so where it was written.
    MadeFrom(name: string, inner: Pattern)
end PatKind

// A statement, with where it was written.
struct Stmt
    span: Span
    kind: &StmtKind
end Stmt

// What a statement is.
//
// **`Val` and `Var` do not clash with `Tok`'s words of the same name.** Two enums in one module may
// each declare a variant called `Val`; the expected type is what picks between them, and where
// nothing supplies one the compiler asks for `Tok.Val` or `StmtKind.Val` by name.
// Which of the three places a module comes from.
//
// **Three syntaxes rather than three readings of one string.** A file is a quoted path, a package is
// a bare word, and one of slate's own is `slate:name` -- so no reader ever has to work out which of
// them a specifier meant, and a package called `http` can never be confused with `slate:http`. That
// last ambiguity is the one node introduced the `node:` prefix to fix, having shipped without it.
//
// **The prefix cannot be written inside quotes the way node writes `'node:http'`.** node can, every
// specifier there being a string; here a quoted path already means a file, so the colon form is a
// bare one and `slate`, `:` and the name are three tokens the lexer already had.
enum Origin
    FromFile
    FromPackage
    FromSlate
end Origin

enum StmtKind
    // `val x = e` and `var x = e`. The difference is whether a later assignment is refused.
    Val(name: string, init: Expr)
    Var(name: string, init: Expr)

    // `val [a, b] = xs` and `val { name, born } = person` -- a binding that takes a value apart.
    //
    // **A separate node rather than a `Val` over a pattern**, because binding one name is what
    // nearly every binding does and it costs one instruction: making the ordinary case pay for the
    // machinery of the rare one would show up in every program. The parser decides between them by
    // the first token, which is `[` or `{` or neither.
    Unpack(pat: Pattern, init: Expr, immutable: bool)

    // Several declarations that one line of source wrote, bound where the group stands.
    //
    // **Not a `Block`, and the difference is the whole reason it exists**: a block opens a scope and
    // these names have to land in the scope around them. `data Shape` declares the shared object and
    // one more name for each variant, all of them at the top level of the file where a `match` and an
    // `export` can see them.
    //
    // Nothing else builds one, and nothing downstream needs to know which declaration did: a group is
    // compiled by compiling each statement in it, which is what every pass here does with it.
    Group(stmts: Buf[Stmt])

    // `x = e`, `o.f = e`, `xs[i] = e`, and the compound forms `x += e` and the rest. What may stand
    // on the left is decided by the parser, so the interpreter is handed a target it already knows is
    // assignable.
    //
    // **`op` is `Assign` for a plain one and the arithmetic operator for a compound one**, rather
    // than the compound form being desugared into `x = x + e`. The difference is that the target is
    // evaluated ONCE: `xs[next()] += 1` calls `next` a single time, which the desugaring would not.
    Assign(op: Tok, target: Expr, value: Expr)

    // `a, b = b, a` -- several places at once. **Every value is computed before any place is
    // written**, which is what makes the swap a swap.
    MultiAssign(op: Tok, targets: Buf[Expr], values: Buf[Expr])

    // A named function, which is a `val` holding a closure and is kept apart from one only so that
    // it can be recursive: the name is in scope inside the body.
    //
    // **`defaults` reads exactly as a `Lambda`'s does**, covering the last of the parameters.
    //
    // **A REST PARAMETER TRAVELS IN ITS OWN NAME, `...rest`, RATHER THAN AS A FIELD HERE.** `...`
    // cannot appear in an identifier, so the marked name is unspellable and cannot collide with
    // anything a program wrote -- which is the arrangement `(0)` already uses for a destructured
    // parameter and `(data)` for the name a variant prints as. A field would have been read by three
    // passes and carried by twenty-four sites that have no use for it, which is the same argument
    // that keeps annotations off this node.
    //
    // `rest_param` and `plain_param` below are the only two functions that know the spelling, and
    // `Chunk` carries the decoded name beside a `variadic` flag -- so nothing downstream of
    // compilation ever sees a marked one.
    Def(name: string, params: Buf[string], defaults: Buf[Expr], body: usize, is_async: bool)

    // An expression evaluated for its effect, or -- as the last statement of a block -- for its
    // value.
    Eval(e: Expr)

    // `return`, with or without a value.
    Return(value: Option[Expr])

    // `throw v` -- raise a fault the nearest `catch` may have.
    //
    // **The value is required, where `return`'s is optional.** A fault with nothing in it says
    // nothing to whoever catches it, and `throw` with no operand would be asking a reader to guess
    // whether the omission was meant.
    Throw(value: Expr)

    // `break`, `break 'outer`, `break v`, `break 'outer v`.
    //
    // **A `break` may carry a value, and that value is the LOOP's**, which is what makes a loop an
    // expression worth writing on the right of a binding: `val found = for x in xs do if p(x) then
    // break x`. A loop that finishes on its own answers null, or whatever its `else` left.
    //
    // The label is empty where none was written, rather than an `Option`: every reader immediately
    // compares it against a frame's, and the empty string is the "any" that comparison wants.
    Break(label: string, value: Option[Expr])
    Continue(label: string)

    // `import { a, b as c } from "./util.sl"`.
    //
    // **The path is the text as it was written, not a resolved one.** Resolving it needs the
    // directory of the file the import is *in*, which the parser has no business knowing -- it is
    // handed a `Source` and a name, and a name may be `<stdin>` or a test's `t`. `module.sysl`
    // resolves, and does it the same way twice: once while loading, and once while compiling, from
    // the same two strings.
    //
    // `names` is what the other file calls them and `locals` is what this one will, so a plain
    // `import { a }` has the same string in both. The two run in step and are the same length.
    // **`origin` is what the parser SAW, not what the path looks like.** The three kinds are three
    // syntaxes rather than three readings of one string, so nothing already written can change
    // meaning -- `"parsing"` in quotes stays a file that does not exist rather than quietly
    // becoming the package of that name.
    ImportNames(path: string, path_at: Span, origin: Origin, names: Buf[string], locals: Buf[string])

    // `import * as util from "./util.sl"` -- the whole of another file's exports under one name.
    ImportAll(path: string, path_at: Span, origin: Origin, alias: string)

    // `type Point = { x: num, y: num }`.
    //
    // **It runs nothing.** A type is resolved while compiling -- a name standing in a pattern is
    // replaced by the pattern the type declared -- so the statement is here to be seen by a reader
    // and by `show_program`, and compiles to the one value every statement leaves.
    TypeDecl(name: string, pat: Pattern)

    // The check a parameter written `p: Point` turns into.
    //
    // **Generated by the parser rather than carried on `Def`**, which is what keeps annotations out
    // of `Def` and `Lambda` and out of everything downstream that reads them. The function is an
    // ordinary one of one parameter; what the annotation added is a statement at the top of its body.
    CheckType(name: string, type_name: string, pat: Pattern)

end StmtKind

// A whole file: the statements at its top level, and what it lets other files see.
//
// **`exports` is gathered by the parser rather than left in the tree**, and that is what keeps
// `export` from being an AST node at all: the word adds a name to this list and the statement it
// prefixes compiles exactly as it would have without it. A module's exports object is then built
// from this list at the end of its chunk, which is the one place that needs to know.
struct Program
    stmts: Buf[Stmt]
    exports: Buf[string]

    // The types this file declared: names, the pattern each stands for, and whether `export` was
    // written in front of it.
    //
    // **Three parallel lists, gathered by the parser exactly as `exports` is.** A type has no runtime
    // existence at all, so there is nothing for it to be in the tree.
    type_names: Buf[string]
    type_pats: Buf[Pattern]
    type_public: Buf[bool]

    // The definitions written under `@test`, in the order they appear.
    //
    // **Gathered by the parser exactly as `exports` is**, and for the same reason: `@test` changes
    // nothing about the function it marks, so there is no node for it and the definition compiles as
    // it would have without the annotation.
    tests: Buf[string]
end Program

// -- function bodies ------------------------------------------------------------------------------

// Every function body in the program, and a `Lambda` or a `Def` names one by its index here.
//
// **The indirection exists because a closure lives in the collected heap and a body may not.** A
// `ClosureObj` is GC-allocated raw memory, and raw memory can hold a `string`, a `Buf` or a `Map` --
// each of those was checked -- but *not* a counted box: an `Expr` holds a `&ExprKind`, and storing
// one into a raw block segfaults, because a `&T` is never null in sysl's model and its release path
// has nothing to guard uninitialised bytes with.
//
// So the tree stays where it is, reference counted and outside the collector, and a closure carries
// a `usize`. That is the right division anyway: the tree is immutable and acyclic, which is exactly
// what refcounting is good at, and it is shared by every closure made from one syntactic function
// rather than copied into each.
//
// **Interned while parsing, so the table is bounded by the program's size** rather than by how many
// closures it makes. A loop creating a million closures adds nothing here.
var bodies: Buf[Expr] = buf()

// Whether the body at the same index yields, parallel to `bodies`.
//
// **Answered by the PARSER rather than by a walk of the tree.** The parser counts the `yield`s it
// reads inside each body and knows the answer as it finishes one; a walk would be a second recursion
// over every kind of node, kept in step with the first by hand, to learn something already known.
var body_yields: Buf[bool] = buf()

// Take a body into the table and answer its index.
intern_body(e: Expr, yields: bool) -> usize
    bodies.push(e)
    body_yields.push(yields)
    bodies.len() - 1

// The body an index names.
body_at(i: usize) -> Expr = bodies.at(i)

// Whether the body at this index is a generator's.
body_is_gen(i: usize) -> bool = body_yields.at(i)

// Forget every body. Called when a new program is parsed.
clear_bodies()
    bodies.clear()
    body_yields.clear()

// -- construction -------------------------------------------------------------------------------

// The two constructors are here so that a parser reads without the tree's boxing on every line.
//
// **There is no operator on the argument, and reaching for one is the mistake to know about.** A
// `&T` is a counted box, not an address, so a value read into one is put in a box where it stands;
// `&kind` would be taking the address of a local, which is a different thing entirely and is
// refused in as many words.
expr(span: Span, kind: ExprKind) -> Expr = Expr(span, kind)

stmt(span: Span, kind: StmtKind) -> Stmt = Stmt(span, kind)

pattern(span: Span, kind: PatKind) -> Pattern = Pattern(span, kind)

// -- a rest parameter's name -----------------------------------------------------------------------

// How a rest parameter is marked in a `Def`'s or a `Lambda`'s parameter list. **`...` cannot appear
// in an identifier**, so nothing a program can write collides with it.
const RestMark: string = "..."

// Mark a name as the one that gathers what is left over.
marked_rest(name: string) -> string = RestMark + name

// The name a rest parameter gathers into, where this parameter is one.
rest_param(param: string) -> Option[string] =
    if param.starts_with(RestMark) then Some(param[RestMark.len..]) else None

// A parameter's name with the mark taken off, which is what it is called inside the body.
plain_param(param: string) -> string = rest_param(param) match
    Some(name) -> name
    None -> param
