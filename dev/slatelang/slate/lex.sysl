module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// Bytes to tokens, with indentation turned into structure on the way.
//
// The pass is `sh.sysl.parsing`'s `layout` doing the bookkeeping and this file deciding what the
// bookkeeping *means*: the column stack, the bracket depth and the arithmetic of closing several
// blocks at once are all there, and what a `NEWLINE` is called and whether a blank line counts as a
// line at all are here, because those are the grammar's and not the toolkit's.
//
// **Three tokens carry the shape of the file and none of them is a character in it.** `Indent` opens
// a block, `Dedent` closes one, and `Newline` separates two statements at the same depth. Above this
// line the parser never looks at a column.

// A tab advances to the next multiple of this. Eight is what a terminal does, and therefore what the
// person looking at the file sees.
private const TabWidth: usize = 8

// The result of reading a whole file: the tokens, and everything that was wrong with it.
//
// **Both, rather than one or the other.** A lexer that stops at the first bad byte reports one
// mistake per run, and a file with two typos in it takes two runs to fix. So a malformed literal is
// recorded and skipped, and the caller decides whether a non-empty report means the parse should go
// ahead -- which for slate it does not, but that is the caller's rule to state.
struct Lexed
    tokens: Tokens[Tok]
    report: Report

    ok(self) -> bool = !self.report.has_errors()
end Lexed

// Read a whole source into tokens.
lex(src: Source) -> Lexed
    var s = scan(src)
    var lay = layout()
    var out: Tokens[Tok] = tokens()
    var rep = report()

    // The elements and holes still open, innermost last, and where each of them began. Two buffers
    // rather than one of pairs, because the top of the stack is REPLACED as often as it is pushed --
    // an opening tag's `>` turns it into children -- and replacing means a pop and a push.
    var slx: Buf[SlxWhere] = buf()
    var slx_at: Buf[Span] = buf()

    // Whether the cursor is at the head of a line whose indentation has not been measured yet. It is
    // only ever set where the layout is significant, so a line continued inside brackets never
    // reaches the measuring branch at all.
    var at_line_head = true

    // Whether anything has been emitted. The first line of a file opens no block and ends no
    // statement, so it gets neither an `Indent` nor a `Newline`, and this is what tells it apart
    // from an identical line halfway down.
    var started = false

    loop
        if at_line_head
            val ind = measure_indent(&s, TabWidth)

            if s.at_end()
                break

            // A line with nothing on it but spaces, or nothing but a comment, is not a line: it has
            // no statement to separate and no block to open, and a person who indents a comment to
            // line up with the code below it did not mean to open one.
            if s.at_line_end() || s.starts_with("//".bytes)
                s.skip_line()
                continue
            end if

            if ind.is_mixed()
                rep.add(error(s.here(), "this line is indented with both tabs and spaces")
                    .with_note("a file may use either, but a file using both nests differently in different editors"))

            emit_dent(&out, &rep, lay.line(ind.columns), s.here(), started)

            started = true
            at_line_head = false
        end if

        // **Children are read before the blank-skipping below, and that ordering is the whole
        // reason a mode is needed.** Between a tag's `>` and the `<` that ends it a space is a
        // character, `//` is not a comment and a newline is not a line ending, so every line of the
        // loop under this one would take something out of the text.
        if slx_in_text(&slx)
            scan_slx_text(&s, &lay, &out, &rep, &slx, &slx_at)
            continue

        s.skip_blanks()

        if s.starts_with("//".bytes)
            s.skip_to_line_end()

        if s.at_end()
            break

        if s.at_line_end()
            s.accept_newline()

            if lay.significant()
                at_line_head = true

            continue
        end if

        scan_token(&s, &lay, &out, &rep, &slx, &slx_at)
    end loop

    // Whatever is still open at the end of the file closes there, and the statement on the last line
    // ends there too. The empty span at the end is where a complaint about an unterminated construct
    // points.
    val eof = point(s.at)

    if started
        out.push(Newline, eof)

    for _ in 0..<lay.finish()
        out.push(Dedent, eof)

    out.push(Eof, eof)

    Lexed(out, rep)
end lex

// Turn one line's indentation into the tokens that stand for it.
//
// **A `Dedent` ends the statement above it as well as closing the block**, so no `Newline` is
// emitted beside one. The parser therefore accepts either as a statement terminator, which is the
// same rule Python's grammar states and is what keeps the last statement of a block from needing a
// blank line under it.
private emit_dent(out: *Tokens[Tok], rep: *Report, d: Dent, at: Span, started: bool)
    d match
        Same ->
            if started then out.push(Newline, at)
        Deeper ->
            out.push(Indent, at)
        Shallower(levels) ->
            if started then out.push(Newline, at)

            for _ in 0..<levels
                out.push(Dedent, at)
        Ragged(levels) ->
            rep.add(error(at, "this line lines up with no block that is open")
                .with_note("it is less indented than the line above and matches none of the levels still open"))

            if started then out.push(Newline, at)

            for _ in 0..<levels
                out.push(Dedent, at)
end emit_dent

// One token, from wherever the cursor is standing.
//
// The cursor is known not to be at a newline, at the end, or on a space: the loop above has dealt
// with all three, so what is here begins something.
private scan_token(s: *Scanner, lay: *Layout, out: *Tokens[Tok], rep: *Report,
                   slx: *Buf[SlxWhere], slx_at: *Buf[Span])
    // Inside a tag the grammar is its own: a name may hold a hyphen, whitespace separates nothing,
    // and `>` ends the tag rather than comparing two things.
    if slx_in_tag(slx)
        scan_slx_tag(s, lay, out, rep, slx, slx_at)
        return

    // The `}` that ends a hole, told from the `}` of an object literal written inside one by the
    // frame every `{` pushes.
    if slx_top(slx) == Some(SlxWhere.Hole) && s.starts_with("}".bytes)
        val h = s.mark()

        s.bump()
        close_blocks(lay, out, h)
        out.push(RBrace, s.span_from(h))
        slx_leave(slx, slx_at)
        return

    val m = s.mark()

    // **`<` begins an element only where an operand is expected**, which is the whole of the
    // ambiguity: `<` is otherwise always an infix operator, so in prefix position it can begin
    // nothing else.
    if opens_element(s, out)
        s.bump()
        out.push(SlxOpen, s.span_from(m))
        lay.open_bracket()
        slx.push(SlxWhere.Opening)
        slx_at.push(s.span_from(m))
        return

    s.peek() match
        None -> return
        Some(c) ->
            if c == u8('\'') then
                scan_label(s, out, rep, m)
            elif is_ident_start(c) then
                scan_word(s, lay, out, rep, m)
            elif is_digit(c) then
                scan_number(s, out, rep, m)
            elif c == u8('"') then
                scan_string(s, out, rep, m)
            else
                scan_punct(s, lay, out, rep, m)

    // A `{` written inside an element opens a frame of its own, so that the `}` closing an object
    // literal in a hole is not mistaken for the one closing the hole.
    if slx.len() > 0 && just_pushed(out) == LBrace
        slx.push(SlxWhere.Hole)
        slx_at.push(s.span_from(m))
end scan_token

// `'outer` -- the name a loop carries.
//
// **A token of its own rather than a quote followed by a name**, because that is the only way the
// binding-power loop can tell one from an expression: a label appears exactly where a loop keyword is
// about to, and nothing else in slate spells `'`.
private scan_label(s: *Scanner, out: *Tokens[Tok], rep: *Report, m: usize)
    s.bump()

    val start = s.mark()

    s.read_ident(is_ident_start, is_ident_cont)

    if s.offset == start
        rep.add(error(s.span_from(m), "a label is an apostrophe and a name, as in `'outer`"))
        return

    out.push(Label, s.span_from(m))
end scan_label

// A word: an identifier, or one of the words the grammar has taken.
// Whether nothing but blanks and a trailing comment stand between the cursor and the end of the line.
//
// **This is what decides whether a token may open a block, and it is not a tidiness check.**
// `opens_block` says "the next newline counts", and the flag it sets survives until a newline is
// actually met -- wherever that is. So nominating a token written *mid*-line hands the flag to some
// later line, which then opens a block it has nothing to do with:
//
//     print(f(x -> x),
//           other)
//
// The newline after the comma would open a block at the column `other` sits at, and the `)` would
// have to close it. Nominating only at the end of a line means the newline the flag is set for is
// the very next thing read.
private line_ends_here(s: *Scanner) -> bool
    val blanks = s.peek_while(is_blank)

    s.peek_at(blanks) match
        None -> true
        Some(c) ->
            if is_newline(c) then return true

            // A comment runs to the end of the line, so a line ending in one still ends here.
            c == u8('/') && s.peek_at(blanks + 1) == Some(u8('/'))
end line_ends_here

private scan_word(s: *Scanner, lay: *Layout, out: *Tokens[Tok], rep: *Report, m: usize)
    s.read_ident(is_ident_start, is_ident_cont)

    // **`s"..."` is a word followed by a quote, and nothing else here is**, so the prefix is spotted
    // after the identifier rather than before it -- which leaves `s` an ordinary name everywhere a
    // quote does not follow.
    if s.text_from(m) == "s".bytes && s.starts_with("\"".bytes)
        scan_interpolated(s, out, rep, m)
        return

    val kind = word_kind(s.text_from(m))

    // **`match` opens a block wherever it is written, brackets included.** Without this,
    // `push(labels, n match ...)` would have its arms inside a bracket pair, where a newline means
    // nothing, so the block would never open. It is the grammar's job to nominate the token; the
    // layout owns the bookkeeping. `->` is the other one, in `scan_punct`.
    //
    // **`try` is nominated on the same terms, and a `catch`'s NAME rather than its word.** That
    // asymmetry is the grammar's, not a shortcut: `x match` ends its line and so does `try`, but a
    // `catch` is always followed by the name it binds, so the token that ends the line is an
    // ordinary identifier. What tells it from every other identifier is the token before it, which
    // is the one thing a lexer walking forwards already has.
    if line_ends_here(s)
        if kind == Match || kind == Try
            lay.opens_block()
        elif kind == Ident && just_pushed(out) == Catch
            lay.opens_block()

    out.push(kind, s.span_from(m))
end scan_word

// The kind of the token most recently pushed, or `Eof` where there is none.
private just_pushed(out: *Tokens[Tok]) -> Tok
    if out.items.len() == 0 then return Eof

    out.items.at(out.items.len() - 1).value
end just_pushed

// The body of an `s"..."`, taken whole.
//
// **The walking is `read_interpolated`'s**, which knows the part that is hard: a `}` inside a nested
// string or a nested brace pair is not the one that closes a hole. What is slate's is the spelling --
// the `s` prefix, `${` for a hole -- and the sentence a person reads when one does not close.
private scan_interpolated(s: *Scanner, out: *Tokens[Tok], rep: *Report, m: usize)
    read_interpolated(s, u8('"'), "${".bytes, u8('}')) match
        Ok(_) -> out.push(StrInterp, s.span_from(m))
        Err(e) -> rep.add(error(where(e), lit_message(e)))
end scan_interpolated

// Which token a run of identifier bytes is.
//
// **A chain of comparisons rather than a table, and it is the right shape here.** A table would be
// module storage -- an initializer that runs before the program does -- and slate's word list is
// twenty-seven entries, which a chain settles in a handful of byte compares because the lengths differ.
// Every hand-written lexer this file was modelled on does exactly this.
//
// `end` is deliberately absent: it is a soft word, so it arrives as an `Ident` and the parser
// decides by what follows. See the note in `tok.sysl`.
//
// **Not `private`, because the PRINTER has to ask the same question.** A key prints bare only where
// slate could read it back as a name, and the sole correct way to answer that is to ask the lexer
// what it would do with the word -- anything else is a second word list that drifts from this one.
word_kind(w: []const u8) -> Tok
    if w == "val".bytes then Val
    elif w == "var".bytes then Var
    elif w == "if".bytes then If
    elif w == "then".bytes then Then
    elif w == "elif".bytes then Elif
    elif w == "else".bytes then Else
    elif w == "while".bytes then While
    elif w == "for".bytes then For
    elif w == "in".bytes then In
    elif w == "loop".bytes then Loop
    elif w == "do".bytes then Do
    elif w == "match".bytes then Match
    elif w == "break".bytes then Break
    elif w == "continue".bytes then Continue
    elif w == "return".bytes then Return
    elif w == "true".bytes then True
    elif w == "false".bytes then False
    elif w == "null".bytes then Null
    elif w == "undefined".bytes then Undefined
    elif w == "async".bytes then Async
    elif w == "await".bytes then Await
    elif w == "yield".bytes then Yield
    elif w == "is".bytes then Is
    elif w == "with".bytes then With
    elif w == "import".bytes then Import
    elif w == "export".bytes then Export
    elif w == "try".bytes then Try
    elif w == "catch".bytes then Catch
    elif w == "throw".bytes then Throw
    else Ident
end word_kind

// A number, which slate keeps as an integer or a real exactly as it was written.
//
// **The value is thrown away here and read again in the parser.** What this call is for is the
// *diagnosis*: `read_number` knows about radix prefixes, underscores and overflow, so a malformed
// literal is caught at the byte that caused it rather than surviving into a tree.
private scan_number(s: *Scanner, out: *Tokens[Tok], rep: *Report, m: usize)
    read_number(s) match
        Ok(n) ->
            // The annotation is what says which `IntLit` this is: `ExprKind` has one too, and with
            // nothing else on this line to supply an expected type the compiler asks.
            val kind: Tok = n match
                Int(_) -> IntLit
                Real(_) -> RealLit

            out.push(kind, s.span_from(m))
        Err(e) ->
            rep.add(error(where(e), lit_message(e)))

            // Step past whatever the reader stopped on, so that the loop above cannot spin on it.
            if s.offset == m then s.bump()

// A quoted string. The span kept is the whole lexeme, both quotes included, because that is what a
// caret should underline when the complaint is about the literal rather than about one escape in it.
private scan_string(s: *Scanner, out: *Tokens[Tok], rep: *Report, m: usize)
    read_quoted(s, u8('"')) match
        Ok(_) -> out.push(StrLit, s.span_from(m))
        Err(e) ->
            rep.add(error(where(e), lit_message(e)))

            if s.offset == m then s.bump()

// Everything that is neither a word, a number nor a string.
private scan_punct(s: *Scanner, lay: *Layout, out: *Tokens[Tok], rep: *Report, m: usize)
    punct_kind(s, lay, out, rep, m) match
        Some(k) ->
            // **An `->` at the end of its line opens a block, brackets included.** That is what lets
            // a callback be written where it is passed --
            //
            //     onData(conn, chunk ->
            //         if chunk == null
            //             close(conn)
            //         else
            //             send(conn, chunk))
            //
            // -- which without it is a parse error, because a newline inside a bracket pair means
            // nothing and the block never opens. `match` is nominated the same way and for the same
            // reason; sysl nominates exactly these two.
            if k == Arrow && line_ends_here(s) then lay.opens_block()

            out.push(k, s.span_from(m))
        None ->
            s.next_char()

            rep.add(error(s.span_from(m), s"`${escape_text(s.text_from(m))}` is not a slate character"))

// The operator or separator at the cursor, consumed.
//
// **Two bytes are tried before one, and the order is the whole of the rule**: `=` would swallow the
// first half of `==` and `-` the first half of `->`. A bracket adjusts the layout's depth on the way
// past, which is what makes a newline inside one insignificant.
// The blocks a closing bracket closed, as `Dedent`s emitted before the bracket itself.
//
// **A block opened inside a bracket pair is closed by the bracket and never by a line**, because the
// `)` sits on the same line as the block's last line -- so no line ending will ever reach it. The
// count comes back from `close_bracket`, and these go out first so that the parser sees the block
// end before the `)` that ended it.
private close_blocks(lay: *Layout, out: *Tokens[Tok], m: usize)
    val closed = lay.close_bracket()

    for _ in 0..<closed
        out.push(Dedent, point(m))

private punct_kind(s: *Scanner, lay: *Layout, out: *Tokens[Tok], rep: *Report, m: usize) -> Option[Tok]
    // Three bytes before two before one, for the same reason two goes before one: `...` would
    // otherwise be read as three field selections, and `||` as two alternatives.
    if s.accept_seq("...".bytes) then return Some(Spread)

    // **`..=` is refused by name**, which is sysl's rule and worth keeping: a reader arriving from
    // Rust writes it once, and what the ordinary grammar would hand back is a sentence about the
    // open-ended range `a..` that was parsed -- true about something else, and never mentioning the
    // `=` that caused it.
    if s.accept_seq("..=".bytes)
        rep.add(error(s.span_from(m), "`..=` is not a range -- inclusive is `a..b` and exclusive is `a..<b`"))
        return Some(DotDot)

    if s.accept_seq("..<".bytes) then return Some(DotDotLt)
    if s.accept_seq("..".bytes) then return Some(DotDot)

    // Three-byte operators, before the two-byte ones they begin with.
    if s.accept_seq("<<=".bytes) then return Some(ShlEq)
    if s.accept_seq(">>=".bytes) then return Some(ShrEq)

    if s.accept_seq("==".bytes) then return Some(EqEq)
    if s.accept_seq("!=".bytes) then return Some(BangEq)
    if s.accept_seq("<=".bytes) then return Some(LtEq)
    if s.accept_seq(">=".bytes) then return Some(GtEq)
    if s.accept_seq("&&".bytes) then return Some(AndAnd)
    if s.accept_seq("||".bytes) then return Some(OrOr)
    if s.accept_seq("??".bytes) then return Some(QQ)
    if s.accept_seq("?.".bytes) then return Some(QDot)

    // `++` and `--` before `+=`/`-=`, and `--` before `->`: longest match, as everywhere here.
    if s.accept_seq("++".bytes) then return Some(PlusPlus)
    if s.accept_seq("--".bytes) then return Some(MinusMinus)
    if s.accept_seq("->".bytes) then return Some(Arrow)

    if s.accept_seq("+=".bytes) then return Some(PlusEq)
    if s.accept_seq("-=".bytes) then return Some(MinusEq)
    if s.accept_seq("*=".bytes) then return Some(StarEq)
    if s.accept_seq("/=".bytes) then return Some(SlashEq)
    if s.accept_seq("%=".bytes) then return Some(PercentEq)
    if s.accept_seq("&=".bytes) then return Some(AmpEq)
    if s.accept_seq("|=".bytes) then return Some(PipeEq)
    if s.accept_seq("^=".bytes) then return Some(CaretEq)
    if s.accept_seq("<<".bytes) then return Some(Shl)
    if s.accept_seq(">>".bytes) then return Some(Shr)

    if s.accept(u8('('))
        lay.open_bracket()
        return Some(LParen)

    if s.accept(u8(')'))
        close_blocks(lay, out, m)
        return Some(RParen)

    if s.accept(u8('['))
        lay.open_bracket()
        return Some(LBracket)

    if s.accept(u8(']'))
        close_blocks(lay, out, m)
        return Some(RBracket)

    if s.accept(u8('{'))
        lay.open_bracket()
        return Some(LBrace)

    if s.accept(u8('}'))
        close_blocks(lay, out, m)
        return Some(RBrace)

    if s.accept(u8(',')) then return Some(Comma)
    if s.accept(u8(';')) then return Some(Semi)
    if s.accept(u8(':')) then return Some(Colon)
    if s.accept(u8('.')) then return Some(Dot)
    if s.accept(u8('=')) then return Some(Assign)
    if s.accept(u8('+')) then return Some(Plus)
    if s.accept(u8('-')) then return Some(Minus)
    if s.accept(u8('*')) then return Some(Star)
    if s.accept(u8('/')) then return Some(Slash)
    if s.accept(u8('%')) then return Some(Percent)
    if s.accept(u8('<')) then return Some(Lt)
    if s.accept(u8('>')) then return Some(Gt)
    if s.accept(u8('!')) then return Some(Bang)
    if s.accept(u8('|')) then return Some(Pipe)
    if s.accept(u8('&')) then return Some(Amp)
    if s.accept(u8('^')) then return Some(Caret)
    if s.accept(u8('~')) then return Some(Tilde)
    if s.accept(u8('@')) then return Some(At)

    None
end punct_kind

// What to say about a literal that would not read.
//
// The toolkit's `LitError` says which rule was broken and where; the sentence a person reads is the
// grammar's, because only the grammar knows what it was trying to read at the time.
private lit_message(e: LitError) -> string
    e match
        NoDigits(_) -> "this number has no digits"
        BadDigit(_) -> "this digit is not one this base allows"
        Overflow(_) -> "this number is too large to hold"
        Unterminated(_) -> "this string reaches the end of the file without closing"
        NoQuote(_) -> "a string starts with a quote"
        BadEscape(_) -> "this is not an escape slate knows"
        BadCodepoint(_) -> "this escape is not a character"
        BadReal(_) -> "this is not a number that can be read"
end lit_message

// Elements in the source -- slx, after tsx.
//
// **The lexer needs a mode, and it needs it because children are not tokens.** `<div>hello there</div>`
// holds two words and a space that mean one string, and the run may cross lines and hold a `//` that
// is not a comment. Everything above this line reads a file by asking what the byte at the cursor
// begins; between a tag's `>` and the `<` that ends it, the answer is "text, until proved otherwise".
//
// **What makes the mode reachable at all is that `<` in prefix position begins nothing else.** It is
// otherwise always an infix operator, and slate has no `<T>` generics -- which is the reason
// TypeScript had to make `.tsx` a separate parse mode from `.ts` and slate does not.

// Where inside an element the cursor is standing.
enum SlxWhere
    // Between `<` and the `>` that ends the tag: attributes, read as tokens.
    Opening

    // A closing tag, from its `</` to its `>`. Told apart from `Opening` because the `>` that ends
    // this one ends the ELEMENT, where an opening tag's `>` begins the children.
    Closing

    // A tag's children, where whatever is not a `<` or a `{` is text.
    Text

    // A `{ ... }`, in a tag or among children: ordinary tokens again. One is pushed for every `{`
    // read inside an element, so that the `}` of an object literal written in a hole is not taken
    // for the one that closes the hole.
    Hole
end SlxWhere

// The frame the cursor is in, or nothing where the file is not inside an element.
private slx_top(slx: *Buf[SlxWhere]) -> Option[SlxWhere]
    if slx.len() == 0 then return None

    Some(slx.at(slx.len() - 1))

private slx_in_text(slx: *Buf[SlxWhere]) -> bool = slx_top(slx) == Some(SlxWhere.Text)

private slx_in_tag(slx: *Buf[SlxWhere]) -> bool
    slx_top(slx) match
        Some(Opening) -> true
        Some(Closing) -> true
        _ -> false

// Leave the innermost frame.
private slx_leave(slx: *Buf[SlxWhere], slx_at: *Buf[Span])
    slx.pop()
    slx_at.pop()

// Make the innermost frame a different one, which is what an opening tag's `>` does.
private slx_become(slx: *Buf[SlxWhere], w: SlxWhere)
    slx.pop()
    slx.push(w)

// Whether the cursor is on a `<` that begins an element.
//
// **The question is what the PREVIOUS token was**, and the answer is a closed set: a `<` after
// something that can end an operand is a comparison, and after anything else there is no operand for
// it to compare and it can only be a tag. A lexer walking forwards has the previous token already,
// which is what makes this cheap enough to ask at every token.
//
// The byte after the `<` is checked too, so that `<<` and `<=` are never mistaken for a tag with a
// strange name -- and so that the complaint about `< 3` written where an operand was wanted is the
// ordinary one about an operator, rather than a sentence about elements.
private opens_element(s: *Scanner, out: *Tokens[Tok]) -> bool
    if !s.starts_with("<".bytes) then return false
    if ends_an_operand(just_pushed(out)) then return false

    s.peek_at(1) match
        None -> false
        Some(c) -> is_ident_start(c) || c == u8('>')
end opens_element

// Whether a token can be the last one of an operand.
//
// **A closed set, and short on purpose.** Everything else in the language is an operator, a keyword
// or a separator, after which an operand is what must come next.
private ends_an_operand(k: Tok) -> bool
    k match
        IntLit -> true
        RealLit -> true
        StrLit -> true
        StrInterp -> true
        Ident -> true
        True -> true
        False -> true
        Null -> true
        Undefined -> true
        RParen -> true
        RBracket -> true
        RBrace -> true
        PlusPlus -> true
        MinusMinus -> true
        SlxTagEnd -> true
        SlxSelfEnd -> true
        _ -> false
end ends_an_operand

// Whatever ends a run of children's text.
private is_text_break(c: u8) -> bool = c == u8('<') || c == u8('{')

// A run of children's text, and whatever ended it.
private scan_slx_text(s: *Scanner, lay: *Layout, out: *Tokens[Tok], rep: *Report,
                      slx: *Buf[SlxWhere], slx_at: *Buf[Span])
    val m = s.mark()

    s.accept_until(is_text_break)

    // **Pushed raw, whitespace and line breaks and all.** What it comes to is the parser's, because
    // the rule is about lines rather than bytes -- a run holding no newline is kept as written, and
    // one that spans lines loses the indentation that only lined it up under its tag.
    if s.offset > m then out.push(SlxText, s.span_from(m))

    if s.at_end()
        slx_unclosed(rep, slx, slx_at)
        return

    val d = s.mark()

    if s.accept_seq("</".bytes)
        out.push(SlxCloseOpen, s.span_from(d))
        slx_become(slx, SlxWhere.Closing)
        return

    if s.accept(u8('<'))
        out.push(SlxOpen, s.span_from(d))
        lay.open_bracket()
        slx.push(SlxWhere.Opening)
        slx_at.push(s.span_from(d))
        return

    s.bump()
    out.push(LBrace, s.span_from(d))
    lay.open_bracket()
    slx.push(SlxWhere.Hole)
    slx_at.push(s.span_from(d))
end scan_slx_text

// One token from inside a tag.
//
// **Whitespace separates nothing here**, so it is skipped whole -- newlines included, since a tag
// with an attribute on each of five lines is the ordinary way to write one and the layout is
// suppressed inside the element anyway.
private scan_slx_tag(s: *Scanner, lay: *Layout, out: *Tokens[Tok], rep: *Report,
                     slx: *Buf[SlxWhere], slx_at: *Buf[Span])
    s.skip_space()

    if s.at_end()
        slx_unclosed(rep, slx, slx_at)
        return

    val m = s.mark()

    if s.accept_seq("/>".bytes)
        out.push(SlxSelfEnd, s.span_from(m))
        close_blocks(lay, out, m)
        slx_leave(slx, slx_at)
        return

    if s.accept(u8('>'))
        out.push(SlxTagEnd, s.span_from(m))

        // An opening tag's `>` begins the children; a closing one's ends the element.
        if slx_top(slx) == Some(SlxWhere.Closing)
            close_blocks(lay, out, m)
            slx_leave(slx, slx_at)
        else
            slx_become(slx, SlxWhere.Text)

        return

    if s.accept(u8('{'))
        out.push(LBrace, s.span_from(m))
        lay.open_bracket()
        slx.push(SlxWhere.Hole)
        slx_at.push(s.span_from(m))
        return

    if s.accept(u8('='))
        out.push(Assign, s.span_from(m))
        return

    if s.accept(u8('.'))
        out.push(Dot, s.span_from(m))
        return

    s.peek() match
        None -> ()
        Some(c) ->
            if c == u8('"') then
                scan_string(s, out, rep, m)
            elif is_ident_start(c) then
                scan_slx_name(s, out, rep, m)
            else
                rep.add(error(point(s.offset), "a tag holds a name, an attribute or a `{ ... }`, and this is none of them")
                    .with_note("write text between the tags rather than inside one"))

                s.bump()
end scan_slx_tag

// A name inside a tag, which is not quite an identifier.
//
// **A hyphen is part of the name here**, because `data-id`, `aria-label` and `<my-widget>` are how
// the web spells things -- and outside a tag a hyphen is a subtraction, which is exactly why the
// lexer has to be in a mode to read one. A dot is left a token of its own, `<Menu.Item>` being a
// field selection read by a different route rather than a name with a dot in it.
private scan_slx_name(s: *Scanner, out: *Tokens[Tok], rep: *Report, m: usize)
    s.read_ident(is_ident_start, is_slx_name_cont)

    // `s"..."` as an attribute's value, which is a word followed by a quote and is spotted the same
    // way it is everywhere else.
    if s.text_from(m) == "s".bytes && s.starts_with("\"".bytes)
        scan_interpolated(s, out, rep, m)
        return

    out.push(Ident, s.span_from(m))
end scan_slx_name

private is_slx_name_cont(c: u8) -> bool = is_ident_cont(c) || c == u8('-')

// A file that ends inside an element.
//
// **The complaint points at the tag that never closed, not at the end of the file**, which is where
// the reader has to go. Everything still open is then abandoned so that the lexer walks out of the
// mode instead of reading the end of the file forever.
private slx_unclosed(rep: *Report, slx: *Buf[SlxWhere], slx_at: *Buf[Span])
    if slx_at.len() > 0
        rep.add(error(slx_at.at(0), "this element reaches the end of the file without closing")
            .with_note("an element ends with `</name>`, or with `/>` where it has no children"))

    slx.truncate(0)
    slx_at.truncate(0)
end slx_unclosed
