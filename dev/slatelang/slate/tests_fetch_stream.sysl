module dev.slatelang.slate
@tests

// `fetch(url, { stream: true })` on both back ends, against one server.
//
// **The server is `slate:net` and not `slate:http`**, because what is under test is how a body is
// framed and how it ends -- chunks split across writes, a `Content-Length` the server never reaches,
// a connection that stays open until the client hangs up -- and a server that writes the bytes itself
// is the only one that can be made to do each of those on purpose. The arrangement is otherwise
// `tests_fetch.sysl`'s: one probe, run under the interpreter with the server in the same program and
// again as node started as that server's child, both held to one written answer.

// **`/endless` writes a chunk every twenty milliseconds until the client hangs up**, and `/hungup`
// says whether it has. That is the leak check for an early `break`: a body whose socket stayed open
// would keep the server writing, `/hungup` would say `false`, and the server program would never end.
private val StreamServer: string =
    "import { listen, onData, send, close, localPort } from slate:net\n" +
    "\n" +
    "var hungUp = false\n" +
    "stop(s) = close(s)\n" +
    "head(extra) = \"HTTP/1.1 200 OK\\r\\nConnection: close\\r\\n\" + extra + \"\\r\\n\"\n" +
    "asks(got, p) = got.startsWith(\"GET \" + p + \" \")\n" +
    "\n" +
    "async put(conn, st, v)\n" +
    "    if !st.gone then await send(conn, v)\n" +
    "\n" +
    "async answer(conn, got, st)\n" +
    "    if asks(got, \"/chunked\")\n" +
    "        await put(conn, st,head(\"Transfer-Encoding: chunked\\r\\n\") + \"5\\r\\nhello\\r\\n\")\n" +
    "        await sleep(30)\n" +
    "        await put(conn, st,\"6\\r\\n world\\r\\n0\\r\\n\\r\\n\")\n" +
    "    elif asks(got, \"/counted\")\n" +
    "        await put(conn, st,head(\"Content-Length: 11\\r\\n\") + \"hello\")\n" +
    "        await sleep(30)\n" +
    "        await put(conn, st,\" world\")\n" +
    "    elif asks(got, \"/drop\")\n" +
    "        await put(conn, st,head(\"Content-Length: 100\\r\\n\") + \"partial\")\n" +
    "        await sleep(30)\n" +
    "    elif asks(got, \"/drip\")\n" +
    "        await put(conn, st,head(\"Transfer-Encoding: chunked\\r\\n\") + \"5\\r\\nfirst\\r\\n\")\n" +
    "        await sleep(800)\n" +
    "        await put(conn, st,\"4\\r\\nlate\\r\\n0\\r\\n\\r\\n\")\n" +
    "    elif asks(got, \"/endless\")\n" +
    "        await put(conn, st,head(\"Transfer-Encoding: chunked\\r\\n\"))\n" +
    "        while !st.gone\n" +
    "            await put(conn, st, \"4\\r\\ntick\\r\\n\")\n" +
    "            await sleep(20)\n" +
    "    elif asks(got, \"/hungup\")\n" +
    "        await put(conn, st,head(\"Content-Length: \" + string(string(hungUp).length) + \"\\r\\n\") + string(hungUp))\n" +
    "    elif asks(got, \"/gz\")\n" +
    "        if got.contains(\"gzip\")\n" +
    "            await put(conn, st,head(\"Content-Encoding: gzip\\r\\nContent-Length: 37\\r\\n\"))\n" +
    "            await put(conn, st," + GzipBytes + ")\n" +
    "        else\n" +
    "            await put(conn, st,head(\"Content-Length: 17\\r\\n\") + \"squeezed and back\")\n" +
    "    elif asks(got, \"/forced\")\n" +
    "        await put(conn, st,head(\"Content-Encoding: gzip\\r\\nContent-Length: 37\\r\\n\"))\n" +
    "        await put(conn, st," + GzipBytes + ")\n" +
    "    elif asks(got, \"/gzsplit\")\n" +
    "        await put(conn, st,head(\"Content-Encoding: gzip\\r\\nContent-Length: 37\\r\\n\"))\n" +
    "        await put(conn, st,[31,139,8,0,0])\n" +
    "        await sleep(30)\n" +
    "        await put(conn, st,[0,0,0,0,19,43,46,44,77,77,173,74,77,81,72,204,75,81,72,74,76,206,6,0,84,52,83,205,17,0,0,0])\n" +
    "    elif asks(got, \"/zlib\")\n" +
    "        await put(conn, st,head(\"Content-Encoding: deflate\\r\\nContent-Length: 25\\r\\n\"))\n" +
    "        await put(conn, st,[120])\n" +
    "        await sleep(30)\n" +
    "        await put(conn, st,[156,43,46,44,77,77,173,74,77,81,72,204,75,81,72,74,76,206,6,0,60,59,6,107])\n" +
    "    elif asks(got, \"/raw\")\n" +
    "        await put(conn, st,head(\"Content-Encoding: deflate\\r\\nContent-Length: 19\\r\\n\"))\n" +
    "        await put(conn, st,[43])\n" +
    "        await sleep(30)\n" +
    "        await put(conn, st,[46,44,77,77,173,74,77,81,72,204,75,81,72,74,76,206,6,0])\n" +
    "    elif asks(got, \"/gzbad\")\n" +
    "        await put(conn, st,head(\"Content-Encoding: gzip\\r\\nContent-Length: 29\\r\\n\"))\n" +
    "        await put(conn, st,[31,139,8,0,0,0,0,0,0,19,0,5,0,250,255,104,101,108,108,111])\n" +
    "        await sleep(30)\n" +
    "        await put(conn, st,[7,0,0,0,0,0,0,0,0])\n" +
    "    elif asks(got, \"/gztrunc\")\n" +
    "        await put(conn, st,head(\"Content-Encoding: gzip\\r\\nContent-Length: 30\\r\\n\"))\n" +
    "        await put(conn, st,[31,139,8,0,0,0,0,0,0,19,43,46,44,77,77,173,74,77,81,72,204,75,81,72,74,76,206,6,0,84])\n" +
    "    elif asks(got, \"/gzempty\")\n" +
    "        await put(conn, st,head(\"Content-Encoding: gzip\\r\\nContent-Length: 0\\r\\n\"))\n" +
    "    close(conn)\n" +
    "\n" +
    "val server = listen(0, conn ->\n" +
    "    var got = \"\"\n" +
    "    var asked = false\n" +
    "    val st = { gone: false }\n" +
    "    onData(conn, chunk ->\n" +
    "        if chunk == null\n" +
    "            st.gone = true\n" +
    "            if got.startsWith(\"GET /endless \") then hungUp = true\n" +
    "            close(conn)\n" +
    "        elif !asked\n" +
    "            got = got + chunk\n" +
    "            if got.contains(\"\\r\\n\\r\\n\")\n" +
    "                asked = true\n" +
    "                answer(conn, got, st)))\n"

// `drain` reads a streamed body to its end and says what came: the status, the bytes as text, and
// `whole` or the sentence the body broke off with. `first` stops after three chunks with a `break`
// and nothing else -- no `using` -- so the loop closing what it walked is the only thing that can hang
// up, and the `next()` asked afterwards says the body is over.
private val StreamProbe: string =
    "anything(v) = v\n" +
    "\n" +
    "async drain(path, opts)\n" +
    "    val r = await fetch(base + path, opts)\n" +
    "    if !r.ok then return { status: 0, text: \"\", said: r.error }\n" +
    "    using body = r.value.body\n" +
    "    var got = bytes(0)\n" +
    "    var said = \"whole\"\n" +
    "    for await c in body\n" +
    "        c match\n" +
    "            { ok: false, error } -> said = error\n" +
    "            _ -> push(got, c)\n" +
    "    { status: r.value.status, text: fromBytes(got).value, said: said }\n" +
    "\n" +
    "async first(n)\n" +
    "    val r = await fetch(base + \"/endless\", { stream: true })\n" +
    "    val body = r.value.body\n" +
    "    var seen = 0\n" +
    "    for await c in body\n" +
    "        seen = seen + 1\n" +
    "        if seen == n then break\n" +
    "    [seen, (await body.next()).done]\n" +
    "\n" +
    "async main()\n" +
    "    val c = await drain(\"/chunked\", { stream: true })\n" +
    "    print(c.status, c.text, c.said)\n" +
    "    val n = await drain(\"/counted\", { stream: true })\n" +
    "    print(n.status, n.text, n.said)\n" +
    "    val d = await drain(\"/drop\", { stream: true })\n" +
    "    print(d.status, d.text, d.said == base + \"/drop stopped sending in the middle of the body\")\n" +
    "    val t = await drain(\"/drip\", { stream: true, timeout: 300 })\n" +
    "    print(t.status, t.text, t.said == base + \"/drip did not answer within 300 milliseconds\")\n" +
    "    print(await first(3))\n" +
    "    await sleep(200)\n" +
    "    print((await fetch(base + \"/hungup\")).value.body)\n" +
    "    val g = await drain(\"/gz\", { stream: true })\n" +
    "    print(g.status, g.text, g.said)\n" +
    "    print((await fetch(base + \"/chunked\")).value.body)\n" +
    "    print((await fetch(base + \"/counted\")).value.body)\n" +
    "    print((await fetch(base + \"/forced\")).value.body)\n" +
    "    print((await fetch(base + \"/chunked\", { stream: false })).value.body)\n" +
    "    print(fetch(base, { stream: anything(\"yes\") }) catch e -> e.message)\n" +
    "    finish()\n" +
    "\n" +
    "main()\n"

private val StreamExpected: string =
    "200 hello world whole\n" +
    "200 hello world whole\n" +
    "200 partial true\n" +
    "200 first true\n" +
    "[3, true]\n" +
    "true\n" +
    "200 squeezed and back whole\n" +
    "hello world\n" +
    "hello world\n" +
    "squeezed and back\n" +
    "hello world\n" +
    "`stream` is true or false, and this is a string"

// **A chunked body and a counted one each split across two writes, read whole; a counted body the
// server abandons, ending in the sentence that says so; a limit that runs out after the first chunk
// has been handed over; an early `break` that hangs up with no `using` around it; a compressed body decoded as it arrives; and
// `stream: false` and no option at all answering exactly what they did.** The two buffered counted
// fetches are also the regression for a body split across reads, which used to be answered with its
// first piece.
@test
fetch_STREAMS_A_BODY_THE_SAME_WAY_ON_BOTH_BACK_ENDS()
    assert_eq(out(fetch_under_slate(StreamServer, StreamProbe)).trim(), StreamExpected)
    assert_eq(fetch_under_node(StreamServer, StreamProbe).trim(), StreamExpected)

// `show` reads a streamed body to its end and says what came, bracketed so that an empty body is
// seen, then `whole` or the sentence it ended with. `/gz` compresses only where it was asked to, so
// its `content-encoding` is what says a streamed request now asks.
private val DecodeProbe: string =
    "async show(path)\n" +
    "    val r = await fetch(base + path, { stream: true })\n" +
    "    if !r.ok then return \"refused \" + r.error\n" +
    "    using body = r.value.body\n" +
    "    var got = bytes(0)\n" +
    "    var said = \"whole\"\n" +
    "    for await c in body\n" +
    "        c match\n" +
    "            { ok: false, error } -> said = error\n" +
    "            _ -> push(got, c)\n" +
    "    \"[\" + fromBytes(got).value + \"] \" + said\n" +
    "\n" +
    "async main()\n" +
    "    val g = await fetch(base + \"/gz\", { stream: true })\n" +
    "    using gb = g.value.body\n" +
    "    print(g.value.headers[\"content-encoding\"])\n" +
    "    for p in [\"/forced\", \"/gzsplit\", \"/zlib\", \"/raw\", \"/gzbad\", \"/gzempty\"]\n" +
    "        print(await show(p))\n" +
    "    finish()\n" +
    "\n" +
    "main()\n"

private val DecodeExpected: string =
    "gzip\n" +
    "[squeezed and back] whole\n" +
    "[squeezed and back] whole\n" +
    "[squeezed and back] whole\n" +
    "[squeezed and back] whole\n" +
    "[hello] the server said the body was compressed with gzip, and it could not be decompressed\n" +
    "[] whole"

// **A compressed streamed body is decoded as it arrives, on both back ends**: gzip, zlib and the bare
// deflate stream a `deflate` server sends anyway, each split across writes -- the gzip one inside its
// header and the two deflate ones after their first byte, which is where the interpreter tells zlib
// from bare. A stream damaged in the middle hands over what decoded before the damage and then ends in
// `undecodable`'s sentence, the mid-body rule; an empty one is whole.
@test
A_COMPRESSED_STREAMED_BODY_IS_DECODED_AS_IT_ARRIVES_ON_BOTH_BACK_ENDS()
    assert_eq(out(fetch_under_slate(StreamServer, DecodeProbe)).trim(), DecodeExpected)
    assert_eq(fetch_under_node(StreamServer, DecodeProbe).trim(), DecodeExpected)

private val TruncatedProbe: string =
    "async main()\n" +
    "    val r = await fetch(base + \"/gztrunc\", { stream: true })\n" +
    "    var got = bytes(0)\n" +
    "    var said = \"whole\"\n" +
    "    for await c in r.value.body\n" +
    "        c match\n" +
    "            { ok: false, error } -> said = error\n" +
    "            _ -> push(got, c)\n" +
    "    print(fromBytes(got).value, \"/\", said)\n" +
    "    finish()\n" +
    "\n" +
    "main()\n"

// **The one host difference, pinned so that a change to either side notices.** A gzip stream whose
// connection ended cleanly but whose trailer never came is `Truncated` to the interpreter's decoder,
// so what decoded is handed over and the body ends in `undecodable`'s sentence. node's `fetch`
// answers what it decoded and says nothing -- its zlib is run with a flush that forgives a missing
// end -- so a body cut short behind a `Content-Length` that matched reads as whole there.
@test
A_TRUNCATED_COMPRESSED_STREAMED_BODY_IS_AN_ERROR_IN_THE_INTERPRETER_AND_WHOLE_UNDER_NODE()
    assert_eq(out(fetch_under_slate(StreamServer, TruncatedProbe)).trim(),
              "squeezed and back / the server said the body was compressed with gzip, and it could not be decompressed")
    assert_eq(fetch_under_node(StreamServer, TruncatedProbe).trim(), "squeezed and back / whole")
