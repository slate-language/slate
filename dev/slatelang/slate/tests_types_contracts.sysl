module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// Contracts: `require` and `ensure`, what they are checked against, and where they may be written.
//
// **Cut out of `tests_types.sysl` when that file passed a thousand lines, by subject, and nothing
// crosses**: a clause is a function's own, and none of that file's helpers is used here.

// **`require` and `ensure` are sysl's own words in sysl's own place**: clauses at the top of a
// function's body, above every other statement. Both are SOFT, so a program may still call something
// `require` -- the words are clauses only at the head of a body.

@test
a_precondition_is_checked_on_the_way_in()
    assert_eq(out("withdraw(balance, amount)\n    require amount > 0\n    balance - amount\nprint(withdraw(100, 30))"), "70")

    val said = fails("withdraw(balance, amount)\n    require amount > 0\n    balance - amount\nprint(withdraw(100, -1))")

    assert(said.contains("`withdraw` requires `amount > 0`, and this call does not meet it"))

@test
a_postcondition_is_checked_where_the_body_falls_out()
    val prog = "take(balance, amount)\n    ensure result >= 0\n    balance - amount\n"

    assert_eq(out(prog + "print(take(100, 30))"), "70")
    assert(fails(prog + "print(take(10, 30))").contains("`take` ensures `result >= 0`, and gave back -20"))

@test
a_postcondition_is_checked_at_a_return_as_well()
    // **The half the parser cannot write.** Falling out of a body is an expression it wraps and a
    // `return` is a jump nothing can be wrapped around, so the compiler emits the check in front of
    // every one of them.
    val prog = "clamp(n)\n    ensure result >= 0\n    if n < 0\n        return n\n    n\n"

    assert_eq(out(prog + "print(clamp(5))"), "5")
    assert(fails(prog + "print(clamp(-5))").contains("`clamp` ensures `result >= 0`, and gave back -5"))

@test
a_return_answers_so_it_meets_the_result_annotation_too()
    val prog = "f(n) -> string\n    if n > 0\n        return 42\n    \"ok\"\n"

    assert_eq(out(prog + "print(f(0))"), "ok")
    assert(fails(prog + "print(f(1))").contains("this answers string, and gave back 42"))

@test
a_result_type_complaint_points_at_the_tail_expression_not_the_first_statement()
    // **The fall-out check used to be pinned to the whole body**, so a multi-statement function
    // pointed a reader at its FIRST line -- `val m = n * 2` here -- rather than at `m`, the
    // statement that actually answered. `t:3:5` is where `m` stands.
    val said = fails("h(n) -> string\n    val m = n * 2\n    m\nprint(h(1))")

    assert(said.contains("this answers string, and gave back 2"))
    assert(said.contains("t:3:5"))

@test
a_result_type_complaint_at_a_return_points_at_the_returned_expression()
    // **The same complaint at a `return` used to name the whole statement**, `return 42`, rather
    // than the `42` that was actually handed back. `t:3:16` is where `42` stands.
    val said = fails("k(n) -> string\n    if n > 0\n        return 42\n    \"ok\"\nprint(k(1))")

    assert(said.contains("this answers string, and gave back 42"))
    assert(said.contains("t:3:16"))

@test
several_clauses_are_checked_in_the_order_they_were_written()
    val prog = "withdraw(balance, amount)\n    require amount > 0\n    require amount <= balance\n    ensure result >= 0\n    balance - amount\n"

    assert_eq(out(prog + "print(withdraw(100, 30))"), "70")
    assert(fails(prog + "print(withdraw(10, 30))").contains("requires `amount <= balance`"))

@test
a_clause_belongs_at_the_top_of_a_body()
    val said = fails("f(n)\n    val m = n * 2\n    require m > 0\n    m\nprint(f(1))")

    assert(said.contains("a `require` clause is a function's contract, and belongs at the top of its body"))

@test
old_is_a_snapshot_only_inside_an_ensure()
    // A `require` is checked on entry, where `old(e)` and `e` are the one value -- so writing one
    // there is a misunderstanding worth naming rather than a second spelling of the same clause.
    val said = fails("f(n)\n    require n > old(n)\n    n\nprint(f(1))")

    assert(said.contains("belongs in an `ensure`"))

@test
old_takes_exactly_one_expression_and_may_not_hold_another_old()
    val none = fails("f(n)\n    ensure result == old()\n    n\nprint(f(1))")

    assert(none.contains("`old` takes exactly one expression"))

    val two = fails("f(n)\n    ensure result == old(n, n)\n    n\nprint(f(1))")

    assert(two.contains("`old` takes exactly one expression"))

    val nested = fails("f(n)\n    ensure result == old(old(n))\n    n\nprint(f(1))")

    assert(nested.contains("may not hold another `old`"))

@test
a_snapshot_is_taken_after_the_preconditions_that_make_it_safe()
    // The order is what lets a precondition guard a snapshot expression: the `require` refuses
    // first, so the snapshot of `xs.at(0)` is never taken for an empty array.
    val prog = "f(xs)\n    require xs.length > 0\n    ensure result == old(xs.at(0))\n    xs.at(0)\n"

    assert_eq(out(prog + "print(f([7, 8]))"), "7")
    assert(fails(prog + "print(f([]))").contains("requires `xs.length > 0`"))

@test
both_contract_words_are_still_ordinary_names()
    // `require("./thing")` is what a reader coming from JavaScript writes first, and it stays a call
    // of whatever the program bound the name to.
    assert_eq(out("val require = (path) -> \"loaded \" + path\nprint(require(\"./x\"))"), "loaded ./x")
    assert_eq(out("val ensure = 3\nprint(ensure + 1)"), "4")

@test
a_contract_belongs_to_the_function_that_wrote_it()
    // A definition inside a body owns its own clauses, and its `return`s are not handed the outer
    // one's -- which is what the saved-and-restored parser state is for.
    val prog = "outer(n)\n    require n > 0\n    inner(m)\n        require m > 5\n        m\n    inner(n)\n"

    assert_eq(out(prog + "print(outer(9))"), "9")
    assert(fails(prog + "print(outer(1))").contains("`inner` requires `m > 5`"))

@test
a_class_method_may_carry_a_contract()
    val prog = "class Account\n    var balance\n\n    withdraw(self, amount)\n        require amount > 0\n        self.balance = self.balance - amount\n        self.balance\nval a = Account(100)\n"

    assert_eq(out(prog + "print(a.withdraw(30))"), "70")
    assert(fails(prog + "print(a.withdraw(0))").contains("`withdraw` requires `amount > 0`"))

@test
a_contract_leaves_the_tree_of_a_function_that_has_none_alone()
    assert_eq(good_tree("f(x) = x + 1"), "(def f(x) (+ x 1))")
    assert(good_tree("f(x)\n    require x > 0\n    x").contains("(require f x > 0)"))
