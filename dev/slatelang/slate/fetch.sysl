module dev.slatelang.slate

import sh.sysl.libuv
import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, remove_dir_all, rename, write_text}
import sysl.text.{split, Search}

// Downloading a package into the cache.
//
// **Where the resolver stops and this begins**: `packages.sysl` works out *which* package at *which*
// version, entirely from manifests; this is the part that puts the code on the disk. Nothing here
// makes a decision -- if it has to choose something, that belongs one file over.

// The URL a coordinate at a version is served from.
//
// **Only GitHub, and an unknown host is refused rather than guessed at.** A coordinate is a host and
// a path, and the URL a tarball lives at is that host's own convention -- GitLab, Codeberg and a
// bare git server each spell it differently. Guessing would produce a 404 reported as a missing
// version, which sends the reader to check a tag that is fine.
tarball_url(git: string, version: string) -> Result[string, string]
    val parts = split(git, "/")

    if parts.len != 3 || parts[0] != "github.com"
        return Err(s"`${git}` is not a coordinate slate knows how to fetch -- it can fetch `github.com/<owner>/<repo>`")

    Ok(s"https://github.com/${parts[1]}/${parts[2]}/archive/refs/tags/v${version}.tar.gz")
end tarball_url

// Put one package in the cache, answering what its contents hashed to.
//
// **It is unpacked beside its home and moved into place, never into it.** A download that fails
// halfway would otherwise leave a directory that looks like a package and is half of one -- and the
// next run would find it, skip the fetch, and compile against it. A rename is the only step that
// makes a package visible, and a rename is atomic.
fetch_package(pkg: Package) -> Result[string, string]
    val url = tarball_url(pkg.git, pkg.version)?
    val reply = get(url)?

    if reply.status == 404
        return Err(s"${pkg.git} has no version ${pkg.version} -- ${url} is not there")

    if reply.status != 200
        return Err(s"${url} answered ${reply.status}")

    val archive = gunzip(reply.body)?
    val entries = read_tar(archive)?

    val parent = dir_of(pkg.dir)

    make_dir_all(parent) match
        Err(e) -> return Err(s"cannot make ${parent}: ${e}")
        Ok(_) -> ()

    // **A sibling of the destination and not `/tmp`**, so the rename below is within one filesystem.
    // A rename across filesystems is a copy that can fail halfway, which is the thing being avoided.
    val staging = libuv.mkdtemp_sync(s"${parent}/.fetching-XXXXXX") match
        Err(e) -> return Err(s"cannot make room to unpack in ${parent}: ${e}")
        Ok(d) -> d

    val unpacked = extract_tar(entries, staging, 1)

    unpacked match
        Err(e) ->
            remove_dir_all(staging)

            return Err(e)
        Ok(_) -> ()

    val hash = tree_hash(staging) match
        None ->
            remove_dir_all(staging)

            return Err(s"${url} unpacked to nothing")
        Some(h) -> h

    rename(staging, pkg.dir) match
        Err(e) ->
            remove_dir_all(staging)

            return Err(s"cannot put ${pkg.name} in ${pkg.dir}: ${e}")
        Ok(_) -> ()

    Ok(hash)
end fetch_package

// What a fetch came to: how many arrived, how many were already in the cache, what it has to say,
// and whether any of it went wrong.
struct Fetched
    got: usize
    already: usize
    notes: Buf[string]
    failed: bool
end Fetched

// One pass over a resolution: fetch what is missing and record the hash of everything, answering
// whether anything was written into the sums.
//
// **A package already in the cache is not fetched again**, re-downloading what is already present
// being what makes a package manager slow. **It is still HASHED and still RECORDED**, which is the
// half this used to leave out: a cache is shared between every project on the machine, so whether
// `slate add` writes a `slate.sum` line depended on whether some *other* project had fetched that
// version first. A build's record of what it compiled is not a thing to decide by that.
//
// The symptom is worth knowing because it reads as a defect in `slate deps`: the add says `added
// greet 2.0.0` and nothing else, `slate.sum` has no line for it, and `slate deps` then reports the
// package "is not recorded" and prints the very hash the add declined to write.
private fetch_round(root: string, packages: Packages, sums: *Sums, f: *Fetched) -> bool
    var added = false

    for i in 0..<packages.found.len()
        val pkg = packages.found.at(i)

        if is_fetched(pkg)
            // **The tree that is already there is hashed against the record, exactly as an arrival
            // is.** A disagreement here is the same disagreement and stops the same way -- the copy
            // in the cache has been edited, or the published version changed under a machine that
            // fetched it first.
            tree_hash(pkg.dir) match
                None -> ()
                Some(now) ->
                    sums.at(pkg.git, pkg.version) match
                        Some(e) ->
                            if e.hash != now
                                f.notes.push(s"error: ${pkg.git} v${pkg.version} does not match ${SumFile}: it was recorded as ${e.hash} and what is in the cache is ${now}")
                                f.failed = true
                        None ->
                            sums.entries.push(SumEntry(pkg.git, pkg.version, now))
                            added = true

            continue
        end if

        f.notes.push(s"fetching ${pkg.git} v${pkg.version}")

        fetch_package(pkg) match
            Err(e) ->
                f.notes.push(s"error: ${e}")
                f.failed = true
            Ok(hash) ->
                f.got += 1

                // **What arrived is recorded against what was recorded before, and a disagreement
                // stops everything.** This is the moment the sum file exists for: a version that
                // was published once and has changed since is caught here, before any of it is
                // compiled.
                sums.at(pkg.git, pkg.version) match
                    Some(e) ->
                        if e.hash != hash
                            f.notes.push(s"error: ${pkg.git} v${pkg.version} does not match ${SumFile}: it was recorded as ${e.hash} and what arrived is ${hash}")
                            f.failed = true
                    None ->
                        sums.entries.push(SumEntry(pkg.git, pkg.version, hash))
                        added = true

    added
end fetch_round

// How many times the graph may deepen before slate calls it a circle. A round only happens where the
// one before it fetched something, so this is a bound on the DEPTH of the dependency graph and not
// on its size.
private val MaxFetchRounds: usize = 32

// Fetch the whole graph a project needs, which takes more than one pass.
//
// **A PACKAGE'S OWN DEPENDENCIES ARRIVE WITH IT, so the first resolution of a cold cache sees only
// what the project itself declares.** `resolve_packages` reads each package's manifest out of the
// package's directory, and a package that has never been fetched has no directory -- so the walk
// stops at the project's own list, one round downloads exactly that, and nothing anywhere
// learns what those packages want in turn.
//
// **The symptom is a `slate.sum` that is permanently incomplete**, and it reads as a defect in
// `slate deps`: `slate add github.com/slate-language/mortar` in an empty directory says `added
// mortar 0.1.0`, fetches mortar alone, and records mortar alone. The next command resolves again --
// mortar's manifest is on the disk now -- finds `lath 0.5.1` under it, and reports for ever that
// lath *is not recorded in `slate.sum`*, because the command that records is the command that
// fetches and it has already run.
//
// **So the resolution is repeated until it stops growing.** A round can only add packages named by
// a manifest that arrived in the round before it, the graph is finite, and a warm cache is one
// round -- which is every run after the first.
fetch_graph(root: string, project: Project) -> (Packages, Fetched)
    var f = Fetched(0, 0, buf(), false)
    var sums = read_sums(root)
    var added = false
    var packages = resolve_packages(root, project)
    var rounds: usize = 0

    loop
        val before = f.got

        if fetch_round(root, packages, &sums, &f) then added = true
        if f.failed then break

        // **Nothing arrived, so nothing this program has not already read can name anything.** This
        // is the ordinary exit and it is taken on the first round by every warm cache.
        if f.got == before then break

        rounds += 1

        if rounds > MaxFetchRounds
            f.notes.push(s"error: gave up fetching after ${MaxFetchRounds} rounds -- the manifests may depend on each other in a circle")
            f.failed = true
            break
        end if

        packages = resolve_packages(root, project)

    // **What was already there is what the WHOLE graph holds less what this run downloaded**, rather
    // than a count kept per round: a package fetched in the first round is "already there" to the
    // second, and adding the rounds up would report it twice.
    f.already = packages.found.len() - f.got

    // **The sum file is written only where nothing went wrong**, so a failed run cannot record a
    // hash for something it also complained about -- and it is written once, here, rather than once
    // per round.
    if added && !f.failed
        write_text(s"${root}/${SumFile}", render_sums(sums)) match
            Err(e) -> f.notes.push(s"error: cannot write ${root}/${SumFile}: ${e}")
            Ok(_) -> f.notes.push(s"recorded what this project uses in ${SumFile}")

    (packages, f)
end fetch_graph
