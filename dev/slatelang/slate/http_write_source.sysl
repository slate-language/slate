module dev.slatelang.slate

// `slate:http`'s second piece: the bounds a connection is held to, and what a handler's answer
// becomes on the wire.
//
// **One module, several blocks.** `http_source.sysl` joins these into the text `slate:http` is
// parsed from, so nothing here is a module of its own and none of these names is importable
// except through `slate:http`. The split is the thousand-line rule and nothing else: the file was
// 1255 lines before HTTP/2 and streamed responses were anywhere near it.
//
// **The seam is the one the code already had** -- a section comment that had been there since the
// module was written. Nothing moved but the line it sits on.

http_write_source() -> string = raw"""
    // How long a connection with nothing outstanding is held open. **Node's number**, and the reasoning
    // is the same: long enough that a browser fetching a page and its stylesheet reuses one connection,
    // short enough that a client that has gone away is not remembered for long.
    val IdleMillis = 5000

    // How much of a request this server will hold before refusing it.
    //
    // **Node's llhttp defaults, and the reasoning is the same**: eight kilobytes of head is more than any
    // browser sends and less than any attack, and a megabyte of body is a JSON document rather than a
    // file upload. A server that wants uploads wants `serveStream`, where `BodyBytes` bounds only what a
    // handler leaves unasked-for and the head limit is the only one a body is measured against at all.
    val HeadBytes = 8192
    val BodyBytes = 1048576

    // The smallest body worth compressing, and how hard to compress it.
    //
    // **Below a kilobyte brotli usually makes a body larger**, having a frame to write, and the round
    // trip costs a client more than the bytes save it. Quality 5 is the on-the-fly setting: 0-4 are
    // faster and 9-11 are for something built ahead of time -- quality 11 on a megabyte costs about half
    // a second and 60 MB of working memory, which is not what a request handler should be doing.
    val CompressBytes = 1024
    val CompressQuality = 5

    // What a handler answered, written to the socket.
    //
    // **A string is a whole response**, which is what makes the first program somebody writes one line
    // long. An object says more -- `{ status, headers, body }` -- and every part of it is optional.
    // Anything else is rendered as `print` would render it, which is what a handler answering a number
    // or an array meant.
    //
    // **A BODY WORTH COMPRESSING GOES OUT COMPRESSED, AND THE HANDLER IS NOT ASKED.** Every browser
    // sends `Accept-Encoding: br` and on text brotli is worth roughly a sixth over gzip, so a server
    // that made this a decision would be making everybody write the same three lines. The escape hatch
    // is to set `Content-Encoding` yourself, which says the body is already encoded and is left alone.
    // **AN ARRAY BODY IS BYTES AND IS SENT AS IT STANDS**, which is what lets a handler answer an
    // image, a font, a PDF or an asset compressed ahead of time. It used to be rendered as text --
    // `{ body: [72, 105] }` went out as the six characters `[72, 105]` -- so there was no way to
    // serve anything that is not text at all. `send` in `slate:net` already reads an array this way
    // and this is that rule reaching the response.
    //
    // **A bare array answers bytes too**, for the same consistency: `req -> [72, 105]` is the byte
    // form of `req -> "Hi"`. A handler that means an array of DATA writes `toJSON(xs)`, which is what
    // it had to write anyway -- rendering a slate array as its own text was never a JSON document.
    write(conn, req: object | null, v, keep: boolean) =
        val r = shaped(req, v)
        var extra = ""

        for [k, hv] in r.headers
            extra = extra + k + ": " + hv + "\r\n"

        if r.source != null
            streamed(conn, r, extra, keep)
        elif r.text == null
            replyBytes(conn, r.status, extra, r.bytes, keep)
        else
            reply(conn, r.status, extra, r.text, keep)

    // A handler's answer read into a status, header pairs and one body.
    //
    // **THE ONE PLACE AN ANSWER IS READ**, so HTTP/1.1 and HTTP/2 agree about what a handler meant
    // and differ only in how it is framed: `write` turns this into a status line and a blank line,
    // and `respondH2` turns the same thing into a HEADERS frame and a DATA frame. Compression is
    // decided here too, being a property of the answer and of what the client asked for rather than
    // of either framing.
    //
    // **`text` and `bytes` are two fields and exactly one of them is there.** A slate byte array is
    // one value per byte, so making every response go through bytes would cost a megabyte of text a
    // million boxed integers -- and the 1.1 writer has a path that never converts it. A body that
    // was compressed is bytes by then, which is what makes that path affordable.
    //
    // **A header value is a PAIR and not a field of an object**, because HTTP allows a name twice
    // and an object does not: `Set-Cookie` written twice is the case that decides it, and `Link`,
    // `Vary` and `Via` all repeat.
    shaped(req: object | null, v) -> object
        var status = 200
        var body = ""
        var bytes = null
        var source = null
        var heartbeat = 0
        var pairs = []
        var encoded = false
        var said = ""

        // **A source is asked about BEFORE `is object`**, a source being one.
        if isSource(v)
            source = v
        elif v is string
            body = v
        elif v is array
            bytes = v
        elif v is object
            if has(v, "status") then status = v.status

            // **A heartbeat is a member of the response and not a guess from its content type.**
            // The writer emits a comment on this interval while nothing else is going down the
            // stream; `sse` sets it, and a program streaming anything else may ask for the same.
            if has(v, "heartbeat") then heartbeat = v.heartbeat

            if has(v, "body")
                if isSource(v.body)
                    source = v.body
                elif v.body is array
                    bytes = v.body
                elif v.body is string
                    body = v.body
                else
                    body = string(v.body)

            if has(v, "headers")
                for [k, hv] in entries(v.headers)
                    if lower(k) == "content-encoding" then encoded = true
                    if lower(k) == "content-type" then said = string(hv)

                    // **AN ARRAY VALUE IS THE HEADER WRITTEN ONCE PER ELEMENT**, which is the only
                    // way to say `Set-Cookie` twice: an object has one value per name and HTTP does
                    // not. It is general rather than a case for cookies -- `Link`, `Vary` and `Via`
                    // all repeat -- and without it an array rendered as its own text, which is a
                    // header no client can read.
                    if hv is array
                        for one in hv
                            push(pairs, [k, string(one)])
                    else
                        push(pairs, [k, string(hv)])
        else
            body = string(v)

        // **A body that arrives in pieces is passed through untouched.** It has no length to count
        // and none to compress: both are knowable only after the last piece, and a server that
        // buffered to find out would be undoing the thing streaming is for.
        if source != null
            return { status: status, headers: pairs, text: null, bytes: null,
                     source: source, heartbeat: heartbeat }

        // **`??` and not an `if`, so `toBytes` is not run on a body that is already bytes.** A
        // megabyte of them would otherwise be converted twice over for nothing.
        val raw = bytes ?? toBytes(body)

        // **A body whose type says it is already compressed is not compressed again.** The check
        // below would catch it -- a PNG comes back larger and is sent as it was -- but a static
        // server would then run brotli over every image on every request and throw the answer away.
        if encoded || alreadyPacked(said) || len(raw) < CompressBytes || !wantsBrotli(req)
            return answered(status, pairs, body, bytes)

        // **`Vary` goes on whether or not this one was compressed**, because what a cache must not do is
        // hand a compressed body to a client that did not ask for one -- and it cannot know that unless
        // every response whose content depended on `Accept-Encoding` says so.
        push(pairs, ["Vary", "Accept-Encoding"])

        val small = compress(raw, CompressQuality)

        // **A body that does not get smaller is sent as it was.** Brotli frames its input, so something
        // already compressed -- a PNG, a zip, an asset built ahead of time -- comes back slightly larger,
        // and sending that would cost the client a decode for nothing.
        if len(small) >= len(raw) then return answered(status, pairs, body, bytes)

        push(pairs, ["Content-Encoding", "br"])

        { status: status, headers: pairs, text: null, bytes: small, source: null, heartbeat: 0 }

    // The three body fields, filled in so that exactly one of them is there.
    answered(status: integer, pairs: array, body: string, bytes: array | null) -> object =
        if bytes == null
            { status: status, headers: pairs, text: body, bytes: null, source: null, heartbeat: 0 }
        else
            { status: status, headers: pairs, text: null, bytes: bytes, source: null, heartbeat: 0 }

    // Whether an answer is a body that arrives in pieces.
    //
    // **It is `for await`'s own question and not a new one**: a source is a generator, or anything
    // with a `next` -- which is the same two things `for await` drives. So a generator function's
    // result is a streamed body with nothing said and nothing wrapped, and an object a program built
    // itself is one on the same terms.
    isSource(v) -> boolean = v is generator || (v is object && has(v, "next") && v.next is function)

    // Whether this client asked for brotli, reading the header rather than looking for the two letters.
    //
    // **`br;q=0` is a client saying it would rather not**, which is not the same as not mentioning it,
    // and `deflate` contains no `br` but a future token might -- so the field is split into its tokens
    // the way the specification says it is.
    wantsBrotli(req: object | null) -> boolean =
        if req == null then return false
        if !has(req.headers, "accept-encoding") then return false

        for part in split(lower(req.headers["accept-encoding"]), ",")
            val token = trim(part)

            if token == "br" || startsWith(token, "br;")
                if contains(token, "q=0") && !contains(token, "q=0.") then return false

                return true

        false

    // A response this module writes for itself, where there is no handler answer to write. **Always the
    // connection's last**, so it never has to say whether one is being kept.
    //
    // **Never compressed**, and not for want of a request to ask: these are short sentences about a
    // request that could not be read, and a client being told why is a client that may not be in a
    // state to decode anything.
    plainly(conn, status: integer, message: string) = reply(conn, status, "", message, false)

    // **`Content-Length` is counted in BYTES and not in characters**, which is the one place this module
    // has to remember that a slate string is characters: a body with an `é` in it is one byte longer
    // than it is characters, and a wrong length here is a client that hangs waiting for the rest of a
    // response that has all arrived.
    //
    // **This answers a promise and closes nothing**, which is what makes keep-alive possible at all: the
    // caller awaits it and then decides. Where the decision is to close, the close comes after the await
    // and that ordering is the whole of it -- closing a socket with a write still queued throws the write
    // away, and the difference a client sees is between a response and a reset connection.
    async reply(conn, status: integer, extra: string, body: string, keep: boolean)
        await send(conn, head(status, extra, len(toBytes(body)), keep) + body)

    // The same, for a body that is already bytes.
    //
    // **Two functions rather than one taking bytes always**, because a slate byte array is one value per
    // byte: making every response go through one would cost a megabyte of text a million boxed integers
    // for nothing. The compressed path pays it because the body is small by then, and it is the only
    // path that has to.
    async replyBytes(conn, status: integer, extra: string, body: array, keep: boolean)
        await send(conn, concat(toBytes(head(status, extra, len(body), keep)), body))

    // -- a body that arrives in pieces ------------------------------------------------------------

    // A response whose body arrives in pieces, written as HTTP/1.1 chunked transfer.
    //
    // **NO `Content-Length` AND NO COMPRESSION.** Neither is knowable before the last piece, and a
    // server that buffered the lot to find out would be undoing the thing streaming is for.
    //
    // **A piece may be text or bytes**, exactly as a whole body may, and each is framed as it is.
    //
    // **A source that faults mid-stream ends the response and puts the fault back**, which is what
    // the server does for a handler that faults: the client sees a truncated body -- which is what a
    // chunked response with no terminator means, and is the only thing HTTP can say once the status
    // line has gone -- and the defect still stops the program.
    async streamed(conn, r: object, extra: string, keep: boolean)
        await send(conn, streamHead(r.status, extra, keep))

        var beating = false

        // **A comment while nothing is happening**, on the interval the response asked for. A line
        // beginning `:` is a comment every SSE client ignores, and it is what keeps an idle
        // connection open through a proxy and tells a client the server is still there.
        //
        // **The response says so with `heartbeat` rather than the writer sniffing a content type.**
        // What decides is then a thing a program wrote, and anything streaming may ask for it --
        // `sse` is one caller of this and not the reason it exists.
        //
        // **The server writes it rather than the formatter.** A formatter pulling from a source
        // cannot interleave a heartbeat with it without racing two promises; the writer already has
        // the socket and a clock.
        // **The comment goes through `sendChunk` rather than being framed by hand**, which is where
        // the first version of this got it wrong: a size line counted in characters rather than
        // bytes, or counted at all by eye, is a chunked stream no client can read past.
        beat()
            if !beating then return

            sendChunk(conn, ": keep-alive\n\n")
            setTimeout(beat, r.heartbeat * 1000)

        if r.heartbeat > 0
            beating = true

            setTimeout(beat, r.heartbeat * 1000)

        // **A SOURCE THAT FAULTS IS PUT BACK ON THE LOOP RATHER THAN THROWN FROM HERE**, and that is
        // not fussiness: the server wraps this call in a `try` that reads a failure as *the client
        // has gone*, which is the ordinary end of a connection and no reason to stop anything. A
        // fault raised here would be swallowed by it, so the defect would vanish and the program
        // would carry on with a client that had been told nothing.
        //
        // What the client sees either way is a chunked body with no terminator, which is the only
        // thing HTTP can say once the status line has gone.
        try
            for await piece in r.source
                await sendChunk(conn, piece)
        catch e
            beating = false

            setTimeout(() -> putBack(e), 0)

            return

        beating = false

        await send(conn, "0\r\n\r\n")

    // **A named function because `throw` is a statement**, so a lambda cannot be one.
    putBack(e)
        throw e

    // One chunk: the byte count in hexadecimal, the bytes, and a blank line.
    async sendChunk(conn, piece)
        if piece is array
            await send(conn, concat(toBytes(hex(len(piece)) + "\r\n"), concat(piece, toBytes("\r\n"))))
            return

        val text = if piece is string then piece else string(piece)
        val n = len(toBytes(text))

        // **A zero-length chunk is the terminator**, so a source that answers an empty string would
        // end the response with more to come. It is skipped rather than refused, an empty piece
        // being a thing to write nothing about.
        if n == 0 then return

        await send(conn, hex(n) + "\r\n" + text + "\r\n")

    // The status line and the headers of a chunked response.
    streamHead(status: integer, extra: string, keep: boolean) -> string =
        ("HTTP/1.1 " + string(status) + " " + reason(status) + "\r\n" + extra +
            "Transfer-Encoding: chunked\r\nConnection: " +
            (if keep then "keep-alive" else "close") + "\r\n\r\n")

    // A number in lower-case hexadecimal, which is what a chunk's size line is written in.
    hex(n: integer) -> string
        if n == 0 then return "0"

        val digits = "0123456789abcdef"
        var out = ""
        var left = n

        while left > 0
            out = digits[(left % 16)..<((left % 16) + 1)] + out
            left = left / 16

        out

    // -- server-sent events ------------------------------------------------------------------------

    // `sse(source)` -- a source of values as a `text/event-stream` response.
    //
    //     app.get("/events", (req) -> sse(ticks()))
    //
    // **A piece may be a string, which is its data**, or an object saying any of `event`, `id`,
    // `retry` and `data` -- and a `data` that is not a string is JSON, which is what a browser's
    // `JSON.parse(e.data)` is going to want anyway.
    //
    // **Every line of the data is prefixed**, because a bare newline inside one would end the event.
    // That is the whole of the format and the whole of what this does.
    //
    // | option | |
    // |---|---|
    // | `heartbeat` | seconds between comments while nothing is sent; 15, and `0` for none |
    // | `status` | 200 |
    //
    // **It is an ordinary response value**, so a handler may build one itself: what `sse` answers is
    // `{ status, headers, body, heartbeat }` and nothing about the server knows this function exists.
    export sse(source, options: object = {}) -> object =
        { status: if has(options, "status") then options.status else 200,
          headers: { "Content-Type": "text/event-stream", "Cache-Control": "no-cache" },
          heartbeat: if has(options, "heartbeat") then options.heartbeat else 15,
          body: framedEvents(source) }

    // The source `sse` hands the writer: the one it was given, with each value formatted.
    //
    // **The parameter is unannotated because a generator is not an `object`**, and both are sources.
    framedEvents(source) -> object
        async pull()
            val step = await source.next()

            if step.done then return { done: true, value: null }

            { done: false, value: oneEvent(step.value) }

        { next: pull }

    // One event, as the lines a client reads.
    oneEvent(v) -> string
        if v is string then return dataLines(v)
        if !(v is object) then return dataLines(string(v))

        var out = ""

        if has(v, "event") then out = out + "event: " + string(v.event) + "\n"
        if has(v, "id") then out = out + "id: " + string(v.id) + "\n"
        if has(v, "retry") then out = out + "retry: " + string(v.retry) + "\n"

        val body = if !has(v, "data") then "" elif v.data is string then v.data else toJSON(v.data)

        out + dataLines(body)

    // The data, one `data:` line per line of it, and the blank line that ends the event.
    dataLines(text: string) -> string
        var out = ""

        for line in split(text, "\n")
            out = out + "data: " + line + "\n"

        out + "\n"

    // The status line, the headers and the blank line that ends them.
    //
    // **The brackets are what continue the lines**, a trailing `+` outside a bracket pair not being a
    // continuation in slate -- which is why the expression this was cut out of never needed them and
    // this does.
    head(status: integer, extra: string, length: integer, keep: boolean) -> string =
        ("HTTP/1.1 " + string(status) + " " + reason(status) + "\r\n" + extra +
            "Content-Length: " + string(length) + "\r\nConnection: " +
            (if keep then "keep-alive" else "close") + "\r\n\r\n")

    // The word beside the number. **Only the ones a handler is likely to answer with**, since a client
    // reads the number and the text is for a person reading a log.
    reason(status: integer) -> string =
        if status == 200 then "OK"
        elif status == 201 then "Created"
        elif status == 204 then "No Content"
        elif status == 301 then "Moved Permanently"
        elif status == 302 then "Found"
        elif status == 304 then "Not Modified"
        elif status == 400 then "Bad Request"
        elif status == 401 then "Unauthorized"
        elif status == 403 then "Forbidden"
        elif status == 404 then "Not Found"
        elif status == 405 then "Method Not Allowed"
        elif status == 411 then "Length Required"
        elif status == 413 then "Content Too Large"
        elif status == 431 then "Request Header Fields Too Large"
        elif status == 501 then "Not Implemented"
        elif status == 418 then "I am a teapot"
        elif status == 500 then "Internal Server Error"
        elif status == 503 then "Service Unavailable"
        else "Status"

    """
