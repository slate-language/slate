module dev.slatelang.slate
@tests

#if feature_http2

// `fetch` over HTTP/2, against a server in the same program that speaks both versions on one port.
//
// **The server is `slate:net` and `slate:nghttp2` and not `slate:http`**, because what is under test
// is what the client does with the frames -- a stream reset, a GOAWAY, a body larger than the window --
// and a server that drives the session itself is the only one that can be made to send each of those
// on purpose. It answers in HTTP/1.1 where ALPN settled on that, saying which it spoke in every body,
// so a test can tell an HTTP/2 answer from the fallback by reading what came back.
//
// **The interpreter alone**: a JavaScript host picks the protocol itself, and node's `fetch` offers
// no `h2` at all, so there is no second host to hold to the same answer.

private val H2Import: string =
    "import { h2Server, h2Receive, h2Send, h2Next, h2Respond, h2RespondStream, h2Push, h2Finish, h2Reset, h2Goaway } from slate:nghttp2\n" +
    "import { readFileSync } from slate:fs\n" +
    "import { gzip } from slate:gzip\n" +
    "import { randomBytes } from slate:crypto\n"

// `listening(alpn)` is a listener offering those protocols; `hungUp` says whether the client let go of
// `/endless`, by a reset or by closing. **ALPN is read at the first arrival and not in the connection
// callback**, which runs at the accept, before the handshake has settled anything.
private val H2Server: string = raw"""
    val cert = readFileSync("tests/tls/cert.pem").value
    val key = readFileSync("tests/tls/key.pem").value
    val gz = [31,139,8,0,0,0,0,0,0,19,43,46,44,77,77,173,74,77,81,72,204,75,81,72,74,76,206,6,0,84,52,83,205,17,0,0,0]
    val big = "0123456789".repeat(100000)
    val noise = randomBytes(150000)
    var hungUp = false

    field(hs, name)
        var v = ""
        for p in hs
            if p[0] == name then v = p[1]
        v

    speakH2(conn, first)
        val s = h2Server()
        val asked = {}
        val c = { gone: false, endless: 0 }

        async flush()
            if c.gone then return
            val out = h2Send(s)
            if out.length > 0
                try
                    await send(conn, out)
                catch e
                    c.gone = true

        async endless(stream)
            h2RespondStream(s, stream, { ":status": "200" })
            while !c.gone
                if h2Push(s, stream, "tick") != null then return
                await flush()
                await sleep(20)

        async answer(stream, a)
            val p = a.path
            if p == "/hello"
                h2Respond(s, stream, [[":status", "200"], ["x-many", "one"], ["x-many", "two"], ["set-cookie", "a=1"], ["set-cookie", "b=2"]], "hello over h2")
            elif p == "/echo"
                h2Respond(s, stream, { ":status": "200" }, a.method + " " + a.body + " " + a.test + " over h2")
            elif p == "/moved"
                h2Respond(s, stream, { ":status": "302", "location": "/hello" })
            elif p == "/slow"
                await sleep(500)
                if !c.gone then h2Respond(s, stream, { ":status": "200" }, "late")
            elif p == "/gz"
                if a.enc.contains("gzip")
                    h2Respond(s, stream, { ":status": "200", "content-encoding": "gzip" }, gz)
                else
                    h2Respond(s, stream, { ":status": "200" }, "plain")
            elif p == "/forced"
                h2Respond(s, stream, { ":status": "200", "content-encoding": "gzip" }, gz)
            elif p == "/noisez"
                h2Respond(s, stream, { ":status": "200", "content-encoding": "gzip" }, await gzip(noise))
            elif p == "/gzbad"
                h2RespondStream(s, stream, { ":status": "200", "content-encoding": "gzip" })
                h2Push(s, stream, [31,139,8,0,0,0,0,0,0,19,0,5,0,250,255,104,101,108,108,111])
                await flush()
                await sleep(30)
                h2Push(s, stream, [7,0,0,0,0,0,0,0,0])
                h2Finish(s, stream)
            elif p == "/drip"
                h2RespondStream(s, stream, { ":status": "200" })
                h2Push(s, stream, "first")
                await flush()
                await sleep(30)
                h2Push(s, stream, " late")
                h2Finish(s, stream)
            elif p == "/endless"
                c.endless = stream
                endless(stream)
            elif p == "/hungup"
                h2Respond(s, stream, { ":status": "200" }, string(hungUp))
            elif p == "/big"
                h2Respond(s, stream, { ":status": "200" }, big)
            elif p == "/reset"
                h2Reset(s, stream, 2)
            elif p == "/goaway"
                h2Goaway(s, 0, 11)
            elif p == "/garbage"
                await send(conn, [0, 0, 1, 0, 0, 0, 0, 0, 0, 65])
            await flush()

        took(e)
            val k = string(e.stream ?? 0)
            if e.kind == "headers"
                asked[k] = { path: field(e.headers, ":path"), method: field(e.headers, ":method"), enc: field(e.headers, "accept-encoding"), test: field(e.headers, "x-test"), body: "" }
            elif e.kind == "data"
                asked[k].body = asked[k].body + fromBytes(e.bytes).value
            elif e.kind == "streamEnd"
                answer(e.stream, asked[k])
            elif e.kind == "rstStream"
                if e.stream == c.endless then hungUp = true

        heard(chunk)
            if h2Receive(s, chunk) != null
                close(conn)
                return
            var e = h2Next(s)
            while e != null
                took(e)
                e = h2Next(s)
            flush()

        onBytes(conn, chunk ->
            if chunk == null
                c.gone = true
                if c.endless > 0 then hungUp = true
                close(conn)
            else
                heard(chunk))
        heard(first)

    speakH1(conn)
        onBytes(conn, chunk ->
            if chunk == null then close(conn))
        send(conn, "HTTP/1.1 200 OK\r\nContent-Length: 13\r\nConnection: close\r\n\r\nhello over h1")

    listening(alpn) = listen({ port: 0, cert: cert, key: key, alpn: alpn }, conn ->
        onBytes(conn, first ->
            if first == null
                close(conn)
            elif alpnProtocol(conn) == "h2"
                speakH2(conn, first)
            else
                speakH1(conn)))

    val both = listening(["h2", "http/1.1"])
    val oneOnly = listening(["http/1.1"])
    val base = "https://localhost:" + string(localPort(both))
    get(p) = fetch(base + p, { trust: cert })
    getWith(p, o)
        o.trust = cert
        fetch(base + p, o)
    v(r)
        if r.ok then return r.value
        { status: 0, body: "failed: " + r.error, headers: {} }
    finish()
        close(both)
        close(oneOnly)
        done()
    """

private h2_out(probe: string) -> string = out(NetImport + H2Import + watched(H2Server + "\n" + probe))

@test
fetch_SPEAKS_HTTP2_WHERE_THE_SERVER_CHOOSES_IT_AND_HTTP1_WHERE_IT_DOES_NOT()
    assert_eq(h2_out(raw"""
        async main()
            val r = v(await get("/hello"))
            print(r.status, r.body, r.headers["x-many"], r.headers["set-cookie"])
            val p = v(await getWith("/echo", { method: "POST", body: "a body", headers: { "X-Test": "named", Connection: "keep-alive" } }))
            print(p.status, p.body)
            val m = v(await get("/moved"))
            print(m.status, m.body)
            val h = v(await fetch("https://localhost:" + string(localPort(oneOnly)) + "/hello", { trust: cert }))
            print(h.status, h.body)
            finish()

        main()
        """).trim(),
        "200 hello over h2 one, two [\"a=1\", \"b=2\"]\n" +
        "200 POST a body named over h2\n" +
        "200 hello over h2\n" +
        "200 hello over h1")
end fetch_SPEAKS_HTTP2_WHERE_THE_SERVER_CHOOSES_IT_AND_HTTP1_WHERE_IT_DOES_NOT

// **A streamed body ends with its stream**, an early `break` hangs up -- the server hears a reset or
// the close and `/endless` stops -- and a limit runs out over HTTP/2 exactly as over HTTP/1.1.
@test
A_STREAMED_BODY_AND_A_TIMEOUT_BEHAVE_OVER_HTTP2_AS_THEY_DO_OVER_HTTP1()
    assert_eq(h2_out(raw"""
        async drain(p, o)
            val r = await getWith(p, o)
            if !r.ok then return r.error
            var got = bytes(0)
            var said = "whole"
            for await c in r.value.body
                c match
                    { ok: false, error } -> said = error
                    _ -> push(got, c)
            fromBytes(got).value + " " + said

        async main()
            print(await drain("/drip", { stream: true }))
            val r = v(await getWith("/endless", { stream: true }))
            var seen = 0
            for await c in r.body
                seen = seen + 1
                if seen == 3 then break
            print(seen, (await r.body.next()).done)
            await sleep(200)
            print(v(await get("/hungup")).body)
            val t = await getWith("/slow", { timeout: 100 })
            print(t.ok, t.error.replace(base, "BASE"))
            print(await drain("/forced", { stream: true }))
            print(await drain("/gzbad", { stream: true }))
            finish()

        main()
        """).trim(),
        "first late whole\n" +
        "3 true\n" +
        "true\n" +
        "false BASE/slow did not answer within 100 milliseconds\n" +
        "squeezed and back whole\n" +
        "hello the server said the body was compressed with gzip, and it could not be decompressed")
end A_STREAMED_BODY_AND_A_TIMEOUT_BEHAVE_OVER_HTTP2_AS_THEY_DO_OVER_HTTP1

// **A compressed streamed body larger than the window arrives whole**, which it only does if the
// credit handed back keeps pace with the bytes the server sent. It is counted in those rather than in
// what they decoded to: random bytes grow a little under gzip, so the decoded count is the smaller.
@test
A_COMPRESSED_STREAMED_BODY_LARGER_THAN_THE_WINDOW_ARRIVES_WHOLE_OVER_HTTP2()
    assert_eq(h2_out(raw"""
        async main()
            val r = v(await getWith("/noisez", { stream: true }))
            var got = bytes(0)
            for await c in r.body
                push(got, c)
            print(got.length, got[0] == noise[0], got[149999] == noise[149999])
            finish()

        main()
        """).trim(),
        "150000 true true")
end A_COMPRESSED_STREAMED_BODY_LARGER_THAN_THE_WINDOW_ARRIVES_WHOLE_OVER_HTTP2

// **A compressed body is decoded, and a large one arrives whole**: a megabyte is sixteen times the
// initial window, so it only arrives at all if the client grants the server more as it reads.
@test
A_COMPRESSED_BODY_AND_ONE_LARGER_THAN_THE_WINDOW_ARRIVE_WHOLE_OVER_HTTP2()
    assert_eq(h2_out(raw"""
        async main()
            print(v(await get("/gz")).body)
            print(v(await getWith("/gz", { headers: { "Accept-Encoding": "identity" } })).body)
            val b = v(await get("/big")).body
            print(b.length, b == big)
            finish()

        main()
        """).trim(),
        "squeezed and back\n" +
        "plain\n" +
        "1000000 true")
end A_COMPRESSED_BODY_AND_ONE_LARGER_THAN_THE_WINDOW_ARRIVE_WHOLE_OVER_HTTP2

// **A reset, a GOAWAY and a frame that breaks the protocol are answers, not faults**: the server's
// word, said in a sentence that names what it did and the code it gave. The broken frame -- DATA on
// stream 0 -- is the one nghttp2 ends the session over without `receive` failing, and before the
// check after every arrival the fetch waited for ever on a server that was waiting on it. The fetch
// after them all is the proof that each one gave its slot back.
@test
A_RESET_A_GOAWAY_AND_A_PROTOCOL_ERROR_ARE_ANSWERED_AS_RESULTS_OVER_HTTP2()
    assert_eq(h2_out(raw"""
        async main()
            print((await get("/reset")).error.replace(base, "BASE"))
            print((await get("/goaway")).error.replace(base, "BASE"))
            print((await get("/garbage")).error.replace(base, "BASE"))
            print(v(await get("/hello")).body)
            finish()

        main()
        """).trim(),
        "the server reset the request for BASE/reset (INTERNAL_ERROR)\n" +
        "the server closed the HTTP/2 connection before answering BASE/goaway (ENHANCE_YOUR_CALM)\n" +
        "localhost sent HTTP/2 that breaks the protocol, so the connection was ended\n" +
        "hello over h2")
end A_RESET_A_GOAWAY_AND_A_PROTOCOL_ERROR_ARE_ANSWERED_AS_RESULTS_OVER_HTTP2

#endif
