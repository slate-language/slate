module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// Statements, as bytecode: a run of them, an assignment and a `try`. The loops, and the `break` and
// `continue` that leave them, are `compile_loop.sysl`.
//
// **Cut out of `compile.sysl`, which keeps the entry points and the types.** Reached from there only
// through `compile_stmts`, and reaching back into it for `emit_pattern_defaults`, `refuse_optionals`
// and `module_index`, each of which says so where it is declared.
// -- statements -----------------------------------------------------------------------------------

// What a statement is asked to leave behind, which is what tells a statement somebody reads from one
// nobody does.
//
// **The two unread answers differ in what becomes of a dropped PROMISE, and nothing else.**
// `Discard` marks one orphaned, so a rejection nobody waited for is still reported; `Pop` cuts the
// stack back and says nothing. A loop body's last statement has always met a `Pop`, and a statement
// standing in front of another has always met a `Discard`.
//
// Not `private`: reached from `compile.sysl` and `compile_expr.sysl`.
enum StmtValue
    Kept
    Dropped
    Cut

// A run of statements, leaving the last one's value where somebody reads it.
//
// **NOTHING IS PUSHED FOR A STATEMENT WHOSE VALUE NOBODY READS.** slate is expression-oriented, so
// every statement answers something -- but every statement except the last stands where that answer
// is thrown away, and the last one does too where the run itself is unread. Such a statement is
// compiled without producing a value at all, which takes with it the `PushNull` a binding used to
// leave and the `Discard` that used to take it away. What is left for a bare expression, whose value
// exists whatever is done with it, is the one instruction that drops it.
//
// **A FUNCTION DECLARATION IS HOISTED TO THE TOP OF THE RUN, AS JAVASCRIPT'S IS.** `val sink =
// written` above `written(r) = …` is what a module with a default in it writes, and it answered
// *"`written` is not defined"* -- while the same two lines the other way round worked, and so did a
// call to `written` from inside another function, because that is resolved when it runs. The rule
// nobody could state was *a definition is in scope from the line it is written on, unless the thing
// that wants it is itself a function*.
//
// **`val` and `var` initialisers stay sequential**, which is JavaScript's rule too and is the half
// that matters: a binding may read what is above it and not what is below, so nothing here makes a
// program's data flow depend on where a function happens to sit.
//
// **THE CHUNK IS COMPILED ONCE**, here. Compiling it again where it stands would double every
// complaint its body makes.
//
// **A STATEMENT CARRIES A SAFE POINT UNLESS IT STANDS IN A LOOP'S BODY, WHERE THE LOOP'S OWN
// COVERS IT.** A `Tick` used to stand in front of every statement in the language -- 7.1% of every
// instruction the benchmark set executes, two of the nineteen in `arith`'s inner loop -- and a
// statement in a loop is the only kind that runs more than once for having been written once.
// `safe_point` in `emit.sysl` is where that is argued.
compile_stmts(u: *Unit, e: *Emit, stmts: Buf[Stmt], at: Span, wants: StmtValue)
    if stmts.len() == 0
        nothing_left(e, at, wants)
        return

    hoist_defs(u, e, stmts)
    compile_run(u, e, stmts, at, wants)
end compile_stmts

// The run itself, with the hoisting already done.
//
// **A `using` takes the rest of the run with it**, which is the whole reason this is a function of
// its own: what a `using` guards is the statements that FOLLOW it, so the tail becomes the body of
// something rather than the next turn of this loop. Hoisting has already run over the whole block,
// the tail included, so it must not run again -- a chunk compiled twice reports every complaint in
// it twice.
//
// Not `private`: `using.sysl` compiles the tail it was handed through this.
compile_run(u: *Unit, e: *Emit, stmts: Buf[Stmt], at: Span, wants: StmtValue)
    if stmts.len() == 0
        nothing_left(e, at, wants)
        return

    val last = stmts.len() - 1

    for i in 0..<stmts.len()
        val leaves: StmtValue = if i == last then wants else Dropped

        statement_safe_point(e, stmts.at(i).span)

        *stmts.at(i).kind match
            Using(bind, awaited) ->
                var rest: Buf[Stmt] = buf()

                for j in (i + 1)..<stmts.len()
                    rest.push(stmts.at(j))

                compile_using(u, e, bind, rest, stmts.at(i).span, awaited, wants)
                return
            _ -> compile_stmt(u, e, stmts.at(i), true, leaves)
end compile_run

// A statement that computed nothing, which is most of them: the null it used to leave is pushed only
// where somebody is going to read it.
//
// Not `private`: reached from `compile_loop.sysl` -- a `break` or a `continue` is a statement too.
nothing_left(e: *Emit, at: Span, wants: StmtValue)
    if wants == Kept then push_n(e, PushNull, at, 0, 1)

// A statement whose value is on the stack, dropped where nobody reads it.
//
// Not `private`: reached from `compile_expr.sysl` -- an expression compiled for no value drops one
// where it turns out to have made one anyway.
drop_value(e: *Emit, at: Span, wants: StmtValue)
    wants match
        Kept -> ()
        Dropped -> push_n(e, Discard, at, 1, 0)
        Cut -> push_n(e, Pop, at, 1, 0)

// Every definition in a run of statements, bound before the run begins.
//
// **A `Group` is walked into**, its statements landing in the scope around it rather than in one of
// their own -- so a definition inside one is a definition of this block and is hoisted with the rest.
//
// **A DEFINITION AT THE FILE'S OWN TOP LEVEL ALSO GOES INTO THE MACHINE'S TABLE**, which is what
// lets a call of it be resolved while compiling rather than looked up by name on every call. Which
// level that is reads off the compiler's own record of open blocks: a file's chunk is compiled with
// none open and every other block opens one before its statements are reached. `defs.sysl` is the
// subject, and a definition anywhere else is the `DefineFn` it always was.
private hoist_defs(u: *Unit, e: *Emit, stmts: Buf[Stmt])
    val file_level = e.module_top && e.blocks.is_empty()

    for i in 0..<stmts.len()
        *stmts.at(i).kind match
            Def(name, params, defaults, body, is_async) ->
                val c = compile_chunk(u, params, defaults, body_at(body), name, is_async, body_is_gen(body))
                val k = intern_str(u, name)

                val cell = if file_level then def_hoisted(u, name) else None

                cell match
                    Some(d) -> push_n(e, DefineDef(intern_wide(u, k, c, def_cell(u, d))), stmts.at(i).span, 0, 0)
                    None -> push_n(e, DefineFn(u32(k), u32(c)), stmts.at(i).span, 0, 0)
            Group(inner) -> hoist_defs(u, e, inner)
            _ -> ()
end hoist_defs

// One contract clause: the condition, a jump past the refusal, and the refusal.
//
// **A jump over a fault rather than an instruction of its own**, where `CheckType` is an instruction:
// a clause is an arbitrary expression and not a pattern, so there is nothing for a single instruction
// to carry. What that costs is a message interned at compile time, which is why a postcondition ends
// with `FailShowing` -- the value is on the stack and the reader wants to see it.
private compile_clause(u: *Unit, e: *Emit, is_require: bool, owner: string, text: string, cond: Expr, at: Span)
    compile_expr(u, e, cond)

    val refuse = push_n(e, JumpIfFalse(0), at, 1, 0)
    val over = push_n(e, Jump(0), at, 0, 0)

    patch(e, refuse, here(e))

    if is_require
        push_n(e, FailWith(intern_str(u, s"`${owner}` requires `${text}`, and this call does not meet it")), at, 0, 0)
    else
        push_n(e, FailShowing(intern_str(u, s"`${owner}` ensures `${text}`, and gave back ")), at, 0, 0)

    patch(e, over, here(e))
end compile_clause

// Every postcondition this chunk declared, run over the value about to be answered.
//
// **The answer is copied into `result` and left where it was**, which is what lets a clause be an
// ordinary expression naming an ordinary local: the parser declared `result` at the top of the body,
// so the slots pass has already given it a home.
private compile_exits(u: *Unit, e: *Emit, at: Span)
    if e.ensures.len() == 0 then return

    push_n(e, Dup, at, 0, 1)
    store_name(u, e, ResultName, at)

    for i in 0..<e.ensures.len()
        *e.ensures.at(i).kind match
            Clause(_, _, owner, text, cond) ->
                compile_clause(u, e, false, owner, text, cond, e.ensures.at(i).span)
            _ -> ()
end compile_exits

// `-> type` asked of a `return`, which answers as surely as falling out of the body does.
//
// **The same `CheckResult` the wrapper emits**, so the two ways out of a function say one sentence.
// The complaint about an annotation that names nothing is left to the wrapper, which is compiled once
// per definition where this is compiled once per `return`.
private check_answer(u: *Unit, e: *Emit, at: Span)
    e.result_pat match
        Some(pat) ->
            val shape = resolve_pattern(pat, 0)

            veil_answer(u, e, shape, at)
            push_n(e, CheckResult(u32(intern_str(u, e.result_declared)), u32(intern_pattern(u, shape))), at, 0, 0)
        None -> ()

// One statement, compiled where it stands.
//
// Not `private`: `using.sysl` compiles the annotation check a binding's own `Group` carried along
// with it, which is an ordinary statement standing on its own.
compile_one_stmt(u: *Unit, e: *Emit, s: Stmt, wants: StmtValue)
    compile_stmt(u, e, s, false, wants)

private compile_stmt(u: *Unit, e: *Emit, s: Stmt, hoisted: bool, wants: StmtValue)
    val at = s.span

    *s.kind match
        // **A `using` reached here guards nothing**, being the whole of a one-line body rather than
        // the head of a run -- so the resource is acquired and released with no statement in
        // between. `compile_run` is where the ordinary case is, the tail it guards being statements
        // this arm cannot see.
        Using(bind, awaited) -> compile_using(u, e, bind, buf(), at, awaited, wants)
        Val(name, init) ->
            compile_expr(u, e, init)
            declare_module_name(u, e, name, at, false)
            nothing_left(e, at, wants)
        Var(name, init) ->
            compile_expr(u, e, init)
            declare_module_name(u, e, name, at, true)
            nothing_left(e, at, wants)
        Unpack(pat, init, immutable) ->
            compile_expr(u, e, init)

            // **A parameter that takes its argument apart reaches this arm too**, the parser having
            // desugared it into an `Unpack` at the top of the body -- so refusing `?` here covers a
            // binding, a `var`, and every parameter, in one place.
            refuse_optionals(pat, "and this one binds")

            // Interned through `resolve_pattern` like every other pattern, so a declared type
            // stands in a destructuring binding exactly as it stands in a `match` arm.
            bind_pattern(u, e, pat, at, !immutable)
            nothing_left(e, at, wants)
        // **`hoist_defs` has already bound it**, so there is nothing left here to do. A definition
        // reached any other way still binds itself.
        Def(name, params, defaults, body, is_async) ->
            if !hoisted
                val c = compile_chunk(u, params, defaults, body_at(body), name, is_async, body_is_gen(body))

                push_n(e, DefineFn(u32(intern_str(u, name)), u32(c)), at, 0, 0)

            nothing_left(e, at, wants)
        // **Each is compiled where the group stands**, which is what makes it not a `Block`: the
        // names land in the scope around them. A group answers null rather than its last statement's
        // value, so every one of them is unread.
        Group(stmts) ->
            for i in 0..<stmts.len()
                compile_stmt(u, e, stmts.at(i), hoisted, Dropped)

            nothing_left(e, at, wants)
        // **AN `if`, A `match` OR A `try` STANDING AS A STATEMENT IS COMPILED FOR NO VALUE**, which
        // is `compile_unread`'s subject and where the argument about the join is written down. Where
        // somebody reads the answer it is the expression it always was.
        Eval(x) ->
            if wants == Kept
                compile_expr(u, e, x)
            else
                compile_unread(u, e, x, wants)
        Assign(op, target, value) -> compile_assign(u, e, op, target, value, at, wants)
        MultiAssign(op, targets, values) -> compile_multi_assign(u, e, op, targets, values, at, wants)
        Return(value) ->
            // **The complaint points at what was RETURNED, not at the `return` keyword in front of
            // it** -- the same reason the fall-out path points at the tail expression rather than at
            // the body it sits in. A bare `return` answers `null` where nothing was written down, so
            // there is no expression to point at and the statement's own span stands in.
            val result_span = value match
                Some(x) -> x.span
                None -> at

            value match
                Some(x) ->
                    compile_expr(u, e, x)

                    if e.ensures.len() > 0 || e.result_pat.is_some() || e.result_claim.is_some() || e.disposes.len() > 0
                        push_n(e, KeepAnswer, result_span, 1, 1)
                None -> push_n(e, PushNull, at, 0, 1)

            // **The postconditions are emitted in FRONT of the jump**, which is the half of a
            // contract the parser could not write: falling out of a body is an expression it can
            // wrap and a `return` is a jump nothing can be wrapped around.
            compile_exits(u, e, at)
            check_answer(u, e, result_span)
            claim_exit(u, e, e.result_claim, result_span)

            // **Every resource this chunk still holds is released in front of the jump, and the
            // answer is already on the stack when they run.** A `return` leaves every block at
            // once, so there is no depth to stop at; `Ret` puts the handler stack back to the
            // caller's, which is what takes the disposal handlers off with it.
            emit_disposes_above(u, e, 0, at)
            put(e, Ret, result_span)

            // Nothing after a `return` runs, but the block it sits in still has to count as leaving
            // what it owes, so the counter is told what the machine would have had.
            e.sp = e.sp - 1
            nothing_left(e, at, wants)
        Throw(x) ->
            compile_expr(u, e, x)
            put(e, Raise, at)

            // The same bookkeeping a `return` needs, and for the same reason: nothing after this
            // runs, and the block still has to leave behind what the counter expects.
            e.sp = e.sp - 1
            nothing_left(e, at, wants)
        // **A TYPE IS A VALUE UNDER ITS OWN NAME**, the way a class, a data type and a variant
        // already were -- a `type` name was the only one in the language that bound nothing, which
        // is why adding this breaks no program.
        //
        // The *resolution* still happened while this was compiled and the shape is still opaque:
        // what the name binds answers `test`, `mismatch` and `name` and lets nothing read its
        // fields back out. So "a type costs nothing at run time" survives in the sense that
        // mattered -- there is no structure here for a program, or for a later pass, to depend on.
        TypeDecl(name, pat) ->
            push_n(e, PushShape(u32(intern_resolved(u, pat)), u32(intern_str(u, name))), at, 0, 1)
            push_n(e, DeclareVal(intern_str(u, name)), at, 1, 0)
            nothing_left(e, at, wants)
        // **An external is one instruction and a `val`**, which is `ImportAsset`'s shape: the path
        // is interned, and the interned index IS the value -- so two declarations of one path bind
        // one value and `==` is identity with nothing to keep.
        ExternalDecl(name, path) ->
            push_n(e, PushExternal(intern_str(u, path)), at, 0, 1)
            push_n(e, DeclareVal(intern_str(u, name)), at, 1, 0)
            nothing_left(e, at, wants)
        CheckType(name, declared, pat) ->
            // **AN ANNOTATION THAT NAMES NOTHING WOULD CHECK NOTHING, SILENTLY.** A bare name in
            // pattern position is a binding where it names no type, and a binding matches anything --
            // so `f(x: string)` accepted every value and bound `string` inside `f`, `str` being
            // slate's word. A check that quietly passes is worse than no check, because the reader
            // believes it.
            val shape = resolve_pattern(pat, 0)

            first_binding(shape) match
                Some(loose) -> complain_here(at, s"`${loose}` is not a type, so checking `${name}` against it would check nothing${instead_of(loose)}")
                None -> ()

            val pk = intern_pattern(u, shape)

            slot_named(e, name) match
                Some(i) -> push_n(e, CheckSlot(u32(e.slot_of.at(i)), intern_wide(u, intern_str(u, name), intern_str(u, declared), pk)), at, 0, 0)
                None -> check_module_name(u, e, name, intern_wide(u, intern_str(u, name), intern_str(u, declared), pk), at)

            nothing_left(e, at, wants)

        // **A precondition runs where it stands and a postcondition's declaration runs nowhere.**
        // The head clause is what tells the ways out what to check; the parser has already put a copy
        // carrying `at_exit` where the body falls out, and `compile_exits` writes the rest.
        Clause(is_require, at_exit, owner, text, cond) ->
            if is_require || at_exit
                // **A postcondition on the FALL-OUT path puts `result` on the stack for its own
                // sentence to show.** `FailShowing` reads the top of the stack, which on a `return`
                // is the answer itself; here the run of statements has discarded it, so what was
                // left was whatever cell happened to be topmost -- the last LOCAL the body declared.
                // Loading the answer says what the reader is owed and depends on nothing about the
                // frame's layout.
                if at_exit then load_name(u, e, ResultName, at)

                compile_clause(u, e, is_require, owner, text, cond, at)

                if at_exit then push_n(e, Discard, at, 1, 0)
            else
                e.ensures.push(s)

            nothing_left(e, at, wants)
        Break(label, value) -> jump_out(u, e, at, true, label, value, wants)
        Continue(label) -> jump_out(u, e, at, false, label, None, wants)

        // **An import is three ordinary instructions per name and no new machinery.** The module is
        // already an object sitting in a slot, so taking a name out of it is the same `GetField` a
        // program writes for itself, and binding it is the same `DeclareVal` a `val` uses.
        //
        // Every path here resolved while loading -- a file that did not, or that does not export
        // what was asked of it, has already stopped the run with a diagnostic -- so a lookup that
        // fails now is a compiler bug and is emitted as one.
        ImportNames(path, _, origin, names, locals) ->
            module_index(u, path, origin) match
                Some(m) ->
                    // **Every name, including a type.** A type used to be skipped here, the
                    // module having no field of that name -- and that hole was the `class` trap
                    // written up in the repo's own notes, since a class is a type as well and does
                    // have one. A type is a value now, so there is one rule and no list.
                    for i in 0..<names.len()
                        push_n(e, PushModule(m), at, 0, 1)
                        push_n(e, GetField(u32(intern_str(u, names.at(i))), u32(fresh_site(u))), at, 1, 1)
                        push_n(e, DeclareVal(intern_str(u, locals.at(i))), at, 1, 0)
                None -> push_n(e, FailWith(intern_str(u, s"the module `${path}` was never loaded")), at, 0, 0)

            nothing_left(e, at, wants)
        ImportAll(path, _, origin, alias) ->
            module_index(u, path, origin) match
                Some(m) ->
                    push_n(e, PushModule(m), at, 0, 1)
                    push_n(e, DeclareVal(intern_str(u, alias)), at, 1, 0)
                None -> push_n(e, FailWith(intern_str(u, s"the module `${path}` was never loaded")), at, 0, 0)

            nothing_left(e, at, wants)

        // **An asset is a string literal and a `val`, which is the whole of it.** The loader read
        // the file before anything was compiled, so what reaches the machine is one `PushStr` into
        // the string table -- the same instruction `"hello"` written in the program compiles to, and
        // the same one however many files imported the asset, `intern_str` keeping one copy.
        ImportAsset(path, _, name) ->
            push_n(e, PushStr(intern_str(u, asset_here(u, path))), at, 0, 1)
            push_n(e, DeclareVal(intern_str(u, name)), at, 1, 0)
            nothing_left(e, at, wants)
end compile_stmt
// `x = e`, and `x += e` and the rest.
//
// **A compound form evaluates its place ONCE**, which is the whole reason it is not desugared into
// `x = x + e`: `xs[next()] += 1` calls `next` a single time. The place's parts are computed, copied
// with `DupAt` for the read, and the copies underneath are what the write consumes.
private compile_assign(u: *Unit, e: *Emit, op: Tok, target: Expr, value: Expr, at: Span, wants: StmtValue)
    if short_circuit_assign(op)
        compile_short_assign(u, e, op, target, value, at, wants)
        return

    val plain = op == Assign

    *target.kind match
        Name(n) ->
            val k = intern_str(u, n)

            if !plain
                load_name(u, e, n, target.span)
                unveil_operand(e, target.span)

            compile_expr(u, e, value)

            if !plain then operate_and_convert(u, e, op, value, at)

            store_name(u, e, n, target.span)
        Field(obj, name, _) ->
            val k = intern_str(u, name)

            compile_expr(u, e, obj)

            if !plain
                push_n(e, Dup, target.span, 0, 1)
                push_n(e, GetField(u32(k), u32(fresh_site(u))), target.span, 1, 1)
                unveil_operand(e, target.span)

            compile_expr(u, e, value)

            if !plain then operate_and_convert(u, e, op, value, at)

            push_n(e, SetField(u32(k), u32(fresh_site(u))), target.span, 2, 0)
        Index(t, key, _) ->
            compile_expr(u, e, t)
            compile_expr(u, e, key)

            if !plain
                push_n(e, DupAt(1), target.span, 0, 1)
                push_n(e, DupAt(1), target.span, 0, 1)
                push_n(e, GetIndex, target.span, 2, 1)
                unveil_operand(e, target.span)

            compile_expr(u, e, value)

            if !plain then operate_and_convert(u, e, op, value, at)

            push_n(e, SetIndex, target.span, 3, 0)
        _ -> push_n(e, FailWith(intern_str(u, "this cannot be assigned to")), at, 0, 0)

    nothing_left(e, at, wants)
end compile_assign

// A compound assignment's operator, its right operand unveiled where the file declared the type, and
// then whatever the checker proved the ANSWER is owed -- recorded at the statement's span, the answer
// having no expression of its own. `total += p` on a `var total: Points` is made a `Points` again
// before it is stored.
private operate_and_convert(u: *Unit, e: *Emit, op: Tok, value: Expr, at: Span)
    unveil_operand(e, value.span)
    push_n(e, op_instruction(op), at, 2, 1)
    convert_after(u, e, at)

// `x ??= v`, `x ||= v` and `x &&= v`.
//
// **THE VALUE IS NOT EVALUATED AT ALL WHERE THE PLACE KEEPS WHAT IT HAD**, which is the whole of
// what these are for: `cache[k] ??= build(k)` builds nothing for a key that is already there. The
// place's parts are still worked out exactly once, so `xs[next()] ??= 1` steps `next` one time
// whichever way the test goes.
//
//     <place parts>        the object, or the target and the key, or nothing at all for a name
//     <read the place>     leaves what is there
//     JumpIf...Keep(skip)  the question that says the place keeps it
//     Pop                  drop the reading copy
//     <value>
//     <write the place>    which consumes the parts underneath
//     Jump(done)
//   skip:                  the reading copy and the parts are still here
//     Pop ...              dropped, and nothing written
//   done:
//
// Both ways out leave the stack where the statement found it, which is what `nothing_left` is told.
private compile_short_assign(u: *Unit, e: *Emit, op: Tok, target: Expr, value: Expr, at: Span, wants: StmtValue)
    val entry = e.sp

    *target.kind match
        Name(n) ->
            load_name(u, e, n, target.span)

            val skip = keep_jump(e, op, at)

            push_n(e, Pop, at, 1, 0)
            compile_expr(u, e, value)
            store_name(u, e, n, target.span)

            val done = put(e, Jump(0), at)

            patch(e, skip, here(e))

            // The counter is set to what the MACHINE has here, not to what fell out of the branch
            // above: control arrives by the jump, with the reading copy still on the stack.
            e.sp = entry + 1

            push_n(e, Pop, at, 1, 0)
            patch(e, done, here(e))
        Field(obj, name, _) ->
            val k = intern_str(u, name)

            compile_expr(u, e, obj)
            push_n(e, Dup, target.span, 0, 1)
            push_n(e, GetField(u32(k), u32(fresh_site(u))), target.span, 1, 1)

            val skip = keep_jump(e, op, at)

            push_n(e, Pop, at, 1, 0)
            compile_expr(u, e, value)
            push_n(e, SetField(u32(k), u32(fresh_site(u))), target.span, 2, 0)

            val done = put(e, Jump(0), at)

            patch(e, skip, here(e))
            e.sp = entry + 2

            push_n(e, Pop, at, 1, 0)
            push_n(e, Pop, at, 1, 0)
            patch(e, done, here(e))
        Index(t, key, _) ->
            compile_expr(u, e, t)
            compile_expr(u, e, key)
            push_n(e, DupAt(1), target.span, 0, 1)
            push_n(e, DupAt(1), target.span, 0, 1)
            push_n(e, GetIndex, target.span, 2, 1)

            val skip = keep_jump(e, op, at)

            push_n(e, Pop, at, 1, 0)
            compile_expr(u, e, value)
            push_n(e, SetIndex, target.span, 3, 0)

            val done = put(e, Jump(0), at)

            patch(e, skip, here(e))
            e.sp = entry + 3

            push_n(e, Pop, at, 1, 0)
            push_n(e, Pop, at, 1, 0)
            push_n(e, Pop, at, 1, 0)
            patch(e, done, here(e))
        _ -> push_n(e, FailWith(intern_str(u, "this cannot be assigned to")), at, 0, 0)

    nothing_left(e, at, wants)
end compile_short_assign

// The jump that leaves the place alone, which asks the opposite of what the operator writes on.
//
// `??=` writes where the place is absent, so it keeps what is PRESENT -- and that is a different
// question from `||=`'s, which keeps what is true: `count ??= 1` leaves a zero alone and
// `count ||= 1` does not.
private keep_jump(e: *Emit, op: Tok, at: Span) -> usize
    if op == QQ then return push_n(e, JumpIfPresentKeep(0), at, 0, 0)
    if op == OrOr then return push_n(e, JumpIfTrueKeep(0), at, 0, 0)

    push_n(e, JumpIfFalseKeep(0), at, 0, 0)
end keep_jump

// `a, b = b, a`.
//
// **Every value is computed before any place is written**, which is what makes the swap a swap. They
// stay on the stack while the writes happen, and each write reaches back down to the one it wants --
// so nothing needs a temporary the program could name.
private compile_multi_assign(u: *Unit, e: *Emit, op: Tok, targets: Buf[Expr], values: Buf[Expr], at: Span, wants: StmtValue)
    val n = values.len()

    for i in 0..<n
        compile_expr(u, e, values.at(i))

    // How far below the top the value for target `i` sits, before that target's own parts are pushed.
    for i in 0..<targets.len()
        if i >= n then break

        val deep = n - 1 - i
        val target = targets.at(i)

        *target.kind match
            Name(name) ->
                val k = intern_str(u, name)

                if op != Assign
                    load_name(u, e, name, target.span)
                    push_n(e, DupAt(deep + 1), target.span, 0, 1)
                    push_n(e, op_instruction(op), at, 2, 1)
                else
                    push_n(e, DupAt(deep), target.span, 0, 1)

                store_name(u, e, name, target.span)
            Field(obj, name, _) ->
                val k = intern_str(u, name)

                compile_expr(u, e, obj)

                if op != Assign
                    push_n(e, Dup, target.span, 0, 1)
                    push_n(e, GetField(u32(k), u32(fresh_site(u))), target.span, 1, 1)
                    push_n(e, DupAt(deep + 2), target.span, 0, 1)
                    push_n(e, op_instruction(op), at, 2, 1)
                else
                    push_n(e, DupAt(deep + 1), target.span, 0, 1)

                push_n(e, SetField(u32(k), u32(fresh_site(u))), target.span, 2, 0)
            Index(t, key, _) ->
                compile_expr(u, e, t)
                compile_expr(u, e, key)

                if op != Assign
                    push_n(e, DupAt(1), target.span, 0, 1)
                    push_n(e, DupAt(1), target.span, 0, 1)
                    push_n(e, GetIndex, target.span, 2, 1)
                    push_n(e, DupAt(deep + 3), target.span, 0, 1)
                    push_n(e, op_instruction(op), at, 2, 1)
                else
                    push_n(e, DupAt(deep + 2), target.span, 0, 1)

                push_n(e, SetIndex, target.span, 3, 0)
            _ -> push_n(e, FailWith(intern_str(u, "this cannot be assigned to")), at, 0, 0)

    for i in 0..<n
        push_n(e, Pop, at, 1, 0)

    nothing_left(e, at, wants)
end compile_multi_assign

// `try ... catch e ...`, and the `x catch e -> y` that is the same thing.
//
// **The two branches meet at one stack height and one scope depth**, which is the whole of the
// bookkeeping: the body leaves a value and so does the handler, and the machine restores everything
// else from the record `PushHandler` wrote.
//
//     PushHandler(catch)   the world here is what a fault is given back
//     <body>               leaves one value
//     PopHandler           nothing faulted, so nothing is owed
//     Jump(end)
//   catch:                 the machine has cut back and pushed the fault
//     PushScope            the handler's name is its own
//     DeclareVal(e)        which takes the fault off the stack -- `DeclareSlot` where this chunk slots
//     <handler>            leaves one value
//     PopScope
//   end:
//
// **THE HANDLER'S NAME IS A SLOT LIKE ANY OTHER WHERE THE CHUNK SLOTS**, and the reason it can be is
// that the fault is already on the stack when the handler starts: `guarded` cuts the stack back to
// the height `PushHandler` recorded -- which is above the slot window, the window sitting at `base`
// and the handler having been established somewhere after it -- and pushes the fault on top. So a
// `DeclareSlot` here takes it off exactly as `DeclareVal` did, and writes it into a cell the frame
// reserved before its first instruction ran.
//
// Not `private`: reached from `compile_expr.sysl` -- `try` is an expression as well as a statement.
compile_try(u: *Unit, e: *Emit, body: Expr, name: string, handler: Expr, at: Span)
    val guard = push_n(e, PushHandler(0), at, 0, 0)
    val sp = e.sp
    val scopes = e.scopes

    e.handlers += 1

    compile_expr(u, e, body)
    push_n(e, PopHandler, at, 0, 0)
    e.handlers -= 1

    val over = put(e, Jump(0), at)

    patch(e, guard, here(e))

    // **The counters are set to what the MACHINE will have at the handler, not to what fell through
    // here.** Control does not reach this point by running the instruction before it: the machine
    // arrives having cut the stack back to where `PushHandler` stood and pushed the fault on top.
    e.sp = sp + 1
    e.scopes = scopes

    open_scope(e, at, scoped_catch(e, name))
    declare_name(u, e, name, at, false)
    compile_expr(u, e, handler)
    shut_scope(e, at)
    patch(e, over, here(e))
end compile_try

// `compile_try` with neither the body nor the handler producing a value.
//
// **THE HANDLER'S HEIGHT IS WHAT MAKES THIS SOUND AND IT DOES NOT MOVE.** `PushHandler` records the
// stack as it stands here, and the machine arrives at the handler having cut back to exactly that and
// pushed the fault on top -- so the counter is `sp + 1` there whatever the body left, and binding the
// caught name takes the fault off. The body leaves `sp` and so does the handler.
//
// Not `private`: reached from `compile_expr.sysl`, beside `compile_try`.
compile_try_unread(u: *Unit, e: *Emit, body: Expr, name: string, handler: Expr, at: Span, wants: StmtValue)
    val guard = push_n(e, PushHandler(0), at, 0, 0)
    val sp = e.sp
    val scopes = e.scopes

    e.handlers += 1

    compile_unread(u, e, body, wants)
    push_n(e, PopHandler, at, 0, 0)
    e.handlers -= 1

    val over = put(e, Jump(0), at)

    patch(e, guard, here(e))

    e.sp = sp + 1
    e.scopes = scopes

    open_scope(e, at, scoped_catch(e, name))
    declare_name(u, e, name, at, false)
    compile_unread(u, e, handler, wants)
    shut_scope(e, at)
    patch(e, over, here(e))
end compile_try_unread
