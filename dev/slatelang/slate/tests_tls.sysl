module dev.slatelang.slate
@tests

// HTTPS: `listen` told a certificate, and everything above it unchanged.
//
// **These run against a real certificate in `tests/tls/`** and a real handshake over a real
// loopback socket -- there is no way to test TLS that is not end to end, and a test that mocked
// the handshake would be testing the mock.

@test
AN_HTTPS_SERVER_IS_serve_WITH_A_CERTIFICATE_AND_NOTHING_ELSE()
    // **The whole feature: `serve` is an HTTPS server and `serve` did not change.** A listener told a
    // certificate hands out connections whose bytes are already decrypted, so the module that owns
    // the protocol never learns that TLS exists -- which is why this is under `listen` rather than
    // beside `serve`, and why there is no `serveTls` to keep in step with `serveStream`.
    //
    // **The certificate is a real one, generated once and committed**, because a self-signed pair
    // made at test time is a test that depends on a binary being installed. It names `localhost` and
    // `127.0.0.1` and expires in a hundred years.

    val text = "import { serve, close } from slate:http\nimport { localPort } from slate:net\nimport { readFileSync } from slate:fs\n\nval cert = readFileSync(\"tests/tls/cert.pem\").value\nval key = readFileSync(\"tests/tls/key.pem\").value\n\nval server = serve({ port: 0, cert: cert, key: key }, (req) -> req.method + \" \" + req.path + \" over TLS\")\n\nasync main()\n    val r = await fetch(\"https://localhost:\" + string(localPort(server)) + \"/hello\", { trust: cert })\n\n    if r.ok\n        print(r.value.status, r.value.body)\n    else\n        print(\"failed: \" + r.error)\n\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(out(watched(text)),
        "200 GET /hello over TLS")

@test
A_SELF_SIGNED_CERTIFICATE_IS_REFUSED_BY_A_CLIENT_THAT_WAS_NOT_TOLD_TO_TRUST_IT()
    // **A certificate nothing trusts is refused, which is the property worth having.** `trust` adds to
    // the machine's own list rather than replacing it, so a program that names one is still verifying
    // every other server it talks to -- and one that names none gets the ordinary answer for a
    // self-signed certificate, which is no.

    val text = "import { serve, close } from slate:http\nimport { localPort } from slate:net\nimport { readFileSync } from slate:fs\n\nval cert = readFileSync(\"tests/tls/cert.pem\").value\nval key = readFileSync(\"tests/tls/key.pem\").value\n\nval server = serve({ port: 0, cert: cert, key: key }, (req) -> \"never read\")\n\nasync main()\n    val r = await fetch(\"https://localhost:\" + string(localPort(server)) + \"/\", {})\n\n    print(r.ok)\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(out(watched(text)),
        "false")

@test
PLAIN_HTTP_TO_A_TLS_PORT_FAILS_RATHER_THAN_HANGING()
    // Plain HTTP to a port that is speaking TLS is not a connection that half works: the server reads
    // the request line as a handshake record and gives up, and the client is told so rather than left
    // waiting.

    val text = "import { serve, close } from slate:http\nimport { localPort } from slate:net\nimport { readFileSync } from slate:fs\n\nval cert = readFileSync(\"tests/tls/cert.pem\").value\nval key = readFileSync(\"tests/tls/key.pem\").value\n\nval server = serve({ port: 0, cert: cert, key: key }, (req) -> \"never read\")\n\nasync main()\n    val r = await fetch(\"http://localhost:\" + string(localPort(server)) + \"/\", {})\n\n    print(r.ok)\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(out(watched(text)),
        "false")

@test
A_KEY_THAT_DOES_NOT_GO_WITH_THE_CERTIFICATE_IS_REFUSED_AT_THE_LISTENER()
    // **A key that does not go with the certificate is caught where the listener is made**, and that is
    // the only place it can be: both installs succeed on a mismatched pair, and the handshake then
    // fails at the *client* with a decrypt error that says nothing about this end at all. The key
    // here is a perfectly good one -- from a second certificate generated beside the first -- so what
    // is being caught is the mismatch and not a malformed file.

    val text = "import { serve, close } from slate:http\nimport { readFileSync } from slate:fs\n\nval cert = readFileSync(\"tests/tls/cert.pem\").value\nval wrong = readFileSync(\"tests/tls/other-key.pem\").value\n\ntry\n    close(serve({ port: 0, cert: cert, key: wrong }, (req) -> \"no\"))\n    print(\"accepted\")\n    done()\ncatch e\n    print(\"refused\")\n\ndone()\n"

    assert_eq(out(watched(text)),
        "refused")
