module dev.slatelang.slate
@tests

import sysl.text.Search

// HTTPS: `listen` told a certificate, and everything above it unchanged.
//
// **These run against a real certificate in `tests/tls/`** and a real handshake over a real
// loopback socket -- there is no way to test TLS that is not end to end, and a test that mocked
// the handshake would be testing the mock.

@test
AN_HTTPS_SERVER_IS_serve_WITH_A_CERTIFICATE_AND_NOTHING_ELSE()
    // **The whole feature: `serve` is an HTTPS server and `serve` did not change.** A listener told a
    // certificate hands out connections whose bytes are already decrypted, so the module that owns
    // the protocol never learns that TLS exists -- which is why this is under `listen` rather than
    // beside `serve`, and why there is no `serveTls` to keep in step with `serveStream`.
    //
    // **The certificate is a real one, generated once and committed**, because a self-signed pair
    // made at test time is a test that depends on a binary being installed. It names `localhost` and
    // `127.0.0.1` and expires in a hundred years.

    val text = "import { serve, close } from slate:http\nimport { localPort } from slate:net\nimport { readFileSync } from slate:fs\n\nval cert = readFileSync(\"tests/tls/cert.pem\").value\nval key = readFileSync(\"tests/tls/key.pem\").value\n\nval server = serve({ port: 0, cert: cert, key: key }, (req) -> req.method + \" \" + req.path + \" over TLS\")\n\nasync main()\n    val r = await fetch(\"https://localhost:\" + string(localPort(server)) + \"/hello\", { trust: cert })\n\n    if r.ok\n        print(r.value.status, r.value.body)\n    else\n        print(\"failed: \" + r.error)\n\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(out(watched(text)),
        "200 GET /hello over TLS")

@test
A_SELF_SIGNED_CERTIFICATE_IS_REFUSED_BY_A_CLIENT_THAT_WAS_NOT_TOLD_TO_TRUST_IT()
    // **A certificate nothing trusts is refused, which is the property worth having.** `trust` adds to
    // the machine's own list rather than replacing it, so a program that names one is still verifying
    // every other server it talks to -- and one that names none gets the ordinary answer for a
    // self-signed certificate, which is no.

    val text = "import { serve, close } from slate:http\nimport { localPort } from slate:net\nimport { readFileSync } from slate:fs\n\nval cert = readFileSync(\"tests/tls/cert.pem\").value\nval key = readFileSync(\"tests/tls/key.pem\").value\n\nval server = serve({ port: 0, cert: cert, key: key }, (req) -> \"never read\")\n\nasync main()\n    val r = await fetch(\"https://localhost:\" + string(localPort(server)) + \"/\", {})\n\n    print(r.ok)\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(out(watched(text)),
        "false")

@test
PLAIN_HTTP_TO_A_TLS_PORT_FAILS_RATHER_THAN_HANGING()
    // Plain HTTP to a port that is speaking TLS is not a connection that half works: the server reads
    // the request line as a handshake record and gives up, and the client is told so rather than left
    // waiting.

    val text = "import { serve, close } from slate:http\nimport { localPort } from slate:net\nimport { readFileSync } from slate:fs\n\nval cert = readFileSync(\"tests/tls/cert.pem\").value\nval key = readFileSync(\"tests/tls/key.pem\").value\n\nval server = serve({ port: 0, cert: cert, key: key }, (req) -> \"never read\")\n\nasync main()\n    val r = await fetch(\"http://localhost:\" + string(localPort(server)) + \"/\", {})\n\n    print(r.ok)\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(out(watched(text)),
        "false")

@test
A_KEY_THAT_DOES_NOT_GO_WITH_THE_CERTIFICATE_IS_REFUSED_AT_THE_LISTENER()
    // **A key that does not go with the certificate is caught where the listener is made**, and that is
    // the only place it can be: both installs succeed on a mismatched pair, and the handshake then
    // fails at the *client* with a decrypt error that says nothing about this end at all. The key
    // here is a perfectly good one -- from a second certificate generated beside the first -- so what
    // is being caught is the mismatch and not a malformed file.

    val text = "import { serve, close } from slate:http\nimport { readFileSync } from slate:fs\n\nval cert = readFileSync(\"tests/tls/cert.pem\").value\nval wrong = readFileSync(\"tests/tls/other-key.pem\").value\n\ntry\n    close(serve({ port: 0, cert: cert, key: wrong }, (req) -> \"no\"))\n    print(\"accepted\")\n    done()\ncatch e\n    print(\"refused\")\n\ndone()\n"

    assert_eq(out(watched(text)),
        "refused")

// -- `startTls`: the other end of the same machinery ------------------------------------------------
//
// **Every one of these is a real handshake over a real loopback socket**, for the reason the four
// above are: a mocked handshake tests the mock. What differs is only which end asked for it -- the
// server under test up there, and the client down here, against a listener that is itself slate's.
//
// **The client and the server share every line below `tls_accepted`**, so what these are really
// pinning is the three things that are not shared: that somebody produces the ClientHello, that the
// certificate is checked against a name the program gave, and that the promise `startTls` hands out
// is answered however the connection ends.

const SecureEcho: string = "import { readFileSync } from slate:fs\nval theCert = readFileSync(\"tests/tls/cert.pem\").value\nval theKey = readFileSync(\"tests/tls/key.pem\").value\nserve(conn)\n    heard(chunk)\n        if chunk == null\n            close(conn)\n        else\n            send(conn, \"echo: \" + chunk)\n    onData(conn, heard)\nval server = listen({ port: 0, cert: theCert, key: theKey }, serve)\nval port = localPort(server)\n"

@test
startTls_UPGRADES_AN_OPEN_SOCKET_AND_WHAT_GOES_AFTER_IT_IS_ENCRYPTED()
    // **The whole feature, and the shape every protocol that upgrades needs.** The socket is
    // connected in the clear, `startTls` is awaited, and `send` after it is `send` -- the program
    // never learns that its bytes are now records, which is the same seam `listen` gives a server.

    assert_eq(net_out(SecureEcho + "async main()\n    val c = (await connect(\"127.0.0.1\", port)).value\n    reply(chunk)\n        print(chunk)\n        close(c)\n        close(server)\n        done()\n    onData(c, reply)\n    val up = await startTls(c, { host: \"localhost\", trust: theCert })\n    print(up.ok)\n    await send(c, \"hello\")\nmain()"), "true\necho: hello")

@test
A_CERTIFICATE_NOTHING_TRUSTS_IS_REFUSED_AND_THE_PROMISE_CARRIES_THE_REASON()
    // **A promise that settles `ok: false` and not a connection that half works.** This is the case
    // `fetch` already gets right; what is new is that a program driving its own socket is told, in a
    // sentence it can print, rather than finding out as an end of stream it cannot explain.

    assert_eq(net_out(SecureEcho + "async main()\n    val c = (await connect(\"127.0.0.1\", port)).value\n    reply(chunk) = chunk\n    onData(c, reply)\n    val up = await startTls(c, \"localhost\")\n    print(up.ok, up.error.contains(\"certificate\"))\n    close(c)\n    close(server)\n    done()\nmain()"), "false true")

@test
THE_NAME_startTls_IS_GIVEN_IS_WHAT_THE_CERTIFICATE_IS_CHECKED_AGAINST()
    // **The host is not decoration and this is what says so**: the same server, the same trusted
    // certificate, a name that is not on it -- refused. Without the check a valid certificate for any
    // host at all would satisfy the verification, which is the failure that makes TLS worthless
    // rather than the one that makes it noisy.

    assert_eq(net_out(SecureEcho + "async main()\n    val c = (await connect(\"127.0.0.1\", port)).value\n    reply(chunk) = chunk\n    onData(c, reply)\n    val up = await startTls(c, { host: \"example.com\", trust: theCert })\n    print(up.ok, up.error.contains(\"handshake\"))\n    close(c)\n    close(server)\n    done()\nmain()"), "false true")

@test
A_SOCKET_THAT_IS_ALREADY_SECURED_IS_NOT_UPGRADED_TWICE()
    // A second upgrade would give the slot a second stream and lose the first, and the connection
    // would fail some records later with nothing pointing back here.

    assert_eq(net_out(SecureEcho + "async main()\n    val c = (await connect(\"127.0.0.1\", port)).value\n    reply(chunk) = chunk\n    onData(c, reply)\n    startTls(c, { host: \"localhost\", trust: theCert })\n    try\n        startTls(c, { host: \"localhost\", trust: theCert })\n        print(\"accepted\")\n    catch e\n        print(\"refused\")\n    close(c)\n    close(server)\n    done()\nmain()"), "refused")

@test
BYTES_WRITTEN_BEFORE_THE_HANDSHAKE_FINISHED_ARE_QUEUED_AND_NOT_LOST()
    // **The client is what makes the queue ordinary.** A server rarely has anything queued -- it
    // writes from inside a read callback, by which time the handshake is long done -- but a client
    // that does not await `startTls` before writing is the natural way to write this, and the bytes
    // go out when the handshake ends. The promise `send` answered is settled then too, which is why
    // `sent` prints before the echo rather than never.

    assert_eq(net_out(SecureEcho + "async main()\n    val c = (await connect(\"127.0.0.1\", port)).value\n    reply(chunk)\n        print(chunk)\n        close(c)\n        close(server)\n        done()\n    onData(c, reply)\n    startTls(c, { host: \"localhost\", trust: theCert })\n    await send(c, \"early\")\n    print(\"sent\")\nmain()"), "sent\necho: early")

@test
A_HANDSHAKE_THE_PEER_ABANDONS_SETTLES_THE_PROMISE_RATHER_THAN_HANGING()
    // **A promise that never settles is a program that never ends.** The listener here is a plain one
    // that hangs up, which is what a port not speaking TLS does, and the program is told -- where
    // before it would have waited for a ServerHello nobody was going to send.

    assert_eq(net_out("hangUp(conn)\n    close(conn)\nval plain = listen(0, hangUp)\nasync main()\n    val c = (await connect(\"127.0.0.1\", localPort(plain))).value\n    reply(chunk) = chunk\n    onData(c, reply)\n    val up = await startTls(c, \"localhost\")\n    print(up.ok, up.error.contains(\"handshake\"))\n    close(c)\n    close(plain)\n    done()\nmain()"), "false true")

@test
startTls_ON_A_CLOSED_SOCKET_IS_A_COMPLAINT_AND_NOT_A_PROMISE()
    assert(net_fails("val s = listen(0, print)\nclose(s)\nstartTls(s, \"localhost\")").contains("this socket is closed, and `startTls` needs an open one"))

@test
startTls_NEEDS_A_HOST_TO_CHECK_THE_CERTIFICATE_AGAINST()
    // The one field that cannot be defaulted: there is no name to check a certificate against but the
    // one the program was looking for, and the address it happened to dial is not it.

    assert(net_fails("val s = listen(0, print)\nstartTls(s, {})").contains("no `host` in it"))

// -- both ends of an upgrade, and a name to check it against ----------------------------------------
//
// **What these four add is the part `startTls` alone could not reach.** The tests above dial an
// address and check a certificate against a name that was never dialled, which works and is not what
// a program does -- a hosted database is reached by name, and the name is what the certificate says.
// So `connect` resolves now, and the two halves meet here: the name a program dialled is the name its
// certificate is checked against, with nothing carried by hand in between.

@test
A_NAME_IS_DIALLED_AND_THE_SAME_NAME_IS_WHAT_THE_CERTIFICATE_MUST_CARRY()
    // **The shape every hosted service is reached with.** Without a resolver on `connect` a program
    // would arrive here holding an address and have nothing left to verify against -- and the two
    // ways out of that are to trust whatever certificate turns up, or to carry the name alongside the
    // address by hand. Neither is a thing a language should ask for.

    assert_eq(net_out(SecureEcho + "async main()\n    val c = (await connect(\"localhost\", port)).value\n\n    reply(chunk)\n        print(chunk)\n        close(c)\n        close(server)\n        done()\n\n    onData(c, reply)\n\n    val up = await startTls(c, { host: \"localhost\", trust: theCert })\n\n    print(up.ok)\n    await send(c, \"hello\")\n\nmain()"), "true\necho: hello")

@test
AN_ADDRESS_IS_CHECKED_AGAINST_THE_CERTIFICATES_ADDRESSES()
    // **An address verifies, and it verifies against the certificate's `IP` names rather than its DNS
    // ones.** The fixture certificate carries `DNS:localhost` and `IP:127.0.0.1` as separate entries,
    // so this passing says the address was matched as an address -- and the test below says the match
    // is real rather than skipped.

    assert_eq(net_out(SecureEcho + "async main()\n    val c = (await connect(\"127.0.0.1\", port)).value\n\n    reply(chunk) = chunk\n\n    onData(c, reply)\n\n    val up = await startTls(c, { host: \"127.0.0.1\", trust: theCert })\n\n    print(up.ok)\n    close(c)\n    close(server)\n    done()\n\nmain()"), "true")

@test
AN_ADDRESS_THE_CERTIFICATE_DOES_NOT_CARRY_IS_REFUSED()
    // **The other half, and without it the one above is worth nothing** -- a check that cannot fail is
    // not a check. `127.0.0.2` is the same kind of thing as `127.0.0.1` and reaches the same listener;
    // what differs is only that the certificate does not name it.

    assert_eq(net_out(SecureEcho + "async main()\n    val c = (await connect(\"127.0.0.1\", port)).value\n\n    reply(chunk) = chunk\n\n    onData(c, reply)\n\n    val up = await startTls(c, { host: \"127.0.0.2\", trust: theCert })\n\n    print(up.ok, up.error.contains(\"certificate verify failed\"))\n    close(c)\n    close(server)\n    done()\n\nmain()"), "false true")

const NegotiatedEcho: string = "import { readFileSync } from slate:fs\n\nval theCert = readFileSync(\"tests/tls/cert.pem\").value\nval theKey = readFileSync(\"tests/tls/key.pem\").value\n\nserve(conn)\n    var secured = false\n\n    heard(chunk)\n        if chunk == null then return\n\n        if secured\n            send(conn, \"echo: \" + chunk)\n        else\n            secured = true\n\n            send(conn, \"S\")\n            startTls(conn, { cert: theCert, key: theKey })\n\n    onData(conn, heard)\n\nval server = listen(0, serve)\nval port = localPort(server)\n"

@test
A_SERVER_UPGRADES_ITS_END_TOO_WHICH_IS_WHAT_A_NEGOTIATED_PROTOCOL_NEEDS()
    // **PostgreSQL's shape, and SMTP's, and IMAP's.** The client asks in the clear, the server answers
    // one byte in the clear, and only then does either speak TLS -- so a server that could only be
    // secured by `listen` could not implement any of them, and a program writing that half in slate
    // would have had to stop.
    //
    // **The listener here is a PLAIN one**, which is the whole point: the certificate arrives on a
    // connection that is already open and already carrying bytes.

    assert_eq(net_out(NegotiatedEcho + "async main()\n    val c = (await connect(\"localhost\", port)).value\n    var secured = false\n\n    async secure()\n        val up = await startTls(c, { host: \"localhost\", trust: theCert })\n\n        print(up.ok)\n        await send(c, \"hello\")\n\n    reply(chunk)\n        if chunk == null then return\n\n        if secured\n            print(chunk)\n            close(c)\n            close(server)\n            done()\n        else\n            print(\"answered \" + chunk)\n\n            secured = true\n\n            secure()\n\n    onData(c, reply)\n    await send(c, \"SSLRequest\")\n\nmain()"), "answered S\ntrue\necho: hello")

@test
A_SERVER_UPGRADE_WITH_A_KEY_THAT_DOES_NOT_GO_WITH_THE_CERTIFICATE_SETTLES_THE_PROMISE()
    // The listener catches this when it is made; a connection has no such moment, so the promise
    // carries it. Both installs succeed on a mismatched pair, which is why the pair is checked at all
    // rather than left to fail at the far end as a decrypt error naming nothing.

    assert_eq(net_out("import { readFileSync } from slate:fs\n\nval theCert = readFileSync(\"tests/tls/cert.pem\").value\nval wrongKey = readFileSync(\"tests/tls/other-key.pem\").value\n\nserve(conn)\n    async upgrade()\n        val up = await startTls(conn, { cert: theCert, key: wrongKey })\n\n        print(up.ok, up.error.contains(\"certificate and key\"))\n        close(conn)\n        close(server)\n        done()\n\n    onData(conn, (chunk) -> chunk)\n    upgrade()\n\nval server = listen(0, serve)\n\nasync main()\n    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n\n    onData(c, (chunk) -> chunk)\n    await send(c, \"hi\")\n\nmain()"), "false true")

@test
A_SERVER_UPGRADE_NEEDS_BOTH_HALVES_OF_THE_PAIR()
    assert(net_fails("val s = listen(0, print)\nstartTls(s, { cert: \"not a certificate\" })").contains("securing this needs `key`"))

// -- ALPN, which is how HTTP/2 is chosen ------------------------------------------------------------

// A secured listener that OFFERS protocols, and answers with the one it settled on.
const AlpnEcho: string = "import { readFileSync } from slate:fs\n\nval theCert = readFileSync(\"tests/tls/cert.pem\").value\nval theKey = readFileSync(\"tests/tls/key.pem\").value\n\nserve(conn)\n    heard(chunk)\n        if chunk == null then return\n\n        send(conn, \"server sees \" + string(alpnProtocol(conn)))\n\n    onData(conn, heard)\n\nval server = listen({ port: 0, cert: theCert, key: theKey, alpn: [\"h2\", \"http/1.1\"] }, serve)\nval port = localPort(server)\n"

@test
A_CLIENT_OFFERS_PROTOCOLS_AND_BOTH_ENDS_READ_WHAT_WAS_AGREED()
    // **HTTP/2 over TLS is chosen by ALPN and by nothing else** -- no upgrade handshake, no version
    // header -- so a server that takes both versions on one port cannot tell them apart without
    // this. The client offers, the server picks from its OWN preference order, and both ends read
    // the answer off the connection.

    assert_eq(net_out(AlpnEcho + "async main()\n    val c = (await connect(\"localhost\", port)).value\n\n    reply(chunk)\n        print(chunk)\n        print(\"client sees\", alpnProtocol(c))\n        close(c)\n        close(server)\n        done()\n\n    onData(c, reply)\n\n    val up = await startTls(c, { host: \"localhost\", trust: theCert, alpn: [\"h2\", \"http/1.1\"] })\n\n    print(up.ok)\n    await send(c, \"hello\")\n\nmain()"),
        "true\nserver sees h2\nclient sees h2")

@test
THE_SERVERS_OWN_ORDER_DECIDES_AND_NOT_THE_CLIENTS()
    // **The end that knows which protocol it serves well is the server**, so its list is the one
    // that ranks. A client asking for `http/1.1` first still gets `h2` here, because the listener
    // above named `h2` first.

    assert_eq(net_out(AlpnEcho + "async main()\n    val c = (await connect(\"localhost\", port)).value\n\n    reply(chunk)\n        print(chunk)\n        close(c)\n        close(server)\n        done()\n\n    onData(c, reply)\n    await startTls(c, { host: \"localhost\", trust: theCert, alpn: [\"http/1.1\", \"h2\"] })\n    await send(c, \"hello\")\n\nmain()"),
        "server sees h2")

@test
A_CONNECTION_THAT_NEGOTIATED_NOTHING_ANSWERS_null()
    // **`null` is an ordinary answer and not a failure**, and it covers three cases a program meets:
    // a plain socket, a peer that offered nothing, and a handshake that has not finished. A client
    // that names no protocols is the middle one, and the connection is perfectly good.

    assert_eq(net_out(AlpnEcho + "async main()\n    val c = (await connect(\"localhost\", port)).value\n\n    reply(chunk)\n        print(chunk)\n        close(c)\n        close(server)\n        done()\n\n    onData(c, reply)\n    await startTls(c, { host: \"localhost\", trust: theCert })\n    await send(c, \"hello\")\n\nmain()"),
        "server sees null")

    // A socket with no TLS on it at all says the same thing, rather than faulting.
    assert_eq(net_out("serve(conn)\n    print(alpnProtocol(conn))\n    close(conn)\n    close(server)\n    done()\n\nval server = listen(0, serve)\n\nasync main()\n    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n\n    await send(c, \"hi\")\n\nmain()"),
        "null")

@test
A_WHOLE_HTTP_2_REQUEST_TRAVELS_OVER_TLS_AND_ALPN_IS_WHAT_CHOSE_IT()
    // **The proof that the three pieces are one feature**: `slate:net` negotiates `h2`, `slate:nghttp2`
    // frames what goes over it, and neither knows the other exists -- a session is bytes in and bytes
    // out, so the socket is the program's own business.
    //
    // **Both ends are written in slate here**, which is what makes it a round trip rather than a
    // parse: the server reads a request off frames it was handed and answers one on the same stream.
    val prog = "import { h2Client, h2Server, h2Receive, h2Send, h2Next, h2Request, h2Respond, h2Close } from slate:nghttp2\nimport { readFileSync } from slate:fs\n\n" +
        "val theCert = readFileSync(\"tests/tls/cert.pem\").value\nval theKey = readFileSync(\"tests/tls/key.pem\").value\n\n" +
        "serve(conn)\n" +
        "    val s = h2Server()\n\n" +
        "    flush()\n" +
        "        val out = h2Send(s)\n\n" +
        "        if len(out) > 0 then send(conn, out)\n\n" +
        "    heard(chunk)\n" +
        "        if chunk == null then return\n\n" +
        "        h2Receive(s, chunk)\n\n" +
        "        loop\n" +
        "            val e = h2Next(s)\n\n" +
        "            if e == null then break\n\n" +
        "            if e.kind == \"headers\" && e.of == \"request\"\n" +
        "                var path = \"?\"\n\n" +
        "                for h in e.headers\n" +
        "                    if h[0] == \":path\" then path = h[1]\n\n" +
        "                h2Respond(s, e.stream, { \":status\": \"200\" }, \"answered \" + path + \" over \" + string(alpnProtocol(conn)))\n\n" +
        "        flush()\n\n" +
        "    onBytes(conn, heard)\n" +
        "    flush()\n\n" +
        "val server = listen({ port: 0, cert: theCert, key: theKey, alpn: [\"h2\", \"http/1.1\"] }, serve)\n\n" +
        "async main()\n" +
        "    val c = (await connect(\"localhost\", localPort(server))).value\n" +
        "    val h = h2Client()\n\n" +
        "    pump()\n" +
        "        val out = h2Send(h)\n\n" +
        "        if len(out) > 0 then send(c, out)\n\n" +
        "    var body = \"\"\n\n" +
        "    arrived(chunk)\n" +
        "        if chunk == null then return\n\n" +
        "        h2Receive(h, chunk)\n\n" +
        "        loop\n" +
        "            val e = h2Next(h)\n\n" +
        "            if e == null then break\n\n" +
        "            if e.kind == \"data\" then body = body + fromBytes(e.bytes).value\n\n" +
        "            if e.kind == \"streamClose\"\n" +
        "                print(body)\n" +
        "                h2Close(h)\n" +
        "                close(c)\n" +
        "                close(server)\n" +
        "                done()\n" +
        "                return\n\n" +
        "        pump()\n\n" +
        "    onBytes(c, arrived)\n\n" +
        "    await startTls(c, { host: \"localhost\", trust: theCert, alpn: [\"h2\"] })\n\n" +
        "    print(\"negotiated\", alpnProtocol(c))\n\n" +
        "    h2Request(h, { \":method\": \"GET\", \":scheme\": \"https\", \":authority\": \"localhost\", \":path\": \"/things\" })\n" +
        "    pump()\n\n" +
        "main()"

    assert_eq(net_out(prog), "negotiated h2\nanswered /things over h2")

// `slate:http` ITSELF SPEAKING HTTP/2, which is the piece the three modules above were built for.
//
// **The handler is written once and answers over either version.** What decides is ALPN, and the
// server asks it at the FIRST BYTE rather than at accept -- a connection callback fires when TCP
// accepts, which is before the TLS handshake has said anything, so `alpnProtocol` there answers
// `null` on a connection that is about to be `h2`.
const H2Server: string = raw"""
    import { serve, close, router } from slate:http
    import { h2Client, h2Receive, h2Send, h2Next, h2Request, h2Close } from slate:nghttp2
    import { readFileSync } from slate:fs

    val theCert = readFileSync("tests/tls/cert.pem").value
    val theKey = readFileSync("tests/tls/key.pem").value

    val app = router()

    app.get("/notes/:id", (req) -> "note " + req.params.id + " for " + req.headers.host + " x=" + req.query.x)
    app.post("/notes", (req) -> { status: 201, headers: { "Content-Type": "application/json" }, body: req.body })
    app.notFound((req) -> { status: 404, body: "nothing at " + req.path })

    val server = serve({ port: 0, cert: theCert, key: theKey, alpn: ["h2", "http/1.1"] }, app)
    val site = "https://localhost:" + string(localPort(server))
    """

@test
slate_http_ANSWERS_OVER_HTTP_2_WHEN_ALPN_SAYS_SO()
    // **The same router, the same handler, the same reply forms** -- what differs is the framing and
    // nothing a program wrote. The `:authority` arrives as `host`, so a handler reading it does not
    // have to know which version it was spoken to over.
    val prog = H2Server + raw"""

    async main()
        val c = (await connect("localhost", localPort(server))).value
        val h = h2Client()

        pump()
            val out = h2Send(h)

            if len(out) > 0 then send(c, out)

        var seen = 0
        var body = ""
        var status = ""

        arrived(chunk)
            if chunk == null then return

            h2Receive(h, chunk)

            loop
                val e = h2Next(h)

                if e == null then break

                if e.kind == "headers" then status = e.headers[0][1]

                if e.kind == "data" then body = body + fromBytes(e.bytes).value

                if e.kind == "streamClose"
                    print(status, body)

                    body = ""
                    seen = seen + 1

                    if seen == 2
                        h2Close(h)
                        close(c)
                        close(server)
                        done()

                        return

            pump()

        onBytes(c, arrived)

        await startTls(c, { host: "localhost", trust: theCert, alpn: ["h2"] })

        h2Request(h, { ":method": "GET", ":scheme": "https", ":authority": "localhost", ":path": "/notes/7?x=1" })
        h2Request(h, { ":method": "POST", ":scheme": "https", ":authority": "localhost", ":path": "/notes" }, "{\"t\":1}")
        pump()

    main()
    """

    assert_eq(net_out(prog), "200 note 7 for localhost x=1\n201 {\"t\":1}")

@test
THE_SAME_LISTENER_ANSWERS_HTTP_1_1_AND_THE_ANSWER_IS_THE_SAME()
    // **A client that offers no ALPN gets `http/1.1`**, which is `null` from `alpnProtocol` read the
    // only way there is to read it -- and the llhttp path is untouched.
    val prog = H2Server + raw"""

    async main()
        val r = await fetch(site + "/notes/7?x=1", { trust: theCert })
        val gone = await fetch(site + "/nowhere", { trust: theCert })

        print(r.value.status, r.value.body)
        print(gone.value.status, gone.value.body)

        close(server)
        done()

    main()
    """

    assert_eq(net_out(prog), "200 note 7 for localhost x=1\n404 nothing at /nowhere")

@test
A_STREAMED_BODY_IS_REFUSED_OVER_HTTP_2_RATHER_THAN_DRAINED()
    // **Draining would turn an endpoint whose source never ends into a request that hangs forever**,
    // and nothing on the client could diagnose it. `sh.sysl.nghttp2` has no data provider, so there
    // is nothing to write a frame at a time with; the refusal names the limitation and the way out.
    val prog = H2Server + raw"""

    counting()
        yield "one "
        yield "two"

    app.get("/count", (req) -> counting())

    async main()
        val c = (await connect("localhost", localPort(server))).value
        val h = h2Client()

        pump()
            val out = h2Send(h)

            if len(out) > 0 then send(c, out)

        var body = ""
        var status = ""

        arrived(chunk)
            if chunk == null then return

            h2Receive(h, chunk)

            loop
                val e = h2Next(h)

                if e == null then break

                if e.kind == "headers" then status = e.headers[0][1]

                if e.kind == "data" then body = body + fromBytes(e.bytes).value

                if e.kind == "streamClose"
                    print(status, body)

                    h2Close(h)
                    close(c)
                    close(server)
                    done()

                    return

            pump()

        onBytes(c, arrived)

        await startTls(c, { host: "localhost", trust: theCert, alpn: ["h2"] })

        h2Request(h, { ":method": "GET", ":scheme": "https", ":authority": "localhost", ":path": "/count" })
        pump()

    main()
    """

    // **The client is told and the fault is put back**, so the run ends on the defect -- which is
    // what `net_fails` reads. What the client saw is printed above it and is asserted separately,
    // the two channels being separate.
    val said = net_fails(prog)

    assert(said.contains("a streamed body needs HTTP/1.1"))
    assert(said.contains("offer only \"http/1.1\" in `alpn`"))
