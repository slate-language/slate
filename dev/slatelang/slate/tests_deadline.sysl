module dev.slatelang.slate
@tests

// `slate:http`'s two deadlines -- `headMillis` on a request's head and `requestMillis` on the whole of
// it -- held against the written answer.
//
// **`tests/js/p57.sl` is the program, and the differential corpus runs it on both back ends**, which
// says the two agree and nothing more: two readings of one tree that shared a mistake would agree
// about it. This runs the same file through the interpreter and compares it with what it must say,
// so a server that never cut anybody fails here even if node's never did either.

// What one server says, under its name.
private held_to(name: string) -> string =
    name + " a slow head 408 closed true\n" +
        name + " a head in time 200\n" +
        name + " a kept connection 200,200 closed false\n" +
        name + " a pipelined slow head 200,408 closed true\n" +
        name + " a slow upload 200 true\n" +
        name + " a slow body 408 closed true"

@test
A_HEAD_SENT_ONE_BYTE_AT_A_TIME_IS_CUT_AT_ITS_DEADLINE_AND_A_SLOW_UPLOAD_IS_NOT()
    assert_eq(cli_said(["slate", "tests/js/p57.sl"]),
        "before a byte false\n" +
            "part way through a head true\n" +
            "after the blank line false\n" +
            "in a body false\n" +
            "a pipelined head true\n" +
            "refused 400\n" +
            "after a refusal false\n" +
            "`httpHeading` asks a parser made by `httpParser`; a streaming parser hands its head over as a part\n" +
            "`httpHeading` takes a parser, and this is a string\n" +
            "`headMillis` is a number of milliseconds above nought, and this is soon\n" +
            "`requestMillis` is a number of milliseconds above nought, and this is 0\n" +
            held_to("serve") + "\n" + held_to("serveStream"))
