module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// The `new` a class or a data variant ends up with, and the object it answers.
//
// **Split out of `declare.sysl` at the seam with the fewest crossings.** Everything here is reached
// through one name, `make_constructor`, called once for a class and once for each variant, and it
// reads back across for two: the `ClassBody` the members were gathered into, and `checked_value`,
// which a field's annotation shares with a written assignment. Cutting instead at the `data` half or
// at the member readers crossed seven names each, most of them the member readers a variant body
// reuses. What is left in `declare.sysl` is the reading of the declarations; what is here is what
// they are turned into once read.
//
// **A subclass is built through its base AT RUN TIME, which is JavaScript's rule.** `from` takes an
// expression -- an import, a module member, a base chosen while the program runs -- so nothing here
// may assume it can see the base's fields. What crosses instead is two values every class carries,
// `(inits)` and `(target)` (`InitsTag` in `value.sysl`): a subclass with no `new` of its own hands
// its arguments to the base's `new` with `(target)` naming the subclass, and one that writes its own
// `new` starts from the object the base's `(inits)` answers.

// The name a constructor holds the object under while it is being made.
//
// **Unspellable on purpose**, for the reason a destructured parameter's is: the names in a body are
// the program's, and a synthetic one that could be written would shadow something a person wrote.
private const Made: string = "(new)"

// The class this construction is building, taken off the class's `(target)` on the way in.
private const Target: string = "(target)"

// What `from` named, read back off the class's own `proto`, and the arguments a subclass with no
// `new` of its own hands on to it.
private const Base: string = "(base)"

private const Handed: string = "(args)"

// What a subclass's own initialised fields came to, in a subclass whose object its base made.
private const Own: string = "(own)"

// The object a constructor answers: every declared field it can fill, and `proto` as its proto.
//
// **The initialiser is the EXPRESSION, put here rather than evaluated once**, which is the whole of
// what `var` buys over `val`: `var tags = []` gives every object its own array, and the same words
// under `val` would have given them all one.
//
// `assigned` names the fields a parameter supplies. Anything else with an initialiser takes it, and a
// field with neither is simply absent -- which is what a dynamically typed language has instead of
// TypeScript's definite-assignment check, and it faults at the first read rather than at the make.
//
// **A generated constructor names every field, so that middle case is a written `new(var w, var h)`
// and nothing else**: there, the fields the parameter list did not name are filled from their own
// declarations. A generated one carries each initialiser as that parameter's default instead, which
// runs in the head of the chunk and is the same expression evaluated the same number of times.
// **`seal` makes the object a DATA VALUE**, which is a variant's instance and nothing else. It is a
// parameter rather than two functions because everything else about building one is the same: the
// fields a parameter supplies, the initialisers, and the class as the proto.
private instance_of(b: *ClassBody, assigned: Buf[string], at: Span, seal: bool, proto: Expr) -> Expr
    var keys: Buf[string] = buf()
    var key_spans: Buf[Span] = buf()
    var values: Buf[Expr] = buf()

    for i in 0..<b.fields.len()
        val f = b.fields.at(i)
        var taken = false

        for j in 0..<assigned.len()
            if assigned.at(j) == f then taken = true

        if taken
            keys.push(f)
            key_spans.push(b.field_spans.at(i))
            values.push(expr(b.field_spans.at(i), Name(f)))
        elif b.has_init.at(i)
            keys.push(f)
            key_spans.push(b.field_spans.at(i))

            // A field a written `new` does not take is filled from its initialiser, and an annotated
            // one is checked there -- a taken one is a parameter, which checks its own.
            values.push(b.field_checks.at(i) match
                Some(c) -> checked_value(f, b.inits.at(i), c)
                None -> b.inits.at(i))

    keys.push("proto")
    key_spans.push(at)
    values.push(proto)

    val made = expr(at, ObjectLit(keys, key_spans, values))

    if seal then expr(at, DataLit(made)) else made
end instance_of

// The `new` a class ends up with: the one it wrote, or the one its field declarations imply.
//
// Not `private`: `declare.sysl` calls it once a class body or a variant body has been read, which is
// the one way in to this file. `derived` is whether the class said `from`.
make_constructor(p: *Parser, cls: string, b: *ClassBody, at: Span, seal: bool, derived: bool)
    // **Every class that could be a base says what its initialised fields come to**, since which
    // classes are bases is not known here: a file that imports this one may descend from it.
    if !seal then add_inits(b, cls, at, derived)

    if !b.has_maker
        if derived && !seal
            subclass_maker(b, cls, at)
            return

        // **A class that declares nothing gets no constructor**, rather than one answering an object
        // with nothing in it. `{ proto: Square }` compiles, runs, and faults later at the first field
        // nobody set, which moves the complaint away from the mistake -- and `{ side: 4, proto: Square }`
        // is still how such a class is instantiated, exactly as it was before classes existed.
        if b.fields.len() == 0 then return

        val params = field_params(b)

        // Every parameter here IS a field, so the whole list is what a positional pattern names.
        b.ctor_fields = params
        b.ctor_positional = true

        add_maker(b, at, params, generated_maker(b, at, seal, params, expr(at, Name(cls))))
        return
    end if

    var assigned: Buf[string] = buf()

    for i in 0..<b.maker_declares.len()
        if b.maker_declares.at(i) then assigned.push(b.maker_params.at(i))

    if assigned.len() != 0
        // `new(var side)`: the object is made from the declarations, and the body runs for its effect
        // with `self` bound to what is being made. That is TypeScript's constructor, and it is the
        // one shape where a body has an object to talk about -- an ordinary `new` is called before
        // there is one, which is why it is handed no receiver.
        var stmts = taking_target(b, cls, b.maker_at)

        // **The names are known here whatever else the constructor takes, and the POSITIONS are only
        // known where it takes nothing else.** A positional pattern promises that it binds what the
        // call sets: `new(var x, scale)` takes two arguments and makes an object with one field, so
        // `Point(a, b)` could not mean what `Point.new(a, b)` means. Naming `x` is still exact, so
        // the named form stays available and `resolve_pattern` carries the message for the other.
        b.ctor_fields = assigned
        b.ctor_positional = assigned.len() == b.maker_params.len()

        // **A subclass's object starts as what its bases' initialisers make**, and its own fields go
        // on after them -- so a base field is there with its initialiser's value, and one the base
        // left without an initialiser is absent, exactly as it would be on the base's own object.
        val own = instance_of(b, assigned, b.maker_at, seal, expr(b.maker_at, Name(Target)))
        val made = if derived then expr(b.maker_at, WithAll(base_inits(cls, b.maker_at), own, false)) else own

        stmts.push(stmt(b.maker_at, Val(Made, made)))
        stmts.push(stmt(b.maker_at, Val("self", expr(b.maker_at, Name(Made)))))
        stmts.push(stmt(b.maker_at, Eval(body_at(b.maker_body))))
        stmts.push(stmt(b.maker_at, Eval(expr(b.maker_at, Name(Made)))))

        add_maker(b, b.maker_at, b.maker_params, expr(b.maker_at, Lambda(b.maker_params, b.maker_defaults, intern_body(expr(b.maker_at, Block(stmts)), false), false)))
        return
    end if

    if b.fields.len() != 0
        p.fault(b.maker_at, s"class `${cls}` declares fields with `var`, so its `new` has to name the ones it takes -- `new(var ${b.fields.at(0)})` declares and assigns in one place, and the rest are filled from their own declarations. A `new` that builds the object itself leaves nothing to fill them")

    // The plain form, which is what a class with no declared fields has: the body's value is the
    // object, and it is given the class as its proto on the way out. **It is written to rather than
    // copied** -- `with` would have said the same thing in one node and allocated a second object for
    // every instance, on the one path where allocation is measured. A subclass's is the exception: its
    // bases' initialised fields are laid under what the body answered, which is a copy.
    var stmts = taking_target(b, cls, b.maker_at)
    val body = body_at(b.maker_body)
    val made = if derived then expr(b.maker_at, WithAll(base_inits(cls, b.maker_at), body, false)) else body

    stmts.push(stmt(b.maker_at, Val(Made, made)))
    stmts.push(stmt(b.maker_at, Assign(Tok.Assign, field_of(b.maker_at, Made, "proto"), expr(b.maker_at, Name(Target)))))
    stmts.push(stmt(b.maker_at, Eval(expr(b.maker_at, Name(Made)))))

    add_maker(b, b.maker_at, b.maker_params, expr(b.maker_at, Lambda(b.maker_params, b.maker_defaults, intern_body(expr(b.maker_at, Block(stmts)), false), false)))
end make_constructor

// **Every declared field is a parameter: the ones with no initialiser first, then the ones with,
// each carrying its initialiser as its default.** A field the class gives a value may therefore be
// given another one at the call, which is what `Box.new(7, ["a"])` reads as in every language that
// has this; and leaving it out means exactly what it meant before, since a default is worked out at
// the call and so runs once per object.
//
// **Where an initialised field was declared first, the parameter order is NOT the declaration
// order**, a default having to be trailing: `var kind = "plain"` above `var side` gives
// `new(side, kind = "plain")`. The alternative was to refuse that class the way Python refuses the
// same shape in a dataclass, which would break classes that compile today to buy a rule nobody
// asked for.
//
// **An initialiser may read a field to its left in that order**, because the defaults are bound in
// order like any others -- so `var w` then `var area = w * w` works.
private field_params(b: *ClassBody) -> Buf[string]
    var params: Buf[string] = buf()

    for i in 0..<b.fields.len()
        if !b.has_init.at(i) then params.push(b.fields.at(i))

    for i in 0..<b.fields.len()
        if b.has_init.at(i) then params.push(b.fields.at(i))

    params
end field_params

// The generated constructor: every field a parameter, an initialiser its default, `proto` the
// object's proto.
//
// **An annotated field is an annotated PARAMETER here**, its check at the top of the body exactly
// where `new(n: integer)` would have put it -- so a default is checked too, being bound before the
// body runs.
private generated_maker(b: *ClassBody, at: Span, seal: bool, params: Buf[string], proto: Expr) -> Expr
    var defaults: Buf[Expr] = buf()
    var checks: Buf[Stmt] = buf()

    for i in 0..<b.fields.len()
        if b.has_init.at(i) then defaults.push(b.inits.at(i))

    for i in 0..<b.fields.len()
        b.field_checks.at(i) match
            Some(c) -> checks.push(c)
            None -> ()

    expr(at, Lambda(params, defaults, intern_body(with_checks(checks, instance_of(b, params, at, seal, proto)), false), false))
end generated_maker

// The `new` a subclass that wrote none is given, which is JavaScript's: it hands its arguments to
// the base's `new` unchanged, so a base's parameters, defaults and hand-written body all run, and
// `self` in that body is already the subclass's instance. Its own initialised fields go on after.
//
// ```
// new(...(args))
//     val (target) = C.(target) ?? C
//     C.(target) = null
//     val (base) = C.proto
//     val (new) = if "new" in (base)
//         if "(target)" in (base) then (base).(target) = (target)
//         val (new) = (base)(...(args))
//         (new).proto = (target)
//         <each initialised field of C's own, set on (new)>
//         (new)
//     else <C's own fields taken by position, as a class with no base takes them>
//     (new)
// ```
//
// **A base with no `new` makes this an ordinary class**: its own fields are its parameters, as they
// would be with no `from` at all -- `class Square from Shape` with `var side` over a `Shape` that
// declares only methods. A subclass with no fields of its own over such a base has nothing to make,
// and says so.
//
// **Its positional pattern names its OWN fields and none of its bases'**: what the class declared is
// what `Square(s)` binds, whichever branch made the object.
private subclass_maker(b: *ClassBody, cls: string, at: Span)
    val params = field_params(b)

    b.ctor_fields = params
    b.ctor_positional = true

    var stmts = taking_target(b, cls, at)

    stmts.push(stmt(at, Val(Base, field_of(at, cls, "proto"))))

    var through: Buf[Stmt] = buf()
    var set_target: Buf[Stmt] = buf()

    set_target.push(stmt(at, Assign(Tok.Assign, field_of(at, Base, TargetTag), expr(at, Name(Target)))))
    through.push(stmt(at, Eval(expr(at, IfExpr(member_test(at, TargetTag, Base), expr(at, Block(set_target)), None)))))

    var handed: Buf[Expr] = buf()

    handed.push(expr(at, Spread(expr(at, Name(Handed)))))
    through.push(stmt(at, Val(Made, expr(at, Call(expr(at, Name(Base)), handed, false)))))
    through.push(stmt(at, Assign(Tok.Assign, field_of(at, Made, "proto"), expr(at, Name(Target)))))

    // **The subclass's own initialisers run once the base has made the object**, so a field both
    // declare ends with the subclass's value -- the TypeScript order, a derived class's field
    // initialisers running after `super()` returns.
    var initialised: Buf[string] = buf()

    for i in 0..<b.fields.len()
        if b.has_init.at(i) then initialised.push(b.fields.at(i))

    if initialised.len() != 0
        through.push(stmt(at, Val(Own, own_inits(b, at))))

        for i in 0..<initialised.len()
            val f = initialised.at(i)

            through.push(stmt(at, Assign(Tok.Assign, field_of(at, Made, f), field_of(at, Own, f))))

    through.push(stmt(at, Eval(expr(at, Name(Made)))))

    val alone = made_alone(b, cls, at, params)

    stmts.push(stmt(at, Val(Made, expr(at, IfExpr(member_test(at, "new", Base), expr(at, Block(through)), Some(alone))))))
    stmts.push(stmt(at, Eval(expr(at, Name(Made)))))

    var rest: Buf[string] = buf()

    rest.push(marked_rest(Handed))
    add_maker(b, at, rest, expr(at, Lambda(rest, buf(), intern_body(expr(at, Block(stmts)), false), false)))
end subclass_maker

// A subclass over a base with no `new`: its own fields by position, as a class with no base takes
// them, or a refusal where it has none.
private made_alone(b: *ClassBody, cls: string, at: Span, params: Buf[string]) -> Expr
    if b.fields.len() == 0
        var refused: Buf[Stmt] = buf()

        refused.push(stmt(at, Throw(expr(at, StrLit(s"class `${cls}` has nothing to make -- it declares no fields and writes no `new`, and what it comes from has no `new` either. Give it a field with `var`, write a `new`, or make one with `{ proto: ${cls} }`")))))

        return expr(at, Block(refused))

    var spread: Buf[Expr] = buf()

    spread.push(expr(at, Spread(expr(at, Name(Handed)))))
    expr(at, Call(generated_maker(b, at, false, params, expr(at, Name(Target))), spread, false))
end made_alone

// `(inits)`: a function answering an object of every initialised field this class and its bases
// declare, the bases' first. A class with none of its own carries none, and a lookup of it finds
// its base's up the chain -- which is the same answer.
private add_inits(b: *ClassBody, cls: string, at: Span, derived: bool)
    var any = false

    for i in 0..<b.has_init.len()
        if b.has_init.at(i) then any = true

    if !any then return

    val own = own_inits(b, at)
    val all = if derived then expr(at, WithAll(base_inits(cls, at), own, false)) else own

    b.keys.push(InitsTag)
    b.key_spans.push(at)
    b.values.push(expr(at, Lambda(buf(), buf(), intern_body(all, false), false)))
end add_inits

// The object of this class's own initialised fields, each worked out as the generated constructor
// works it out: in order, as a default, so an initialiser may read a field to its left. **A field
// with no initialiser is a parameter nobody gives**, so an initialiser that reads one reads an
// absence and faults where it is used, which is what the object would have said about it anyway.
private own_inits(b: *ClassBody, at: Span) -> Expr
    val params = field_params(b)
    var defaults: Buf[Expr] = buf()
    var keys: Buf[string] = buf()
    var key_spans: Buf[Span] = buf()
    var values: Buf[Expr] = buf()
    var checks: Buf[Stmt] = buf()

    for i in 0..<b.fields.len()
        if !b.has_init.at(i) then defaults.push(expr(b.field_spans.at(i), UndefinedLit))

    for i in 0..<b.fields.len()
        if b.has_init.at(i)
            defaults.push(b.inits.at(i))
            keys.push(b.fields.at(i))
            key_spans.push(b.field_spans.at(i))
            values.push(expr(b.field_spans.at(i), Name(b.fields.at(i))))

            b.field_checks.at(i) match
                Some(c) -> checks.push(c)
                None -> ()

    val made = with_checks(checks, expr(at, ObjectLit(keys, key_spans, values)))

    expr(at, Call(expr(at, Lambda(params, defaults, intern_body(made, false), false)), buf(), false))
end own_inits

// What the bases' initialisers make, or an empty object where the base carries no `(inits)` -- a
// plain object, or a class none of whose fields has one.
private base_inits(cls: string, at: Span) -> Expr
    val base = field_of(at, cls, "proto")

    expr(at, IfExpr(expr(at, Binary(Tok.In, expr(at, StrLit(InitsTag)), base)),
        expr(at, Call(expr(at, Field(field_of(at, cls, "proto"), InitsTag, false)), buf(), false)),
        Some(expr(at, ObjectLit(buf(), buf(), buf())))))
end base_inits

// The first two statements of every `new` a base's subclass can be built through: the class being
// made, and the class's `(target)` put back. **Taken back before anything else runs**, so an object
// of the same class made inside the body is that class's own and not the subclass's.
//
// The class also gets its `(target)` field here, `null` until a subclass's `new` sets it.
private taking_target(b: *ClassBody, cls: string, at: Span) -> Buf[Stmt]
    b.keys.push(TargetTag)
    b.key_spans.push(at)
    b.values.push(expr(at, NullLit))

    var stmts: Buf[Stmt] = buf()

    stmts.push(stmt(at, Val(Target, expr(at, Binary(Tok.QQ, field_of(at, cls, TargetTag), expr(at, Name(cls)))))))
    stmts.push(stmt(at, Assign(Tok.Assign, field_of(at, cls, TargetTag), expr(at, NullLit))))
    stmts
end taking_target

private member_test(at: Span, key: string, holder: string) -> Expr =
    expr(at, Binary(Tok.In, expr(at, StrLit(key)), expr(at, Name(holder))))

private field_of(at: Span, holder: string, name: string) -> Expr =
    expr(at, Field(expr(at, Name(holder)), name, false))

private add_maker(b: *ClassBody, at: Span, params: Buf[string], value: Expr)
    b.keys.push("new")
    b.key_spans.push(at)
    b.values.push(value)
end add_maker

// The statement a class declaration becomes: the object bound under the class's name, and its
// promises checked.
//
// Not `private`: `declare.sysl` calls it once a class body has been read.
class_statement(name: string, made: Expr, span: Span, promised: Buf[string], promises: Buf[Pattern]) -> Stmt
    if promises.len() == 0 then return stmt(span, Val(name, made))

    // **The object is bound UNDER THE CLASS'S OWN NAME inside a block, checked there, and answered.**
    // Naming the temporary after the class is the whole trick: `CheckType` reads the name out of the
    // scope and puts it in its complaint, so what a reader gets is *"`Square` was declared Drawable,
    // and was given ..."* rather than a sentence about an unspellable binding. The block's value is
    // the object, which the outer `val` binds where the class really lives.
    var checked: Buf[Stmt] = buf()

    checked.push(stmt(span, Val(name, made)))

    for i in 0..<promises.len()
        checked.push(stmt(promises.at(i).span, CheckType(name, promised.at(i), promises.at(i))))

    checked.push(stmt(span, Eval(expr(span, Name(name)))))

    stmt(span, Val(name, expr(span, Block(checked))))
end class_statement
