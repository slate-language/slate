module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.str_builder

// Compiling: what a whole module comes to, what a declared type resolves to, and which module a
// written path names.
//
// **The STATEMENTS are in `compile_stmt.sysl` and the expressions in `compile_expr.sysl`**, this
// file holding the entry points and the type machinery both of them stand on. Three names cross to
// the statements -- `emit_pattern_defaults`, `refuse_optionals` and `module_index` -- and nothing
// comes back the other way; `compiling_source` stays `private` because everything that reads it,
// `module_want` included, is here.

// -- entry ----------------------------------------------------------------------------------------

// Which file is being compiled, as an index into the unit's sources.
//
// **Module storage, for the same reason `current_source` is**: a chunk is made deep inside
// `compile_expr`, which has no business carrying a file down to it, and the answer is the same for
// everything one call to `compile_module` emits. The machine's copy is the run-time twin of this.
private var compiling_source: usize = 0

// -- types -----------------------------------------------------------------------------------------

// Every type any module has declared so far, and where.
//
// **Filled as each module compiles, which is why no pre-pass is needed**: modules are compiled in
// post-order, so by the time a file that imports something is compiled, everything it imports has
// already registered whatever it declared.
private var known_source: Buf[usize] = buf()
private var known_name: Buf[string] = buf()
private var known_pat: Buf[Pattern] = buf()
private var known_public: Buf[bool] = buf()

// The types the file being compiled may name: its own, and the exported ones it imported.
private var visible_names: Buf[string] = buf()
private var visible_pats: Buf[Pattern] = buf()

// What was wrong with the program, found while compiling rather than while parsing.
//
// **The compiler had nothing to complain WITH until types existed.** Everything it could object to
// before then was either a parse error or something a `FailWith` could carry to run time; a name in
// a pattern that turns out to be a binding where a type was wanted is neither -- it is known while
// compiling and there is no value to attach it to. `run` folds these in with the parser's.
private var compile_faults: Report = report()
private var compile_fault_srcs: Buf[usize] = buf()

// Whether anything was wrong, for the caller that has to decide not to run the program.
compile_went_wrong() -> bool = compile_faults.has_errors()

compile_report() -> Report = compile_faults
compile_report_srcs() -> Buf[usize] = compile_fault_srcs

// Not `private`: `check.sysl` reports through this channel too, so a static complaint stops the
// program exactly as one raised here does.
complain_here(at: Span, message: string)
    compile_faults.add(error(at, message))
    compile_fault_srcs.push(compiling_source)

// Forget everything, for the next program.
reset_types()
    known_source.clear()
    known_name.clear()
    known_pat.clear()
    known_public.clear()
    visible_names.clear()
    visible_pats.clear()
    compile_faults = report()
    compile_fault_srcs.clear()

private declared_in(src: usize, name: string, want_public: bool) -> Option[Pattern]
    for i in 0..<known_name.len()
        if known_source.at(i) == src && known_name.at(i) == name
            if want_public && !known_public.at(i) then return None

            return Some(known_pat.at(i))

    None
end declared_in

// What `Point` stands for in the file being compiled, if anything does.
private visible_type(name: string) -> Option[Pattern]
    for i in 0..<visible_names.len()
        if visible_names.at(i) == name then return Some(visible_pats.at(i))

    None
end visible_type

// Whether a bare name in pattern position stands for a type rather than binding a value, which is
// exactly the question `resolve_pattern`'s `Bind` arm asks.
//
// **Asked without resolving, on purpose.** `resolve_pattern` complains about a generic type used
// without its arguments, so a second walk over the same pattern would report that twice -- and the
// caller here wants one bit, not a pattern.
//
// Not `private`: `slots.sysl` has to tell the names a pattern BINDS from the names it LOOKS UP, and
// a bare name is one or the other depending on what this file has registered.
names_a_type(name: string) -> bool = visible_type(name).is_some()

// How deep a type may be resolved through other types before slate calls it a circle.
private const MaxTypeDepth: usize = 32

// Whether `name` is one of `names`.
private names_one(names: Buf[string], name: string) -> bool
    for i in 0..<names.len()
        if names.at(i) == name then return true

    false
end names_one

// `` `x`, `y` and `z` `` -- a declaration's fields, read aloud in a complaint about one of them.
private field_list(names: Buf[string]) -> string
    var out = str_builder()

    for i in 0..<names.len()
        if i != 0 then out.push(if i == names.len() - 1 then " and " else ", ")

        out.push_char('`')
        out.push(names.at(i))
        out.push_char('`')

    out.finish()
end field_list

// A pattern with every name that stands for a type replaced by what that type stands for.
//
// **A bare name in pattern position is a BINDING unless it names something**, which is sysl's rule
// for a nullary variant and is exactly the rule here -- so `p is Point` is a shape test where a
// `Point` was declared and binds a variable where none was, with no new syntax either way.
//
// Not `private`: `check.sysl` reads an annotation back off the check it was desugared into, and
// needs the same resolution the compiler applies.
resolve_pattern(pat: Pattern, depth: usize) -> Pattern
    if depth >= MaxTypeDepth then return pat

    *pat.kind match
        Bind(name) ->
            visible_type(name) match
                Some(found) -> *found.kind match
                    // **A generic type used without its arguments is refused rather than erased.**
                    // Erasing would be sound -- every parameter becomes "anything" -- and that is
                    // exactly what makes it the wrong answer: `p is Pair` would quietly test only
                    // that the fields are there, which is a check the reader believes and does not
                    // get.
                    GenericPat(params, _) ->
                        complain_here(pat.span, s"`${name}` is generic over ${counted(params.len(), "type")}, so it needs them here -- write `${name}[${erased_args(params)}]`, or the types this one holds")
                        pat
                    _ -> resolve_pattern(found, depth + 1)
                None -> pat

        // **THE DECLARATION ITSELF, ERASED.** This is reached where the pattern a `type` registered
        // is resolved on its own rather than through a use -- which is what makes the *value* a
        // generic type binds: `Pair.test(v)` asks about the shape with every parameter standing for
        // anything, which is all a shape with no arguments could ever ask. A USE of the bare name
        // goes through the `Bind` arm above and is refused there instead, because a reader who wrote
        // `p: Pair` meant to say something about the fields and this would quietly not.
        GenericPat(params, inner) -> resolve_pattern(substituted(inner, params, erased_types(params, pat.span)), depth + 1)

        // `Pair[string, integer]` -- the declaration, with what it is generic over put through it.
        AppliedPat(name, args) ->
            var out: Buf[Pattern] = buf()

            for i in 0..<args.len()
                out.push(resolve_pattern(args.at(i), depth))

            visible_type(name) match
                Some(found) -> *found.kind match
                    GenericPat(params, inner) ->
                        if params.len() != out.len()
                            complain_here(pat.span, s"`${name}` is generic over ${counted(params.len(), "type")} and this gives it ${out.len()}")

                            return pat

                        // **Substituted and THEN resolved**, so a type given to a generic type may
                        // name another type -- `Pair[Point, Note]` -- and the shape that comes out
                        // is the one both declarations describe.
                        resolve_pattern(substituted(inner, params, out), depth + 1)
                    _ ->
                        complain_here(pat.span, s"`${name}` is not generic, so it takes no types in brackets")
                        pat
                None ->
                    complain_here(pat.span, s"nothing here declares a type called `${name}`")
                    pat
        At(name, inner) -> pattern(pat.span, PatKind.At(name, resolve_pattern(inner, depth)))
        ArrayPat(items, open, rest, defaults) ->
            var out: Buf[Pattern] = buf()

            for i in 0..<items.len()
                out.push(resolve_pattern(items.at(i), depth))

            pattern(pat.span, ArrayPat(out, open, rest, defaults))
        ObjectPat(keys, values, defaults, optional) ->
            var out: Buf[Pattern] = buf()

            for i in 0..<values.len()
                out.push(resolve_pattern(values.at(i), depth))

            pattern(pat.span, ObjectPat(keys, out, defaults, optional))
        VariantPat(name, items, _, _) ->
            var out: Buf[Pattern] = buf()

            for i in 0..<items.len()
                out.push(resolve_pattern(items.at(i), depth))

            visible_type(name) match
                Some(found) -> *found.kind match
                    VariantPat(_, _, keys, singleton) ->
                        // **The arity is checked HERE and nowhere else**, this being the one place
                        // that has both the pattern a person wrote and the declaration it names. A
                        // pattern cannot fault, so an unchecked mismatch would simply never match --
                        // silently, which is the failure mode every pattern defect here has.
                        //
                        // **An EMPTY list means the pattern was written bare**, which tests and takes
                        // nothing apart -- `x is Circle` and `c: Circle`. It is also the shape the
                        // declaration itself registers, and this function resolves that one too, so
                        // checking a count against it would refuse every data declaration there is.
                        // The parser refuses a written `Circle()`, which is what keeps the two apart.
                        if items.len() != 0 && items.len() != keys.len()
                            complain_here(pat.span, s"`${name}` carries ${counted(keys.len(), "field")} and this names ${items.len()}")

                        pattern(pat.span, VariantPat(name, out, keys, singleton))

                    // **A class is taken apart by position exactly as a variant is, and by the same
                    // node.** What its fields are called and what order they come in is the list its
                    // own constructor was built from, so `Point(a, b)` binds what `Point.new(1, 2)`
                    // sets -- not by a convention anybody maintains, but because it is that `Buf`.
                    ProtoPat(_, fields, positional) ->
                        if !positional
                            complain_here(pat.span, s"`${name}` cannot be taken apart by position, because what its `new` takes is not the same as what it holds -- write `${name} { ... }`, which names the fields")
                            pat
                        else
                            if items.len() != 0 && items.len() != fields.len()
                                complain_here(pat.span, s"`${name}` is made from ${counted(fields.len(), "field")} and this names ${items.len()}")

                            pattern(pat.span, VariantPat(name, out, fields, false))
                    _ ->
                        complain_here(pat.span, s"`${name}(...)` takes a class or a data variant apart, and `${name}` is neither")
                        pat
                None ->
                    complain_here(pat.span, s"nothing here declares `${name}`, so `${name}(...)` has no fields to take apart")
                    pat
        MadeFrom(name, inner) ->
            val body = resolve_pattern(inner, depth)

            // **What the declaration says it holds, which is what a written field name is checked
            // against.** An empty list is "not known" rather than "holds nothing" -- a class whose
            // `new` builds its own object names nothing for slate to check, and a pattern over one
            // is left to match or not at run time, exactly as a bare `{ ... }` always has.
            var known: Buf[string] = buf()

            visible_type(name) match
                Some(found) -> *found.kind match
                    ProtoPat(_, fields, _) -> known = fields
                    VariantPat(_, _, keys, singleton) ->
                        if singleton
                            complain_here(pat.span, s"`${name}` declared no fields, so there is nothing to take apart -- write `${name}`, which tests for it")
                        else
                            known = keys
                    DataPat(_, _) ->
                        complain_here(pat.span, s"`${name}` is a data type rather than one of its variants, and the variants are what carry the fields -- name the one this arm is for")
                    _ -> complain_here(pat.span, s"`${name} { ... }` takes a class or a data variant apart, and `${name}` is neither")
                None -> complain_here(pat.span, s"nothing here declares `${name}`, so `${name} { ... }` has no fields to take apart")

            if known.len() != 0
                *body.kind match
                    ObjectPat(keys, _, _, _) ->
                        for i in 0..<keys.len()
                            if !names_one(known, keys.at(i))
                                complain_here(body.span, s"`${name}` has no field `${keys.at(i)}` -- it is made from ${field_list(known)}")
                    _ -> ()

            pattern(pat.span, PatKind.MadeFrom(name, body))
        OrPat(alts) ->
            var out: Buf[Pattern] = buf()

            for i in 0..<alts.len()
                val one = resolve_pattern(alts.at(i), depth)

                // **The parser deferred this and here is where it can be answered.** A bare name in
                // an alternative is a type where one was declared -- `Point | null` -- and a binding
                // otherwise, which would leave a name bound down one path and not the other.
                if binds(one)
                    complain_here(alts.at(i).span, "an alternative of a pattern may not bind a name -- write a type where one was meant, or a literal")

                out.push(one)

            pattern(pat.span, OrPat(out))

        // **A part MAY bind, so there is nothing to refuse here** -- every part runs, so what one
        // binds is bound whenever the pattern matched at all. A bare name that named no type is
        // still a binding and is still perfectly legal, which is `{ id } & user` naming the whole.
        AndPat(parts) ->
            var out: Buf[Pattern] = buf()

            for i in 0..<parts.len()
                out.push(resolve_pattern(parts.at(i), depth))

            pattern(pat.span, AndPat(out))

        // **The element is resolved like any other pattern, and this is also where a binding in one
        // is refused.** It cannot be refused while parsing -- a bare name is a type where one was
        // declared -- and it cannot be left, because an element pattern runs once per element and a
        // name in it would be bound to whichever element ran last.
        EveryPat(container, element) ->
            val inner = resolve_pattern(element, depth)

            first_binding(inner) match
                // **The message leads with "is not a type", which is nearly always the cause.** A
                // reader told only that an element pattern may not bind goes and looks at binding,
                // where what they wrote was a type name that is not one -- the mechanism is worth
                // saying second and the mistake first.
                Some(loose) -> complain_here(pat.span, s"`${loose}` is not a type, so an element pattern naming it would bind it once per element rather than test anything${instead_of(loose)}")
                None -> ()

            pattern(pat.span, EveryPat(container, inner))

        // **A name inside a function type is resolved like any other**, so `(Point) -> boolean` sees
        // the declaration and a name that named nothing is refused where it stands rather than being
        // read as a parameter nobody can supply.
        FnPat(params, result) ->
            var out: Buf[Pattern] = buf()

            for i in 0..<params.len()
                out.push(resolve_pattern(params.at(i), depth))

            pattern(pat.span, FnPat(out, resolve_pattern(result, depth)))
        _ -> pat
end resolve_pattern

// One `any` for each type parameter, which is what a generic type with no arguments describes.
private erased_types(params: Buf[string], at: Span) -> Buf[Pattern]
    var out: Buf[Pattern] = buf()

    for i in 0..<params.len()
        out.push(pattern(at, Wild))

    out
end erased_types

// What a generic type's parameters would look like written out, for the message above to quote.
private erased_args(params: Buf[string]) -> string
    var out = str_builder()

    for i in 0..<params.len()
        if i > 0 then out.push(", ")

        out.push("any")

    out.finish()
end erased_args

// One pattern with every type parameter replaced by the type it was given.
//
// **A rebuild rather than an environment carried through resolution**, and the reason is that a
// generic type may be used inside another one: substituting where the use is found means the
// argument patterns are the ones written at THIS use, and nothing has to be unwound afterwards.
//
// **A type parameter cannot appear in a key, a default or a name**, so the walk only has to reach
// the places a type can stand -- which is what every arm below is.
private substituted(pat: Pattern, params: Buf[string], args: Buf[Pattern]) -> Pattern
    *pat.kind match
        TypeVarPat(name) ->
            for i in 0..<params.len()
                if params.at(i) == name then return args.at(i)

            pat
        At(name, inner) -> pattern(pat.span, PatKind.At(name, substituted(inner, params, args)))
        ArrayPat(items, open, rest, defaults) ->
            var out: Buf[Pattern] = buf()

            for i in 0..<items.len()
                out.push(substituted(items.at(i), params, args))

            pattern(pat.span, ArrayPat(out, open, rest, defaults))
        ObjectPat(keys, values, defaults, optional) ->
            var out: Buf[Pattern] = buf()

            for i in 0..<values.len()
                out.push(substituted(values.at(i), params, args))

            pattern(pat.span, ObjectPat(keys, out, defaults, optional))
        EveryPat(container, element) -> pattern(pat.span, EveryPat(container, substituted(element, params, args)))
        OrPat(alts) ->
            var out: Buf[Pattern] = buf()

            for i in 0..<alts.len()
                out.push(substituted(alts.at(i), params, args))

            pattern(pat.span, OrPat(out))
        AndPat(parts) ->
            var out: Buf[Pattern] = buf()

            for i in 0..<parts.len()
                out.push(substituted(parts.at(i), params, args))

            pattern(pat.span, AndPat(out))
        FnPat(takes, result) ->
            var out: Buf[Pattern] = buf()

            for i in 0..<takes.len()
                out.push(substituted(takes.at(i), params, args))

            pattern(pat.span, FnPat(out, substituted(result, params, args)))
        VariantPat(name, items, keys, singleton) ->
            var out: Buf[Pattern] = buf()

            for i in 0..<items.len()
                out.push(substituted(items.at(i), params, args))

            pattern(pat.span, VariantPat(name, out, keys, singleton))
        MadeFrom(name, inner) -> pattern(pat.span, PatKind.MadeFrom(name, substituted(inner, params, args)))
        AppliedPat(name, inner) ->
            var out: Buf[Pattern] = buf()

            for i in 0..<inner.len()
                out.push(substituted(inner.at(i), params, args))

            pattern(pat.span, AppliedPat(name, out))
        _ -> pat
end substituted

// A pattern into the unit's table, resolved first.
//
// Not `private`: reached from `compile_expr.sysl` -- a pattern in an expression is interned here too.
intern_resolved(u: *Unit, pat: Pattern) -> usize = intern_pattern(u, resolve_pattern(pat, 0))

// Record what a module declared, and work out what it may name.
//
// **A file sees its own types whether or not they were exported, and an imported one only where
// `export type` was written** -- which is the same rule every other name in slate follows.
private open_types(u: *Unit, prog: Program, src: usize)
    for i in 0..<prog.type_names.len()
        known_source.push(src)
        known_name.push(prog.type_names.at(i))
        known_pat.push(prog.type_pats.at(i))
        known_public.push(prog.type_public.at(i))

    open_own_types(prog)

    // **THE IMPORTED TYPES ARE OPENED BEFORE THE SHAPES ARE CHECKED, and the other order was a
    // hole rather than a safeguard.** `check_type_shapes` refuses a declaration that BINDS a name,
    // and whether a name binds is exactly the question "is this a type?" -- so checking before the
    // imported ones were known made every one of them look like a binding. A file could not write
    // `type Wrapped = { box: Box }` for any `Box` it had imported, or alias one, or build any
    // vocabulary at all on another module's types; `v is Box` on the very next line worked, because
    // that resolves later. Two answers to one question about one name.
    //
    // The comment here used to say that opening them first "would quietly change which shapes this
    // complains about". It does, and that is the fix: the ones it stops complaining about are the
    // ones that were never bindings.
    open_imported_types(u, prog, src)
    check_type_shapes(prog)
end open_types

// What one module may name, for a pass that is not compiling.
//
// **The JavaScript back end resolves the same patterns and must resolve them the same way**, so it
// calls this and then `resolve_pattern` rather than walking the types itself. A second resolver
// would be a second answer to a question that already has one, and the two would drift.
//
// **It is the other half of `open_types` and not a copy of it**: registering what a module declares
// happens once, while compiling, and complaining about a shape happens there too. Working out what a
// module may name happens again for every pass that reads its patterns -- and by the time the back
// end runs, every module's types are registered, so a name imported from another file resolves here
// exactly as it did for the machine.
open_module_types(u: *Unit, prog: Program, src: usize)
    open_own_types(prog)
    open_imported_types(u, prog, src)

// The file's own types, which it sees whether or not it exported them.
private open_own_types(prog: Program)
    visible_names.clear()
    visible_pats.clear()

    for i in 0..<prog.type_names.len()
        visible_names.push(prog.type_names.at(i))
        visible_pats.push(prog.type_pats.at(i))

// The types this file imported, which it sees only where `export type` was written.
private open_imported_types(u: *Unit, prog: Program, src: usize)
    for i in 0..<prog.stmts.len()
        *prog.stmts.at(i).kind match
            ImportNames(path, _, origin, names, locals) ->
                val from = module_want_from(u, src, path, origin)

                for j in 0..<u.module_paths.len()
                    if u.module_paths.at(j) == from
                        for k in 0..<names.len()
                            declared_in(u.chunks.at(u.modules.at(j)).source, names.at(k), true) match
                                Some(found) ->
                                    visible_names.push(locals.at(k))

                                    // **A CLASS IS A TYPE AND A VALUE UNDER ONE NAME, and both
                                    // halves have to cross.** An ordinary type has no runtime
                                    // existence, so binding one would look for a field the module
                                    // does not have; a class is an object sitting in that module and
                                    // the import must fetch it. The pattern itself says which is
                                    // which, so no second list is kept.
                                    //
                                    // **The name inside the pattern is rewritten to the LOCAL one**,
                                    // because that is the name the test will look up when it runs.
                                    // Under `import { Square as Sq }` the object is bound as `Sq`,
                                    // and a pattern still asking for `Square` would quietly match
                                    // nothing -- a pattern has nowhere to report from, so this is a
                                    // failure that would have been silent.
                                    //
                                    // **A data type and a variant are the same case as a class**,
                                    // each being a type and a value under one name -- so all three
                                    // are rewritten and all three are bound.
                                    *found.kind match
                                        ProtoPat(_, fields, positional) -> visible_pats.push(pattern(found.span, ProtoPat(locals.at(k), fields, positional)))
                                        DataPat(_, variants) -> visible_pats.push(pattern(found.span, DataPat(locals.at(k), variants)))
                                        VariantPat(_, items, keys, singleton) -> visible_pats.push(pattern(found.span, VariantPat(locals.at(k), items, keys, singleton)))
                                        _ -> visible_pats.push(found)
                                None -> ()
            _ -> ()
end open_imported_types

// One file to a chunk of its own, answering the module index other files name it by.
//
// **Every module is compiled the same way and the entry is simply the last one**, which is what
// makes a program of one file a program of one module rather than a special case.
//
// **A module's value is its exports and not its last statement.** The statements run for their
// effect, their value is dropped, and what the chunk answers is an object built out of the names the
// file marked `export` -- so a module is an ordinary object, `util.double` is an ordinary field
// selection, and the collector needs to know nothing new.
//
// **The object is a snapshot taken when the file finishes.** An `export var` that the module changes
// afterwards is not seen changing from outside, which is where this parts company with TypeScript's
// live bindings -- and is the honest reading of "a module is an object".
compile_module(u: *Unit, prog: Program, src: usize, name: string, is_entry: bool) -> usize
    val at = u.chunks.len()
    var params: Buf[string] = buf()

    compiling_source = src
    open_types(u, prog, src)

    // **The static check runs before the code is emitted, and after the types are open.** It reports
    // through `compile_faults` like everything else here, so a complaint from it stops the program
    // exactly as a parse error does -- and it has to be after `open_types` because an annotation
    // naming a declared type cannot be read until that type is registered.
    check_program(prog, is_slate_module(name))
    u.chunks.push(Chunk(buf(), params, 0, false, name, false, false, 0, false, src))

    // **The top level is not async, so top-level `await` is refused.** node draws the same line for a
    // script, and lifting it would mean the whole program becoming a coroutine -- which is a real
    // design, and one to make on purpose rather than by leaving a flag `true` here.
    // **A module never slots.** Its names are what an import reads, a load per export, so they have
    // to stay findable by name from a chunk that is not this one.
    var e = fresh_emit(false, false, false)

    compile_stmts(u, &e, prog.stmts, point(0))
    push_n(&e, Discard, point(0), 1, 0)

    // **Only the file that was asked for registers its tests.** A test file imports the module it
    // tests, so registering every module's would run the imported file's tests again -- once as its
    // own entry and once more for each file importing it.
    if is_entry
        for i in 0..<prog.tests.len()
            val t = intern_str(u, prog.tests.at(i))

            push_n(&e, LoadName(t), point(0), 0, 1)
            push_n(&e, DefineTest(t), point(0), 1, 0)

    for i in 0..<prog.exports.len()
        val k = intern_str(u, prog.exports.at(i))

        push_n(&e, PushStr(k), point(0), 0, 1)
        push_n(&e, LoadName(k), point(0), 0, 1)

    push_n(&e, MakeObject(prog.exports.len()), point(0), prog.exports.len() * 2, 1)
    put(&e, Ret, point(0))

    var c = u.chunks.at(at)

    c.code = e.code
    u.chunks.set(at, c)
    u.modules.push(at)
    u.module_paths.push(name)
    u.modules.len() - 1
end compile_module

// A function body to a chunk of its own, answering where it landed.
//
// Not `private`: reached from `compile_expr.sysl` -- a lambda is an expression.
compile_chunk(u: *Unit, params: Buf[string], defaults: Buf[Expr], body: Expr, name: string, is_async: bool, is_gen: bool) -> usize
    // The slot is claimed before the body is compiled, so a function that calls itself finds a chunk
    // index that already exists.
    val at = u.chunks.len()

    // **`defaults` covers the LAST of the parameters**, which the parser has already made sure of,
    // so the count of the ones a caller must give is the whole of what a call needs to know.
    //
    // **A rest parameter is not one of them.** It is always bound -- to an empty array where a call
    // gave nothing left over -- so a caller must give every parameter before it and none of it.
    val variadic = !params.is_empty() && rest_param(params.at(params.len() - 1)).is_some()
    val fixed = if variadic then params.len() - 1 else params.len()
    val required = fixed - defaults.len()

    // **The mark comes off HERE and nowhere else**, so a `Chunk` carries the name the body binds and
    // nothing downstream of compilation knows how a rest parameter was written.
    var plain: Buf[string] = buf()

    for i in 0..<params.len()
        plain.push(plain_param(params.at(i)))

    // Every chunk a compilation makes belongs to the file being compiled, which `compile_module`
    // named before it started.
    u.chunks.push(Chunk(buf(), plain, required, variadic, name, is_async, is_gen, 0, false, compiling_source))

    // **Whether this chunk's names may be slots is asked ONCE, of the whole body**, before a line of
    // it is emitted: a name resolved to a slot in one place and to the chain in another would be two
    // bindings wearing one name.
    var e = fresh_emit(is_async, is_gen, may_slot(plain, defaults, body))

    // **THE PARAMETERS TAKE THE FIRST SLOTS, IN ORDER, BEFORE ANYTHING ELSE CLAIMS ONE.** That is
    // what makes parameter `i` slot `i` by construction, so the machine can lay a call's arguments
    // straight into the window without a table saying where each one goes -- and it is why this runs
    // before `compile_defaults`, whose guards name a parameter by its position.
    //
    // **A parameter is writable.** A program may assign to one, which is what `bind_arguments` says
    // by declaring it assignable, and a slot has to agree or the write would be refused here instead.
    if e.slotting
        for i in 0..<plain.len()
            claim_slot(&e, plain.at(i), true)

    // **A default is worked out at the CALL and not at the definition**, which is the whole reason it
    // is compiled here rather than evaluated once and stored: `f(xs = [])` gives each call an array
    // of its own, and `f(a, b = a + 1)` can read what came before it. The parameters are bound in
    // order, so a default sees every parameter to its left and none to its right.
    compile_defaults(u, &e, plain, defaults, required)
    compile_expr(u, &e, body)
    put(&e, Ret, body.span)

    var c = u.chunks.at(at)

    c.code = e.code
    c.slots = e.slots
    c.slotted = e.slotting
    u.chunks.set(at, c)
    at
end compile_chunk

// The head of a chunk that has default parameters: one guarded binding each, in order.
//
// **A parameter nobody gave is not bound at all, so the guard is a question about the scope.** slate
// refuses to store `undefined`, so there is no "it was given, and the value was absence" to tell
// apart from "it was not given" -- which makes this simpler than JavaScript's rule and is why a
// default here fires on exactly one thing.
// **Where the parameters are slots the question is asked of the frame instead**, one bit per
// parameter, and the answer is written into the slot the parameter already owns rather than declared
// into a scope. `JumpIfGiven` and `JumpIfBound` ask the same thing of the two places a parameter can
// live, and which one a chunk uses is settled once, here.
private compile_defaults(u: *Unit, e: *Emit, params: Buf[string], defaults: Buf[Expr], required: usize)
    for i in 0..<defaults.len()
        val value = defaults.at(i)
        val n = required + i
        val k = intern_str(u, params.at(n))
        val over = put(e, if e.slotting then JumpIfGiven(n, 0) else JumpIfBound(k, 0), value.span)

        compile_expr(u, e, value)

        if e.slotting
            push_n(e, StoreSlot(n), value.span, 1, 0)
        else
            push_n(e, DeclareVar(k), value.span, 1, 0)

        patch(e, over, here(e))
end compile_defaults

// The defaults a binding pattern carries, as one guarded binding each.
//
// **This is `compile_defaults` again, and deliberately so.** A parameter nobody gave and a field the
// subject did not have are the same situation: slate refuses to store `undefined`, so a name that
// was not supplied is simply *not bound*, and `JumpIfBound` is the question that separates the two
// cases. The matcher leaves a defaulted name unbound and this fills it in.
//
// **The order is the order they were written**, so a default may read a name bound to its left --
// `{ width, height = width }` -- which is the rule a parameter list already has.
//
// Not `private`: reached from `compile_stmt.sysl`.
emit_pattern_defaults(u: *Unit, e: *Emit, pat: Pattern, immutable: bool)
    *pat.kind match
        At(_, inner) -> emit_pattern_defaults(u, e, inner, immutable)
        ArrayPat(items, _, _, defaults) ->
            for i in 0..<items.len()
                emit_pattern_defaults(u, e, items.at(i), immutable)
                emit_one_default(u, e, items.at(i), defaults.at(i), immutable)
        ObjectPat(_, values, defaults, _) ->
            for i in 0..<values.len()
                emit_pattern_defaults(u, e, values.at(i), immutable)
                emit_one_default(u, e, values.at(i), defaults.at(i), immutable)
        _ -> ()
end emit_pattern_defaults

private emit_one_default(u: *Unit, e: *Emit, target: Pattern, value: Option[Expr], immutable: bool)
    val given = value match
        Some(v) -> v
        None -> return

    // The parser has already refused a default on anything but a bare binding, so this is the name.
    val name = *target.kind match
        Bind(n) -> n
        _ -> return

    val k = intern_str(u, name)
    val over = put(e, JumpIfBound(k, 0), given.span)

    compile_expr(u, e, given)
    push_n(e, if immutable then DeclareVal(k) else DeclareVar(k), given.span, 1, 0)
    patch(e, over, here(e))
end emit_one_default

// Whether a pattern carries a default anywhere inside it.
//
// Not `private`: `compile_expr.sysl` refuses one where a pattern is a TEST rather than a binding.
pattern_defaults(pat: Pattern) -> bool
    *pat.kind match
        At(_, inner) -> pattern_defaults(inner)
        OrPat(alts) ->
            for i in 0..<alts.len()
                if pattern_defaults(alts.at(i)) then return true

            false
        AndPat(parts) ->
            for i in 0..<parts.len()
                if pattern_defaults(parts.at(i)) then return true

            false
        ArrayPat(items, _, _, defaults) ->
            for i in 0..<items.len()
                if defaults.at(i).is_some() || pattern_defaults(items.at(i)) then return true

            false
        EveryPat(_, element) -> pattern_defaults(element)
        ObjectPat(_, values, defaults, _) ->
            for i in 0..<values.len()
                if defaults.at(i).is_some() || pattern_defaults(values.at(i)) then return true

            false
        _ -> false
end pattern_defaults

// Whether a pattern marks a field `?` anywhere inside it.
//
// **`pattern_defaults`' mirror, for the mirror rule**: a default belongs to a pattern that binds and
// is refused in a test, and a `?` belongs to a pattern that tests and is refused in a binding.
private pattern_optionals(pat: Pattern) -> bool
    *pat.kind match
        At(_, inner) -> pattern_optionals(inner)
        OrPat(alts) ->
            for i in 0..<alts.len()
                if pattern_optionals(alts.at(i)) then return true

            false
        AndPat(parts) ->
            for i in 0..<parts.len()
                if pattern_optionals(parts.at(i)) then return true

            false
        ArrayPat(items, _, _, _) ->
            for i in 0..<items.len()
                if pattern_optionals(items.at(i)) then return true

            false
        EveryPat(_, element) -> pattern_optionals(element)
        ObjectPat(_, values, _, optional) ->
            for i in 0..<values.len()
                if optional.at(i) || pattern_optionals(values.at(i)) then return true

            false
        MadeFrom(_, inner) -> pattern_optionals(inner)
        VariantPat(_, items, _, _) ->
            for i in 0..<items.len()
                if pattern_optionals(items.at(i)) then return true

            false
        _ -> false
end pattern_optionals

// **A `?` says a field may be absent and says nothing about what happens then, which only a test can
// use.** In a binding the name would simply not be bound, and slate refuses to store `undefined` --
// so the mistake would surface at whichever later line first read it, with nothing there to say the
// binding was the cause. A default is what a binding writes instead, and the message says so.
//
// Not `private`: reached from `compile_stmt.sysl`.
refuse_optionals(pat: Pattern, where: string)
    if pattern_optionals(pat)
        complain_here(pat.span, s"`?` says a field may be missing and says nothing about what to bind, so it belongs to a pattern that tests -- ${where}. A name left unbound would fault at whichever line read it: write `= something` to say what a missing field binds")

// **A DECLARED TYPE IS A SHAPE, NOT A DESTRUCTURING.** A type is a named pattern, so nothing stopped
// one holding a bare name -- and a bare name binds. `type Tagged = { x: n }` then introduced `n` at
// every site that used the type, including out of an `is` into the surrounding scope, which is action
// at a distance from a declaration that reads as a shape.
//
// **It is also what the union rule already said.** An alternative may not bind, for the same reason;
// a whole type being allowed to was the inconsistency.
//
// Checked here rather than while parsing for the reason everything about types is: a bare name is a
// type where one was declared, and which it is cannot be known until they are all registered.
private check_type_shapes(prog: Program)
    for i in 0..<prog.type_names.len()
        val name = prog.type_names.at(i)
        val at = prog.type_pats.at(i).span

        first_binding(resolve_pattern(prog.type_pats.at(i), 0)) match
            Some(loose) ->
                // A name still standing after resolution that IS a type is one the resolver gave up
                // on, which happens only when a type is written in terms of itself.
                if visible_type(loose).is_some() || loose == name
                    complain_here(at, s"`${name}` is written in terms of itself, and a type is a shape a value is tested against rather than one that nests without end")
                else
                    complain_here(at, s"a type is a shape, so `${name}` may not bind `${loose}` -- a name written inside a type is introduced wherever the type is used, which is not what a declaration that reads as a shape should do")
            None -> ()
end check_type_shapes

// What somebody who wrote a name slate does not know probably meant.
//
// **slate used the short forms until the day it stopped**, so `str`, `num`, `int`, `bool` and `fn`
// are all worth guessing at; `float`, `double` and `any` are what another language would have taught
// somebody instead. A guess at the moment of the mistake is worth more than a list in a manual.
//
// Not `private`: reached from `compile_expr.sysl` -- an annotation on a lambda gets the same guess.
instead_of(name: string) -> string
    if name == "str" then return " -- slate's word is `string`"
    if name == "num" then return " -- slate's word is `number`"
    if name == "int" then return " -- slate's word is `integer`"
    if name == "bool" then return " -- slate's word is `boolean`"
    if name == "fn" then return " -- slate's word is `function`"
    if name == "float" || name == "double" then return " -- slate's word is `real`"
    " -- declare it with `type`, or name one of null, boolean, integer, real, number, string, array, object, function"
end instead_of

// Which module a path written in the file being compiled names.
//
// **It resolves the path the same way the loader did, from the same two strings**, rather than
// having the loader hand a table down -- there is one rule for what a path means and it lives in
// `module.sysl`, so asking it twice cannot disagree with itself.
//
// Not `private`: reached from `compile_stmt.sysl`.
module_index(u: *Unit, raw: string, origin: Origin) -> Option[usize]
    val want = module_want(u, raw, origin)

    if want == "" then return None

    for i in 0..<u.module_paths.len()
        if u.module_paths.at(i) == want then return Some(i)

    None
end module_index

// The string a module is known by, worked out the way the loader worked it out.
//
// **The file an import is written IN is a parameter**, because `open_types` asks this question while
// walking a file that is not the one being compiled -- and a relative path means nothing without it.
module_want_from(u: *Unit, src: usize, raw: string, origin: Origin) -> string
    if origin == Origin.FromSlate then return builtin_path(raw)
    if origin == Origin.FromPackage then return package_path(u, raw)

    resolve_import(u.sources.at(src).name, raw)
end module_want_from

private module_want(u: *Unit, raw: string, origin: Origin) -> string =
    module_want_from(u, compiling_source, raw, origin)

// Where a package import points, asked of the same resolver the loader used.
private package_path(u: *Unit, name: string) -> string
    val (entry, _) = package_entry(u.packages, name)

    entry
end package_path
