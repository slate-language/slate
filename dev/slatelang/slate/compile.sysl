module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// Compiling: what a whole module comes to, what a module declared and what it may name, and which
// module a written path names.
//
// **The STATEMENTS are in `compile_stmt.sysl`, the expressions in `compile_expr.sysl` and what a
// declared type resolves to in `compile_types.sysl`**, this file holding the entry points both of
// the first two stand on. Three names cross to the statements -- `emit_pattern_defaults`, `refuse_optionals` and `module_index` -- and nothing
// comes back the other way; `compiling_source` stays `private` because everything that reads it,
// `module_want` included, is here.

// -- entry ----------------------------------------------------------------------------------------

// Which file is being compiled, as an index into the unit's sources, is `current().compiling_source`.
//
// **Reached rather than threaded, for the same reason `current_source` is**: a chunk is made deep
// inside `compile_expr`, which has no business carrying a file down to it, and the answer is the same
// for everything one call to `compile_module` emits. The machine's copy is the run-time twin of this.

// -- types -----------------------------------------------------------------------------------------

// Every type any module has declared so far, and where, is the four `current().known_*` buffers.
//
// **Filled as each module compiles, which is why no pre-pass is needed**: modules are compiled in
// post-order, so by the time a file that imports something is compiled, everything it imports has
// already registered whatever it declared.
//
// The types the file being compiled may name -- its own, and the exported ones it imported -- are
// `current().visible_names` and `current().visible_pats`. All of them are fields of the VM; see
// `vm_state.sysl`.

// What was wrong with the program, found while compiling rather than while parsing.
//
// **The compiler had nothing to complain WITH until types existed.** Everything it could object to
// before then was either a parse error or something a `FailWith` could carry to run time; a name in
// a pattern that turns out to be a binding where a type was wanted is neither -- it is known while
// compiling and there is no value to attach it to. `run` folds these in with the parser's.
// They are `current().compile_faults` and `current().compile_fault_srcs`.

// Whether anything was wrong, for the caller that has to decide not to run the program.
compile_went_wrong() -> bool = current().compile_faults.has_errors()

compile_report() -> Report = current().compile_faults
compile_report_srcs() -> Buf[usize] = current().compile_fault_srcs

// Not `private`: `check.sysl` reports through this channel too, so a static complaint stops the
// program exactly as one raised here does.
//
// **The same sentence at the same place in the same file is said once.** A class's initialiser is
// one expression the parser places in more than one function -- the generated `new`, the `(inits)`
// a subclass is built from -- so a mistake in it is met once per copy, and a reader told twice
// looks for a second mistake.
complain_here(at: Span, message: string)
    val v = current()

    for i in 0..<v.compile_faults.items.len()
        val d = v.compile_faults.items.at(i)

        if d.span.start == at.start && d.span.end == at.end && d.message == message && v.compile_fault_srcs.at(i) == v.compiling_source then return

    v.compile_faults.add(error(at, message))
    v.compile_fault_srcs.push(v.compiling_source)

// Forget everything, for the next program.
reset_types()
    val v = current()

    v.known_source.clear()
    v.known_name.clear()
    v.known_pat.clear()
    v.known_public.clear()
    v.visible_names.clear()
    v.visible_pats.clear()
    v.compile_faults = report()
    v.compile_fault_srcs.clear()
    v.session_type_names.clear()
    v.session_type_pats.clear()
    forget_conversions()

// Record what a module declared, and work out what it may name.
//
// **A file sees its own types whether or not they were exported, and an imported one only where
// `export type` was written** -- which is the same rule every other name in slate follows.
private open_types(u: *Unit, prog: Program, src: usize)
    val v = current()

    for i in 0..<prog.type_names.len()
        v.known_source.push(src)
        v.known_name.push(prog.type_names.at(i))
        v.known_pat.push(prog.type_pats.at(i))
        v.known_public.push(prog.type_public.at(i))

    open_own_types(prog)

    // **THE IMPORTED TYPES ARE OPENED BEFORE THE SHAPES ARE CHECKED, and the other order was a
    // hole rather than a safeguard.** `check_type_shapes` refuses a declaration that BINDS a name,
    // and whether a name binds is exactly the question "is this a type?" -- so checking before the
    // imported ones were known made every one of them look like a binding. A file could not write
    // `type Wrapped = { box: Box }` for any `Box` it had imported, or alias one, or build any
    // vocabulary at all on another module's types; `v is Box` on the very next line worked, because
    // that resolves later. Two answers to one question about one name.
    //
    // The comment here used to say that opening them first "would quietly change which shapes this
    // complains about". It does, and that is the fix: the ones it stops complaining about are the
    // ones that were never bindings.
    open_imported_types(u, prog, src)

    // **A session's earlier programs' types come LAST**, the lookup taking the first match: a type
    // this file declares or imports under a name an earlier program used is the one it means.
    if v.session_scope != null
        for i in 0..<v.session_type_names.len()
            v.visible_names.push(v.session_type_names.at(i))
            v.visible_pats.push(v.session_type_pats.at(i))

    open_veils(prog, src)
    check_type_shapes(prog)
end open_types

// What one module may name, for a pass that is not compiling.
//
// **The JavaScript back end resolves the same patterns and must resolve them the same way**, so it
// calls this and then `resolve_pattern` rather than walking the types itself. A second resolver
// would be a second answer to a question that already has one, and the two would drift.
//
// **It is the other half of `open_types` and not a copy of it**: registering what a module declares
// happens once, while compiling, and complaining about a shape happens there too. Working out what a
// module may name happens again for every pass that reads its patterns -- and by the time the back
// end runs, every module's types are registered, so a name imported from another file resolves here
// exactly as it did for the machine.
open_module_types(u: *Unit, prog: Program, src: usize)
    open_own_types(prog)
    open_imported_types(u, prog, src)

// The file's own types, which it sees whether or not it exported them.
private open_own_types(prog: Program)
    val v = current()

    v.visible_names.clear()
    v.visible_pats.clear()

    for i in 0..<prog.type_names.len()
        v.visible_names.push(prog.type_names.at(i))
        v.visible_pats.push(prog.type_pats.at(i))

// The file a quoted import in the file being compiled names, by its index in the unit -- the lookup
// `open_imported_types` makes, asked by the checker of one import at a time.
//
// Not `private`: `import_signature` reads an imported file's signatures through it.
imported_source(path: string, origin: Origin) -> Option[usize]
    val u = running_unit()
    val from = module_want_from(u, current().compiling_source, path, origin)

    for j in 0..<u.module_paths.len()
        if u.module_paths.at(j) == from then return Some(u.chunks.at(u.modules.at(j)).source)

    None
end imported_source

// The types this file imported, which it sees only where `export type` was written.
private open_imported_types(u: *Unit, prog: Program, src: usize)
    for i in 0..<prog.stmts.len()
        *prog.stmts.at(i).kind match
            ImportNames(path, _, origin, names, locals) ->
                val from = module_want_from(u, src, path, origin)

                for j in 0..<u.module_paths.len()
                    if u.module_paths.at(j) == from
                        for k in 0..<names.len()
                            declared_in(u.chunks.at(u.modules.at(j)).source, names.at(k), true) match
                                Some(found) ->
                                    current().visible_names.push(locals.at(k))

                                    // **A CLASS IS A TYPE AND A VALUE UNDER ONE NAME, and both
                                    // halves have to cross.** An ordinary type has no runtime
                                    // existence, so binding one would look for a field the module
                                    // does not have; a class is an object sitting in that module and
                                    // the import must fetch it. The pattern itself says which is
                                    // which, so no second list is kept.
                                    //
                                    // **The name inside the pattern is rewritten to the LOCAL one**,
                                    // because that is the name the test will look up when it runs.
                                    // Under `import { Square as Sq }` the object is bound as `Sq`,
                                    // and a pattern still asking for `Square` would quietly match
                                    // nothing -- a pattern has nowhere to report from, so this is a
                                    // failure that would have been silent.
                                    //
                                    // **A data type and a variant are the same case as a class**,
                                    // each being a type and a value under one name -- so all three
                                    // are rewritten and all three are bound.
                                    *found.kind match
                                        ProtoPat(_, fields, positional) -> current().visible_pats.push(pattern(found.span, ProtoPat(locals.at(k), fields, positional)))
                                        DataPat(_, variants) -> current().visible_pats.push(pattern(found.span, DataPat(locals.at(k), variants)))
                                        VariantPat(_, items, keys, singleton) -> current().visible_pats.push(pattern(found.span, VariantPat(locals.at(k), items, keys, singleton)))
                                        _ -> current().visible_pats.push(found)
                                None -> ()
            _ -> ()
end open_imported_types

// One file to a chunk of its own, answering the module index other files name it by.
//
// **Every module is compiled the same way and the entry is simply the last one**, which is what
// makes a program of one file a program of one module rather than a special case.
//
// **A module's value is its exports and not its last statement.** The statements run for their
// effect, their value is dropped, and what the chunk answers is an object built out of the names the
// file marked `export` -- so a module is an ordinary object, `util.double` is an ordinary field
// selection, and the collector needs to know nothing new.
//
// **The object is a snapshot taken when the file finishes.** An `export var` that the module changes
// afterwards is not seen changing from outside, which is where this parts company with TypeScript's
// live bindings -- and is the honest reading of "a module is an object".
// **A MODULE IS TWO CHUNKS: THE ONE A PROGRAM RUNS, AND ITS DECLARATIONS ALONE.** The first is the
// chunk this has always emitted, statement for statement -- so an ordinary run is unchanged down to
// the instruction. The second holds only the file's declarations, in source order: its definitions,
// classes, data types, types, externals and imports.
//
// **What the second buys is a VM that can learn a program's names without running it.** An actor's
// machine, or an embedder's, runs `load_declarations` and has every definition and every class the
// program declares, with nothing printed, nothing opened and no timer armed. A top-level `val` is
// simply not bound there, so a method reaching one faults with the ordinary sentence about a name
// that is not defined -- which is the consequence `docs/reference/modules.md` states for a reader.
//
// **THE DECLARATIONS ARE COMPILED TWICE RATHER THAN CUT OUT OF THE ONE CHUNK, AND THE REASON IS THAT
// A DECLARATION IS NOT ALWAYS FIRST.** Cutting them out would mean running them ahead of the file's
// effects, and slate has two rules that says otherwise: an `import` binds where it is written, and a
// class field's initialiser is worked out where the class stands, so `class Config` carrying
// `val defaults = Defaults` reads a `val` written above it. Both are pinned by tests and both would
// have had to change. The price is a chunk per declared function on each side, which nothing but a
// program's size can see.
compile_module(u: *Unit, prog: Program, src: usize, name: string, is_entry: bool) -> usize
    val at_decls = u.chunks.len()
    val at = at_decls + 1
    var params: Buf[string] = buf()

    current().compiling_source = src
    forget_conversions_of(src)
    open_types(u, prog, src)

    // **The static check runs before the code is emitted, and after the types are open.** It reports
    // through `compile_faults` like everything else here, so a complaint from it stops the program
    // exactly as a parse error does -- and it has to be after `open_types` because an annotation
    // naming a declared type cannot be read until that type is registered.
    check_program(prog, is_slate_module(name))

    // **Both chunks are reserved before either is compiled**, because compiling one pushes a chunk
    // for every definition in it and an index handed out afterwards would not be the one a caller was
    // promised. The declarations chunk never waits: an `await` at the top level is an effect, so it
    // is in the other one and the flag that makes a chunk a coroutine belongs there.
    u.chunks.push(Chunk(buf(), buf(), 0, false, name, false, false, 0, false, false, src))
    u.chunks.push(Chunk(buf(), params, 0, false, name, prog.awaits, false, 0, false, false, src))

    // The two halves of the file, each in the order it was written.
    var decl_stmts: Buf[Stmt] = buf()
    var body_stmts: Buf[Stmt] = buf()

    for i in 0..<prog.stmts.len()
        if i < prog.decls.len() && prog.decls.at(i) then decl_stmts.push(prog.stmts.at(i)) else body_stmts.push(prog.stmts.at(i))

    // **A file's body is an async context where the file waits for something, and an ordinary chunk
    // where it does not**, which is an ES module's rule: `await` at the top level is legal and the
    // file is finished when what it waited for has settled. The flag is the one an `async`
    // definition's body carries, so `Await` needs no new arm anywhere -- and it is read off the
    // PARSER rather than set true for everybody, so a file holding no `await` is compiled into the
    // instructions it always was and started by `run_chunk` with no coroutine and no promise.
    // **A module never slots, and not one name of it does.** Its names are what an import reads, a
    // load per export, so they have to stay findable by name from a chunk that is not this one --
    // which is why it gets neither answer rather than the weaker one.
    //
    // **`prog.binders` is what a module has in place of `slot_plan`'s answer.** Every other chunk
    // learns from the plan that it holds no binding `is`; a module is never planned, so the parser
    // counts the ones written at the file's own top level and a module holding none lets each block
    // be asked whether it declares anything -- which is what stops a module-level loop building an
    // `EnvObj` every turn for a body that binds nothing.
    var e = fresh_emit(u, at, true, prog.awaits, false, false, false, prog.binders, buf())

    // **The file's own definitions are read off the tree before a line of it is emitted**, so that a
    // call of one compiles to a table index rather than a lookup by name. `defs.sysl` carries the
    // rule and `settle_module_defs` at the end of this function is the other half of it.
    open_module_defs(u, prog.stmts)

    // **A module's own body answers nothing**, its exports being an object built below rather than
    // its last statement's value, so every statement in it stands unread.
    compile_stmts(u, &e, prog.stmts, point(0), Dropped)

    // **Only the file that was asked for registers its tests.** A test file imports the module it
    // tests, so registering every module's would run the imported file's tests again -- once as its
    // own entry and once more for each file importing it.
    if is_entry
        for i in 0..<prog.tests.len()
            val t = intern_str(u, prog.tests.at(i))

            push_n(&e, LoadName(t), point(0), 0, 1)
            push_n(&e, DefineTest(t), point(0), 1, 0)

        // And what the file wrote around them, by the same rule and for the same reason.
        emit_hook(u, &e, HookSetup, prog.setup)
        emit_hook(u, &e, HookTeardown, prog.teardown)
        emit_hook(u, &e, HookSetupAll, prog.setup_all)
        emit_hook(u, &e, HookTeardownAll, prog.teardown_all)

    export_object(u, &e, prog.exports, buf())

    var c = u.chunks.at(at)

    c.code = fuse(e.code)
    u.chunks.set(at, c)

    // And the declarations a second time, on their own. **Nothing here may complain**: these are
    // statements the chunk above has just compiled, so every diagnostic they can draw has been drawn.
    val was = quiet_compiling()

    var de = fresh_emit(u, at_decls, true, false, false, false, false, prog.binders, buf())

    compile_stmts(u, &de, decl_stmts, point(0), Dropped)
    export_object(u, &de, prog.exports, effect_names(body_stmts))
    say_again(was)

    var dc = u.chunks.at(at_decls)

    dc.code = fuse(de.code)
    u.chunks.set(at_decls, dc)

    // **Both chunks are written, so every resolved read is an index into code standing still** --
    // which is what this waits for. A spelling something in the file turned out to bind goes back to
    // the lookup it would have had, wherever it was read.
    settle_module_defs(u)

    u.modules.push(at)
    u.module_decls.push(at_decls)
    u.module_paths.push(name)
    u.modules.len() - 1
end compile_module

// Put the compiler's report aside, and hand back what was there.
//
// **`sh.sysl.parsing`'s `Report` has no rewind**, which is what makes this a swap rather than a
// truncation: a fresh one takes every complaint the next pass makes and is thrown away with them.
// The declarations chunk is the one caller, and it compiles statements the module's own chunk has
// already compiled -- so a complaint raised there would be the second copy of one the reader has.
private quiet_compiling() -> (Report, Buf[usize])
    val v = current()
    val was = (v.compile_faults, v.compile_fault_srcs)

    v.compile_faults = report()
    v.compile_fault_srcs = buf()
    was
end quiet_compiling

private say_again(was: (Report, Buf[usize]))
    val v = current()

    v.compile_faults = was.0
    v.compile_fault_srcs = was.1
end say_again

// What a module answers: an object of the names the file marked `export`.
//
// **`absent` is the names a chunk cannot load, and it is empty for every chunk but a declarations
// one.** A file may export a `val`, which is an effect -- so the declarations chunk has never bound
// it and a `LoadName` there would fault on a name the file is perfectly entitled to have. It is
// written as `null` instead, which is what a VM that has run only declarations knows about it: the
// key is there because the file exports it, and nothing is behind it because nothing has run.
private export_object(u: *Unit, e: *Emit, names: Buf[string], absent: Buf[string])
    for i in 0..<names.len()
        // **Read the way the file's own code reads the name**, which is its cell where it has one: a
        // top-level `var` lives in its cell and the scope is not written after it is bound (see
        // `compose_store_cell`), so an export read by spelling would answer what it was declared as.
        if names_one(absent, names.at(i))
            push_n(e, PushNull, point(0), 0, 1)
        else
            read_module_name(u, e, names.at(i), point(0))

    push_n(e, MakeObject(intern_object_keys(u, names), u32(names.len())), point(0), names.len(), 1)
    put(e, Ret, point(0))
end export_object

// The names a run of statements BINDS, for the two forms that bind one and can be exported.
//
// **A `val` and a `var` are the whole list**, because they are the only effects `export` takes: a
// destructuring binding has no single name and `parse_export` pushes nothing for one, so a name that
// is exported and not declared arrived through one of these two.
// The names a whole file's top level binds with a `val` or a `var`.
//
// **These are exactly the names a declarations-only load leaves unbound**, which is why they are worth
// recording: an actor's VM does not run the entry file's top level, so a handler reaching one of these
// can be told where the value belongs rather than only that the name is not defined.
//
// Not `private`: `run.sysl` records the entry file's own before the modules are walked.
top_level_effect_names(prog: Program) -> Buf[string]
    var body: Buf[Stmt] = buf()

    for i in 0..<prog.stmts.len()
        if !(i < prog.decls.len() && prog.decls.at(i)) then body.push(prog.stmts.at(i))

    effect_names(body)
end top_level_effect_names

private effect_names(stmts: Buf[Stmt]) -> Buf[string]
    var found: Buf[string] = buf()

    for i in 0..<stmts.len()
        *stmts.at(i).kind match
            Val(name, _) -> found.push(name)
            Var(name, _) -> found.push(name)
            _ -> ()

    found
end effect_names

// One `@setup`, `@teardown`, `@setupAll` or `@teardownAll`, where the file wrote one.
private emit_hook(u: *Unit, e: *Emit, kind: usize, name: string)
    if name == "" then return

    val k = intern_str(u, name)

    push_n(e, LoadName(k), point(0), 0, 1)
    push_n(e, DefineHook(u32(kind), u32(k)), point(0), 1, 0)
end emit_hook

// A function body to a chunk of its own, answering where it landed.
//
// Not `private`: reached from `compile_expr.sysl` -- a lambda is an expression.
// Whether this body will put a safe point down without being asked, which is every block that has a
// statement in it: `compile_stmts` writes one in front of each, and the first of them stands at the
// chunk's head. An annotated parameter, a `-> type` and a contract clause all wrap a body into such
// a block, so the bodies this answers false for are the plain one-expression ones.
private carries_statement_safe_point(body: Expr) -> bool
    *body.kind match
        Block(stmts) -> !stmts.is_empty()
        _ -> false

// Where a body's fall-out answer was written, which is where `Ret` refusing an absence points: the
// last statement of a block that ends in an expression, and the body itself otherwise.
private answer_span(body: Expr) -> Span
    *body.kind match
        Block(stmts) ->
            if stmts.is_empty() then return body.span

            *stmts.at(stmts.len() - 1).kind match
                Eval(x) -> answer_span(x)
                _ -> body.span
        Ensures(value, _, _, _) -> answer_span(value)
        _ -> body.span
end answer_span

compile_chunk(u: *Unit, params: Buf[string], defaults: Buf[Expr], body: Expr, name: string, is_async: bool, is_gen: bool) -> usize
    // The slot is claimed before the body is compiled, so a function that calls itself finds a chunk
    // index that already exists.
    val at = u.chunks.len()

    // **`defaults` covers the LAST of the parameters**, which the parser has already made sure of,
    // so the count of the ones a caller must give is the whole of what a call needs to know.
    //
    // **A rest parameter is not one of them.** It is always bound -- to an empty array where a call
    // gave nothing left over -- so a caller must give every parameter before it and none of it.
    val variadic = !params.is_empty() && rest_param(params.at(params.len() - 1)).is_some()
    val fixed = if variadic then params.len() - 1 else params.len()
    val required = fixed - defaults.len()

    // **The mark comes off HERE and nowhere else**, so a `Chunk` carries the name the body binds and
    // nothing downstream of compilation knows how a rest parameter was written.
    var plain: Buf[string] = buf()

    for i in 0..<params.len()
        plain.push(plain_param(params.at(i)))

    // Every chunk a compilation makes belongs to the file being compiled, which `compile_module`
    // named before it started.
    u.chunks.push(Chunk(buf(), plain, required, variadic, name, is_async, is_gen, 0, false, false, current().compiling_source))

    // **Which of this chunk's names may be cells is asked ONCE, of the whole body**, before a line of
    // it is emitted: a name resolved to a cell in one place and to the chain in another would be two
    // bindings wearing one name, so the answer is a set fixed before anything is emitted rather than
    // a decision taken again at each site.
    //
    // **A chunk with cells provably holds no binding `is`**, `expr_holds_capture` answering true at
    // the first one it meets and the plan then giving no cells at all -- so `!plan.cells` is the
    // conservative reading of "a block here may gain a name its statements do not name", and a
    // chunk refused cells for any other reason simply keeps the scopes it always kept.
    val plan = slot_plan(plain, defaults, body)
    var e = fresh_emit(u, at, false, is_async, is_gen, plan.whole, plan.cells, !plan.cells, plan.kept)

    // **THE PARAMETERS TAKE THE FIRST SLOTS, IN ORDER, BEFORE ANYTHING ELSE CLAIMS ONE.** That is
    // what makes parameter `i` slot `i` by construction, so the machine can lay a call's arguments
    // straight into the window without a table saying where each one goes -- and it is why this runs
    // before `compile_defaults`, whose guards name a parameter by its position.
    //
    // **A parameter is writable.** A program may assign to one, which is what `bind_arguments` says
    // by declaring it assignable, and a slot has to agree or the write would be refused here instead.
    //
    // **A CHUNK THAT KEEPS ITS SCOPE KEEPS ALL ITS PARAMETERS IN IT**, and they are written down
    // here so a lookup stops at one rather than answering about a cell an inner block claimed under
    // the same spelling. Splitting the parameters -- some cells, some not -- would need a table
    // saying where each argument goes, which is exactly what "parameter `i` is slot `i`" bought.
    // **A parameter of a chunk with no cells at all is bound by the MACHINE and by no instruction**,
    // so this is where such a chunk says that its parameters shadow a definition of the same
    // spelling. `claim_slot` and `note_scope_name` say it for every other chunk, and saying it twice
    // costs a walk of a list that is nearly always empty.
    for i in 0..<plain.len()
        shadowed_name(u, plain.at(i))

    if e.slotting
        for i in 0..<plain.len()
            claim_slot(&e, plain.at(i), true)
    else
        for i in 0..<plain.len()
            note_scope_name(&e, plain.at(i))

    // **A CHUNK WHOSE BODY IS ONE EXPRESSION GETS A SAFE POINT OF ITS OWN, HERE.** A block body's
    // first statement already carries one, and an expression body never goes through
    // `compile_stmts` at all -- so `down(n) = n > 0 && down(n - 1)` and `(v) -> v * scale` used to
    // hold none, and a recursion through such functions could be neither collected nor interrupted
    // until it returned. It stands at the HEAD, in front of the defaults, so a default that calls
    // back into the chunk is inside the guarantee too.
    if !carries_statement_safe_point(body) then safe_point(&e, body.span)

    // **A parameter with NO default still owes a binding where the call left it out** -- the call
    // rule follows JavaScript's in both directions, so too few is not refused and what nobody gave
    // reads as `undefined`, exactly as a missing field does. This runs BEFORE `compile_defaults`, or
    // a trailing default reading an earlier required parameter (`f(a, b = a + 1)`) would find it
    // unbound rather than absent.
    compile_required_absences(u, &e, plain, required, body.span)

    // **A default is worked out at the CALL and not at the definition**, which is the whole reason it
    // is compiled here rather than evaluated once and stored: `f(xs = [])` gives each call an array
    // of its own, and `f(a, b = a + 1)` can read what came before it. The parameters are bound in
    // order, so a default sees every parameter to its left and none to its right.
    compile_defaults(u, &e, plain, defaults, required)
    compile_expr(u, &e, body)

    // **A generator that falls out of its body has finished, and a finished one's value is `null`.**
    // Its body's last value is usually the answer to its last `yield` -- `undefined` wherever a `for`
    // or a bare `next()` drove it -- which is nothing the program wrote down to hand back. So an
    // absence there becomes `null` rather than a refusal; a `return` in a generator is still refused.
    if is_gen
        val skip = push_n(&e, JumpIfPresentKeep(0), body.span, 0, 0)

        push_n(&e, Pop, body.span, 1, 0)
        push_n(&e, PushNull, body.span, 0, 1)
        patch(&e, skip, here(&e))

    put(&e, Ret, answer_span(body))

    var c = u.chunks.at(at)

    c.code = fuse(e.code)
    c.slots = e.slots
    c.slotted = e.slotting
    c.in_place_ok = c.slotted && !c.variadic && !c.is_async && !c.is_gen
    u.chunks.set(at, c)
    at
end compile_chunk

// The head of a chunk that has REQUIRED parameters: one guarded `undefined` binding each, for a
// call that left one out.
//
// **This is `compile_defaults` with the default expression fixed at `undefined`.** A call giving
// too few arguments no longer refuses -- it binds the same absence a missing field already answers
// with, `DeclareAbsent` being the one difference from an ordinary default's binding: it skips the
// refusal that a WRITTEN `= undefined` would still meet.
//
// **A SLOTTED CHUNK OWES NOTHING HERE, AND THAT IS WHERE THE HEAD OF EVERY ORDINARY FUNCTION WENT.**
// `lay_frame` pads a parameter cell nobody filled with exactly this absence, so the guarded binding
// could only ever write what was already there -- and the guard itself ran on every call, three
// instructions a call for a function of three parameters that has no default anywhere in it.
//
// **A chunk that keeps its scope still owes them**, because a parameter nobody gave is not bound
// there at all and a lookup would walk past it to a global of the same spelling.
private compile_required_absences(u: *Unit, e: *Emit, params: Buf[string], required: usize, at: Span)
    if e.slotting then return

    for i in 0..<required
        val k = intern_str(u, params.at(i))
        val over = put(e, JumpIfBound(u32(k), 0), at)

        push_n(e, PushUndefined, at, 0, 1)
        push_n(e, DeclareAbsent(k), at, 1, 0)
        patch(e, over, here(e))
end compile_required_absences

// The head of a chunk that has default parameters: one guarded binding each, in order.
//
// **A parameter nobody gave is bound to what the default says**, and the guard is a question about
// the scope: `JumpIfGiven` and `JumpIfBound` ask the same thing of the two places a parameter can
// live (a slot or the scope chain), and which one a chunk uses is settled once, here.
//
// **`?` WRITES `undefined` AS THE DEFAULT, AND THAT ONE VALUE IS EXEMPT FROM THE ORDINARY REFUSAL.**
// slate refuses to STORE `undefined` everywhere else, so an evaluated default binds through the
// ordinary `DeclareVar`/`StoreSlot` -- but a default that is literally `UndefinedLit` (written as
// `= undefined` or desugared from `b?` in `define.sysl`'s `read_default`) is exactly the absence a
// missing field already answers with, not a program choosing to store one, so it binds through
// `DeclareAbsent` instead. Everything else about the mechanism -- the guard, the order, a default
// reading an earlier parameter -- is identical either way.
//
// **AND A SLOTTED CHUNK EMITS NOTHING FOR A DEFAULT THAT IS THE ABSENCE ITSELF.** `b?`, and a
// default written `= undefined`, bind exactly what `lay_frame` already padded the cell with, so the
// guard and the binding under it are a branch and a store that between them change nothing. An
// evaluated default still needs both: its expression may not run where the argument arrived.
private compile_defaults(u: *Unit, e: *Emit, params: Buf[string], defaults: Buf[Expr], required: usize)
    for i in 0..<defaults.len()
        val value = defaults.at(i)
        val n = required + i
        val absent = *value.kind match
            UndefinedLit -> true
            _ -> false

        if absent && e.slotting then continue

        val k = intern_str(u, params.at(n))
        val over = put(e, if e.slotting then JumpIfGiven(u32(n), 0) else JumpIfBound(u32(k), 0), value.span)

        compile_expr(u, e, value)

        if e.slotting
            push_n(e, StoreSlot(n), value.span, 1, 0)
        else
            push_n(e, if absent then DeclareAbsent(k) else DeclareVar(k), value.span, 1, 0)

        patch(e, over, here(e))
end compile_defaults

// The defaults a binding pattern carries, as one guarded binding each.
//
// **This is `compile_defaults` again, and deliberately so.** A parameter nobody gave and a field the
// subject did not have are the same situation: slate refuses to store `undefined`, so a name that
// was not supplied is simply *not bound*, and `JumpIfBound` is the question that separates the two
// cases. The matcher leaves a defaulted name unbound and this fills it in.
//
// **The order is the order they were written**, so a default may read a name bound to its left --
// `{ width, height = width }` -- which is the rule a parameter list already has.
//
// Not `private`: reached from `compile_stmt.sysl`.
emit_pattern_defaults(u: *Unit, e: *Emit, pat: Pattern, immutable: bool)
    *pat.kind match
        At(_, inner) -> emit_pattern_defaults(u, e, inner, immutable)
        ArrayPat(items, _, _, defaults) ->
            for i in 0..<items.len()
                emit_pattern_defaults(u, e, items.at(i), immutable)
                emit_one_default(u, e, items.at(i), defaults.at(i), immutable)
        ObjectPat(_, values, defaults, _, _) ->
            for i in 0..<values.len()
                emit_pattern_defaults(u, e, values.at(i), immutable)
                emit_one_default(u, e, values.at(i), defaults.at(i), immutable)
        _ -> ()
end emit_pattern_defaults

private emit_one_default(u: *Unit, e: *Emit, target: Pattern, value: Option[Expr], immutable: bool)
    val given = value match
        Some(v) -> v
        None -> return

    // The parser has already refused a default on anything but a bare binding, so this is the name.
    val name = *target.kind match
        Bind(n) -> n
        _ -> return

    val k = intern_str(u, name)
    val over = put(e, JumpIfBound(u32(k), 0), given.span)

    compile_expr(u, e, given)
    push_n(e, if immutable then DeclareVal(k) else DeclareVar(k), given.span, 1, 0)
    patch(e, over, here(e))
end emit_one_default

// Whether a pattern carries a default anywhere inside it.
//
// Not `private`: `compile_expr.sysl` refuses one where a pattern is a TEST rather than a binding.
pattern_defaults(pat: Pattern) -> bool
    *pat.kind match
        At(_, inner) -> pattern_defaults(inner)
        OrPat(alts) ->
            for i in 0..<alts.len()
                if pattern_defaults(alts.at(i)) then return true

            false
        AndPat(parts) ->
            for i in 0..<parts.len()
                if pattern_defaults(parts.at(i)) then return true

            false
        ArrayPat(items, _, _, defaults) ->
            for i in 0..<items.len()
                if defaults.at(i).is_some() || pattern_defaults(items.at(i)) then return true

            false
        EveryPat(_, element) -> pattern_defaults(element)
        HoldsPat(_, key, value) -> pattern_defaults(key) || pattern_defaults(value)
        ObjectPat(_, values, defaults, _, _) ->
            for i in 0..<values.len()
                if defaults.at(i).is_some() || pattern_defaults(values.at(i)) then return true

            false
        _ -> false
end pattern_defaults

// Whether a pattern marks a field `?` anywhere inside it.
//
// **`pattern_defaults`' mirror, for the mirror rule**: a default belongs to a pattern that binds and
// is refused in a test, and a `?` belongs to a pattern that tests and is refused in a binding.
private pattern_optionals(pat: Pattern) -> bool
    *pat.kind match
        At(_, inner) -> pattern_optionals(inner)
        OrPat(alts) ->
            for i in 0..<alts.len()
                if pattern_optionals(alts.at(i)) then return true

            false
        AndPat(parts) ->
            for i in 0..<parts.len()
                if pattern_optionals(parts.at(i)) then return true

            false
        ArrayPat(items, _, _, _) ->
            for i in 0..<items.len()
                if pattern_optionals(items.at(i)) then return true

            false
        EveryPat(_, element) -> pattern_optionals(element)
        HoldsPat(_, key, value) -> pattern_optionals(key) || pattern_optionals(value)
        ObjectPat(_, values, _, optional, _) ->
            for i in 0..<values.len()
                if optional.at(i) || pattern_optionals(values.at(i)) then return true

            false
        MadeFrom(_, inner) -> pattern_optionals(inner)
        VariantPat(_, items, _, _) ->
            for i in 0..<items.len()
                if pattern_optionals(items.at(i)) then return true

            false
        _ -> false
end pattern_optionals

// **A `?` says a field may be absent and says nothing about what happens then, which only a test can
// use.** In a binding the name would simply not be bound, and slate refuses to store `undefined` --
// so the mistake would surface at whichever later line first read it, with nothing there to say the
// binding was the cause. A default is what a binding writes instead, and the message says so.
//
// Not `private`: reached from `compile_stmt.sysl` and `compile_loop.sysl`.
refuse_optionals(pat: Pattern, where: string)
    if pattern_optionals(pat)
        complain_here(pat.span, s"`?` says a field may be missing and says nothing about what to bind, so it belongs to a pattern that tests -- ${where}. A name left unbound would fault at whichever line read it: write `= something` to say what a missing field binds")

// What somebody who wrote a name slate does not know probably meant.
//
// **slate used the short forms until the day it stopped**, so `str`, `num`, `int`, `bool` and `fn`
// are all worth guessing at; `float`, `double` and `any` are what another language would have taught
// somebody instead. A guess at the moment of the mistake is worth more than a list in a manual.
//
// Not `private`: reached from `compile_expr.sysl` -- an annotation on a lambda gets the same guess.
instead_of(name: string) -> string
    if name == "str" then return " -- slate's word is `string`"
    if name == "num" then return " -- slate's word is `number`"
    if name == "int" then return " -- slate's word is `integer`"
    if name == "bool" then return " -- slate's word is `boolean`"
    if name == "fn" then return " -- slate's word is `function`"
    if name == "float" || name == "double" then return " -- slate's word is `real`"
    " -- declare it with `type`, or name one of null, boolean, integer, real, number, string, array, object, function"
end instead_of

// Which module a path written in the file being compiled names.
//
// **It resolves the path the same way the loader did, from the same two strings**, rather than
// having the loader hand a table down -- there is one rule for what a path means and it lives in
// `module.sysl`, so asking it twice cannot disagree with itself.
//
// Not `private`: reached from `compile_stmt.sysl`.
module_index(u: *Unit, raw: string, origin: Origin) -> Option[usize]
    val want = module_want(u, raw, origin)

    if want == "" then return None

    for i in 0..<u.module_paths.len()
        if u.module_paths.at(i) == want then return Some(i)

    None
end module_index

// What an asset import written in the file being compiled brings in.
//
// **The empty string where the loader could not read it**, and nothing here says so a second time:
// a file that is missing or is not text has already stopped the run with a diagnostic drawn against
// the import, exactly as a module that would not load has.
//
// Not `private`: reached from `compile_stmt.sysl`.
asset_here(u: *Unit, raw: string) -> string
    asset_text(module_want_from(u, current().compiling_source, raw, Origin.FromFile)) match
        Some(text) -> text
        None -> ""
end asset_here

// The string a module is known by, worked out the way the loader worked it out.
//
// **The file an import is written IN is a parameter**, because `open_types` asks this question while
// walking a file that is not the one being compiled -- and a relative path means nothing without it.
module_want_from(u: *Unit, src: usize, raw: string, origin: Origin) -> string
    if origin == Origin.FromSlate then return builtin_path(raw)
    if origin == Origin.FromPackage then return package_path(u, raw)

    resolve_import(u.sources.at(src).name, raw)
end module_want_from

private module_want(u: *Unit, raw: string, origin: Origin) -> string =
    module_want_from(u, current().compiling_source, raw, origin)

// Where a package import points, asked of the same resolver the loader used.
private package_path(u: *Unit, name: string) -> string
    val (entry, _) = package_entry(u.packages, name)

    entry
end package_path
