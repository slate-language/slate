module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// The tree to instructions.
//
// **Two counters make this whole file work, and both are compile-time.** `sp` is how many values will
// be on the operand stack when this instruction runs, and `scopes` is how deep the scope chain will
// be. Neither is needed at run time, and knowing both here is what lets `break` emit exactly the
// right number of `Pop`s and `PopScope`s to leave the loop balanced -- rather than the machine
// carrying unwind tables to work it out again.
//
// **Every statement leaves exactly one value on the stack**, and the statement after it begins by
// popping that. A block's value is therefore whatever the last statement left, which is slate's rule,
// and an empty block pushes `null` so the rule holds with nothing in it.

// What one chunk's compilation is carrying.
struct Emit
    code: Buf[Ins]

    // How tall the operand stack will be here.
    sp: usize

    // How deep the scope chain will be here.
    scopes: usize

    // The loops enclosing this point, innermost last.
    loops: Buf[LoopFrame]

    // How many `try` handlers will be owed here.
    //
    // **The third counter, and it exists for the same reason the other two do**: a `break` out of a
    // `try` body has to leave the machine balanced, and the only place the number of handlers to
    // drop is known is here.
    handlers: usize

    // Whether the chunk being compiled is an `async` one, which is what says whether `await` is
    // allowed in it. **A compile-time question rather than a run-time one**: a machine that reached an
    // `await` it could not honour would have to decide what to do with a half-evaluated expression,
    // and there is no good answer -- so the code is never emitted.
    is_async: bool

// Where `break` and `continue` have to get back to, and what they have to tidy on the way.
struct LoopFrame
    sp: usize
    scopes: usize

    // How many handlers were owed when the loop began, so a `break` out of a `try` drops its own.
    handlers: usize

    // The name this loop was given, or the empty string. A `break` with no label takes the innermost
    // frame whatever its name; one with a label walks outward until the names agree.
    label: string

    // Instruction positions to patch once the two destinations are known.
    breaks: Buf[usize]
    continues: Buf[usize]

private fresh_emit(is_async: bool) -> Emit = Emit(buf(), 0, 0, buf(), 0, is_async)

// Put one instruction down and answer where it went.
private put(e: *Emit, op: Op, at: Span) -> usize
    e.code.push(Ins(op, at))
    e.code.len() - 1

// Put an instruction down and account for what it does to the stack.
private push_n(e: *Emit, op: Op, at: Span, takes: usize, gives: usize) -> usize
    e.sp = e.sp - takes + gives
    put(e, op, at)

private here(e: *Emit) -> usize = e.code.len()

// Aim a jump that was emitted before its destination was known.
private patch(e: *Emit, at: usize, to: usize)
    val old = e.code.at(at)

    val aimed: Op = old.op match
        Jump(_) -> Jump(to)
        JumpIfFalse(_) -> JumpIfFalse(to)
        JumpIfTrueKeep(_) -> JumpIfTrueKeep(to)
        JumpIfPresentKeep(_) -> JumpIfPresentKeep(to)
        JumpIfAbsentKeep(_) -> JumpIfAbsentKeep(to)
        JumpIfFalseKeep(_) -> JumpIfFalseKeep(to)
        IterNext(_) -> IterNext(to)

        // **A handler's target is patched exactly as a jump's is**, and leaving it out of this list
        // was silent: `PushHandler(0)` is a perfectly good instruction naming instruction zero, so a
        // caught fault re-entered the chunk at its first instruction and the program looped until the
        // heap ran out. The `other -> other` arm below is what made it silent.
        PushHandler(_) -> PushHandler(to)
        other -> other

    e.code.set(at, Ins(aimed, old.at))
end patch

// Drop back to a stack height, a scope depth and a handler depth, which is what leaving a block
// means.
private unwind_to(e: *Emit, sp: usize, scopes: usize, handlers: usize, at: Span)
    var n = e.sp

    while n > sp
        put(e, Pop, at)
        n -= 1

    var d = e.scopes

    while d > scopes
        put(e, PopScope, at)
        d -= 1

    // **A `break` out of a `try` body drops its handler on the way.** Left behind, it would name an
    // instruction in a block nothing is running any more, and the next fault anywhere in the program
    // would be restored into it.
    var k = e.handlers

    while k > handlers
        put(e, PopHandler, at)
        k -= 1
end unwind_to

// -- entry ----------------------------------------------------------------------------------------

// Which file is being compiled, as an index into the unit's sources.
//
// **Module storage, for the same reason `current_source` is**: a chunk is made deep inside
// `compile_expr`, which has no business carrying a file down to it, and the answer is the same for
// everything one call to `compile_module` emits. The machine's copy is the run-time twin of this.
private var compiling_source: usize = 0

// -- types -----------------------------------------------------------------------------------------

// Every type any module has declared so far, and where.
//
// **Filled as each module compiles, which is why no pre-pass is needed**: modules are compiled in
// post-order, so by the time a file that imports something is compiled, everything it imports has
// already registered whatever it declared.
private var known_source: Buf[usize] = buf()
private var known_name: Buf[string] = buf()
private var known_pat: Buf[Pattern] = buf()
private var known_public: Buf[bool] = buf()

// The types the file being compiled may name: its own, and the exported ones it imported.
private var visible_names: Buf[string] = buf()
private var visible_pats: Buf[Pattern] = buf()

// What was wrong with the program, found while compiling rather than while parsing.
//
// **The compiler had nothing to complain WITH until types existed.** Everything it could object to
// before then was either a parse error or something a `FailWith` could carry to run time; a name in
// a pattern that turns out to be a binding where a type was wanted is neither -- it is known while
// compiling and there is no value to attach it to. `run` folds these in with the parser's.
private var compile_faults: Report = report()
private var compile_fault_srcs: Buf[usize] = buf()

// Whether anything was wrong, for the caller that has to decide not to run the program.
compile_went_wrong() -> bool = compile_faults.has_errors()

compile_report() -> Report = compile_faults
compile_report_srcs() -> Buf[usize] = compile_fault_srcs

// Not `private`: `check.sysl` reports through this channel too, so a static complaint stops the
// program exactly as one raised here does.
complain_here(at: Span, message: string)
    compile_faults.add(error(at, message))
    compile_fault_srcs.push(compiling_source)

// The names this file imported that turned out to be TYPES rather than values.
//
// **They must not be compiled into a binding.** A type has no runtime existence, so the module it
// came from has no field of that name to take -- the import is satisfied entirely by the resolution
// that already happened while the patterns were compiled.
private var imported_types: Buf[string] = buf()

// Forget everything, for the next program.
reset_types()
    known_source.clear()
    known_name.clear()
    known_pat.clear()
    known_public.clear()
    visible_names.clear()
    visible_pats.clear()
    imported_types.clear()
    compile_faults = report()
    compile_fault_srcs.clear()

private declared_in(src: usize, name: string, want_public: bool) -> Option[Pattern]
    for i in 0..<known_name.len()
        if known_source.at(i) == src && known_name.at(i) == name
            if want_public && !known_public.at(i) then return None

            return Some(known_pat.at(i))

    None
end declared_in

// What `Point` stands for in the file being compiled, if anything does.
private visible_type(name: string) -> Option[Pattern]
    for i in 0..<visible_names.len()
        if visible_names.at(i) == name then return Some(visible_pats.at(i))

    None
end visible_type

// How deep a type may be resolved through other types before slate calls it a circle.
private const MaxTypeDepth: usize = 32

// A pattern with every name that stands for a type replaced by what that type stands for.
//
// **A bare name in pattern position is a BINDING unless it names something**, which is sysl's rule
// for a nullary variant and is exactly the rule here -- so `p is Point` is a shape test where a
// `Point` was declared and binds a variable where none was, with no new syntax either way.
// Not `private`: `check.sysl` reads an annotation back off the check it was desugared into, and
// needs the same resolution the compiler applies.
resolve_pattern(pat: Pattern, depth: usize) -> Pattern
    if depth >= MaxTypeDepth then return pat

    *pat.kind match
        Bind(name) ->
            visible_type(name) match
                Some(found) -> resolve_pattern(found, depth + 1)
                None -> pat
        At(name, inner) -> pattern(pat.span, PatKind.At(name, resolve_pattern(inner, depth)))
        ArrayPat(items, open, rest) ->
            var out: Buf[Pattern] = buf()

            for i in 0..<items.len()
                out.push(resolve_pattern(items.at(i), depth))

            pattern(pat.span, ArrayPat(out, open, rest))
        ObjectPat(keys, values) ->
            var out: Buf[Pattern] = buf()

            for i in 0..<values.len()
                out.push(resolve_pattern(values.at(i), depth))

            pattern(pat.span, ObjectPat(keys, out))
        OrPat(alts) ->
            var out: Buf[Pattern] = buf()

            for i in 0..<alts.len()
                val one = resolve_pattern(alts.at(i), depth)

                // **The parser deferred this and here is where it can be answered.** A bare name in
                // an alternative is a type where one was declared -- `Point | null` -- and a binding
                // otherwise, which would leave a name bound down one path and not the other.
                if binds(one)
                    complain_here(alts.at(i).span, "an alternative of a pattern may not bind a name -- write a type where one was meant, or a literal")

                out.push(one)

            pattern(pat.span, OrPat(out))
        _ -> pat
end resolve_pattern

// A pattern into the unit's table, resolved first.
private intern_resolved(u: *Unit, pat: Pattern) -> usize = intern_pattern(u, resolve_pattern(pat, 0))

// Record what a module declared, and work out what it may name.
//
// **A file sees its own types whether or not they were exported, and an imported one only where
// `export type` was written** -- which is the same rule every other name in slate follows.
private open_types(u: *Unit, prog: Program, src: usize)
    for i in 0..<prog.type_names.len()
        known_source.push(src)
        known_name.push(prog.type_names.at(i))
        known_pat.push(prog.type_pats.at(i))
        known_public.push(prog.type_public.at(i))

    visible_names.clear()
    visible_pats.clear()
    imported_types.clear()

    for i in 0..<prog.type_names.len()
        visible_names.push(prog.type_names.at(i))
        visible_pats.push(prog.type_pats.at(i))

    check_type_shapes(prog)

    for i in 0..<prog.stmts.len()
        *prog.stmts.at(i).kind match
            ImportNames(path, _, names, locals) ->
                val from = resolve_import(u.sources.at(src).name, path)

                for j in 0..<u.module_paths.len()
                    if u.module_paths.at(j) == from
                        for k in 0..<names.len()
                            declared_in(u.chunks.at(u.modules.at(j)).source, names.at(k), true) match
                                Some(found) ->
                                    visible_names.push(locals.at(k))
                                    visible_pats.push(found)
                                    imported_types.push(locals.at(k))
                                None -> ()
            _ -> ()
end open_types

// One file to a chunk of its own, answering the module index other files name it by.
//
// **Every module is compiled the same way and the entry is simply the last one**, which is what
// makes a program of one file a program of one module rather than a special case.
//
// **A module's value is its exports and not its last statement.** The statements run for their
// effect, their value is dropped, and what the chunk answers is an object built out of the names the
// file marked `export` -- so a module is an ordinary object, `util.double` is an ordinary field
// selection, and the collector needs to know nothing new.
//
// **The object is a snapshot taken when the file finishes.** An `export var` that the module changes
// afterwards is not seen changing from outside, which is where this parts company with TypeScript's
// live bindings -- and is the honest reading of "a module is an object".
compile_module(u: *Unit, prog: Program, src: usize, name: string, is_entry: bool) -> usize
    val at = u.chunks.len()
    var params: Buf[string] = buf()

    compiling_source = src
    open_types(u, prog, src)

    // **The static check runs before the code is emitted, and after the types are open.** It reports
    // through `compile_faults` like everything else here, so a complaint from it stops the program
    // exactly as a parse error does -- and it has to be after `open_types` because an annotation
    // naming a declared type cannot be read until that type is registered.
    check_program(prog)
    u.chunks.push(Chunk(buf(), params, name, false, src))

    // **The top level is not async, so top-level `await` is refused.** node draws the same line for a
    // script, and lifting it would mean the whole program becoming a coroutine -- which is a real
    // design, and one to make on purpose rather than by leaving a flag `true` here.
    var e = fresh_emit(false)

    compile_stmts(u, &e, prog.stmts, point(0))
    push_n(&e, Pop, point(0), 1, 0)

    // **Only the file that was asked for registers its tests.** A test file imports the module it
    // tests, so registering every module's would run the imported file's tests again -- once as its
    // own entry and once more for each file importing it.
    if is_entry
        for i in 0..<prog.tests.len()
            val t = intern_str(u, prog.tests.at(i))

            push_n(&e, LoadName(t), point(0), 0, 1)
            push_n(&e, DefineTest(t), point(0), 1, 0)

    for i in 0..<prog.exports.len()
        val k = intern_str(u, prog.exports.at(i))

        push_n(&e, PushStr(k), point(0), 0, 1)
        push_n(&e, LoadName(k), point(0), 0, 1)

    push_n(&e, MakeObject(prog.exports.len()), point(0), prog.exports.len() * 2, 1)
    put(&e, Ret, point(0))

    var c = u.chunks.at(at)

    c.code = e.code
    u.chunks.set(at, c)
    u.modules.push(at)
    u.module_paths.push(name)
    u.modules.len() - 1
end compile_module

// A function body to a chunk of its own, answering where it landed.
private compile_chunk(u: *Unit, params: Buf[string], body: Expr, name: string, is_async: bool) -> usize
    // The slot is claimed before the body is compiled, so a function that calls itself finds a chunk
    // index that already exists.
    val at = u.chunks.len()

    // Every chunk a compilation makes belongs to the file being compiled, which `compile_module`
    // named before it started.
    u.chunks.push(Chunk(buf(), params, name, is_async, compiling_source))

    var e = fresh_emit(is_async)

    compile_expr(u, &e, body)
    put(&e, Ret, body.span)

    var c = u.chunks.at(at)

    c.code = e.code
    u.chunks.set(at, c)
    at
end compile_chunk

// -- statements -----------------------------------------------------------------------------------

// A run of statements, leaving the last one's value.
compile_stmts(u: *Unit, e: *Emit, stmts: Buf[Stmt], at: Span)
    push_n(e, PushNil, at, 0, 1)

    for i in 0..<stmts.len()
        push_n(e, Pop, stmts.at(i).span, 1, 0)
        push_n(e, Tick, stmts.at(i).span, 0, 0)
        compile_stmt(u, e, stmts.at(i))
end compile_stmts

private compile_stmt(u: *Unit, e: *Emit, s: Stmt)
    val at = s.span

    *s.kind match
        Val(name, init) ->
            compile_expr(u, e, init)
            push_n(e, DeclareVal(intern_str(u, name)), at, 1, 0)
            push_n(e, PushNil, at, 0, 1)
        Var(name, init) ->
            compile_expr(u, e, init)
            push_n(e, DeclareVar(intern_str(u, name)), at, 1, 0)
            push_n(e, PushNil, at, 0, 1)
        Unpack(pat, init, immutable) ->
            compile_expr(u, e, init)

            // Interned through `resolve_pattern` like every other pattern, so a declared type
            // stands in a destructuring binding exactly as it stands in a `match` arm.
            push_n(e, Unpack(intern_resolved(u, pat), immutable), at, 1, 0)
            push_n(e, PushNil, at, 0, 1)
        Def(name, params, body, is_async) ->
            val c = compile_chunk(u, params, body_at(body), name, is_async)

            push_n(e, DefineFn(intern_str(u, name), c), at, 0, 0)
            push_n(e, PushNil, at, 0, 1)
        Eval(x) -> compile_expr(u, e, x)
        Assign(op, target, value) -> compile_assign(u, e, op, target, value, at)
        MultiAssign(op, targets, values) -> compile_multi_assign(u, e, op, targets, values, at)
        Return(value) ->
            value match
                Some(x) -> compile_expr(u, e, x)
                None -> push_n(e, PushNil, at, 0, 1)

            put(e, Ret, at)

            // Nothing after a `return` runs, but the block it sits in still has to typecheck as
            // leaving one value, so the counter is told what the machine would have had.
            e.sp = e.sp - 1
            push_n(e, PushNil, at, 0, 1)
        TypeDecl(_, _) ->
            // A type has no runtime existence: the resolution happened while this was compiled.
            push_n(e, PushNil, at, 0, 1)
        CheckType(name, declared, pat) ->
            // **AN ANNOTATION THAT NAMES NOTHING WOULD CHECK NOTHING, SILENTLY.** A bare name in
            // pattern position is a binding where it names no type, and a binding matches anything --
            // so `f(x: string)` accepted every value and bound `string` inside `f`, `str` being
            // slate's word. A check that quietly passes is worse than no check, because the reader
            // believes it.
            val shape = resolve_pattern(pat, 0)

            first_binding(shape) match
                Some(loose) -> complain_here(at, s"`${loose}` is not a type, so `${name}: ${loose}` would check nothing${instead_of(loose)}")
                None -> ()

            push_n(e, Op.CheckType(intern_str(u, name), intern_str(u, declared), intern_pattern(u, shape)), at, 0, 0)
            push_n(e, PushNil, at, 0, 1)
        Break(label, value) -> jump_out(u, e, at, true, label, value)
        Continue(label) -> jump_out(u, e, at, false, label, None)

        // **An import is three ordinary instructions per name and no new machinery.** The module is
        // already an object sitting in a slot, so taking a name out of it is the same `GetField` a
        // program writes for itself, and binding it is the same `DeclareVal` a `val` uses.
        //
        // Every path here resolved while loading -- a file that did not, or that does not export
        // what was asked of it, has already stopped the run with a diagnostic -- so a lookup that
        // fails now is a compiler bug and is emitted as one.
        ImportNames(path, _, names, locals) ->
            module_index(u, path) match
                Some(m) ->
                    for i in 0..<names.len()
                        // A type came in when the file was opened and has nothing to bind: the
                        // module has no field of that name, a type never having been a value.
                        if !is_imported_type(locals.at(i))
                            push_n(e, PushModule(m), at, 0, 1)
                            push_n(e, GetField(intern_str(u, names.at(i))), at, 1, 1)
                            push_n(e, DeclareVal(intern_str(u, locals.at(i))), at, 1, 0)
                None -> push_n(e, FailWith(intern_str(u, s"the module `${path}` was never loaded")), at, 0, 0)

            push_n(e, PushNil, at, 0, 1)
        ImportAll(path, _, alias) ->
            module_index(u, path) match
                Some(m) ->
                    push_n(e, PushModule(m), at, 0, 1)
                    push_n(e, DeclareVal(intern_str(u, alias)), at, 1, 0)
                None -> push_n(e, FailWith(intern_str(u, s"the module `${path}` was never loaded")), at, 0, 0)

            push_n(e, PushNil, at, 0, 1)
end compile_stmt

// **A DECLARED TYPE IS A SHAPE, NOT A DESTRUCTURING.** A type is a named pattern, so nothing stopped
// one holding a bare name -- and a bare name binds. `type Tagged = { x: n }` then introduced `n` at
// every site that used the type, including out of an `is` into the surrounding scope, which is action
// at a distance from a declaration that reads as a shape.
//
// **It is also what the union rule already said.** An alternative may not bind, for the same reason;
// a whole type being allowed to was the inconsistency.
//
// Checked here rather than while parsing for the reason everything about types is: a bare name is a
// type where one was declared, and which it is cannot be known until they are all registered.
private check_type_shapes(prog: Program)
    for i in 0..<prog.type_names.len()
        val name = prog.type_names.at(i)
        val at = prog.type_pats.at(i).span

        first_binding(resolve_pattern(prog.type_pats.at(i), 0)) match
            Some(loose) ->
                // A name still standing after resolution that IS a type is one the resolver gave up
                // on, which happens only when a type is written in terms of itself.
                if visible_type(loose).is_some() || loose == name
                    complain_here(at, s"`${name}` is written in terms of itself, and a type is a shape a value is tested against rather than one that nests without end")
                else
                    complain_here(at, s"a type is a shape, so `${name}` may not bind `${loose}` -- a name written inside a type is introduced wherever the type is used, which is not what a declaration that reads as a shape should do")
            None -> ()
end check_type_shapes

// What somebody who wrote a name slate does not know probably meant.
//
// **slate used the short forms until the day it stopped**, so `str`, `num`, `int`, `bool` and `fn`
// are all worth guessing at; `float`, `double` and `any` are what another language would have taught
// somebody instead. A guess at the moment of the mistake is worth more than a list in a manual.
private instead_of(name: string) -> string
    if name == "str" then return " -- slate's word is `string`"
    if name == "num" then return " -- slate's word is `number`"
    if name == "int" then return " -- slate's word is `integer`"
    if name == "bool" then return " -- slate's word is `boolean`"
    if name == "fn" then return " -- slate's word is `function`"
    if name == "float" || name == "double" then return " -- slate's word is `real`"
    " -- declare it with `type`, or name one of null, boolean, integer, real, number, string, array, object, function"
end instead_of

private is_imported_type(name: string) -> bool
    for i in 0..<imported_types.len()
        if imported_types.at(i) == name then return true

    false
end is_imported_type

// Which module a path written in the file being compiled names.
//
// **It resolves the path the same way the loader did, from the same two strings**, rather than
// having the loader hand a table down -- there is one rule for what a path means and it lives in
// `module.sysl`, so asking it twice cannot disagree with itself.
private module_index(u: *Unit, raw: string) -> Option[usize]
    val want = resolve_import(u.sources.at(compiling_source).name, raw)

    for i in 0..<u.module_paths.len()
        if u.module_paths.at(i) == want then return Some(i)

    None
end module_index

// `x = e`, and `x += e` and the rest.
//
// **A compound form evaluates its place ONCE**, which is the whole reason it is not desugared into
// `x = x + e`: `xs[next()] += 1` calls `next` a single time. The place's parts are computed, copied
// with `DupAt` for the read, and the copies underneath are what the write consumes.
private compile_assign(u: *Unit, e: *Emit, op: Tok, target: Expr, value: Expr, at: Span)
    val plain = op == Assign

    *target.kind match
        Name(n) ->
            val k = intern_str(u, n)

            if !plain then push_n(e, LoadName(k), target.span, 0, 1)

            compile_expr(u, e, value)

            if !plain then push_n(e, BinaryOp(op), at, 2, 1)

            push_n(e, StoreName(k), target.span, 1, 0)
        Field(obj, name, _) ->
            val k = intern_str(u, name)

            compile_expr(u, e, obj)

            if !plain
                push_n(e, Dup, target.span, 0, 1)
                push_n(e, GetField(k), target.span, 1, 1)

            compile_expr(u, e, value)

            if !plain then push_n(e, BinaryOp(op), at, 2, 1)

            push_n(e, SetField(k), target.span, 2, 0)
        Index(t, key) ->
            compile_expr(u, e, t)
            compile_expr(u, e, key)

            if !plain
                push_n(e, DupAt(1), target.span, 0, 1)
                push_n(e, DupAt(1), target.span, 0, 1)
                push_n(e, GetIndex, target.span, 2, 1)

            compile_expr(u, e, value)

            if !plain then push_n(e, BinaryOp(op), at, 2, 1)

            push_n(e, SetIndex, target.span, 3, 0)
        _ -> push_n(e, FailWith(intern_str(u, "this cannot be assigned to")), at, 0, 0)

    push_n(e, PushNil, at, 0, 1)
end compile_assign

// `a, b = b, a`.
//
// **Every value is computed before any place is written**, which is what makes the swap a swap. They
// stay on the stack while the writes happen, and each write reaches back down to the one it wants --
// so nothing needs a temporary the program could name.
private compile_multi_assign(u: *Unit, e: *Emit, op: Tok, targets: Buf[Expr], values: Buf[Expr], at: Span)
    val n = values.len()

    for i in 0..<n
        compile_expr(u, e, values.at(i))

    // How far below the top the value for target `i` sits, before that target's own parts are pushed.
    for i in 0..<targets.len()
        if i >= n then break

        val deep = n - 1 - i
        val target = targets.at(i)

        *target.kind match
            Name(name) ->
                val k = intern_str(u, name)

                if op != Assign
                    push_n(e, LoadName(k), target.span, 0, 1)
                    push_n(e, DupAt(deep + 1), target.span, 0, 1)
                    push_n(e, BinaryOp(op), at, 2, 1)
                else
                    push_n(e, DupAt(deep), target.span, 0, 1)

                push_n(e, StoreName(k), target.span, 1, 0)
            Field(obj, name, _) ->
                val k = intern_str(u, name)

                compile_expr(u, e, obj)

                if op != Assign
                    push_n(e, Dup, target.span, 0, 1)
                    push_n(e, GetField(k), target.span, 1, 1)
                    push_n(e, DupAt(deep + 2), target.span, 0, 1)
                    push_n(e, BinaryOp(op), at, 2, 1)
                else
                    push_n(e, DupAt(deep + 1), target.span, 0, 1)

                push_n(e, SetField(k), target.span, 2, 0)
            Index(t, key) ->
                compile_expr(u, e, t)
                compile_expr(u, e, key)

                if op != Assign
                    push_n(e, DupAt(1), target.span, 0, 1)
                    push_n(e, DupAt(1), target.span, 0, 1)
                    push_n(e, GetIndex, target.span, 2, 1)
                    push_n(e, DupAt(deep + 3), target.span, 0, 1)
                    push_n(e, BinaryOp(op), at, 2, 1)
                else
                    push_n(e, DupAt(deep + 2), target.span, 0, 1)

                push_n(e, SetIndex, target.span, 3, 0)
            _ -> push_n(e, FailWith(intern_str(u, "this cannot be assigned to")), at, 0, 0)

    for i in 0..<n
        push_n(e, Pop, at, 1, 0)

    push_n(e, PushNil, at, 0, 1)
end compile_multi_assign

// `break` and `continue`, which have to leave the loop as they found it.
//
// **A `break` leaves its value where the loop's own would have gone**, which is why the value is
// compiled AFTER the unwind: everything the loop had is dropped first, and what is pushed onto the
// bare stack is what the loop answers.
private jump_out(u: *Unit, e: *Emit, at: Span, breaking: bool, label: string, value: Option[Expr])
    val which = loop_named(e, label)

    if which == 0
        val word = if label != ""
            s"no enclosing loop is called `'${label}`"
        elif breaking then
            "`break` outside a loop"
        else
            "`continue` outside a loop"

        push_n(e, FailWith(intern_str(u, word)), at, 0, 0)
        push_n(e, PushNil, at, 0, 1)
        return
    end if

    val slot = which - 1
    var frame = e.loops.at(slot)
    val sp = e.sp
    val scopes = e.scopes
    val handlers = e.handlers

    if breaking
        // **The value is compiled BEFORE anything is unwound**, and that is not an optimisation: the
        // scopes the unwind is about to close are the ones holding the names it may use, so
        // `for x in xs do if p(x) then break x` would find `x` already gone. It is then slid beneath
        // the values the loop had and they are dropped from above it.
        value match
            Some(x) -> compile_expr(u, e, x)
            None -> push_n(e, PushNil, at, 0, 1)

        val extra = sp - frame.sp

        if extra > 0
            push_n(e, RotUp(extra), at, 0, 0)

            for i in 0..<extra
                push_n(e, Pop, at, 1, 0)

        var d = e.scopes

        while d > frame.scopes
            put(e, PopScope, at)
            d -= 1

        e.scopes = frame.scopes

        var k = e.handlers

        while k > frame.handlers
            put(e, PopHandler, at)
            k -= 1

        e.handlers = frame.handlers
    else
        unwind_to(e, frame.sp, frame.scopes, frame.handlers, at)

    val j = put(e, Jump(0), at)

    if breaking then frame.breaks.push(j) else frame.continues.push(j)
    e.loops.set(slot, frame)

    // Control never falls through, so the counters go back to what the following code expects.
    e.sp = sp
    e.scopes = scopes
    e.handlers = handlers
    push_n(e, PushNil, at, 0, 1)
end jump_out

private open_loop(e: *Emit, label: string)
    e.loops.push(LoopFrame(e.sp, e.scopes, e.handlers, label, buf(), buf()))

// Which enclosing loop a `break` or a `continue` means, counted from the innermost.
//
// **The empty string means "the nearest one", not "the one with no name"**, so a labelled loop is
// still what an unlabelled `break` inside it leaves.
private loop_named(e: *Emit, label: string) -> usize
    if e.loops.len() == 0 then return 0

    var i = e.loops.len()

    while i > 0
        i -= 1

        if label == "" || e.loops.at(i).label == label then return i + 1

    0
end loop_named

private close_loop(e: *Emit, continue_to: usize, break_to: usize)
    val frame = e.loops.at(e.loops.len() - 1)

    for i in 0..<frame.breaks.len()
        patch(e, frame.breaks.at(i), break_to)

    for i in 0..<frame.continues.len()
        patch(e, frame.continues.at(i), continue_to)

    e.loops.truncate(e.loops.len() - 1)
end close_loop

// **A loop is an expression, and a `break` is what gives it a value other than null.** The two exits
// therefore meet at one place with one value already on the stack: the normal one runs any `else` and
// pushes null, and a `break` arrives with its own value already pushed.
private compile_while(u: *Unit, e: *Emit, label: string, cond: Expr, body: Expr, otherwise: Option[Expr], at: Span)
    val top = here(e)

    open_loop(e, label)
    compile_expr(u, e, cond)

    val out = push_n(e, JumpIfFalse(0), at, 1, 0)

    compile_body(u, e, body)
    put(e, Jump(top), at)
    patch(e, out, here(e))
    compile_else(u, e, otherwise, at)

    // **A `break` lands just past what the normal exit pushed, having pushed its own value instead.**
    // Both exits therefore leave exactly one value and no jump is needed to join them.
    close_loop(e, top, here(e))
end compile_while

// What a loop answers when it finished on its own.
//
// **The `else`'s value IS the loop's**, which was checked against sysl rather than assumed: a `for`
// over nothing with an `else -1` answers `-1` there. That is what makes the search idiom read --
// `break` gives the answer that was found and `else` gives the one for having found none -- and it
// is why this leaves a value where a Python-style clause run for effect would not.
private compile_else(u: *Unit, e: *Emit, otherwise: Option[Expr], at: Span)
    otherwise match
        Some(x) -> compile_expr(u, e, x)
        None -> push_n(e, PushNil, at, 0, 1)

private compile_loop(u: *Unit, e: *Emit, label: string, body: Expr, at: Span)
    val top = here(e)

    open_loop(e, label)
    compile_body(u, e, body)
    put(e, Jump(top), at)

    // There is no normal exit from a `loop`, so the only way out already carries a value -- and the
    // counter is told about it here, there being no instruction that pushed one.
    close_loop(e, top, here(e))
    e.sp += 1
end compile_loop

// **`continue` goes to the TEST, not to the top**, which is the whole reason this is not desugared
// into a `while`: the body has already run once by the time the condition is first asked.
private compile_do_while(u: *Unit, e: *Emit, label: string, body: Expr, cond: Expr, otherwise: Option[Expr], at: Span)
    val top = here(e)

    open_loop(e, label)
    compile_body(u, e, body)

    val test = here(e)

    compile_expr(u, e, cond)

    val out = push_n(e, JumpIfFalse(0), at, 1, 0)

    put(e, Jump(top), at)
    patch(e, out, here(e))
    compile_else(u, e, otherwise, at)
    close_loop(e, test, here(e))
end compile_do_while

private compile_for(u: *Unit, e: *Emit, label: string, binding: Pattern, iter: Expr, body: Expr, otherwise: Option[Expr], at: Span)
    compile_expr(u, e, iter)

    // **`IterInit` KEEPS the subject and pushes a counter beside it**, so it gives one and takes
    // none. Accounting it as taking the subject left the counter unmatched: the compiler believed
    // the stack was one shallower than it was, the single `Pop` below removed only the counter, and
    // every `for` a program ran stranded its subject for the rest of the enclosing chunk. Fifty
    // thousand turns of a loop containing one was a SIGSEGV with no output.
    push_n(e, IterInit, at, 0, 1)

    val top = here(e)

    open_loop(e, label)

    // Answers the next element, or jumps out when there is none.
    val out = push_n(e, IterNext(0), at, 0, 1)

    push_n(e, PushScope, at, 0, 0)
    e.scopes += 1
    // **One name costs one instruction, as it always did.** Only a head that takes the element
    // apart pays for the pattern machinery, and a `for` that binds one name emits nothing new.
    *binding.kind match
        Bind(name) -> push_n(e, DeclareVal(intern_str(u, name)), at, 1, 0)
        _ -> push_n(e, Unpack(intern_resolved(u, binding), true), at, 1, 0)

    compile_stmt_body(u, e, body)

    push_n(e, PopScope, at, 0, 0)
    e.scopes -= 1
    put(e, Jump(top), at)
    patch(e, out, here(e))

    // The counter and the subject both go -- two values, which is what `IterInit` left -- and they go
    // *before* the answer is built, so that the two Pops cannot take it.
    push_n(e, Pop, at, 1, 0)
    push_n(e, Pop, at, 1, 0)
    compile_else(u, e, otherwise, at)

    val done = put(e, Jump(0), at)

    // **A `break` arrives with the walk still on the stack under its value**, having unwound only to
    // the frame's own height -- so the value is slid beneath them and they are dropped from above it.
    val brk = here(e)
    val after = e.sp

    push_n(e, RotUp(2), at, 0, 0)
    push_n(e, Pop, at, 1, 0)
    push_n(e, Pop, at, 1, 0)

    // The two paths meet, so the counter follows the one that fell through rather than this one.
    e.sp = after
    close_loop(e, top, brk)
    patch(e, done, here(e))
end compile_for

// A loop body, run for effect: its value is discarded each turn.
private compile_body(u: *Unit, e: *Emit, body: Expr)
    push_n(e, PushScope, body.span, 0, 0)
    e.scopes += 1
    compile_stmt_body(u, e, body)
    push_n(e, PopScope, body.span, 0, 0)
    e.scopes -= 1
end compile_body

// The inside of a loop body, with its own scope already open.
private compile_stmt_body(u: *Unit, e: *Emit, body: Expr)
    *body.kind match
        Block(stmts) ->
            compile_stmts(u, e, stmts, body.span)
            push_n(e, Pop, body.span, 1, 0)
        _ ->
            compile_expr(u, e, body)
            push_n(e, Pop, body.span, 1, 0)
end compile_stmt_body

// `try ... catch e ...`, and the `x catch e -> y` that is the same thing.
//
// **The two branches meet at one stack height and one scope depth**, which is the whole of the
// bookkeeping: the body leaves a value and so does the handler, and the machine restores everything
// else from the record `PushHandler` wrote.
//
//     PushHandler(catch)   the world here is what a fault is given back
//     <body>               leaves one value
//     PopHandler           nothing faulted, so nothing is owed
//     Jump(end)
//   catch:                 the machine has cut back and pushed the fault
//     PushScope            the handler's name is its own
//     DeclareVal(e)        which takes the fault off the stack
//     <handler>            leaves one value
//     PopScope
//   end:
private compile_try(u: *Unit, e: *Emit, body: Expr, name: string, handler: Expr, at: Span)
    val guard = push_n(e, PushHandler(0), at, 0, 0)
    val sp = e.sp
    val scopes = e.scopes

    e.handlers += 1

    compile_expr(u, e, body)
    push_n(e, PopHandler, at, 0, 0)
    e.handlers -= 1

    val over = put(e, Jump(0), at)

    patch(e, guard, here(e))

    // **The counters are set to what the MACHINE will have at the handler, not to what fell through
    // here.** Control does not reach this point by running the instruction before it: the machine
    // arrives having cut the stack back to where `PushHandler` stood and pushed the fault on top.
    e.sp = sp + 1
    e.scopes = scopes

    push_n(e, PushScope, at, 0, 0)
    e.scopes += 1
    push_n(e, DeclareVal(intern_str(u, name)), at, 1, 0)
    compile_expr(u, e, handler)
    push_n(e, PopScope, at, 0, 0)
    e.scopes -= 1
    patch(e, over, here(e))
end compile_try

// -- expressions ----------------------------------------------------------------------------------

compile_expr(u: *Unit, e: *Emit, x: Expr)
    val at = x.span

    *x.kind match
        IntLit(v) -> push_n(e, PushInt(v), at, 0, 1)
        RealLit(v) -> push_n(e, PushReal(v), at, 0, 1)
        BoolLit(v) -> push_n(e, PushBool(v), at, 0, 1)
        StrLit(v) -> push_n(e, PushStr(intern_str(u, v)), at, 0, 1)
        NullLit -> push_n(e, PushNil, at, 0, 1)
        UndefinedLit -> push_n(e, PushUndefined, at, 0, 1)
        Name(n) -> push_n(e, LoadName(intern_str(u, n)), at, 0, 1)
        Unary(op, rhs) ->
            compile_expr(u, e, rhs)
            push_n(e, UnaryOp(op), at, 1, 1)
        Binary(op, lhs, rhs) -> compile_binary(u, e, op, lhs, rhs, at)
        Compare(operands, ops) -> compile_compare(u, e, operands, ops, at)
        Range(lo, hi, inclusive) ->
            lo match
                Some(x) -> compile_expr(u, e, x)
                None -> ()

            hi match
                Some(x) -> compile_expr(u, e, x)
                None -> ()

            val ends: usize = (if lo.is_some() then 1 else 0) + (if hi.is_some() then 1 else 0)

            push_n(e, MakeRange(inclusive, lo.is_some(), hi.is_some()), at, ends, 1)
        IsPattern(subject, pat, negated) ->
            compile_expr(u, e, subject)
            push_n(e, IsPat(intern_resolved(u, pat), negated), at, 1, 1)
        IncDec(target, up, before) -> compile_inc_dec(u, e, target, up, before, at)
        Call(callee, args) ->
            // **`o.m(a)` is compiled as one thing, because that is the only form a receiver is
            // passed for.** Everything else -- a name, a call answering a function, an element of an
            // array -- is an ordinary call of whatever it evaluated to.
            *callee.kind match
                Field(target, name, optional) ->
                    compile_expr(u, e, target)

                    // `o?.m(a)` does not evaluate its arguments where there is nothing to call the
                    // method on, which is what makes the guard worth having over a test afterwards.
                    val short = if optional then Some(push_n(e, JumpIfAbsentKeep(0), at, 0, 0)) else None

                    for i in 0..<args.len()
                        compile_expr(u, e, args.at(i))

                    push_n(e, CallMethod(intern_str(u, name), args.len()), at, args.len() + 1, 1)

                    short match
                        Some(where) ->
                            val done = put(e, Jump(0), at)

                            patch(e, where, here(e))
                            push_n(e, Pop, at, 1, 0)
                            push_n(e, PushNil, at, 0, 1)
                            patch(e, done, here(e))
                        None -> ()
                _ ->
                    compile_expr(u, e, callee)

                    for i in 0..<args.len()
                        compile_expr(u, e, args.at(i))

                    push_n(e, CallFn(args.len()), at, args.len() + 1, 1)
        Index(t, key) ->
            compile_expr(u, e, t)
            compile_expr(u, e, key)
            push_n(e, GetIndex, at, 2, 1)
        Field(t, name, optional) ->
            compile_expr(u, e, t)

            if !optional
                push_n(e, GetField(intern_str(u, name)), at, 1, 1)
            else
                // **The two paths leave one value where one stood**, so the counter needs no
                // correction: `GetField` takes one and gives one, and the other arm drops the
                // nullish subject and pushes `null` in its place.
                val short = push_n(e, JumpIfAbsentKeep(0), at, 0, 0)

                push_n(e, GetField(intern_str(u, name)), at, 1, 1)

                val done = put(e, Jump(0), at)

                patch(e, short, here(e))
                push_n(e, Pop, at, 1, 0)
                push_n(e, PushNil, at, 0, 1)
                patch(e, done, here(e))
        Interp(pieces) ->
            for i in 0..<pieces.len()
                compile_expr(u, e, pieces.at(i))

            push_n(e, Join(pieces.len()), at, pieces.len(), 1)
        ArrayRepeat(value, count) ->
            compile_expr(u, e, value)
            compile_expr(u, e, count)
            push_n(e, Repeat, at, 2, 1)
        WithFields(base, keys, values) ->
            compile_expr(u, e, base)

            for i in 0..<keys.len()
                push_n(e, PushStr(intern_str(u, keys.at(i))), at, 0, 1)
                compile_expr(u, e, values.at(i))

            push_n(e, WithObject(keys.len()), at, keys.len() * 2 + 1, 1)
        ArrayLit(items) ->
            for i in 0..<items.len()
                compile_expr(u, e, items.at(i))

            push_n(e, MakeArray(items.len()), at, items.len(), 1)
        ObjectLit(keys, _, values) ->
            for i in 0..<keys.len()
                push_n(e, PushStr(intern_str(u, keys.at(i))), at, 0, 1)
                compile_expr(u, e, values.at(i))

            push_n(e, MakeObject(keys.len()), at, keys.len() * 2, 1)
        Lambda(params, body, is_async) ->
            val c = compile_chunk(u, params, body_at(body), "a function", is_async)

            push_n(e, MakeClosure(c), at, 0, 1)
        Await(inner) ->
            compile_expr(u, e, inner)

            // **Refused the way `break` outside a loop is**, with an instruction that faults where it
            // stands: the tree is compiled without a report to write into, and a fault carrying this
            // span points at the same character a parse error would have.
            if e.is_async
                push_n(e, Op.Await, at, 1, 1)
            else
                push_n(e, FailWith(intern_str(u, "`await` belongs in an `async` function")), at, 1, 1)
        Block(stmts) ->
            push_n(e, PushScope, at, 0, 0)
            e.scopes += 1
            compile_stmts(u, e, stmts, at)
            push_n(e, PopScope, at, 0, 0)
            e.scopes -= 1
        Ensures(value, declared, pat) ->
            compile_expr(u, e, value)

            val shape = resolve_pattern(pat, 0)

            // **Pointed at the ANNOTATION and not at the body.** `at` here is the wrapped
            // expression, which is the whole function; the pattern's own span is the `-> Nope` a
            // reader has to change.
            first_binding(shape) match
                Some(loose) -> complain_here(pat.span, s"`${loose}` is not a type, so `-> ${loose}` would check nothing${instead_of(loose)}")
                None -> ()

            push_n(e, CheckResult(intern_str(u, declared), intern_pattern(u, shape)), at, 0, 0)
        TryCatch(body, name, handler) -> compile_try(u, e, body, name, handler, at)
        IfExpr(cond, then_branch, else_branch) -> compile_if(u, e, cond, then_branch, else_branch, at)
        MatchExpr(subject, arms) -> compile_match(u, e, subject, arms, at)
        While(label, cond, body, otherwise) -> compile_while(u, e, label, cond, body, otherwise, at)
        For(label, binding, iter, body, otherwise) -> compile_for(u, e, label, binding, iter, body, otherwise, at)
        Loop(label, body) -> compile_loop(u, e, label, body, at)
        DoWhile(label, body, cond, otherwise) -> compile_do_while(u, e, label, body, cond, otherwise, at)

        // A program with one of these in it is never run: `parse` reports first.
        Bad -> push_n(e, FailWith(intern_str(u, "this expression did not parse")), at, 0, 1)
end compile_expr

// A chain of comparisons, which is one comparison.
//
// **The middle operand is evaluated once and kept on the stack**, which is the whole difference from
// `a < b && b < c` written out: `a < f() < c` calls `f` a single time. Each step keeps a copy of the
// right operand to be the next step's left, and a step that answers false jumps to a common exit
// where whatever is still standing is dropped.
private compile_compare(u: *Unit, e: *Emit, operands: Buf[Expr], ops: Buf[Tok], at: Span)
    compile_expr(u, e, operands.at(0))

    var short: Buf[usize] = buf()
    val last = ops.len() - 1

    for i in 0..<ops.len()
        compile_expr(u, e, operands.at(i + 1))

        if i == last
            push_n(e, BinaryOp(ops.at(i)), at, 2, 1)
        else
            // Keep the right operand: it is the next step's left.
            push_n(e, Dup, at, 0, 1)
            push_n(e, RotUp(2), at, 0, 0)
            push_n(e, BinaryOp(ops.at(i)), at, 2, 1)
            short.push(push_n(e, JumpIfFalse(0), at, 1, 0))

    val done = put(e, Jump(0), at)

    // Reached with one value on the stack -- the operand the failing step had kept -- so the height
    // is the same on both paths and the counter needs no correction.
    val fail = here(e)

    for i in 0..<short.len()
        patch(e, short.at(i), fail)

    push_n(e, Pop, at, 1, 0)
    push_n(e, PushBool(false), at, 0, 1)
    patch(e, done, here(e))
end compile_compare

// `++x`, `x++`, and the two decrements.
//
// **Prefix and postfix differ only in WHICH value is kept**, so both are the same four moves: read
// the old value, put the one to keep out of the way underneath, copy it back to be written, write.
private compile_inc_dec(u: *Unit, e: *Emit, target: Expr, up: bool, before: bool, at: Span)
    val op: Tok = if up then Plus else Minus

    *target.kind match
        Name(n) ->
            val k = intern_str(u, n)

            push_n(e, LoadName(k), target.span, 0, 1)

            if before
                push_n(e, PushInt(1), at, 0, 1)
                push_n(e, BinaryOp(op), at, 2, 1)
                push_n(e, Dup, at, 0, 1)
            else
                push_n(e, Dup, at, 0, 1)
                push_n(e, PushInt(1), at, 0, 1)
                push_n(e, BinaryOp(op), at, 2, 1)

            push_n(e, StoreName(k), target.span, 1, 0)
        Field(obj, name, _) ->
            val k = intern_str(u, name)

            compile_expr(u, e, obj)
            push_n(e, Dup, target.span, 0, 1)
            push_n(e, GetField(k), target.span, 1, 1)

            if before
                push_n(e, PushInt(1), at, 0, 1)
                push_n(e, BinaryOp(op), at, 2, 1)

            // The value to keep goes under the receiver, and a copy of it comes back up to be stored.
            push_n(e, RotUp(1), at, 0, 0)
            push_n(e, DupAt(1), at, 0, 1)

            if !before
                push_n(e, PushInt(1), at, 0, 1)
                push_n(e, BinaryOp(op), at, 2, 1)

            push_n(e, SetField(k), target.span, 2, 0)
        Index(t, key) ->
            compile_expr(u, e, t)
            compile_expr(u, e, key)
            push_n(e, DupAt(1), target.span, 0, 1)
            push_n(e, DupAt(1), target.span, 0, 1)
            push_n(e, GetIndex, target.span, 2, 1)

            if before
                push_n(e, PushInt(1), at, 0, 1)
                push_n(e, BinaryOp(op), at, 2, 1)

            push_n(e, RotUp(2), at, 0, 0)
            push_n(e, DupAt(2), at, 0, 1)

            if !before
                push_n(e, PushInt(1), at, 0, 1)
                push_n(e, BinaryOp(op), at, 2, 1)

            push_n(e, SetIndex, target.span, 3, 0)
        _ ->
            push_n(e, FailWith(intern_str(u, "only a name, a field or an element may be stepped")), at, 0, 1)
end compile_inc_dec

// **`&&` and `||` answer the operand that decided**, which is slate's rule and not sysl's -- so the
// jump keeps what it tested rather than popping it.
private compile_binary(u: *Unit, e: *Emit, op: Tok, lhs: Expr, rhs: Expr, at: Span)
    if op == AndAnd || op == OrOr || op == QQ
        compile_expr(u, e, lhs)

        val skip = if op == AndAnd
            push_n(e, JumpIfFalseKeep(0), at, 0, 0)
        elif op == OrOr
            push_n(e, JumpIfTrueKeep(0), at, 0, 0)
        else
            // `??` asks a different question from `||`: `0 ?? 1` is `0`, because zero is not absent.
            push_n(e, JumpIfPresentKeep(0), at, 0, 0)

        push_n(e, Pop, at, 1, 0)
        compile_expr(u, e, rhs)
        patch(e, skip, here(e))
        return

    compile_expr(u, e, lhs)
    compile_expr(u, e, rhs)
    push_n(e, BinaryOp(op), at, 2, 1)
end compile_binary

private compile_if(u: *Unit, e: *Emit, cond: Expr, then_branch: Expr, else_branch: Option[Expr], at: Span)
    compile_expr(u, e, cond)

    val otherwise = push_n(e, JumpIfFalse(0), at, 1, 0)
    val before = e.sp

    push_n(e, PushScope, at, 0, 0)
    e.scopes += 1
    compile_expr(u, e, then_branch)
    push_n(e, PopScope, at, 0, 0)
    e.scopes -= 1

    val done = put(e, Jump(0), at)

    patch(e, otherwise, here(e))
    e.sp = before

    push_n(e, PushScope, at, 0, 0)
    e.scopes += 1

    else_branch match
        Some(x) -> compile_expr(u, e, x)
        None -> push_n(e, PushNil, at, 0, 1)

    push_n(e, PopScope, at, 0, 0)
    e.scopes -= 1
    patch(e, done, here(e))
end compile_if

// **An arm gets a scope of its own, thrown away when it does not take.** A pattern binds as it goes,
// so a failed arm has already written names, and the only thing keeping them out of the next arm is
// somewhere separate to write them.
private compile_match(u: *Unit, e: *Emit, subject: Expr, arms: Buf[Arm], at: Span)
    compile_expr(u, e, subject)

    val subject_sp = e.sp
    var leaves: Buf[usize] = buf()

    for i in 0..<arms.len()
        val arm = arms.at(i)

        push_n(e, PushScope, at, 0, 0)
        e.scopes += 1

        // Reads the subject where it lies and answers whether it took; the subject stays, because the
        // arm after this one wants it.
        push_n(e, TestPat(intern_resolved(u, arm.pattern)), at, 0, 1)

        val missed = push_n(e, JumpIfFalse(0), at, 1, 0)
        var guard_missed: usize = 0
        var guarded = false

        arm.guard match
            Some(g) ->
                compile_expr(u, e, g)
                guard_missed = push_n(e, JumpIfFalse(0), at, 1, 0)
                guarded = true
            None -> ()

        // It took: the subject is finished with, and the body's value takes its place.
        push_n(e, Pop, at, 1, 0)
        compile_expr(u, e, arm.body)
        push_n(e, PopScope, at, 0, 0)
        e.scopes -= 1
        leaves.push(put(e, Jump(0), at))

        // It did not: give the scope back and try the next one, with the subject still in place.
        patch(e, missed, here(e))

        if guarded then patch(e, guard_missed, here(e))

        push_n(e, PopScope, at, 0, 0)
        e.scopes += 1
        e.scopes -= 1
        e.sp = subject_sp

    push_n(e, FailNoArm, at, 0, 0)
    e.sp = subject_sp

    for i in 0..<leaves.len()
        patch(e, leaves.at(i), here(e))
end compile_match
