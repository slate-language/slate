module dev.slatelang.slate
@tests

import sysl.buf.{Buf, buf}
import sysl.text.Search

// What `fuse` in `emit.sysl` writes into a chunk, and what the fused arms in `run_fused.sysl` do
// with it.
//
// **`tests/lang/fused.sl` asks whether the ANSWERS are right and this asks whether the FUSION
// HAPPENED**, and neither question stands in for the other: an emitter that quietly stopped fusing
// would print exactly the right thing for ever and leave the item measuring nothing, while one that
// fused the wrong pair would be caught by the answers alone. That is `tests_operators.sysl`'s own
// division and it is here for its reason.
//
// **THE INVARIANT THAT MAKES A FUSION SAFE IS A SHAPE THIS FILE CAN SEE.** `fuse` overwrites the
// first slot of a pair and leaves the second standing, so anything that jumps at the second runs
// the instruction the emitter wrote. That means a `LoadSlot2` is always followed in the buffer by a
// `LoadSlot`, a `LessJumpIfFalse` by a `JumpIfFalse`, and so on -- and a pass that started deleting
// what it folded would fail the tests below rather than failing a program one release later.

// The instruction names of the chunk of that name, longest first.
//
// **The largest match is the real one**: `compile_module` compiles a file twice, so a top-level
// definition has two chunks of one name and the declarations-only copy holds a subset. This is
// `tests_operators.sysl`'s helper, which is `private` there as it is here -- `private` in sysl is
// per file, and a second copy is cheaper than making a test helper part of the module's surface.
private fused_names(program: string, name: string) -> Buf[string]
    out(program)

    var best: Buf[string] = buf()
    var found = false

    for i in 0..<running_unit().chunks.len()
        if running_unit().chunks.at(i).name != name then continue

        found = true

        val code = running_unit().chunks.at(i).code
        var names: Buf[string] = buf()

        for k in 0..<code.len()
            names.push(op_label(code.at(k).op))

        if names.len() > best.len() then best = names

    assert(found, s"no chunk is called `${name}`")
    best
end fused_names

// How many of that instruction the chunk carries.
private how_many(names: Buf[string], want: string) -> usize
    var n: usize = 0

    for i in 0..<names.len()
        if names.at(i) == want then n += 1

    n

// Whether every `want` in the chunk is directly followed by `tail` -- which is the whole of what
// makes a fusion legal, the tail being what a jump into the middle of the group runs.
private always_followed_by(names: Buf[string], want: string, tail: string) -> bool
    for i in 0..<names.len()
        if names.at(i) != want then continue
        if i + 1 >= names.len() then return false
        if names.at(i + 1) != tail then return false

    true
end always_followed_by

// -- the emitter folds the pairs it says it folds --------------------------------------------------

@test
TWO_LOADS_AND_A_LOAD_WITH_A_LITERAL_ARE_EACH_ONE_INSTRUCTION()
    val names = fused_names("f(a, b) =\n    val x = a + b\n    val y = a + 1\n\n    x + y\n\nprint(f(1, 2))", "f")

    assert(how_many(names, "LoadSlot2") > 0, "`a + b` did not fold its two loads")
    assert(how_many(names, "LoadSlotInt") > 0, "`a + 1` did not fold its load and its literal")

    // **The folded instruction is still there**, which is what a jump into the middle of the group
    // runs. A pass that deleted it would have to renumber every jump target in the chunk.
    assert(always_followed_by(names, "LoadSlot2", "LoadSlot"), "a `LoadSlot2` is not followed by the load it folded")
    assert(always_followed_by(names, "LoadSlotInt", "PushInt"), "a `LoadSlotInt` is not followed by the literal it folded")
end TWO_LOADS_AND_A_LOAD_WITH_A_LITERAL_ARE_EACH_ONE_INSTRUCTION

@test
A_LITERAL_TOO_WIDE_FOR_A_PAYLOAD_IS_LEFT_AS_A_PAIR_AND_STILL_ADDS()
    // **A `LoadSlotInt` holds a slot and a literal in the eight bytes an instruction's payload is**,
    // so the literal it folds is a 32-bit one and a wider one is not folded at all. Nothing about
    // the program changes: the pair stays the `LoadSlot` and the `PushInt` it always was, and runs
    // as such. Both halves are asked here, since an emitter that folded it anyway would be caught
    // by neither alone -- the shape would be wrong and the answer would still look right.
    val narrow = fused_names("f(a) =\n    val x = a + 1\n    x\n\nprint(f(1))", "f")
    val wide = fused_names("f(a) =\n    val x = a + 4294967296\n    x\n\nprint(f(1))", "f")

    assert(how_many(narrow, "LoadSlotInt") > 0, "a literal that fits a payload was not folded")
    assert_eq(how_many(wide, "LoadSlotInt"), 0, "a literal too wide for a payload was folded anyway")
    assert_eq(out("f(a) = a + 4294967296\nprint(f(1))"), "4294967297")

    // The edge is where it is claimed to be: the largest literal that fits is folded and the next
    // one up is not.
    assert(how_many(fused_names("f(a) =\n    val x = a + 2147483647\n    x\n\nprint(f(1))", "f"), "LoadSlotInt") > 0,
           "the largest literal a payload holds was not folded")
    assert_eq(how_many(fused_names("f(a) =\n    val x = a + 2147483648\n    x\n\nprint(f(1))", "f"), "LoadSlotInt"), 0,
              "the first literal too wide for a payload was folded")
end A_LITERAL_TOO_WIDE_FOR_A_PAYLOAD_IS_LEFT_AS_A_PAIR_AND_STILL_ADDS

@test
A_SUM_INTO_A_LOCAL_AND_A_COMPARISON_BEFORE_A_JUMP_ARE_EACH_ONE_INSTRUCTION()
    val names = fused_names("f(n) =\n    var t = 0\n    var i = 0\n\n    while i < n\n        t = t + i\n        i = i + 1\n\n    t\n\nprint(f(3))", "f")

    assert(how_many(names, "AddStoreSlot") > 0, "`t = t + i` did not fold its store")
    assert(how_many(names, "LessJumpIfFalse") > 0, "`while i < n` did not fold its jump")
    assert(always_followed_by(names, "AddStoreSlot", "StoreSlot"), "an `AddStoreSlot` is not followed by the store it folded")
    assert(always_followed_by(names, "LessJumpIfFalse", "JumpIfFalse"), "a `LessJumpIfFalse` is not followed by the jump it folded")
end A_SUM_INTO_A_LOCAL_AND_A_COMPARISON_BEFORE_A_JUMP_ARE_EACH_ONE_INSTRUCTION

@test
A_FOLDED_PAIR_IS_NEVER_OVERLAPPED_SO_THREE_LOADS_LEAVE_ONE_STANDING()
    // `[a, b, c]` is three loads in a row. The scan advances by two over a pair, so the first two
    // fold and the third is an ordinary `LoadSlot` -- rather than two groups sharing an instruction,
    // where the second group's head would be a slot the first had already overwritten.
    val names = fused_names("f(a, b, c) = [a, b, c]\n\nprint(f(1, 2, 3))", "f")

    assert_eq(how_many(names, "LoadSlot2"), 1, "three loads did not fold into exactly one pair")
end A_FOLDED_PAIR_IS_NEVER_OVERLAPPED_SO_THREE_LOADS_LEAVE_ONE_STANDING

@test
NO_FOLDED_PAIR_NAMES_A_RESOLVED_MODULE_DEFINITION()
    // **`settle_module_defs` puts a `LoadName` back over a `LoadDef` AT A REMEMBERED POSITION**, so
    // a fusion whose head were a `LoadDef` would have its slot overwritten by that put-back and a
    // fusion whose tail were one would step over a read the compiler had just corrected. Neither is
    // possible while no pattern names `LoadDef`, and this is what says so about the code that is
    // actually emitted: a file whose top-level definition is read beside a local and a literal.
    val names = fused_names("add3(n) = n + 3\n\nf(a) =\n    val g = add3\n\n    g(a) + a + 1\n\nprint(f(1))", "f")

    assert(how_many(names, "LoadDef") + how_many(names, "LoadName") > 0, "the program resolved no definition at all")
    assert(always_followed_by(names, "LoadSlot2", "LoadSlot"), "a `LoadSlot2` folded something that is not a load")
    assert(always_followed_by(names, "LoadSlotInt", "PushInt"), "a `LoadSlotInt` folded something that is not a literal")
end NO_FOLDED_PAIR_NAMES_A_RESOLVED_MODULE_DEFINITION

// -- a jump really does land inside a group ---------------------------------------------------------

// Where every jump in the chunk of that name is aimed.
private jump_targets(program: string, name: string) -> Buf[usize]
    out(program)

    var best: Buf[usize] = buf()
    var longest: usize = 0

    for i in 0..<running_unit().chunks.len()
        if running_unit().chunks.at(i).name != name then continue

        val code = running_unit().chunks.at(i).code

        if code.len() < longest then continue

        longest = code.len()

        var aims: Buf[usize] = buf()

        for k in 0..<code.len()
            code.at(k).op match
                Jump(to) -> aims.push(to)
                JumpIfFalse(to) -> aims.push(to)
                JumpIfTrueKeep(to) -> aims.push(to)
                JumpIfFalseKeep(to) -> aims.push(to)
                JumpIfPresentKeep(to) -> aims.push(to)
                JumpIfAbsentKeep(to) -> aims.push(to)
                LessJumpIfFalse(to) -> aims.push(to)
                _ -> ()

        best = aims

    best
end jump_targets

@test
A_JUMP_AIMED_INSIDE_A_FOLDED_GROUP_IS_WHAT_THE_SHORT_CIRCUIT_TESTS_EXERCISE()
    // **A test that could not have failed is not evidence**, so this is the witness that
    // `tests/lang/fused.sl`'s short-circuit programs really do aim a jump at the SECOND instruction
    // of a fused pair rather than merely looking as though they might. `a || c` leaves `a` where it
    // is truthy and jumps over `c` to what follows -- and what follows is a load the emitter has
    // already folded onto the load of `c`, so the target sits one past a `LoadSlot2`.
    val program = "f(a, c, d) = (a || c) + d\n\nprint(f(1, 99, 5))"
    val names = fused_names(program, "f")
    val aims = jump_targets(program, "f")

    var inside = false

    for i in 0..<aims.len()
        val to = aims.at(i)

        if to > 0 && to < names.len() && names.at(to - 1).starts_with("LoadSlot2")
            inside = true

    assert(inside, "no jump in this chunk lands on the second instruction of a folded pair")
end A_JUMP_AIMED_INSIDE_A_FOLDED_GROUP_IS_WHAT_THE_SHORT_CIRCUIT_TESTS_EXERCISE

// -- a fault inside a fused instruction points where it always pointed ------------------------------

@test
A_FAULT_IN_A_FOLDED_SUM_QUOTES_THE_LINE_THE_ADDITION_WAS_WRITTEN_ON()
    // The addition is what is wrong, and the caret has to stand under it rather than under the
    // store the fusion swallowed or the statement that contains both.
    val said = fails("f() =\n    var t = 1\n\n    t = t + {}\n    t\n\nprint(f())")

    assert(said.contains("t = t + {}"), said)
    assert(said.contains("4"), said)
end A_FAULT_IN_A_FOLDED_SUM_QUOTES_THE_LINE_THE_ADDITION_WAS_WRITTEN_ON

@test
AN_ABSENCE_WRITTEN_TO_A_LOCAL_BY_A_FOLDED_SUM_IS_STILL_REFUSED()
    // **This is the one path whose sentence belongs to the STORE and not to the addition**, which is
    // why `fused_add_store_slot` hands the value back rather than writing it: the fused arm has to
    // read the span out of the instruction it stepped over.
    val said = fails("class Holder\n    var box\n\n    +(self, o) = self.box.missing\n\nf() =\n    var t = Holder({})\n\n    t = t + t\n    t\n\nprint(f())")

    assert(said.contains("undefined"), said)
end AN_ABSENCE_WRITTEN_TO_A_LOCAL_BY_A_FOLDED_SUM_IS_STILL_REFUSED

@test
A_FAULT_IN_A_FOLDED_COMPARISON_QUOTES_THE_COMPARISON()
    val said = fails("f(a) =\n    if a < 1\n        \"less\"\n    else\n        \"more\"\n\nprint(f({}))")

    assert(said.contains("a < 1"), said)
end A_FAULT_IN_A_FOLDED_COMPARISON_QUOTES_THE_COMPARISON

// -- the machine and the VM are handed down, and these are what a stale one would break -------------

// **`run_frames` ASKS `current()` ONCE AND HANDS WHAT IT GOT TO EVERY HOT HELPER**, because that
// accessor is a thread-local read and the helpers below run once per instruction: `pop_on`/`peek_on`
// take the `*Machine`, `keepable_on` and `maybe_collect_on` take the `*Vm`, and the fused arms take
// the machine rather than asking again. What makes that sound is that nothing the runtime itself
// calls changes which VM is current -- `enter`/`leave` belong to a test or an embedder -- and that a
// park swaps what the machine FIELD holds rather than where it lives, so a pointer to it is still a
// pointer to the running machine after a nested line of execution has come and gone.
//
// **A CACHED POINTER THAT WENT STALE WOULD BE A WRONG ANSWER AND NOT A FAULT**, which is why every
// test here asserts what a program PRINTED. `tests/lang/fused.sl` asks the same questions of both back
// ends; what is only askable here is the same programs against a heap small enough that the collector
// runs between one step and the next.

// A heap that collects several times inside one of these loops, and the one the rest of the suite
// runs against. `tests_native_args.sysl` names the same two numbers for the same reason.
private const Crowded: usize = 1048576
private const Roomy: usize = 268435456

// What a program printed, run against a heap that collects under it. The limit is put back whatever
// happened, so nothing after this runs in a megabyte by accident.
private out_in_small_heap(text: string) -> string
    set_heap_limit(Crowded)

    val said = out(text)

    set_heap_limit(Roomy)
    said
end out_in_small_heap

// Something to allocate with, so that a collection lands between two steps of the generator rather
// than at a boundary the program chose.
private const Allocating: string = "deep(n) = if n == 0 then { a: 1, b: [1, 2, 3], c: \"xxxxxxxx\" } else deep(n - 1)\n"

@test
A_GENERATOR_STEPPED_FROM_A_FOLDED_LOOP_ANSWERS_WITH_THE_COLLECTOR_RUNNING_UNDER_IT()
    // Two operand stacks, three hundred crossings, and a collection landing wherever it lands. The
    // driver's `while k < 300` is a `LessJumpIfFalse` and its `total = total + step.value` an
    // `AddStoreSlot`, and the generator's body carries the same two -- so both sides of every
    // crossing are running the arms that were handed a machine rather than asking for one.
    val counted = out_in_small_heap(Allocating + "countingUp(limit) =\n    var i = 0\n\n    while i < limit\n        deep(150)\n        yield i * 2\n        i = i + 1\n\nval g = countingUp(300)\nvar total = 0\nvar k = 0\n\nwhile k < 300\n    val step = g.next()\n\n    total = total + step.value\n    deep(150)\n    k = k + 1\n\nprint(total)")

    assert_eq(counted, "89700")

@test
TWO_GENERATORS_INTERLEAVED_UNDER_A_COLLECTION_KEEP_THEIR_OWN_STACKS()
    // A driver that read a value off whichever stack happened to be installed would answer the same
    // number twice, which the sum of the two counters apart is what catches.
    val mixed = out_in_small_heap(Allocating + "countingUp(limit) =\n    var i = 0\n\n    while i < limit\n        deep(120)\n        yield i * 2\n        i = i + 1\n\nval a = countingUp(200)\nval b = countingUp(200)\nvar total = 0\nvar k = 0\n\nwhile k < 200\n    total = total + a.next().value\n    total = total + b.next().value * 3\n    deep(120)\n    k = k + 1\n\nprint(total)")

    // Each generator yields 0, 2, ... 398, which sums to 39,800; the second is counted three times.
    assert_eq(mixed, "159200")

@test
A_BUILTIN_RUNNING_A_CALLBACK_INSIDE_A_FOLDED_LOOP_LEAVES_THE_STACK_WHERE_IT_WAS()
    // A nested `run_frames` runs on the SAME stack, so a helper handed the wrong machine -- or a loop
    // that leaked one cell a turn -- runs the stack away rather than saying anything. Ten thousand
    // turns is what makes a one-cell drift arithmetic rather than luck.
    val walked = out_in_small_heap(Allocating + "f(n) =\n    var t = 0\n    var i = 0\n\n    while i < n\n        t = t + reduce(map([1, 2, 3], x -> deep(80).a - 1 + x), (a, b) -> a + b, 0)\n        i = i + 1\n\n    t\n\nprint(f(10000))")

    assert_eq(walked, "60000")

@test
AN_ABSENCE_REFUSED_INSIDE_A_CALLBACK_QUOTES_THE_LINE_IT_WAS_WRITTEN_ON()
    // **The absence check is where the VM is read for the file a fault belongs to**, and a nested run
    // is where that could go wrong: the callback's chunk is entered from inside a builtin, so the
    // sentence below proves the refusal read the source the RUNNING chunk set rather than the one the
    // outermost call happened to leave standing.
    val said = fails("val holder = { a: 1 }\n\npick(x) =\n    val gone = holder.missing\n\n    gone\n\nprint(map([1, 2], x -> pick(x)))")

    assert(said.contains("undefined"), said)
    assert(said.contains("val gone = holder.missing"), said)
end AN_ABSENCE_REFUSED_INSIDE_A_CALLBACK_QUOTES_THE_LINE_IT_WAS_WRITTEN_ON

// -- the runs: a loop's whole head and tail, and a difference into a local --------------------------

// A counted loop whose body ends in a sum and whose counter steps by a literal.
private const Counting: string = "f(n) =\n    var t = 0\n    var i = 0\n\n    while i < 10\n        t = t - n\n        i = i + 1\n\n    t\n\nprint(f(2))"

@test
A_COUNTED_LOOP_HEAD_AND_ITS_INCREMENT_ARE_EACH_ONE_INSTRUCTION()
    val names = fused_names(Counting, "f")

    assert_eq(out(Counting), "-20")
    assert_eq(how_many(names, "TickSlotIntLess"), 1, "`while i < 10` did not fold its head")
    assert_eq(how_many(names, "SlotIntAddStoreJump"), 1, "`i = i + 1` did not fold with the back edge")
    assert_eq(how_many(names, "SubStoreSlot"), 1, "`t = t - n` did not fold its store")

    // **Every slot of a run stays standing, and the run's inner pairs are folded where they stand**,
    // so a jump landing inside one finds the pair form: the head's `LoadSlotInt` at its second slot
    // and its `LessJumpIfFalse` at its fourth, the tail's `AddStoreSlot` at its third.
    assert(always_followed_by(names, "TickSlotIntLess", "LoadSlotInt"), "a loop head does not stand over its load")
    assert(always_followed_by(names, "LoadSlotInt", "PushInt"), "a load stands over no literal")
    assert(always_followed_by(names, "LessJumpIfFalse", "JumpIfFalse"), "a comparison stands over no jump")
    assert(always_followed_by(names, "SlotIntAddStoreJump", "PushInt"), "a loop tail does not stand over its literal")
    assert(always_followed_by(names, "AddStoreSlot", "StoreSlot"), "a sum stands over no store")
    assert(always_followed_by(names, "SubStoreSlot", "StoreSlot"), "a difference stands over no store")
end A_COUNTED_LOOP_HEAD_AND_ITS_INCREMENT_ARE_EACH_ONE_INSTRUCTION

@test
A_SUM_INTO_ANOTHER_LOCAL_THAT_ENDS_A_LOOP_BODY_IS_LEFT_AS_A_PAIR()
    // The counter steps first, so the body ends in a sum into another local -- `t = t + i` -- which
    // is not an increment of one slot. **Folding it with the back edge measured nothing** and was
    // struck, so it stays the `AddStoreSlot` pair and the `Jump` after it; `SlotIntAddStoreJump`
    // folds only a slot added to ITSELF.
    val program = "f() =\n    var t = 0\n    var i = 0\n\n    while i < 4\n        i = i + 1\n        t = t + i\n\n    t\n\nprint(f())"
    val names = fused_names(program, "f")

    assert_eq(out(program), "10")
    assert_eq(how_many(names, "SlotIntAddStoreJump"), 0, "a sum into another local was folded as an increment")
    assert(how_many(names, "AddStoreSlot") >= 2, "`i = i + 1` and `t = t + i` did not both fold their stores")
    assert(always_followed_by(names, "AddStoreSlot", "StoreSlot"), "a sum stands over no store")
end A_SUM_INTO_ANOTHER_LOCAL_THAT_ENDS_A_LOOP_BODY_IS_LEFT_AS_A_PAIR

@test
A_STEP_OR_A_SLOT_TOO_WIDE_FOR_SIXTEEN_BITS_IS_LEFT_TO_THE_PAIRS()
    // **A tail carries the slot, the step and the target in eight bytes**, so the first two get
    // sixteen bits each; a wider step is not folded at all and runs as the pairs it always was.
    val narrow = "f() =\n    var i = 0\n\n    while i < 100000\n        i = i + 32767\n\n    i\n\nprint(f())"
    val wide = "f() =\n    var i = 0\n\n    while i < 100000\n        i = i + 32768\n\n    i\n\nprint(f())"

    assert_eq(how_many(fused_names(narrow, "f"), "SlotIntAddStoreJump"), 1, "the widest step that fits was not folded")
    assert_eq(how_many(fused_names(wide, "f"), "SlotIntAddStoreJump"), 0, "a step too wide for the payload was folded")
    assert_eq(out(narrow), "131068")
    assert_eq(out(wide), "131072")
end A_STEP_OR_A_SLOT_TOO_WIDE_FOR_SIXTEEN_BITS_IS_LEFT_TO_THE_PAIRS

@test
A_FAULT_IN_A_FOLDED_LOOP_HEAD_QUOTES_THE_COMPARISON()
    // The run carries the `Tick`'s span, and the comparison's sentence has to point at the `<` --
    // which is the one slot the slow path reads back.
    val said = fails("anything(v) = v\n\nf() =\n    var i = anything({})\n\n    while i < 3\n        i = 4\n\n    i\n\nprint(f())")

    assert(said.contains("while i < 3"), said)
end A_FAULT_IN_A_FOLDED_LOOP_HEAD_QUOTES_THE_COMPARISON

@test
A_FAULT_IN_A_FOLDED_LOOP_TAIL_QUOTES_THE_ADDITION()
    val said = fails("anything(v) = v\n\nf() =\n    var s = anything(\"a\")\n\n    while s != \"b\"\n        s = s + 1\n\n    s\n\nprint(f())")

    assert(said.contains("does not apply to a string and an integer"), said)
    assert(said.contains("s = s + 1"), said)
end A_FAULT_IN_A_FOLDED_LOOP_TAIL_QUOTES_THE_ADDITION

@test
A_FAULT_IN_A_FOLDED_DIFFERENCE_QUOTES_THE_SUBTRACTION()
    val said = fails("f() =\n    var t = 1\n\n    t = t - {}\n    t\n\nprint(f())")

    assert(said.contains("t = t - {}"), said)
end A_FAULT_IN_A_FOLDED_DIFFERENCE_QUOTES_THE_SUBTRACTION

@test
A_LOOP_HEAD_COLLECTS_AND_ANSWERS_WITH_A_SMALL_HEAP()
    // **The head's `Tick` is the loop's safe point**, folded into the run: a heap that has to be
    // collected many times inside the loop is what says the safe point still runs every turn.
    val counted = out_in_small_heap(Allocating + "f(n) =\n    var t = 0\n    var i = 0\n\n    while i < n\n        deep(60)\n        t = t + i\n        i = i + 1\n\n    t\n\nprint(f(3000))")

    assert_eq(counted, "4498500")
end A_LOOP_HEAD_COLLECTS_AND_ANSWERS_WITH_A_SMALL_HEAP

// -- a local's field, a product summed, an arm's test, a module variable, a remainder ----------------

// Every instruction name in every chunk the program compiled to, which is how a module's own code is
// reached -- its chunk has no name a test could ask for.
private every_name(program: string) -> Buf[string]
    out(program)

    var names: Buf[string] = buf()

    for i in 0..<running_unit().chunks.len()
        val code = running_unit().chunks.at(i).code

        for k in 0..<code.len()
            names.push(op_label(code.at(k).op))

    names
end every_name

@test
A_LOCALS_FIELD_IS_ONE_INSTRUCTION_AND_FAULTS_AT_THE_FIELD()
    val program = "class P\n    var x\n    var y\n\nf(p, q) =\n    val s = 1\n    p.x + q.y + s\n\nprint(f(P(1, 2), P(3, 4)))"
    val names = fused_names(program, "f")

    assert_eq(out(program), "6")
    assert(how_many(names, "LoadSlotGetField") >= 2, "a local's field did not fold")
    assert(always_followed_by(names, "LoadSlotGetField", "GetField"), "a folded load stands over no field read")

    val said = fails("anything(v) = v\n\nf(p) =\n    val s = 1\n    p.nope + s\n\nprint(f(anything(1)))")

    assert(said.contains("p.nope"), said)
end A_LOCALS_FIELD_IS_ONE_INSTRUCTION_AND_FAULTS_AT_THE_FIELD

@test
A_PRODUCT_SUMMED_IS_ONE_INSTRUCTION_AND_EACH_HALF_FAULTS_ON_ITS_OWN_LINE()
    val program = "f(a, b, c) =\n    val s = 0\n    c + a * b + s\n\nprint(f(3, 4, 5))"
    val names = fused_names(program, "f")

    assert_eq(out(program), "17")
    assert_eq(how_many(names, "MulAdd"), 1, "`c + a * b` did not fold")
    assert(always_followed_by(names, "MulAdd", "Add"), "a folded product stands over no sum")

    // **Overflow in either step takes the long way**, which promotes rather than wrapping.
    assert_eq(out("f(a, b, c) =\n    val s = 0\n    c + a * b + s\n\nprint(f(4611686018427387904, 2, 0) > 0)"), "true")
    assert_eq(out("f(a, b, c) =\n    val s = 0\n    c + a * b + s\n\nprint(f(3, 4, 5.5))"), "17.5")

    // The product's sentence points at the product and the sum's at the sum, on lines of their own.
    val product = fails("anything(v) = v\n\nf(a, c) =\n    val s = 0\n    (c +\n        a * 2) + s\n\nprint(f(anything({}), 1))")
    val sum = fails("anything(v) = v\n\nf(a, c) =\n    val s = 0\n    (c +\n        a * 2) + s\n\nprint(f(1, anything({})))")

    assert(product.contains("a * 2"), product)
    assert(sum.contains("(c +"), sum)
end A_PRODUCT_SUMMED_IS_ONE_INSTRUCTION_AND_EACH_HALF_FAULTS_ON_ITS_OWN_LINE

@test
A_PRODUCT_SUMMED_INTO_A_LOCAL_IS_LEFT_TO_THE_STORE()
    // `t = t + a * b` ends in `Add; StoreSlot`, which writes the cell without a push -- so the product
    // stays on its own and the sum folds with the store.
    val program = "f(a, b) =\n    var t = 1\n    t = t + a * b\n    t\n\nprint(f(3, 4))"
    val names = fused_names(program, "f")

    assert_eq(out(program), "13")
    assert_eq(how_many(names, "MulAdd"), 0, "a product summed into a local was folded ahead of its store")
    assert(how_many(names, "AddStoreSlot") > 0, "the sum into a local did not fold its store")
end A_PRODUCT_SUMMED_INTO_A_LOCAL_IS_LEFT_TO_THE_STORE

@test
A_MATCH_ARMS_TEST_AND_ITS_WAY_OUT_ARE_ONE_INSTRUCTION()
    val program = "f(v) = v match\n    [x, y] -> x + y\n    { a } -> a\n    _ -> 0\n\nprint(f([1, 2]))\nprint(f({ a: 7 }))\nprint(f(5))"
    val names = fused_names(program, "f")

    assert_eq(out(program), "3\n7\n0")
    assert(how_many(names, "TestSlotsJumpIfFalse") >= 2, "an arm's test did not fold with its jump")
    assert(always_followed_by(names, "TestSlotsJumpIfFalse", "JumpIfFalse"), "a folded test stands over no jump")
end A_MATCH_ARMS_TEST_AND_ITS_WAY_OUT_ARE_ONE_INSTRUCTION

@test
A_MODULE_VARIABLE_AND_A_LITERAL_ARE_ONE_INSTRUCTION_AND_GO_BACK_WHEN_REBOUND()
    val program = "var n = 0\nwhile n < 5\n    n = n + 1\nprint(n)"
    val names = every_name(program)

    assert_eq(out(program), "5")
    assert(how_many(names, "LoadCellInt") > 0, "a module variable and a literal did not fold")
    assert(always_followed_by(names, "LoadCellInt", "PushInt"), "a folded cell read stands over no literal")

    // **A spelling a function binds for itself takes every site back to the lookup**, and a folded
    // read is one of them: it goes back to `LoadName`, and the literal behind it is what runs next.
    val rebound = "var n = 0\nbump()\n    n = n + 1\n    n\nown()\n    var n = 9\n    n\nprint(bump() + own())"

    assert_eq(how_many(every_name(rebound), "LoadCellInt"), 0, "a rebound spelling kept its folded cell read")
    assert_eq(out(rebound), "10")
end A_MODULE_VARIABLE_AND_A_LITERAL_ARE_ONE_INSTRUCTION_AND_GO_BACK_WHEN_REBOUND

@test
A_LOCALS_REMAINDER_BY_A_LITERAL_IS_ONE_INSTRUCTION_AND_FAULTS_AT_THE_REMAINDER()
    val program = "f(n) =\n    var odd = 0\n    for i in 0..<n\n        if i % 2 == 1\n            odd = odd + 1\n    odd\n\nprint(f(9))"
    val names = fused_names(program, "f")

    assert_eq(out(program), "4")
    assert(how_many(names, "SlotIntRem") > 0, "`i % 2` did not fold")
    assert(always_followed_by(names, "SlotIntRem", "PushInt"), "a folded remainder stands over no literal")

    val said = fails("f(n) =\n    val s = 0\n    n % 0 + s\n\nprint(f(7))")

    assert(said.contains("n % 0"), said)
    assert_eq(out("f(n) =\n    val s = 0\n    n % 3 + s\n\nprint(f(-7))"), "-1")
    assert(fails("anything(v) = v\n\nf(n) =\n    val s = 0\n    n % 3 + s\n\nprint(f(anything(7.5)))").contains("a remainder is taken of integers"))
end A_LOCALS_REMAINDER_BY_A_LITERAL_IS_ONE_INSTRUCTION_AND_FAULTS_AT_THE_REMAINDER

@test
AN_EQUALITY_BEFORE_A_JUMP_IS_LEFT_AS_A_PAIR()
    // **`Equal; JumpIfFalse` folded measured nothing** (+0.04% on the mean, +1.3% on `strwalk`) and
    // was struck, so it stays the two instructions it always was.
    val program = "f(a, b) =\n    if a == b\n        \"same\"\n    else\n        \"different\"\n\nprint(f(1, 1))\nprint(f(1, 1.0))\nprint(f(\"x\", \"x\"))\nprint(f([1], [1]))\nprint(f(1, \"1\"))"
    val names = fused_names(program, "f")

    assert_eq(out(program), "same\nsame\nsame\nsame\ndifferent")
    assert(how_many(names, "Equal") > 0, "`a == b` was folded")
    assert(always_followed_by(names, "Equal", "JumpIfFalse"), "an equality stands over no jump")
end AN_EQUALITY_BEFORE_A_JUMP_IS_LEFT_AS_A_PAIR

// -- the safe point stays its own instruction outside a counted loop's head ---------------------------

@test
A_SAFE_POINT_BEFORE_A_LOAD_OR_A_WALK_IS_LEFT_ON_ITS_OWN()
    // **Folding it into the load or the step after it was built and measured nothing** (-0.30% on the
    // mean, inside the noise the wrapper added), so an expression body's head, a `while` over two
    // locals and a `for`'s head all keep a bare `Tick` -- one each, which is the rule.
    val body = fused_names("f(v) = -v\n\nprint(f(2))", "f")
    val two = fused_names("f(n) =\n    var i = 0\n    while i < n\n        i = i + 1\n    i\n\nprint(f(3))", "f")
    val walk = fused_names("f(xs) =\n    var t = 0\n    for x in xs\n        t = t + x\n    t\n\nprint(f([1, 2, 3]))", "f")

    assert_eq(how_many(body, "Tick"), 1)
    assert(always_followed_by(body, "Tick", "LoadSlot"), "an expression body's safe point stands over no load")
    assert(always_followed_by(walk, "Tick", "IterNext"), "a `for`'s safe point stands over no step")
    assert(how_many(two, "Tick") >= 1)

    assert_eq(out("f(v) = -v\n\nprint(f(2))"), "-2")
    assert_eq(out("f(n) =\n    var i = 0\n    while i < n\n        i = i + 1\n    i\n\nprint(f(3))"), "3")
    assert_eq(out("f(xs) =\n    var t = 0\n    for x in xs\n        t = t + x\n    t\n\nprint(f([1, 2, 3]))"), "6")
end A_SAFE_POINT_BEFORE_A_LOAD_OR_A_WALK_IS_LEFT_ON_ITS_OWN

@test
A_LOCALS_LOAD_AFTER_A_SAFE_POINT_STILL_PAIRS_ONWARD()
    val literal = fused_names("f(v) = v + 1\n\nprint(f(2))", "f")
    val field = fused_names("f(p) = p.x\n\nprint(f({ x: 4 }))", "f")

    assert_eq(how_many(literal, "Tick"), 1)
    assert(how_many(literal, "LoadSlotInt") > 0)
    assert(how_many(field, "LoadSlotGetField") > 0)
    assert_eq(out("f(p) = p.x\n\nprint(f({ x: 4 }))"), "4")
end A_LOCALS_LOAD_AFTER_A_SAFE_POINT_STILL_PAIRS_ONWARD

@test
A_SAFE_POINT_IN_A_WALK_A_LOOP_AND_A_RECURSION_STILL_COLLECTS_EVERY_TURN()
    // **Each loop allocates on every turn against a heap a megabyte deep**, so the collection the
    // safe point asks for has to happen there or the program runs out.
    val walked = out_in_small_heap(Allocating + "f(xs) =\n    var t = 0\n    for x in xs\n        deep(60)\n        t = t + x\n    t\n\nprint(f(0..<3000))")
    val looped = out_in_small_heap(Allocating + "f(n) =\n    var i = 0\n    var t = 0\n    while i < n\n        deep(60)\n        t = t + i\n        i = i + 1\n    t\n\nprint(f(3000))")
    val recursed = out_in_small_heap(Allocating + "down(n, z) = if n == z then 0 else down(n - 1, z) + (if deep(40) == null then 0 else 1)\n\nprint(down(1000, 0))")

    assert_eq(walked, "4498500")
    assert_eq(looped, "4498500")
    assert_eq(recursed, "1000")
end A_SAFE_POINT_IN_A_WALK_A_LOOP_AND_A_RECURSION_STILL_COLLECTS_EVERY_TURN

@test
A_FAULT_IN_A_FOLDED_WALK_QUOTES_THE_FOR()
    val said = fails("anything(v) = v\n\nf(xs) =\n    var t = 0\n    for x in xs\n        t = t + 1\n    t\n\nprint(f(anything(5)))")

    assert(said.contains("`for` walks an array"), said)
    assert(said.contains("for x in xs"), said)
end A_FAULT_IN_A_FOLDED_WALK_QUOTES_THE_FOR
