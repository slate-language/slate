module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// How the JavaScript back end spells a local whose block READ the same name before declaring it.
//
// **slate binds a name where its declaration stands; JavaScript binds a `let` or `const` for the
// whole block.** So `val x = made()` and then `val made = x + 1` read the outer `made` on the first
// line under the interpreter, and under node the first line is inside the second line's temporal dead
// zone -- `Cannot access 'made' before initialization`. Only a LATER declaration collides in slate,
// and `val g = g()` (a definition named and then run) is an idiom, so the emitted program has to
// keep the outer binding reachable above the line that shadows it.
//
// **The local is spelled differently, never declared with `var`.** `made` becomes `made$7` from the
// line that declares it to the end of its block, and every read above that line is left as `made`,
// which JavaScript then resolves outward exactly as the machine does. A `var` would hoist the local
// over the read instead, which is the same defect wearing a different hat.
//
// **A read inside a function written in the block is DEFERRED, and what it finds is decided when it
// RUNS** -- the interpreter looks the name up at call time, so before the local's declaration has
// executed it finds the outer binding and after it the local. Only DIRECT reads decide whether a
// block needs a new spelling at all; a deferred one decides whether the local is GUARDED:
//
// - **A local with an outer binding that a function in the block mentions is declared at the head
//   of the block**, `let made$7 = $.unbound;`, and its declaration becomes an assignment. A deferred
//   read is then `(made$7 === $.unbound ? made : made$7)`, which asks the question the machine asks
//   at the moment the read runs. A lambda called during the local's own initialiser is the case.
// - **Anything else stays a `const`.** A local with no outer binding has nothing to fall back to --
//   the read is a fault on both hosts -- and one no function mentions has no deferred read, so
//   ordinary code is emitted exactly as it always was.
//
// **Every binder takes the spelling too, not only the declaration.** A parameter, a pattern or a
// nested `val` naming `made` below the declaration shadows it; spelling all of them alike keeps
// JavaScript's scoping the same shape as slate's, so nothing here has to track which binding a read
// lands on. The one thing that is the slate name throughout is what a message says.

// One local given a spelling of its own.
struct Spelling
    // The name the program wrote.
    name: string

    // What the emitted program calls it.
    js: string

    // How many functions deep the block declaring it is, which is what tells a deferred read from a
    // direct one.
    depth: usize

    // Whether its declaration has been written. Above that line a direct read is the OUTER binding's.
    live: bool

    // Whether it was declared at the head of its block holding `$.unbound`, so that a deferred read
    // can ask whether the declaration has run.
    guarded: bool

    // Which open block declared it, counted as `JsSpelling.blocks` counts them.
    block: usize
end Spelling

// What the emitter knows about spellings at the point being written.
struct JsSpelling
    // Every spelling of every block open around this point, innermost last.
    entries: Buf[Spelling]

    // The names the block being written spells afresh.
    early: Buf[string]

    // How many function bodies enclose this point.
    depth: usize

    // How many blocks are open, so the file's own block can be told when it closes.
    blocks: usize

    // The spellings the file's top level gave, kept for its exports once its block has closed.
    top: Buf[Spelling]

    // Every name the blocks open around this point bind, which is what an outer binding is.
    visible: Buf[string]

    // The builtins, which are outer bindings everywhere; read once, when first wanted.
    builtins: Option[Buf[string]]
end JsSpelling

fresh_spelling() -> JsSpelling = JsSpelling(buf(), buf(), 0, 0, buf(), buf(), None)

// The JavaScript name a local is written under at this point, for a binding or a write.
//
// Not `private`: every file of the back end that writes a binding or a read of one asks it.
spelled(j: *Js, name: string) -> string
    val es = j.spelling.entries
    var k = es.len()

    while k > 0
        k -= 1

        val e = es.at(k)

        if e.name == name && (e.live || j.spelling.depth > e.depth) then return e.js

    js_name(name)
end spelled

// The JavaScript expression a READ of a name is written as at this point.
//
// **It differs from `spelled` only for a guarded local read from a function**, which may run before
// the declaration has: the read asks the sentinel, and falls back to whatever the same read would
// have meant without this local -- itself possibly another guarded one further out.
//
// Not `private`: `js_expr.sysl`'s `Name` arm and the patterns in `js_pat.sysl` that look a class up.
read_spelled(j: *Js, name: string) -> string = read_below(j, name, j.spelling.entries.len())

private read_below(j: *Js, name: string, from: usize) -> string
    val es = j.spelling.entries
    var k = from

    while k > 0
        k -= 1

        val e = es.at(k)

        if e.name != name then continue

        if e.guarded && j.spelling.depth > e.depth
            return s"(${e.js} === $$.unbound ? ${read_below(j, name, k)} : ${e.js})"

        if e.live || j.spelling.depth > e.depth then return e.js

    js_name(name)
end read_below

// Whether the block being written declared this name at its head, so its declaration assigns.
//
// Not `private`: `js_stmt.sysl`'s `declaring` asks it.
guarded_here(j: *Js, name: string) -> bool
    val es = j.spelling.entries
    var k = es.len()

    while k > 0
        k -= 1

        val e = es.at(k)

        if e.block != j.spelling.blocks then return false

        if e.name == name then return e.guarded

    false
end guarded_here

// The same question asked once the file's block has closed, which is where its exports are written.
//
// Not `private`: `js.sysl`'s exports and test registrations ask it.
module_spelled(j: *Js, name: string) -> string
    val es = j.spelling.top

    for k in 0..<es.len()
        if es.at(k).name == name then return es.at(k).js

    js_name(name)
end module_spelled

// Give a spelling to every name the run of statements reads directly before the statement that
// declares it, and guard every local a function in the run may read before it is bound. `already`
// is what the block holds before its first statement -- a function's parameters, a binder's names --
// which a read is a read of.
//
// **The guarded locals are declared here**, at the head of the block and before any statement in it
// can run a function that reads one.
//
// Not `private`: `js_stmt.sysl`'s `open_block` asks it.
spell_early(j: *Js, stmts: Buf[Stmt], already: Buf[string])
    var declared = already.copy()
    var reads: Buf[string] = buf()
    var early: Buf[string] = buf()
    var later: Buf[string] = buf()
    var firsts: Buf[string] = buf()

    // **A definition hoists**, so a read above one is a read of it, and it is never respelled.
    hoisted_defs(stmts, &declared)

    for i in 0..<stmts.len()
        scan_early(stmts.at(i), &declared, &reads, &early, &later, &firsts)

    var guarded: Buf[string] = buf()

    for i in 0..<firsts.len()
        val name = firsts.at(i)

        if holds(later, name) && bound_outside(j, name) then guarded.push(name)

    for i in 0..<early.len()
        give_spelling(j, early.at(i), holds(guarded, early.at(i)))

    for i in 0..<guarded.len()
        val name = guarded.at(i)

        if !holds(early, name)
            give_spelling(j, name, true)
            early.push(name)

    for i in 0..<guarded.len()
        line(j, s"let ${spelled_in_block(j, guarded.at(i))} = $$.unbound;")

    j.spelling.early = early
end spell_early

private give_spelling(j: *Js, name: string, guarded: bool)
    j.tmp += 1
    j.spelling.entries.push(Spelling(name, js_name(name) + "$" + s"${j.tmp}", j.spelling.depth, false, guarded, j.spelling.blocks))

// What the block being opened calls a name it has just spelled.
private spelled_in_block(j: *Js, name: string) -> string
    val es = j.spelling.entries
    var k = es.len()

    while k > 0
        k -= 1

        if es.at(k).name == name then return es.at(k).js

    js_name(name)
end spelled_in_block

// Whether something around the block binds this name: a block open around it, or a builtin.
private bound_outside(j: *Js, name: string) -> bool
    if holds(j.spelling.visible, name) then return true

    if j.spelling.builtins.is_none() then j.spelling.builtins = Some(builtin_names())

    holds(j.spelling.builtins.unwrap(), name)
end bound_outside

// The declaration of `name` is being written: from here on a direct read is the block's own.
//
// Not `private`: `js_stmt.sysl`'s `emit_stmt` says so at each declaration it writes.
went_live(j: *Js, name: string)
    if !holds(j.spelling.early, name) then return

    var k = j.spelling.entries.len()

    while k > 0
        k -= 1

        val e = j.spelling.entries.at(k)

        if e.name == name && e.depth == j.spelling.depth
            if !e.live then j.spelling.entries.set(k, Spelling(e.name, e.js, e.depth, true, e.guarded, e.block))

            return
end went_live

// A class's shape, written as the thunk `SShape` works out on first use.
//
// **The thunk is a function, so the names in it are DEFERRED reads** and take the new spelling: the
// shape sits inside the object literal that is the class's own initialiser, above the line where its
// name goes live, and names the class. Read as a direct read, a class declared below a read of the
// outer name would have its shape test against the outer binding instead of itself.
//
// Not `private`: `js_expr.sysl`'s `ShapeLit` arm writes it.
shape_thunk(j: *Js, name: string, pat: Pattern) -> string
    j.spelling.depth += 1

    val made = s"$$.shape(() => ${emit_shape(j, pat)}, ${quoted_js(name)})"

    j.spelling.depth -= 1
    made
end shape_thunk

// One statement of the run: what it reads, then what it declares, in the order they happen.
// `later` gathers every name a function written in it mentions, and `firsts` every name it is the
// first in the block to declare.
//
// **A `Group` is walked statement by statement, because that is the order it binds in.** A `data`
// line is its shared object and then each variant, every variant reading the object above it; an
// annotated `val` is the binding and then its check. So a read of the group's name ABOVE the group is
// a read of the outer binding, and a read inside it after the name is bound is the group's own --
// exactly what an ordinary statement gets.
private scan_early(s: Stmt, declared: *Buf[string], reads: *Buf[string], early: *Buf[string], later: *Buf[string], firsts: *Buf[string])
    *s.kind match
        Group(stmts) ->
            for m in 0..<stmts.len()
                scan_early(stmts.at(m), declared, reads, early, later, firsts)

            return
        _ -> ()

    var here: Buf[string] = buf()

    respellable(s, &here)
    direct_stmt_reads(s, reads, later)

    for n in 0..<here.len()
        val name = here.at(n)

        if holds(*declared, name) then continue

        declared.push(name)
        firsts.push(name)

        if holds(*reads, name) && !holds(*early, name) then early.push(name)
end scan_early

// The names a statement binds that a spelling can be given to: what `val`, `var` and a destructuring
// binding declare, a `class` being a `val` and a `data` line a `Group` of them. A definition hoists
// and an import stands at the top of a file, so neither can be read before it.
private respellable(s: Stmt, here: *Buf[string])
    *s.kind match
        Val(name, _) -> here.push(name)
        Var(name, _) -> here.push(name)
        Unpack(pat, _, _) -> pattern_names(resolve_pattern(pat, 0), here)
        _ -> ()

private hoisted_defs(stmts: Buf[Stmt], into: *Buf[string])
    for i in 0..<stmts.len()
        *stmts.at(i).kind match
            Def(name, _, _, _, _) -> into.push(name)
            Group(inner) -> hoisted_defs(inner, into)
            _ -> ()

// What a statement reads as it runs, leaving out every function body it writes -- whose names go
// to `later` instead.
private direct_stmt_reads(s: Stmt, into: *Buf[string], later: *Buf[string])
    *s.kind match
        Def(_, params, defaults, body, _) -> reachable_from(params, defaults, body, later)
        TypeDecl(_, _) -> ()
        ExternalDecl(_, _) -> ()
        Val(_, init) -> direct_reads(init, into, later)
        Var(_, init) -> direct_reads(init, into, later)
        Unpack(_, init, _) -> direct_reads(init, into, later)
        Using(bind, _) -> direct_stmt_reads(bind, into, later)
        Group(stmts) ->
            for i in 0..<stmts.len()
                direct_stmt_reads(stmts.at(i), into, later)
        Assign(_, target, value) ->
            direct_reads(target, into, later)
            direct_reads(value, into, later)
        MultiAssign(_, targets, values) ->
            each_direct(targets, into, later)
            each_direct(values, into, later)
        Eval(e) -> direct_reads(e, into, later)
        Return(value) -> maybe_direct(value, into, later)
        Throw(value) -> direct_reads(value, into, later)
        Break(_, value) -> maybe_direct(value, into, later)
        Continue(_) -> ()
        ImportNames(_, _, _, _, _) -> ()
        ImportAll(_, _, _, _) -> ()
        ImportAsset(_, _, _) -> ()
        CheckType(name, _, _) -> into.push(name)
        Clause(_, _, _, _, cond) -> direct_reads(cond, into, later)
end direct_stmt_reads

// Every name an expression reads as it is evaluated.
//
// **A lambda's body is left out, and that is the whole of the rule** -- see the header. Its names go
// to `later`, less its own parameters. A nested block, branch, loop or `match` is walked into: it
// runs where it stands, and a name it declares for itself only makes this answer larger, which costs
// a spelling nobody needed and nothing else.
//
// **Exhaustive over `ExprKind` on purpose**, for `free_names`' reason in `slots.sysl`: a node added
// later that quietly reads nothing here is a dead zone node finds and nothing reports.
private direct_reads(x: Expr, into: *Buf[string], later: *Buf[string])
    *x.kind match
        Name(n) -> into.push(n)
        Lambda(params, defaults, body, _) -> reachable_from(params, defaults, body, later)

        // A class's own shape, which the runtime reads lazily.
        ShapeLit(_, _) -> ()
        MatchExpr(subject, arms) ->
            direct_reads(subject, into, later)

            for i in 0..<arms.len()
                val arm = arms.at(i)

                maybe_direct(arm.guard, into, later)
                direct_reads(arm.body, into, later)
        For(_, _, iter, body, otherwise, _) ->
            direct_reads(iter, into, later)
            direct_reads(body, into, later)
            maybe_direct(otherwise, into, later)
        TryCatch(body, _, handler) ->
            direct_reads(body, into, later)
            direct_reads(handler, into, later)
        Spread(inner) -> direct_reads(inner, into, later)
        Named(_, value) -> direct_reads(value, into, later)
        Unary(_, rhs) -> direct_reads(rhs, into, later)
        Binary(_, lhs, rhs) ->
            direct_reads(lhs, into, later)
            direct_reads(rhs, into, later)
        Call(callee, args, _) ->
            direct_reads(callee, into, later)
            each_direct(args, into, later)
        Index(target, key, _) ->
            direct_reads(target, into, later)
            direct_reads(key, into, later)
        Field(target, _, _) -> direct_reads(target, into, later)
        Chain(inner) -> direct_reads(inner, into, later)
        ArrayLit(items) -> each_direct(items, into, later)
        ArrayRepeat(value, count) ->
            direct_reads(value, into, later)
            direct_reads(count, into, later)
        Interp(pieces) -> each_direct(pieces, into, later)
        WithFields(base, _, values) ->
            direct_reads(base, into, later)
            each_direct(values, into, later)
        WithAll(base, other, _) ->
            direct_reads(base, into, later)
            direct_reads(other, into, later)
        ObjectLit(_, _, values) -> each_direct(values, into, later)
        DataLit(inner) -> direct_reads(inner, into, later)
        Compare(operands, _) -> each_direct(operands, into, later)
        Range(lo, hi, _, step) ->
            maybe_direct(lo, into, later)
            maybe_direct(hi, into, later)
            maybe_direct(step, into, later)
        IsPattern(subject, _, _) -> direct_reads(subject, into, later)
        IncDec(target, _, _) -> direct_reads(target, into, later)
        Await(inner) -> direct_reads(inner, into, later)
        Yield(inner) -> direct_reads(inner, into, later)
        IfExpr(cond, then_branch, else_branch) ->
            direct_reads(cond, into, later)
            direct_reads(then_branch, into, later)
            maybe_direct(else_branch, into, later)
        While(_, cond, body, otherwise) ->
            direct_reads(cond, into, later)
            direct_reads(body, into, later)
            maybe_direct(otherwise, into, later)
        Loop(_, body) -> direct_reads(body, into, later)
        DoWhile(_, body, cond, otherwise) ->
            direct_reads(body, into, later)
            direct_reads(cond, into, later)
            maybe_direct(otherwise, into, later)
        Block(stmts) ->
            for i in 0..<stmts.len()
                direct_stmt_reads(stmts.at(i), into, later)
        Ensures(value, _, _, _) -> direct_reads(value, into, later)
        IntLit(_) -> ()
        BigLit(_) -> ()
        RealLit(_) -> ()
        StrLit(_) -> ()
        BoolLit(_) -> ()
        NullLit -> ()
        UndefinedLit -> ()
        Bad -> ()
end direct_reads

private each_direct(xs: Buf[Expr], into: *Buf[string], later: *Buf[string])
    for i in 0..<xs.len()
        direct_reads(xs.at(i), into, later)

private maybe_direct(x: Option[Expr], into: *Buf[string], later: *Buf[string]) = x match
    Some(e) -> direct_reads(e, into, later)
    None -> ()
