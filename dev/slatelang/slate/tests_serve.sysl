module dev.slatelang.slate
@tests

import sh.sysl.libuv
import sh.sysl.parsing.*
import sysl.text.{replace_all, Search}

// What `slate:http` gives a program writing an API server, beyond the protocol `tests_lang.sysl`
// covers: a handler that answers bytes rather than text.
//
// **These read the wire as BYTES**, which is the whole reason they are not written over `fetch`: a
// body that is not text has no reading as text, and a test that decoded it would be asserting on
// whatever the decoder made of it.

// The head of a response, `|`-joined, and the body as the numbers it really is. `<answer>` is what
// the handler says.
//
// **The body is printed as an array rather than decoded**, so a byte that is part of no character
// survives the assertion -- which is exactly what a test of a byte body has to check.
private byte_probe(answer: string) -> string =
    "val server = serve(0, req -> (" + answer + "))\n" +
    "cut(bs) =\n" +
    "    var i = 0\n" +
    "    while i + 3 < len(bs)\n" +
    "        if bs[i] == 13 && bs[i + 1] == 10 && bs[i + 2] == 13 && bs[i + 3] == 10 then return i\n" +
    "        i = i + 1\n" +
    "    0 - 1\n" +
    "async main()\n" +
    "    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n" +
    "    var got = []\n" +
    "    heard(chunk)\n" +
    "        if chunk == null\n" +
    "            val at = cut(got)\n" +
    "            print(join(split(fromBytes(got[0..<at]).value, \"\\r\\n\"), \"|\"))\n" +
    "            print(got[(at + 4)..<len(got)])\n" +
    "            shutSocket(c)\n" +
    "            close(server)\n" +
    "            done()\n" +
    "        else\n" +
    "            got = concat(got, chunk)\n" +
    "    onBytes(c, heard)\n" +
    "    await send(c, \"GET / HTTP/1.1\\r\\nHost: h\\r\\nConnection: close\\r\\n\\r\\n\")\n" +
    "main()\n"

@test
A_HANDLER_MAY_ANSWER_BYTES()
    // **`{ body: [72, 105] }` used to go out as the six characters `[72, 105]`**, so there was no way
    // to serve an image, a font, a PDF or an asset compressed ahead of time. `send` in `slate:net`
    // has always read an array as bytes and this is that rule reaching the response.

    val said = br_wire_out(byte_probe("{ body: [72, 105] }"))

    assert(said.contains("Content-Length: 2"))
    assert(said.contains("[72, 105]"))

@test
A_BARE_ARRAY_IS_BYTES_TOO()
    // The byte form of `req -> "Hi"`, and consistent with the object form above rather than a second
    // rule. A handler meaning an array of DATA writes `toJSON(xs)`, which it had to write anyway.

    val said = br_wire_out(byte_probe("[72, 105]"))

    assert(said.contains("Content-Length: 2"))
    assert(said.contains("[72, 105]"))

@test
BYTES_THAT_ARE_PART_OF_NO_CHARACTER_SURVIVE()
    // **The case that says these are bytes and not text.** `0` and `159` are not a UTF-8 sequence, so
    // anything that decoded the body on the way out would have replaced or refused them -- and an
    // image is full of exactly such bytes.

    val said = br_wire_out(byte_probe("[0, 159, 146, 150, 255]"))

    assert(said.contains("Content-Length: 5"))
    assert(said.contains("[0, 159, 146, 150, 255]"))

@test
A_CONTENT_TYPE_THE_HANDLER_SET_TRAVELS_WITH_A_BYTE_BODY()
    // Which is what makes a byte body worth having: the bytes say nothing about what they are.

    val said = br_wire_out(byte_probe("{ headers: { \"Content-Type\": \"image/png\" }, body: [137, 80, 78, 71] }"))

    assert(said.contains("Content-Type: image/png"))
    assert(said.contains("Content-Length: 4"))
    assert(said.contains("[137, 80, 78, 71]"))

@test
A_STATUS_AND_A_BYTE_BODY_TOGETHER()
    val said = br_wire_out(byte_probe("{ status: 201, body: [65] }"))

    assert(said.contains("HTTP/1.1 201 Created"))
    assert(said.contains("Content-Length: 1"))

@test
AN_ARRAY_OF_DATA_IS_STILL_ANSWERED_WITH_toJSON()
    // **The one thing this change takes away**, said out loud: an array used to be rendered as its
    // own text, which was never a JSON document -- `[1, 2]` rather than `[1,2]` is close enough to
    // look right and is not what a client parses. `toJSON` is what that always had to be.

    val said = br_wire_out(byte_probe("{ headers: { \"Content-Type\": \"application/json\" }, body: toJSON([1, 2]) }"))

    assert(said.contains("Content-Type: application/json"))
    assert(said.contains("Content-Length: 5"))

// -- the query, forms, cookies and the router --------------------------------------------------

// Everything the API surface exports. **One import line rather than one per test**, since what each
// of these is about is the behaviour and not which names it needed.
private val ApiImport: string =
    "import { serve, close, router, files, parseQuery, parseForm, parseCookies, setCookie, encodeComponent } from slate:http\n"

// A program that needs no socket -- the parsers and the encoder are ordinary functions.
private api_out(text: string) -> string = out(ApiImport + text)

// The same four names as `slate:url` has them, which is where they are implemented.
private val UrlImport: string =
    "import { percentDecode, encodeComponent, parseQuery, parsePairs } from slate:url\n"

private url_out(text: string) -> string = out(UrlImport + text)

// Both modules at once, for the tests that compare one against the other.
private both_out(text: string) -> string =
    out("import { percentDecode as httpDecode, encodeComponent as httpEncode, " +
        "parseQuery as httpQuery } from slate:http\n" + UrlImport + text)

@test
slate_url_IS_WHERE_THE_PERCENT_CODER_LIVES_AND_slate_http_FORWARDS_TO_IT()
    // **The four names moved out of `slate:http` and its exports did not change**, so what has to be
    // pinned is that the two answer the same thing rather than that either answers something. A
    // forwarder that lost an argument -- `plusIsSpace` is the one that could go missing silently --
    // would show up here and nowhere else in the suite.
    assert_eq(both_out("for s in [\"caf%C3%A9\", \"a+b\", \"%zz\", \"%\", \"plain\", \"%E2%82%AC\"]\n" +
        "    print(httpDecode(s, true) == percentDecode(s, true), httpDecode(s, false) == percentDecode(s, false))"),
        "true true\ntrue true\ntrue true\ntrue true\ntrue true\ntrue true")

    assert_eq(both_out("print(httpEncode(\"a b/é\") == encodeComponent(\"a b/é\"))"), "true")
    assert_eq(both_out("val a = httpQuery(\"x=1&y=two+words&x=2\")\nval b = parseQuery(\"x=1&y=two+words&x=2\")\n" +
        "print(a.x == b.x, a.y == b.y)"), "true true")

@test
slate_url_ASKS_NOTHING_OF_THE_HOST_AND_THAT_IS_WHY_IT_EXISTS()
    // **A page must be able to import this.** `slate:http` is a server, a file server and an HTTP/2
    // speaker, and the JavaScript back end emits the whole of an imported module -- so a browser page
    // reaching two of these through `slate:http` paid 239 KB for them. Nothing here touches a socket,
    // a clock or a document, which is what makes the module importable anywhere at all.
    assert_eq(url_out("print(percentDecode(\"caf%C3%A9\", false))"), "café")
    assert_eq(url_out("print(encodeComponent(\"a b/c?d=e&f\"))"), "a%20b%2Fc%3Fd%3De%26f")
    assert_eq(url_out("val q = parseQuery(\"name=Ada+Lovelace&year=1843\")\nprint(q.name, q.year)"),
        "Ada Lovelace 1843")

@test
parsePairs_IS_THE_ONE_GRAMMAR_A_QUERY_A_FORM_AND_A_COOKIE_HEADER_SHARE()
    // **Exported because the three callers inside `slate:http` do not exhaust it.** A dozen headers
    // are `name=value` lists, and a program reading one of them would otherwise write this again --
    // which is the very thing moving the module was meant to stop.
    //
    // The separator and the `+` rule are the whole of the difference: a cookie's `+` is a `+`.
    assert_eq(url_out("val c = parsePairs(\"a=1; b=x+y\", \";\", false)\nprint(c.a, c.b)"), "1 x+y")
    assert_eq(url_out("val f = parsePairs(\"a=1&b=x+y\", \"&\", true)\nprint(f.a, f.b)"), "1 x y")
    assert_eq(url_out("print(len(keys(parsePairs(\"\", \"&\", true))))"), "0")

// A server, one request written on the wire, and what came back: the head `|`-joined and the body.
//
// **Written over a socket rather than through `fetch`**, because `fetch` folds repeated response
// headers into one object and `Set-Cookie` is the header that repeats.
private asked(setup: string, request: string) -> string =
    ApiImport + WireImport + watched(setup +
        "async main()\n" +
        "    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n" +
        "    var got = \"\"\n" +
        "    heard(chunk)\n" +
        "        if chunk == null\n" +
        "            print(join(split(got, \"\\r\\n\"), \"|\"))\n" +
        "            shutSocket(c)\n" +
        "            close(server)\n" +
        "            done()\n" +
        "        else\n" +
        "            got = got + chunk\n" +
        "    onData(c, heard)\n" +
        "    await send(c, " + request + ")\n" +
        "main()\n")

private asked_out(setup: string, request: string) -> string = out(asked(setup, request))

// A plain `GET` of `path`, with whatever extra header lines are wanted.
private get_of(path: string, extra: string) -> string =
    "\"GET " + path + " HTTP/1.1\\r\\nHost: h\\r\\n" + extra + "Connection: close\\r\\n\\r\\n\""

@test
A_QUERY_STRING_REACHES_THE_HANDLER_AS_AN_OBJECT()
    // `req.search` is the raw text after the `?` and `req.query` is what it means -- the URL API's
    // two names, so a program that wants the text it was sent still has it.

    assert(asked_out("val server = serve(0, req -> req.query.x + \"|\" + req.query.y + \"|\" + req.search)\n",
        get_of("/a?x=1&y=two+words", "")).contains("1|two words|x=1&y=two+words"))

@test
A_PERCENT_ENCODED_QUERY_IS_DECODED_OVER_BYTES_AND_NOT_CHARACTERS()
    // **`%C3%A9` is two bytes that are one character**, which is why the decoder collects bytes and
    // decodes the lot at the end rather than working a character at a time.

    assert(asked_out("val server = serve(0, req -> req.query.n + \"|\" + string(len(req.query.n)))\n",
        get_of("/a?n=caf%C3%A9", "")).contains("café|4"))

@test
A_QUERY_NAME_WITH_NO_VALUE_IS_PRESENT_AND_EMPTY()
    // Which is what a bare `?debug` means to everybody who writes one.

    assert(asked_out("val server = serve(0, req -> string(has(req.query, \"debug\")) + \"|\" + req.query.debug + \"|\")\n",
        get_of("/a?debug", "")).contains("true||"))

@test
A_REPEATED_QUERY_NAME_IS_THE_LAST_ONE_AND_THE_RAW_TEXT_KEEPS_BOTH()
    // **A decision rather than an oversight.** The alternative every framework reaches for is an
    // array where a name repeats, which makes the TYPE of `q.name` depend on what a client sent --
    // so a program that read it as a string works until somebody sends the field twice. The text is
    // on `search` for a program that genuinely expects one more than once.

    assert(asked_out("val server = serve(0, req -> req.query.a + \"|\" + req.search)\n",
        get_of("/a?a=1&a=2", "")).contains("2|a=1&a=2"))

@test
COOKIES_ARRIVE_PARSED_AND_ONLY_THE_VALUE_IS_DECODED()
    // A cookie's name is a token by the specification and browsers do not encode one, so decoding a
    // name would turn two different cookies into one.

    assert(asked_out("val server = serve(0, req -> req.cookies.session + \"|\" + req.cookies.who)\n",
        get_of("/a", "Cookie: session=abc123; who=ada%20l\r\n")).contains("abc123|ada l"))

@test
A_REQUEST_WITH_NO_COOKIE_HEADER_HAS_AN_EMPTY_OBJECT_AND_NOT_A_MISSING_FIELD()
    // A field that is there only sometimes is one every handler has to test for before reading, and
    // `undefined` may not be passed anywhere in slate -- so the empty object is what makes
    // `req.cookies` safe to read.

    assert(asked_out("val server = serve(0, req -> string(len(keys(req.cookies))))\n",
        get_of("/a", "")).contains("0"))

@test
A_HEADER_WHOSE_VALUE_IS_AN_ARRAY_IS_WRITTEN_ONCE_PER_ELEMENT()
    // **The only way to say `Set-Cookie` twice**: an object has one value per name and HTTP does not.
    // It is general rather than a case for cookies -- `Link`, `Vary` and `Via` all repeat.

    val said = asked_out(
        "val server = serve(0, req -> { headers: { \"Set-Cookie\": [setCookie(\"a\", \"1\"), setCookie(\"b\", \"2\", { httpOnly: true })] }, body: \"ok\" })\n",
        get_of("/a", ""))

    assert(said.contains("Set-Cookie: a=1; Path=/"))
    assert(said.contains("Set-Cookie: b=2; Path=/; HttpOnly"))

@test
setCookie_WRITES_THE_ATTRIBUTES_IT_IS_GIVEN_AND_A_PATH_IT_IS_NOT()
    // **`Path=/` is the one default here that is not the specification's.** A cookie with no path is
    // scoped to the directory of the request that set it, which is almost never what a program means
    // and is a bug that only appears on the second path.

    assert_eq(api_out("print(setCookie(\"s\", \"a b\"))"), "s=a%20b; Path=/")
    assert_eq(api_out("print(setCookie(\"s\", \"x\", { maxAge: 60, httpOnly: true, secure: true, sameSite: \"Lax\" }))"),
        "s=x; Max-Age=60; Path=/; SameSite=Lax; HttpOnly; Secure")
    assert_eq(api_out("print(setCookie(\"s\", \"x\", { path: \"/admin\", domain: \"example.com\" }))"),
        "s=x; Domain=example.com; Path=/admin")

@test
A_FORM_BODY_IS_THE_SAME_GRAMMAR_AS_A_QUERY_AND_IS_NOT_PARSED_UNASKED()
    // A body has a content type, and a handler that did not ask for a form should not have one
    // parsed for it -- so `parseForm` is a function rather than a field.

    assert_eq(api_out("val f = parseForm(\"name=Ada+Lovelace&year=1843\")\nprint(f.name, f.year)"),
        "Ada Lovelace 1843")
    assert_eq(api_out("print(len(keys(parseForm(\"\"))))"), "0")

@test
encodeComponent_IS_THE_UNRESERVED_SET_AND_NOTHING_MORE()
    // Encoding more than is needed is always safe and encoding less never is.

    assert_eq(api_out("print(encodeComponent(\"a b/c?d=e&f\"))"), "a%20b%2Fc%3Fd%3De%26f")
    assert_eq(api_out("print(encodeComponent(\"-_.~AZaz09\"))"), "-_.~AZaz09")
    assert_eq(api_out("print(encodeComponent(\"café\"))"), "caf%C3%A9")

@test
A_ROUTER_BINDS_THE_PARAMETERS_A_PATH_NAMES()
    assert(asked_out(
        "val app = router()\n" +
        "app.get(\"/users/:id\", (req) -> \"user \" + req.params.id)\n" +
        "val server = serve(0, app)\n",
        get_of("/users/42", "")).contains("user 42"))

@test
serve_TAKES_A_ROUTER_BECAUSE_IT_HAS_A_handle()
    // **Nothing in the server knows what routing is.** A handler is a function, and one place to look
    // for one is inside an object that says it has a `handle` -- which is the whole of the coupling.

    assert(asked_out(
        "val app = router()\n" +
        "app.get(\"/\", (req) -> \"root\")\n" +
        "val server = serve(0, app.handle)\n",
        get_of("/", "")).contains("root"))

@test
A_PATH_THAT_IS_THERE_UNDER_ANOTHER_METHOD_IS_405_AND_NAMES_WHAT_IS_ALLOWED()
    // **The four lines nobody writes by hand**, and the difference between a client being told what
    // to send and being told the thing is not there. `Allow` is required on a 405.

    val said = asked_out(
        "val app = router()\n" +
        "app.post(\"/things\", (req) -> \"made\")\n" +
        "app.put(\"/things\", (req) -> \"replaced\")\n" +
        "val server = serve(0, app)\n",
        get_of("/things", ""))

    assert(said.contains("405 Method Not Allowed"))
    assert(said.contains("Allow: POST, PUT"))

@test
A_PATH_NOTHING_ROUTES_IS_404_AND_notFound_REPLACES_IT()
    assert(asked_out("val app = router()\nval server = serve(0, app)\n", get_of("/nope", ""))
        .contains("404 Not Found"))

    assert(asked_out(
        "val app = router()\n" +
        "app.notFound((req) -> { status: 404, body: \"nothing at \" + req.path })\n" +
        "val server = serve(0, app)\n",
        get_of("/nope", "")).contains("nothing at /nope"))

@test
A_STAR_TAKES_THE_WHOLE_OF_THE_REST_SLASHES_INCLUDED()
    // Which is what a file server needs, and is the one pattern that may match a different number of
    // parts than it has.

    assert(asked_out(
        "val app = router()\n" +
        "app.get(\"/files/*rest\", (req) -> \"[\" + req.params.rest + \"]\")\n" +
        "val server = serve(0, app)\n",
        get_of("/files/a/b/c.txt", "")).contains("[a/b/c.txt]"))

@test
ROUTES_ARE_TRIED_IN_THE_ORDER_THEY_WERE_ADDED()
    // The rule every router has and the only one a reader can predict: a more specific route written
    // second does not win.

    assert(asked_out(
        "val app = router()\n" +
        "app.get(\"/a/*rest\", (req) -> \"star\")\n" +
        "app.get(\"/a/b\", (req) -> \"exact\")\n" +
        "val server = serve(0, app)\n",
        get_of("/a/b", "")).contains("star"))

@test
A_TRAILING_SLASH_IS_THE_SAME_PATH_AND_THE_ROOT_IS_NO_PARTS_AT_ALL()
    assert(asked_out(
        "val app = router()\n" +
        "app.get(\"/a\", (req) -> \"one\")\n" +
        "app.get(\"/\", (req) -> \"root\")\n" +
        "val server = serve(0, app)\n",
        get_of("/a/", "")).contains("one"))

@test
AN_ASYNC_ROUTE_IS_AWAITED_LIKE_ANY_OTHER_HANDLER()
    // A router answers whatever its route answered, so a promise travels out through `handle` and the
    // server awaits it where it always did.

    assert(asked_out(
        "val app = router()\n" +
        "app.get(\"/slow\", async (req) ->\n" +
        "    await sleep(10)\n" +
        "    \"worth it\")\n" +
        "val server = serve(0, app)\n",
        get_of("/slow", "")).contains("worth it"))

@test
A_ROUTE_GIVEN_SOMETHING_THAT_IS_NOT_A_FUNCTION_SAYS_SO_WHERE_IT_WAS_WRITTEN()
    // For `serve`'s reason: nothing would look at it until a request arrived on that path, which may
    // be an hour later and on a connection somebody is waiting for.

    assert(api_out("val app = router()\ntry\n    app.get(\"/a\", 4)\ncatch e\n    print(e.message)")
        .contains("a route needs a function to call"))

// -- serving files ----------------------------------------------------------------------------

// A program with the server, a socket, and the disk, run against a scratch directory `<dir>` names.
//
// **`in_scratch`'s arrangement with a wider import**: a file server is the one thing here that needs
// all three modules, and the directory has to be a real one because what is being tested is what the
// file system answers.
private in_files(text: string) -> string
    val dir = libuv.mkdtemp_sync("/tmp/slate-serve-XXXXXX").unwrap()
    val said = out(ApiImport + WireImport + FsImport + watched(replace_all(text, "<dir>", dir)))

    scrub(dir)
    said

// A directory holding one file, a server over it, and one request written on the wire.
private file_probe(name: string, content: string, request: string) -> string =
    "writeFileSync(\"<dir>/" + name + "\", " + content + ")\n" +
    "val app = router()\n" +
    "app.get(\"/*rest\", files(\"<dir>\"))\n" +
    "val server = serve(0, app)\n" +
    "async main()\n" +
    "    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n" +
    "    var got = \"\"\n" +
    "    heard(chunk)\n" +
    "        if chunk == null\n" +
    "            print(join(split(got, \"\\r\\n\"), \"|\"))\n" +
    "            shutSocket(c)\n" +
    "            close(server)\n" +
    "            done()\n" +
    "        else\n" +
    "            got = got + chunk\n" +
    "    onData(c, heard)\n" +
    "    await send(c, " + request + ")\n" +
    "main()\n"

@test
A_FILE_UNDER_THE_ROOT_IS_SERVED_WITH_ITS_TYPE_AND_ITS_LENGTH()
    val said = in_files(file_probe("hello.txt", "\"hi there\"", get_of("/hello.txt", "")))

    assert(said.contains("HTTP/1.1 200 OK"))
    assert(said.contains("Content-Type: text/plain; charset=utf-8"))
    assert(said.contains("Content-Length: 8"))
    assert(said.contains("hi there"))

@test
THE_TYPE_COMES_OFF_THE_EXTENSION()
    // **The handful where guessing wrongly breaks the page**, rather than a thousand-line table that
    // goes out of date.

    assert(in_files(file_probe("page.html", "\"<p>hi</p>\"", get_of("/page.html", "")))
        .contains("Content-Type: text/html; charset=utf-8"))
    assert(in_files(file_probe("a.css", "\"p{}\"", get_of("/a.css", "")))
        .contains("Content-Type: text/css; charset=utf-8"))
    assert(in_files(file_probe("a.wasm", "\"x\"", get_of("/a.wasm", "")))
        .contains("Content-Type: application/wasm"))
    assert(in_files(file_probe("a.unheardof", "\"x\"", get_of("/a.unheardof", "")))
        .contains("Content-Type: application/octet-stream"))

@test
A_PATH_THAT_CLIMBS_OUT_OF_THE_ROOT_IS_REFUSED_RATHER_THAN_RESOLVED()
    // **`tar.sysl`'s rule for the same attack**, which is the oldest bug in every program that ever
    // took a path from outside: such a request is not a request with a mistake in it, and quietly
    // rewriting the name would hide what was attempted.

    val said = in_files(file_probe("ok.txt", "\"fine\"", get_of("/../../etc/passwd", "")))

    assert(said.contains("403 Forbidden"))
    assert(!said.contains("root:"))

@test
A_FILE_THAT_IS_NOT_THERE_IS_404_AND_SO_IS_A_DIRECTORY_WITH_NO_INDEX()
    // **The same 404 for both, on purpose**: telling a client which is which maps out a server's
    // disk for it.

    assert(in_files(file_probe("ok.txt", "\"fine\"", get_of("/nope.txt", ""))).contains("404 Not Found"))

    assert(in_files("mkdirSync(\"<dir>/sub\")\n" + file_probe("ok.txt", "\"fine\"", get_of("/sub", "")))
        .contains("404 Not Found"))

@test
A_DIRECTORY_IS_ITS_INDEX_FILE()
    val said = in_files(
        "mkdirSync(\"<dir>/sub\")\n" +
        "writeFileSync(\"<dir>/sub/index.html\", \"<h1>in here</h1>\")\n" +
        file_probe("ok.txt", "\"fine\"", get_of("/sub", "")))

    assert(said.contains("200 OK"))
    assert(said.contains("<h1>in here</h1>"))
    assert(said.contains("Content-Type: text/html; charset=utf-8"))

@test
AN_ETag_COMES_BACK_AND_SENDING_IT_AGAIN_IS_ANSWERED_304()
    // **The size and the modification time, not a hash of the contents.** Hashing a file on every
    // request is what a static server exists not to do.
    //
    // The tag is read out of the first answer and sent back on the second, so the test asserts the
    // round trip rather than a number it could only have got by computing it the same way.

    val said = in_files(
        "writeFileSync(\"<dir>/a.txt\", \"cached\")\n" +
        "val app = router()\n" +
        "app.get(\"/*rest\", files(\"<dir>\"))\n" +
        "val server = serve(0, app)\n" +
        "async once(extra)\n" +
        "    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n" +
        "    var got = \"\"\n" +
        "    heard(chunk)\n" +
        "        if chunk != null then got = got + chunk\n" +
        "    onData(c, heard)\n" +
        "    await send(c, \"GET /a.txt HTTP/1.1\\r\\nHost: h\\r\\n\" + extra + \"Connection: close\\r\\n\\r\\n\")\n" +
        "    await sleep(60)\n" +
        "    shutSocket(c)\n" +
        "    got\n" +
        "async main()\n" +
        "    val first = await once(\"\")\n" +
        "    val at = indexOf(first, \"ETag: \")\n" +
        "    val tag = first[(at + 6)..<indexOf(first[at..<len(first)], \"\\r\\n\") + at]\n" +
        "    print(join(split(first, \"\\r\\n\"), \"|\"))\n" +
        "    print(join(split(await once(\"If-None-Match: \" + tag + \"\\r\\n\"), \"\\r\\n\"), \"|\"))\n" +
        "    close(server)\n" +
        "    done()\n" +
        "main()\n")

    assert(said.contains("200 OK"))
    assert(said.contains("cached"))
    assert(said.contains("304 Not Modified"))

@test
files_IS_A_HANDLER_SO_IT_SERVES_A_WHOLE_SERVER_TOO()
    // It reads `req.params.rest` where a route bound one and `req.path` otherwise, so the root is
    // said once whether or not a router is in use.

    val said = in_files(
        "writeFileSync(\"<dir>/plain.txt\", \"no router\")\n" +
        "val server = serve(0, files(\"<dir>\"))\n" +
        "async main()\n" +
        "    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n" +
        "    var got = \"\"\n" +
        "    heard(chunk)\n" +
        "        if chunk == null\n" +
        "            print(join(split(got, \"\\r\\n\"), \"|\"))\n" +
        "            shutSocket(c)\n" +
        "            close(server)\n" +
        "            done()\n" +
        "        else\n" +
        "            got = got + chunk\n" +
        "    onData(c, heard)\n" +
        "    await send(c, " + get_of("/plain.txt", "") + ")\n" +
        "main()\n")

    assert(said.contains("200 OK"))
    assert(said.contains("no router"))

@test
A_CACHE_CONTROL_IS_WRITTEN_WHERE_ONE_WAS_ASKED_FOR()
    val said = in_files(
        "writeFileSync(\"<dir>/a.txt\", \"x\")\n" +
        "val app = router()\n" +
        "app.get(\"/*rest\", files(\"<dir>\", { cacheControl: \"max-age=300\" }))\n" +
        "val server = serve(0, app)\n" +
        "async main()\n" +
        "    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n" +
        "    var got = \"\"\n" +
        "    heard(chunk)\n" +
        "        if chunk == null\n" +
        "            print(join(split(got, \"\\r\\n\"), \"|\"))\n" +
        "            shutSocket(c)\n" +
        "            close(server)\n" +
        "            done()\n" +
        "        else\n" +
        "            got = got + chunk\n" +
        "    onData(c, heard)\n" +
        "    await send(c, " + get_of("/a.txt", "") + ")\n" +
        "main()\n")

    assert(said.contains("Cache-Control: max-age=300"))

@test
A_STAT_ANSWERS_WHEN_A_FILE_WAS_MODIFIED()
    // **A stat without a modification time is not a stat**, and slate's had none: it is what every
    // cache validator is made of, and the file server could not have been written without it. An
    // INSTANT and not a number, because that is the type slate has for a point on the timeline.

    assert_eq(in_scratch(
        "writeFileSync(\"<dir>/a.txt\", \"x\")\n" +
        "val s = statSync(\"<dir>/a.txt\").value\n" +
        "print(s.modified is instant, s.modified.epochMillis() > 1700000000000)"), "true true")

// -- what closing a server does to the connections it accepted -----------------------------------

// **Closing a server used to close its listening socket and nothing else**, so a connection already
// accepted was held until its own idle clock ran out -- and over HTTP/2, which had no clock at all,
// for the life of the program. A socket is a handle the event loop waits on, so a program that had
// closed everything it owned could still not exit.

@test
CLOSING_A_SERVER_CLOSES_A_CONNECTION_IT_HAS_NOTHING_TO_DO_ON()
    // **An idle connection goes at once.** The client here has been answered and is keeping the
    // connection, which is what a keep-alive client does; nothing is in flight, so there is nothing
    // to wait for and the connection ends with the server.

    val prog = raw"""
    val server = serve(0, (req) -> "hi")

    async main()
        val c = (await connect("127.0.0.1", localPort(server))).value

        var answers = 0

        heard(chunk)
            if chunk == null
                print("the server closed it")

                shutSocket(c)
                done()

                return

            answers = answers + 1

            if answers == 1
                print("answered")

                close(server)

        onData(c, heard)

        await send(c, "GET / HTTP/1.1\r\nHost: h\r\n\r\n")

    main()
    """

    assert_eq(wire_out(prog), "answered\nthe server closed it")

@test
A_REQUEST_IN_FLIGHT_WHEN_THE_SERVER_CLOSES_IS_STILL_ANSWERED()
    // **The other half of the rule, and the reason closing is not simply abrupt.** A client that
    // asked a moment before the shutdown is answered rather than cut off; the connection ends after
    // the response it was writing, not in the middle of it.

    val prog = raw"""
    var theServer = null

    val server = serve(0, async (req) ->
        close(theServer)

        await sleep(30)

        "answered anyway")

    theServer = server

    async main()
        val c = (await connect("127.0.0.1", localPort(server))).value

        var got = ""

        heard(chunk)
            if chunk == null
                print(got.contains("answered anyway"), "then closed")

                shutSocket(c)
                done()

                return

            got = got + chunk

        onData(c, heard)

        await send(c, "GET / HTTP/1.1\r\nHost: h\r\n\r\n")

    main()
    """

    assert_eq(wire_out(prog), "true then closed")

@test
A_SECOND_REQUEST_ON_A_CONNECTION_THE_SERVER_HAS_CLOSED_IS_NOT_SERVED()
    // **There is no keep-alive after `close`.** Both requests are written in one go, so the second is
    // already in the parser when the shutdown happens -- and it is not answered: the connection ends
    // with the response that was in flight. A server being shut down that went on serving whatever
    // was already buffered would never finish shutting down.

    val prog = raw"""
    var theServer = null

    val server = serve(0, async (req) ->
        close(theServer)

        await sleep(30)

        "one")

    theServer = server

    async main()
        val c = (await connect("127.0.0.1", localPort(server))).value

        var got = ""

        heard(chunk)
            if chunk == null
                print("answers", len(split(got, "HTTP/1.1 200")) - 1)

                shutSocket(c)
                done()

                return

            got = got + chunk

        onData(c, heard)

        await send(c, "GET /a HTTP/1.1\r\nHost: h\r\n\r\nGET /b HTTP/1.1\r\nHost: h\r\n\r\n")

    main()
    """

    assert_eq(wire_out(prog), "answers 1")
