module dev.slatelang.slate
@tests

// A request body arriving over HTTP/2, and the connection underneath it.
//
// **Cut out of `tests_tls.sysl` with `tests_http2.sysl` when that file passed a thousand lines**,
// and separate from it because the subject is the other direction: `serveStream` hands the handler
// a request whose body is still on the wire, so what these tests are about is what the handler
// reads while the peer is still sending -- a reset mid-upload, a connection that ends under a
// running stream, a connection nobody is using, and a body large enough to arrive in many frames.
// `H2StreamServer` is the listener the first two share; the rest use `H2Server` from
// `tests_http2.sysl`.

// A server that is handed a request at its headers rather than at its end, over HTTP/2.
//
// **`serveStream` and not `serve`**, which is the whole subject: the handler runs while the body is
// still arriving, and what it reads is the frames as they land.
const H2StreamServer: string = raw"""
    import { serveStream, close } from slate:http
    import { h2Client, h2Receive, h2Send, h2Next, h2RequestStream, h2Push, h2Finish, h2Reset,
        h2Close } from slate:nghttp2
    import { readFileSync } from slate:fs

    val theCert = readFileSync("tests/tls/cert.pem").value
    val theKey = readFileSync("tests/tls/key.pem").value
    """

@test
serveStream_OVER_HTTP_2_HANDS_THE_BODY_OVER_AS_IT_LANDS()
    // **One arrival per DATA frame, which is what `serveStream` promises and could not keep over
    // HTTP/2 until now.** The binding held a body whole, so a handler written to write a gigabyte to
    // disk as it arrived was given the gigabyte first -- the honest shape of what was underneath,
    // and useless for the one thing this server exists for.
    val prog = H2StreamServer + raw"""

    async handler(req)
        var pieces = []

        for await piece in req
            push(pieces, fromBytes(piece).value)

        "saw " + string(pieces.length) + ": " + join(pieces, "|")

    val server = serveStream({ port: 0, cert: theCert, key: theKey, alpn: ["h2"] }, handler)

    async main()
        val c = (await connect("localhost", localPort(server))).value
        val h = h2Client()

        pump()
            val out = h2Send(h)

            if out.length > 0 then send(c, out)

        var body = ""

        arrived(chunk)
            if chunk == null then return

            h2Receive(h, chunk)

            loop
                val e = h2Next(h)

                if e == null then break

                if e.kind == "data" then body = body + fromBytes(e.bytes).value

                if e.kind == "streamClose"
                    print(body)

                    h2Close(h)
                    close(c)
                    close(server)
                    done()

                    return

            pump()

        onBytes(c, arrived)

        await startTls(c, { host: "localhost", trust: theCert, alpn: ["h2"] })

        val id = h2RequestStream(h, { ":method": "POST", ":scheme": "https",
            ":authority": "localhost", ":path": "/up" })

        pump()

        h2Push(h, id, "one")
        pump()

        await sleep(10)

        h2Push(h, id, "two")
        pump()

        await sleep(10)

        h2Finish(h, id)
        pump()

    main()
    """

    assert_eq(net_out(prog), "saw 2: one|two")

@test
A_STREAM_RESET_MID_UPLOAD_ENDS_THE_BODY_THE_HANDLER_IS_READING()
    // **THE TEST 0.0.24 COULD NOT WRITE**, and the reason it could not is worth keeping: a partial
    // upload needs HEADERS and DATA with no end, and `sh.sysl.nghttp2` sent a body whole -- so there
    // was no way to reach the case from a slate client at all. `h2RequestStream` is what makes it
    // expressible.
    //
    // What the handler sees is a body that ENDS where the reset arrived. A truncated body is the
    // only thing either version of HTTP can say once the request has stopped arriving, and a handler
    // that was not told would wait for the rest of the run.
    val prog = H2StreamServer + raw"""

    val heard = pending()

    async handler(req)
        var pieces = 0

        for await piece in req
            pieces = pieces + 1

        settle(heard, pieces)

        "never sent"

    val server = serveStream({ port: 0, cert: theCert, key: theKey, alpn: ["h2"] }, handler)

    async main()
        val c = (await connect("localhost", localPort(server))).value
        val h = h2Client()

        pump()
            val out = h2Send(h)

            if out.length > 0 then send(c, out)

        arrived(chunk)
            if chunk == null then return

            h2Receive(h, chunk)

            loop
                if h2Next(h) == null then break

            pump()

        onBytes(c, arrived)

        await startTls(c, { host: "localhost", trust: theCert, alpn: ["h2"] })

        val id = h2RequestStream(h, { ":method": "POST", ":scheme": "https",
            ":authority": "localhost", ":path": "/up" })

        pump()

        h2Push(h, id, "half of it")
        pump()

        await sleep(10)

        // The client gives up mid-body: a cancelled fetch, a closed tab, a timeout.
        h2Reset(h, id, 8)
        pump()

        print("the handler read", await heard, "pieces before the client gave up")

        h2Close(h)
        close(c)
        close(server)
        done()

    main()
    """

    assert_eq(net_out(prog), "the handler read 1 pieces before the client gave up")

@test
A_CONNECTION_THAT_ENDS_UNDER_A_RUNNING_STREAM_DOES_NOT_STOP_THE_SERVER()
    // **A CLIENT CAN END A CONNECTION UNDER A RESPONSE THAT IS STILL BEING WRITTEN, AND MUST NOT BE
    // ABLE TO END THE PROGRAM.** This is defect 1's shape on the other version: nonsense arriving on
    // a connection makes the server say goodbye and hang up, and the stream that was running is then
    // pushing into a session that has been closed and a socket that has gone.
    //
    // **WHAT THIS PINS AND WHAT IT DOES NOT.** It pins the outcome -- the server survives a client
    // that gives up mid-stream, however it gives up. It does NOT discriminate the `flushed` change
    // that went in beside it: the same program passes with every `flush` unawaited, because on this
    // path the failure surfaces inside the source loop, where `sending` is true and the rethrow is
    // already read as the client having gone. That change is a latent orphan closed by reading, and
    // saying so here is better than letting a green test be read as evidence for it.
    val prog = H2Server + raw"""
    import { sse } from slate:http

    // A source that keeps going, so that there is a stream running when the connection ends.
    ticking()
        var n = 0

        val source = {}

        source.next = async () ->
            await sleep(20)

            n = n + 1

            { done: n > 20, value: "tick " + string(n) }

        source

    app.get("/events", (req) -> sse(ticking(), { heartbeat: 0 }))

    async main()
        val c = (await connect("localhost", localPort(server))).value
        val h = h2Client()

        pump()
            val out = h2Send(h)

            if out.length > 0 then send(c, out)

        var frames = 0

        arrived(chunk)
            if chunk == null then return

            h2Receive(h, chunk)

            loop
                val e = h2Next(h)

                if e == null then break

                if e.kind == "data" then frames = frames + 1

            pump()

        onBytes(c, arrived)

        await startTls(c, { host: "localhost", trust: theCert, alpn: ["h2"] })

        h2Request(h, { ":method": "GET", ":scheme": "https", ":authority": "localhost", ":path": "/events" })
        pump()

        await sleep(60)

        print("streaming", frames > 0)

        // **Nonsense on the same connection**, which is what the server answers with a GOAWAY and a
        // hangup -- under a response it is still writing.
        await send(c, "this is not a frame")

        // Long enough for several more of the source's values to be produced and to find a
        // connection that is not there any more.
        await sleep(200)

        print("the server is still running")

        h2Close(h)
        close(c)
        close(server)
        done()

    main()
    """

    assert_eq(net_out(prog), "streaming true\nthe server is still running")

// -- an HTTP/2 connection's own lifetime ---------------------------------------------------------

@test
AN_HTTP_2_CONNECTION_NOBODY_IS_USING_IS_CLOSED_BY_THE_SERVERS_CLOCK()
    // **The 1.1 speaker has closed a quiet connection after `IdleMillis` from the start and this one
    // never did.** A client may keep a connection and then simply go away, and without a clock that
    // socket is held for the life of the server -- and a socket is a handle the event loop waits on,
    // so it is not only memory that pays. HTTP/2 makes it likelier rather than rarer, a connection
    // there carrying many streams and being meant to be kept.
    //
    // **The fuse has to outlast the clock**, which is what `fused` is for: three seconds is the
    // default and not a maximum, and a watchdog shorter than the thing being measured would report
    // the measurement as a hang.
    val prog = H2Server + raw"""

    app.get("/ping", (req) -> "pong")

    async main()
        val c = (await connect("localhost", localPort(server))).value
        val h = h2Client()

        pump()
            val out = h2Send(h)

            if out.length > 0 then send(c, out)

        var status = ""

        arrived(chunk)
            if chunk == null
                print("closed after", status)

                close(c)
                close(server)
                done()

                return

            h2Receive(h, chunk)

            loop
                val e = h2Next(h)

                if e == null then break

                if e.kind == "headers" then status = e.headers[0][1]

            pump()

        onBytes(c, arrived)

        await startTls(c, { host: "localhost", trust: theCert, alpn: ["h2"] })

        h2Request(h, { ":method": "GET", ":scheme": "https", ":authority": "localhost", ":path": "/ping" })
        pump()

    main()
    """

    assert_eq(out(NetImport + fused(9000, prog)), "closed after 200")

@test
A_SERVER_THAT_TOOK_A_MEGABYTE_BODY_CAN_TAKE_ANOTHER_FIFTEEN()
    // **The h2 server used to grow a request body by concatenating the whole of it to each DATA frame
    // as it arrived**, which is quadratic -- and an array holds a value per byte, so a megabyte
    // arriving in sixteen-kilobyte frames cost about 1.5 GB of peak footprint and a third of a second
    // of pure copying. One body was survivable and is why nothing noticed; sixteen is not.
    //
    // **Sixteen bodies just under the limit, on one connection.** Held as the frames themselves and
    // joined once at the end it is a fraction of a second; grown a frame at a time it is several
    // seconds of copying and does not finish inside the watchdog. The sizes coming back are what says
    // each body was reassembled whole and in order rather than merely fast.
    val prog = H2Server + raw"""

    app.post("/up", (req) -> "took " + string(req.body.length))

    async main()
        val c = (await connect("localhost", localPort(server))).value
        val h = h2Client()
        val payload = repeat("z", 900000)

        var closed = 0
        var said = ""

        arrived(chunk)
            if chunk == null then return

            h2Receive(h, chunk)

            loop
                loop
                    val e = h2Next(h)

                    if e == null then break

                    if e.kind == "data" then said = said + fromBytes(e.bytes).value

                    if e.kind == "streamClose"
                        closed = closed + 1

                        if closed == 16
                            print(closed, said.contains("took 900000"), said.length)

                            h2Close(h)
                            close(c)
                            close(server)
                            done()

                            return

                val out = h2Send(h)

                if out.length == 0 then break

                send(c, out)

        onBytes(c, arrived)

        await startTls(c, { host: "localhost", trust: theCert, alpn: ["h2"] })

        for i in 0..<16
            h2Request(h, { ":method": "POST", ":scheme": "https", ":authority": "localhost", ":path": "/up" },
                payload)

        arrived([])

    main()
    """

    assert_eq(net_out(prog), "16 true 176")
