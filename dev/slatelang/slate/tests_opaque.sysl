module dev.slatelang.slate
@tests

import sysl.text.Search

// `opaque type`, as far as the CHECKER and the declaration go. What a running program sees is
// `tests/lang/opaque.sl`, which both back ends run; this is what is refused before anything runs, and
// what a declaration may not say.
//
// **The boundary is between files**, so most of these read a fixture under `tests/mods/` that imports
// `opaque_lib.sl` -- the checker's knowledge of an imported signature being exactly what is under test.

// -- the boundary ----------------------------------------------------------------------------------

@test
A_BARE_REPRESENTATION_HANDED_TO_THE_TYPE_ACROSS_THE_BOUNDARY_IS_REFUSED_BEFORE_IT_RUNS()
    assert(ran_fault("tests/mods/opaque_bare.sl").contains("`next` takes GlyphId here, and this is integer"))

@test
THE_REPRESENTATIONS_OPERATORS_ARE_REFUSED_OUTSIDE_BEFORE_IT_RUNS()
    assert(ran_fault("tests/mods/opaque_operator.sl").contains("`+` does not apply to GlyphId and integer"))

@test
A_SEALED_TYPE_DOES_NOT_WIDEN_TO_ITS_REPRESENTATION()
    assert(ran_fault("tests/mods/opaque_widen.sl").contains("`n` was declared integer, and this is GlyphId"))

@test
A_METHOD_OF_THE_REPRESENTATION_IS_NOT_THE_TYPES()
    assert(ran_fault("tests/mods/opaque_method.sl").contains("`foo` is not something a GlyphId can do"))

@test
A_FIELD_OF_THE_REPRESENTATION_IS_NOT_THE_TYPES_EITHER()
    assert(ran_fault("tests/mods/opaque_field.sl").contains("`x` is not something a GlyphId can do"))

@test
A_BOUND_IS_HOW_FAR_THE_OUTSIDE_MAY_USE_IT()
    // `Points is real`: an operand, a binding declared `real`, and the sealed type beside it handed
    // around as itself.
    assert_eq(ran_out("tests/mods/opaque_bounded.sl"), "2 2.5 1.5 true")

// -- inside the declaring file ---------------------------------------------------------------------

@test
INSIDE_THE_DECLARING_FILE_THE_TYPE_IS_ITS_REPRESENTATION()
    val program = "opaque type G = integer\n\nnext(g: G) -> G = g + 1\n\nhalf(g: G) -> integer = g \\ 2\n\nprint(next(5), half(next(next(7))))\n"

    assert_eq(out(program), "6 4")

@test
INSIDE_A_VALUE_THE_REPRESENTATION_DOES_NOT_FIT_IS_STILL_REFUSED()
    val said = fails("opaque type G = integer\n\nnext(g: G) -> G = g + 1\n\nprint(next(\"x\"))\n")

    assert(said.contains("`next` takes G here, and this is string"))

@test
INSIDE_A_VALUE_IS_STILL_ITS_OWN_TYPE_TO_A_TEST()
    // The conversions are written where a value is HANDED OVER; `is` asks about the value itself.
    assert_eq(out("opaque type G = integer\n\nmake(n: integer) -> G = n\n\nprint(make(1) is G, make(1) is integer, 1 is G)\n"), "true false false")

// -- the declaration -------------------------------------------------------------------------------

@test
A_BOUND_THE_REPRESENTATION_DOES_NOT_FIT_IS_REFUSED()
    assert(fails("opaque type T is string = integer\n\nprint(1)\n").contains("which is not string"))

@test
AN_OPAQUE_TYPE_TAKES_NO_TYPE_PARAMETERS()
    assert(fails("opaque type T[A] = A\n\nprint(1)\n").contains("an opaque type takes no type parameters"))

@test
A_REPRESENTATION_MAY_NOT_BIND_A_NAME()
    assert(fails("opaque type T = { a: n }\n\nprint(1)\n").contains("`n` is not a type"))

@test
OPAQUE_IS_A_SOFT_WORD()
    assert_eq(out("val opaque = 3\n\nprint(opaque + 1)\n"), "4")

@test
THE_NAME_BINDS_A_SHAPE_THAT_ASKS_THE_TYPES_QUESTION()
    assert_eq(out("opaque type G = integer\n\nmake(n: integer) -> G = n\n\nprint(G.test(make(1)), G.test(1), G.name())\n"), "true false G")
