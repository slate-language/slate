module dev.slatelang.slate

// slate's Redis module, written in slate and carried in the binary.
//
// **THE FOURTH BUILT-IN MODULE WRITTEN IN SLATE**, after `slate:http` and `slate:jwt`; `stdlib.sysl`
// says how that kind differs from an export list over natives, which is in `take_builtin` and nowhere
// else. What makes this one worth writing in slate is that a Redis client is a queue, a socket and a
// promise per command -- all of which slate has -- and the one thing it could not do is recognise
// RESP, which is `redis_parse.sysl`.
//
// **A RAW TEXT BLOCK, SO WHAT IS WRITTEN HERE IS WHAT SLATE READS.** `raw"""` takes no escapes and
// strips only the incidental indentation, so the module sits below at four spaces and reaches the
// lexer at the margin -- and a `\r\n`, a quote or a `${...}` in it means itself. It was an array of
// escaped strings, one per line, until 2026-08-30: this file's own header said sysl had no raw string
// literal, and that had stopped being true long before. `http_source.sysl` says the rest.

// The module's source, as slate will read it.
redis_source() -> string = raw"""
    // Redis, written in slate over the RESP reader and a socket.
    //
    // **A Redis client in a server must not stop the server**, and that is the whole reason this module
    // exists at the tier it does. `sh.sysl.redis` binds hiredis's reader and deliberately not its
    // connection: the reader is fed bytes and answers replies, so the socket stays slate's own and every
    // command is a promise on the same loop that is answering HTTP. A blocking client would have made a
    // request handler that touched Redis stop answering everybody else.
    //
    // ## One export, because a connection is one object
    //
    // `redis(host, port)` answers a result carrying the client, and everything else is a method on it --
    // the same shape `slate:regex` has, and for the same reason: a program that wants Redis wants one
    // noun, not a vocabulary.
    //
    //     val r = (await redis("127.0.0.1", 6379)).value
    //
    //     await r.command("SET", "greeting", "hello")
    //     print((await r.command("GET", "greeting")).value)
    //
    //     r.close()
    //
    // **There is no `get` and no `set`, and that is not laziness.** Redis has some two hundred and forty
    // commands and grows more with every release, so a client that named them would be a list to keep up
    // to date and a wall between a program and anything new. `command` takes the words of the command as
    // its arguments, every one crosses as a counted string, and there is nothing to escape.
    //
    // **A command worked out while running is spread**, `r.command(...parts)`, which is the same call
    // said the other way round. `command` took the list itself until the language could gather one.
    //
    // ## Two channels, as everywhere else
    //
    // **A command answers a result.** `-ERR unknown command` is the server refusing, which is an
    // ordinary thing to handle rather than a defect; so is a connection that has gone. **Calling
    // `command` on a client that is already closed throws**, because that is the program's own mistake.
    //
    // ## Pipelining is what happens when you do not await
    //
    // Commands are written in the order they were issued and replies come back in that order, which is
    // the protocol's own guarantee -- so issuing several without awaiting and awaiting them afterwards
    // costs one round trip rather than several.

    import { connect, onBytes, send, close as shutSocket } from slate:net

    // What a command answers: the reply under `value`, or why there is not one under `error`.
    //
    // **Only the field that applies is there**, which is the shape every result in slate has -- reading
    // `r.value` off a failure is `undefined`, and slate refuses to carry that anywhere.
    export type Reply = { ok: boolean, value?: any, error?: string }

    // A connection, and everything a program does with one.
    export type Client = { command: function, onPush: function, close: function }

    // `redis(host, port)` -- a client, or the reason there is not one.
    export redis(host: string, port: integer) = opened(host, port)

    async opened(host: string, port: integer)
        val made = await connect(host, port)

        if !made.ok then return made

        val sock = made.value

        // hiredis's reader for this connection. **One per connection and never shared**: it holds the
        // parse state between packets, so two connections through one reader would interleave replies.
        val reader = redisReader()

        // The promises for commands that have gone out and not been answered, oldest first. **This is
        // the whole of how a reply is matched to its command** -- RESP has no request ids and does not
        // need them, answers coming back in the order the commands were written.
        var waiting = []

        var pushes = null
        var shut = false

        // Answer everything outstanding and let the connection go.
        //
        // **Every waiting promise is SETTLED rather than left**, and with a result rather than a
        // failure: a connection that has gone is an outside condition like any other, and a program
        // awaiting a command would otherwise wait for the rest of the run.
        stop(why: string)
            if shut then return

            shut = true

            for p in waiting
                settle(p, { ok: false, error: why })

            waiting = []

            redisClose(reader)
            shutSocket(sock)

        // The next reply belongs to the oldest command that has not been answered.
        answer(r: object)
            if len(waiting) == 0 then return

            val p = waiting[0]

            removeAt(waiting, 0)

            if r.kind == "error"
                settle(p, { ok: false, error: r.value.error })
            else
                settle(p, { ok: true, value: r.value })

        heard(chunk: array | null)
            if chunk == null
                stop("the redis connection was closed by the server")

                return

            redisFeed(reader, chunk)

            while true
                val r = redisTake(reader)

                if r == null then return

                // **A protocol failure ends the connection rather than being reported and stepped
                // over.** The two ends disagree about where a reply begins, so nothing after it can be
                // trusted to belong to the command it would be matched with.
                if r.kind == "broken"
                    stop(r.value)

                    return

                // **A push arrives BETWEEN replies to your own commands** -- a pub/sub message, or a
                // cache invalidation -- so it is answered to whoever asked to see them and is never
                // matched against a waiting command. A client that assumed every reply was its own would
                // hand a subscriber's message back as the answer to a `GET`.
                if r.kind == "push"
                    if pushes != null then pushes(r.value)
                else
                    answer(r)

        // `r.command(word, ...)` -- the reply, or the reason there is not one.
        //
        // **The words are gathered rather than taken as a list**, so an ordinary command reads as one
        // and a computed one is spread: `r.command(...parts)`.
        async ask(...parts)
            if shut then throw "this redis connection is closed"

            val p = pending()

            push(waiting, p)

            try
                await send(sock, redisCommand(parts))
            catch e
                stop("the redis connection was lost while a command was going out")

            await p

        // `r.onPush(f)` -- what to do with a pub/sub message or an invalidation.
        watch(f: function)
            pushes = f

        // `r.close()` -- and every command still waiting is answered.
        bye()
            stop("this redis connection was closed")

        onBytes(sock, heard)

        val client = { }

        // **Stored on the object rather than reached through a proto**, so calling one passes it what it
        // was given and nothing else -- `r.command(a, b)` is `ask(a, b)` and no receiver.
        client.command = ask
        client.onPush = watch
        client.close = bye

        { ok: true, value: client }
    """
