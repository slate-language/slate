module dev.slatelang.slate

import sh.sysl.parsing.*

// `x.m(a)` where `x` is not an object -- the method syntax a builtin type answers to.
//
// **A BUILTIN METHOD IS THE FREE FUNCTION OF THE SAME NAME, WITH THE RECEIVER IN FRONT.** `xs.map(f)`
// is `map(xs, f)` and `s.upper()` is `upper(s)`; there is one implementation, one set of argument
// checks and one diagnostic for each. Nothing is looked up in the heap, nothing is bound, and no
// second surface exists to drift from the first.
//
// **SO THERE IS NO ARRAY PROTOTYPE, AND A PROGRAM CANNOT ADD TO ONE.** This is a table in the
// interpreter and not an object a program can reach, which settles by construction the question
// JavaScript answers by convention: patching `Array.prototype` is the single most damaging thing
// node's ecosystem does to itself, and every library that has to defend against it -- every
// `hasOwnProperty` guard, every `Object.create(null)` -- is paying for a decision that could have
// been made once. slate makes it here. **A program that wants its own array operations writes
// functions**, which is what a function is for.
//
// The cost is the honest one: `xs.map` on its own hands back the plain builtin rather than a method
// bound to `xs`, exactly as `o.m` on an object hands back the plain function. `map(xs, f)` is how it
// is then called, which is the same call.

// The method of this name a value of this kind answers to, if it has one.
//
// **Dispatch is on the kind of the receiver and not on the name alone**, so that a name belonging to
// another kind is refused rather than run: `xs.upper()` says an array cannot do that instead of
// reaching `upper` and complaining about its argument. The difference matters because the second
// message sends the reader to look at what they passed, when what is wrong is what they called.
// **AN OBJECT IS NOT IN THIS TABLE, AND THAT IS THE DECISION RATHER THAN AN OMISSION.** An object's
// names belong to the program: `o.keys` is `undefined` for an object with no such field, and a
// builtin answering there would make every object claim to have a `keys` and a `has` that no program
// put on it -- so `o.thing ?? fallback` would stop working for exactly those two names, silently and
// only for those two. **Objects already have a method mechanism, which is `proto`**, and a second
// invisible one underneath it would be the one nobody could see. `keys(o)` and `has(o, k)` stay the
// free functions they were; `keys(o).length` is how a program counts an object's own keys, `.length`
// belonging to arrays and strings and not to objects for the same reason.
builtin_method(v: Value, name: string) -> Option[NativeFn] = methods_of(method_kind(v), name)

// The word for the kind a value's methods are looked up under, or `""` for a value that has none.
//
// **An object answers `""` and that is the decision the header states**: its names belong to the
// program, and a builtin answering there would give every object a `keys` and a `has` that nothing
// put on it.
private method_kind(v: Value) -> string = v match
    Array(_) -> "array"
    Bytes(_) -> "bytes"
    Str(_) -> "string"
    Int(_) -> "number"
    Real(_) -> "number"
    InstantVal(_) -> "instant"
    DurationVal(_) -> "duration"
    DateVal(_) -> "date"
    TimeVal(_) -> "time"
    DateTimeVal(_, _) -> "dateTime"
    ZoneVal(_) -> "zone"
    ZonedVal(_, _) -> "zoned"
    PeriodVal(_, _) -> "period"
    RegexVal(_) -> "regex"
    Shape(_) -> "shape"
    Gen(_, _) -> "generator"
    ChildVal(_, _) -> "child"
    ChannelVal(_) -> "channel"
    RangeVal(_, _, _, _, _, _) -> "range"
    SetVal(_) -> "set"
    MapVal(_) -> "map"
    WeakMapVal(_) -> "weakMap"
    WeakRefVal(_) -> "weakRef"

    // **An actor and a message answer `""` for the OBJECT's reason**: a handle's field namespace
    // belongs entirely to the program, so `a.stop` is the handler somebody wrote called `stop` and a
    // builtin answering there would collide with a name they chose. `read_field` in `index.sysl` is
    // where a handle's field is answered, and it answers a message for any name at all.
    _ -> ""

// The same tables, reached by the name of a kind rather than by a value of it.
//
// **This is what lets the CHECKER refuse `"abc".push(1)` before it runs**, and it is one function
// rather than a second table for the same reason `method.sysl` is one table rather than a prototype
// object: two lists of what a string can do would drift, and the drift would be a checker refusing
// something the machine allows -- the one mistake that pass may not make. `check.sysl` asks with the
// word its own `TypeKind` carries, which is the word a program writes in an annotation.
methods_of(kind: string, name: string) -> Option[NativeFn]
    kind_method(kind, name) match
        Some(f) -> Some(f)

        // **The universal five are asked LAST, so a kind's own answer always wins** -- and they are
        // asked *here* rather than beside the dispatch so that the CHECKER learns them in the same
        // line the machine does. `"abc".eq("d")` is accepted before it runs because this function
        // answers, and a table the checker did not share is how a pass comes to refuse a program that
        // runs.
        None -> universal_method(name)
end methods_of

// What a value of this kind can do by virtue of being that kind, and nothing else.
private kind_method(kind: string, name: string) -> Option[NativeFn]
    if kind == "array" then return array_method(name)
    if kind == "bytes" then return bytes_method(name)
    if kind == "string" then return string_method(name)
    if kind == "number" || kind == "integer" || kind == "real" then return number_method(name)
    if kind == "instant" then return instant_method(name)
    if kind == "duration" then return duration_method(name)
    if kind == "date" then return date_method(name)
    if kind == "time" then return time_method(name)
    if kind == "dateTime" then return date_time_method(name)
    if kind == "zone" then return zone_method(name)
    if kind == "zoned" then return zoned_method(name)
    if kind == "period" then return period_method(name)
    if kind == "generator" then return generator_method(name)
    if kind == "child" then return child_method(name)
    if kind == "channel" then return channel_method(name)
    if kind == "regex" then return regex_method(name)
    if kind == "shape" then return shape_method(name)
    if kind == "set" then return set_method(name)
    if kind == "map" then return map_method(name)
    if kind == "weakMap" then return weak_map_method(name)
    if kind == "weakRef" then return weak_ref_method(name)

    None
end kind_method

// What a set can do. **JavaScript's surface**, and `size` is not here: it is a property, written
// `s.size`, which is how JavaScript spells it and where `set_property` below answers it.
private set_method(name: string) -> Option[NativeFn] = name match
    "add" -> Some(n_set_add)
    "has" -> Some(n_set_has)
    "delete" -> Some(n_set_delete)
    "clear" -> Some(n_set_clear)
    "values" -> Some(n_set_values)
    "forEach" -> Some(n_set_for_each)
    _ -> None

// What a map can do.
//
// **`keys`, `values` and `entries` answer ARRAYS where JavaScript answers iterators**, which is the
// same decision the object's three free functions already took: slate has no iterator protocol on a
// builtin, `for` walks the map itself, and an array is what every use of these does something to.
private map_method(name: string) -> Option[NativeFn] = name match
    "set" -> Some(n_map_set)
    "get" -> Some(n_map_get)
    "has" -> Some(n_map_has)
    "delete" -> Some(n_map_delete)
    "clear" -> Some(n_map_clear)
    "keys" -> Some(n_map_keys)
    "values" -> Some(n_map_values)
    "entries" -> Some(n_map_entries)
    "forEach" -> Some(n_map_for_each)
    _ -> None

// What a weak map can do: four names and no more.
//
// **`keys`, `values`, `entries`, `forEach`, `clear` and `size` are all absent, and none of them is
// an omission.** What is in a weak map is the collector's to decide, so a walk would answer
// something different on two runs of the same program with nothing between them -- and a count is a
// walk that says how long it was. JavaScript's `WeakMap` carries exactly these four for exactly this
// reason.
private weak_map_method(name: string) -> Option[NativeFn] = name match
    "set" -> Some(n_weak_map_set)
    "get" -> Some(n_weak_map_get)
    "has" -> Some(n_weak_map_has)
    "delete" -> Some(n_weak_map_delete)
    _ -> None

// What a weak reference can do, which is answer what it points at while that is still there.
private weak_ref_method(name: string) -> Option[NativeFn] = name match
    "deref" -> Some(n_weak_ref_deref)
    _ -> None

// The four methods EVERY value answers to, whatever its kind and whether or not it is an object.
//
// **This is the one place the header's rule above is deliberately broken, and the reason is the
// object model rather than convenience.** An object's names belong to the program, which is why
// `o.keys` is `undefined` and not a builtin -- but an object model is exactly a set of questions
// every value can be asked, and a language where `o.toString()` works only when somebody remembered
// to write one has not got one. Java, Scala, Python and Ruby all put these on the root type; slate
// puts them here, which is the same decision spelled in the mechanism it has.
//
// **The cost is stated rather than hidden: `o.eq ?? fallback` stops answering the fallback** for
// these four names, exactly as the header warns. That is why there are four and not forty -- the
// list is closed, it is the whole of the object protocol, and every name on it is one a program
// asking `??` about would have been asking a strange question.
//
// **`hash` IS A HOOK AND NOT ONE OF THESE, WHICH IS A NARROWING OF THE JAVA CONTRACT AND IS
// DELIBERATE.** A class may still write `hash(self)` and a table consults it, which is the half that
// does work; what is not here is a way for a program to READ the number. Two reasons, and the second
// is the one that decided it: the number is an implementation detail, so exposing it would pin both
// back ends to one arithmetic forever -- and the JavaScript runtime does no hashing at all, an
// `SObj` being a `Map` keyed by strings, so it would have shipped in one back end only.
//
// **A FIELD THE PROGRAM PUT THERE STILL WINS**, own or through a proto, because this table is
// consulted only where the lookup found nothing. So a class overrides any of the five by declaring
// it, and nothing here can shadow what a program wrote.
universal_method(name: string) -> Option[NativeFn] = name match
    "toString" -> Some(n_to_string)
    "eq" -> Some(n_eq)
    "ne" -> Some(n_ne)
    "equals" -> Some(n_equals)
    _ -> None

// What an array can do.
private array_method(name: string) -> Option[NativeFn] = name match
    "push" -> Some(n_push)
    "pop" -> Some(n_pop)
    "insert" -> Some(n_insert)
    "removeAt" -> Some(n_remove_at)
    "clear" -> Some(n_clear)
    "map" -> Some(n_map)
    "filter" -> Some(n_filter)
    "reduce" -> Some(n_reduce)
    "find" -> Some(n_find)
    "findIndex" -> Some(n_find_index)
    "every" -> Some(n_every)
    "some" -> Some(n_some)
    "sort" -> Some(n_sort)
    "sorted" -> Some(n_sorted)
    "reverse" -> Some(n_reverse)
    "reversed" -> Some(n_reversed)
    "concat" -> Some(n_concat)
    "flat" -> Some(n_flat)
    "flatMap" -> Some(n_flat_map)
    "forEach" -> Some(n_for_each)
    "slice" -> Some(n_slice)
    "at" -> Some(n_at)
    "shift" -> Some(n_shift)
    "unshift" -> Some(n_unshift)
    "findLast" -> Some(n_find_last)
    "findLastIndex" -> Some(n_find_last_index)
    "sum" -> Some(n_sum)
    "join" -> Some(n_join)
    "contains" -> Some(n_contains)
    "includes" -> Some(n_contains)
    "indexOf" -> Some(n_index_of)
    "lastIndexOf" -> Some(n_last_index_of)
    "string" -> Some(n_string)

    // The eight that answer with a different shape -- `reshape.sysl` holds them.
    "groupBy" -> Some(n_group_by)
    "zip" -> Some(n_zip)
    "unique" -> Some(n_unique)
    "chunk" -> Some(n_chunk)
    "count" -> Some(n_count)
    "partition" -> Some(n_partition)
    "minBy" -> Some(n_min_by)
    "maxBy" -> Some(n_max_by)
    _ -> None

// What a buffer of bytes can do.
//
// **A SHORT TABLE, AND SHORT ON PURPOSE.** An array's forty names are about values -- `map`, `sort`,
// `groupBy` -- and a buffer holds no values, only bytes. What a program does with one is measure it,
// read a byte, cut a piece out, join two together, and turn it into text or into numbers; everything
// else is `b.toArray()` away and answers an array, which is the kind that has the forty names.
//
// **`push`, `concat`, `slice`, `indexOf` and `contains` are the array's words**, and they are the same
// words deliberately: a program that had bytes as an array of numbers keeps the sentence it wrote.
private bytes_method(name: string) -> Option[NativeFn] = name match
    "push" -> Some(n_push)
    "slice" -> Some(n_slice)
    "concat" -> Some(n_concat)
    "indexOf" -> Some(n_index_of)
    "contains" -> Some(n_contains)
    "includes" -> Some(n_contains)
    "at" -> Some(n_at)
    "toArray" -> Some(n_to_array)
    "clear" -> Some(n_clear)
    _ -> None

// What a regular expression can do.
//
// **`replace` here is not the string's `replace`**, and the table is what keeps them apart: one takes
// a pattern and a replacement that may name groups, the other takes two pieces of literal text. A
// name is looked up by the kind of the receiver, so `s.replace(a, b)` and `re.replace(s, b)` reach
// different implementations and complain in different words.
//
// **There is no `g` flag and so no `matchAll` beside `match`.** `findAll` finds every match because
// that is what it is for, and `replace` replaces every one; JavaScript needs two of each because its
// patterns carry a mutable position.
private regex_method(name: string) -> Option[NativeFn] = name match
    "test" -> Some(n_re_test)
    "find" -> Some(n_re_find)
    "findAll" -> Some(n_re_find_all)
    "replace" -> Some(n_re_replace)
    "replaceFirst" -> Some(n_re_replace_first)
    "split" -> Some(n_re_split)
    "pattern" -> Some(n_re_pattern)
    "flags" -> Some(n_re_flags)
    _ -> None

// What a declared type can do, once it is a value.
//
// **Three and no more, and the absent fourth is the point**: there is no way to read a shape's
// fields back out, so nothing downstream can grow to depend on the structure of a type. `test`
// answers whether a value fits, `mismatch` answers what does not, and `name` is what the
// declaration called it -- which is what a diagnostic wants and all it wants.
// Not `private`: `index.sysl` asks it of a CLASS OBJECT as well, a class and a data type carrying
// their own shape under `ShapeTag` -- so `Circle.test(v)` and `NewNote.test(v)` are one table and
// one implementation.
shape_method(name: string) -> Option[NativeFn] = name match
    "test" -> Some(n_shape_test)
    "mismatch" -> Some(n_shape_mismatch)
    "name" -> Some(n_shape_name)
    _ -> None

// What a string can do. Every one of these counts and cuts in CHARACTERS -- see `text.sysl`.
private string_method(name: string) -> Option[NativeFn] = name match
    "chars" -> Some(n_chars)
    "split" -> Some(n_split)
    "contains" -> Some(n_contains)
    "includes" -> Some(n_contains)
    "indexOf" -> Some(n_index_of)
    "lastIndexOf" -> Some(n_last_index_of)
    "startsWith" -> Some(n_starts_with)
    "endsWith" -> Some(n_ends_with)
    "trim" -> Some(n_trim)
    "trimStart" -> Some(n_trim_start)
    "trimEnd" -> Some(n_trim_end)
    "upper" -> Some(n_upper)
    "lower" -> Some(n_lower)
    "normalize" -> Some(n_normalize)
    "casefold" -> Some(n_casefold)
    "replace" -> Some(n_replace)
    "replaceAll" -> Some(n_replace)
    "repeat" -> Some(n_repeat)
    "padStart" -> Some(n_pad_start)
    "padEnd" -> Some(n_pad_end)
    "number" -> Some(n_number)
    "integer" -> Some(n_integer)
    "real" -> Some(n_real)
    "boolean" -> Some(n_boolean)
    "string" -> Some(n_string)
    _ -> None

// What a number can do.
private number_method(name: string) -> Option[NativeFn] = name match
    "abs" -> Some(n_abs)
    "floor" -> Some(n_floor)
    "ceil" -> Some(n_ceil)
    "round" -> Some(n_round)
    "trunc" -> Some(n_trunc)
    "sqrt" -> Some(n_sqrt)
    "sin" -> Some(n_sin)
    "cos" -> Some(n_cos)
    "tan" -> Some(n_tan)
    "asin" -> Some(n_asin)
    "acos" -> Some(n_acos)
    "atan" -> Some(n_atan)
    "sinh" -> Some(n_sinh)
    "cosh" -> Some(n_cosh)
    "tanh" -> Some(n_tanh)
    "log" -> Some(n_log)
    "log2" -> Some(n_log2)
    "log10" -> Some(n_log10)
    "exp" -> Some(n_exp)
    "cbrt" -> Some(n_cbrt)
    "integer" -> Some(n_integer)
    "real" -> Some(n_real)
    "boolean" -> Some(n_boolean)
    "string" -> Some(n_string)

    // The two that write a number for a person: how many places, and where the thousands go.
    "toFixed" -> Some(n_to_fixed)
    "formatNumber" -> Some(n_format_number)

    // **A number makes a length of time**, which is what `sleep(2.seconds())` is written with. It
    // comes free from the rule this file is built on -- a method is the free function with the
    // receiver in front -- so `2.seconds()` and `seconds(2)` are the one call.
    "micros" -> Some(n_micros)
    "millis" -> Some(n_millis)
    "seconds" -> Some(n_seconds)
    "minutes" -> Some(n_minutes)
    "hours" -> Some(n_hours)
    "days" -> Some(n_days)
    "weeks" -> Some(n_weeks)
    "months" -> Some(n_months)
    "years" -> Some(n_years)
    "epochSeconds" -> Some(n_epoch_seconds)
    "epochMillis" -> Some(n_epoch_millis)
    "epochMicros" -> Some(n_epoch_micros)
    _ -> None

// **An instant answers almost nothing, and that is the design rather than an oversight.** It is a
// point on the timeline and knows no calendar: the year, the month and the hour are all questions
// about a zone, so the only way through is `.at(zone)`. A JavaScript `Date` answers all of them and
// picks the zone for you, which is the single most expensive convenience in that library.
private instant_method(name: string) -> Option[NativeFn] = name match
    "at" -> Some(n_at)
    "instant" -> Some(n_instant)

    // **`format` is here so that it can be REFUSED with a sentence that helps.** Leaving it out
    // would answer "`format` is not something an instant can do", which is true and sends the reader
    // to look at the pattern; what is wrong is one step earlier, and `do_format` says so.
    "format" -> Some(n_format)
    "epochSeconds" -> Some(n_epoch_seconds)
    "epochMillis" -> Some(n_epoch_millis)
    "epochMicros" -> Some(n_epoch_micros)
    "string" -> Some(n_string)
    _ -> None

// A length of timeline, read back in whole units. **No `days`**: a day is not a fixed length, so a
// duration cannot be asked how many of them it is -- see `value.sysl`.
private duration_method(name: string) -> Option[NativeFn] = name match
    "micros" -> Some(n_micros)
    "millis" -> Some(n_millis)
    "seconds" -> Some(n_seconds)
    "minutes" -> Some(n_minutes)
    "hours" -> Some(n_hours)
    "string" -> Some(n_string)
    _ -> None

private date_method(name: string) -> Option[NativeFn] = name match
    "year" -> Some(n_year)
    "month" -> Some(n_month)
    "day" -> Some(n_day)
    "weekday" -> Some(n_weekday)
    "monthName" -> Some(n_month_name)
    "dayOfYear" -> Some(n_day_of_year)
    "daysInMonth" -> Some(n_days_in_month)
    "isLeapYear" -> Some(n_is_leap_year)
    "at" -> Some(n_at)
    "startOf" -> Some(n_start_of)
    "onOrAfter" -> Some(n_on_or_after)
    "format" -> Some(n_format)
    "string" -> Some(n_string)
    _ -> None

private time_method(name: string) -> Option[NativeFn] = name match
    "hour" -> Some(n_hour)
    "minute" -> Some(n_minute)
    "second" -> Some(n_second)
    "micros" -> Some(n_micros)
    "format" -> Some(n_format)
    "string" -> Some(n_string)
    _ -> None

private date_time_method(name: string) -> Option[NativeFn] = name match
    "date" -> Some(n_date)
    "time" -> Some(n_time)
    "year" -> Some(n_year)
    "month" -> Some(n_month)
    "day" -> Some(n_day)
    "hour" -> Some(n_hour)
    "minute" -> Some(n_minute)
    "second" -> Some(n_second)
    "micros" -> Some(n_micros)
    "weekday" -> Some(n_weekday)
    "monthName" -> Some(n_month_name)
    "dayOfYear" -> Some(n_day_of_year)
    "daysInMonth" -> Some(n_days_in_month)
    "isLeapYear" -> Some(n_is_leap_year)
    "at" -> Some(n_at)
    "startOf" -> Some(n_start_of)
    "format" -> Some(n_format)
    "string" -> Some(n_string)
    _ -> None

// **A zone's three questions all take an instant**, because a zone's answer changes through the
// year. That is the thing a program written against a fixed offset forgets, and the signature is
// where it is best remembered.
private zone_method(name: string) -> Option[NativeFn] = name match
    "offset" -> Some(n_offset)
    "isDST" -> Some(n_is_dst)
    "abbrev" -> Some(n_abbrev)
    "string" -> Some(n_string)
    _ -> None

private zoned_method(name: string) -> Option[NativeFn] = name match
    "instant" -> Some(n_instant)
    "zone" -> Some(n_zone)
    "date" -> Some(n_date)
    "time" -> Some(n_time)
    "dateTime" -> Some(n_date_time)
    "year" -> Some(n_year)
    "month" -> Some(n_month)
    "day" -> Some(n_day)
    "hour" -> Some(n_hour)
    "minute" -> Some(n_minute)
    "second" -> Some(n_second)
    "micros" -> Some(n_micros)
    "weekday" -> Some(n_weekday)
    "monthName" -> Some(n_month_name)
    "dayOfYear" -> Some(n_day_of_year)
    "daysInMonth" -> Some(n_days_in_month)
    "isLeapYear" -> Some(n_is_leap_year)
    "offset" -> Some(n_offset)
    "isDST" -> Some(n_is_dst)
    "abbrev" -> Some(n_abbrev)
    "at" -> Some(n_at)
    "startOf" -> Some(n_start_of)
    "format" -> Some(n_format)
    "epochSeconds" -> Some(n_epoch_seconds)
    "epochMillis" -> Some(n_epoch_millis)
    "epochMicros" -> Some(n_epoch_micros)
    "string" -> Some(n_string)
    _ -> None

// **`weeks` and `days` convert and `months` and `years` convert, and the two pairs never meet.**
// `weeks(2).days()` is 14; `months(1).days()` is 0, because a month is not a number of days.
private period_method(name: string) -> Option[NativeFn] = name match
    "days" -> Some(n_days)
    "weeks" -> Some(n_weeks)
    "months" -> Some(n_months)
    "years" -> Some(n_years)
    "string" -> Some(n_string)
    _ -> None

// **A generator answers `next` and nothing else.** `for x in g` is the other way to drive one and
// needs no name at all, and everything a program might want here -- `map`, `take`, `collect` -- is a
// function over a generator rather than a method on one, which is what a function is for.
private generator_method(name: string) -> Option[NativeFn] = name match
    "next" -> Some(n_gen_next)
    "string" -> Some(n_string)
    _ -> None

// What a child process can do. **Methods rather than free functions, which is where this parts from
// `slate:net`**: a socket's `send` and `close` are names `slate:net` could take because a program
// importing them said it wanted them, and a supervisor holding several children wants `worker.send`
// -- one noun with everything hanging off it -- the way `slate:sqlite` and `slate:redis` read.
// `pid` and `exited` are not here: neither is a call, and `child_property` answers both.
private child_method(name: string) -> Option[NativeFn] = name match
    "send" -> Some(n_child_send)
    "kill" -> Some(n_child_kill)
    "onMessage" -> Some(n_child_on_message)
    "onExit" -> Some(n_child_on_exit)
    _ -> None

// What this program's own end of the channel can do, which is the two halves of a conversation and
// nothing else. **There is no `close`**: a worker ends by ending, and a supervisor closes a channel
// by letting the child go.
private channel_method(name: string) -> Option[NativeFn] = name match
    "send" -> Some(n_channel_send)
    "onMessage" -> Some(n_channel_on_message)
    _ -> None

// What to say when a name is not a method of this kind of value.
//
// **It names the kind rather than the name alone**, because the reader's next move depends on which
// of the two is wrong -- a misspelling is fixed at the call and a wrong receiver is fixed further
// back.
no_such_method(v: Value, name: string) -> string
    // **A missing value gets a different sentence, because the fix is different.** "`b` is not
    // something null can do" is true and sends the reader to look at `b`; what is actually wrong is
    // one link earlier, and `?.` is the thing to write.
    if is_nullish(v)
        return s"there is nothing here to read `${name}` from -- `?.` answers null where a value may be missing"

    s"`${name}` is not something ${v.type_name()} can do"
end no_such_method

// -- properties ------------------------------------------------------------------------------------

// The property of this name a value of this kind answers to, if it has one.
//
// **A PROPERTY IS A NAME READ WITH A `.` THAT ANSWERS A VALUE, AND THERE IS NO CALL.** `s.length`
// answers a number where `s.len()` answers the same number and `s.len` hands back the free function
// -- so a property is not a method with the brackets left off, it is the other thing a `.` can mean.
// A class already has both, `get area(self)` being read as `c.area`; this is that idea on a value
// with no fields to put one on.
//
// **THIS IS THE TABLE A NEW PROPERTY IS ADDED TO**, and the reason it is a table rather than a test
// for one name: `size` on a set and on a map is the same shape and belongs here beside `length`,
// which is what keeps `read_field`, `SetField` and the checker from growing a case each per property.
//
// **The native is the FREE FUNCTION the property answers with**, exactly as a method's is -- `length`
// is `NLen` on every kind it appears on, so an array, a string and a range cannot come to disagree
// about what a character or an element is.
builtin_property(v: Value, name: string) -> Option[NativeFn] = properties_of(method_kind(v), name)

// The same table, reached by the name of a kind rather than by a value of it.
//
// **What lets the CHECKER give `s.length` a type**, and it is one function rather than a second table
// for `methods_of`'s reason: two lists of what a kind carries would drift, and the drift would be a
// pass describing a language slate is not.
properties_of(kind: string, name: string) -> Option[NativeFn]
    if kind == "array" then return array_property(name)
    if kind == "bytes" then return bytes_property(name)
    if kind == "string" then return string_property(name)
    if kind == "range" then return range_property(name)
    if kind == "set" then return set_property(name)
    if kind == "map" then return map_property(name)
    if kind == "child" then return child_property(name)

    None
end properties_of

// **What a child IS rather than what it does**, which is the line every property here is on: a
// process id is a number the child has, and `exited` is the one promise it will ever settle. A call
// would suggest either could answer differently the second time it was asked.
private child_property(name: string) -> Option[NativeFn] = name match
    "pid" -> Some(n_child_pid)
    "exited" -> Some(n_child_exited)
    _ -> None

private array_property(name: string) -> Option[NativeFn] = name match
    "length" -> Some(n_length)
    _ -> None

// **HOW MANY BYTES, and `length` rather than `size` because a buffer IS a sequence** -- every byte in
// one is at a position and `b[3]` reads it, which is the test the set and the map fail. `n_length` is
// the free function here as it is on an array and a string, so `b.length` and `len(b)` cannot drift.
private bytes_property(name: string) -> Option[NativeFn] = name match
    "length" -> Some(n_length)
    _ -> None

// **Characters, not UTF-16 units**, `n_length` being the free function underneath `.length` on every
// kind it appears on: `"a👋".length` is 2 here and 3 in JavaScript, and the JavaScript back end
// counts what this counts rather than what its host does.
private string_property(name: string) -> Option[NativeFn] = name match
    "length" -> Some(n_length)
    _ -> None

// **How many whole numbers a range covers**, the same count a `for` walks -- so `(0..<3).length` is
// 3 and a range with an end left out faults exactly as `n_length`'s implementation already does,
// there being no second implementation to keep in step with it.
private range_property(name: string) -> Option[NativeFn] = name match
    "length" -> Some(n_length)
    _ -> None

// **How many values a set holds, spelled the way JavaScript spells it.** `length` is deliberately
// absent: a set is not a sequence, nothing is at a position in one, and a program that asks for
// `s.length` has confused it with an array -- so the missing-field fault is the answer that says so.
private set_property(name: string) -> Option[NativeFn] = name match
    "size" -> Some(n_set_size)
    _ -> None

// **How many pairs a map holds**, `length` absent for the set's reason.
private map_property(name: string) -> Option[NativeFn] = name match
    "size" -> Some(n_map_size)
    _ -> None

// What to say when a property of a builtin kind is assigned to.
//
// **A property of a builtin kind is READ-ONLY, and the sentence names the property rather than the
// assignment**, which is where the reader has to look: `s.length = 3` is a mistake about what
// `length` is, not about strings having no fields. A class's `get` with no `set` says the same thing
// in the same words, `index.sysl` writing that half.
read_only_property(v: Value, name: string) -> string =
    s"`${name}` is a read-only property of ${v.type_name()}"
