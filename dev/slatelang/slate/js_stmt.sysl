module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.str_builder

// Statements as JavaScript: a run of them, what a block declares, an assignment, a definition, and
// the two jumps out of a loop.
//
// **Cut out of `js.sysl` on the heading it already had, and nothing crosses in either direction.**
// That file keeps the entry points, the writer and how a name is spelled -- all of which this one
// uses and none of which uses this one.
// -- statements -----------------------------------------------------------------------------------

// A run of statements, for effect.
emit_stmts(j: *Js, stmts: Buf[Stmt])
    val outer = open_block(j, stmts)

    for i in 0..<stmts.len()
        emit_stmt(j, stmts.at(i))

    close_block(j, outer)

// Begin a JavaScript block, working out what the run of statements in it declares twice.
//
// **A block is where a redeclaration is illegal, so it is what has to be counted.** What the block
// around it declared is neither here nor there -- a name declared again inside a nested one is
// shadowing, which JavaScript is happy with -- so the outer block's answer is put aside and given
// back when this one ends.
private open_block(j: *Js, stmts: Buf[Stmt]) -> JsBlock
    val outer = JsBlock(j.rebound, j.bound)

    j.rebound = declared_twice(stmts, j.pending)
    j.bound = j.pending
    j.pending = buf()
    outer
end open_block

private close_block(j: *Js, outer: JsBlock)
    j.rebound = outer.rebound
    j.bound = outer.bound
    j.pending = buf()

// The names this run declares more than once, which are the ones a `const` cannot hold.
private declared_twice(stmts: Buf[Stmt], already: Buf[string]) -> Buf[string]
    var seen = already
    var twice: Buf[string] = buf()

    for i in 0..<stmts.len()
        var here: Buf[string] = buf()

        *stmts.at(i).kind match
            Val(name, _) -> here.push(name)
            Var(name, _) -> here.push(name)
            Def(name, _, _, _, _) -> here.push(name)
            Unpack(pat, _, _) -> pattern_names(resolve_pattern(pat, 0), &here)

            // A group binds every name its statements do, and the ones one `data` line writes are
            // all `val`s. Missing this would leave a variant undeclared in the emitted module.
            Group(stmts) ->
                for m in 0..<stmts.len()
                    *stmts.at(m).kind match
                        Val(name, _) -> here.push(name)
                        _ -> ()
            ImportNames(_, _, _, _, locals) ->
                for k in 0..<locals.len()
                    here.push(locals.at(k))
            ImportAll(_, _, _, alias) -> here.push(alias)

            // A type is a value under its own name here as it is for the machine.
            TypeDecl(name, _) -> here.push(name)
            _ -> ()

        for k in 0..<here.len()
            val name = here.at(k)

            if holds(seen, name)
                if !holds(twice, name) then twice.push(name)
            else
                seen.push(name)

    twice
end declared_twice

holds(names: Buf[string], name: string) -> bool
    for i in 0..<names.len()
        if names.at(i) == name then return true

    false
end holds

// How a name is introduced here: `const `, `let `, or nothing at all where it is being declared a
// second time in one block.
//
// **A name is `let` from the start where the block declares it again**, since the second one is an
// assignment and assigning to a `const` is a fault rather than a refusal to start.
declaring(j: *Js, name: string, immutable: bool) -> string
    if holds(j.bound, name) then return ""

    j.bound.push(name)

    if holds(j.rebound, name) then return "let "

    if immutable then "const " else "let "
end declaring

// A name a binder declares into the block that is about to open.
//
// **Always `let`, because whether the body declares it again is not known here** -- the binding is
// written before the run of statements that would say so. A `for` over a name whose body binds the
// same name is the case, and it is an ordinary thing to write.
declaring_into_block(j: *Js, name: string) -> string
    if holds(j.pending, name) then return ""

    j.pending.push(name)
    "let "
end declaring_into_block

// A run of statements whose last value is wanted, assigned into `into`.
//
// **A block's value is what its last statement left**, which is slate's rule, and only an expression
// statement leaves anything: a `val` evaluates to null, as does a definition and an assignment. So
// the last statement is emitted into the temporary and every other one for effect.
emit_stmts_into(j: *Js, stmts: Buf[Stmt], into: string)
    if stmts.len() == 0
        line(j, s"${into} = null;")
        return
    end if

    val outer = open_block(j, stmts)

    for i in 0..<stmts.len() - 1
        emit_stmt(j, stmts.at(i))

    val last = stmts.at(stmts.len() - 1)

    *last.kind match
        Eval(e) ->
            // The last statement is emitted here rather than through `emit_stmt`, so the line it is
            // on has to be said here too.
            mark(j, last.span)

            val v = emit_expr(j, e)

            line(j, s"${into} = ${v};")
        _ ->
            emit_stmt(j, last)
            line(j, s"${into} = null;")

    close_block(j, outer)
end emit_stmts_into

// Say which line the program is on, where it has changed since the last thing emitted said so.
//
// **A line table, which is what a fault needs and JavaScript cannot supply.** A caught fault is an
// object carrying `message`, `line` and `file`, and the line has to be slate's -- a `catch` reading
// the line of the emitted JavaScript would be reading a file the programmer never saw.
//
// **Per statement and only where it changed**, so a long expression costs nothing and two
// statements on one line cost one marker.
private mark(j: *Js, at: Span)
    val here = j.src.locate(at.start).line

    // **Where the file travels too, every statement gets a marker whether or not the line moved.**
    // A call that returned a moment ago left the callee's file behind it, and the next statement is
    // what puts this one back -- so a marker skipped for saying the same line as the one before it
    // would leave a fault naming the file it was raised in the last time somebody was called.
    if j.stamp
        j.last_line = here
        line(j, s"$$.at(${here}, ${j.file});")

        return
    end if

    if here == j.last_line then return

    j.last_line = here
    line(j, s"$$.at(${here});")
end mark

// One statement, for effect.
emit_stmt(j: *Js, s: Stmt)
    val at = s.span

    mark(j, at)

    *s.kind match
        // Each is emitted where the group stands, for the reason the machine compiles it there: the
        // names belong to the scope around it and not to one of its own.
        Group(stmts) -> for i in 0..<stmts.len() do emit_stmt(j, stmts.at(i))
        Val(name, init) ->
            val v = emit_expr(j, init)

            line(j, s"${declaring(j, name, true)}${js_name(name)} = ${v};")
        Var(name, init) ->
            val v = emit_expr(j, init)

            line(j, s"${declaring(j, name, false)}${js_name(name)} = ${v};")
        Unpack(pat, init, immutable) ->
            val v = emit_expr(j, init)
            val subject = fresh(j)

            line(j, s"const ${subject} = ${v};")
            emit_binding(j, pat, subject, immutable, at)
        Assign(op, target, value) -> emit_assign(j, op, target, value, at)
        MultiAssign(op, targets, values) -> emit_multi_assign(j, op, targets, values, at)
        Def(name, params, defaults, body, is_async) ->
            // **A definition is a JavaScript function declaration where it can be**, which is what
            // makes the emitted code read like the program. One that is defined again in the same
            // run is bound to a name instead: two `function f` in one block are legal JavaScript and
            // mean the wrong thing, the second winning even for a call written between them.
            val how = declaring(j, name, true)

            if how == "const "
                emit_function(j, "", js_name(name), js_name(name), params, defaults, body, is_async, "", at)
            else
                emit_function(j, s"${how}${js_name(name)} = ", "", js_name(name), params, defaults, body, is_async, ";", at)
        Eval(e) ->
            val v = emit_expr(j, e)

            // **A statement that came out as a bare name is not written at all.** Every control form
            // is emitted as a temporary plus the statements that fill it, so a loop written for its
            // effect ends with the name of a temporary nobody reads -- which JavaScript is happy to
            // evaluate and a reader has to work out is nothing.
            if !is_bare_name(v) then line(j, s"${v};")
        Return(value) ->
            value match
                Some(e) ->
                    val v = emit_expr(j, e)

                    line(j, s"return ${v};")
                None -> line(j, "return null;")
        Throw(value) ->
            val v = emit_expr(j, value)

            line(j, s"throw new $$.Thrown(${v});")
        Break(label, value) -> emit_break(j, label, value, at)
        Continue(label) -> emit_continue(j, label, at)

        // **A type binds a value here as it does for the machine** -- the pattern it stands for, as
        // the same data `is` is emitted against, and the name it was declared under.
        //
        // **The pattern literal is evaluated WHERE THE DECLARATION STANDS**, so a `["proto", Circle]`
        // inside it captures the class lexically. That is the declaring scope the interpreter has to
        // hold a pointer to, arriving here for nothing.
        TypeDecl(name, pat) ->
            line(j, s"${declaring(j, name, true)}${js_name(name)} = $$.shape(${emit_shape(j, pat)}, ${quoted_js(name)});")

        // `p: Point` -- what the parser leaves behind an annotated parameter, and the machine's
        // `CheckType`. **The complaint names all three things a reader needs**: the parameter, the
        // type it was declared as, and what arrived -- which is why it is written out here rather
        // than left to `$.matches` to say something general.
        CheckType(name, declared, pat) ->
            val test = emit_test(j, pat, js_name(name))

            line(j, s"if (!(${test})) $$.fault(\"`${name}` was declared ${declared}, and was given \" + $$.plainShow(${js_name(name)}));")

        // **An import is a field taken out of the module's object, which is what the module already
        // is.** The file it names has been emitted above this one -- `Loaded.order` is what
        // guarantees that -- so the `const` holding it is in scope and nothing has to be looked up
        // at run time. Every path here resolved while loading, so a lookup that fails now is a
        // compiler bug and is reported as one.
        ImportNames(path, path_at, origin, names, locals) ->
            module_of(j, path, origin) match
                Some(m) ->
                    // **Every name, including a type**, which is a value here as it is for the
                    // machine -- see the `ImportNames` arm of `compile_stmt`.
                    for i in 0..<names.len()
                        val local = locals.at(i)

                        line(j, s"${declaring(j, local, true)}${js_name(local)} = $$.field($$m${m}, ${quoted_js(names.at(i))});")
                None -> complain(j, path_at, s"the module `${path}` was never loaded")
        ImportAll(path, path_at, origin, alias) ->
            module_of(j, path, origin) match
                Some(m) -> line(j, s"${declaring(j, alias, true)}${js_name(alias)} = $$m${m};")
                None -> complain(j, path_at, s"the module `${path}` was never loaded")
end emit_stmt

// Which file an import written in this one names.
//
// **The path is resolved by the compiler's own resolver, from the unit the program was just
// compiled into.** There is one rule for what a path means and it lives in `module.sysl`; asking it
// through `module_want_from` is what keeps this from being a second answer to the same question.
private module_of(j: *Js, raw: string, origin: Origin) -> Option[usize]
    val want = module_want_from(&current_unit, j.file, raw, origin)

    for i in 0..<current_unit.sources.len()
        if current_unit.sources.at(i).name == want then return Some(i)

    None
end module_of

// `x = e`, `x += e` and their neighbours, over a name, an index or a field.
private emit_assign(j: *Js, op: Tok, target: Expr, value: Expr, at: Span)
    *target.kind match
        Name(name) ->
            val v = emit_operand(j, op, target, value, at)

            line(j, s"${js_name(name)} = ${v};")
        Index(t, k) ->
            val obj = emit_expr(j, t)
            val key = emit_expr(j, k)
            val a = fresh(j)
            val b = fresh(j)

            line(j, s"const ${a} = ${obj};")
            line(j, s"const ${b} = ${key};")

            var v = ""

            if op == Assign
                v = emit_expr(j, value)
            else
                v = emit_arith(j, op, s"$$.index(${a}, ${b})", emit_expr(j, value))

            line(j, s"$$.setIndex(${a}, ${b}, ${v});")
        Field(t, name, _) ->
            val obj = emit_expr(j, t)
            val a = fresh(j)

            line(j, s"const ${a} = ${obj};")

            var v = ""

            if op == Assign
                v = emit_expr(j, value)
            else
                v = emit_arith(j, op, s"$$.field(${a}, ${quoted_js(name)})", emit_expr(j, value))

            line(j, s"$$.setField(${a}, ${quoted_js(name)}, ${v});")
        _ -> complain(j, at, "this cannot be assigned to")
end emit_assign

// The right-hand side of an assignment, which for `+=` is the operator applied to what is there.
private emit_operand(j: *Js, op: Tok, target: Expr, value: Expr, at: Span) -> string
    if op == Assign then return emit_expr(j, value)

    val was = emit_expr(j, target)
    val v = emit_expr(j, value)

    emit_arith(j, op, was, v)
end emit_operand

// `a, b = b, a`: every value is worked out before any name is written.
private emit_multi_assign(j: *Js, op: Tok, targets: Buf[Expr], values: Buf[Expr], at: Span)
    var held: Buf[string] = buf()

    for i in 0..<values.len()
        val v = emit_expr(j, values.at(i))
        val t = fresh(j)

        line(j, s"const ${t} = ${v};")
        held.push(t)

    for i in 0..<targets.len()
        if i < held.len()
            emit_assign_to(j, op, targets.at(i), held.at(i), at)
end emit_multi_assign

// An assignment whose value is already in hand.
private emit_assign_to(j: *Js, op: Tok, target: Expr, value: string, at: Span)
    *target.kind match
        Name(name) ->
            val v = if op == Assign then value else emit_arith(j, op, js_name(name), value)

            line(j, s"${js_name(name)} = ${v};")
        Index(t, k) ->
            val obj = emit_expr(j, t)
            val key = emit_expr(j, k)

            line(j, s"$$.setIndex(${obj}, ${key}, ${value});")
        Field(t, name, _) ->
            val obj = emit_expr(j, t)

            line(j, s"$$.setField(${obj}, ${quoted_js(name)}, ${value});")
        _ -> complain(j, at, "this cannot be assigned to")
end emit_assign_to

// -- functions --------------------------------------------------------------------------------------

// A definition or a lambda, written as `<before>function <name>(params) { ... }<after>`.
//
// **`before` and `after` are what tell a definition from a lambda**: a definition is a statement and
// stands on its own, and a lambda is bound to a temporary, so it arrives as `const $t1 = ` and ends
// with a semicolon. Both are otherwise the same function, which is why there is one of these.
//
// **A default is a JavaScript default**, and the two mean the same thing here: slate works one out
// in the callee when the argument was not given, and JavaScript does the same. That holds only
// because `undefined` cannot be passed to a slate function -- the runtime's `keep` refuses it -- so
// a default can never be triggered by a value the program meant to pass.
//
// **A generator is a `function*`, and a body knows whether it is one**: `body_is_gen` is what the
// parser worked out from the `yield`s it read, which is the same question `compile_chunk` asks.
// **`bound` is how to reach the function afterwards**, which is what the two properties below are
// written onto. A named argument is placed against the callee's parameters at the call, and a
// JavaScript function does not reliably say what its parameters are called -- so every function this
// back end writes carries them, along with how many of them a call must give.
emit_function(j: *Js, before: string, name: string, bound: string, params: Buf[string], defaults: Buf[Expr], body: usize, is_async: bool, after: string, at: Span)
    val star = if body_is_gen(body) then "*" else ""
    val prefix = if is_async then "async " else ""
    val called = if name == "" then "" else " " + name

    line(j, s"${before}${prefix}function${star}${called}(${params_text(j, params, defaults)}) {")
    open(j)

    val answer = fresh(j)

    line(j, s"let ${answer};")

    // **A body runs at a different time from the text around it, so what the last marker said means
    // nothing inside it.** A marker is written only where the line changed, and the line a function
    // is defined on is the line its first statement is usually on -- so a body that trusted the
    // count would begin with no marker at all, and a fault in it would be reported at whatever line
    // the CALLER was on. Forgetting on the way in and again on the way out is the whole fix.
    // **THE PARAMETERS ARE ALREADY BOUND IN THE BLOCK THE BODY IS ABOUT TO OPEN.** slate reads the
    // parameter list and the body as two scopes, so `f(x) = ...` whose body says `val x` is ordinary
    // shadowing; JavaScript reads them as one, so a `const x` beside a parameter `x` is a **syntax
    // error** and the whole program fails to load. Handing the names to the block makes the second
    // binding an assignment, which is exactly what this back end already does for a name a block
    // declares twice -- `declared_twice` and `rebound` are that same rule, and this is the one place
    // it was not being asked.
    // **Saved and put back, because a body that is ONE EXPRESSION opens no block to consume it.**
    // `open_block` is what takes `pending` and makes it `bound`, and `emit_body_into` reaches it only
    // for a `Block` -- so `f(self) = self.x` would have left `self` sitting in `pending` for whatever
    // block opened next. The generated `new` of a class is the next thing after a method, and it
    // declares a `self` of its own: `const self` became a bare `self =` naming nothing, and the
    // program died with `self is not defined` at run time.
    // **AND THE BODY'S OWN SCOPE IS PUT IN PLACE HERE, for the same reason and with the same
    // reach.** A body that opens a block gets one from `open_block`; a one-expression body gets none
    // at all, so `declaring` was answering about the block OUTSIDE the function. A name the body
    // introduces then came out as an assignment to somebody else's binding -- `named(v) = v is n`
    // written under a module-level `var n` wrote 7 into that `n`, where the interpreter binds the
    // name in the call and leaves the outer one alone. A function body is a scope in JavaScript as
    // much as in slate; this is the record of it catching up with the fact.
    val outer_pending = j.pending
    val outer_bound = j.bound
    val outer_rebound = j.rebound

    j.pending = buf()

    for i in 0..<params.len()
        j.pending.push(plain_param(params.at(i)))

    j.bound = j.pending
    j.rebound = buf()
    j.last_line = 0
    emit_body_into(j, body_at(body), answer)
    j.pending = outer_pending
    j.bound = outer_bound
    j.rebound = outer_rebound
    j.last_line = 0
    line(j, s"return ${answer};")
    close(j)
    line(j, "}" + after)

    if bound != "" && !params.is_empty()
        line(j, s"$$.sig(${bound}, ${params_json(params)}, ${required_of(params, defaults)});")
end emit_function

// The parameter names as a JavaScript array literal, a rest parameter keeping its dots.
//
// **The mark is what tells the arrangement that naming an argument is refused** -- a rest parameter
// is not a slot a name can pick out, it is everything left over.
private params_json(params: Buf[string]) -> string
    var out = str_builder()

    out.push_char('[')

    for i in 0..<params.len()
        if i > 0 then out.push(", ")

        rest_param(params.at(i)) match
            Some(plain) -> out.push(quoted_js("..." + plain))
            None -> out.push(quoted_js(params.at(i)))

    out.push_char(']')
    out.finish()
end params_json

// How many arguments a call must give: every parameter that has no default, a rest one not counting.
private required_of(params: Buf[string], defaults: Buf[Expr]) -> usize
    val fixed = if variadic_here(params) then params.len() - 1 else params.len()

    fixed - defaults.len()

// The parameter list, with each default written where JavaScript wants it.
//
// **A default is emitted as an expression and never as hoisted statements**, which is what stops a
// block from being written into a parameter list. A default that needs statements -- a `match`, a
// loop -- is emitted as an immediately-called function instead, which is the one place this back end
// uses one and is safe there: a default runs before the body, so there is no `return`, `break` or
// `await` of the enclosing function to break.
// **`defaults` covers the LAST of the parameters**, which the parser has already made sure of -- so
// the first parameter with one is `params.len() - defaults.len()`, and reading the two lists in step
// gives every default to the wrong parameter. That mistake is silent: the function still takes the
// arguments it took, and only a call that leaves one out shows it.
private params_text(j: *Js, params: Buf[string], defaults: Buf[Expr]) -> string
    var out = str_builder()

    // **A rest parameter is JavaScript's own `...`**, which is the one place the two languages agree
    // outright: it gathers into an array, it must be last, and it is bound to an empty array where a
    // call gave nothing left over. So the mark comes off and the dots go back on.
    val fixed = if variadic_here(params) then params.len() - 1 else params.len()
    val required = fixed - defaults.len()

    for i in 0..<params.len()
        if i > 0 then out.push(", ")

        rest_param(params.at(i)) match
            Some(name) ->
                out.push("...")
                out.push(js_name(name))
            None ->
                out.push(js_name(params.at(i)))

                if i >= required
                    out.push(" = ")
                    out.push(emit_inline(j, defaults.at(i - required)))

    out.finish()
end params_text

// Whether the last parameter gathers what is left over.
private variadic_here(params: Buf[string]) -> bool =
    !params.is_empty() && rest_param(params.at(params.len() - 1)).is_some()

// A function's body, whose value is the function's answer.
emit_body_into(j: *Js, body: Expr, into: string)
    *body.kind match
        Block(stmts) -> emit_stmts_into(j, stmts, into)
        _ ->
            // **A body that is one expression says its line too.** Only statements are marked, and a
            // branch written as `else "done"` holds no statement -- so a fault raised in it would
            // have been reported against whatever line was marked last, which is the line above.
            mark(j, body.span)

            val v = emit_expr(j, body)

            line(j, s"${into} = ${v};")
end emit_body_into

// -- break and continue -----------------------------------------------------------------------------

// `break`, `break 7` and `break outer`.
private emit_break(j: *Js, label: string, value: Option[Expr], at: Span)
    which_loop(j, label) match
        None -> complain(j, at, if label == "" then "`break` is only written inside a loop" else s"no loop here is called `${label}`")
        Some(k) ->
            val frame = j.loops.at(k)

            value match
                Some(e) ->
                    val v = emit_expr(j, e)

                    line(j, s"${frame.value} = ${v};")
                None -> ()

            line(j, s"${frame.broke} = true;")
            line(j, s"break ${frame.js};")
end emit_break

private emit_continue(j: *Js, label: string, at: Span)
    which_loop(j, label) match
        None -> complain(j, at, if label == "" then "`continue` is only written inside a loop" else s"no loop here is called `${label}`")
        Some(k) -> line(j, s"continue ${j.loops.at(k).js};")
end emit_continue

// The loop a `break` or a `continue` names: the innermost where no label was written, and the
// innermost of that name where one was.
private which_loop(j: *Js, label: string) -> Option[usize]
    if j.loops.len() == 0 then return None

    if label == "" then return Some(j.loops.len() - 1)

    var i = j.loops.len()

    while i > 0
        i -= 1

        if j.loops.at(i).label == label then return Some(i)

    None
end which_loop
