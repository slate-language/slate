module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.str_builder

// What an expression IS, and what is complained about: the type of every form a program can write,
// the walk over an expression, a `match` that does not cover its subject, and a binary operator
// whose two sides cannot meet.
//
// **Cut out of `check.sysl` on the heading it already had.** `type_of_expr` came here rather than
// staying with the walk because it answers for a literal and a field as much as for anything a
// statement asks about; `binary_type` and `same_type` are reached back from the walk's `var_type`
// and say so where they are declared.
// -- what an expression is -------------------------------------------------------------------------

// The type of an expression, as far as the pass can tell. **`Any` wherever it cannot.**
//
// **What a CALL answers is `calls.sysl`'s**, since it is a question about a signature: the Call arm
// below asks `method_result`, `has_marker`, `resolved` and `argument_types`, and the Lambda arm asks
// `lambda_type`. Everything else here is answered where it stands.
type_of_expr(x: Expr, env: *TypeEnv) -> Type
    *x.kind match
        IntLit(_) -> type_of(IntegerType)
        RealLit(_) -> type_of(RealType)
        StrLit(_) -> type_of(StringType)
        BoolLit(_) -> type_of(BooleanType)

        // **`null` written out is a null**, which is what makes `f(null)` refusable where the
        // parameter wanted something else -- the machine refuses the same call. `undefined` is left
        // alone: it cannot be stored anywhere, so nothing can be said about where it went.
        NullLit -> type_of(NullType)
        Interp(_) -> type_of(StringType)
        Name(name) -> known_type(env, name)
        // **AN ARRAY LITERAL SAYS WHAT IT WAS BUILT OUT OF**, so `map([1, 2], n -> n * 2)` types its
        // callback and `first([1, 2])` answers an integer. Elements that disagree make a union, and
        // one element nothing is known about gives the whole thing up -- `Any` for the element is
        // what a bare `array` means and is the honest answer there.
        ArrayLit(items) -> type_of(ArrayOf(elements_of(items, env)))
        ArrayRepeat(value, _) -> type_of(ArrayOf(type_of_expr(value, env)))
        DataLit(inner) -> type_of_expr(inner, env)
        ShapeLit(_, _) -> shape_type()
        ObjectLit(keys, _, values) ->
            var out: Buf[Type] = buf()
            var certain: Buf[bool] = buf()

            for i in 0..<values.len()
                out.push(type_of_expr(values.at(i), env))

                // A literal's fields are all there -- optionality is something an annotation says
                // about what it will accept, never something a value says about itself.
                certain.push(false)

            type_of(ObjectWith(keys, out, certain))
        Lambda(params, defaults, body, is_async) ->
            lambda_type(params, defaults, body, is_async, env, buf())

        // A comparison and an `is` are booleans whatever they compared.
        Compare(_, _) -> type_of(BooleanType)
        IsPattern(_, _, _) -> type_of(BooleanType)
        Unary(op, rhs) -> op match
            Bang -> type_of(BooleanType)
            _ -> type_of_expr(rhs, env)
        Binary(op, lhs, rhs) -> binary_type(op, type_of_expr(lhs, env), type_of_expr(rhs, env))
        Call(callee, args) ->
            // **The method spelling is resolved as the free function it is**, so `xs.filter(p)`
            // answers what `filter(xs, p)` answers rather than nothing at all.
            val as_method = *callee.kind match
                Field(target, name, optional) ->
                    if optional then None else method_result(target, name, args, env)
                _ -> None

            as_method match
                Some(t) -> t
                None ->
                    val read = type_of_expr(callee, env)

                    // **A generic function's answer is what this call made of it**, solved from the
                    // arguments beside it: `first(["a"])` answers a string. It is the marker path
                    // one line down wearing another hat, and the guard is the same -- almost
                    // nothing is generic, so almost no call pays for the question.
                    val sig = if has_typevar(read) then solved_generics(read, args, env) else read

                    *sig.kind match
                        FunctionType(_, _, _, result) ->
                            if has_marker(result) then resolved(result, argument_types(args, env, sig)) else result
                        _ -> type_of(Any)

        // **A FIELD READ, WHERE THE SHAPE IS ONE NOTHING COULD HAVE MADE STALE.** A name only
        // carries a shape at all when `flow.sysl` proved the object it holds is reachable from
        // nowhere else and has no field written to it, so what is recorded here is what is there.
        // An optional field is left alone: `{ ok: boolean, value?: any }` says `value` may be
        // absent, and absence is not a type this pass may report against.
        Field(target, field, optional) ->
            if optional then return type_of(Any)

            *type_of_expr(target, env).kind match
                ObjectWith(keys, values, maybe) ->
                    for i in 0..<keys.len()
                        if keys.at(i) == field && !maybe.at(i) then return values.at(i)

                    type_of(Any)
                _ -> type_of(Any)
        Ensures(_, _, pat) -> type_from_pattern(resolve_pattern(pat, 0))
        _ -> type_of(Any)
end type_of_expr

// What every element of a literal is, where they agree, and a union where they do not.
//
// **`Any` the moment anything is not known**, which is a union with `Any` in it saying nothing --
// and an empty literal is `Any` too, there being no element to describe.
private elements_of(items: Buf[Expr], env: *TypeEnv) -> Type
    if items.is_empty() then return type_of(Any)

    var out: Buf[Type] = buf()

    for i in 0..<items.len()
        val one = type_of_expr(items.at(i), env)

        *one.kind match
            Any -> return type_of(Any)

            // A spread element is an array whose own elements are what land here, and this pass does
            // not open one -- so a literal holding one says nothing.
            _ -> ()

        *items.at(i).kind match
            Spread(_) -> return type_of(Any)
            _ -> ()

        var seen = false

        for j in 0..<out.len()
            if same_type(out.at(j), one) then seen = true

        if !seen then out.push(one)

    if out.len() == 1 then out.at(0) else type_of(OneOf(out))
end elements_of

// What an operator answers, given what it was handed.
//
// **Only the cases that are certain.** `+` over two integers is an integer; over anything less known
// it is `Any`, because the operator is overloaded on strings and promotes across the two number
// kinds. Saying `number` where it could be a string would be a claim the checker cannot support.
//
// Not `private`: reached from `check.sysl`.
binary_type(op: Tok, lhs: Type, rhs: Type) -> Type
    op match
        AndAnd -> return type_of(BooleanType)
        OrOr -> return type_of(BooleanType)
        _ -> ()

    if !is_arithmetic(op) then return type_of(Any)

    if is_kind_of(lhs, StringType) && is_kind_of(rhs, StringType) && op == Plus
        return type_of(StringType)

    if is_kind_of(lhs, IntegerType) && is_kind_of(rhs, IntegerType) then return type_of(IntegerType)

    // **A real anywhere in it makes the answer a real**, which is slate's promotion. Saying
    // `number` here instead would be true and too weak: `1.0 * 2` would then not fit a `real`
    // parameter, and the checker would be refusing a program that runs.
    if numeric(lhs) && numeric(rhs)
        if is_kind_of(lhs, RealType) || is_kind_of(rhs, RealType) then return type_of(RealType)

        return type_of(NumberType)

    type_of(Any)
end binary_type

private numeric(t: Type) -> bool =
    is_kind_of(t, IntegerType) || is_kind_of(t, RealType) || is_kind_of(t, NumberType)

private is_arithmetic(op: Tok) -> bool = op match
    Plus -> true
    Minus -> true
    Star -> true
    Slash -> true
    Percent -> true
    _ -> false

// -- what is complained about ----------------------------------------------------------------------

// Whether a `match` over a data type leaves one of its variants unmatched.
//
// **This is the one check in this pass that reports something the machine would refuse for a value
// nobody has yet written down.** It is sound because the subject's own ANNOTATION is the promise: a
// name declared `Shape` admits every variant of `Shape`, and a match that answers none of them for
// one of those is a function that refuses a value its own signature accepts -- which the machine
// meets as *"no arm of this match applies to ..."*. Where the subject's type is anything else, this
// says nothing at all, which is nearly everywhere.
private check_covers(subject: Expr, arms: Buf[Arm], env: *TypeEnv)
    val subject_type = type_of_expr(subject, env)

    val known = *subject_type.kind match
        DataType(name, variants) -> (name, variants)
        _ -> return

    val data = known.0
    val variants = known.1

    // **A variant reached under another name says nothing here.** An import may rename, so a list
    // naming `Circle` where the file binds it as `Round` would report a variant missing that is
    // matched on the very next line. Silence is the safe direction and this is the whole of the
    // guard: unless every name still resolves to the variant it names, nothing is claimed.
    for i in 0..<variants.len()
        if !variant_still_named(variants.at(i), subject.span) then return

    var covered: Buf[string] = buf()

    for i in 0..<arms.len()
        // **A guarded arm covers nothing.** Its guard may answer false for a value its pattern fits,
        // and the arm after it is then the one that has to have that value.
        if arms.at(i).guard.is_none()
            val pat = resolve_pattern(arms.at(i).pattern, 0)

            // A pattern that matches anything is how a program says it has finished listing cases,
            // and it is the way out of this check.
            if catches_all(pat) then return

            gather_variants(pat, &covered)

    var missing: Buf[string] = buf()

    for i in 0..<variants.len()
        if !holds(covered, variants.at(i)) then missing.push(variants.at(i))

    if missing.len() != 0
        complain_here(subject.span, s"this match does not cover every ${data} -- ${listed(missing)} unmatched. Add an arm for it, or `_` for whatever is left")
end check_covers

// Whether a name still resolves to the variant of that name.
private variant_still_named(name: string, at: Span) -> bool =
    *resolve_pattern(pattern(at, Bind(name)), 0).kind match
        VariantPat(n, _, _, _) -> n == name
        _ -> false

// Whether a pattern fits every value there is, which is what ends the listing.
private catches_all(pat: Pattern) -> bool =
    *pat.kind match
        Wild -> true
        Bind(_) -> true
        At(_, inner) -> catches_all(inner)
        _ -> false

// The variants an arm accounts for.
//
// **An alternative may not bind, so `Circle | Rect` is the one shape that covers two** -- and an
// alternative that is not a variant covers nothing, which is right: `Circle | 0` says nothing about
// `Rect`.
private gather_variants(pat: Pattern, into: *Buf[string])
    *pat.kind match
        VariantPat(name, _, _, _) -> if !holds(*into, name) then into.push(name)

        // `Circle { r }` accounts for `Circle` exactly as `Circle(r)` does -- how an arm took the
        // variant apart says nothing about which variant it was for.
        MadeFrom(name, _) -> if !holds(*into, name) then into.push(name)
        OrPat(alts) ->
            for i in 0..<alts.len()
                gather_variants(alts.at(i), into)

        // **An intersection covers only what EVERY part covers, and no variant is every part** --
        // an exhaustiveness listing built from one would name variants the arm cannot actually
        // take. Saying nothing is the safe direction for this pass.
        AndPat(_) -> ()
        At(_, inner) -> gather_variants(inner, into)
        _ -> ()
end gather_variants

// `Circle` / `Circle and Rect` / `Circle, Rect and Empty` -- one name or a list read aloud.
private listed(names: Buf[string]) -> string
    if names.len() == 1 then return s"`${names.at(0)}` is"

    var out = str_builder()

    for i in 0..<names.len()
        if i != 0 then out.push(if i == names.len() - 1 then " and " else ", ")

        out.push_char('`')
        out.push(names.at(i))
        out.push_char('`')

    out.push(" are")
    out.finish()
end listed

// Not `private`: `check_args` and `check_body` in `calls.sysl` walk what they are given.
check_expr(x: Expr, env: *TypeEnv)
    val at = x.span

    *x.kind match
        Call(callee, args) ->
            check_expr(callee, env)
            check_args(callee, args, env)
            check_method(callee, env)
            check_call(callee, args, env, at)
        Binary(op, lhs, rhs) ->
            check_expr(lhs, env)

            // **THE RIGHT OPERAND OF `&&` IS WALKED WHERE THE LEFT ONE HELD**, which is the only
            // place it ever runs -- so `x != null && f(x)` is the same claim as an `if` around an
            // `if`, and refusing one while accepting the other broke this pass's own first rule: it
            // may only refuse what the machine would also refuse.
            //
            // **`||` is the same rule read backwards.** Its right operand runs where the left one
            // did NOT hold, so `x == null || f(x)` narrows by the false side.
            if op == AndAnd || op == OrOr
                enter_scope(env)
                narrow_by(lhs, op == AndAnd, env)
                check_expr(rhs, env)
                leave_scope(env)
            else
                check_expr(rhs, env)

            check_binary(op, lhs, rhs, env, at)
        Unary(_, rhs) -> check_expr(rhs, env)
        Block(stmts) ->
            enter_scope(env)
            check_stmts(stmts, env)
            leave_scope(env)
        ArrayLit(items) -> for i in 0..<items.len() do check_expr(items.at(i), env)
        DataLit(inner) -> check_expr(inner, env)

        // Nothing to check: the pattern was resolved when the declaration was parsed, and a shape
        // is a value with no subexpression in it.
        ShapeLit(_, _) -> ()
        ObjectLit(_, _, values) -> for i in 0..<values.len() do check_expr(values.at(i), env)
        Interp(pieces) -> for i in 0..<pieces.len() do check_expr(pieces.at(i), env)
        Compare(operands, _) -> for i in 0..<operands.len() do check_expr(operands.at(i), env)
        Field(target, _, _) -> check_expr(target, env)
        Index(target, key) ->
            check_expr(target, env)
            check_expr(key, env)
        WithAll(base, other, _) ->
            check_expr(base, env)
            check_expr(other, env)
        WithFields(base, _, values) ->
            check_expr(base, env)

            for i in 0..<values.len()
                check_expr(values.at(i), env)
        Await(inner) -> check_expr(inner, env)
        Ensures(value, declared, pat) ->
            check_expr(value, env)

            // **A body that is one expression is checked against what the definition promised.** A
            // block answers `Any` here and is left alone, which is also what keeps an early `return`
            // out of it: nothing about a block's value is known, so nothing is claimed.
            val answered = type_of_expr(value, env)
            val promised = type_from_pattern(resolve_pattern(pat, 0))

            if !fits(answered, promised)
                complain_here(value.span, s"this was declared to answer ${declared}, and answers ${show_type(answered)}")
        IfExpr(cond, then_branch, else_branch) ->
            check_expr(cond, env)

            enter_scope(env)
            narrow_by(cond, true, env)
            check_expr(then_branch, env)
            leave_scope(env)

            else_branch match
                Some(other) ->
                    enter_scope(env)
                    narrow_by(cond, false, env)
                    check_expr(other, env)
                    leave_scope(env)
                None -> ()
        MatchExpr(subject, arms) ->
            check_expr(subject, env)

            for i in 0..<arms.len()
                // **A pattern's bindings are not typed yet**, so the arm's body is walked in a scope
                // that knows nothing new -- which is `Any` for every name the pattern introduced, and
                // therefore silent about all of them.
                enter_scope(env)
                note_bindings(arms.at(i).pattern, env)
                narrow_by_arm(subject, arms.at(i).pattern, env)

                // **The guard is walked in the ARM's scope, and was not walked at all until now.**
                // It runs where the pattern's names are bound, which is what it is for -- and a name
                // misspelled in one was the single place the undefined-name check could not see.
                arms.at(i).guard match
                    Some(g) -> check_expr(g, env)
                    None -> ()

                check_expr(arms.at(i).body, env)
                leave_scope(env)

            check_covers(subject, arms, env)
        While(_, cond, body, otherwise) ->
            check_expr(cond, env)
            check_expr(body, env)
            check_otherwise(otherwise, env)
        For(_, binding, iter, body, otherwise, _) ->
            check_expr(iter, env)
            enter_scope(env)

            // **A `for` OVER A KNOWN LIST TYPES ITS NAME, and that became possible the day
            // `array of T` did.** `ArrayOf` has carried its element since the checker was written
            // and had nothing but `Any` to put there, so the loop variable said nothing; now
            // `for u in users` where `users: array of User` makes `u` a `User`, which the
            // method-name check reads.
            //
            // **Only a BARE name is typed**, for narrowing's reason: anything else is a pattern
            // taking the element apart, and what its names catch is the pattern's business.
            element_of(type_of_expr(iter, env)) match
                Some(element) -> *binding.kind match
                    Bind(name) -> note_type(env, name, element)
                    _ -> note_bindings(binding, env)
                None -> note_bindings(binding, env)

            check_expr(body, env)
            leave_scope(env)
            check_otherwise(otherwise, env)
        Loop(_, body) -> check_expr(body, env)
        DoWhile(_, body, cond, otherwise) ->
            check_expr(body, env)
            check_expr(cond, env)
            check_otherwise(otherwise, env)
        TryCatch(body, caught, handler) ->
            check_expr(body, env)
            enter_scope(env)

            // **A fault is an ordinary object and its three fields are always there**, so the name a
            // `catch` binds is the one name in the language whose shape is known without anybody
            // writing it down. What that buys today is the method-name check -- `catch e` then
            // `e.push(1)` is refused -- and it will buy more the day a field read is typed.
            note_type(env, caught, fault_shape())
            check_expr(handler, env)
            leave_scope(env)
        Lambda(params, defaults, body, _) -> check_body(params, defaults, body_at(body), env, buf())

        // **A NAME NOTHING HAS BOUND IS REFUSED BEFORE IT RUNS**, which is the most common mistake
        // there is in any language and the one a dynamic language usually finds last -- a typo on a
        // branch nobody took until a customer took it.
        //
        // **It is sound because the machine would refuse the same program**: a name is bound by a
        // `val`, a `var`, a definition, a parameter, a pattern, an import or the builtins, and this
        // pass tracks every one of those. A name used before the `val` that binds it in the same
        // block faults at run time too -- the scope has nothing in it yet -- so refusing it early is
        // the same answer sooner.
        Name(name) ->
            if !defined(env, name)
                complain_here(x.span, s"`${name}` is not defined${nearest(env, name)}")

        // **An `is` BINDS INTO THE SURROUNDING SCOPE**, which is the machine's rule -- `if x is
        // { n }` leaves `n` standing after it. Nothing here checked the subject or noted the
        // bindings before, which was harmless while every unknown name was `Any` and is not once a
        // name nothing bound is a complaint.
        IsPattern(subject, pat, _) ->
            check_expr(subject, env)
            note_bindings(pat, env)
        _ -> ()
end check_expr

// The nearest name the program does know, where one is close enough to be worth naming.
//
// **THE GUESSING IS `sh.sysl.parsing`'s NOW, AND THE SENTENCE IS STILL SLATE'S.** `nearest_name`
// carries the policy -- one edit for a short name, two for a longer one, nothing otherwise -- and
// the edit distance under it; this writes what a slate reader sees. That split is the right one:
// slate said the same thing about a module's exports in `module.sysl`, with the *policy* written
// out a second time, and two copies of a threshold are two copies that drift.
private nearest(env: *TypeEnv, name: string) -> string
    nearest_name(name, env.names) match
        Some(best) -> s" -- did you mean `${best}`?"
        None -> ""
end nearest

// **An arm narrows its subject the way an `is` narrows its operand**, and for the same reason: the
// arm only runs where the pattern took. `note_bindings` has already put the arm's own names in, so
// this is on top of them and a name the pattern bound wins by being nearer.
private narrow_by_arm(subject: Expr, pat: Pattern, env: *TypeEnv)
    *subject.kind match
        Name(name) ->
            if !may_narrow(env, name) then return

            first_binding(pat) match
                Some(_) -> ()
                None -> note_binding(env, name, type_from_pattern(resolve_pattern(pat, 0)), true)
        _ -> ()
end narrow_by_arm

private check_otherwise(otherwise: Option[Expr], env: *TypeEnv)
    otherwise match
        Some(x) -> check_expr(x, env)
        None -> ()

// `x.m(...)` where the kind of `x` is known: a method name that kind does not have.
//
// **This is the most common mistake a checker can catch in a dynamic language** -- a name off by a
// letter, or one borrowed from another type -- and it is sound here because it asks the machine's own
// question. `methods_of` is the table `builtin_method` dispatches through, so what this refuses is
// exactly what the machine would refuse, and a name added to a kind is added in one place.
//
// **An object is not asked about**, its names being the program's; nor is anything whose type is not
// certain, which is the ordinary case in unannotated code.
private check_binary(op: Tok, lhs: Expr, rhs: Expr, env: *TypeEnv, at: Span)
    if !is_arithmetic(op) then return

    val a = type_of_expr(lhs, env)
    val b = type_of_expr(rhs, env)

    if numeric(a) && numeric(b) then return
    if op == Plus && is_kind_of(a, StringType) && is_kind_of(b, StringType) then return

    // **A temporal operand is left to the machine, and this pass may not do otherwise.** What `+`,
    // `-` and `*` mean over the eight temporal kinds is a table of its own in `time.sysl` -- an
    // instant minus an instant is a duration, a zoned reading plus a period is a zoned reading, a
    // duration times an integer is a duration -- and restating it here would be a second copy to
    // keep in step by hand. It refused `monotonic() - a`, which runs, the first time it was tried.
    if is_named_kind(a) || is_named_kind(b) then return

    // Anything not certainly one of the two workable pairings is left to the machine.
    if !certain(a) || !certain(b) then return

    complain_here(at, s"`${op_text(op)}` does not apply to ${show_type(a)} and ${show_type(b)}")
end check_binary

// Whether this is one of the kinds that is nothing but its word. Their operators are their own
// subject, and a generator has none at all.
private is_named_kind(t: Type) -> bool
    *t.kind match
        NamedType(_) -> true
        _ -> false


// The two types describe the same values.
//
// **`fits` in both directions, which is what "the same" means to a pass built on it** -- and both
// sides are asked to be certain first, since `Any` fits everything and would call anything the same
// as anything.
//
// Not `private`: reached from `check.sysl`.
same_type(a: Type, b: Type) -> bool = certain(a) && certain(b) && fits(a, b) && fits(b, a)

// Whether enough is known about a type to argue from it.
// Not `private`: `method_signature` in `calls.sysl` refuses a receiver it is not sure of.
certain(t: Type) -> bool
    *t.kind match
        Any -> false
        OneOf(_) -> false
        _ -> true
end certain
