module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// `all`, `allSettled`, `race` and `any` -- the four that wait on many promises at once, which
// `await` cannot be written to do by itself. `combine.sysl` holds the mechanism; these are the same
// four questions `Promise.all`, `Promise.allSettled`, `Promise.race` and `Promise.any` answer in
// JavaScript, with one shape changed on purpose (see below).

// -- what each of them answers ---------------------------------------------------------------------

@test
ALL_ANSWERS_EVERY_VALUE_IN_THE_ORDER_GIVEN()
    // A plain value is a value that has already arrived, so it sits beside a promise without being
    // dressed up as one -- a cache hit next to a fetch.
    assert_eq(out("async main()\n    print(await all([1, resolve(2), 3]))\nmain()"), "[1, 2, 3]")

@test
ALL_OF_NOTHING_ANSWERS_NOTHING()
    assert_eq(out("async main()\n    print(await all([]))\nmain()"), "[]")

@test
ALL_WAITS_FOR_EVERY_ONE_BEFORE_ANSWERING()
    val prog = "async main()\n" +
        "    val a = pending()\n" +
        "    val b = pending()\n" +
        "\n" +
        "    setTimeout(() -> settle(a, 1), 10)\n" +
        "    setTimeout(() -> settle(b, 2), 20)\n" +
        "\n" +
        "    print(await all([a, b]))\n" +
        "\nmain()\n"

    assert_eq(out(prog), "[1, 2]")

@test
ALL_FAILS_WITH_THE_FIRST_REJECTION_IN_THE_ORDER_GIVEN()
    // Both promises are already settled by the time `all` is called, so it is the POSITION and not
    // the timing that decides which reason is reported.
    assert(fails("async main()\n    await all([reject(\"first\"), reject(\"second\")])\nasync top()\n    await main()\ntop()")
        .contains("first"))

@test
ALLSETTLED_ANSWERS_THE_RESULT_SHAPE_FOR_EVERY_ONE()
    // **`{ok, value}` / `{ok, error}`, not JavaScript's `{status, value|reason}`** -- the shape
    // `parseJSON`, every `Sync` call in `slate:fs` and `run` already answer.
    val prog = "async main()\n" +
        "    val r = await allSettled([resolve(1), reject(\"bad\")])\n" +
        "    print(r[0].ok, r[0].value, r[1].ok, r[1].error)\n" +
        "main()\n"

    assert_eq(out(prog), "true 1 false bad")

@test
ALLSETTLED_OF_NOTHING_ANSWERS_NOTHING()
    assert_eq(out("async main()\n    print(await allSettled([]))\nmain()"), "[]")

@test
RACE_ANSWERS_THE_FIRST_TO_SETTLE_WHICHEVER_ONE_THAT_IS()
    val prog = "async main()\n" +
        "    val a = pending()\n" +
        "    val b = pending()\n" +
        "\n" +
        "    setTimeout(() -> settle(a, \"slow\"), 20)\n" +
        "    setTimeout(() -> settle(b, \"fast\"), 5)\n" +
        "\n" +
        "    print(await race([a, b]))\n" +
        "\nmain()\n"

    assert_eq(out(prog), "fast")

@test
RACE_CAN_BE_WON_BY_A_FAILURE()
    val prog = "async main()\n" +
        "    val a = pending()\n" +
        "    val b = pending()\n" +
        "\n" +
        "    setTimeout(() -> fail(a, \"early\"), 5)\n" +
        "    setTimeout(() -> settle(b, \"late\"), 20)\n" +
        "\n" +
        "    await race([a, b])\n" +
        "async top()\n" +
        "    await main()\n" +
        "top()"

    assert(fails(prog).contains("early"))

@test
ANY_ANSWERS_THE_FIRST_TO_SUCCEED_PAST_A_FAILURE()
    assert_eq(out("async main()\n    print(await any([reject(\"no\"), resolve(\"yes\")]))\nmain()"), "yes")

@test
ANY_OF_ALL_FAILURES_LISTS_EVERY_REASON()
    // **What JavaScript raises an `AggregateError` for**, said as one sentence -- slate's rejections
    // carry text and not a value, so there is nothing for an error object to be.
    assert(fails("async main()\n    await any([reject(\"a\"), reject(\"b\")])\nasync top()\n    await main()\ntop()")
        .contains("every promise `any` was given failed: a; b"))

// -- what each of them refuses -----------------------------------------------------------------------

@test
A_COMBINATOR_GIVEN_THE_WRONG_NUMBER_OF_ARGUMENTS_NAMES_WHAT_IS_TAKEN()
    // **Every one of the four has a fixed arity of one, so the checker refuses an ordinary call with
    // the wrong count before the program runs** -- `anything(...)` hides which function is being
    // called from the pass, which is the door `tests_builtins.sysl` already uses to reach a native's
    // own runtime count check.
    assert(fails(Opaque + "print(anything(all)())").contains("`all` takes one array of promises, and was given 0 arguments"))
    assert(fails(Opaque + "print(anything(all)(1, 2))").contains("`all` takes one array of promises, and was given 2 arguments"))
    assert(fails(Opaque + "print(anything(allSettled)())").contains("`allSettled` takes one array of promises, and was given 0 arguments"))
    assert(fails(Opaque + "print(anything(race)(1, 2))").contains("`race` takes one array of promises, and was given 2 arguments"))
    assert(fails(Opaque + "print(anything(any)())").contains("`any` takes one array of promises, and was given 0 arguments"))

@test
A_NON_ARRAY_IS_REFUSED_RATHER_THAN_TREATED_AS_ONE_PROMISE()
    // **The parameter is declared `list`, so an ordinary literal of the wrong type is refused by the
    // checker first** -- `anything(v)` is untyped, so wrapping the argument reaches the native's own
    // check instead.
    assert(fails(Opaque + "print(all(anything(5)))").contains("`all` takes an array of promises, and this is an integer"))
    assert(fails(Opaque + "print(allSettled(anything(\"x\")))").contains("`allSettled` takes an array of promises, and this is a string"))
    assert(fails(Opaque + "print(race(anything(null)))").contains("`race` takes an array of promises, and this is null"))
    assert(fails(Opaque + "print(any(anything(true)))").contains("`any` takes an array of promises, and this is a boolean"))

@test
THE_FOUR_COMBINATORS_TOGETHER_MATCH_THE_DOCS_EXAMPLE()
    // Pinned to the exact program `docs/library/globals.md` shows, so a change to the rendering of
    // any of the four is caught here before a reader hits it.
    val prog = "async first(ms, label)\n" +
        "    await sleep(ms)\n" +
        "    label\n" +
        "\n" +
        "async main()\n" +
        "    print(await all([1, resolve(2), 3]))\n" +
        "    print(await allSettled([resolve(1), reject(\"bad\")]))\n" +
        "    print(await race([first(20, \"slow\"), first(5, \"fast\")]))\n" +
        "    print(await any([reject(\"no\"), resolve(\"yes\")]))\n" +
        "\n" +
        "main()\n"

    assert_eq(out(prog),
        "[1, 2, 3]\n" +
        "[{ok: true, value: 1}, {ok: false, error: \"bad\"}]\n" +
        "fast\n" +
        "yes")

@test
RACE_AND_ANY_OF_NOTHING_ARE_REFUSED_RATHER_THAN_HANGING()
    // JavaScript answers a promise that never settles, which is a program that hangs and says
    // nothing -- slate refuses at the call instead.
    assert(fails("print(race([]))")
        .contains("`race` was given nothing to race -- there is no first answer among no promises"))
    assert(fails("print(any([]))")
        .contains("`any` was given nothing to wait for -- there is no first answer among no promises"))
