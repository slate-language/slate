module dev.slatelang.slate
@tests

import sh.sysl.libuv
import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.fs.{current_dir, read_bytes, remove_file, set_current_dir, write_text}
import sysl.process.capture
import sysl.text.{Search, from_utf8_unchecked, split, str_builder}
import sysl.time.{monotonic, whole_micros}

// The half of the harness that runs the DRIVER rather than a program.
//
// **Cut out of `tests_kit.sysl` when that file passed a thousand lines**, and the seam is what the
// helper hands the tested code: everything there is a slate program and a string of what it said,
// and everything here is an argument vector, a directory on disk, or `node`. So the manifest, the
// package cache, `slate add`, a script with its own shebang, and the JavaScript back end's output
// run through a real Node all live in this file.
//
// **NOTHING HERE IS `private` EITHER, AND IT MAY NOT BECOME PRIVATE AGAIN** -- the same rule
// `tests_kit.sysl` states, and for the same reason: `private` in sysl is private to the FILE, and
// a harness nobody else can say is not a harness.

// The driver, run with its report collected rather than printed.
//
// **This is what `run_cli` taking somewhere to say things buys.** The status a shell would have seen
// is asserted here, in-process, with nothing reaching the terminal -- where before the driver
// printed straight out and answered nothing, so neither half of it could be pinned by a test at all.
//
// **THE `sink` IS NOT CEREMONY: a sysl closure captures BY VALUE.** Written the obvious way, as
// `line -> lines.push(line)`, the closure carries its own copy of the buffer and every push lands in
// it -- so the calls all succeed, nothing is reported, and `lines` is empty at the end. A pointer is
// captured by value too, and that is the whole difference: what it points at is the one buffer.
cli_status(args: []string) -> int
    var lines: Buf[string] = buf()
    val sink = &lines

    run_cli(args, (line: string) -> sink.push(line))
end cli_status

// The same run, read for what it said.
cli_said(args: []string) -> string
    var lines: Buf[string] = buf()
    val sink = &lines

    run_cli(args, (line: string) -> sink.push(line))

    var out = str_builder()

    for i in 0..<lines.len()
        if i > 0 then out.push("\n")

        out.push(lines.at(i))

    out.finish()
end cli_said

// A project, flattened to one line so that a test says the whole of what was read.
proj(text: string) -> string
    val f = read_project_text("package.sl", text)

    if !f.ok() then return s"REFUSED: ${proj_said(text)}"

    val p = f.project
    var out = str_builder()

    out.push(s"${p.name} ${p.version}")

    if p.main != "" then out.push(s" main=${p.main}")
    if p.description != "" then out.push(s" description=${p.description}")
    if p.homepage != "" then out.push(s" homepage=${p.homepage}")
    if p.license != "" then out.push(s" license=${p.license}")

    for i in 0..<p.dependencies.len()
        val d = p.dependencies.at(i)

        out.push(s" ${d.name}@${d.version}<-${d.git}")

    // **The second section is rendered with a `dev:` in front of it**, so a test can see which of
    // the two a dependency was read into rather than only that it was read.
    for i in 0..<p.dev.len()
        val d = p.dev.at(i)

        out.push(s" dev:${d.name}@${d.version}<-${d.git}")

    out.finish()
end proj

// Everything the reader had to say about a project, warnings included -- so a test asserting a
// warning cannot pass by the file having been refused outright.
proj_said(text: string) -> string
    val src = source_of("package.sl", text)
    val f = read_project(src)

    if f.report.is_empty() then "" else f.report.render(src)
end proj_said

// A program run with the package cache pointed at the fixture tree.
//
// **The cache is a setting for the same reason the heap size is**: the behaviour under test is
// identical whatever directory it reads, and a suite that read the real `~/.slate/pkg` would pass or
// fail on what a previous run had happened to download. `tests/cache/` is a package cache checked in.
with_packages(path: string) -> string
    set_package_cache("tests/cache")

    val said = ran_out(path)

    set_package_cache("")
    said
end with_packages

// The same, for a program expected to be refused.
// `slate deps`, run against the fixture cache rather than whatever is in `~/.slate/pkg`.
deps_said(dir: string) -> string
    set_package_cache("tests/cache")

    val said = cli_said(["slate", "deps", dir])

    set_package_cache("")
    said
end deps_said

deps_status(dir: string) -> int
    set_package_cache("tests/cache")

    val code = cli_status(["slate", "deps", dir])

    set_package_cache("")
    code
end deps_status

packages_fault(path: string) -> string
    set_package_cache("tests/cache")

    val said = ran_fault(path)

    set_package_cache("")
    said
end packages_fault

// A one-file project written into a scratch directory, run against the fixture cache.
scratch_project(manifest: string, program: string) -> string
    val dir = libuv.mkdtemp_sync("/tmp/slate-proj-XXXXXX").unwrap()

    write_text(s"${dir}/package.sl", manifest).unwrap()
    write_text(s"${dir}/app.sl", program).unwrap()
    set_package_cache("tests/cache")

    val said = ran_fault(s"${dir}/app.sl")

    set_package_cache("")
    scrub(dir)
    said
end scratch_project

// The same, for a project expected to run.
//
// **`scratch_project` answers a fault and this answers output**, which is the same split `ran_fault`
// and `ran_out` already are. A resolution test that only ever asserts on complaints is a test that
// never checked the thing working.
scratch_project_out(manifest: string, program: string) -> string
    val dir = libuv.mkdtemp_sync("/tmp/slate-proj-XXXXXX").unwrap()

    write_text(s"${dir}/package.sl", manifest).unwrap()
    write_text(s"${dir}/app.sl", program).unwrap()
    set_package_cache("tests/cache")

    val said = ran_out(s"${dir}/app.sl")

    set_package_cache("")
    scrub(dir)
    said
end scratch_project_out

// A directory holding the named files, for hashing.
tree_of(names: []const string, bodies: []const string) -> string
    val dir = libuv.mkdtemp_sync("/tmp/slate-tree-XXXXXX").unwrap()

    for i in 0..<names.len
        write_text(s"${dir}/${names[i]}", bodies[i]).unwrap()

    dir
end tree_of

hash_of(names: []const string, bodies: []const string) -> string
    val dir = tree_of(names, bodies)
    val h = tree_hash(dir).unwrap()

    scrub(dir)
    h
end hash_of

// **The fixtures are made by `git archive`, which is what GitHub serves.** An archive written by
// this repo's own idea of the format would prove nothing about the one a fetch will actually meet --
// the global pax header carrying the commit id is there because git puts it there, and it is the
// first thing in the file.
tar_bytes(name: string) -> []const u8
    read_bytes(s"tests/tar/${name}") match
        Err(e) -> panic(s"cannot read tests/tar/${name}: ${e} -- this suite reads its fixtures by relative path, so it must be run from the project root")
        Ok(b) -> b
end tar_bytes

// A project in a scratch directory, holding the manifest text given.
project_at(text: string) -> string
    val dir = libuv.mkdtemp_sync("/tmp/slate-add-XXXXXX").unwrap()

    write_text(s"${dir}/package.sl", text).unwrap()
    dir
end project_at

// What a scratch project's manifest holds now.
manifest_now(dir: string) -> string =
    from_utf8_unchecked(read_bytes(s"${dir}/package.sl").unwrap())

// One command run against the fixture cache, answering the status and what it said.
//
// **Run ONCE, where `cli_status` and `cli_said` each run their own.** A command that writes a file
// is not the same command the second time -- the second `slate add` would find what the first one
// wrote and report that instead.
cache_run(args: []string) -> (int, string)
    var lines: Buf[string] = buf()
    val sink = &lines

    set_package_cache("tests/cache")

    val status = run_cli(args, (line: string) -> sink.push(line))

    set_package_cache("")

    var out = str_builder()

    for i in 0..<lines.len()
        if i > 0 then out.push("\n")

        out.push(lines.at(i))

    (status, out.finish())
end cache_run

// A program written to a real file and run the way a shell runs one.
//
// **A real file and the real `run_cli`, because the file is half of what these tests are about.** A
// shebang line only matters to a program that was read off a disk, and the arguments only exist
// because a command line had them -- so a helper built on `run(source_of(...))` would be testing
// neither. This goes in at the same door `main` does and answers what the shell would hear and what
// the terminal would show.
//
// **The arguments are given the way a person types them**: everything in `argv` lands after the
// program's name, which is exactly the shape `run_cli` slices.
script_ran(text: string, argv: []const string) -> (int, string)
    val dir = libuv.mkdtemp_sync("/tmp/slate-script-XXXXXX").unwrap()
    val where = s"${dir}/script.sl"

    write_text(where, text).unwrap()

    var command: Buf[string] = buf()

    command.push("slate")
    command.push(where)

    for i in 0..<argv.len
        command.push(argv[i])

    var lines: Buf[string] = buf()
    val sink = &lines
    val status = run_cli(command.view(), (line: string) -> sink.push(line))

    // **Put back what the driver set, or the next test inherits it.** `program_args` is module
    // storage that `run_program` writes on the way in and nothing writes on the way out, so a test
    // running a program through `out` after this one would see the arguments this one was given.
    set_program_args(buf())
    scrub(dir)

    var said = str_builder()

    for i in 0..<lines.len()
        if i > 0 then said.push("\n")

        said.push(lines.at(i))

    (status, said.finish())
end script_ran

// A project on disk with `slate run` typed INSIDE it: the status, what it said, and the directory.
//
// **From inside the directory, which is the whole of what `slate run` needs.** It finds the project
// by walking up from where a person is standing, so a helper that ran it from the repository root
// would find slate's own `package.sl` and list slate's own scripts. The working directory is put
// back whatever the run came to.
//
// **The directory is answered rather than scrubbed**, because a script that wrote a file is half of
// what some of these tests assert. Every caller ends with `scrub`.
//
// `names` and `bodies` are the files written beside the manifest; `cache` is a package cache, taken
// relative to where the suite is running since that is where the fixtures are.
run_in_project(manifest: string, names: []const string, bodies: []const string,
               cache: string, argv: []const string) -> (int, string, string)
    val dir = libuv.mkdtemp_sync("/tmp/slate-run-XXXXXX").unwrap()

    write_text(s"${dir}/package.sl", manifest).unwrap()

    for i in 0..<names.len
        write_text(s"${dir}/${names[i]}", bodies[i]).unwrap()

    var command: Buf[string] = buf()

    command.push("slate")
    command.push("run")

    for i in 0..<argv.len
        command.push(argv[i])

    val was = current_dir().unwrap()

    set_current_dir(dir).unwrap()

    if cache != "" then set_package_cache(if cache.starts_with("/") then cache else s"${was}/${cache}")

    var lines: Buf[string] = buf()
    val sink = &lines
    val status = run_cli(command.view(), (line: string) -> sink.push(line))

    set_package_cache("")
    set_current_dir(was).unwrap()

    // Put back what `run_program` set, for `script_ran`'s reason.
    set_program_args(buf())

    var said = str_builder()

    for i in 0..<lines.len()
        if i > 0 then said.push("\n")

        said.push(lines.at(i))

    (status, said.finish(), dir)
end run_in_project

// The same, for the common case of a program given nothing.
script_said(text: string) -> string
    val (_, said) = script_ran(text, [])

    said
end script_said

// One `@test` in a snippet, run the way `slate test` runs it, and what it had to say.
//
// **`fails` would answer nothing here**, running the program's statements and never the tests it
// declared -- so a test about what a `@test` does has to go in through `run_tests`.
test_verdict(text: string, name: string) -> string = verdict(run_tests(source_of("t", text)), name)

// A component unique to this call, so two suites racing on the same tree -- `sysl test .` and
// `sysl test . --features webview`, or two worktrees sharing a disk -- never write the same probe
// path at once.
//
// **The monotonic clock alone is not enough**: two calls close together can land in the same
// microsecond, so a counter rides beside it, and `sysl.process` deliberately has no `pid` for a
// caller outside it to fall back on.
//
// process-wide: this is the test HARNESS's own counter, one per `sysl test` process rather than
// per slate VM under test -- it has nothing to do with `vm_state.sysl`'s runtime and every process
// running the suite needs its own sequence regardless of how many VMs it starts.
var probe_seq: long = 0

probe_unique() -> string
    probe_seq = probe_seq + 1

    s"${whole_micros(monotonic())}-${probe_seq}"
end probe_unique

// A probe's own bare file name, named `prefix` and unique to this run.
probe_name(prefix: string) -> string = s"${prefix}-${probe_unique()}.tmp.sl"

// The same, as a path under `tests/`. Every `node_said*` helper below, and every other probe across
// the suite that used to write a fixed name, names its source through this instead -- the `.js`/
// `.mjs` output derived from it (`src + ".js"`) inherits the same uniqueness for free.
probe_path(prefix: string) -> string = "tests/" + probe_name(prefix)

@test
TWO_CALLS_TO_probe_path_NEVER_NAME_THE_SAME_FILE()
    val a = probe_path("x")
    val b = probe_path("x")

    assert(a != b, s"two calls with the same prefix must differ: ${a} vs ${b}")

    // Both still carry the shared prefix and the fixed suffix the callers rely on -- what
    // varies is only the run-unique middle.
    assert(a.starts_with("tests/x-") && a.ends_with(".tmp.sl"), a)
    assert(b.starts_with("tests/x-") && b.ends_with(".tmp.sl"), b)

// What a program says under node -- its output, or the sentence it failed with.
//
// **A subprocess, where every other driver in this harness runs in this process**, because that is the
// whole point: the JavaScript back end is a second reading of the tree and a second runtime, and
// only running it says whether the two agree. `tests_js_run.sysl` diffs whole programs the same way;
// this is for the handful of answers that have no interpreter side to be diffed against -- the two
// calendar names a JavaScript host cannot answer and the asymmetric half of JWS being three the
// interpreter does give and gives differently.
//
// **It lives here rather than in `tests_time.sysl`, where it was written, because `private` in sysl
// is per FILE**: `tests_crypto.sysl` wanted the same thing and a second copy is a second thing to
// keep in step with the first.
node_said(text: string) -> string
    val src = probe_path("js-probe")
    val out_js = src + ".js"

    write_text(src, text).unwrap()

    val wrote = cli_status(["slate", "js", src, "-o", out_js])

    if wrote != 0 then return s"`slate js` exited ${wrote}"

    val ran = capture("node", [out_js], "", [], true, 120000)

    remove_file(src)
    remove_file(out_js)

    ran match
        Err(e) -> s"node could not be started: ${e}"

        // **The complaint is read off stderr where the run failed**, node writing a fault there and
        // exiting non-zero; a test asserting on a refusal would otherwise be asserting on the empty
        // string, which every passing run also produces.
        Ok(o) -> if o.status.ok() then o.text.trim() else o.err.unwrap_or("").trim()
end node_said

// The same run, written to a `.mjs` file so that node reads the program as an ES MODULE.
//
// **A module has no `require`, and the whole suite otherwise runs scripts.** `slate js p.sl -o
// p.mjs` is an ordinary thing to ask for and `node` reads that extension as a module whatever the
// nearest `package.json` says -- so every host door this runtime opens by loading a node module was
// unmeasured in exactly the shape a program ships in. `node_said` above cannot see it: its output
// file is a `.js`.
node_said_module(text: string) -> string
    val src = probe_path("js-probe-esm")
    val out_js = src + ".mjs"

    write_text(src, text).unwrap()

    val wrote = cli_status(["slate", "js", src, "-o", out_js])

    if wrote != 0 then return s"`slate js` exited ${wrote}"

    val ran = capture("node", [out_js], "", [], true, 120000)

    remove_file(src)
    remove_file(out_js)

    ran match
        Err(e) -> s"node could not be started: ${e}"
        Ok(o) -> if o.status.ok() then o.text.trim() else o.err.unwrap_or("").trim()
end node_said_module

// The same run again, with a `location` in front of it, which is the one thing about a page that
// decides how a URL is read.
//
// **This is not a DOM and does not pretend to be one.** What is wanted here is an address for a
// reference to be resolved against, and the resolving is `new URL`'s -- node's own, the same
// implementation a browser would use -- rather than anything this file or the runtime writes. So
// the only shimmed thing is the string.
node_said_at(base: string, text: string) -> string
    val src = probe_path("js-probe-page")
    val out_js = src + ".js"

    write_text(src, text).unwrap()

    val wrote = cli_status(["slate", "js", src, "-o", out_js])

    if wrote != 0 then return s"`slate js` exited ${wrote}"

    val driver = s"globalThis.location = new URL(\"${base}\"); require(\"./${out_js}\")"
    val ran = capture("node", ["-e", driver], "", [], true, 120000)

    remove_file(src)
    remove_file(out_js)

    ran match
        Err(e) -> s"node could not be started: ${e}"
        Ok(o) -> if o.status.ok() then o.text.trim() else o.err.unwrap_or("").trim()
end node_said_at
