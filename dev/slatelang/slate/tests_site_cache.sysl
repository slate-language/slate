module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// What an instruction may remember about where it found a name, asked at the level a slate program
// cannot reach.
//
// **`tests/lang/sitecache.sl` is the other half and is the one that matters to a reader**: it asks
// the LANGUAGE whether a place in a program that has read one object still answers for the next. What
// is here can only be asked in sysl -- the width of an instruction, and the summary of a table's keys
// that makes a MISS cheap -- and both are things a benchmark would notice and could not explain.

// Whether the summary and the search agree about a name, which is the property the whole of the fast
// path rests on: the summary may say "maybe" about a name that is not there, and may never say "no"
// about one that is.
private agree(o: *ObjectObj, name: string) -> bool
    val searched = obj_index_named(o, name)
    val summarised = obj_index_hashed(o, name, name.hash())

    searched match
        Some(a) -> summarised match
            Some(b) -> a == b
            None -> false
        None -> summarised.is_none()
end agree

@test
THE_SUMMARY_OF_A_TABLES_KEYS_NEVER_HIDES_ONE_THAT_IS_THERE()
    reset_vm()
    reset_heap()
    collect_now()

    // Across the line an index is built at, because the two searches under the summary are two
    // different functions and the summary stands in front of both.
    for size in 1usize..<24
        val o = new_object()

        for i in 0..<size
            obj_put_name(o, "field" + str(i), Int(long(i * 3)))

        for i in 0..<size
            assert(agree(o, "field" + str(i)), s"field${str(i)} of ${str(size)}")

        assert(agree(o, "fieldnope"), s"a name never written, of ${str(size)}")
        assert(agree(o, ""), s"the empty name, of ${str(size)}")
end THE_SUMMARY_OF_A_TABLES_KEYS_NEVER_HIDES_ONE_THAT_IS_THERE

@test
A_KEY_THAT_WAS_REMOVED_LEAVES_ITS_BIT_AND_IS_STILL_NOT_FOUND()
    reset_vm()
    reset_heap()
    collect_now()

    val o = new_object()

    obj_put_name(o, "gone", Int(1))
    obj_put_name(o, "here", Int(2))

    val h = "gone".hash()

    assert(!obj_lacks(o, h), "a key that was written is in the summary")

    obj_index_named(o, "gone") match
        Some(at) -> obj_drop_at(o, at)
        None -> assert(false, "the key was written and should be found")

    // **The summary only ever grows, so it still claims the key MAY be there** -- and the search
    // under it is what answers, which is why a bit left behind costs a walk and never an answer.
    assert(!obj_lacks(o, h), "and removing it leaves the bit standing")
    assert(agree(o, "gone"), "a removed key is not found either way")

    obj_get_name(o, "here") match
        Some(Int(v)) -> assert_eq(v, 2, "its neighbour is untouched")
        _ -> assert(false, "its neighbour is gone")
end A_KEY_THAT_WAS_REMOVED_LEAVES_ITS_BIT_AND_IS_STILL_NOT_FOUND

@test
A_REHASH_MOVES_EVERY_POSITION_AND_THE_SUMMARY_SURVIVES_IT()
    reset_vm()
    reset_heap()
    collect_now()

    val o = new_object()

    // A tombstone in front of the keys, so that the growth which drops it shifts everything after.
    obj_put_name(o, "temp", Int(0))

    obj_index_named(o, "temp") match
        Some(at) -> obj_drop_at(o, at)
        None -> assert(false, "the key was written and should be found")

    for i in 0..<40
        obj_put_name(o, "k" + str(i), Int(long(i)))

    for i in 0..<40
        assert(agree(o, "k" + str(i)), s"k${str(i)} after the rehash")

        obj_get_name(o, "k" + str(i)) match
            Some(Int(v)) -> assert_eq(v, long(i), s"k${str(i)} holds what it was given")
            _ -> assert(false, s"k${str(i)} is gone")
end A_REHASH_MOVES_EVERY_POSITION_AND_THE_SUMMARY_SURVIVES_IT

@test
THE_UNIT_HASHES_proto_THE_WAY_EVERY_LOOKUP_ASKS_FOR_IT()
    // **A delegated lookup compares the key standing at its remembered hop against this one number**
    // rather than hashing the word again per call, so a unit whose copy disagreed with the hash every
    // table files `proto` under would send every method call down the walk it exists to save. Nothing
    // would answer differently, which is what makes it worth pinning here.
    assert_eq(new_unit().proto_hash, "proto".hash(), "a unit hashes `proto` once")
end THE_UNIT_HASHES_proto_THE_WAY_EVERY_LOOKUP_ASKS_FOR_IT

@test
AN_INSTRUCTION_IS_NO_WIDER_FOR_CARRYING_A_CACHE_SLOT()
    // **The instruction is fetched and copied once per dispatch**, so its width is the interpreter's
    // hottest constant -- a `mov` of the stride, a multiply, and a load per eight bytes into
    // registers this loop has never had spare, on every instruction a program executes, whatever
    // the arm turns out to want. Thirty-two is a `lsl #5` and half the cache line the old
    // fifty-six took, and it is what holding every `Op` payload to eight bytes buys. `CallMethod`
    // still remembers where it found a method: its cache slot is one of the three operands
    // `Unit.wide` holds for it.
    assert_eq(sizeof(Ins), 32usize, "an instruction is 32 bytes")
end AN_INSTRUCTION_IS_NO_WIDER_FOR_CARRYING_A_CACHE_SLOT

@test
A_METHOD_CALL_READS_ITS_WIDE_OPERANDS_THE_SAME_WAY_EVERY_TIME()
    // **`CallMethod` keeps its argument count and reads the other three from `Unit.wide`** -- the
    // method's name, the argument names the call wrote, and the cache cell this site remembers in.
    // All three are read on every call, so a wrong index would be wrong on the first turn and on the
    // hundred-thousandth alike; the loop is here because the cache makes the first call and the rest
    // take different paths through the same three operands.
    //
    // **The call written BY NAME is what exercises the operand that is zero everywhere else.** An
    // ordinary call carries no names, so a table read that quietly answered zero would pass every
    // other test in this file.
    val said = out("class Stride\n    var n\n\n    step(self, by = 1) = self.n * by\nend Stride\n\nval s = Stride(2)\nvar total = 0\n\nfor i in 0..<100000\n    total = total + s.step(by = 3)\n\nprint(total, s.step())")

    assert_eq(said, "600000 2")
end A_METHOD_CALL_READS_ITS_WIDE_OPERANDS_THE_SAME_WAY_EVERY_TIME
