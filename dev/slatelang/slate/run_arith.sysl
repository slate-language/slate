module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.math.checked_mul

// One function per operator, each of them two whole numbers in front of the general arithmetic.
//
// **WHICH OPERATOR IT IS, IS A COMPILE-TIME FACT, AND UNTIL NOW IT WAS ASKED THREE TIMES AT RUN
// TIME.** `a + b` used to emit a `BinaryOp(Plus)` carrying the token, so the machine matched the
// instruction, `on_values` matched the token for `==` and `!=`, `arith` tested it for the string
// join, and `int_arith` matched it again over seventeen arms -- three switches and three calls to
// reach an addition the emitter had already picked out. The emitter names the instruction now
// (`op_instruction` in `code.sysl`), so the machine arrives at the operator directly and what is
// left here is the arithmetic itself.
//
// **EVERY FUNCTION HERE IS THE INT-INT PATH AND A HAND-OFF, and the hand-off is what keeps the
// semantics honest.** A pair of machine integers is answered in place; everything else -- a real, a
// big integer, two strings, two sets, a date, an operator method, and every diagnostic -- goes to
// `arith` exactly as it always did, and a pair of integers whose answer does not fit goes to
// `int_arith` with the same token, so the overflow promotions and the `LeastLong` edge cases are the
// ones that were already written rather than a second copy of them. Nothing here may grow a rule of
// its own: if an answer is not `Int` or `Bool`, it belongs to the file it is handed to.
//
// **They are separate functions rather than twenty blocks written into the loop for one reason: the
// thousand-line rule.** `run_frames.sysl` is one function whose body is one arm-list, and twenty
// arms with their fast paths written out take it well past a thousand lines. Each of these is a leaf
// with exactly one caller, which is the shape a compiler inlines; `bench/README.md` carries the
// measurement that says the arrangement is worth what it claims.
//
// Nothing here is `private`: every name is reached from `run_frames.sysl`, which is the only caller
// of any of them.

// -- the arithmetic -------------------------------------------------------------------------------

// `a + b`.
//
// **The overflow test is written out rather than asked of `checked_add`**, which is `int_arith`'s
// own reasoning and its own line of code: a sum overflows exactly when the operands agree in sign
// and the answer does not, which is three instructions and a branch that is never taken. Plain `+`
// wraps, which is what makes the wrapped answer available to test.
added(a: Value, b: Value, at: Span) -> Step = a match
    Int(x) -> b match
        Int(y) ->
            val sum = x + y

            if (x ^ sum) & (y ^ sum) < 0 then int_arith(Plus, x, y, at) else Ok(Int(sum))
        _ -> arith(Plus, a, b, at)
    _ -> arith(Plus, a, b, at)

// `a - b`, whose overflow test is the same fact about a sign bit read for a difference.
subtracted(a: Value, b: Value, at: Span) -> Step = a match
    Int(x) -> b match
        Int(y) ->
            val diff = x - y

            if (x ^ y) & (x ^ diff) < 0 then int_arith(Minus, x, y, at) else Ok(Int(diff))
        _ -> arith(Minus, a, b, at)
    _ -> arith(Minus, a, b, at)

// `a * b`. **Multiplication stays `checked_mul`'s**, its test being three routes and a division
// rather than two exclusive-ors -- and a program multiplies far less than it adds.
multiplied(a: Value, b: Value, at: Span) -> Step = a match
    Int(x) -> b match
        Int(y) -> checked_mul(x, y) match
            Some(n) -> Ok(Int(n))
            None -> int_arith(Star, x, y, at)
        _ -> arith(Star, a, b, at)
    _ -> arith(Star, a, b, at)

// `a / b`, which answers a real even between two integers -- so nothing on this path divides whole
// numbers and `1 / 0` is an infinity rather than a fault.
divided(a: Value, b: Value, at: Span) -> Step = a match
    Int(x) -> b match
        Int(y) -> Ok(Real(real(x) / real(y)))
        _ -> arith(Slash, a, b, at)
    _ -> arith(Slash, a, b, at)

// `a \ b`, the whole division, which truncates toward zero.
//
// **The two pairs that cannot be divided here are handed over rather than answered**: a zero divisor
// is a fault with a sentence, and the most negative `long` over `-1` is one past the largest positive
// and grows. Both are `int_arith`'s words and `int_arith`'s answer, so neither can drift.
quotient_of(a: Value, b: Value, at: Span) -> Step = a match
    Int(x) -> b match
        Int(y) -> if y == 0 || (x == LeastLong && y == -1) then int_arith(Backslash, x, y, at) else Ok(Int(x / y))
        _ -> arith(Backslash, a, b, at)
    _ -> arith(Backslash, a, b, at)

// `a % b`, whose remainder takes the dividend's sign -- the other half of what makes
// `a == (a \ b) * b + a % b` hold. The same two pairs are handed over, for the same reasons.
remainder_of(a: Value, b: Value, at: Span) -> Step = a match
    Int(x) -> b match
        Int(y) -> if y == 0 || (x == LeastLong && y == -1) then int_arith(Percent, x, y, at) else Ok(Int(x % y))
        _ -> arith(Percent, a, b, at)
    _ -> arith(Percent, a, b, at)

// -- the comparisons ------------------------------------------------------------------------------

// `a < b`. The three below it are the same function with the comparison changed; they are written out
// one at a time because the whole point of the instruction is that nothing asks which one it is.
is_less(a: Value, b: Value, at: Span) -> Step = a match
    Int(x) -> b match
        Int(y) -> Ok(Bool(x < y))
        _ -> arith(Lt, a, b, at)
    _ -> arith(Lt, a, b, at)

// `a <= b`.
is_less_eq(a: Value, b: Value, at: Span) -> Step = a match
    Int(x) -> b match
        Int(y) -> Ok(Bool(x <= y))
        _ -> arith(LtEq, a, b, at)
    _ -> arith(LtEq, a, b, at)

// `a > b`.
is_greater(a: Value, b: Value, at: Span) -> Step = a match
    Int(x) -> b match
        Int(y) -> Ok(Bool(x > y))
        _ -> arith(Gt, a, b, at)
    _ -> arith(Gt, a, b, at)

// `a >= b`.
is_greater_eq(a: Value, b: Value, at: Span) -> Step = a match
    Int(x) -> b match
        Int(y) -> Ok(Bool(x >= y))
        _ -> arith(GtEq, a, b, at)
    _ -> arith(GtEq, a, b, at)

// `a == b`.
//
// **The two fast pairs are the two `same` answers with a comparison in them**, and they are exactly
// what `same_plain` already does for those kinds -- two integers and two booleans compare by value
// and nothing else is consulted. Every other pair goes to `same`, which is where the absence rule,
// the structural walk, the cycle record and a class's own `==` live.
is_equal(a: Value, b: Value, at: Span) -> Step = a match
    Int(x) -> b match
        Int(y) -> Ok(Bool(x == y))
        _ -> Ok(Bool(same(a, b, at)?))
    Bool(x) -> b match
        Bool(y) -> Ok(Bool(x == y))
        _ -> Ok(Bool(same(a, b, at)?))
    _ -> Ok(Bool(same(a, b, at)?))

// `a != b`, which is always the negation of `==` -- a class may not write one, so there is nothing
// else to ask.
is_unequal(a: Value, b: Value, at: Span) -> Step = a match
    Int(x) -> b match
        Int(y) -> Ok(Bool(x != y))
        _ -> Ok(Bool(!same(a, b, at)?))
    Bool(x) -> b match
        Bool(y) -> Ok(Bool(x != y))
        _ -> Ok(Bool(!same(a, b, at)?))
    _ -> Ok(Bool(!same(a, b, at)?))

// -- the bitwise operators ------------------------------------------------------------------------

// `a & b`. The bitwise operators are integers only, which needs no rule here: a real reaching one
// falls through to `arith` and the sentence naming both sides.
bit_anded(a: Value, b: Value, at: Span) -> Step = a match
    Int(x) -> b match
        Int(y) -> Ok(Int(x & y))
        _ -> arith(Amp, a, b, at)
    _ -> arith(Amp, a, b, at)

// `a | b`.
bit_ored(a: Value, b: Value, at: Span) -> Step = a match
    Int(x) -> b match
        Int(y) -> Ok(Int(x | y))
        _ -> arith(Pipe, a, b, at)
    _ -> arith(Pipe, a, b, at)

// `a ^ b`.
bit_xored(a: Value, b: Value, at: Span) -> Step = a match
    Int(x) -> b match
        Int(y) -> Ok(Int(x ^ y))
        _ -> arith(Caret, a, b, at)
    _ -> arith(Caret, a, b, at)

// `a << b`, which GROWS: `1 << 100` is `2 ^ 100` exactly. The fast path is the standard overflow
// test -- shift it back and see whether the number is still there -- and a shift that moves past
// sixty-two places, or by a negative count, is `int_arith`'s to answer and to complain about.
shifted_left(a: Value, b: Value, at: Span) -> Step = a match
    Int(x) -> b match
        Int(y) -> if y >= 0 && y < 63 && ((x << y) >> y) == x then Ok(Int(x << y)) else int_arith(Shl, x, y, at)
        _ -> arith(Shl, a, b, at)
    _ -> arith(Shl, a, b, at)

// `a >> b`, which floors toward negative infinity and has no upper bound -- a shift past the width
// drags the sign down. Sixty-three places and fewer are the hardware's; everything else, a negative
// count included, is `int_arith`'s.
shifted_right(a: Value, b: Value, at: Span) -> Step = a match
    Int(x) -> b match
        Int(y) -> if y >= 0 && y <= 63 then Ok(Int(x >> y)) else int_arith(Shr, x, y, at)
        _ -> arith(Shr, a, b, at)
    _ -> arith(Shr, a, b, at)

// -- the prefix operators -------------------------------------------------------------------------

// `-v`. **The most negative `long` has no positive twin**, so that one value grows and is handed to
// `unary`, which owns the promotion and the `unary_-` method beside it.
negated(v: Value, at: Span) -> Step = v match
    Int(x) -> if x == LeastLong then unary(Minus, v, at) else Ok(Int(-x))
    _ -> unary(Minus, v, at)

// `!v`, which is truthiness and is the whole of the operator -- every value has an answer, so there
// is nothing to hand over and no span to complain against.
notted(v: Value) -> Step = Ok(Bool(!v.truthy()))

// `~v`, which cannot grow: inverting an endless run of bits is `-v - 1`, never past the width it
// started at.
complemented(v: Value, at: Span) -> Step = v match
    Int(x) -> Ok(Int(~x))
    _ -> unary(Tilde, v, at)
