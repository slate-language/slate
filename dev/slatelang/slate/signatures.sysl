module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// What the names a program did NOT write are known to take and answer.
//
// **Cut from `check.sysl` because the walk and the signatures are two subjects**, and the file had
// reached a thousand lines. Everything here answers one question -- *what is the type of a name
// nothing in this program declared* -- for the builtins seeded into the outermost scope, for the
// exports of one of slate's own modules, and for a name imported from a file this pass has not read.
// Nothing here walks anything.
//
// **The seam crosses two names and no more**: `install_builtin_types`, which `check_program` calls
// once, and `import_signature`, which the walk asks wherever it notes an import. Everything else --
// the arity helpers, the three type constructors, and the per-module tables -- is used only by its
// neighbours here and stays `private`.
//
// **The rule the whole file is written to is `check.sysl`'s**: a signature may only say what the
// machine would also enforce. A parameter type that is too narrow refuses a program that runs, which
// is the one mistake this pass may not make, so anything uncertain says `Any` and fits everything.

// What the builtins take and answer, as far as it can be said without qualification.
//
// **Seeded into the OUTERMOST scope, so that anything a program binds shadows it.** A `val len = ...`,
// a definition, a parameter, an imported name and a pattern binding all go into an inner scope and
// are found first -- which is what keeps this from being a claim about a name the program took for
// itself.
//
// **A builtin whose count RANGES is here too, because a signature can now say a range.** `required`
// is how many of the parameters a call has to give, so `toJSON(value, indent)` is two parameters of
// which one is needed, and `check_call` compares against both ends -- the same reading it already
// did for a slate function with a default. Before defaults existed a signature could say only one
// number, which would have refused the other count, so these said nothing at all.
//
// **What is still left out is the genuinely VARIADIC**: `print`, `min`, `max` and `concat` take any
// number of arguments, and there is no upper end for `params` to be. A range needs both ends.
//
// **And only the builtins that are always there.** `regex` and `run` are declared inside
// `install_natives`' `if everything`, and nothing seeded here is conditional.
//
// **A parameter type is generous and a result type is only given where it is certain.** A wrong
// parameter type refuses a program that runs; a wrong result type does the same one call later, and
// is harder to see. `floor`, `abs` and `pow` answer an integer for integers and a real wherever a
// real came in, so they say `number`; `sqrt` and `number` are left alone entirely.
// Not `private`: `check_program` in `check.sysl` seeds every scope with these.
install_builtin_types(e: *TypeEnv)
    val any = type_of(Any)
    val text = type_of(StringType)
    val whole = type_of(IntegerType)
    val truth = type_of(BooleanType)
    val amount = type_of(NumberType)
    val list = type_of(ArrayOf(type_of(Any)))
    val record = type_of(ObjectWith(buf(), buf(), buf()))
    val callable = type_of(FunctionType(buf(), 0, false, type_of(Any)))

    // **`find` answers an element OR nothing**, which is `indexOf`'s shape one level up: a search
    // that found nothing has to say so, and saying it with the element type would be a claim the
    // machine does not make.
    var found: Buf[Type] = buf()

    found.push(type_of(ElementOf(0)))
    found.push(type_of(NullType))

    val element_or_null = type_of(OneOf(found))
    val nothing = type_of(NullType)

    // **A position that may answer `null` says so**, which is a real check rather than a nicety:
    // `indexOf` answers a position or nothing, so handing its answer straight to a parameter that
    // wants a number is a fault the machine would raise, and a union is what lets this see it.
    var maybe_at: Buf[Type] = buf()

    maybe_at.push(whole)
    maybe_at.push(nothing)

    val position = type_of(OneOf(maybe_at))

    one(e, "len", any, whole)
    one(e, "chars", text, list)
    one(e, "trim", text, text)
    one(e, "trimStart", text, text)
    one(e, "trimEnd", text, text)
    one(e, "upper", text, text)
    one(e, "lower", text, text)
    one(e, "string", any, text)
    one(e, "boolean", any, truth)
    one(e, "keys", record, list)
    one(e, "values", record, list)
    one(e, "entries", record, list)
    one(e, "parseJSON", text, record)
    one(e, "reversed", list, type_of(SameAsArg(0)))
    one(e, "flat", list, list)
    one(e, "sum", list, amount)
    one(e, "pop", list, type_of(ElementOf(0)))
    one(e, "shift", list, type_of(ElementOf(0)))
    one(e, "clear", list, nothing)
    one(e, "reverse", list, nothing)
    one(e, "abs", amount, amount)
    one(e, "floor", amount, amount)
    one(e, "ceil", amount, amount)
    one(e, "round", amount, amount)
    one(e, "trunc", amount, amount)

    two(e, "split", text, text, list)
    two(e, "join", list, text, text)
    two(e, "startsWith", text, text, truth)
    two(e, "endsWith", text, text, truth)
    two(e, "repeat", text, whole, text)
    two(e, "pow", amount, amount, amount)
    two(e, "has", record, any, truth)
    two(e, "contains", any, any, truth)
    two(e, "indexOf", any, any, position)
    two(e, "lastIndexOf", any, any, position)
    two(e, "map", list, callable, type_of(ArrayOf(type_of(ResultOf(1)))))
    two(e, "filter", list, callable, type_of(SameAsArg(0)))
    two(e, "find", list, callable, element_or_null)
    two(e, "findIndex", list, callable, position)
    two(e, "every", list, callable, truth)
    two(e, "some", list, callable, truth)
    two(e, "push", list, any, nothing)
    two(e, "removeAt", list, whole, type_of(ElementOf(0)))
    two(e, "unshift", list, any, nothing)
    two(e, "forEach", list, callable, nothing)
    two(e, "findLast", list, callable, element_or_null)
    two(e, "findLastIndex", list, callable, position)

    // **`flatMap`'s elements are the elements of what its function answers**, which is a marker
    // inside a marker and is one thing `resolved_result` cannot spell: it names an ARGUMENT by
    // position, so there is nothing for `ElementOf` to be applied to but an argument. Left as bare
    // `array` rather than guessed at.
    two(e, "flatMap", list, callable, list)

    three(e, "replace", text, text, text, text)
    three(e, "reduce", list, callable, any, type_of(ResultOf(1)))
    three(e, "insert", list, whole, any, nothing)

    // **A delay is a number of milliseconds or a duration**, which is what `do_timer` reads and so
    // is what the signature has to allow; naming only the number would refuse a timer written with
    // one of the temporal words, which runs.
    var maybe_delay: Buf[Type] = buf()

    maybe_delay.push(amount)
    maybe_delay.push(type_of(NamedType("duration")))

    val delay = type_of(OneOf(maybe_delay))

    one_or_two(e, "assert", any, any, nothing)
    one_or_two(e, "toJSON", any, whole, text)
    one_or_two(e, "sort", list, callable, nothing)
    one_or_two(e, "sorted", list, callable, type_of(SameAsArg(0)))
    one_or_two(e, "next", any, any, record)
    one_or_two(e, "fetch", text, record, any)
    one_or_two(e, "setTimeout", callable, delay, whole)
    one_or_two(e, "setInterval", callable, delay, whole)

    two_or_three(e, "assertEq", any, any, any, nothing)

    // **`slice` takes a position that may be NEGATIVE**, counting back from the end, so `integer`
    // rather than anything narrower.
    two_or_three(e, "slice", list, whole, whole, type_of(SameAsArg(0)))

    // **`at` is deliberately left with no signature.** One native serves an array and the four
    // temporal kinds -- `xs.at(-1)` and `t.at(zone)` -- and their arities differ, so any single
    // signature would refuse one of the two. A name this pass says nothing about costs a diagnostic;
    // a name it says the wrong thing about costs a program that runs.
end install_builtin_types

// A builtin of no arguments.
//
// **It is only expressible because the RESULT is known**, `FunctionType(no params, any result)`
// being the bare word `function` and saying nothing. So `now()` can be counted -- `now(5)` is
// refused -- and a builtin of no arguments whose answer nobody can name could not be.
private none(e: *TypeEnv, name: string, result: Type) = note_type(e, name, none_t(result))

private one(e: *TypeEnv, name: string, a: Type, result: Type) = note_type(e, name, one_t(a, result))

private two(e: *TypeEnv, name: string, a: Type, b: Type, result: Type) = note_type(e, name, two_t(a, b, result))

// What an imported name is known to be: a signature where it came out of one of slate's own
// modules, and `Any` where it came out of a file this pass has not read.
// Not `private`: `check.sysl` notes an import in two places and asks this at both.
//
// **`import_signature` and not `imported_type`, which is what it was called while it lived beside
// its callers.** Module-wide it would sit next to `compile.sysl`'s `imported_types` and
// `is_imported_type`, which are the compiler's list of type names an import brought in -- a
// different thing entirely, one letter apart.
import_signature(path: string, origin: Origin, name: string) -> Type
    if origin == Origin.FromSlate then return slate_type(path, name)

    type_of(Any)
end import_signature

// The type of a name one of slate's own modules exports.
//
// **A signature travels with the IMPORT now, where a global's is seeded into the outermost scope.**
// Seeding these globally is what the pass used to do, and it would now be a hole exactly where the
// migration needs a wall: a name in the outermost `TypeEnv` counts as defined, so an unimported
// `date(...)` would have gone unreported by the very check that should catch forgetting the import.
//
// **`Any` for anything not named**, which is what the pass says about a builtin whose signature is
// not worth stating -- and is the safe answer, `Any` fitting everything.
slate_type(from: string, name: string) -> Type
    if from == "time" then return time_type(name)
    if from == "process" then return process_type(name)

    type_of(Any)
end slate_type

// **`env` answers a string or nothing, and that union is a real check**: handing it straight to
// something that wants a string is a fault the machine would raise, and `?? ""` is what a program
// writes instead.
//
// `run` is not here, its answer being a result object whose shape depends on whether the child ran
// at all -- a signature naming one of the two would refuse the other.
private process_type(name: string) -> Type
    if name == "env"
        val text = type_of(StringType)

        var maybe_text: Buf[Type] = buf()

        maybe_text.push(text)
        maybe_text.push(type_of(NullType))

        return one_t(text, type_of(OneOf(maybe_text)))

    // **`args` is the one import here that is not a function.** What the element type buys is the
    // ordinary reading -- `args[0]` is a string and goes wherever a string goes -- rather than a
    // check on `args()`, which everybody who has written C, node or Python types first: this pass
    // does not ask whether a called thing is callable, so that one is the machine's to refuse, and
    // it does, naming the array.
    if name == "args" then return type_of(ArrayOf(type_of(StringType)))

    // **`exit` takes a status or nothing**, which is a `required` of zero against one parameter --
    // the same shape a slate function with a default has, and the reason `required` is a count rather
    // than the length. Its result is `null` and never read: the call does not come back.
    if name == "exit"
        var status: Buf[Type] = buf()

        status.push(type_of(IntegerType))

        return type_of(FunctionType(status, 0, false, type_of(NullType)))

    // **`onSignal` answers the id `offSignal` takes**, which is the whole reason both are stated:
    // the pair is easy to write backwards, and a name handed to `offSignal` -- or an id handed to
    // `onSignal` -- is then a fault at the moment the signal arrives rather than where it was
    // written. The function is `Any` because a slate function's own type is not what this pass
    // works in.
    if name == "onSignal"
        var registration: Buf[Type] = buf()

        registration.push(type_of(StringType))
        registration.push(type_of(Any))

        return type_of(FunctionType(registration, 2, false, type_of(IntegerType)))

    if name == "offSignal"
        var id: Buf[Type] = buf()

        id.push(type_of(IntegerType))

        return type_of(FunctionType(id, 1, false, type_of(NullType)))

    type_of(Any)
end process_type

// **The temporal builtins, and only the ones whose answer does not depend on what they were given.**
// `seconds(n)` makes a duration and `seconds(d)` reads one back, so its result is an integer or a
// duration depending on the argument -- a signature naming one would refuse the other. The same goes
// for `date`, `time`, `dateTime`, `zone` and the epoch words. **Varying ARITY is no longer a reason
// to say nothing**, a signature carrying a range; what keeps these out is the result varying with
// what was given, which is a different thing that happens to travel with it here.
// What is left is the part a program gets wrong most often anyway: the readings.
private time_type(name: string) -> Type
    val any = type_of(Any)
    val text = type_of(StringType)
    val whole = type_of(IntegerType)
    val date_t = type_of(NamedType("date"))

    if name == "now" then return none_t(type_of(NamedType("instant")))
    if name == "monotonic" then return none_t(type_of(NamedType("duration")))
    if name == "localZone" then return none_t(type_of(NamedType("zone")))
    if name == "instant" then return one_t(any, type_of(NamedType("instant")))
    if is_reading(name) then return one_t(any, whole)
    if name == "weekday" || name == "monthName" then return one_t(any, text)
    if name == "isLeapYear" then return one_t(any, type_of(BooleanType))
    if is_parse(name) then return one_t(text, type_of(ObjectWith(buf(), buf(), buf())))
    if name == "format" then return two_t(any, text, text)
    if name == "startOf" then return two_t(any, text, any)
    if name == "onOrAfter" then return two_t(date_t, text, date_t)

    any
end time_type

// The readings that answer a whole number, which is most of them.
private is_reading(name: string) -> bool =
    name == "year" || name == "month" || name == "day" || name == "hour" || name == "minute" || name == "second" || name == "dayOfYear" || name == "daysInMonth"

private is_parse(name: string) -> bool =
    name == "parseDate" || name == "parseTime" || name == "parseDateTime" || name == "parseTimestamp"

// The same three signatures as VALUES rather than as declarations.
//
// **A name a module exports is typed where it is imported, not where the scope is built**, so the
// signature has to be something a caller can hold. `install_builtin_types` seeds the global ones and
// `slate_type` answers for the rest, out of the same three constructors.
private none_t(result: Type) -> Type = type_of(FunctionType(buf(), 0, false, result))

private one_t(a: Type, result: Type) -> Type
    var params: Buf[Type] = buf()

    params.push(a)
    type_of(FunctionType(params, params.len(), false, result))
end one_t

private two_t(a: Type, b: Type, result: Type) -> Type
    var params: Buf[Type] = buf()

    params.push(a)
    params.push(b)
    type_of(FunctionType(params, params.len(), false, result))
end two_t

// A builtin whose last argument may be left out. **This is what default parameters bought the
// natives**: `required` below the number of parameters says the range, and nothing else had to
// change, `check_call` having already compared against both ends for slate's own functions.
private one_or_two(e: *TypeEnv, name: string, a: Type, b: Type, result: Type)
    var params: Buf[Type] = buf()

    params.push(a)
    params.push(b)
    note_type(e, name, type_of(FunctionType(params, 1, false, result)))
end one_or_two

private two_or_three(e: *TypeEnv, name: string, a: Type, b: Type, c: Type, result: Type)
    var params: Buf[Type] = buf()

    params.push(a)
    params.push(b)
    params.push(c)
    note_type(e, name, type_of(FunctionType(params, 2, false, result)))
end two_or_three

private three(e: *TypeEnv, name: string, a: Type, b: Type, c: Type, result: Type)
    var params: Buf[Type] = buf()

    params.push(a)
    params.push(b)
    params.push(c)
    note_type(e, name, type_of(FunctionType(params, params.len(), false, result)))
