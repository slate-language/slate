module dev.slatelang.slate
@tests

// What closing a server does to the connections it accepted, and what a handler is told about the
// request it was given.
//
// Cut out of `tests_serve.sysl`, which holds the byte bodies, the query, forms, cookies, the router
// and the file server. Nothing here shares a helper with it.

// -- what closing a server does to the connections it accepted -----------------------------------

// **Closing a server used to close its listening socket and nothing else**, so a connection already
// accepted was held until its own idle clock ran out -- and over HTTP/2, which had no clock at all,
// for the life of the program. A socket is a handle the event loop waits on, so a program that had
// closed everything it owned could still not exit.

@test
CLOSING_A_SERVER_CLOSES_A_CONNECTION_IT_HAS_NOTHING_TO_DO_ON()
    // **An idle connection goes at once.** The client here has been answered and is keeping the
    // connection, which is what a keep-alive client does; nothing is in flight, so there is nothing
    // to wait for and the connection ends with the server.

    val prog = raw"""
    val server = serve(0, (req) -> "hi")

    async main()
        val c = (await connect("127.0.0.1", localPort(server))).value

        var answers = 0

        heard(chunk)
            if chunk == null
                print("the server closed it")

                shutSocket(c)
                done()

                return

            answers = answers + 1

            if answers == 1
                print("answered")

                close(server)

        onData(c, heard)

        await send(c, "GET / HTTP/1.1\r\nHost: h\r\n\r\n")

    main()
    """

    assert_eq(wire_out(prog), "answered\nthe server closed it")

@test
A_REQUEST_IN_FLIGHT_WHEN_THE_SERVER_CLOSES_IS_STILL_ANSWERED()
    // **The other half of the rule, and the reason closing is not simply abrupt.** A client that
    // asked a moment before the shutdown is answered rather than cut off; the connection ends after
    // the response it was writing, not in the middle of it.

    val prog = raw"""
    var theServer = null

    val server = serve(0, async (req) ->
        close(theServer)

        await sleep(30)

        "answered anyway")

    theServer = server

    async main()
        val c = (await connect("127.0.0.1", localPort(server))).value

        var got = ""

        heard(chunk)
            if chunk == null
                print(got.contains("answered anyway"), "then closed")

                shutSocket(c)
                done()

                return

            got = got + chunk

        onData(c, heard)

        await send(c, "GET / HTTP/1.1\r\nHost: h\r\n\r\n")

    main()
    """

    assert_eq(wire_out(prog), "true then closed")

@test
A_CONNECTION_ACCEPTED_JUST_BEFORE_THE_SERVER_CLOSES_IS_STILL_ANSWERED()
    // **A connection that has not spoken yet is not idle.** This is a cluster worker being rolled: the
    // supervisor hands it a connection and then asks it to leave, so the adopted server is closed in
    // the same turn the connection arrived, with the client's request already sent and not yet read.
    // It used to be cut with nothing written, which a client sees as a refusal.

    val prog = raw"""
    import { adopt } from slate:http
    import { listen } from slate:net

    val app = adopt((req) -> "answered anyway")

    var outer = null

    took(conn)
        app.handle(conn)
        app.close()
        shutSocket(outer)

    outer = listen(0, took)

    async main()
        val c = (await connect("127.0.0.1", localPort(outer))).value

        var got = ""

        heard(chunk)
            if chunk == null
                print(got.contains("answered anyway"), "then closed")

                shutSocket(c)
                done()

                return

            got = got + chunk

        onData(c, heard)

        await send(c, "GET / HTTP/1.1\r\nHost: h\r\n\r\n")

    main()
    """

    assert_eq(wire_out(prog), "true then closed")

@test
A_CONNECTION_THAT_NEVER_SPEAKS_IS_STILL_ENDED_BY_CLOSING_THE_SERVER()
    // **The wait for a first byte is a quarter of a second and not an idle clock.** A client that
    // connects and says nothing is given `DrainMillis` and then let go, so a server with one of these
    // on it still stops -- well inside the watchdog, which would name something undefined were it
    // held for `IdleMillis`.

    val prog = raw"""
    var theServer = null

    val server = serve(0, (req) -> "hi")

    theServer = server

    async main()
        val c = (await connect("127.0.0.1", localPort(server))).value

        heard(chunk)
            if chunk == null
                print("the server closed it")

                shutSocket(c)
                done()

        onData(c, heard)

        await sleep(20)

        close(theServer)

    main()
    """

    assert_eq(wire_out(prog), "the server closed it")

@test
AN_ADOPTED_CONNECTION_IS_HEARD_ONCE_ITS_FIRST_REQUEST_REACHES_THE_HANDLER()
    // **`heard()` is what a retiring cluster worker waits on before its `onShutdown`**, so it must
    // settle neither before the handler has the request nor later than the turn it gets it. A server
    // with nothing handed to it is heard at once; one with a silent connection is not, until the
    // client speaks -- and then the handler's line comes before `heard`'s.

    val prog = raw"""
    import { adopt } from slate:http
    import { listen } from slate:net

    handler(req)
        print("handler")
        "ok"

    val app = adopt(handler)

    var isHeard = false

    async listenFor()
        await app.heard()
        isHeard = true
        print("heard")

    var outer = null

    took(conn)
        app.handle(conn)
        shutSocket(outer)
        listenFor()

    outer = listen(0, took)

    async main()
        await app.heard()
        print("nothing handed, heard")

        val c = (await connect("127.0.0.1", localPort(outer))).value

        var got = ""

        heard(chunk)
            if chunk == null
                print(got.contains("ok"), "then closed")

                shutSocket(c)
                done()

                return

            got = got + chunk

        onData(c, heard)

        await sleep(50)
        print("silent, heard:", isHeard)

        await send(c, "GET / HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n")

    main()
    """

    assert_eq(wire_out(prog), "nothing handed, heard\nsilent, heard: false\nhandler\nheard\ntrue then closed")

@test
AN_ADOPTED_CONNECTION_THAT_NEVER_SPEAKS_IS_HEARD_WHEN_THE_CLOSE_LETS_IT_GO()
    // **The other way out of the count**: a connection that says nothing is let go `DrainMillis`
    // after the server closes, and letting it go is the end of waiting for it -- otherwise a worker
    // handed one would wait on `heard()` for as long as its ceiling, every time.

    val prog = raw"""
    import { adopt } from slate:http
    import { listen } from slate:net

    val app = adopt((req) -> "never asked")

    var outer = null

    async listenFor()
        await app.heard()
        print("heard")

    took(conn)
        app.handle(conn)
        shutSocket(outer)
        listenFor()
        app.close()

    outer = listen(0, took)

    async main()
        val c = (await connect("127.0.0.1", localPort(outer))).value

        heard(chunk)
            if chunk == null
                print("the server closed it")

                shutSocket(c)
                done()

        onData(c, heard)

    main()
    """

    assert_eq(wire_out(prog), "heard\nthe server closed it")

@test
A_SECOND_REQUEST_ON_A_CONNECTION_THE_SERVER_HAS_CLOSED_IS_NOT_SERVED()
    // **There is no keep-alive after `close`.** Both requests are written in one go, so the second is
    // already in the parser when the shutdown happens -- and it is not answered: the connection ends
    // with the response that was in flight. A server being shut down that went on serving whatever
    // was already buffered would never finish shutting down.

    val prog = raw"""
    var theServer = null

    val server = serve(0, async (req) ->
        close(theServer)

        await sleep(30)

        "one")

    theServer = server

    async main()
        val c = (await connect("127.0.0.1", localPort(server))).value

        var got = ""

        heard(chunk)
            if chunk == null
                print("answers", split(got, "HTTP/1.1 200").length - 1)

                shutSocket(c)
                done()

                return

            got = got + chunk

        onData(c, heard)

        await send(c, "GET /a HTTP/1.1\r\nHost: h\r\n\r\nGET /b HTTP/1.1\r\nHost: h\r\n\r\n")

    main()
    """

    assert_eq(wire_out(prog), "answers 1")

// -- what a handler is TOLD about the request ------------------------------------------------------

// A server whose answer says something about the request it was given, and one request written as
// BYTES so that a body which is not text can be sent at all.
//
// **`send` reads an array as bytes**, so the head is `toBytes`'d and the body concatenated on to it
// -- which is the only way to put a `0xFF` on the wire from a slate program.
private told(answer: string, head: string, body: string) -> string =
    "val server = serve(0, req -> (" + answer + "))\n" +
    "async main()\n" +
    "    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n" +
    "    var got = bytes(0)\n" +
    "    heard(chunk)\n" +
    "        if chunk == null\n" +
    "            print(fromBytes(got).value)\n" +
    "            shutSocket(c)\n" +
    "            close(server)\n" +
    "            done()\n" +
    "        else\n" +
    "            got = concat(got, chunk)\n" +
    "    onBytes(c, heard)\n" +
    "    await send(c, concat(toBytes(" + head + "), " + body + "))\n" +
    "main()\n"

@test
A_BODY_THAT_IS_NOT_UTF_8_ARRIVES_INTACT_UNDER_req_bytes()
    // **`req.body` was the ONLY reading of a body, and it is `from_utf8(...).unwrap_or("")`** -- so a
    // PNG posted to a route was the same value as a request that carried no body at all: no header,
    // no status, no fault. `0` and `255` are part of no UTF-8 sequence, which is what makes this the
    // case rather than a convenience.
    val said = br_wire_out(told(
        "string(req.bytes.toArray()) + \"|\" + string(req.body.length)",
        "\"POST /u HTTP/1.1\\r\\nHost: h\\r\\nContent-Length: 5\\r\\nConnection: close\\r\\n\\r\\n\"",
        "[0, 159, 146, 150, 255]"))

    assert(said.contains("[0, 159, 146, 150, 255]|0"), said)

@test
A_TEXT_BODY_IS_UNCHANGED_AND_ITS_BYTES_ARE_BESIDE_IT()
    // The control, and the compatibility claim: nothing a program already reads moved.
    val said = br_wire_out(told(
        "req.body + \"|\" + string(req.bytes.toArray())",
        "\"POST /u HTTP/1.1\\r\\nHost: h\\r\\nContent-Length: 5\\r\\nConnection: close\\r\\n\\r\\n\"",
        "toBytes(\"hello\")"))

    assert(said.contains("hello|[104, 101, 108, 108, 111]"), said)

@test
A_HANDLER_IS_TOLD_WHO_CONNECTED()
    // **`slate:http` told a handler the method, the path and the headers and nothing at all about the
    // client**, so a rate limiter, an allow-list and a log line each had only whatever a proxy had
    // written into a header. `listen` binds `::`, so a client on `127.0.0.1` arrives mapped and the
    // prefix is taken off -- an allow-list written against the address a client dialled has to match.
    val said = br_wire_out(told(
        "string(req.address)",
        "\"GET / HTTP/1.1\\r\\nHost: h\\r\\nConnection: close\\r\\n\\r\\n\"",
        "[]"))

    assert(said.contains("127.0.0.1"), said)
    assert(!said.contains("::ffff:"), said)

@test
A_LISTENER_HAS_NO_PEER_AND_SAYS_SO_RATHER_THAN_FAILING()
    // Asking a socket who is at the far end of it is asking about a thing that may not be there, so
    // it is an answer -- which is `alpnProtocol`'s channel and for its reason.
    val body = "import { listen, close, remoteAddress } from slate:net\n" +
        "val server = listen(0, conn -> null)\n" +
        "print(remoteAddress(server))\n" +
        "close(server)\n"

    assert_eq(out(body), "null")
