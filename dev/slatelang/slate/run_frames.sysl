module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.str_builder

// The instruction loop: one `Op` after another, and the sentence a thrown value carries.
//
// **Cut out of `execute.sysl`, which keeps the entry points and the calls.** It reaches back for
// `pop`, `peek`, `arrange_named` and `invoke`, each of which says so where it is declared, and
// `guarded` reaches in here for `run_frames`.
// The sentence a thrown value carries.
//
// **A caught fault re-thrown keeps its own words**, which is what `throw e` inside a `catch` is for:
// a library that decides not to handle something puts it back rather than replacing it with a
// sentence of its own. That is why an object with a `message` is read for that field rather than
// rendered -- rendering would turn the fault into `{message: "...", line: 3, file: "..."}`, which is
// a description of a fault rather than the fault.
//
// **The LOCATION becomes the `throw`'s own**, and does not travel. A `Fail` carries a span into a
// source, and a caught fault has been flattened to a line number and a file name by the time a
// program can see it -- so a re-thrown fault says the words of the original and points at the line
// that put it back. That is the honest reading of what the value still holds.
private thrown_message(v: Value) -> string = v match
    Str(p) -> p.s
    Object(o) ->
        obj_get_name(o, "message") match
            Some(Str(p)) -> p.s
            _ -> value_text(v)
    other -> value_text(other)

// The instruction loop.
//
// **The instruction pointer and the scope are sysl locals rather than fields of the top frame**, and
// written back only when a call pushes or pops one -- or when an `await` suspends. Reading them out of
// a `Buf` on every instruction would copy a whole frame per step.
//
// Not `private`: reached from `execute.sysl`.
run_frames(u: *Unit, start: usize, from: usize, base0: usize, floor: usize, outer_scope: *EnvObj) -> Step
    var chunk_ix = start

    // **The machine keeps `current_source` in step with the chunk it is running**, which is what
    // lets `failure` stamp a fault with the file its span belongs to. It is set here and at every
    // point below that changes `chunk_ix`; there are three, and they are the only three.
    current_source = u.chunks.at(chunk_ix).source
    var pc = from
    var base = base0
    var code = u.chunks.at(chunk_ix).code

    loop
        if pc >= code.len()
            // A chunk that ran off its end answers null, which only happens for an empty body.
            vm.stack.push(Null)
            pc = code.len()

        val ins = code.at(pc)
        val at = ins.at

        pc += 1

        ins.op match
            // The object was built by the instructions above this one and nothing else has seen it
            // yet, so there is no window in which a data value is writable and reachable.
            SealData -> peek(0) match
                Object(o) -> o.frozen = true
                _ -> ()
            PushNull -> vm.stack.push(Null)
            PushUndefined -> vm.stack.push(Undefined)
            PushBool(v) -> vm.stack.push(Bool(v))
            PushInt(v) -> vm.stack.push(Int(v))
            PushReal(v) -> vm.stack.push(Real(v))
            PushStr(k) -> vm.stack.push(str_value(u.strings.at(k)))
            PushModule(m) -> vm.stack.push(module_values.at(m))
            PushShape(pk, k) -> vm.stack.push(shape_value(u.patterns.at(pk), u.strings.at(k), vm.scope))

            CheckType(k, t, pk) ->
                val name = u.strings.at(k)

                val v = lookup(vm.scope, name) match
                    Some(found) -> found
                    None -> return fault(at, s"`${name}` is not defined")

                if !match_pattern(u.patterns.at(pk), v, vm.scope, false)
                    return fault(at, s"`${name}` was declared ${u.strings.at(t)}, and was given ${show_value(v)}")

            CheckResult(t, pk) ->
                if !match_pattern(u.patterns.at(pk), peek(0), vm.scope, false)
                    return fault(at, s"this answers ${u.strings.at(t)}, and gave back ${show_value(peek(0))}")

            DefineTest(k) -> registered_tests.push(TestCase(u.strings.at(k), u.chunks.at(chunk_ix).source, pop()))

            PushHandler(to) -> vm.handlers.push(Handler(chunk_ix, to, vm.stack.len(), vm.frames.len(), vm.scope, base))
            PopHandler -> vm.handlers.truncate(vm.handlers.len() - 1)
            Raise -> return fault(at, thrown_message(pop()))

            // The head of a chunk with default parameters, and nowhere else.
            JumpIfBound(k, to) -> if bound_here(vm.scope, u.strings.at(k)) then pc = to

            LoadName(k) ->
                val name = u.strings.at(k)

                lookup(vm.scope, name) match
                    Some(v) -> vm.stack.push(v)
                    None -> return fault(at, s"`${name}` is not defined")
            DeclareVal(k) ->
                val v = pop()

                keepable(v, at, s"bound to `${u.strings.at(k)}`")?
                declare(vm.scope, u.strings.at(k), v, false)
            DeclareVar(k) ->
                val v = pop()

                keepable(v, at, s"bound to `${u.strings.at(k)}`")?
                declare(vm.scope, u.strings.at(k), v, true)
            StoreName(k) ->
                val name = u.strings.at(k)

                val stored = pop()

                keepable(stored, at, s"written to `${name}`")?

                assign_name(vm.scope, name, stored) match
                    Written -> ()
                    Immutable -> return fault(at, s"`${name}` is a `val`, so it is written once")
                    Unknown -> return fault(at, s"`${name}` is not defined")

            UnaryOp(op) ->
                val v = pop()

                vm.stack.push(unary(op, v, at)?)
            BinaryOp(op) ->
                val b = pop()
                val a = pop()

                vm.stack.push(on_values(op, a, b, at)?)

            MakeArray(n) ->
                var items: Buf[Value] = buf()

                for i in 0..<n
                    keepable(peek(n - 1 - i), at, "put in an array")?
                    items.push(peek(n - 1 - i))

                // **Allocated before the stack shrinks.** Between the truncate and the alloc the
                // elements would live only in `items`, which the mark phase cannot see -- and `alloc`
                // collects when the heap is full.
                val made = Array(new_array(items))

                vm.stack.truncate(vm.stack.len() - n)
                vm.stack.push(made)
            MakeObject(n) ->
                val o = new_object()
                val mark = root_mark()

                hold(Object(o))

                for i in 0..<n
                    val key = peek((n - 1 - i) * 2 + 1)
                    val value = peek((n - 1 - i) * 2)

                    keepable(value, at, "put in an object")?

                    obj_put(o, key, value, at)?

                release(mark)
                vm.stack.truncate(vm.stack.len() - n * 2)
                vm.stack.push(Object(o))

            GetIndex ->
                val k = pop()
                val target = pop()

                vm.stack.push(read_at(target, k, at)?)
            SetIndex ->
                val v = pop()
                val k = pop()
                val target = pop()

                keepable(v, at, "stored")?
                keepable(k, at, "used as a key")?

                store_at(target, k, v, at)?
            GetField(k) ->
                val target = pop()

                vm.stack.push(read_field(target, u.strings.at(k), at)?)
            SetField(k) ->
                val v = pop()

                keepable(v, at, s"stored in `${u.strings.at(k)}`")?

                pop() match
                    Object(o) ->
                        // **Asked here because `obj_put_name` has nowhere to report from**, where
                        // the indexed form goes through `obj_put` and refuses it there. The two
                        // answer the same sentence.
                        if o.frozen then return fault(at, frozen_complaint(s"`${u.strings.at(k)}`"))

                        obj_put_name(o, u.strings.at(k), v)
                    other -> return fault(at, s"a field belongs to an object, and this is ${other.type_name()}")

            Jump(to) -> pc = to
            JumpIfFalse(to) -> if !pop().truthy() then pc = to
            JumpIfTrueKeep(to) -> if peek(0).truthy() then pc = to
            JumpIfPresentKeep(to) -> if !is_nullish(peek(0)) then pc = to
            JumpIfAbsentKeep(to) -> if is_nullish(peek(0)) then pc = to
            JumpIfFalseKeep(to) -> if !peek(0).truthy() then pc = to

            Pop -> vm.stack.truncate(vm.stack.len() - 1)
            Discard ->
                peek(0) match
                    Promise(pr) ->
                        pr.orphaned = true
                        orphan_failed(pr)
                    _ -> ()

                vm.stack.truncate(vm.stack.len() - 1)
            Dup -> vm.stack.push(peek(0))
            DupAt(n) -> vm.stack.push(peek(n))
            RotUp(n) ->
                // `[a, b, c]` with an `n` of two becomes `[c, a, b]`: the top slides down and
                // everything it passed shifts up one.
                val top = vm.stack.len() - 1
                val v = vm.stack.at(top)
                var i = top

                while i > top - n
                    vm.stack.set(i, vm.stack.at(i - 1))
                    i -= 1

                vm.stack.set(top - n, v)

            Join(n) ->
                var out = str_builder()

                for i in 0..<n
                    keepable(peek(n - 1 - i), at, "put in a string")?
                    out.push(printed(peek(n - 1 - i), at)?)

                val joined = str_value(out.finish())

                vm.stack.truncate(vm.stack.len() - n)
                vm.stack.push(joined)
            Repeat ->
                val n = pop() match
                    Int(k) ->
                        if k < 0 then return fault(at, s"an array of ${k} copies is not something to make") else usize(k)
                    other -> return fault(at, s"a repeat count is a whole number, and this is ${other.type_name()}")

                keepable(peek(0), at, "put in an array")?

                var items: Buf[Value] = buf()

                for i in 0..<n
                    items.push(peek(0))

                // Allocated before the stack shrinks, for the reason `MakeArray` gives.
                val made = Array(new_array(items))

                vm.stack.truncate(vm.stack.len() - 1)
                vm.stack.push(made)
            WithObject(n) ->
                val base = peek(n * 2)

                val fields = base match
                    Object(o) -> o
                    other -> return fault(at, s"`with` copies an object, and this is ${other.type_name()}")

                val o = new_object()
                val mark = root_mark()

                hold(Object(o))

                // The base's own fields first, in the order it holds them, so that the copy keeps
                // the order and a changed field keeps the place it already had.
                for i in 0..<fields.entries.len()
                    val entry = fields.entries.at(i)

                    if !entry.dead then obj_put(o, entry.key, entry.value, at)?

                for i in 0..<n
                    val key = peek((n - 1 - i) * 2 + 1)
                    val value = peek((n - 1 - i) * 2)

                    keepable(value, at, "put in an object")?
                    obj_put(o, key, value, at)?

                // A copy of a data value is a data value, which is what makes `with` the answer the
                // refusal points at. Set last, the writes above being how the copy was filled.
                o.frozen = fields.frozen

                release(mark)
                vm.stack.truncate(vm.stack.len() - n * 2 - 1)
                vm.stack.push(Object(o))

            // **`spread` picks the words and changes nothing else.** `{ ...o }` is this instruction
            // and so is `a with b`; a message naming the spelling the reader did not write sends
            // them looking for it.
            WithMerge(spread) ->
                val other = peek(0) match
                    Object(o) -> o
                    got ->
                        return fault(at, if spread
                            then s"`...` spreads the fields of an object, and this is ${got.type_name()}"
                            else s"`with` copies the fields of an object, and this is ${got.type_name()}")

                val fields = peek(1) match
                    Object(o) -> o
                    got -> return fault(at, s"`with` copies an object, and this is ${got.type_name()}")

                val o = new_object()
                val mark = root_mark()

                hold(Object(o))

                // The base's own fields first, in the order it holds them, so the copy keeps the
                // order and a field the other object also has keeps the place it already had.
                for i in 0..<fields.entries.len()
                    val entry = fields.entries.at(i)

                    if !entry.dead then obj_put(o, entry.key, entry.value, at)?

                for i in 0..<other.entries.len()
                    val entry = other.entries.at(i)

                    if !entry.dead then obj_put(o, entry.key, entry.value, at)?

                // **A copy of a data value is a data value**, which is what makes `with` the answer
                // the refusal points at: `c with { r: 5 }` is another `Circle`, still sealed, still
                // usable as a key. The flag is set last, the writes above being how it was filled.
                o.frozen = fields.frozen

                release(mark)
                vm.stack.truncate(vm.stack.len() - 2)
                vm.stack.push(Object(o))

            MakeRange(inclusive, has_lo, has_hi) ->
                val hi = if has_hi then range_end(pop(), at, "the end")? else 0
                val lo = if has_lo then range_end(pop(), at, "the start")? else 0

                vm.stack.push(RangeVal(lo, hi, inclusive, has_lo, has_hi))
            Unpack(k, immutable) ->
                val subject = pop()

                // **A binding has no next arm, so a shape that does not fit is a fault**, where a
                // `match` would simply let the next pattern try. The message says the pattern back
                // and says what arrived, both being things the reader needs and neither being on
                // the line by itself.
                if !match_pattern(u.patterns.at(k), subject, vm.scope, !immutable)
                    return fault(at, unpack_complaint(u.patterns.at(k), subject))

            IsPat(k, negated) ->
                val took = match_pattern(u.patterns.at(k), pop(), vm.scope, false)

                vm.stack.push(Bool(if negated then !took else took))

            PushScope -> vm.scope = new_env(vm.scope)
            PopScope -> vm.scope = vm.scope.parent

            MakeClosure(c) -> vm.stack.push(Fn(new_closure(u.chunks.at(c).params, c, vm.scope)))
            DefineFn(k, c) ->
                val name = u.strings.at(k)

                // Bound before the closure is built, so the body can see its own name -- which is the
                // whole of what makes a named function recursive.
                declare(vm.scope, name, Null, false)
                declare(vm.scope, name, Fn(new_closure(u.chunks.at(c).params, c, vm.scope)), false)

            TestPat(k) ->
                val took = match_pattern(u.patterns.at(k), peek(0), vm.scope, false)

                vm.stack.push(Bool(took))

            IterInit ->
                peek(0) match
                    Array(_) -> vm.stack.push(Int(0))

                    // **A range with an end left out is refused rather than walked**, because the
                    // walk would not stop: an end taken from what the range is used on has nothing to
                    // take it from here.
                    RangeVal(_, _, _, has_lo, has_hi) ->
                        if !has_lo || !has_hi
                            return fault(at, "`for` needs a range with both ends, since one left out would never finish")

                        vm.stack.push(Int(0))
                    // A generator has no counter to initialise, but the loop pushes one anyway so
                    // that `IterNext` is one shape: the integer is kept beside the generator and
                    // ignored, which costs nothing and keeps the instruction from needing to know
                    // which kind of subject it has before it asks.
                    Gen(_, _) -> vm.stack.push(Int(0))
                    other -> return fault(at, s"`for` walks an array, a range or a generator, and this is ${other.type_name()}")
            IterNext(to) ->
                val i = peek(0) match
                    Int(n) -> usize(n)
                    _ -> 0

                val step = peek(1) match
                    Array(p) ->
                        if i >= p.items.len() then None else Some(p.items.at(i))
                    RangeVal(lo, hi, inclusive, _, _) ->
                        if i >= range_count(lo, hi, inclusive) then None else Some(Int(lo + long(i)))

                    // **A generator ignores the counter and is asked instead.** The loop keeps
                    // counting beside it, which costs an integer and keeps this instruction one
                    // shape; what says whether there is another value is the generator, and only it
                    // can know. This runs slate code from inside the instruction loop, which is what
                    // a native calling back already does.
                    Gen(id, gen) -> gen_iter_next(id, gen, at)?
                    _ -> return fault(at, "`for` walks an array, a range or a generator")

                step match
                    None -> pc = to
                    Some(v) ->
                        vm.stack.set(vm.stack.len() - 1, Int(long(i + 1)))
                        vm.stack.push(v)

            // **The subject is left where it stands** -- what this decides is only whether the
            // `next()` about to be called is a question worth asking of it.
            IterAwaitCheck -> peek(0) match
                Object(_) -> ()
                Gen(_, _) -> ()
                other ->
                    // **The sentence names the `await` and not `next`**, which is the whole reason
                    // this instruction exists: a reader who wrote `for await x in xs` over an array
                    // has no `next` anywhere in their program to go and look at.
                    val kind = other.type_name()

                    return fault(at, s"a `for await` asks its subject for `next()`, and ${kind} has none -- write `for` without `await` to walk ${kind}")

            FailWith(k) -> return fault(at, u.strings.at(k))
            FailNoArm -> return fault(at, s"no arm of this match applies to ${value_text(peek(0))}")

            Tick ->
                maybe_collect()

                // A full heap is reported where there is a line to point at; the allocator has no
                // idea which statement it was serving.
                if heap_exhausted then return fault(at, "this program has run out of memory")

            CallFn(argc, names) ->
                var written: Buf[Value] = buf()

                for i in 0..<argc
                    keepable(peek(argc - 1 - i), at, "passed to a function")?
                    written.push(peek(argc - 1 - i))

                val callee = peek(argc)

                vm.stack.truncate(vm.stack.len() - argc - 1)

                // **Zero means every argument was positional**, which is nearly every call, and the
                // whole of what it costs one is this comparison.
                val args = if names == 0 then written else arrange_named(u, callee, written, u.arg_names.at(names), 0, at)?

                invoke(u, callee, args, at, vm.frames.len())? match
                    Answered(v) -> vm.stack.push(v)
                    Enter(body, called) ->
                        // The frame this call is leaving is written back only here, which is what
                        // makes the ordinary instruction cheap.
                        vm.frames.push(Frame(chunk_ix, pc, vm.scope, base, vm.handlers.len()))
                        chunk_ix = body
                        code = u.chunks.at(chunk_ix).code
                        current_source = u.chunks.at(chunk_ix).source
                        pc = 0
                        vm.scope = called
                        base = vm.stack.len()

            // `f(...xs)` -- the arguments are an array the instruction above it built.
            //
            // **The only difference from `CallFn` is where the count comes from**, which is the
            // whole point: everything after that -- the keepable check, the truncate, `invoke` and
            // the two ways a call can go -- is the same code doing the same thing.
            CallSpread ->
                val given = pop()
                val callee = pop()

                var args: Buf[Value] = buf()

                given match
                    Array(a) ->
                        for i in 0..<a.items.len()
                            keepable(a.items.at(i), at, "passed to a function")?
                            args.push(a.items.at(i))
                    _ -> return fault(at, "unreachable")

                invoke(u, callee, args, at, vm.frames.len())? match
                    Answered(v) -> vm.stack.push(v)
                    Enter(body, called) ->
                        vm.frames.push(Frame(chunk_ix, pc, vm.scope, base, vm.handlers.len()))
                        chunk_ix = body
                        code = u.chunks.at(chunk_ix).code
                        current_source = u.chunks.at(chunk_ix).source
                        pc = 0
                        vm.scope = called
                        base = vm.stack.len()

            // The top `n` arrays, made into one. What builds a spread argument list.
            JoinArrays(n) ->
                var items: Buf[Value] = buf()

                for i in 0..<n
                    peek(n - 1 - i) match
                        Array(a) ->
                            for j in 0..<a.items.len()
                                items.push(a.items.at(j))

                        // **The complaint names the spread and not the call**, because that is where
                        // the reader has to look: `f(...42)` is a mistake about what may be spread.
                        other -> return fault(at, s"`...` spreads an array, and this is ${other.type_name()}")

                // Allocated before the stack shrinks, for `MakeArray`'s reason.
                val made = Array(new_array(items))

                vm.stack.truncate(vm.stack.len() - n)
                vm.stack.push(made)

            // `o.m(a)`, which is where the receiver rule lives.
            //
            // **The lookup and the call are one instruction because the rule needs both.** By the
            // time a `GetField` has handed a function to a `CallFn`, the fact that decides whether
            // an object is passed -- was it the object's own, or a shared one reached through a
            // proto -- has been thrown away.
            CallMethod(k, argc, names) ->
                val name = u.strings.at(k)
                val target = peek(argc)

                // **A builtin type answers a method by TABLE and an object answers by field.** An
                // object is not in the table at all -- its names are the program's, and `proto` is
                // already the mechanism by which one gets methods. `method.sysl` says why.
                val looked = target match
                    Object(fields) -> field_from(fields, name, at)?
                    other -> builtin_receiver(target, name, at)?

                // **The five universal methods are what an object falls back to**, after its own
                // fields and its whole proto chain have answered nothing. A builtin kind has already
                // had the same fallback inside `builtin_receiver`.
                // **A class or a data name answers the three shape methods here**, where its own
                // fields and its proto chain have said nothing -- so a static the program declared
                // wins over them.
                val found = if is_absent(looked.0) then shape_receiver(target, name) match
                    Some(pair) -> pair
                    None -> universal_receiver(name) match
                        Some(pair) -> pair
                        None -> looked
                else looked

                var args: Buf[Value] = buf()

                // **The object goes in front of the written arguments where it was delegated to.**
                // A method the object carries itself has already captured what it needs; a shared
                // one cannot have, there being one of it for every instance. A builtin method is
                // delegated to by the same rule -- it is the free function of that name, and the
                // receiver is its first argument.
                if found.1 then args.push(target)

                for i in 0..<argc
                    keepable(peek(argc - 1 - i), at, "passed to a function")?
                    args.push(peek(argc - 1 - i))

                vm.stack.truncate(vm.stack.len() - argc - 1)

                if is_absent(found.0)
                    return fault(at, s"`${name}` is not a field of this object, so there is nothing to call")

                // **The receiver is parameter zero and is already in the list**, so the names cover
                // what was written and the arrangement is told how many slots are spoken for.
                val placed = if names == 0 then args else arrange_named(u, found.0, args, u.arg_names.at(names), if found.1 then 1 else 0, at)?

                invoke(u, found.0, placed, at, vm.frames.len())? match
                    Answered(v) -> vm.stack.push(v)
                    Enter(body, called) ->
                        vm.frames.push(Frame(chunk_ix, pc, vm.scope, base, vm.handlers.len()))
                        chunk_ix = body
                        code = u.chunks.at(chunk_ix).code
                        current_source = u.chunks.at(chunk_ix).source
                        pc = 0
                        vm.scope = called
                        base = vm.stack.len()

            // `o.m(...xs)`. The receiver rule is `CallMethod`'s and is not restated: what differs is
            // that the arguments arrive as an array, and the receiver goes in front of them where
            // the method was delegated to.
            CallMethodSpread(k) ->
                val name = u.strings.at(k)
                val given = pop()
                val target = peek(0)

                val looked = target match
                    Object(fields) -> field_from(fields, name, at)?
                    other -> builtin_receiver(target, name, at)?

                // **The five universal methods are what an object falls back to**, after its own
                // fields and its whole proto chain have answered nothing. A builtin kind has already
                // had the same fallback inside `builtin_receiver`.
                // **A class or a data name answers the three shape methods here**, where its own
                // fields and its proto chain have said nothing -- so a static the program declared
                // wins over them.
                val found = if is_absent(looked.0) then shape_receiver(target, name) match
                    Some(pair) -> pair
                    None -> universal_receiver(name) match
                        Some(pair) -> pair
                        None -> looked
                else looked

                var args: Buf[Value] = buf()

                if found.1 then args.push(target)

                given match
                    Array(a) ->
                        for i in 0..<a.items.len()
                            keepable(a.items.at(i), at, "passed to a function")?
                            args.push(a.items.at(i))
                    _ -> return fault(at, "unreachable")

                vm.stack.truncate(vm.stack.len() - 1)

                if is_absent(found.0)
                    return fault(at, s"`${name}` is not a field of this object, so there is nothing to call")

                invoke(u, found.0, args, at, vm.frames.len())? match
                    Answered(v) -> vm.stack.push(v)
                    Enter(body, called) ->
                        vm.frames.push(Frame(chunk_ix, pc, vm.scope, base, vm.handlers.len()))
                        chunk_ix = body
                        code = u.chunks.at(chunk_ix).code
                        current_source = u.chunks.at(chunk_ix).source
                        pc = 0
                        vm.scope = called
                        base = vm.stack.len()

            // `yield e` -- stand still and let whoever is driving take the value.
            //
            // **The frame is written back and the machine is NOT parked**, which is where this parts
            // company with `Await`. An `await` is resumed by the scheduler, so it has to be in
            // `parked` before it lets go; a generator is resumed by `gen_step`, which is the very
            // function this `Err(Wait)` is about to return to -- so parking is that function's move,
            // and doing it here as well would park twice and lose the machine.
            //
            // **The value stays on the stack for `Await`'s reason**: the machine's own stack is a
            // root the tracer walks, and the sysl local this arm could have kept it in is not.
            Op.Yield ->
                vm.frames.push(Frame(chunk_ix, pc, vm.scope, base, vm.handlers.len()))

                return Err(Wait)

            Op.Await ->
                // **A machine that is not a coroutine has nowhere to come back from.** The compiler
                // refuses `await` outside an `async` function, so this is only reachable if a chunk
                // were started the ordinary way -- and suspending the main program would leave `run`
                // with nothing to return.
                if vm.promise == null || floor != 0
                    return fault(at, "`await` cannot suspend this call")

                // **The awaited value stays on the stack while the machine is parked**, which is what
                // keeps a pending promise reachable: the shadow stack cannot hold it across the park,
                // and the machine's own operand stack is a root the tracer already walks. The answer
                // is written over it when the machine comes back.
                val awaited = peek(0)

                // What `resume_chunk` will pick the loop up from.
                vm.frames.push(Frame(chunk_ix, pc, vm.scope, base, vm.handlers.len()))

                val id = park()

                awaited match
                    Promise(pr) ->
                        pr.handled = true

                        // **A settled promise still goes round the queue.** Continuing here instead
                        // would make `await` on a finished promise run the rest of the function before
                        // anything else queued ahead of it -- which is the ordering bug every async
                        // runtime that took the shortcut has had to undo. JavaScript resolves this
                        // case through a microtask for the same reason.
                        if pr.settled
                            ready.push(Resumption(id, pr.value, pr.failed, pr.message, pr.at))
                        else
                            pr.waiters.push(id)
                    other ->
                        // `await 5` is 5, as in JavaScript -- and it still yields, so that a program
                        // cannot tell which of the two it was given by watching what runs next.
                        ready.push(Resumption(id, other, false, "", at))

                return Err(Wait)

            Ret ->
                val v = pop()

                vm.stack.truncate(base)

                if vm.frames.len() == floor
                    vm.scope = outer_scope
                    return Ok(v)

                val back = vm.frames.at(vm.frames.len() - 1)

                vm.frames.truncate(vm.frames.len() - 1)

                // **Anything the returning call was inside goes with it.** A `return` written in a
                // `try` body skips its `PopHandler`, and a handler outliving the frame it was
                // established in names an instruction nobody is standing at.
                vm.handlers.truncate(back.handlers)
                chunk_ix = back.chunk
                code = u.chunks.at(chunk_ix).code
                current_source = u.chunks.at(chunk_ix).source
                pc = back.pc
                vm.scope = back.scope
                base = back.base
                vm.stack.push(v)
end run_frames
