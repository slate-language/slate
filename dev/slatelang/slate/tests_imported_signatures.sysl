module dev.slatelang.slate
@tests

import sysl.text.Search

// A call to a function another file exported, checked against the signature that file was checked
// with (`note_exports` / `import_signature` in `signatures.sysl`). The fixtures are `tests/mods/sig_*.sl`,
// whose exporting half is `sig_lib.sl`.

// -- refused, as a call beside the definition would be -----------------------------------------------

@test
TOO_FEW_ARGUMENTS_TO_AN_IMPORTED_FUNCTION_ARE_REFUSED_BEFORE_IT_RUNS()
    assert(ran_fault("tests/mods/sig_arity.sl").contains("`pair` takes 2 arguments and this gives it 1"))

@test
AN_ARGUMENT_THAT_DOES_NOT_FIT_AN_IMPORTED_PARAMETER_IS_REFUSED_BEFORE_IT_RUNS()
    assert(ran_fault("tests/mods/sig_type.sl").contains("`pair` takes integer here, and this is string"))

@test
A_REEXPORTED_FUNCTION_CARRIES_ITS_SIGNATURE_THROUGH_THE_FILE_BETWEEN()
    assert(ran_fault("tests/mods/sig_uses_reexport.sl").contains("`add` takes 2 arguments and this gives it 1"))

@test
A_PACKAGES_FUNCTION_IS_CHECKED_AS_A_FILES_IS()
    assert(with_packages("tests/proj/arity.sl").contains("`hello` takes 1 argument and this gives it 0"))

@test
A_FUNCTION_FROM_ONE_OF_SLATES_OWN_MODULES_WRITTEN_IN_SLATE_IS_CHECKED_TOO()
    assert(fails("import { encodeComponent } from slate:url\n\nprint(encodeComponent(1))\n").contains("`encodeComponent` takes string here, and this is integer"))
    assert(fails("import { encodeComponent } from slate:url\n\nprint(encodeComponent())\n").contains("`encodeComponent` takes 1 argument and this gives it 0"))

// -- accepted ----------------------------------------------------------------------------------------

@test
DEFAULTS_A_REST_PARAMETER_AND_AN_UNTYPED_PARAMETER_ACCEPT_WHAT_THEY_ACCEPT_AT_HOME()
    // `greet` has a default, `count` gathers, and `loose` names no type, so a string and a real both
    // go; `label` is an exported value that is not a function, which crosses as `any`.
    assert_eq(ran_out("tests/mods/sig_accepted.sl"), "3 a! a? 1 3 s 2.5 lib")

@test
A_GUARD_ENDING_IN_AN_IMPORTED_CALL_THAT_ALWAYS_THROWS_NARROWS_AS_A_THROW_DOES()
    // `parsed` answers `integer | null`; `refuse` throws on every path, so below the guard `n` is an
    // integer -- the arithmetic the machine never reaches with a null is not refused.
    assert_eq(ran_out("tests/mods/sig_never.sl"), "6")

@test
A_GUARD_ENDING_IN_A_LOCAL_CALL_THAT_ALWAYS_THROWS_NARROWS_TOO()
    val program = "p(s) -> integer | null = if s == \"\" then null else 3\n\nstop(m)\n    throw m\n\nf(s)\n    val n = p(s)\n\n    if n == null then stop(\"x\")\n\n    n * 2\n\nprint(f(\"a\"))\n"

    assert_eq(out(program), "6")

@test
A_CALL_THAT_THROWS_ONLY_SOMETIMES_DOES_NOT_NARROW()
    val program = "p(s) -> integer | null = if s == \"\" then null else 3\n\nmaybe(m)\n    if m == \"\" then throw m\n\n    0\n\nf(s)\n    val n = p(s)\n\n    if n == null then maybe(\"x\")\n\n    n * 2\n\nprint(f(\"a\"))\n"

    assert(fails(program).contains("`*` does not apply to integer | null and integer"))

@test
A_CALL_THAT_NEVER_ANSWERS_GIVES_A_JOIN_NOTHING()
    // The `else` is the only branch that answers, so `v` is an integer -- and handing it to a string
    // parameter is the fault the machine raises whenever `c` is false.
    val program = "stop(m)\n    throw m\n\nshout(s: string) = s\n\nf(c)\n    val v = if c then stop(\"x\") else 5\n\n    shout(v)\n\nprint(f(false))\n"

    assert(fails(program).contains("`shout` takes string here, and this is integer"))

@test
A_NAMESPACE_IMPORT_IS_A_CALL_THROUGH_A_VALUE_AND_IS_NOT_CHECKED()
    // `lib.pair(1, 2, 3)` gives one too many, which the machine drops -- a call through a value is
    // where every unchecked call goes.
    assert_eq(ran_out("tests/mods/sig_namespace.sl"), "3")

@test
A_CYCLE_IS_THE_LOADERS_REFUSAL_AND_NOT_A_CHECKERS()
    // `sig_cycle_a.sl` calls `b` with three arguments where it takes one; the loader refuses the circle
    // before the checker could read a signature that does not exist yet.
    val said = ran_fault("tests/mods/sig_cycle_a.sl")

    assert(said.contains("a file cannot import something that is waiting for it"))
    assert(!said.contains("takes"))
