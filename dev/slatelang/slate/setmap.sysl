module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// What a program does to a set and to a map.
//
// **Both are an `ObjectObj` and nothing else**, which is the whole of why this file is short: an
// object is already an insertion-ordered hash table keyed by any value at all, hashing structurally
// and consulting a class's own `hash` and `==` where it wrote them. A set uses the key half and
// ignores the value; a map uses both. `table.sysl` is the implementation of all three.
//
// **What separates a map from an object is what a KEY MEANS, not how it is stored.** An object's
// keys are the program's field names -- `o.x` is a lookup a reader expects to find a field, a
// `proto` on one is machinery, and a data value's are frozen. A map's keys are data: nothing is a
// field, nothing is walked past, and a key that happens to spell `proto` is a key like any other.
// That is exactly the distinction JavaScript drew when it added `Map` beside the object, and it is
// why a program that keys by a number, an array or an instance wants this rather than an object.
//
// **A MUTATOR ANSWERS THE COLLECTION HERE, WHERE AN ARRAY'S ANSWERS NOTHING.** `array.sysl` refuses
// to hand the array back from `sort` and `push` so that `ys = xs.sort()` cannot read as a fresh
// array; the reason does not carry over, because `add` and `set` are the names JavaScript gave them
// and chaining them is what those names are for -- `Set().add(1).add(2)` builds one set and says so.

// The table behind a set, or a complaint naming what was given instead.
private set_of(v: Value, at: Span, name: string) -> Result[*ObjectObj, Signal] = v match
    SetVal(t) -> Ok(t)
    other -> Err(failure(at, s"`${name}` takes a set, and this is ${other.type_name()}"))

private map_of(v: Value, at: Span, name: string) -> Result[*ObjectObj, Signal] = v match
    MapVal(t) -> Ok(t)
    other -> Err(failure(at, s"`${name}` takes a map, and this is ${other.type_name()}"))

// **A count is a FLOOR, not a target** -- `wants` in `text.sysl`, and the call rule the language
// follows everywhere: a surplus is dropped and only a count the call did not reach is refused.
private takes_n(args: Args, n: usize, at: Span, name: string, what: string) -> Result[unit, Signal]
    if args.len() < n then return Err(failure(at, s"`${name}` takes ${what}, and was given ${counted(args.len(), "argument")}"))

    Ok(())

// How many live entries a table holds.
//
// **`o.live` rather than `obj_len`**, and the difference is the one thing a map may not inherit from
// an object: `obj_len` walks the entries skipping what `walked_key` hides, which is right for a
// record and wrong for a container. A map's `proto` is a key.
private live_count(t: *ObjectObj) -> usize = t.live

// Everything a value yields, in order -- what a constructor is given and what `...` spreads.
//
// **The list is materialised rather than walked lazily**, because what reads it puts each value
// into a table that may grow, and a growth is where the collector runs. A `Buf[Value]` is not a
// root, so the caller holds the collection it is filling and this holds nothing longer than it
// takes to build.
//
// **The VERB is the caller's**, because the one sentence this answers with has to read as the
// construct that wanted the walk: `...` *spreads* what `Set` *takes*, and a refusal phrased in the
// other's words sends the reader to look at the wrong thing.
walked_values(v: Value, at: Span, what: string, verb: string) -> Result[Buf[Value], Signal]
    val mark = root_mark()
    val holder = new_array(buf())

    hold(Array(holder))

    val outcome = walked_into(holder, v, at, what, verb)

    outcome match
        Err(e) ->
            release(mark)
            Err(e)
        Ok(_) ->
            // Copied out while the array still holds every value. A `Buf` is sysl memory and its
            // `push` allocates nothing the collector manages, so nothing can be freed between the
            // first copy and the last.
            var out: Buf[Value] = buf()

            for i in 0..<holder.items.len()
                out.push(holder.items.at(i))

            release(mark)
            Ok(out)
end walked_values

// The same walk, straight into an array the CALLER is holding.
//
// **This is the primary form and `walked_values` is the wrapper, which is the other way round from
// how it reads.** A generator's arm runs slate code -- a program, which allocates -- between one
// value and the next, and a map's arm builds a fresh pair per entry; a `Buf[Value]` is not a root,
// so values already gathered into one are invisible to a collection that lands mid-walk. Pushing
// into a held `ArrayObj` roots each value the instant it is produced, which is the rule in
// `CLAUDE.md`'s *A `Value` in a sysl local is not a root* read at the one place that walks a
// program while gathering.
walked_into(out: *ArrayObj, v: Value, at: Span, what: string, verb: string) -> Result[unit, Signal]
    v match
        Array(a) ->
            // The length is read afresh each turn: nothing on this arm calls back into slate, so it
            // cannot change, and a `for` over the live length costs no more than a saved bound.
            for i in 0..<a.items.len()
                array_push(out, a.items.at(i))
        SetVal(t) ->
            for i in 0..<t.entries.len()
                val e = t.entries.at(i)

                if !e.dead then array_push(out, e.key)

        // **A map yields its pairs**, which is what `for (k, v) in m` unpacks and what `Map(m)`
        // reads back -- so a map spread into a `Map` is a copy of it, as an array spread into an
        // array is.
        MapVal(t) ->
            for i in 0..<t.entries.len()
                val e = t.entries.at(i)

                if !e.dead
                    var pair: Buf[Value] = buf()

                    pair.push(e.key)
                    pair.push(e.value)
                    array_push(out, Array(new_array(pair)))
        RangeVal(lo, hi, inclusive, has_lo, has_hi, step) ->
            if !has_lo || !has_hi
                return Err(failure(at, s"${what} needs a range with both ends, since one left out would never finish"))

            for i in 0..<range_count(lo, hi, inclusive, step)
                array_push(out, Int(range_at(lo, step, i)))
        Gen(id, gen) ->
            loop
                gen_iter_next(id, gen, at)? match
                    None -> break
                    Some(one) -> array_push(out, one)

        // **A buffer yields the NUMBER at each position**, which is what `for` over one already
        // yields and what `toArray` already answers -- so `array(bs)` and `bs.toArray()` are one
        // answer reached two ways rather than two readings of a buffer.
        Bytes(p) ->
            for i in 0..<p.data.len()
                array_push(out, Int(long(p.data.at(i))))
        other -> return Err(failure(at, s"${what} ${verb} an array, bytes, a range, a generator, a set or a map, and this is ${other.type_name()}"))

    Ok(())
end walked_into

// -- sets -----------------------------------------------------------------------------------------

// `Set()` and `Set(xs)`.
do_set_new(args: Args, at: Span) -> Step
    if args.len() > 1
        return fault(at, s"`Set` takes nothing or one thing to walk, and was given ${counted(args.len(), "argument")}")

    val mark = root_mark()
    val made = SetVal(new_object())

    hold(made)

    val out = fill_set(made, args, at)

    release(mark)
    out
end do_set_new

private fill_set(made: Value, args: Args, at: Span) -> Step
    if args.len() == 1
        val each = walked_values(args.at(0), at, "`Set`", "takes")?
        val t = set_of(made, at, "Set")?

        for i in 0..<each.len()
            keepable(each.at(i), at, "put in a set")?
            obj_put(t, each.at(i), Null, at)?

    Ok(made)
end fill_set

// `set_of` for a native that is going to WRITE, which a frozen set refuses.
//
// **Asked here rather than left to `obj_put`, and that is what keeps the two back ends saying one
// sentence.** The table underneath would refuse the write and name the MEMBER, which is an object's
// shape of complaint; a set has members rather than fields, so what reads is the call that was
// refused. `clear` reaches the table through `empty_table` and would not be refused at all.
private changing_set(v: Value, at: Span, name: string) -> Result[*ObjectObj, Signal]
    val t = set_of(v, at, name)?

    if t.frozen then return Err(failure(at, frozen_set_complaint(name)))

    Ok(t)
end changing_set

// `map_of` for a write, which is `changing_set`'s rule and is stated there.
private changing_map(v: Value, at: Span, name: string) -> Result[*ObjectObj, Signal]
    val t = map_of(v, at, name)?

    if t.frozen then return Err(failure(at, frozen_map_complaint(name)))

    Ok(t)
end changing_map

// `add(s, v)` -- and the set back, so that adds chain.
do_set_add(args: Args, at: Span) -> Step
    takes_n(args, 2, at, "add", "a set and a value")?

    val t = changing_set(args.at(0), at, "add")?

    keepable(args.at(1), at, "put in a set")?
    obj_put(t, args.at(1), Null, at)?
    Ok(args.at(0))
end do_set_add

do_set_has(args: Args, at: Span) -> Step
    takes_n(args, 2, at, "has", "a set and a value")?

    Ok(Bool(obj_has(set_of(args.at(0), at, "has")?, args.at(1), at)?))

// `delete(s, v)` -- whether there was one, which is JavaScript's answer and the useful one.
do_set_delete(args: Args, at: Span) -> Step
    takes_n(args, 2, at, "delete", "a set and a value")?

    Ok(Bool(obj_remove(changing_set(args.at(0), at, "delete")?, args.at(1), at)?))

do_set_clear(args: Args, at: Span) -> Step
    takes_n(args, 1, at, "clear", "a set")?

    empty_table(changing_set(args.at(0), at, "clear")?)
    Ok(Null)

// Everything out of a table, keeping the object so that every name for it sees the change.
private empty_table(t: *ObjectObj)
    val was = object_payload(t)

    t.entries = buf()

    // Emptied back to the small case a new table starts in, with no index -- `table.sysl` builds
    // one again the moment this table outgrows it.
    t.index = buf()
    t.live = 0

    // **This one really does give the storage back**, both buffers being replaced rather than
    // truncated -- which is what makes emptying a set or a map different from clearing an array.
    object_recharged(t, was)

// `size(s)` -- how many are in it.
//
// **A method rather than the property JavaScript has**, because slate has no properties on a
// builtin kind: `xs.len()` is a call and so is this. `len(s)` answers the same number.
do_set_size(args: Args, at: Span) -> Step
    takes_n(args, 1, at, "size", "a set")?

    Ok(Int(long(live_count(set_of(args.at(0), at, "size")?))))

// `values(s)` -- what is in it, as an array, in the order it was added.
do_set_values(args: Args, at: Span) -> Step
    takes_n(args, 1, at, "values", "a set")?

    Ok(Array(new_array(walked_values(args.at(0), at, "`values`", "takes")?)))

do_set_for_each(args: Args, at: Span) -> Step
    takes_n(args, 2, at, "forEach", "a set and a function")?

    val each = walked_values(args.at(0), at, "`forEach`", "takes")?

    for i in 0..<each.len()
        call_one(args.at(1), each.at(i), at, "forEach")?

    Ok(Null)
end do_set_for_each

private call_one(f: Value, v: Value, at: Span, name: string) -> Step
    var one: Buf[Value] = buf()

    one.push(v)
    apply_callback(f, one, at, name)

// -- set algebra ----------------------------------------------------------------------------------

// **Every member of a set, materialised before anything is written**, which is `walked_values`' rule
// and is here for a second reason on top of its one: asking a table whether it holds a key runs a
// class's own `hash` and `==` where it wrote them, so slate runs while this walk is standing in the
// entries -- and a walk holding an index into a buffer another thing may grow is a walk reading the
// wrong entry. The values are reachable from the set the caller is holding, so the list roots
// nothing itself.
private members(t: *ObjectObj) -> Buf[Value]
    var out: Buf[Value] = buf()

    for i in 0..<t.entries.len()
        val e = t.entries.at(i)

        if !e.dead then out.push(e.key)

    out
end members

// Which of the four a call is building. Named for the set operation rather than for the operator, a
// spelling being what `union` and `|` have in common and not what either one is.
private enum Combine
    SetUnion
    SetIntersection
    SetDifference
    SetSymmetric

// A new set holding what the two make together, with neither side touched.
//
// **`hold` between a mark and its release**, which is `do_set_new`'s arrangement and is needed for
// its reason: the answer is a `Value` in a sysl local, which is not a root, and a key comparison may
// run a class's own `hash` -- so the collector gets its chance while this is only half filled.
private combined(x: *ObjectObj, y: *ObjectObj, how: Combine, at: Span) -> Step
    val mark = root_mark()
    val t = new_object()
    val made = SetVal(t)

    hold(made)

    val out = fill_combined(t, x, y, how, at)

    release(mark)

    out match
        Ok(_) -> Ok(made)
        Err(e) -> Err(e)
end combined

// **The receiver's members first and the argument's after them**, which is the order JavaScript's
// own `union` answers in and the only one a reader can predict: a set walks in the order things went
// into it, so an answer built from two of them walks the left one first.
//
// **An intersection walks the RECEIVER too**, where JavaScript walks whichever of the two is smaller
// and lets that decide the order. What it buys there is a comparison count and what it costs is an
// answer whose order depends on a size nobody wrote down.
private fill_combined(t: *ObjectObj, x: *ObjectObj, y: *ObjectObj, how: Combine, at: Span) -> Result[unit, Signal]
    val xs = members(x)

    how match
        SetUnion ->
            val ys = members(y)

            for i in 0..<xs.len()
                obj_put(t, xs.at(i), Null, at)?

            for i in 0..<ys.len()
                obj_put(t, ys.at(i), Null, at)?
        SetIntersection ->
            for i in 0..<xs.len()
                if obj_has(y, xs.at(i), at)? then obj_put(t, xs.at(i), Null, at)?
        SetDifference ->
            for i in 0..<xs.len()
                if !obj_has(y, xs.at(i), at)? then obj_put(t, xs.at(i), Null, at)?
        SetSymmetric ->
            val ys = members(y)

            for i in 0..<xs.len()
                if !obj_has(y, xs.at(i), at)? then obj_put(t, xs.at(i), Null, at)?

            for i in 0..<ys.len()
                if !obj_has(x, ys.at(i), at)? then obj_put(t, ys.at(i), Null, at)?

    Ok(())
end fill_combined

// Whether every member of `x` is a member of `y`.
private contained(x: *ObjectObj, y: *ObjectObj, at: Span) -> Result[bool, Signal]
    val xs = members(x)

    for i in 0..<xs.len()
        if !obj_has(y, xs.at(i), at)? then return Ok(false)

    Ok(true)
end contained

// Whether the two share nothing at all.
private apart(x: *ObjectObj, y: *ObjectObj, at: Span) -> Result[bool, Signal]
    val xs = members(x)

    for i in 0..<xs.len()
        if obj_has(y, xs.at(i), at)? then return Ok(false)

    Ok(true)
end apart

// The two sets a call works over, or the complaint naming whichever side is not one.
private both_sets(args: Args, at: Span, name: string) -> Result[unit, Signal]
    takes_n(args, 2, at, name, "two sets")?
    set_of(args.at(0), at, name)?
    set_of(args.at(1), at, name)?
    Ok(())

// `union(a, b)`, `intersection(a, b)`, `difference(a, b)` and `symmetricDifference(a, b)` -- each a
// NEW set, leaving both of the sets it was given exactly as they were.
//
// **ECMAScript's names**, which slate takes wherever the choice is arbitrary: a reader who has met
// `Set.prototype.union` in JavaScript has met this one, and the alternative spellings (`plus`, `or`,
// `intersect`) would each be a word to learn for nothing.
do_set_union(args: Args, at: Span) -> Step
    both_sets(args, at, "union")?

    combined(set_of(args.at(0), at, "union")?, set_of(args.at(1), at, "union")?, SetUnion, at)

do_set_intersection(args: Args, at: Span) -> Step
    both_sets(args, at, "intersection")?

    combined(set_of(args.at(0), at, "intersection")?, set_of(args.at(1), at, "intersection")?, SetIntersection, at)

do_set_difference(args: Args, at: Span) -> Step
    both_sets(args, at, "difference")?

    combined(set_of(args.at(0), at, "difference")?, set_of(args.at(1), at, "difference")?, SetDifference, at)

do_set_symmetric_difference(args: Args, at: Span) -> Step
    both_sets(args, at, "symmetricDifference")?

    combined(set_of(args.at(0), at, "symmetricDifference")?, set_of(args.at(1), at, "symmetricDifference")?,
        SetSymmetric, at)

// `isSubsetOf(a, b)`, `isSupersetOf(a, b)` and `isDisjointFrom(a, b)` -- the three questions two sets
// answer with a boolean.
//
// **A set is a subset of itself**, which is what the mathematics says and what `⊆` means; `a < b`
// below is the strict reading for a program that wants the other one.
do_set_is_subset_of(args: Args, at: Span) -> Step
    both_sets(args, at, "isSubsetOf")?

    Ok(Bool(contained(set_of(args.at(0), at, "isSubsetOf")?, set_of(args.at(1), at, "isSubsetOf")?, at)?))

do_set_is_superset_of(args: Args, at: Span) -> Step
    both_sets(args, at, "isSupersetOf")?

    Ok(Bool(contained(set_of(args.at(1), at, "isSupersetOf")?, set_of(args.at(0), at, "isSupersetOf")?, at)?))

do_set_is_disjoint_from(args: Args, at: Span) -> Step
    both_sets(args, at, "isDisjointFrom")?

    Ok(Bool(apart(set_of(args.at(0), at, "isDisjointFrom")?, set_of(args.at(1), at, "isDisjointFrom")?, at)?))

// What an operator means where both of its operands are sets.
//
// **Python's spelling, and each one is a method above under another name** -- `|` a union, `&` an
// intersection, `-` a difference, `^` a symmetric difference, `<=` a subset and `<` a strict one. The
// operators are worth having beside the words because set algebra is the one place a program writes
// several of them in a line, where `a.union(b).difference(c)` is a sentence to unpick.
//
// **Both operands are HELD, the machine having popped them off the stack before an operator runs** --
// so nothing else names them while a key comparison runs a class's own `hash` and the collector takes
// its chance.
//
// Not `private`: `arith.sysl` tries this where neither the numbers nor the strings nor the calendar
// answered.
set_arith(op: Tok, a: Value, b: Value, at: Span) -> Option[Step]
    val x = a match
        SetVal(t) -> t
        _ -> return None

    val y = b match
        SetVal(t) -> t
        _ -> return None

    val mark = root_mark()

    hold(a)
    hold(b)

    val out = set_operator(op, x, y, at)

    release(mark)
    out
end set_arith

private set_operator(op: Tok, x: *ObjectObj, y: *ObjectObj, at: Span) -> Option[Step]
    op match
        Pipe -> Some(combined(x, y, SetUnion, at))
        Amp -> Some(combined(x, y, SetIntersection, at))
        Minus -> Some(combined(x, y, SetDifference, at))
        Caret -> Some(combined(x, y, SetSymmetric, at))
        LtEq -> Some(within(x, y, false, at))
        GtEq -> Some(within(y, x, false, at))
        Lt -> Some(within(x, y, true, at))
        Gt -> Some(within(y, x, true, at))
        _ -> None
end set_operator

// Whether `x` is contained in `y`, strictly where a program wrote `<` or `>`.
//
// **A strict containment is the plain one plus a smaller size**, which is exact rather than a
// shortcut: a set holds each member once, so a subset the same size as its superset is that
// superset.
private within(x: *ObjectObj, y: *ObjectObj, strict: bool, at: Span) -> Step
    if strict && live_count(x) >= live_count(y) then return Ok(Bool(false))

    Ok(Bool(contained(x, y, at)?))

// -- maps -----------------------------------------------------------------------------------------

// `Map()` and `Map(pairs)`.
do_map_new(args: Args, at: Span) -> Step
    if args.len() > 1
        return fault(at, s"`Map` takes nothing or a list of pairs, and was given ${counted(args.len(), "argument")}")

    val mark = root_mark()
    val made = MapVal(new_object())

    hold(made)

    val out = fill_map(made, args, at)

    release(mark)
    out
end do_map_new

private fill_map(made: Value, args: Args, at: Span) -> Step
    if args.len() == 1
        val each = walked_values(args.at(0), at, "`Map`", "takes")?
        val t = map_of(made, at, "Map")?

        for i in 0..<each.len()
            // **A pair is an array of exactly two, and anything else is named rather than
            // ignored.** JavaScript reads a one-element entry as a key with `undefined` beside it,
            // which slate has nowhere to put -- and a reader who wrote `Map([1])` meant a pair.
            val pair = each.at(i) match
                Array(a) ->
                    if a.items.len() != 2
                        return fault(at, s"`Map` reads a list of pairs, and one of these has ${counted(a.items.len(), "value")} rather than a key and a value")

                    a
                other -> return fault(at, s"`Map` reads a list of pairs, and one of these is ${other.type_name()}")

            keepable(pair.items.at(0), at, "a map key")?
            keepable(pair.items.at(1), at, "put in a map")?
            obj_put(t, pair.items.at(0), pair.items.at(1), at)?

    Ok(made)
end fill_map

// `set(m, k, v)` -- and the map back, so that writes chain.
do_map_set(args: Args, at: Span) -> Step
    takes_n(args, 3, at, "set", "a map, a key and a value")?

    val t = changing_map(args.at(0), at, "set")?

    keepable(args.at(1), at, "a map key")?
    keepable(args.at(2), at, "put in a map")?
    obj_put(t, args.at(1), args.at(2), at)?
    Ok(args.at(0))
end do_map_set

// `get(m, k)` -- what the key holds, or `null` where there is none.
//
// **`null` and not `undefined`**, which is slate's rule rather than a choice made here: absence
// stops at the boundary it arose at, so nothing hands one out. A program that has to tell a stored
// `null` from a missing key asks `has` first, which is what `has` is for.
do_map_get(args: Args, at: Span) -> Step
    takes_n(args, 2, at, "get", "a map and a key")?

    obj_get(map_of(args.at(0), at, "get")?, args.at(1), at)? match
        None -> Ok(Null)
        Some(v) -> Ok(v)

do_map_has(args: Args, at: Span) -> Step
    takes_n(args, 2, at, "has", "a map and a key")?

    Ok(Bool(obj_has(map_of(args.at(0), at, "has")?, args.at(1), at)?))

do_map_delete(args: Args, at: Span) -> Step
    takes_n(args, 2, at, "delete", "a map and a key")?

    Ok(Bool(obj_remove(changing_map(args.at(0), at, "delete")?, args.at(1), at)?))

do_map_clear(args: Args, at: Span) -> Step
    takes_n(args, 1, at, "clear", "a map")?

    empty_table(changing_map(args.at(0), at, "clear")?)
    Ok(Null)

do_map_size(args: Args, at: Span) -> Step
    takes_n(args, 1, at, "size", "a map")?

    Ok(Int(long(live_count(map_of(args.at(0), at, "size")?))))

do_map_keys(args: Args, at: Span) -> Step
    takes_n(args, 1, at, "keys", "a map")?

    val t = map_of(args.at(0), at, "keys")?

    var out: Buf[Value] = buf()

    for i in 0..<t.entries.len()
        val e = t.entries.at(i)

        if !e.dead then out.push(e.key)

    Ok(Array(new_array(out)))
end do_map_keys

do_map_values(args: Args, at: Span) -> Step
    takes_n(args, 1, at, "values", "a map")?

    val t = map_of(args.at(0), at, "values")?

    var out: Buf[Value] = buf()

    for i in 0..<t.entries.len()
        val e = t.entries.at(i)

        if !e.dead then out.push(e.value)

    Ok(Array(new_array(out)))
end do_map_values

// `entries(m)` -- the pairs, which is what walking a map gives and what `Map` reads back.
do_map_entries(args: Args, at: Span) -> Step
    takes_n(args, 1, at, "entries", "a map")?

    Ok(Array(new_array(walked_values(args.at(0), at, "`entries`", "takes")?)))

// `forEach(m, f)` -- the function on every pair, as `for (k, v) in m` unpacks one.
do_map_for_each(args: Args, at: Span) -> Step
    takes_n(args, 2, at, "forEach", "a map and a function")?

    val each = walked_values(args.at(0), at, "`forEach`", "takes")?

    for i in 0..<each.len()
        call_one(args.at(1), each.at(i), at, "forEach")?

    Ok(Null)
end do_map_for_each

// -- what this file registers ---------------------------------------------------------------------

// **Each kind has its own natives rather than sharing an array's**, and the reason is the checker
// rather than the machine. `methods_of` is one table for both, and the signature a name carries is
// looked up by the native it maps to -- so a `forEach` shared with an array would describe a set's
// call in an array's terms and complain about a program that runs.
//
// **Only the two constructors are declared, and everything else is a method.** `s.add(v)`,
// `m.set(k, v)` -- because the names are ones a program uses for its own functions all the time: a
// global `add`, `get`, `set`, `delete` or `size` would take five ordinary words out of every
// program's vocabulary in exchange for a spelling nobody wants. That is the opposite of the array
// family, whose names (`map`, `filter`, `push`) were already slate's and read as well either way.
//
// **So a method-only native is registered under a QUALIFIED name** -- `Set.has` is not `has`, the
// global one taking an object -- the registry being keyed by name.
var n_set_new: NativeFn = 0
var n_set_add: NativeFn = 0
var n_set_has: NativeFn = 0
var n_set_delete: NativeFn = 0
var n_set_clear: NativeFn = 0
var n_set_size: NativeFn = 0
var n_set_values: NativeFn = 0
var n_set_for_each: NativeFn = 0
var n_set_union: NativeFn = 0
var n_set_intersection: NativeFn = 0
var n_set_difference: NativeFn = 0
var n_set_symmetric_difference: NativeFn = 0
var n_set_is_subset_of: NativeFn = 0
var n_set_is_superset_of: NativeFn = 0
var n_set_is_disjoint_from: NativeFn = 0

var n_map_new: NativeFn = 0
var n_map_set: NativeFn = 0
var n_map_get: NativeFn = 0
var n_map_has: NativeFn = 0
var n_map_delete: NativeFn = 0
var n_map_clear: NativeFn = 0
var n_map_size: NativeFn = 0
var n_map_keys: NativeFn = 0
var n_map_values: NativeFn = 0
var n_map_entries: NativeFn = 0
var n_map_for_each: NativeFn = 0

install_setmap(env: *EnvObj)
    n_set_new = register("Set", do_set_new)
    n_set_add = register("Set.add", do_set_add)
    n_set_has = register("Set.has", do_set_has)
    n_set_delete = register("Set.delete", do_set_delete)
    n_set_clear = register("Set.clear", do_set_clear)
    n_set_size = register("Set.size", do_set_size)
    n_set_values = register("Set.values", do_set_values)
    n_set_for_each = register("Set.forEach", do_set_for_each)
    n_set_union = register("Set.union", do_set_union)
    n_set_intersection = register("Set.intersection", do_set_intersection)
    n_set_difference = register("Set.difference", do_set_difference)
    n_set_symmetric_difference = register("Set.symmetricDifference", do_set_symmetric_difference)
    n_set_is_subset_of = register("Set.isSubsetOf", do_set_is_subset_of)
    n_set_is_superset_of = register("Set.isSupersetOf", do_set_is_superset_of)
    n_set_is_disjoint_from = register("Set.isDisjointFrom", do_set_is_disjoint_from)

    n_map_new = register("Map", do_map_new)
    n_map_set = register("Map.set", do_map_set)
    n_map_get = register("Map.get", do_map_get)
    n_map_has = register("Map.has", do_map_has)
    n_map_delete = register("Map.delete", do_map_delete)
    n_map_clear = register("Map.clear", do_map_clear)
    n_map_size = register("Map.size", do_map_size)
    n_map_keys = register("Map.keys", do_map_keys)
    n_map_values = register("Map.values", do_map_values)
    n_map_entries = register("Map.entries", do_map_entries)
    n_map_for_each = register("Map.forEach", do_map_for_each)

    declare(env, "Set", Native(n_set_new), false)
    declare(env, "Map", Native(n_map_new), false)
end install_setmap
