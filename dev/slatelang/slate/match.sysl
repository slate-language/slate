module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// Testing a value against a PATTERN at run time, and binding what the pattern names.
//
// **Cut out of `index.sysl` when that file passed a thousand lines**, and the seam is what the
// operation is given: everything left there is handed a container and an index -- a range, a field,
// a property, an argument list -- and everything here is handed a `Pattern` and a `Value` and
// answers whether the two fit. `pattern.sysl` is the other end of the same word: it is the PARSER's
// pattern, this is the matcher's.
//
// **One name crosses**, `MaxProtoDepth`, which `match_proto` reads for the same reason a field
// lookup does: a `proto` is an ordinary field and a program can make one point at itself.
//
// **A failure needs a sentence only where there is no next arm to try**, which is why
// `unpack_complaint` is here rather than beside the arms: a `match` moves on and a destructuring
// binding has to say what did not fit.

// What to say when a destructuring binding does not fit.
//
// **A `match` arm that does not fit needs no sentence and a binding does**, there being no next arm
// to try -- so this is the one place a pattern's failure has to be explained. `write_pattern`'s
// s-expression form is for reading a parse and would send the reader to the wrong thing here; what
// they need is which of the two halves is wrong, so each arm names the shape it wanted and the
// thing that arrived.
unpack_complaint(pat: Pattern, v: Value) -> string
    *pat.kind match
        ArrayPat(items, open, _, defaults) ->
            v match
                Array(a) ->
                    // **What the binding needs is the elements with no default**, so a complaint about
                    // `[a, b = 2]` given `[]` says one and not two.
                    val needs = items.len() - trailing_defaults(defaults)
                    val least = if open || needs != items.len() then "at least " else ""

                    if a.items.len() >= needs && a.items.len() <= items.len()
                        return "this array has the right number of elements, and one of them does not fit the binding"

                    s"this binding takes ${least}${needs} ${if needs == 1 then "element" else "elements"} out of an array, and this one has ${a.items.len()}"
                other -> s"this binding takes an array apart, and this is ${other.type_name()}"
        ObjectPat(keys, _, defaults, optional) ->
            v match
                Object(o) ->
                    for i in 0..<keys.len()
                        if defaults.at(i).is_some() then continue

                        if obj_get_name(o, keys.at(i)).is_none()
                            return s"this object has no field called `${keys.at(i)}`, which this binding takes out of it"

                    "every field this binding names is there, and one of them does not fit"
                other -> s"this binding takes an object apart, and this is ${other.type_name()}"
        _ -> s"this value does not fit the binding -- it is ${show_value(v)}"
end unpack_complaint

// Whether a pattern matches a value, binding its names into `scope` as it goes.
//
// **`assignable` is what a destructuring `var` needs and nothing else uses.** A name a `match` arm
// or an `is` introduces is a `val` -- it is the arm's reading of the subject and there is nothing to
// write it back to -- so every caller but `Unpack` passes false.
//
// **It answers a bare `bool` rather than a `Step`, and that is deliberate**: nothing a pattern does
// can fail at runtime. There is no arithmetic in one, no call, and no index that could be out of
// range -- a pattern that does not fit simply does not fit, which is an answer and not a fault.
match_pattern(pat: Pattern, v: Value, scope: *EnvObj, assignable: bool) -> bool =
    match_walk(pat, v, scope, assignable, false)

// The same walk, gathering what it bound onto the OPERAND STACK instead of into a scope.
//
// **`collecting` is what a chunk whose names are numbered slots needs**, there being no scope to
// declare into: the machine takes the values back off the stack and writes them into the slots the
// compiler claimed. The values go on the stack rather than into a list of sysl's own because the
// stack is a root the collector already walks -- a `rest` pattern builds an array, and one held only
// by a sysl local would be invisible to a mark that happened while the match was still running.
//
// **The ORDER is `pattern_names`' order, which is what the compiler claimed its slots in.** There is
// exactly one place the two could disagree and it is `At`: the binding walk below runs the
// sub-pattern first and declares the name after it, deliberately, so a failed arm leaves nothing
// bound -- while `pattern_names` writes the name first. Into a scope that difference is invisible,
// a scope having no order; into a flat list it is a silent mis-binding. So a collecting walk pushes
// `At`'s name BEFORE matching the inner pattern, which is safe for exactly the reason the other
// order was chosen: a failed match has its whole list discarded, so nothing is left half-bound
// either way.
//
// Not `private`: `run_frames.sysl` is the only caller that collects.
match_walk(pat: Pattern, v: Value, scope: *EnvObj, assignable: bool, collecting: bool) -> bool
    *pat.kind match
        Wild -> true
        Bind(name) ->
            // Bound as a `val`: a name a pattern introduced is not a place to write to.
            if collecting then vm.stack.push(v) else declare(scope, name, v, assignable)

            true
        TypePat(test) -> is_kind(v, test)
        At(name, inner) ->
            // **The sub-pattern runs first, and the whole value is bound only if it took.** The
            // other order would leave the name bound after a failed arm -- which the arm's own
            // scope would throw away anyway, but only by accident rather than by rule.
            if collecting
                vm.stack.push(v)
                return match_walk(inner, v, scope, assignable, true)
            end if

            if !match_walk(inner, v, scope, assignable, false) then return false

            declare(scope, name, v, assignable)
            true
        IntPat(want) -> same_literal(v, Int(want))
        RealPat(want) -> same_literal(v, Real(want))
        StrPat(want) -> v match
            // Compared against the sysl `string` directly, so a pattern never boxes one onto the
            // collected heap just to throw it away.
            Str(p) -> p.s == want
            _ -> false
        BoolPat(want) -> same_literal(v, Bool(want))
        NullPat -> v match
            Null -> true
            _ -> false
        RangePat(lo, hi, inclusive, step) -> in_range(lo, hi, inclusive, step, v)
        ArrayPat(items, open, rest, defaults) -> match_array(items, open, rest, defaults, v, scope, assignable, collecting)
        ObjectPat(keys, values, defaults, optional) -> match_object(keys, values, defaults, optional, v, scope, assignable, collecting)
        OrPat(alts) ->
            for i in 0..<alts.len()
                if match_walk(alts.at(i), v, scope, assignable, collecting) then return true

            false

        // **Every part, and a part that fails stops the walk** -- so a part to the right of a
        // failure never binds. What the parts to its LEFT bound stays bound, which is what a
        // half-matched object pattern already does and what a `match` arm is written around: an
        // arm that did not match does not run.
        AndPat(parts) ->
            for i in 0..<parts.len()
                if !match_walk(parts.at(i), v, scope, assignable, collecting) then return false

            true

        // **Identity, walked up the chain** -- which is what makes this worth having over the
        // `p.proto == Point` a program could already write. `==` on objects is *structural* here, so
        // it answers true for a different class that happens to hold the same fields, and it looks
        // only one link up. This asks the question a reader means by `is`: was this object made from
        // that class, or from something descended from it.
        //
        // **A class that is not in scope is a value this pattern does not match**, rather than a
        // fault: nothing a pattern does may fail, which is what lets `match` try an arm and move on.
        ProtoPat(name, _, _) -> match_proto(name, v, scope)

        // **The nominal half and the field half, and the field half is an ordinary object pattern.**
        // Nothing here knows about shorthand or defaults or nesting, because `match_pattern` on the
        // inner pattern already does all three.
        MadeFrom(name, inner) ->
            if !match_proto(name, v, scope) then return false

            match_walk(inner, v, scope, assignable, collecting)

        // A data type asks exactly what a class does: was this made from that, or from something
        // descended from it. The variant list it carries is the checker's and nothing runs on it.
        DataPat(name, _) -> match_proto(name, v, scope)
        VariantPat(name, items, keys, singleton) -> match_variant(name, items, keys, singleton, v, scope, assignable, collecting)

        // **Every element, and an EMPTY container fits.** Every element of nothing is a string,
        // which is the reading a test wants: a shape refusing `[]` would refuse the ordinary answer
        // to a query that found nothing. A floor is said with the fixed prefix -- `[string, ...]`.
        //
        // An object's VALUES are what is walked. Its keys are the program's, so a shape saying
        // anything about them would be a different feature.
        // **Callable, and a call of this size one it would take.** A function's parameter TYPES are
        // not a question about the value in front of us -- they are a question about every call that
        // will ever be made through it -- so they are the checker's and this asks what it can. The
        // count is knowable: a closure carries its own, and the machine faults on a call that misses
        // it, which is what makes refusing it here the same answer one statement earlier.
        //
        // **A native takes any count as far as this can see.** Its parameters are sysl's and it
        // carries none, so the test is callability alone rather than a guess.
        // **A TYPE PARAMETER MATCHES ANYTHING, WHICH IS WHAT ERASURE MEANS HERE.** `T` says the
        // answer is whatever the argument was; nothing about a value in front of us could confirm or
        // deny that, so the run-time test is the one `any` makes and the claim is the checker's.
        TypeVarPat(_) -> true

        // **Neither of these survives `resolve_pattern`** -- a use of a generic type is substituted
        // and a declaration is what gets substituted INTO -- so reaching one means a pattern was
        // matched without being resolved. Matching anything is the safe answer: a pattern may not
        // fault, and refusing everything would silently take an arm nobody wrote.
        GenericPat(_, _) -> true
        AppliedPat(_, _) -> true
        FnPat(params, _) -> v match
            Fn(c) ->
                val chunk = current_unit.chunks.at(c.body)

                // **Only the FLOOR, because only the floor is a limit.** A call giving more than the
                // function declares drops the surplus rather than faulting, so a one-parameter
                // function does take a call of three -- and answering no here would refuse an arm
                // over a call the machine makes.
                params.len() >= chunk.required
            Native(_) -> true
            _ -> false
        EveryPat(container, element) -> v match
            Array(xs) ->
                if container != IsArray then return false

                for i in 0..<xs.items.len()
                    if !match_walk(element, xs.items.at(i), scope, assignable, collecting) then return false

                true
            Object(o) ->
                if container != IsObject then return false

                for i in 0..<o.entries.len()
                    if !o.entries.at(i).dead && !match_walk(element, o.entries.at(i).value, scope, assignable, collecting) then return false

                true
            _ -> false

        // **A set's members and a map's keys AND values are each tested**, which is what makes
        // `Map[string, integer]` a claim the machine checks rather than a note to the checker. An
        // empty one fits, as an empty `array of T` does and for its reason.
        HoldsPat(container, key, value) -> v match
            SetVal(t) ->
                if container != IsSet then return false

                for i in 0..<t.entries.len()
                    if !t.entries.at(i).dead && !match_walk(key, t.entries.at(i).key, scope, assignable, collecting) then return false

                true
            MapVal(t) ->
                if container != IsMap then return false

                for i in 0..<t.entries.len()
                    val e = t.entries.at(i)

                    if !e.dead
                        if !match_walk(key, e.key, scope, assignable, collecting) then return false
                        if !match_walk(value, e.value, scope, assignable, collecting) then return false

                true
            _ -> false
end match_walk

// Whether a number lies between a range's ends.
//
// **A range whose bounds are whole takes whole numbers only**, which is the rule `range_whole` states
// and both back ends read from there: `1..65535` is written by somebody describing a port, and a real
// in that span is not a port. A bound written with a point widens the whole range to any number.
private in_range(lo: Option[Pattern], hi: Option[Pattern], inclusive: bool, step: Option[Pattern], v: Value) -> bool
    if range_whole(lo, hi)
        val n = v match
            Int(i) -> i
            _ -> return false

        lo match
            Some(b) -> if n < bound_long(b) then return false
            None -> ()

        // **A STEP IS A SECOND TEST AND NOT A NARROWER SPAN**: the number has to be inside the ends
        // *and* on the step, counted from whichever end the step walks away from. The parser has
        // already refused a step with no end to count from, so the anchor is always there.
        step match
            Some(b) ->
                val k = bound_long(b)

                // A downward step counts from the top, and an exclusive top is not itself a number
                // the range covers -- so the first one under it is what the count starts at.
                val from = if k > 0
                    lo match
                        Some(a) -> Some(bound_long(a))
                        None -> None
                else
                    hi match
                        Some(a) -> Some(if inclusive then bound_long(a) else bound_long(a) - 1)
                        None -> None

                from match
                    Some(a) -> if (n - a) % k != 0 then return false
                    None -> ()
            None -> ()

        hi match
            Some(b) -> if inclusive then n <= bound_long(b) else n < bound_long(b)
            None -> true
    else
        val x = v match
            Int(i) -> real(i)
            Real(r) -> r
            _ -> return false

        lo match
            Some(b) -> if x < bound_real(b) then return false
            None -> ()

        hi match
            Some(b) -> if inclusive then x <= bound_real(b) else x < bound_real(b)
            None -> true
end in_range

// Push one placeholder per name this pattern would have bound, for a collecting walk that skipped it.
//
// **Counted with `pattern_names` rather than assumed to be one.** A default may only be written on a
// bare binding today, so the answer is always one -- and a rule that quietly depends on that is a
// rule that breaks when the parser widens.
private hold_places(pat: Pattern)
    var names: Buf[string] = buf()

    pattern_names(pat, &names)

    for _ in 0..<names.len()
        vm.stack.push(Undefined)

// Whether `v` is the variant `name` names, and whether what it carries fits.
//
// **A variant that declared no fields is a VALUE, so the test is identity with that one object** --
// `Empty` is the singleton itself rather than something made from a maker, and a walk up its chain
// would ask about the data type instead. Everything else is the class question plus the fields, read
// by the names the declaration gave them and in the order it gave them.
private match_variant(name: string, items: Buf[Pattern], keys: Buf[string], singleton: bool, v: Value, scope: *EnvObj, assignable: bool, collecting: bool) -> bool
    if singleton
        val want: *u8 = lookup(scope, name) match
            Some(Object(o)) -> ptr_cast(o)
            _ -> return false

        val here: *u8 = v match
            Object(o) -> ptr_cast(o)
            _ -> return false

        return here == want
    end if

    if !match_proto(name, v, scope) then return false

    // A bare `Circle` tests and takes nothing apart, which is what an annotation and an `is` write.
    if items.len() == 0 then return true

    // **A pattern that was never resolved matches nothing rather than reading past its own list.**
    // `resolve_pattern` fills the names in and complains where it cannot, so reaching here with the
    // two out of step means the program is already refused.
    if items.len() != keys.len() then return false

    val o = v match
        Object(p) -> p
        _ -> return false

    for i in 0..<items.len()
        val got = obj_get_name(o, keys.at(i)) match
            Some(x) -> x
            None -> return false

        if !match_walk(items.at(i), got, scope, assignable, collecting) then return false

    true
end match_variant

// Whether `v` was made from the class `name` names, or from one descended from it.
private match_proto(name: string, v: Value, scope: *EnvObj) -> bool
    val want: *u8 = lookup(scope, name) match
        Some(Object(c)) -> ptr_cast(c)
        _ -> return false

    var up = v match
        Object(o) -> o
        _ -> return false

    var depth: usize = 0

    loop
        val next = obj_get_name(up, "proto") match
            Some(Object(p)) -> p
            _ -> return false

        val here: *u8 = ptr_cast(next)

        if here == want then return true

        depth += 1

        // The same ceiling `field_from` walks to, and for the same reason: a `proto` is an ordinary
        // field, so a chain may be a circle. There is nowhere to report from inside a pattern, so a
        // circle simply does not match.
        if depth >= MaxProtoDepth then return false

        up = next
end match_proto

// `[a, b]` and `[first, ...rest]`.
private match_array(items: Buf[Pattern], open: bool, rest: Option[string], defaults: Buf[Option[Expr]], v: Value, scope: *EnvObj, assignable: bool, collecting: bool) -> bool
    v match
        Array(xs) ->
            // A closed pattern must agree on length exactly; an open one treats the fixed patterns
            // as a floor.
            val fixed = items.len()

            // **A defaulted element is optional, so the floor is the elements WITHOUT one.** They are
            // all at the end, which the parser has already seen to.
            val least = fixed - trailing_defaults(defaults)

            if open
                if xs.items.len() < least then return false
            else
                if xs.items.len() < least || xs.items.len() > fixed then return false

            // **An element the array did not reach is left UNBOUND rather than matched**, and the
            // instruction that follows the unpack is what gives it its default. That keeps the
            // matcher infallible and keeps the default an expression worked out where the binding is.
            val taken = if xs.items.len() < fixed then xs.items.len() else fixed

            for i in 0..<taken
                if !match_walk(items.at(i), xs.items.at(i), scope, assignable, collecting) then return false

            // **An element the array did not reach still takes its POSITION when collecting**, or
            // every binding after it would land in the cell before its own. The placeholder never
            // leaves the stack: the machine skips it, leaves that cell alone, and records a zero
            // bit for it, which is what the default that follows is guarded by.
            if collecting
                for i in taken..<fixed
                    hold_places(items.at(i))

            // The tail is only gathered where it is named. `[a, ...]` allocates nothing.
            rest match
                Some(name) ->
                    var tail: Buf[Value] = buf()

                    for i in taken..<xs.items.len()
                        tail.push(xs.items.at(i))

                    val gathered = Array(new_array(tail))

                    if collecting then vm.stack.push(gathered) else declare(scope, name, gathered, assignable)
                None -> ()

            true
        _ -> false
end match_array

// How many of the last entries carry a default, the parser having made sure they are the last ones.
private trailing_defaults(defaults: Buf[Option[Expr]]) -> usize
    var n: usize = 0

    for i in 0..<defaults.len()
        if defaults.at(i).is_some() then n += 1

    n

// `{ name: n }`.
//
// **An object pattern matches an object with *at least* these fields.** A record grows fields over
// its life, so a pattern that broke whenever one was added would be a pattern nobody could keep
// working -- and a program that wants exactness can ask `keys(o).length`.
//
// **A FIELD A PROTO SUPPLIES COUNTS, because a pattern asks the question `.` answers.** `o.draw`
// walks the chain, so a pattern that read only own fields disagreed with the very expression a
// program writes after matching -- and every subclass failed the interface its base implements, which
// is what `type Drawable = { draw: function }` is for. JavaScript splits the same seam and puts `in`
// on this side of it; `hasOwnProperty` is the other question, and slate has never had syntax for it.
private match_object(keys: Buf[string], values: Buf[Pattern], defaults: Buf[Option[Expr]], optional: Buf[bool], v: Value, scope: *EnvObj, assignable: bool, collecting: bool) -> bool
    v match
        Object(fields) ->
            for i in 0..<keys.len()
                field_through(fields, keys.at(i)) match
                    // **A field with a default or a `?` is optional and is left UNBOUND.** Where it
                    // was a default, the instruction after the unpack is what gives it its value;
                    // where it was a `?`, nothing does and nothing is meant to. A field with
                    // neither is still the fault it always was.
                    None ->
                        if defaults.at(i).is_none() && !optional.at(i) then return false

                        if collecting then hold_places(values.at(i))
                    Some(field) -> if !match_walk(values.at(i), field, scope, assignable, collecting) then return false

            true
        _ -> false
end match_object

// Whether a value is of a kind.
//
// **`num` is the only one that is not a single variant**, being the union of `int` and `real` --
// which is what a pattern guarding arithmetic wants, and is why it is in the list at all.
private is_kind(v: Value, test: TypeTest) -> bool
    test match
        IsNull -> v match
            Null -> true
            _ -> false
        IsBool -> v match
            Bool(_) -> true
            _ -> false
        IsInt -> v match
            Int(_) -> true
            _ -> false
        IsReal -> v match
            Real(_) -> true
            _ -> false
        IsNum -> v match
            Int(_) -> true
            Real(_) -> true
            _ -> false
        IsStr -> v match
            Str(_) -> true
            _ -> false
        IsArray -> v match
            Array(_) -> true
            _ -> false
        IsObject -> v match
            Object(_) -> true
            _ -> false
        IsFn -> v match
            Fn(_) -> true
            Native(_) -> true
            _ -> false
        IsInstant -> v match
            InstantVal(_) -> true
            _ -> false
        IsDuration -> v match
            DurationVal(_) -> true
            _ -> false
        IsDate -> v match
            DateVal(_) -> true
            _ -> false
        IsTime -> v match
            TimeVal(_) -> true
            _ -> false
        IsDateTime -> v match
            DateTimeVal(_, _) -> true
            _ -> false
        IsZone -> v match
            ZoneVal(_) -> true
            _ -> false
        IsZoned -> v match
            ZonedVal(_, _) -> true
            _ -> false
        IsPeriod -> v match
            PeriodVal(_, _) -> true
            _ -> false
        IsGen -> v match
            Gen(_, _) -> true
            _ -> false
        IsPromise -> v match
            Promise(_) -> true
            _ -> false
        IsRegex -> v match
            RegexVal(_) -> true
            _ -> false
        IsExternal -> v match
            External(_) -> true
            _ -> false
        IsSet -> v match
            SetVal(_) -> true
            _ -> false
        IsMap -> v match
            MapVal(_) -> true
            _ -> false
        // **A CLASS OR A DATA NAME IS ONE TOO**, carrying its own shape under the hidden tag -- so a
        // parameter annotated `shape` takes all three declarations, which is the whole use a shape
        // value has. Without this the annotation would refuse the very names the types page calls
        // type expressions, and a program handing its failure type to a framework would be back to
        // declaring `type Fail = Failure` to get past the check.
        IsShape -> v match
            Shape(_) -> true
            Object(o) -> obj_get_name(o, ShapeTag) match
                Some(Shape(_)) -> true
                _ -> false
            _ -> false
end is_kind
