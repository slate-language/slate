module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// What a table costs in storage, which is a different subject from what it answers.
//
// **`tests_setmap.sysl` pins the key rules and this pins the layout.** A table's answers -- which
// values are one key, what order they come back in, what a class's `==` and `hash` decide -- are
// written there against slate programs. What is written here can only be asked in sysl: how many
// bytes a table took to hold what it holds, and whether it built an index at all.
//
// **A benchmark cannot say why it got faster and these can.** The small-table path is invisible to
// every program -- the same answers in the same order -- so a wall-clock figure is the only other
// evidence there is, and a wall-clock figure moves with the machine.

// How many slots a table's index has. Zero means it has none and a lookup walks the entries.
private index_slots(o: *ObjectObj) -> usize = o.index.cap()

@test
A_TABLE_UNDER_NINE_ENTRIES_HOLDS_NO_INDEX_AT_ALL()
    reset_vm()
    reset_heap()
    collect_now()

    val o = new_object()

    assert_eq(index_slots(o), 0usize, "a table is built with no index")

    // **Eight is `SmallTable` and the ninth entry is what builds one.** The number is a
    // measurement rather than a law -- `bench/README.md` has it -- so a build that moves it moves
    // this test with it, on purpose: the point of the number being written down twice is that
    // somebody has to look.
    for i in 0..<8
        obj_put_name(o, "k" + str(i), Int(long(i)))
        assert_eq(index_slots(o), 0usize, s"and still none at ${str(i + 1)} entries")

    obj_put_name(o, "k8", Int(8))
    assert(index_slots(o) > 0, "the ninth entry is what builds an index")

    // Every key is still there, and in the order it was written.
    for i in 0..<9
        obj_get_name(o, "k" + str(i)) match
            Some(Int(n)) -> assert_eq(n, long(i), s"k${str(i)} still answers")
            _ -> assert(false, s"k${str(i)} is gone")

    assert_eq(obj_keys(o).len(), 9usize, "with nothing added and nothing lost")
end A_TABLE_UNDER_NINE_ENTRIES_HOLDS_NO_INDEX_AT_ALL

@test
A_TABLE_THAT_SHRINKS_BACK_UNDER_THE_LINE_GIVES_ITS_INDEX_UP()
    reset_vm()
    reset_heap()
    collect_now()

    val o = new_object()
    val nowhere = Span(0, 0)

    for i in 0..<20
        obj_put(o, Int(long(i)), Int(long(i * i)), nowhere) match
            Ok(_) -> ()
            Err(_) -> assert(false, "an integer key goes in")

    assert(index_slots(o) > 0, "twenty entries have an index")

    for i in 0..<18
        obj_remove(o, Int(long(i)), nowhere) match
            Ok(gone) -> assert(gone, s"${str(i)} was there to remove")
            Err(_) -> assert(false, "removing an integer key answers")

    // **A REMOVAL LEAVES A TOMBSTONE AND TAKES NOTHING BACK, so deleting alone never gives an index
    // up** -- the entries are as long as they ever were and the table is a third full, which is
    // nowhere near the line a regrow is asked at. That is the pre-existing growth policy and this
    // says so rather than wishing otherwise.
    assert(index_slots(o) > 0, "eighteen tombstones do not give the index up by themselves")

    // **What gives it up is the next GROWTH**, which compacts the tombstones away and finds two
    // live entries where it expected a full table. Writing and removing a key each round is what
    // drives the entries over the line without the live count moving.
    var rounds: usize = 0

    while rounds < 200 && index_slots(o) > 0
        val k = Int(long(100 + rounds))

        obj_put(o, k, Int(0), nowhere) match
            Ok(_) -> ()
            Err(_) -> assert(false, "a fresh key goes in")

        obj_remove(o, k, nowhere) match
            Ok(_) -> ()
            Err(_) -> assert(false, "and comes straight back out")

        rounds += 1

    assert_eq(index_slots(o), 0usize, s"a table left with two live entries keeps no index, after ${str(rounds)} rounds")
    assert_eq(o.live, 2usize, "and it is holding the two that were never removed")

    obj_get(o, Int(18), nowhere) match
        Ok(Some(Int(n))) -> assert_eq(n, 324, "what survived is still found")
        _ -> assert(false, "18 is still there")

    obj_get(o, Int(0), nowhere) match
        Ok(None) -> ()
        _ -> assert(false, "and what was removed is not")
end A_TABLE_THAT_SHRINKS_BACK_UNDER_THE_LINE_GIVES_ITS_INDEX_UP

@test
A_HUNDRED_THOUSAND_INTEGER_KEYS_COST_A_SMALL_CONSTANT_EACH()
    reset_vm()
    reset_heap()
    collect_now()

    val start = current().payload
    val o = new_object()
    val nowhere = Span(0, 0)
    val n: usize = 100000

    for i in 0..<n
        obj_put(o, Int(long(i)), Int(long(i)), nowhere) match
            Ok(_) -> ()
            Err(_) -> assert(false, "an integer key goes in")

    val per = (current().payload - start) / n

    // **A COMPACT DICT COSTS ONE ENTRY AND ONE INDEX SLOT PER KEY, and both buffers double**, so
    // the ceiling is twice each. The bound is what would fail if an allocation crept back in per
    // insertion -- an index rebuilt as the table grew rather than doubled, or a per-entry array of
    // any kind. It is deliberately loose about the constant and tight about its SHAPE.
    val ceiling = 2 * sizeof(Entry) + 4 * sizeof(usize)

    assert(per <= ceiling, s"a hundred thousand integer keys cost ${str(per)} bytes each, against a ceiling of ${str(ceiling)}")
    assert(per >= sizeof(Entry), s"and at least the entry itself, which was ${str(per)}")

    // The accounting has to come back exactly, which is what says `grow`'s early return recharges
    // like its long way round does.
    assert_eq(obj_keys(o).len(), n, "every key is there")
    collect_now()
    assert_eq(current().payload, start, "and a collection puts every byte of it back")
end A_HUNDRED_THOUSAND_INTEGER_KEYS_COST_A_SMALL_CONSTANT_EACH

@test
EVERY_KEY_IS_FOUND_ON_BOTH_SIDES_OF_THE_LINE_AN_INDEX_IS_BUILT_AT()
    reset_vm()
    reset_heap()
    collect_now()

    val nowhere = Span(0, 0)

    // **A table is filled one entry at a time and asked about EVERY key it holds at every size**,
    // which is what catches a scan and a probe disagreeing at the boundary rather than in the
    // middle. A single check after the fill would pass against a build that lost a key at the
    // moment the index was made.
    for size in 1usize..<24
        val o = new_object()

        for i in 0..<size
            obj_put(o, Int(long(i)), Int(long(i * 7)), nowhere) match
                Ok(_) -> ()
                Err(_) -> assert(false, "an integer key goes in")

        for i in 0..<size
            obj_get(o, Int(long(i)), nowhere) match
                Ok(Some(Int(v))) -> assert_eq(v, long(i * 7), s"key ${str(i)} of ${str(size)}")
                _ -> assert(false, s"key ${str(i)} of ${str(size)} is gone")

        obj_get(o, Int(long(size)), nowhere) match
            Ok(None) -> ()
            _ -> assert(false, s"a key never written is not there at ${str(size)}")

        val keys = obj_keys(o)

        assert_eq(keys.len(), size, s"${str(size)} keys came back")

        // The order is the order they went in, whichever side of the line the table is on.
        for i in 0..<size
            keys.at(i) match
                Int(v) -> assert_eq(v, long(i), s"key ${str(i)} of ${str(size)} is in its place")
                _ -> assert(false, "a key came back as something else")
end EVERY_KEY_IS_FOUND_ON_BOTH_SIDES_OF_THE_LINE_AN_INDEX_IS_BUILT_AT

@test
A_NAMED_FIELD_IS_FOUND_ON_BOTH_SIDES_OF_THE_LINE_TOO()
    reset_vm()
    reset_heap()
    collect_now()

    // `obj_get_name` is the path a field read takes, and it does not hash the name at all while
    // the table is small -- so it is a second implementation of the same question and is walked
    // across the same boundary.
    for size in 1usize..<24
        val o = new_object()

        for i in 0..<size
            obj_put_name(o, "field" + str(i), Int(long(i * 3)))

        for i in 0..<size
            obj_get_name(o, "field" + str(i)) match
                Some(Int(v)) -> assert_eq(v, long(i * 3), s"field${str(i)} of ${str(size)}")
                _ -> assert(false, s"field${str(i)} of ${str(size)} is gone")

        obj_get_name(o, "fieldnope") match
            None -> ()
            Some(_) -> assert(false, "a field never written is not there")

        // Re-writing a field keeps its place, which is the rule the whole layout exists for.
        obj_put_name(o, "field0", Int(999))
        assert_eq(obj_keys(o).len(), size, s"re-writing adds nothing at ${str(size)}")

        obj_get_name(o, "field0") match
            Some(Int(v)) -> assert_eq(v, 999, "and the new value is what it holds")
            _ -> assert(false, "field0 is gone")
end A_NAMED_FIELD_IS_FOUND_ON_BOTH_SIDES_OF_THE_LINE_TOO
