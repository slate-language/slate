module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.fs.{read_bytes, remove_file, write_text}
import sysl.process.capture
import sysl.text.{Search, from_utf8_unchecked, str_builder}

// The emitted PROGRAM, rather than the statement a form compiles to.
//
// **Cut out of `tests_js.sysl` when that file passed a thousand lines**, on the heading that was
// already there. What stays there is the back end's translation of one form at a time -- a value,
// an operator, a statement, a definition, the line table -- and what is here is everything that is
// only true of a whole program: several files becoming several functions, the annotations a
// running program checks, the runtime and the scope wrapped round it, what `slate js` prints, and
// what the result does to the host it is dropped into.
//
// `probed` is `private` and stays so: it moved with the three tests that use it, and nothing
// outside this file says the name.

// -- a program of several files --------------------------------------------------------------------

@test
a_module_is_a_function_answering_its_exports_and_an_import_takes_a_field_out_of_it()
    // **The whole of a two-file program**, since what is worth pinning is the shape rather than any
    // one line of it: a module ahead of the file that imports it, its exports collected into the
    // object it answers, and the import a field taken out of that object.
    assert_eq(js_modules("tests/js/mods/two.sl"), """
            $.files(["tests/js/mods/two.sl", "tests/js/mods/lib.sl"]);

            const $m1 = (() => {
                $.at(0, 1);
                const $exports = $.obj([]);

                $.at(7, 1);
                const greeting = "hello";
                $.at(9, 1);
                function double(x) {
                    let $t1;
                    $.at(9, 1);
                    $t1 = $.arith("*", x, 2n);
                    return $t1;
                }
                $.sig(double, ["x"], 1, "double");
                $.at(11, 1);
                const Point = $.shape(["obj", ["x", "y"], [["t", "number"], ["t", "number"]], [false, false]], "Point");
                $.at(15, 1);
                function quiet() {
                    let $t2;
                    $.at(15, 1);
                    $t2 = "unseen";
                    return $t2;
                }
                $.sig(quiet, [], 0, "quiet");
                $exports.setName("greeting", greeting);
                $exports.setName("double", double);
                $exports.setName("Point", Point);

                return $exports;
            })();

            const $m0 = (() => {
                $.at(0, 0);
                const $exports = $.obj([]);

                $.at(1, 0);
                const double = $.field($m1, "double");
                const hi = $.field($m1, "greeting");
                const Point = $.field($m1, "Point");
                $.at(3, 0);
                $.call(print, [hi]);
                $.at(4, 0);
                $.call(print, [$.call(double, [21n])]);
                $.at(5, 0);
                const $t1 = $.obj([["x", 1n], ["y", 2n]]);
                const $t2 = $.matched($t1, ["obj", ["x", "y"], [["t", "number"], ["t", "number"]], [false, false]]);
                $.call(print, [($t2 !== null)]);

                return $exports;
            })();
        })();
        """)

@test
an_imported_type_is_a_value_AND_is_still_resolved_where_it_is_used()
    val made = js_modules("tests/js/mods/two.sl")

    // **Both halves, and each used to be the whole story on its own.** A type crosses a file as a
    // shape the compiler resolves -- which is why `is Point` emits the object pattern rather than a
    // name -- and it crosses as a VALUE too, so the import takes a field out of the module exactly
    // as `double` does. It took none until a type bound one, and the import path skipped it by
    // name; that skip is gone and there is one rule for every import.
    assert(made.contains("const Point = $.field($m1, \"Point\");"), "the import binds it")
    assert(made.contains("$exports.setName(\"Point\", Point);"), "and the module exported it")
    assert(made.contains("[\"obj\", [\"x\", \"y\"]"), "and what it stands for is what the test uses")

@test
a_star_import_binds_the_module_object_itself()
    assert(js_modules("tests/js/mods/star.sl").contains("const lib = $m1;"))

@test
a_package_is_a_module_like_any_other_once_it_has_been_resolved()
    // **The third import syntax, and the back end knows nothing about it.** Which file a package
    // name points at is `module_want_from`'s answer -- the compiler's own resolver, asked here so
    // that there is one rule for what a path means rather than two that can drift.
    set_package_cache("tests/cache")

    val made = js_modules("tests/proj/app.sl")

    set_package_cache("")

    assert(made.contains("const hello = $.field($m"), "a name out of one package")
    assert(made.contains("const shout = $.field($m"), "and one out of the other")

@test
one_of_slates_own_modules_is_an_object_built_over_the_builtins()
    // **A built-in module is a `Program` with no statements and an export list**, so its JavaScript
    // is its exports read out of the scope every builtin is already in -- which is the whole of the
    // mechanism here, exactly as it is for the machine.
    val made = js_program("import { now } from slate:time\nprint(1)\n")

    assert(made.contains("$exports.setName(\"now\", now);"), "the module is its names")
    assert(made.contains("const now = $.field($m1, \"now\");"), "and the import takes one out")

@test
every_module_is_a_function_of_its_own_so_a_name_it_binds_shadows_nothing()
    // **A regression test.** The entry was written out flat while the other modules were functions,
    // so every name it bound sat in the scope those functions were written in -- and `import { now }
    // from slate:time` then bound a `const now` that `slate:time` itself found when it went looking
    // for the builtin. A `const` is in its dead zone until the line that fills it, so a program that
    // imported the clock could not start.
    assert(js_program("import { now } from slate:time\nprint(1)\n").contains("const $m0 = (() => {"),
        "the entry is a function like every other module")

@test
a_marker_carries_the_file_where_a_program_has_more_than_one()
    // **A function defined in one file and called from another has to say where it was written**,
    // and the caller's next marker has to put the caller's file back -- so once there are two files
    // every marker carries one. `tests/js/mods/blames.sl` is the program that shows why.
    assert(js_modules("tests/js/mods/two.sl").contains("$.at(3, 0);"), "the file travels with the line")

    // And a program of one file says it once, a scope shared with nobody being unable to change it.
    assert_eq(js("val a = 1\n"), "$.at(1);\nconst a = 1n;\n")

// -- an annotation is checked, and says what the machine says ----------------------------------------

@test
a_declared_parameter_is_checked_against_its_type()
    // **The machine's `CheckType`, word for word.** What the reader needs is all three things: the
    // parameter, the type it was declared as, and what actually arrived.
    assert_eq(js("f(x: integer) = x\n"), """
        $.at(1);
        function f(x) {
            let $t1;
            $.at(1);
            if (!($.matches(x, ["t", "integer"]))) $.fault("`x` was declared integer, and was given " + $.plainShow(x));
            $t1 = x;
            return $t1;
        }
        $.sig(f, ["x"], 1, "f");
        """)

@test
an_answer_annotation_is_checked_against_its_type()
    assert(js("f() -> integer = 1\n").contains(
        "$.fault(\"this answers integer, and gave back \" + $.plainShow($t2));"))

@test
the_builtins_a_host_supplies_are_built_rather_than_owed()
    // **What the suite can see of these is that they EXIST**, the emitted text for `sleep(10)` being
    // an ordinary call. That they behave as the interpreter's do is `tests/js/p7.sl` and
    // `tests/js/p8.sl`, which run the same program through both and compare what it printed -- the
    // only place a runtime's behaviour can be checked until the suite has an engine in it.
    val runtime = js_runtime()

    for name in ["setTimeout", "setInterval", "clearTimeout", "clearInterval", "sleep",
            "resolve", "reject", "pending", "settle", "fail", "writeFileSync", "writeFile",
            "renameSync", "rename", "exists", "existsSync", "env"]
        assert(runtime.contains(s"B.${name} = "), s"`${name}` is built rather than owed")

    // The fourteen that are made by a helper rather than written out, so the name is what it is
    // registered under.
    for name in ["readFileSync", "readBytesSync", "readDirSync", "statSync", "removeSync",
            "mkdirSync", "rmdirSync"]
        assert(runtime.contains(s"syncing(\"${name}\""), s"`${name}` is built rather than owed")

    for name in ["readFile", "readBytes", "readDir", "stat", "remove", "mkdir", "rmdir"]
        assert(runtime.contains(s"promising(\"${name}\""), s"`${name}` is built rather than owed")

@test
the_scripts_arguments_and_its_exit_are_the_hosts_own()
    val runtime = js_runtime()

    // **`args` is a VALUE and every other builtin is a function**, so the assertion has to be that
    // it is assigned rather than that it is owed. The loop that puts the builtins on the global
    // object copies whatever it finds, which is why nothing else was needed for a non-function.
    assert(runtime.contains("B.args = $.host.args.slice()"))
    assert(runtime.contains("B.exit = (...args) =>"))

    // **Two hosts count a command line differently and the adapter is where they are reconciled.**
    // node's `process.argv` opens with the executable and the script; quickjs's `scriptArgs` opens
    // with the script alone. A host with neither is a browser, which was asked nothing.
    assert(runtime.contains("process.argv.slice(2)"))
    assert(runtime.contains("scriptArgs.slice(1)"))

    // A host that cannot stop a program says so rather than returning, every caller of `exit` having
    // written the line after it expecting never to reach it.
    assert(runtime.contains("this host cannot stop a program"))

    // The range is checked at both ends here as it is in the interpreter, and for its reason: a
    // shell keeps the low eight bits, so a truncated 256 is a program that says it failed and is
    // recorded as having succeeded.
    assert(runtime.contains("a status is between 0 and 255"))

@test
every_name_a_built_in_module_claims_is_one_the_javascript_runtime_has()
    // **The other half of the check the machine already has.** A module declared over natives is an
    // export list and nothing else, so a name in that list which the emitted runtime does not
    // install is a module that emits and then dies on a `ReferenceError` -- and it would wait for
    // the first program to import it. The eight `slate:llhttp` names were exactly that.
    val runtime = js_runtime()
    val names = builtin_module_names()

    for i in 0..<names.len()
        val name = names.at(i)

        // A module written IN slate exports what its own statements define, so there is nothing here
        // for the runtime to owe.
        if !builtin_has_source(name)
            val exports = builtin_module(name).unwrap()

            // **Either form counts, since what matters is that the name is THERE**: a builtin that
            // is built is `B.<name> =`, and one that is not yet is a quoted entry in the owed list
            // which answers a sentence. A name in neither is the `ReferenceError`.
            for k in 0..<exports.len()
                val wanted = exports.at(k)

                assert(runtime.contains(s"\"${wanted}\"") || runtime.contains(s"B.${wanted} = "),
                    s"slate:${name} claims `${wanted}`, and the JavaScript runtime has no such name")

// -- the whole program ------------------------------------------------------------------------------

@test
a_whole_program_carries_the_runtime_and_a_scope_of_its_own()
    val made = js_program("print(1)")

    // **The module body is a function**, so a program declaring `print` shadows the builtin rather
    // than colliding with it -- the relationship the interpreter's scope chain gives them.
    assert(made.contains("const $ = (() => {"), "the runtime is part of the program")
    assert(made.contains(";(() => {"), "the module has a scope of its own")

    // **The semicolon in front of that is load-bearing**: JavaScript would otherwise read the
    // module's function as an argument to the prelude's last statement.
    assert(!made.contains("\n(() => {\n    $.files"), "the module opens with a semicolon")

@test
the_files_a_fault_may_name_are_listed_once_at_the_top()
    // **A marker names a file by its index in this list**, so that a line table costs a number per
    // statement rather than a path.
    assert(js_program("print(1)").contains("$.files([\"t\"]);"), "the files are named for a fault to carry")

// -- the driver ---------------------------------------------------------------------------------------

@test
what_slate_js_prints_is_the_program_it_wrote()
    // **A regression test for `say_lines`**, which rebuilt every line character by character out of
    // its bytes -- so a program with a wide string in it reached the terminal as mojibake while the
    // same program written to a file was correct.
    val said = cli_said(["slate", "js", "tests/js/wide.sl"])

    assert(said.contains("$.call(print, [\"日本語\"]);"), "a wide string survives being printed")

@test
a_class_pattern_emits_the_nominal_test_beside_the_fields()
    // **The two forms take one node each, and the named one hands its object half straight to the
    // ordinary object matcher** -- which is why shorthand, defaults and nesting needed nothing written
    // twice for this back end.
    //
    // **What is pinned is the emitted text, as everywhere in this file**: that these actually MATCH was
    // established by running the output under node while the feature was written, and every such
    // assertion lives in `tests_classes.sysl` against the interpreter, which the suite can run.

    assert(js("""
        class Point
            var x
            var y

        print(Point.new(1, 2) match
            Point(a, b) -> a
            _ -> 0)
        """).contains("[\"variant\", Point, [\"x\", \"y\"], [[\"_\"], [\"_\"]], \"Point\"]"), "the positional form")

    assert(js("""
        class Point
            var x
            var y

        print(Point.new(1, 2) match
            Point { y: b } -> b
            _ -> 0)
        """).contains("[\"made\", Point, [\"obj\", [\"y\"], [[\"_\"]], [false]], \"Point\"]"), "the named form")

    // **The declared name travels at the end of each nominal form and nothing that MATCHES reads
    // it.** It is there so a `mismatch` report can say `Point`, a JavaScript class knowing no name
    // of its own where the interpreter reads one off the pattern.

// -- what the emitted program does to its host ------------------------------------------------------

// **A builtin is a PARAMETER of the program and not a name in the host's global scope**, and these
// are what say so. The mechanism they replaced installed every builtin onto `globalThis`, which made
// slate the owner of `setTimeout`, `fetch` and two hundred other names for the whole process -- so a
// host API calling one got slate's. node's own `WebSocket` does exactly that and could not open a
// socket; in a browser the same thing takes those names from every other script on the page.
//
// **These run a JavaScript PROBE appended to the emitted program**, which is the only way to ask a
// question about the host's globals: a slate program cannot see them, and that is the whole point.

// What node says when a probe is run after the emitted program has loaded.
private probed(program: string, probe: string) -> string
    val src = "tests/js-probe.tmp.sl"
    val out_js = src + ".js"

    write_text(src, program).unwrap()

    val wrote = cli_status(["slate", "js", src, "-o", out_js])

    remove_file(src)

    if wrote != 0 then return s"`slate js` exited ${wrote}"

    val emitted = from_utf8_unchecked(read_bytes(out_js).unwrap())

    write_text(out_js, emitted + "\n" + probe).unwrap()

    val ran = capture("node", [out_js], "", [], true)

    remove_file(out_js)

    ran match
        Err(e) -> s"node could not be started: ${e}"
        Ok(o) -> if o.status.ok() then o.text.trim() else o.err.unwrap_or("").trim()
end probed

// The emitted program run under a real node, read for its exit status as well as what it printed.
//
// **`probed` throws the status away, and `exit` is exactly the case that needs it kept.** A program
// that calls `process.exit` never gets to `o.status.ok()` deciding anything -- the status IS the
// answer -- so this is `probed`'s file-write-compile-run arrangement with the one thing added.
private node_status_and_said(program: string) -> (string, string)
    val src = "tests/js-exit.tmp.sl"
    val out_js = src + ".js"

    write_text(src, program).unwrap()

    val wrote = cli_status(["slate", "js", src, "-o", out_js])

    remove_file(src)

    if wrote != 0 then return (s"`slate js` exited ${wrote}", "")

    val ran = capture("node", [out_js], "", [], true)

    remove_file(out_js)

    ran match
        Err(e) -> (s"node could not be started: ${e}", "")
        Ok(o) -> (s"${o.status}", o.text.trim())
end node_status_and_said

@test
THE_EMITTED_PROGRAM_LEAVES_THE_HOSTS_OWN_GLOBALS_ALONE()
    // **`print` is the one to ask about, because it is the plainest.** A host that has a `print` of
    // its own -- quickjs does -- would have had it taken; a host that has none, as node does, would
    // have grown one. Either way the program on the page is not the only thing running.
    val probe = "console.log(typeof globalThis.print, typeof globalThis.max)\n" +
        "console.log(globalThis.setTimeout === require(\"timers\").setTimeout)\n"

    assert_eq(probed("print(\"ready\")\n", probe), "ready\nundefined undefined\ntrue")
end THE_EMITTED_PROGRAM_LEAVES_THE_HOSTS_OWN_GLOBALS_ALONE

@test
A_HOST_API_THAT_CALLS_A_GLOBAL_GETS_THE_HOSTS_OWN()
    // **node's `WebSocket` is the host API that found this**, and it is the regression test rather
    // than a demonstration: its handshake calls `setTimeout` and calls `.unref()` on what comes back,
    // where slate answers its own integer id -- which has no such method, so the socket never opened
    // and nothing anywhere named a timer. Nothing of `slate:ws` is involved; this is the emitted
    // program's effect on a host that was minding its own business.
    val probe = "const ws = new WebSocket(\"ws://127.0.0.1:1/\")\n" +
        "ws.onerror = () => { console.log(\"refused, and by the socket rather than by a timer\"); process.exit(0) }\n" +
        "ws.onopen = () => { console.log(\"opened, which nothing is listening for\"); process.exit(0) }\n"

    // **Port 1 refuses, which is the point**: what is asserted is that the failure is the CONNECTION
    // and not a `TypeError` raised inside undici by slate's own `setTimeout`.
    assert_eq(probed("print(\"ready\")\n", probe),
              "ready\nrefused, and by the socket rather than by a timer")
end A_HOST_API_THAT_CALLS_A_GLOBAL_GETS_THE_HOSTS_OWN

@test
host_ANSWERS_NODE_UNDER_THE_EMITTED_PROGRAM()
    // **The one host `tests_builtins.sysl` cannot reach**, that file driving the interpreter directly
    // and answering `"interpreter"` for exactly that reason. Node has no `document`, which is
    // `js_rt_ws.sysl`'s `B.host` telling the two apart.
    assert_eq(probed("print(host())\n", ""), "node")
end host_ANSWERS_NODE_UNDER_THE_EMITTED_PROGRAM

@test
EXIT_INSIDE_AN_UNAWAITED_ASYNC_FUNCTION_STOPS_THE_PROCESS_WITH_ITS_STATUS()
    // **`B.exit` has always called `process.exit` directly**, so this side of the fix is about the
    // interpreter and `slate test --js` catching up to what compiling to JavaScript already did --
    // this test is here to say so is still true rather than because it was ever broken.
    val (status, said) = node_status_and_said(
        "import { exit } from slate:process\n\nasync main()\n    print(\"before\")\n    exit(3)\n\nmain()\n")

    assert_eq(said, "before")
    assert_eq(status, "exited 3")
end EXIT_INSIDE_AN_UNAWAITED_ASYNC_FUNCTION_STOPS_THE_PROCESS_WITH_ITS_STATUS

@test
EXIT_INSIDE_AN_AWAITED_ASYNC_FUNCTION_IS_NOT_CAUGHT_BY_A_TRY_AROUND_THE_AWAIT()
    val (status, said) = node_status_and_said(
        "import { exit } from slate:process\n" +
        "async handler(req)\n" +
        "    print(\"handling\")\n" +
        "    exit(7)\n\n" +
        "async dispatch()\n" +
        "    try\n" +
        "        await handler(1)\n" +
        "    catch e\n" +
        "        print(\"caught:\", e.message)\n\n" +
        "dispatch()\n")

    assert_eq(said, "handling")
    assert_eq(status, "exited 7")
end EXIT_INSIDE_AN_AWAITED_ASYNC_FUNCTION_IS_NOT_CAUGHT_BY_A_TRY_AROUND_THE_AWAIT

@test
A_TEST_MAY_NOT_STOP_THE_RUN_UNDER_NODE_EITHER()
    // **`process.exit` from inside `slate test --js` used to take the whole suite with it**: `B.exit`
    // called it unconditionally, `$suite` runs every file in one node process, and nothing in that
    // process could have told a test's `exit` apart from a real request to stop. A test calling
    // `exit` killed node outright -- no FAIL line, no "N passed", just node gone and whatever exit
    // code `exit` itself had been given standing in for the suite's own. `$testMode` is what tells
    // them apart now: `$suite` turns it on, `B.exit` raises `Exited` instead of calling `process.exit`
    // while it is, and `caught` passes `Exited` through every `catch` a tested program wrote --
    // uncatchable there exactly as `Quit` is in the interpreter.
    val src = "tests/js-exit-test.tmp.sl"

    write_text(src, "import { exit } from slate:process\n@test\nasync t()\n    exit(9)\n").unwrap()

    var lines: Buf[string] = buf()
    val sink = &lines
    val status = run_cli(["slate", "test", "--js", src], (line: string) -> sink.push(line))

    remove_file(src)

    var said = str_builder()

    for i in 0..<lines.len()
        if i > 0 then said.push("\n")

        said.push(lines.at(i))

    val out = said.finish()

    assert(out.contains("`exit(9)` was called, and a test may not stop the run it is part of"), out)
    assert_eq(status, 1)
end A_TEST_MAY_NOT_STOP_THE_RUN_UNDER_NODE_EITHER

@test
A_PROGRAM_MAY_STILL_DECLARE_A_NAME_A_BUILTIN_HAS()
    // **Two scopes are what keeps this true.** The builtins are the outer function's parameters and
    // the program is the inner one, so a program's own `setTimeout` is ordinary shadowing -- where
    // one scope would have made it a redeclaration and a `SyntaxError` that takes the whole program
    // with it. The global scheme gave this for free and it had to be kept.
    val text = "val setTimeout = 7\nval say = print\nsay(setTimeout)\n"

    assert_eq(out(text), "7")
    assert_eq(node_said(text), "7")
end A_PROGRAM_MAY_STILL_DECLARE_A_NAME_A_BUILTIN_HAS

@test
A_PROGRAM_EMITTED_AS_A_MODULE_REACHES_THE_SAME_NODE_MODULES_A_SCRIPT_DOES()
    // **`slate js p.sl -o p.mjs` IS AN ORDINARY THING TO ASK FOR AND EVERY node MODULE REFUSED IN
    // ONE.** node reads a `.mjs` as an ES module whatever the nearest `package.json` says, and a
    // module has no `require` -- so the runtime's `typeof require === "function"` answered *no* on a
    // machine with node's whole standard library on it, and `argon2`, `zstd` and `node:sqlite` each
    // said the host had not got them. `slate test --js` never saw it because its programs are
    // scripts, which is why the module shape is now run beside them.
    //
    // The loader is `process.getBuiltinModule` and `createRequire` off it rather than
    // `import.meta.url`: one runtime has to parse as a script as well, and `import.meta` there is a
    // `SyntaxError` before anything runs.
    val text =
        "import { argon2 } from slate:crypto\n" +
        "import { zstd } from slate:zstd\n" +
        "import { sqlite } from slate:sqlite\n" +
        "import { existsSync } from slate:fs\n" +
        "async main()\n" +
        "    print(startsWith(await argon2(\"pw\", { memoryCost: 8192, timeCost: 1 }), \"$argon2id$\"))\n" +
        "    print(await zstd(toBytes(\"hello hello hello\"), 3).length > 0)\n" +
        "    print(sqlite(\":memory:\").run(\"create table t (a)\").changes)\n" +
        "    print(existsSync(\"package.hocon\"))\n" +
        "main()\n"

    // **The script is asserted beside it and with the same string**, a fix that moved the module
    // shape and broke the script one being the thing worth catching.
    assert_eq(node_said_module(text), "true\ntrue\n0\ntrue")
    assert_eq(node_said(text), "true\ntrue\n0\ntrue")
end A_PROGRAM_EMITTED_AS_A_MODULE_REACHES_THE_SAME_NODE_MODULES_A_SCRIPT_DOES
