module dev.slatelang.slate

// slate's WebSocket server, written in slate and carried in the binary.
//
// **THE FOURTH MODULE WRITTEN IN SLATE**, after `slate:http`, `slate:jwt` and `slate:redis`, and it
// is written in slate for the same reason they are: everything it does, slate can already do. A
// frame is a few bytes of header and a payload; the state a connection carries is a buffer and a
// partly-assembled message. `&`, `|`, `^`, `<<` and `>>` are slate's own, and `toBytes` and
// `fromBytes` are the one place a program sees UTF-8.
//
// **The one thing it reaches out for is SHA-1, which slate cannot do at all**, and it is `sha1` from
// `crypto.sysl` on `sysl.crypto`'s. It used to be written here, on the reasoning that sixty bytes
// per connection cost nothing and that a module reaching outside the language would be saying the
// language cannot do its own work. **That reasoning had stopped applying**: `slate:jwt` reached for
// `sysl.crypto`'s HMAC and SHA-2 the moment they existed, and SHA-1 arrived there afterwards -- so
// what was left was not a design but the order the two were written in. What carries the claim that
// slate does its own work is the rest of this file: the framing, the masking, the fragment
// reassembly and the base64, none of which needs anything.
//
// **The upgrade is `slate:http`'s to hand over and this module's to answer.** A handshake is an
// ordinary HTTP request that says `Connection: upgrade`, so the server parses it as it parses any
// other and then stops being the socket's owner; `httpUpgraded` says where the HTTP stopped, and
// what is behind that offset is the first frames. Everything from the 101 onwards is here.
//
// **The source is a `raw"""` block, which takes no escapes and strips its own indentation** -- so
// what is written below is what slate's lexer sees, `\r\n` included, and there is no second copy to
// drift.

// The module's source, as slate will read it.
ws_source() -> string = raw"""
    // A WebSocket server, written in slate on the upgrade `slate:http` hands over.

    import { connect, send, onBytes, startTls, close as shutSocket } from slate:net

    // RFC 6455's own constant. It is in the protocol so that a server answering the handshake proves it
    // understood WebSocket rather than having echoed a header back -- a cache or a proxy replaying an
    // earlier response cannot produce it.
    val Guid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

    val Continuation = 0
    val TextFrame = 1
    val BinaryFrame = 2
    val CloseFrame = 8
    val PingFrame = 9
    val PongFrame = 10

    // How much of a message a connection will hold before closing.
    //
    // **A frame states its own length before it sends a byte**, so an oversized one is refused on its
    // header rather than after it has arrived -- but a fragmented message states nothing, and the only
    // bound on one is the total kept as the pieces arrive.
    val MessageBytes = 1048576

    val B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

    // One frame, read off the wire. **`tooBig` is the only field that is always there**: a frame
    // whose stated length is over the limit is refused before its bytes are looked at, so there is
    // nothing else to say about it. Everything else is optional for that reason and for no other.
    export type Frame = { tooBig: boolean, fin?: boolean, opcode?: integer, masked?: boolean, payload?: array, size?: integer }

    // What `accept` answers: the connection under `value`, or why the handshake was not one.
    export type Accepted = { ok: boolean, value?: object, error?: string }

    // A live connection, and everything a program does with one.
    export type Connection = { onMessage: function, onBinary: function, onClose: function, send: function, sendBytes: function, ping: function, close: function }

    base64(bs: array) -> string
        var out = ""
        var i = 0

        while i + 2 < len(bs)
            val n = (bs[i] << 16) | (bs[i + 1] << 8) | bs[i + 2]

            out = out + B64[(n >> 18) & 63] + B64[(n >> 12) & 63] + B64[(n >> 6) & 63] + B64[n & 63]
            i = i + 3

        val rest = len(bs) - i

        if rest == 1
            val n = bs[i] << 16

            out = out + B64[(n >> 18) & 63] + B64[(n >> 12) & 63] + "=="
        else if rest == 2
            val n = (bs[i] << 16) | (bs[i + 1] << 8)

            out = out + B64[(n >> 18) & 63] + B64[(n >> 12) & 63] + B64[(n >> 6) & 63] + "="

        out

    // `accepting(key)` -- the value RFC 6455 says a server must answer with.
    //
    // **This is not a use of SHA-1 that its weakness touches.** Nothing is signed and nothing is
    // compared for authenticity; the protocol wants a value only the other end could have computed,
    // so that a client can tell a server that understood WebSocket from a cache replaying an
    // earlier response.
    export accepting(key: string) -> string = base64(sha1(toBytes(key + Guid)))

    // One frame, encoded. **A server never masks**, which is the protocol's rule and not an omission:
    // masking exists to stop a hostile page steering an intermediary into treating payload bytes as a
    // request, and only the browser's direction has that problem.
    export framed(opcode: integer, payload: array) -> array
        var out = [0x80 | opcode]
        val n = len(payload)

        if n < 126
            push(out, n)
        else if n < 65536
            push(out, 126)
            push(out, (n >> 8) & 0xFF)
            push(out, n & 0xFF)
        else
            push(out, 127)

            for i in 0..<8
                push(out, (n >> ((7 - i) * 8)) & 0xFF)

        for b in payload
            push(out, b)

        out

    // One frame written by a CLIENT, which is the same frame masked.
    //
    // **Masking is not secrecy and the key is sent beside the payload.** It exists so that a page
    // cannot steer an intermediary into reading payload bytes as a request of its own: a cache in
    // front of a server sees traffic it cannot predict, and a browser is the only direction that can
    // be told what to send by a hostile document. So a client masks and a server does not, and each
    // fails the connection when the other gets it wrong.
    export maskedFrame(opcode: integer, payload: array) -> array
        val mask = randomBytes(4)

        var out = [0x80 | opcode]
        val n = len(payload)

        if n < 126
            push(out, 0x80 | n)
        else if n < 65536
            push(out, 0x80 | 126)
            push(out, (n >> 8) & 0xFF)
            push(out, n & 0xFF)
        else
            push(out, 0x80 | 127)

            for i in 0..<8
                push(out, (n >> ((7 - i) * 8)) & 0xFF)

        for b in mask
            push(out, b)

        var i = 0

        for b in payload
            push(out, b ^ mask[i % 4])
            i = i + 1

        out

    // The first whole frame in `buf` at or after `from`, or `null` while there is not one yet.
    //
    // **A frame is refused rather than held when its stated length is over the limit**, which is the
    // point of reading the header first: the bytes need never arrive at all.
    export unframed(buf: array, from: integer) -> Frame | null
        val have = len(buf) - from

        if have < 2 then return null

        val b0 = buf[from]
        val b1 = buf[from + 1]
        val masked = (b1 >> 7) & 1
        var n = b1 & 127
        var at = from + 2

        if n == 126
            if len(buf) - at < 2 then return null

            n = (buf[at] << 8) | buf[at + 1]
            at = at + 2
        else if n == 127
            if len(buf) - at < 8 then return null

            n = 0

            for i in 0..<8
                n = (n << 8) | buf[at + i]

            at = at + 8

        if n < 0 || n > MessageBytes then return { tooBig: true }

        var key = null

        if masked == 1
            if len(buf) - at < 4 then return null

            key = [buf[at], buf[at + 1], buf[at + 2], buf[at + 3]]
            at = at + 4

        if len(buf) - at < n then return null

        var payload = []

        for i in 0..<n
            val byte = buf[at + i]

            push(payload, if key == null then byte else byte ^ key[i % 4])

        { tooBig: false,
          fin: ((b0 >> 7) & 1) == 1,
          opcode: b0 & 15,
          masked: masked == 1,
          payload: payload,
          size: at + n - from }

    // `accept(req, socket, head)` -- answer the handshake, or say why it was not one.
    //
    // **A handshake that is not one is an ANSWER rather than a fault**, on `slate:jwt`'s reasoning: a
    // program serving the open internet is sent malformed requests as a matter of course, and taking the
    // process down over one would be the wrong trade. What faults is the program's own mistake.
    export accept(req: object, socket, head: array) -> Accepted
        val h = req.headers

        if req.method != "GET"
            return declined(socket, "a websocket handshake is a GET, and this is a " + req.method)

        if !contains(lower(h.upgrade ?? ""), "websocket")
            return declined(socket, "this is not a websocket handshake -- it has no `Upgrade: websocket`")

        if !contains(lower(h.connection ?? ""), "upgrade")
            return declined(socket, "this is not a websocket handshake -- it has no `Connection: upgrade`")

        val version = h["sec-websocket-version"] ?? ""

        if version != "13"
            return declined(socket, "this server speaks websocket version 13, and this handshake asked for " + (if version == "" then "none" else version))

        val key = h["sec-websocket-key"] ?? ""

        if key == ""
            return declined(socket, "this handshake has no `Sec-WebSocket-Key`")

        send(socket, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accepting(key) + "\r\n\r\n")

        { ok: true, value: connected(socket, head, false) }

    declined(socket, why: string) -> Accepted
        send(socket, "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
        shutSocket(socket)

        { ok: false, error: why }

    // A live connection, whichever end of it this program is.
    //
    // **`masking` is the whole of the difference between a client and a server here**, and it decides
    // two things that are the same rule read from two ends: what this end writes, and what it will
    // accept. A client masks every frame it sends and fails the connection on a masked frame it
    // receives; a server does the exact opposite. Everything else -- the reassembly, the control
    // frames, the close handshake, the UTF-8 check -- is the protocol and not the direction.
    connected(socket, head: array, masking: boolean) -> Connection
        var buf = []
        var heardText = null
        var heardBytes = null
        var gone = null
        var shut = false
        var closing = false

        // The message being reassembled, and what its first frame said it was. **A fragmented message
        // is the ordinary case rather than the exotic one** -- a browser splits anything large, and a
        // server that ignored continuation frames would work in testing and fail on real traffic.
        var partial = null
        var partialOp = 0

        // **Whatever arrived behind the handshake.** A client may send its first frame in the same packet
        // as the handshake, and those bytes have already been read off the socket by the HTTP parser.
        for b in head
            push(buf, b)

        // **One place decides whether a frame is masked**, so no site that writes one has to
        // remember which end this is.
        outgoing(opcode: integer, payload: array) -> array =
            if masking then maskedFrame(opcode, payload) else framed(opcode, payload)

        write(bs: array)
            if !shut then send(socket, bs)

        // The connection is over. **`gone` is called before the socket closes**, so a handler that wants
        // to say something about it still can.
        finish(code: integer, why: string)
            if shut then return

            shut = true

            if gone != null then gone(code, why)

            shutSocket(socket)

        // Say why we are closing, then close. **The close frame goes first**, which is what lets the peer
        // tell a deliberate end from a connection that dropped.
        goodbye(code: integer, why: string)
            if shut || closing then return

            closing = true

            var payload = [(code >> 8) & 0xFF, code & 0xFF]

            for b in toBytes(why)
                push(payload, b)

            write(outgoing(CloseFrame, payload))
            finish(code, why)

        deliver(f: Frame)
            // **A control frame is never fragmented and never large**, and one that is has been made by
            // something that is not following the protocol.
            if f.opcode >= 8
                if !f.fin || len(f.payload) > 125
                    goodbye(1002, "a control frame is one piece of at most 125 bytes")

                    return

            if f.opcode == PingFrame
                write(outgoing(PongFrame, f.payload))

                return

            if f.opcode == PongFrame then return

            if f.opcode == CloseFrame
                val code = if len(f.payload) >= 2 then (f.payload[0] << 8) | f.payload[1] else 1005

                // **The close is echoed rather than answered with our own**, which is the protocol's
                // handshake: whoever sends first is told the same code back.
                if !closing
                    closing = true

                    write(outgoing(CloseFrame, f.payload))

                finish(code, "the peer closed the connection")

                return

            if f.opcode == Continuation
                if partial == null
                    goodbye(1002, "this continuation frame follows no message")

                    return

                for b in f.payload
                    push(partial, b)
            else if f.opcode == TextFrame || f.opcode == BinaryFrame
                if partial != null
                    goodbye(1002, "a new message began before the last one had finished")

                    return

                partialOp = f.opcode
                partial = f.payload
            else
                goodbye(1002, "this connection does not know opcode " + string(f.opcode))

                return

            if len(partial) > MessageBytes
                goodbye(1009, "that message is larger than this connection will hold")

                return

            if !f.fin then return

            val whole = partial

            partial = null

            if partialOp == TextFrame
                val text = fromBytes(whole)

                // **A text frame that is not UTF-8 closes the connection**, and 1007 is the code the
                // protocol reserves for it. Answering the bytes as some other string would be inventing
                // a message the peer did not send.
                if !text.ok
                    goodbye(1007, "that message is not valid UTF-8")

                    return

                if heardText != null then heardText(text.value)
            else
                if heardBytes != null then heardBytes(whole)

        step()
            while true
                if shut then return

                val f = unframed(buf, 0)

                if f == null then return

                if f.tooBig
                    goodbye(1009, "that message is larger than this connection will hold")

                    return

                // **Every frame a client sends is masked and no frame a server sends is**, and one
                // that has it the wrong way round did not come from something following the
                // protocol. RFC 6455 says to fail the connection rather than read it, in both
                // directions and for the same reason.
                if masking == f.masked
                    goodbye(1002, if masking then "a frame sent to a client must not be masked"
                        else "a frame sent to a server must be masked")

                    return

                buf = buf[f.size..]

                deliver(f)

        heard(chunk: array | null)
            if chunk == null
                finish(1006, "the connection was closed without a close frame")

                return

            for b in chunk
                push(buf, b)

            step()

        onBytes(socket, heard)

        onMessage(f: function)
            heardText = f

        onBinary(f: function)
            heardBytes = f

        onClose(f: function)
            gone = f

        sendText(m: string)
            write(outgoing(TextFrame, toBytes(m)))

        sendBytes(bs: array)
            write(outgoing(BinaryFrame, bs))

        ping()
            write(outgoing(PingFrame, []))

        bye(code: integer = 1000, why: string = "")
            goodbye(code, why)

        // **The bytes behind the handshake are read on the next turn, not now.** The caller has not
        // registered a handler yet -- it is still inside `accept` -- so draining the buffer here would
        // deliver a pipelined first frame to nobody.
        setTimeout(step, 0)

        val c = { }

        c.onMessage = onMessage
        c.onBinary = onBinary
        c.onClose = onClose
        c.send = sendText
        c.sendBytes = sendBytes
        c.ping = ping
        c.close = bye
        c

    // -- the client ---------------------------------------------------------------------------------

    // **A client is TWO implementations of one `Connection`, and `hostHas` is what chooses.** Where
    // the host provides a WebSocket of its own -- a browser, and node since it grew the global -- the
    // work is handed to it, because a browser has no socket at all and the framing above has nothing
    // to write onto. Everywhere else the protocol is spoken here, over `slate:net`, which is the same
    // framing the server uses read from the other end.
    //
    // **What a program gets is one object either way**, and that is the point of putting the choice
    // here rather than in front of it. A program that branched on its host would be two programs.

    // What `open` answers: the connection under `value`, or why there is not one.
    export type Opened = { ok: boolean, value?: object, error?: string }

    // How much of a handshake answer this will read before giving up on it. **A server that answers
    // headers for ever is the one failure a client cannot time out of by itself**, the bytes being
    // perfectly well-formed as they arrive.
    val HandshakeBytes = 16384

    // `open(url)` -- a promise of a result carrying the connection.
    //
    // **A promise of a RESULT and not a promise that fails**, which is `connect`'s shape in
    // `slate:net` and is the rule this whole language follows: a server that is not there is an
    // outside condition a client was always going to deal with, and a fault is for a defect in the
    // program.
    export open(url: string) = opening(url)

    async opening(url: string)
        if !(url is string) then throw "`open` takes a url, and this is not one"

        // **The url is read HERE, above the branch, and that is not tidiness.** A host's own
        // WebSocket refuses a url it does not like in its own words, so leaving the check to it
        // would make `open("http://x")` answer one sentence in the interpreter and another in a
        // browser -- for a mistake that has nothing to do with either host.
        val target = parsedUrl(url)

        if !target.ok then return target

        if hostHas("websocket") then return await hostClient(url)

        await ownClient(target.value)

    // -- the host's own client ------------------------------------------------------------------------

    // **One handler for both kinds of message, because the host has one event.** A browser's
    // `message` carries text or bytes and says which by what it hands over, so the two slate handlers
    // are told apart here rather than by asking the host twice.
    async hostClient(url: string)
        val made = await wsOpen(url)

        if !made.ok then return made

        val id = made.value

        var heardText = null
        var heardBytes = null
        var gone = null

        arrived(m)
            if m is string
                if heardText != null then heardText(m)
            else
                if heardBytes != null then heardBytes(m)

        ended(code: integer, why: string)
            if gone != null then gone(code, why)

        wsOnMessage(id, arrived)
        wsOnClose(id, ended)

        onMessage(f: function)
            heardText = f

        onBinary(f: function)
            heardBytes = f

        onClose(f: function)
            gone = f

        sendText(m: string)
            wsSend(id, m)

        sendBytes(bs: array)
            wsSendBytes(id, bs)

        // **A browser's WebSocket cannot send a ping, and this says so rather than doing nothing.**
        // The protocol has one and the object does not expose it: a page has no way to write a
        // control frame, the browser answering the server's pings on the page's behalf. So the
        // method is here to be refused well -- leaving it out would answer "a connection cannot
        // `ping`", which sends a reader to look for a spelling mistake.
        ping()
            throw "this host's WebSocket cannot send a ping -- a browser writes the control frames itself and gives a page no way to, so a program that needs one has to send an ordinary message instead"

        bye(code: integer = 1000, why: string = "")
            wsClose(id, code, why)

        val c = { }

        c.onMessage = onMessage
        c.onBinary = onBinary
        c.onClose = onClose
        c.send = sendText
        c.sendBytes = sendBytes
        c.ping = ping
        c.close = bye

        { ok: true, value: c }

    // -- the client this program speaks itself --------------------------------------------------------

    // Where a url points, or why it points nowhere.
    type Target = { ok: boolean, value?: object, error?: string }

    // **`ws://` and `wss://` and nothing else.** An `http://` url is not a WebSocket url even though
    // the handshake is HTTP, and taking one would be accepting a mistake rather than reporting it.
    parsedUrl(url: string) -> Target
        var rest = ""
        var secure = false

        if startsWith(url, "wss://")
            rest = url[6..<len(url)]
            secure = true
        else if startsWith(url, "ws://")
            rest = url[5..<len(url)]
        else
            return { ok: false, error: "a websocket url begins `ws://` or `wss://`, and this one is " + url }

        val slash = indexOf(rest, "/")
        val authority = if slash == null then rest else rest[0..<slash]
        val path = if slash == null then "/" else rest[slash..<len(rest)]

        if authority == "" then return { ok: false, error: "this url names no host: " + url }

        // **An IPv6 address is in brackets and its colons are its own**, so the port is looked for
        // after the bracket rather than at the last colon of the whole authority.
        val bracket = if startsWith(authority, "[") then indexOf(authority, "]") else null

        if startsWith(authority, "[") && bracket == null
            return { ok: false, error: "this url opens a bracket it never closes: " + url }

        val from = if bracket == null then 0 else bracket + 1
        val colon = indexOf(authority[from..<len(authority)], ":")
        val host = if colon == null then authority else authority[0..<(from + colon)]
        val given = if colon == null then "" else authority[(from + colon + 1)..<len(authority)]

        if colon != null && given == ""
            return { ok: false, error: "this url ends in a colon with no port: " + url }

        // **`number` and not `integer`**: `integer` converts a number and this is text off a url, so
        // a port that is not digits comes back as null rather than faulting where it is read.
        val port = if given == "" then (if secure then 443 else 80) else number(given)

        if !(port is integer) || port < 1 || port > 65535
            return { ok: false, error: "`" + given + "` is not a port" }

        // **The brackets come off the host and stay on the `Host` header**, which is what each of the
        // two wants: a resolver is given an address and a header is given the authority as written.
        val named = if bracket == null then host else host[1..<bracket]

        { ok: true, value: { host: named, port: port, path: path, authority: authority, secure: secure } }

    async ownClient(t: object)
        val made = await connect(t.host, t.port)

        if !made.ok then return made

        val sock = made.value

        if t.secure
            val up = await startTls(sock, { host: t.host })

            if !up.ok
                shutSocket(sock)

                return { ok: false, error: up.error }

        // **Sixteen random bytes, base64'd, and the server proves it understood by hashing them
        // back.** It is not a secret and nothing is authenticated by it: what it rules out is a cache
        // or a proxy replaying an answer it gave to something else.
        val key = base64(randomBytes(16))

        send(sock, "GET " + t.path + " HTTP/1.1\r\n" +
            "Host: " + t.authority + "\r\n" +
            "Upgrade: websocket\r\n" +
            "Connection: Upgrade\r\n" +
            "Sec-WebSocket-Key: " + key + "\r\n" +
            "Sec-WebSocket-Version: 13\r\n\r\n")

        val answered = await handshake(sock, key)

        if !answered.ok
            shutSocket(sock)

            return answered

        { ok: true, value: connected(sock, answered.value, true) }

    // The bytes just past the first blank line, or `null` while it has not arrived.
    headerEnd(buf: array) -> integer | null
        for i in 0..<(len(buf) - 3)
            if buf[i] == 13 && buf[i + 1] == 10 && buf[i + 2] == 13 && buf[i + 3] == 10
                return i + 4

        null

    // Read the server's answer to the handshake, and hand back whatever came behind it.
    //
    // **The leftover bytes matter for the same reason they do on the server side**: a server may put
    // its first frame in the same packet as the 101, and those bytes are already off the socket. They
    // seed the connection's buffer exactly as `accept`'s do.
    handshake(sock, key: string)
        val p = pending()

        var buf = []
        var done = false

        finish(answer)
            if done then return

            done = true

            settle(p, answer)

        heard(chunk: array | null)
            if done then return

            if chunk == null
                finish({ ok: false, error: "the connection closed before the handshake was answered" })

                return

            for b in chunk
                push(buf, b)

            val end = headerEnd(buf)

            if end == null
                if len(buf) > HandshakeBytes
                    finish({ ok: false, error: "this handshake answer is longer than a handshake answer is" })

                return

            val head = fromBytes(buf[0..<end])

            if !head.ok
                finish({ ok: false, error: "this handshake answer is not text" })

                return

            finish(checked(head.value, key, buf[end..<len(buf)]))

        onBytes(sock, heard)

        p

    // What reading the handshake answer produced: the bytes behind it, or why it was not an answer.
    //
    // **Its own type and not `Opened`**, which the annotation caught: what this carries is the
    // LEFTOVER BYTES and what `open` carries is the connection, so one type for both would be a
    // shape that is sometimes an array and sometimes an object.
    type Handshake = { ok: boolean, value?: array, error?: string }

    // Whether that answer is the one RFC 6455 says a server gives.
    checked(head: string, key: string, rest: array) -> Handshake
        val lines = split(head, "\r\n")
        val status = split(lines[0], " ")

        if len(status) < 2 || status[1] != "101"
            return { ok: false, error: "this server answered `" + lines[0] + "` rather than 101" }

        var accept = null
        var upgraded = false

        for i in 1..<len(lines)
            val at = indexOf(lines[i], ":")

            if at != null
                val name = lower(trim(lines[i][0..<at]))
                val value = trim(lines[i][(at + 1)..<len(lines[i])])

                if name == "sec-websocket-accept" then accept = value
                if name == "upgrade" then upgraded = lower(value) == "websocket"

        if !upgraded
            return { ok: false, error: "this server answered 101 without `Upgrade: websocket`" }

        // **The one check that says the server understood rather than echoed.** A wrong value here is
        // an intermediary answering out of a cache, which is exactly what the key exists to catch.
        if accept == null
            return { ok: false, error: "this server answered 101 with no `Sec-WebSocket-Accept`" }

        if accept != accepting(key)
            return { ok: false, error: "this server's `Sec-WebSocket-Accept` is not the one this handshake asked for" }

        { ok: true, value: rest }
    """
