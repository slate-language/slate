module dev.slatelang.slate

// Where an object's entries are kept, and the only functions that reach them by position.
//
// **EVERY READER AND WRITER OF AN OBJECT'S TABLE GOES THROUGH THIS FILE**, and that is the whole of
// what it is for. The table's compact dict (`table.sysl`), the tracer, the printer, the matcher, the
// actor copy, JSON and every subsystem that walks an options object ask for an entry by POSITION --
// `entry_count`, `entry_at`, `entry_set` -- and never name the storage. So where the entries live
// is decided here and nowhere else, and changing it is a change to this file.
//
// **A position is the insertion order**, tombstones included: `keys` order, the index's biased
// positions and a call site's remembered guess (`site_cache.sysl`) all name the same numbers.
//
// **A SMALL OBJECT'S ENTRIES LIVE IN ITS OWN CELL, AND A LARGER ONE'S ALL IN A `Buf`.** Nearly every
// object a program makes is small -- a class instance is its `proto` and a field or two, a literal a
// point or a pair -- so up to `InlineEntries` entries sit in the `ObjectObj` the allocator already
// handed out: a construction asks `malloc` for nothing, a field read is one load off the object
// rather than a load of the table and a second through it, and the sweep that frees it has no second
// block to give back. The entry that does not fit SPILLS the whole table into `stored`, and from then
// on every position is there.
//
// **Spilling the whole table rather than keeping the first few inline is measured, not tidy.** With
// the first `InlineEntries` positions always inline, a lookup in a large table asked `i < N` of a
// position the hash had just chosen, and a map read at random mispredicted it: `mapset` read +3.7%
// and `methods` +2.9%.
//
// **AND NO READ ASKS WHICH SIDE THE TABLE IS ON: `at` POINTS AT WHEREVER THE ENTRIES ARE.** Asking
// "has this object spilled" on every read was predicted and still cost a large table 2-4%, so the
// answer is kept in the cell instead -- `at` is `small`'s first entry or the `Buf`'s storage, and a
// read, a write and a value write are one index off it. The price is that every change of storage
// re-points it, and there are exactly four: a new or emptied table (`entries_fresh_on`,
// `entries_drop`, `entries_release`) points at the cell, and a push past the cell (`pushed_outside`)
// points at the `Buf` after EVERY push -- a `Buf` that grows moves, and a pointer into its old
// storage is a read of freed memory. A rehash compacts in place and truncates, which moves nothing.
// It is a raw `*Entry`, not a counted `&T`, so the zeroing rule for collected memory has nothing to
// say about it; and nothing copies an `ObjectObj` by value, which would carry a pointer into the
// cell it was copied from -- an actor's copy is a new object filled by `entry_push`.
//
// **An inline `Entry` is legal in collected memory** because it holds no counted member: a hash, two
// `Value`s and a flag, none of which a zeroed cell can make a first assignment release wrongly.

// How many entries an object holds in its own cell. Three is a class instance's `proto` and two
// fields, and a literal's three; `bench/results/2026-09-24-inline-object.md` has 3, 4 and 8 side by side.
const InlineEntries: usize = 3

// The C allocator's resize, beside the `malloc` and `free` `vm_state.sysl` declares.
extern realloc(block: *u8, bytes: usize) -> *u8

// Whether the table has outgrown its cell, which a spilled table never un-does until it is emptied.
@inline
private spilled(o: *ObjectObj) -> bool = o.spill_cap != 0

// How many entries the table holds, tombstones included.
@inline
entry_count(o: *ObjectObj) -> usize = o.count

// The entry at position `i`, which must be below `entry_count`.
@inline
entry_at(o: *ObjectObj, i: usize) -> Entry = o.at[i]

// Write the entry at position `i`, which must be below `entry_count`.
@inline
entry_set(o: *ObjectObj, i: usize, e: Entry)
    o.at[i] = e

// Replace the value at position `i`, keeping its key, hash and liveness.
@inline
entry_value_set(o: *ObjectObj, i: usize, v: Value)
    o.at[i].value = v

// Where position 0 is -- the cell's first entry or the spill block -- which is what the tests ask.
entries_at(o: *ObjectObj) -> *Entry = o.at

// Point a table back at its own cell, giving nothing back -- for a cell that holds no spill block.
@inline
private home(o: *ObjectObj)
    o.count = 0
    o.spill_cap = 0
    o.at = &o.small[0]

// Drop every tombstone, keeping the live entries in their order, and answer how many are left.
//
// **In place**, which is what a rehash wants: the positions the index is about to be rebuilt from
// are the compacted ones, and nothing is allocated to move them. A spilled table stays spilled and
// keeps its capacity -- a table that grew to hold many keys is likely to hold them again.
entries_compact(o: *ObjectObj) -> usize
    var kept: usize = 0

    for i in 0..<o.count
        val e = entry_at(o, i)

        if !e.dead
            if kept != i then entry_set(o, kept, e)

            kept += 1

    o.count = kept
    kept
end entries_compact

// Empty the table and give back what held its entries, which puts it back in its cell.
entries_drop(o: *ObjectObj)
    if spilled(o) then free(ptr_cast(o.at))

    home(o)

// What the entries hold outside the heap, which `object_payload` charges. The inline ones are the
// cell's and are counted with it.
entries_payload(o: *ObjectObj) -> usize = o.spill_cap * sizeof(Entry)

// The capacity a table takes when it spills, which is therefore the only size a sweep keeps.
//
// **Twice the cell, not the eight a `Buf`'s first push would give**, so an object of four to six
// fields pays for what it holds; past that the `Buf` doubles as it always did.
const FirstOverflow: usize = InlineEntries * 2

// How many emptied spill tables a VM keeps for reuse.
const SpareEntries: usize = 4096

// Give a new object its empty table: nothing in the cell and nothing outside it.
//
// **The cell is zeroed collected memory, so there is nothing in it to give back** -- except in a
// reserve handed out a second time on a full heap, which `entries_drop` would free and this may not
// assume either way. Asking costs one predicted branch on a construction.
entries_fresh_on(v: *Vm, o: *ObjectObj)
    if spilled(o) then free(ptr_cast(o.at))

    home(o)

// **A SWEEP KEEPS AN EMPTIED SPILL TABLE FOR THE NEXT OBJECT THAT OUTGROWS ITS CELL**, so a loop
// making objects of four to six fields asks `malloc` for nothing a turn -- which is what every
// object with a field used to cost before the small ones moved into the cell. `spill` takes one
// before it asks for memory.
//
// **Only during a SWEEP, which `sweeping` says.** A heap being disposed is going away with its VM,
// and keeping its tables would only move the free to later.
//
// **Bounded, so the tables kept are never more than a sweep's worth of objects**: a program that
// made a million and dropped them keeps `SpareEntries` tables -- about a megabyte -- and gives the
// rest back as it always did.
entries_release(v: *Vm, o: *ObjectObj)
    if spilled(o)
        if v.sweeping && o.spill_cap == FirstOverflow && v.spare_entries.len() < SpareEntries
            v.spare_entries.push(o.at)
        else
            free(ptr_cast(o.at))

    home(o)

// Give back every kept spill block, which a heap being rebuilt or a VM being disposed owes: the list
// is sysl memory and the blocks are `malloc`'s, so dropping the list alone would leak them.
entries_spares_free(v: *Vm)
    for block in v.spare_entries.view()
        free(ptr_cast(block))

    v.spare_entries.clear()

// Append an entry to an object's table.
//
// **EVERY KEY A TABLE TAKES ARRIVES HERE, which is what makes the summary in `keys_bloom` sound.**
// A rehash compacts the entries without coming through this function and deliberately leaves the
// summary alone: what it drops are tombstones, so the bits it keeps stay a superset of the keys.
entry_push(o: *ObjectObj, e: Entry) = entry_push_on(current(), o, e)

// The same, charged to a VM the caller already holds.
@inline
entry_push_on(v: *Vm, o: *ObjectObj, e: Entry)
    val n = o.count

    if n < InlineEntries && !spilled(o) then o.small[n] = e else pushed_outside(v, o, e)

    o.count = n + 1
    o.keys_bloom = o.keys_bloom | (u64(1) << (e.hash & 63))

// A push the cell cannot take: the first one moves the cell's entries out into a kept table or one
// of `FirstOverflow`, and every one charges what the capacity grew by.
//
// **`at` is re-pointed at every change of block, and a doubling is one**: `realloc` may move the
// entries, and a pointer left at the old block is a read of freed memory on the next field.
@noinline
private pushed_outside(v: *Vm, o: *ObjectObj, e: Entry)
    val n = o.count

    if !spilled(o)
        val block: *Entry = v.spare_entries.pop() match
            Some(kept) -> kept
            None -> ptr_cast(malloc(FirstOverflow * sizeof(Entry)))

        for i in 0..<n
            block[i] = o.small[i]

        o.at = block
        o.spill_cap = FirstOverflow
        charge_on(v, FirstOverflow * sizeof(Entry))
    elif n == o.spill_cap
        val grown = o.spill_cap * 2

        o.at = ptr_cast(realloc(ptr_cast(o.at), grown * sizeof(Entry)))
        charge_on(v, (grown - o.spill_cap) * sizeof(Entry))
        o.spill_cap = grown

    o.at[n] = e
