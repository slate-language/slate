module dev.slatelang.slate

import sysl.buf.{Buf, buf}

// Where an object's entries are kept, and the only functions that reach them by position.
//
// **EVERY READER AND WRITER OF AN OBJECT'S TABLE GOES THROUGH THIS FILE**, and that is the whole of
// what it is for. The table's compact dict (`table.sysl`), the tracer, the printer, the matcher, the
// actor copy, JSON and every subsystem that walks an options object ask for an entry by POSITION --
// `entry_count`, `entry_at`, `entry_set` -- and never name the storage. So where the entries live
// is decided here and nowhere else, and changing it is a change to this file.
//
// **A position is the insertion order**, tombstones included: `keys` order, the index's biased
// positions and a call site's remembered guess (`site_cache.sysl`) all name the same numbers.

// How many entries the table holds, tombstones included.
@inline
entry_count(o: *ObjectObj) -> usize = o.stored.len()

// The entry at position `i`, which must be below `entry_count`.
@inline
entry_at(o: *ObjectObj, i: usize) -> Entry = o.stored.at(i)

// Write the entry at position `i`, which must be below `entry_count`.
@inline
entry_set(o: *ObjectObj, i: usize, e: Entry) = o.stored.set(i, e)

// Replace the value at position `i`, keeping its key, hash and liveness.
@inline
entry_value_set(o: *ObjectObj, i: usize, v: Value)
    var e = entry_at(o, i)

    e.value = v
    entry_set(o, i, e)

// What the entries hold outside the heap, which `object_payload` charges.
entries_payload(o: *ObjectObj) -> usize = o.stored.cap() * sizeof(Entry)

// The capacity a `Buf` takes at its first push, which is therefore the table every object of fewer
// than eight fields has.
private const FirstTable: usize = 8

// How many emptied tables a VM keeps for reuse.
private const SpareEntries: usize = 4096

// Give a new object its empty table.
//
// **A table a sweep kept, where there is one** -- `entries_release` says why. It is empty and
// already the size a first field would have grown it to, and the charge `new_object_on` makes is
// what that growth would have charged.
entries_fresh_on(v: *Vm, o: *ObjectObj)
    o.stored = v.spare_entries.pop() match
        Some(kept) -> kept
        None -> buf()

// **A SWEEP KEEPS A SMALL OBJECT'S ENTRY TABLE FOR THE NEXT OBJECT, AND THAT IS THE ALLOCATION A
// CONSTRUCTOR CALL USED TO MAKE.** An object's fields live in a `Buf` outside the heap, so every
// `Counter(n)` asked `malloc` for a table of `SmallTable` entries, wrote every one of them, and the
// sweep that freed the object handed the table back to `free` -- a malloc, a fill and a free per
// object, which a loop making one object a turn pays every turn. A table of exactly the size the
// first push gives is emptied and kept instead, up to `SpareEntries` of them, and `new_object` takes
// one before it asks for memory.
//
// **Only during a SWEEP, which `sweeping` says.** A heap being disposed is going away with its VM,
// and keeping its tables would only move the free to later.
//
// **Bounded, so the tables kept are never more than a sweep's worth of small objects**: a program
// that made a million and dropped them keeps `SpareEntries` tables -- two megabytes -- and gives the
// rest back as it always did.
entries_release(v: *Vm, o: *ObjectObj)
    if v.sweeping && o.stored.cap() == FirstTable && v.spare_entries.len() < SpareEntries
        o.stored.clear()
        v.spare_entries.push(o.stored)

    o.stored = buf()

// Take the entries a rehash kept in place of the ones the table had.
entries_replace(o: *ObjectObj, kept: Buf[Entry])
    o.stored = kept

// Empty the table and give back what held its entries.
entries_drop(o: *ObjectObj)
    o.stored = buf()

// Append an entry to an object's table.
//
// **EVERY KEY A TABLE TAKES ARRIVES HERE, which is what makes the summary in `keys_bloom` sound.**
// A rehash rebuilds the entries without coming through this function and deliberately leaves the
// summary alone: what it drops are tombstones, so the bits it keeps stay a superset of the keys.
entry_push(o: *ObjectObj, e: Entry) = entry_push_on(current(), o, e)

// The same, charged to a VM the caller already holds.
entry_push_on(v: *Vm, o: *ObjectObj, e: Entry)
    val was = o.stored.cap()

    o.stored.push(e)
    o.keys_bloom = o.keys_bloom | (u64(1) << (e.hash & 63))

    // A table a sweep kept is already the size its first push would grow it to, so a literal's
    // pushes nearly never move the capacity and there is nothing to charge.
    if o.stored.cap() != was then charge_on(v, (o.stored.cap() - was) * sizeof(Entry))
