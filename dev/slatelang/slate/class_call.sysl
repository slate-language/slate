module dev.slatelang.slate

// Finding a class's `new` when the class is called.
//
// **`Counter(3)` ASKED THE CLASS FOR `new` BY SPELLING ON EVERY CONSTRUCTION** -- `hook_of` hashes
// the name and searches the table -- for an answer that is the same every time. `CallFn` has no cache
// slot of its own (its eight bytes are the argument count and the names), so the memory is one
// position kept on the unit: where `new` stood the last time any constructor call looked.
//
// **A POSITION, CHECKED BEFORE IT IS BELIEVED, which is `site_cache.sysl`'s bargain and needs no
// invalidation for its reasons.** The entry standing there has to be live, filed under `new`'s hash
// and keyed `new` itself, so a class whose `new` was reassigned answers the new closure (a write keeps
// the position and changes the value), one whose table was rehashed or whose `new` was removed misses
// and searches, and a different class is simply a different table to check the same position in.
// Classes declared alike put `new` at the same place, which is why one position serves them all.
//
// **The answer is `hook_of`'s exactly**: the class's own `new` if it has one, callable or not -- a
// field that is not a function is no constructor, and the chain is not searched past it -- and
// otherwise whatever its protos supply.

// The callable `new` a class supplies, if it has one.
constructor_of(u: *Unit, o: *ObjectObj) -> Option[Value]
    val at = u.new_at

    if at < o.entries.len()
        val e = o.entries.at(at)

        if !e.dead && e.hash == u.new_hash
            e.key match
                Str(p) -> if p.s == "new" then return callable_or_none(e.value)
                _ -> ()

    obj_index_hashed(o, "new", u.new_hash) match
        Some(i) ->
            u.new_at = i
            callable_or_none(o.entries.at(i).value)
        None -> hook_of(Object(o), "new")
end constructor_of

private callable_or_none(v: Value) -> Option[Value] = v match
    Fn(_) -> Some(v)
    Native(_) -> Some(v)
    _ -> None
