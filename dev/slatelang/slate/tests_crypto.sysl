module dev.slatelang.slate
@tests

import sysl.text.Search

// `slate:crypto` -- the digests, HMAC, key derivation and randomness a program reaches.
//
// **Every one of these is a published vector rather than a value this implementation produced.**
// That is the whole discipline for testing a hash: a digest compared against what this program
// answered yesterday passes just as happily on a broken implementation, and the point of a digest is
// that everybody else's agrees.

@test
THE_FOUR_DIGESTS_ANSWER_THE_PUBLISHED_VECTORS_FOR_abc()
    // **`"abc"` is the vector every one of these was published with**, which is what makes this a
    // test of SHA-2 rather than a test that this program is consistent with itself. A digest
    // compared against a value this implementation produced would pass just as happily on a broken
    // one.

    assert_eq(crypto_out("print(hex(sha1(\"abc\")))\nprint(hex(sha256(\"abc\")))\nprint(hex(sha384(\"abc\")))\nprint(hex(sha512(\"abc\")))\n"),
        "a9993e364706816aba3e25717850c26c9cd0d89d\n" +
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\n" +
        "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7\n" +
        "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")

@test
MD5_ANSWERS_ITS_PUBLISHED_VECTORS_ON_BOTH_SIDES_OF_THE_BLOCK_BOUNDARY()
    // **The first three are RFC 1321's own**, which is what `md5` is here to agree with. MD5 is
    // exported for the protocols that give a client no say -- PostgreSQL's `md5` login above all --
    // and the only thing that makes such an implementation worth having is that it answers what the
    // server computed.
    //
    // **The last two are the block boundary and are the reason there are five rather than three.**
    // MD5's block is 64 bytes and its length field takes the last eight, so a message of 55 pads
    // inside one block and a message of 56 needs a second. An implementation that got the boundary
    // wrong passes every one of the RFC's short vectors, which is the lesson SHA-1's own swap paid
    // for. Both come from an independent implementation and not from this one.

    assert_eq(crypto_out("print(hex(md5(\"\")))\nprint(hex(md5(\"abc\")))\nprint(hex(md5(\"message digest\")))\nprint(hex(md5(\"1234567890123456789012345678901234567890123456789012345\")))\nprint(hex(md5(\"12345678901234567890123456789012345678901234567890123456\")))\n"),
        "d41d8cd98f00b204e9800998ecf8427e\n" +
        "900150983cd24fb0d6963f7d28e17f72\n" +
        "f96b697d7cb7938d525a2f31aaf161d0\n" +
        "c9ccf168914a1bcfc3229f1948e67da0\n" +
        "49f193adce178490e34d1b3a4ec0064c")

@test
HMAC_TAKES_MD5_AND_KEY_DERIVATION_DOES_NOT()
    // **RFC 2202's second case for HMAC-MD5**, which exists for the same reason `md5` does: HTTP
    // Digest and the older SASL mechanisms name it and a client answering one has no vote.
    //
    // **`pbkdf2` refuses it, and that is a decision rather than a gap.** Every other name here reads
    // a protocol somebody else chose; deriving a key is the one thing a program chooses for itself,
    // and there is nothing in the standard library to reach for even if it were wanted.

    assert_eq(crypto_out("print(hex(hmac(\"MD5\", \"Jefe\", \"what do ya want for nothing?\")))\n"),
        "750c783e6ab0b503eaa86e310a5db738")

    assert(crypto_fails("print(pbkdf2(\"MD5\", \"p\", \"s\", 1, 16))").contains("`MD5` is not a digest this derives a key with -- there are SHA-1, SHA-256, SHA-384 and SHA-512"))

@test
A_DIGEST_TAKES_BYTES_WHERE_A_PROGRAM_HAS_BYTES()
    // **Text or bytes, since a program hashing something has one or the other and never a choice.**
    // A file it read is bytes; a password or a header it built is text; and `toBytes` is the one
    // conversion between them, so hashing either has to answer the same digest.

    assert_eq(crypto_out("print(hex(sha256(toBytes(\"abc\"))) == hex(sha256(\"abc\")))\nprint(hex(sha256(\"\")))\n"),
        "true\n" +
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")

@test
HMAC_ANSWERS_RFC_4231()
    // **RFC 4231's second case, and the `hmac` half of the module's whole reason for being.** A
    // challenge-response protocol -- SCRAM, a signed webhook, an S3 request -- is HMAC and a layout,
    // and the layout is the package's own work.

    assert_eq(crypto_out("print(hex(hmac(\"SHA-256\", \"Jefe\", \"what do ya want for nothing?\")))\nprint(hex(hmac(\"SHA-1\", \"Jefe\", \"what do ya want for nothing?\")))\n"),
        "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843\n" +
        "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")

@test
PBKDF2_ANSWERS_RFC_6070_AND_THE_COUNT_IS_THE_CALLERS()
    // **RFC 6070's first two cases, which pin the part an implementation gets wrong silently**: the
    // block counter is four bytes, big-endian, and starts at one. Get it wrong and every key that
    // comes out looks like a key and agrees with nobody.
    //
    // **The 4,096-iteration case is what one SCRAM handshake costs**, and is the reason this is a
    // native at all -- some eight thousand SHA-256 compressions, which is a millisecond here and
    // seconds in the interpreter.

    assert_eq(crypto_out("print(hex(pbkdf2(\"SHA-1\", \"password\", \"salt\", 1, 20)))\nprint(hex(pbkdf2(\"SHA-1\", \"password\", \"salt\", 2, 20)))\nprint(hex(pbkdf2(\"SHA-256\", \"password\", \"salt\", 4096, 32)))\n"),
        "0c60c80f961f0e71f3a9b524af6012062fe037a6\n" +
        "ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957\n" +
        "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a")

@test
A_DERIVED_KEY_MAY_BE_LONGER_THAN_ONE_BLOCK()
    // **A length past the digest's own is the second block**, and the counter is what makes it
    // different from the first. A derivation that ignored the length would answer 20 bytes and a
    // caller wanting 40 would never know which half was real.

    assert_eq(crypto_out("val long = pbkdf2(\"SHA-1\", \"password\", \"salt\", 1, 40)\nprint(len(long))\nprint(hex(long).startsWith(hex(pbkdf2(\"SHA-1\", \"password\", \"salt\", 1, 20))))\nprint(hex(long))\n"),
        "40\n" +
        "true\n" +
        "0c60c80f961f0e71f3a9b524af6012062fe037a6e0f0eb94fe8fc46bdc637164ac2e7a8e3f9d2e83")

@test
randomBytes_ANSWERS_WHAT_WAS_ASKED_FOR_AND_NOT_THE_SAME_TWICE()
    // **This is the half of the module that cannot be written in slate at any price.** A program has
    // no source of unpredictability at all, so a nonce or a salt it worked out from the clock is
    // neither -- and a protocol whose nonce is guessable has no protection left in it.
    //
    // **Two calls differing is not a test of randomness and does not pretend to be.** It is a test
    // that the kernel is actually being asked each time, which is the failure a wrong implementation
    // has: a buffer filled once and handed out again.

    assert_eq(crypto_out("print(len(randomBytes(1)), len(randomBytes(32)), len(randomBytes(1000)))\nprint(hex(randomBytes(24)) == hex(randomBytes(24)))\n"),
        "1 32 1000\n" +
        "false")

@test
timingSafeEqual_ANSWERS_THE_SAME_QUESTION_EQUALITY_DOES()
    // **A comparison that stops at the first differing byte is how a tag is forged a byte at a
    // time**, and `==` on two arrays is exactly that comparison. What this adds is the timing, which
    // no test can observe -- so what is pinned here is that the answer is the ordinary one.

    assert_eq(crypto_out("print(timingSafeEqual([1, 2, 3], [1, 2, 3]))\nprint(timingSafeEqual([1, 2, 3], [1, 2, 4]))\nprint(timingSafeEqual([1, 2, 3], [1, 2]))\nprint(timingSafeEqual(\"abc\", toBytes(\"abc\")))\n"),
        "true\n" +
        "false\n" +
        "false\n" +
        "true")

@test
THE_NAMES_SAY_WHAT_THEY_TAKE()
    // **An error path per name, because a native's complaint is code nobody else runs.** Each of
    // these is the mistake its own surface invites: a digest nobody has heard of, a count of
    // arguments, a length or an iteration count that cannot mean anything.

    assert(crypto_fails("print(sha256(\"a\", \"b\"))").contains("`sha256` takes the data to hash, and was given 2 arguments"))
    assert(crypto_fails("print(sha256(42))").contains("`sha256` takes the data as text or bytes, and this is an integer"))
    assert(crypto_fails("print(hmac(\"SHA-9\", \"k\", \"m\"))").contains("`SHA-9` is not a digest this understands -- there are MD5, SHA-1, SHA-256, SHA-384 and SHA-512"))
    assert(crypto_fails("print(hmac(\"SHA-256\", \"k\"))").contains("`hmac` takes an algorithm, a key and a message, and was given 2 arguments"))
    assert(crypto_fails("print(pbkdf2(\"SHA-256\", \"p\", \"s\", 0, 32))").contains("`pbkdf2` takes at least one iteration, and was asked for 0"))
    assert(crypto_fails("print(pbkdf2(\"SHA-256\", \"p\", \"s\", 1, -4))").contains("`pbkdf2` takes the length as a count that is not negative, and this is -4"))
    assert(crypto_fails("print(pbkdf2(\"SHA-256\", \"p\", \"s\", 1, 0))").contains("`pbkdf2` was asked for a key of no length"))
    assert(crypto_fails("print(pbkdf2(\"SHA-256\", \"p\", \"s\", 4294967296, 32))").contains("`pbkdf2` takes an iteration count of at most 4294967295, and was asked for 4294967296"))
    assert(crypto_fails("print(randomBytes(0))").contains("`randomBytes` was asked for no bytes"))
    assert(crypto_fails("print(randomBytes(\"lots\"))").contains("`randomBytes` takes the count as a number, and this is a string"))
    assert(crypto_fails("print(timingSafeEqual([1]))").contains("`timingSafeEqual` takes two byte strings, and was given 1 argument"))
