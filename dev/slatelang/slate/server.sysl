module dev.slatelang.slate

import sh.sysl.gc
import sh.sysl.libuv
import sh.sysl.libuv.Handle
import sh.sysl.libuv.Stream
import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{from_utf8, str_builder}

// An HTTP server, on the event loop slate already has.
//
// **Written on libuv directly rather than on slate's own `listen`**, and the reason is a table rather
// than a preference: `listen` delivers each connection to a slate callback, and what this needs to
// know at every step is *which server* a connection belongs to and *which connection* a chunk of
// bytes belongs to. A sysl closure may capture a `usize` and nothing else -- the collector cannot see
// through one -- so the two indices are what the callbacks carry, and the tables they index are here.
//
// **The socket lifetime machinery IS reused**, though: every handle this file makes is held in
// `event.sysl`'s slot table exactly as `net.sysl`'s are, which is what keeps the loop alive while a
// server is listening and what closes the handle when the slot is given back.
//
// **A HANDLER MAY ANSWER A PROMISE**, which is the whole reason `watch_promise` exists. An async
// handler is the ordinary case -- it reads a file, asks a database, calls another service -- and a
// server that could only take a synchronous one would be a server for nothing real.
//
// ## What is deliberately not here
//
// **No keep-alive.** Every response says `Connection: close` and the socket is closed after it. That
// is one request per connection, which is slower and is *correct*, and it keeps this file from having
// to decide when a connection has gone quiet. It is the first thing to add.
//
// **No chunked request bodies and no streaming.** A request is read whole before the handler sees it,
// so `Content-Length` is what says how much to wait for, and a request without one has no body. A
// body arriving in chunks is refused rather than misread.
//
// **No routing.** A handler is a function from a request to a response, and matching on `req.path` is
// something slate can already do -- a router that only ever calls `startsWith` would be a thing to
// learn for nothing.

// One listening server.
struct Server
    live: bool

    // The slot in `event.sysl`'s table that holds the listening socket.
    id: usize
    gen: usize

    // What to call with each request. **The one value here the collector has to know about**, which
    // is what `mark_servers` is for.
    handler: Value

var servers: Buf[Server] = buf()

// One connection, from accepted to answered.
struct Conn
    live: bool
    id: usize
    gen: usize

    // Which server accepted it, so its handler can be found again.
    server: usize

    // What has arrived so far. **A request is read whole**, so this grows until the headers say how
    // much there is and the body is that long.
    got: Buf[u8]

    // Whether a response has been written, so that a second one cannot be.
    answered: bool

var conns: Buf[Conn] = buf()

// Mark what a server is holding. Nothing else refers to a handler once `serve` has returned.
mark_servers(h: *gc.Heap)
    for i in 0..<servers.len()
        if servers.at(i).live then mark_value(h, servers.at(i).handler)

reset_servers()
    servers = buf()
    conns = buf()

// `serve(port, handler)` -- listen, and call `handler` with each request.
//
// The answer is the listening socket, so that a program can `close` it -- which is also the only way
// a program with a server in it ever exits.
do_serve(args: Buf[Value], at: Span) -> Step
    wants(args, 2, at, "serve", "a port and a function to call with each request")?

    val port = args.at(0) match
        Int(n) -> n
        other -> return fault(at, s"`serve` takes a port number, and this is ${other.type_name()}")

    if port < 0 || port > 65535 then return fault(at, s"a port is between 0 and 65535, and this is ${port}")

    args.at(1) match
        Fn(_) -> ()
        Native(_) -> ()
        other -> return fault(at, s"`serve` needs a function to call with each request, and this is ${other.type_name()}")

    val listener = libuv.tcp() match
        Err(e) -> return fault(at, s"this socket could not be made: ${e}")
        Ok(t) -> t

    val addr = libuv.ip4("0.0.0.0", int(port)) match
        Err(e) -> return fault(at, s"this address could not be read: ${e}")
        Ok(a) -> a

    listener.bind(addr) match
        Err(e) -> return fault(at, s"cannot listen on port ${port}: ${e}")
        Ok(_) -> ()

    val held = hold_socket(listener, Value.Null)
    val (id, gen) = socket_slot(held)
    val s = claim_server(id, gen, args.at(1))

    listener.listen(128, () -> server_accepted(s)) match
        Err(e) ->
            surrender(id)
            drop_server(s)
            fault(at, s"cannot listen on port ${port}: ${e}")
        Ok(_) -> Ok(held)
end do_serve

private claim_server(id: usize, gen: usize, handler: Value) -> usize
    for i in 0..<servers.len()
        if !servers.at(i).live
            servers.set(i, Server(true, id, gen, handler))
            return i

    servers.push(Server(true, id, gen, handler))
    servers.len() - 1

private drop_server(i: usize)
    var s = servers.at(i)

    s.live = false
    s.handler = Value.Null
    servers.set(i, s)

// A connection has arrived. libuv guarantees exactly one per call.
private server_accepted(si: usize)
    if si >= servers.len() then return

    val s = servers.at(si)

    if !s.live then return

    socket_at(s.id, s.gen) match
        None ->
            // The program closed the listener; nothing more is coming and the slot is already gone.
            drop_server(si)
        Some(listener) ->
            listener.accept() match
                Err(e) -> loop_fails(s"a connection could not be accepted: ${e}")
                Ok(conn) ->
                    val (cid, cgen) = socket_slot(hold_socket(conn, Value.Null))
                    val ci = claim_conn(cid, cgen, si)

                    conn.read_start((r) ->
                        r match
                            Data(bytes) -> conn_read(ci, bytes)

                            // **A connection that ends before a whole request is simply dropped.**
                            // It is what a load balancer's health check does, what a browser does
                            // when a user navigates away, and what a port scanner does; a server
                            // that complained about it would complain all day.
                            End -> close_conn(ci)
                            Failed(_) -> close_conn(ci)) match
                        Err(e) ->
                            loop_fails(s"a connection could not be read: ${e}")
                            close_conn(ci)
                        Ok(_) -> ()

private claim_conn(id: usize, gen: usize, server: usize) -> usize
    for i in 0..<conns.len()
        if !conns.at(i).live
            conns.set(i, Conn(true, id, gen, server, buf(), false))
            return i

    conns.push(Conn(true, id, gen, server, buf(), false))
    conns.len() - 1

// Give the connection's slot back, which is what closes the socket.
close_conn(ci: usize)
    if ci >= conns.len() then return

    var c = conns.at(ci)

    if !c.live then return

    c.live = false
    c.got = buf()
    conns.set(ci, c)
    surrender(c.id)

// More of a request has arrived.
private conn_read(ci: usize, bytes: []const u8)
    if ci >= conns.len() then return

    var c = conns.at(ci)

    if !c.live || c.answered then return

    for b in bytes
        c.got.push(b)

    conns.set(ci, c)
    try_request(ci)

// **A request is answered once it is whole**, and this is called after every chunk because there is
// no other way to know: TCP hands over whatever has arrived, and a request may be split anywhere at
// all -- including in the middle of the blank line that ends the headers.
private try_request(ci: usize)
    var c = conns.at(ci)
    val head = header_end(c.got.view())

    if head == 0 then return

    val lines = header_lines(c.got.view(), head)

    if lines.len() == 0
        respond_plainly(ci, 400, "the request line is missing")
        return

    val length = content_length(lines)

    if length < 0
        respond_plainly(ci, 411, "this server needs a `Content-Length` on a request with a body")
        return

    if c.got.len() < head + usize(length) then return

    // From here the request is whole and the connection is answered exactly once.
    c.answered = true
    conns.set(ci, c)

    val request = request_value(ci, lines, c.got.view(), head, usize(length))

    call_handler(ci, request)

// Hand the request to the program's function, and take what it answers.
private call_handler(ci: usize, request: Value)
    val c = conns.at(ci)
    val s = servers.at(c.server)

    if !s.live
        close_conn(ci)
        return

    val mark = root_mark()

    hold(request)

    var args: Buf[Value] = buf()

    args.push(request)

    val answer = apply(s.handler, args, point(0))

    release(mark)

    answer match
        Err(sig) ->
            // **A handler that faulted is a 500 and a stopped program.** The response goes out first,
            // so the client is not left hanging, and the fault is then reported the way any other
            // fault from inside the loop is -- a defect in the program is not something to swallow
            // because it happened in a callback.
            respond_plainly(ci, 500, "this request was not answered")
            loop_fails(signal_message(sig))
        Ok(v) -> v match
            // **A handler that answers a promise is waited for**, which is the ordinary case: an
            // async function answers one, and everything a real handler does is asynchronous.
            Promise(pr) ->
                pr.handled = true

                if pr.settled
                    if pr.failed
                        respond_plainly(ci, 500, "this request was not answered")
                        loop_fails(pr.message)
                    else
                        write_response(ci, pr.value)
                else
                    watch_promise(pr, ci + 1)
            _ -> write_response(ci, v)

// A promise a handler answered has settled. **The tag is the connection's index plus one**, zero
// meaning "nothing is watching" -- see `watch_promise`.
promise_answered(tag: usize, value: Value, failed: bool, message: string)
    val ci = tag - 1

    if ci >= conns.len() then return
    if !conns.at(ci).live then return

    if failed
        respond_plainly(ci, 500, "this request was not answered")
        loop_fails(message)
    else
        write_response(ci, value)

// -- reading a request ---------------------------------------------------------------------------

// The request, as the program sees it.
//
// **Headers arrive lower-cased**, which is the one normalisation worth doing: HTTP header names are
// case-insensitive, so a program reading `req.headers["content-type"]` would otherwise have to try
// three spellings and still be wrong about the fourth.
private request_value(ci: usize, lines: Buf[string], raw: []const u8, head: usize, length: usize) -> Value
    val mark = root_mark()
    val o = new_object()

    hold(Object(o))

    val parts = split_request_line(lines.at(0))

    obj_put_name(o, "method", str_value(parts.0))
    obj_put_name(o, "path", str_value(parts.1))
    obj_put_name(o, "query", str_value(parts.2))

    val headers = new_object()

    hold(Object(headers))

    for i in 1..<lines.len()
        val line = lines.at(i)
        val colon = index_of_byte(line, u8(':'))

        if colon > 0
            obj_put_name(headers, lowered(text_before(line, colon)), str_value(trimmed_after(line, colon)))

    obj_put_name(o, "headers", Object(headers))

    // **The body is text or it is empty**, this server having no byte value to hand over. A request
    // whose body is not text is answered rather than dropped -- see `write_response`'s reasoning
    // about output that will not decode.
    var body: Buf[u8] = buf()

    for i in head..<(head + length)
        body.push(raw[i])

    val text = from_utf8(body.view()) match
        Ok(t) -> t
        Err(_) -> ""

    obj_put_name(o, "body", str_value(text))
    release(mark)
    Object(o)

// `GET /a/b?c=1 HTTP/1.1` -- the method, the path, and the query with no `?` on it.
private split_request_line(line: string) -> (string, string, string)
    val b = line.bytes
    var i: usize = 0

    while i < b.len && b[i] != u8(' ')
        i += 1

    val method = slice_text(b, 0, i)
    var j = i + 1
    var q: usize = 0

    while j < b.len && b[j] != u8(' ')
        if b[j] == u8('?') && q == 0 then q = j

        j += 1

    if q == 0 then (method, slice_text(b, i + 1, j), "") else (method, slice_text(b, i + 1, q), slice_text(b, q + 1, j))

// The header block as lines, or nothing where the request line is missing.
private header_lines(raw: []const u8, head: usize) -> Buf[string]
    var out: Buf[string] = buf()
    var start: usize = 0
    var i: usize = 0

    while i + 1 < head
        if raw[i] == u8('\r') && raw[i + 1] == u8('\n')
            if i > start
                from_utf8(raw[start..<i]) match
                    Ok(line) -> out.push(line)
                    Err(_) -> ()

            i += 2
            start = i
        else
            i += 1

    out

// How long the body is, `0` where there is none and `-1` where the request says something this
// server cannot read.
private content_length(lines: Buf[string]) -> long
    for i in 0..<lines.len()
        val line = lines.at(i)

        if header_is(line, "transfer-encoding") then return -1

        if header_is(line, "content-length")
            val n = header_value(line)
            var total: long = 0
            var any = false

            for c in n.bytes
                if c >= u8('0') && c <= u8('9')
                    total = total * 10 + long(c - u8('0'))
                    any = true

            if !any then return -1

            return total

    0

// -- writing a response --------------------------------------------------------------------------

// What a handler answered, written to the socket.
//
// **A string is a whole response**, which is what makes the first program somebody writes one line
// long: `serve(8080, req -> "hello")` is a 200 with that text in it. An object says more --
// `{ status, headers, body }` -- and every part of it is optional.
private write_response(ci: usize, v: Value)
    if ci >= conns.len() then return

    val c = conns.at(ci)

    if !c.live then return

    var status: long = 200
    var body = ""
    var extra: Buf[string] = buf()

    v match
        Str(p) -> body = p.s
        Object(o) ->
            field_from(o, "status", point(0)) match
                Ok(found) -> found.0 match
                    Int(n) -> status = n
                    _ -> ()
                Err(_) -> ()

            field_from(o, "body", point(0)) match
                Ok(found) -> found.0 match
                    Str(p) -> body = p.s
                    Undefined -> ()
                    other -> body = value_text(other)
                Err(_) -> ()

            field_from(o, "headers", point(0)) match
                Ok(found) -> found.0 match
                    Object(h) ->
                        for i in 0..<h.entries.len()
                            val e = h.entries.at(i)

                            if !e.dead
                                e.key match
                                    Str(k) -> extra.push(s"${k.s}: ${value_text(e.value)}")
                                    _ -> ()
                    _ -> ()
                Err(_) -> ()

        // **Anything else is rendered as `print` would render it**, which is what a handler that
        // answers a number or an array meant. Refusing would be refusing a program that works.
        other -> body = value_text(other)

    var out = str_builder()

    out.push(s"HTTP/1.1 ${status} ${reason(status)}\r\n")

    for i in 0..<extra.len()
        out.push(extra.at(i))
        out.push("\r\n")

    // **`Content-Length` is counted in BYTES and not in characters**, which is the one place this
    // file has to remember that a slate string is characters: a body with an `é` in it is one byte
    // longer than it is characters, and a wrong length here is a client that hangs waiting for the
    // rest of a response that has all arrived.
    out.push(s"Content-Length: ${body.bytes.len}\r\n")
    out.push("Connection: close\r\n\r\n")
    out.push(body)

    send_and_close(ci, out.finish())

// A response this file writes for itself, where there is no handler answer to write.
private respond_plainly(ci: usize, status: long, message: string)
    if ci >= conns.len() then return

    var c = conns.at(ci)

    if !c.live then return

    c.answered = true
    conns.set(ci, c)

    send_and_close(ci, s"HTTP/1.1 ${status} ${reason(status)}\r\nContent-Length: ${message.bytes.len}\r\nConnection: close\r\n\r\n${message}")

// Write it, and close when it has gone.
//
// **The close waits for the write's callback**, which is what makes the difference between a client
// reading a response and a client reading a reset connection: closing a handle with a write still
// queued on it throws the write away.
private send_and_close(ci: usize, text: string)
    val c = conns.at(ci)

    socket_at(c.id, c.gen) match
        None -> close_conn(ci)
        Some(sock) ->
            sock.write(text.bytes, (r) -> close_conn(ci)) match
                Err(_) -> close_conn(ci)
                Ok(_) -> ()

// The word beside the number. **Only the ones a handler is likely to answer with**, since a client
// reads the number and the text is for a person reading a log.
private reason(status: long) -> string
    if status == 200 then "OK"
    elif status == 201 then "Created"
    elif status == 204 then "No Content"
    elif status == 301 then "Moved Permanently"
    elif status == 302 then "Found"
    elif status == 304 then "Not Modified"
    elif status == 400 then "Bad Request"
    elif status == 401 then "Unauthorized"
    elif status == 403 then "Forbidden"
    elif status == 404 then "Not Found"
    elif status == 405 then "Method Not Allowed"
    elif status == 411 then "Length Required"
    elif status == 418 then "I'm a teapot"
    elif status == 500 then "Internal Server Error"
    elif status == 503 then "Service Unavailable"
    else "Status"

// -- the small text helpers ----------------------------------------------------------------------

private index_of_byte(s: string, c: u8) -> usize
    val b = s.bytes

    for i in 0..<b.len
        if b[i] == c then return i

    0

private text_before(s: string, at: usize) -> string = slice_text(s.bytes, 0, at)

private trimmed_after(s: string, colon: usize) -> string
    val b = s.bytes
    var i = colon + 1

    while i < b.len && (b[i] == u8(' ') || b[i] == u8('\t'))
        i += 1

    slice_text(b, i, b.len)

private slice_text(b: []const u8, from: usize, to: usize) -> string
    if from >= to || to > b.len then return ""

    from_utf8(b[from..<to]) match
        Ok(t) -> t
        Err(_) -> ""

private lowered(s: string) -> string
    var out = str_builder()

    for c in s.bytes
        out.push_char(char(u32(if c >= u8('A') && c <= u8('Z') then c + 32 else c)))

    out.finish()
