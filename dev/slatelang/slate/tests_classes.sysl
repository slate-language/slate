module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// `class`, which is sugar over the object slate could already write, and the one thing that sugar
// adds underneath: a NOMINAL identity, so `p is Square` can ask what no structural pattern can.
//
// **The parser is where all of this lives.** A class becomes a `val` holding an object literal, so
// the checker, the compiler, the machine and `show_program` are handed what a program could have
// typed itself -- which is why these tests assert on what runs rather than on a tree.

// -- the sugar ---------------------------------------------------------------------------------------

@test
a_class_is_the_object_a_program_could_have_written_itself()
    // **The desugar, asserted rather than described.** A class binds a `val` to an object literal, `from`
    // is the `proto` field, and a method is a field holding a function -- so the two programs below are
    // the same program, and nothing downstream of the parser can tell them apart.

    val sugared = Shapely + "print(Square.new(4).describe())"
    val plain = "val Shape = { kind: \"shape\", describe: self -> s\"a ${self.kind} of ${self.area()}\" }\nval Square = { proto: Shape, kind: \"square\", area: self -> self.side * self.side }\nprint({ side: 4, proto: Square }.describe())"
    
    assert_eq(out(sugared), "a square of 16")
    assert_eq(out(sugared), out(plain))

@test
a_method_is_written_in_the_ordinary_definition_syntax()
    // **This is the whole reason the word exists.** A field's value is an expression, so a method in an
    // object literal is a lambda and its body is whatever fits after `->`; a definition's body may be an
    // indented run of statements. A class of twenty methods reads like twenty functions rather than like
    // twenty fields, and that difference is the feature.

    val prog = "class Till\n    new(n) = { n: n }\n\n    report(self) =\n        val doubled = self.n * 2\n        val label = if doubled > 5 then \"big\" else \"small\"\n\n        s\"${doubled} is ${label}\"\nprint(Till.new(4).report())"
    
    assert_eq(out(prog), "8 is big")

@test
dispatch_goes_back_down_to_the_object_it_started_from()
    // `describe` lives on `Shape` and calls `area`, which only the two below it have. That is the receiver
    // rule doing the work classes usually need a keyword for.

    assert_eq(out(Shapely + "print(Square.new(3).describe())\nprint(Circle.new(2).describe())"), "a square of 9\na circle of 12")

@test
a_field_a_class_carries_is_shared_and_one_below_it_shadows()
    // `legs` on the base is read through the chain until something nearer says otherwise, which is the
    // same lookup a hand-written proto gets.

    val prog = "class A\n    val legs = 4\n\n    count(self) = self.legs\n\nclass B from A\n    val legs = 2\n\nclass C from A\nprint(B.count(), C.count())"
    
    assert_eq(out(prog), "2 4")

@test
a_class_with_no_members_is_an_empty_object()
    // A class is worth declaring for its identity alone -- a tag nothing else can be mistaken for -- so an
    // empty body is not a mistake and gets no complaint.

    assert_eq(out("class Tag\nclass Sub from Tag\nprint(keys(Tag), keys(Sub))"), "[] [\"proto\"]")

// -- the constructor ---------------------------------------------------------------------------------

@test
a_constructor_gives_what_it_answers_the_class_as_its_proto()
    // **The one piece of sugar with anything behind it.** Written out, `new(x) = { x: x }` is the object
    // literal plus the `proto:` line a program writes today -- and leaving that line out is the mistake
    // this exists to make unmakeable.

    assert_eq(out(Shapely + "val s = Square.new(5)\nprint(s.proto == Square, s.side)"), "true 5")

@test
a_constructor_takes_no_receiver_because_there_is_no_object_yet()
    // `new` is the class's OWN field rather than one reached through a proto, so the receiver rule hands
    // it nothing and its first parameter is the caller's first argument. That is not a special case for
    // `new`; it is what the rule already said.

    assert_eq(out("class P\n    new(a, b) = { sum: a + b }\nprint(P.new(2, 3).sum)"), "5")

@test
a_constructor_writes_to_what_it_answers_rather_than_copying_it()
    // **Measured rather than asserted in a comment.** `with` would have said the same thing in one node
    // and allocated a second object for every instance, on the one path where allocation is measured --
    // so the object handed back is the object the body made, and this is what tells the difference.

    val prog = "class Wrap\n    new(o) = o\nvar o = { n: 1 }\nval w = Wrap.new(o)\nprint(o is Wrap, w is Wrap)"
    
    assert_eq(out(prog), "true true")

@test
a_constructor_answering_something_that_is_not_an_object_says_so()
    // Nothing checks the body's answer in advance, because nothing could: it is an arbitrary expression.
    // What it gets instead is the ordinary complaint about writing a field on a value that has none.

    assert(fails("class Bad\n    new(n) = n\nprint(Bad.new(3))").contains("a field belongs to an object"))

// -- `is`, which is what a class adds that a proto could not ------------------------------------------

@test
is_asks_whether_an_object_was_made_from_a_class()
    // **This is what the nominal identity buys, and `p.proto == Square` gets it wrong twice over.** `==`
    // on objects is DEEP here, so it answers true for any object that happens to hold the same fields;
    // and it looks exactly one link up the chain. `is` compares identity and walks.

    assert_eq(out(Shapely + "print(Square.new(2) is Square, Circle.new(2) is Square)"), "true false")
    
    // The lookalike: same fields, made from nothing.
    assert_eq(out(Shapely + "print({ side: 2, kind: \"square\" } is Square)"), "false")

@test
is_walks_the_whole_chain_and_not_one_link()
    // A square is a shape, which is the reading a person expects and the one a single-link test would get
    // wrong. Every language that has this walks.

    assert_eq(out(Shapely + "print(Square.new(1) is Shape, Circle.new(1) is Shape)"), "true true")

@test
a_class_is_not_an_instance_of_itself()
    // `Square is Square` is false, which is JavaScript's answer and the one the walk gives for free: the
    // test starts at the object's proto rather than at the object, so a class would have to point at
    // itself to match.

    assert_eq(out(Shapely + "print(Square is Square, Square is Shape)"), "false true")

@test
is_against_a_class_is_false_for_a_value_that_has_no_fields_at_all()
    // A pattern may not fault, so a number asked whether it was made from a class simply answers no.

    assert_eq(out(Shapely + "print(3 is Square, null is Square, \"s\" is Square)"), "false false false")

@test
a_class_name_may_be_bound_and_tested_in_one_pattern()
    // `n @ Square` is the spelling slate already had for testing and naming at once, and a class name
    // stands where any other type does.

    val prog = Shapely + "for s in [Square.new(2), Circle.new(1)]\n    print(s match\n        q @ Square -> s\"square ${q.side}\"\n        c @ Circle -> s\"circle ${c.r}\"\n        _ -> \"?\")"
    
    assert_eq(out(prog), "square 2\ncircle 1")

@test
an_annotation_naming_a_class_accepts_anything_made_from_it()
    // The annotation is the same `CheckType` any type gets, so a class costs the checker nothing and the
    // chain means what it means everywhere else.

    assert_eq(out(Shapely + "area(s: Shape) = s.area()\nprint(area(Square.new(3)))"), "9")
    assert(fails(Shapely + "area(s: Square) = s.area()\nprint(area(Circle.new(3)))").contains("was declared Square"))

// -- overriding, and reaching what was overridden -----------------------------------------------------

@test
the_base_class_is_how_a_method_reaches_the_one_it_overrides()
    // **There is no `super`, and none is needed.** A base is an ordinary value in scope, and its method is
    // its OWN field -- so the receiver rule hands it nothing and `Shape.describe(self)` passes the
    // receiver explicitly. That is lexically right where `self.proto.proto` would not be: it names the
    // class the call was written in rather than counting links from whatever object turned up.

    val prog = "class A\n    tell(self) = \"A\"\n\nclass B from A\n    tell(self) = \"B(\" + A.tell(self) + \")\"\n\nclass C from B\n    tell(self) = \"C(\" + B.tell(self) + \")\"\nprint(C.tell({ proto: C }))"
    
    assert_eq(out(prog), "C(B(A))")

@test
a_method_may_be_a_generator_or_async()
    // `parse_def` reads the member, so everything a definition already has comes with it: `async`, `yield`,
    // parameter annotations, a result annotation, and a destructuring parameter.

    val gen = "class R\n    new(n) = { n: n }\n\n    each(me) =\n        for i in 0..<me.n\n            yield i\nvar out = []\nfor i in R.new(3).each()\n    out.push(i)\nprint(out)"
    val asy = "class R\n    new(n) = { n: n }\n\n    async twice(me) = me.n * 2\nasync main() =\n    print(await R.new(4).twice())\nmain()"
    
    assert_eq(out(gen), "[0, 1, 2]")
    assert_eq(out(asy), "8")

// -- across a file ------------------------------------------------------------------------------------

@test
a_class_crosses_a_file_as_a_value_and_as_a_type()
    // **A class is the one declaration that is both, and both halves have to cross.** An ordinary type has
    // no runtime existence, so importing one binds nothing; a class is an object sitting in that module
    // and the import has to fetch it. The pattern itself says which is which.
    //
    // **The alias is the part that would have failed silently.** Under `Bird as Tweeter` the object is
    // bound as `Tweeter`, so a pattern still asking for `Bird` would look up a name that is not there --
    // and a pattern has nowhere to report from, so it would simply have matched nothing.

    assert_eq(ran_out("tests/mods/uses_menagerie.sl"), "robin says tweet on 2 legs\ntrue true\nrobin\nbound\ntrue false")

@test
what_a_file_did_not_export_is_neither_a_value_nor_a_type_elsewhere()
    // `Ghost` is a class the fixture keeps to itself, so in the importing file the bare name is an ordinary
    // binding -- which is the rule every other name follows and the one `export type` already had.

    assert(ran_out("tests/mods/uses_menagerie.sl").contains("bound"))

// -- what a class body refuses ------------------------------------------------------------------------

@test
a_member_given_twice_is_refused()
    // An object literal lets a later key win, which is right for data assembled from parts. A class body is
    // one declaration a person sat down and wrote, and two methods of one name in it are a mistake nobody
    // meant and that nothing else would ever report.

    assert(fails("class A\n    area(self) = 1\n\n    area(self) = 2\nprint(A)").contains("`area` is given twice in class `A`"))

@test
a_var_member_is_refused_with_what_it_would_have_meant()
    // There is one of each member for every object made from the class, so a mutable one is a single value
    // standing behind all of them -- the thing a person writing `var` here is least likely to want. A
    // silent `val` would have hidden the misunderstanding rather than answered it.

    val said = fails("class A\n    var n = 1\nprint(A)")
    
    assert(said.contains("shared by every object made from it"))
    assert(said.contains("put what differs from object to object on the object"))

@test
a_class_body_holds_definitions_and_vals_and_nothing_else()
    // A statement in a class body has nowhere to go: the body is not run, it is turned into an object.

    assert(fails("class A\n    print(\"hi\")\nprint(A)").contains("a class body holds definitions and `val`s"))

@test
a_constructor_may_not_be_async()
    // An `async` constructor would answer a promise with the object still to come, so `Point.new(1, 2)`
    // would hand back something that is not a point and has no proto to give it one.

    assert(fails("class A\n    async new(x) = { x: x }\nprint(A)").contains("a constructor cannot be `async`"))

@test
a_class_may_not_say_from_and_give_a_proto_both()
    // They are the same field written two ways, and nothing decides which wins that would not surprise
    // half the readers.

    assert(fails("class B\n    val q = 1\n\nclass A from B\n    val proto = B\nprint(A)").contains("says `from` and also gives a `proto`"))

@test
a_class_belongs_to_the_top_level_of_a_file()
    // Its name is a type as well as a value, and a type is resolved while compiling -- so one declared
    // inside a block would not be there for `is` to resolve against. This is `type`'s rule, for `type`'s
    // reason.

    assert(fails("f() =\n    class A\n        g(self) = 1\n\n    A\nprint(f())").contains("a class belongs to the top level"))

@test
is_follows_the_name_at_run_time_and_so_a_shadow_changes_it()
    // **The name is looked up where the match runs**, which is what `instanceof` does too -- a
    // pattern lives in the unit's table and is shared by every frame that reaches it, so it cannot
    // have captured a binding.
    //
    // **A shadow that is not a class answers NO rather than complaining**, because nothing a pattern
    // does may fail: `match` has to be able to try an arm and move on. TypeScript throws on
    // `x instanceof 3` and this cannot, which is the honest cost of that rule and is written down
    // rather than dressed up.
    val prog = "class A\n    new(x) = { x: x }\nval a = A.new(1)\nf(A) = a is A\nprint(f(A), f(3))"

    assert_eq(out(prog), "true false")

// -- what an interface would need, and does not have yet ----------------------------------------------

@test
an_object_pattern_reads_a_values_own_fields_and_not_its_protos()
    // **Pinned because it is a DECISION, not because it is right.** `.` follows the proto chain and an
    // object pattern does not, so a class that inherits `draw` fails `is { draw: function }` while the
    // class it inherited from passes. JavaScript splits the same way -- `in` walks, `hasOwnProperty`
    // does not -- so there is a real argument on both sides.
    //
    // **It is what stands between slate and TypeScript's `implements`.** A `type` over function fields
    // is already an interface, and a class satisfying one could be checked where the class is
    // declared; but a subclass would wrongly fail, its methods being one link up. Changing this would
    // change what `is` means for every object, which is why it is written down rather than done.
    val prog = "type Drawable = { draw: function }\n\nclass Base\n    draw(self) = \"drawn\"\n\nclass Sub from Base\n    val n = 1\nprint(Base is Drawable, Sub is Drawable, { draw: () -> 1 } is Drawable)"

    assert_eq(out(prog), "true false true")

@test
class_is_a_soft_word()
    // **Two tokens settle it**, as `type` and `end` are settled: a bare name followed by another bare name
    // begins nothing else in slate, there being no juxtaposition anywhere in the grammar. So a program
    // that was already calling a variable `class` is untouched.

    assert_eq(out("val class = 1\n\nclass Point\n    new(x) = { x: x }\nprint(class, Point.new(2).x)"), "1 2")
