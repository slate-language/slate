module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// `class`, which is sugar over the object slate could already write, and the one thing that sugar
// adds underneath: a NOMINAL identity, so `p is Square` can ask what no structural pattern can.
//
// **The parser is where all of this lives.** A class becomes a `val` holding an object literal, so
// the checker, the compiler, the machine and `show_program` are handed what a program could have
// typed itself -- which is why these tests assert on what runs rather than on a tree.

// -- the sugar ---------------------------------------------------------------------------------------

@test
a_class_is_the_object_a_program_could_have_written_itself()
    // **The desugar, asserted rather than described.** A class binds a `val` to an object literal, `from`
    // is the `proto` field, and a method is a field holding a function -- so the two programs below are
    // the same program, and nothing downstream of the parser can tell them apart.

    val sugared = Shapely + "print(Square.new(4).describe())"
    val plain = "val Shape = { kind: \"shape\", describe: self -> s\"a ${self.kind} of ${self.area()}\" }\nval Square = { proto: Shape, kind: \"square\", area: self -> self.side * self.side }\nprint({ side: 4, proto: Square }.describe())"
    
    assert_eq(out(sugared), "a square of 16")
    assert_eq(out(sugared), out(plain))

@test
a_method_is_written_in_the_ordinary_definition_syntax()
    // **This is the whole reason the word exists.** A field's value is an expression, so a method in an
    // object literal is a lambda and its body is whatever fits after `->`; a definition's body may be an
    // indented run of statements. A class of twenty methods reads like twenty functions rather than like
    // twenty fields, and that difference is the feature.

    val prog = "class Till\n    new(n) = { n: n }\n\n    report(self) =\n        val doubled = self.n * 2\n        val label = if doubled > 5 then \"big\" else \"small\"\n\n        s\"${doubled} is ${label}\"\nprint(Till.new(4).report())"
    
    assert_eq(out(prog), "8 is big")

@test
dispatch_goes_back_down_to_the_object_it_started_from()
    // `describe` lives on `Shape` and calls `area`, which only the two below it have. That is the receiver
    // rule doing the work classes usually need a keyword for.

    assert_eq(out(Shapely + "print(Square.new(3).describe())\nprint(Circle.new(2).describe())"), "a square of 9\na circle of 12")

@test
a_field_a_class_carries_is_shared_and_one_below_it_shadows()
    // `legs` on the base is read through the chain until something nearer says otherwise, which is the
    // same lookup a hand-written proto gets.

    val prog = "class A\n    val legs = 4\n\n    count(self) = self.legs\n\nclass B from A\n    val legs = 2\n\nclass C from A\nprint(B.count(), C.count())"
    
    assert_eq(out(prog), "2 4")

@test
a_class_with_no_members_is_an_empty_object()
    // A class is worth declaring for its identity alone -- a tag nothing else can be mistaken for -- so an
    // empty body is not a mistake and gets no complaint.

    // **`Sub`'s `proto` is the base class**, which is machinery rather than a field somebody wrote --
    // so neither answers a key, and the class is as empty as it looks.
    assert_eq(out("class Tag\nclass Sub from Tag\nprint(keys(Tag), keys(Sub))"), "[] []")

// -- the constructor ---------------------------------------------------------------------------------

@test
a_constructor_gives_what_it_answers_the_class_as_its_proto()
    // **The one piece of sugar with anything behind it.** Written out, `new(x) = { x: x }` is the object
    // literal plus the `proto:` line a program writes today -- and leaving that line out is the mistake
    // this exists to make unmakeable.

    assert_eq(out(Shapely + "val s = Square.new(5)\nprint(s.proto == Square, s.side)"), "true 5")

@test
a_constructor_takes_no_receiver_because_there_is_no_object_yet()
    // `new` is the class's OWN field rather than one reached through a proto, so the receiver rule hands
    // it nothing and its first parameter is the caller's first argument. That is not a special case for
    // `new`; it is what the rule already said.

    assert_eq(out("class P\n    new(a, b) = { sum: a + b }\nprint(P.new(2, 3).sum)"), "5")

@test
a_constructor_writes_to_what_it_answers_rather_than_copying_it()
    // **Measured rather than asserted in a comment.** `with` would have said the same thing in one node
    // and allocated a second object for every instance, on the one path where allocation is measured --
    // so the object handed back is the object the body made, and this is what tells the difference.

    val prog = "class Wrap\n    new(o) = o\nvar o = { n: 1 }\nval w = Wrap.new(o)\nprint(o is Wrap, w is Wrap)"
    
    assert_eq(out(prog), "true true")

@test
a_constructor_answering_something_that_is_not_an_object_says_so()
    // Nothing checks the body's answer in advance, because nothing could: it is an arbitrary expression.
    // What it gets instead is the ordinary complaint about writing a field on a value that has none.

    assert(fails("class Bad\n    new(n) = n\nprint(Bad.new(3))").contains("a field belongs to an object"))

// -- fields, and the constructor they imply -----------------------------------------------------------

@test
var_declares_a_field_each_object_gets_and_val_one_the_class_holds()
    // **The distinction the two words carry, and the reason both exist.** `val` is the class's, one of it
    // however many objects there are; `var` is each object's. Reading them the other way round is the
    // trap the next test is about.

    val prog = Boxy + "print(keys(Box))\nprint(keys(Box.new(1)))"

    // The class holds its `val` and its methods. `new` is there because fields were declared.
    assert_eq(out(prog), "[\"tag\", \"peek\", \"new\"]\n[\"v\", \"seen\"]")

@test
an_initialiser_on_a_field_runs_once_per_object()
    // **This is what `var` buys over `val`, measured.** The initialiser is an expression put inside the
    // constructor rather than evaluated once for the class, so every object gets its own array. Under
    // `val` all of them would share one -- which is Python's oldest mistake and TypeScript's `items = []`
    // read wrongly.

    val prog = Boxy + "val a = Box.new(1)\nval b = Box.new(2)\na.seen.push(\"x\")\nprint(a.seen, b.seen)"

    assert_eq(out(prog), "[\"x\"] []")

@test
a_class_that_declares_fields_gets_a_constructor_that_takes_them()
    // **Every field is a parameter, and one with an initialiser is OPTIONAL** -- that initialiser is
    // its default. So a class says what a field normally is and a call may still say otherwise, and
    // the arity of `new` is a range rather than a number.

    assert_eq(out(Boxy + "print(Box.new(7).peek())"), "7 first")
    assert_eq(out(Boxy + "print(Box.new(7, [\"a\"]).seen)"), "[\"a\"]")

    val over = fails(Boxy + "print(Box.new(7, [], 1))")

    assert(over.contains("takes from 1 to 2 arguments"))
    assert(over.contains("was given 3"))
    assert(fails(Boxy + "print(Box.new())").contains("was given 0"))

@test
an_initialised_field_may_be_given_a_value_at_the_call()
    // **The default is worked out at the call**, so leaving it out means what it has always meant --
    // the initialiser runs, once per object -- and giving it jumps those instructions over entirely.
    // A field whose default is expensive costs nothing to a call that says otherwise.

    val prog = Boxy + "val a = Box.new(1, [\"x\"])\nval b = Box.new(2)\nb.seen.push(\"y\")\nprint(a.seen, b.seen, Box.new(3).seen)"

    assert_eq(out(prog), "[\"x\"] [\"y\"] []")

@test
an_initialised_field_declared_first_still_comes_last_in_the_constructor()
    // **A default has to be trailing, so the parameters are the fields with no initialiser and then
    // the rest**, which is not the declaration order when an initialised field was written first.
    // Refusing this class instead -- Python's answer for a dataclass -- would break classes that
    // compile today to buy a rule nobody asked for.

    val prog = "class Box\n    var kind = \"plain\"\n    var side\nval b = Box.new(2, \"fancy\")\nprint(b.side, b.kind, Box.new(3).kind)"

    assert_eq(out(prog), "2 fancy plain")

@test
an_initialiser_may_read_a_field_bound_before_it()
    // The defaults bind in order like any others, so a field's initialiser sees the parameters to its
    // left. The object literal could already do that for a field a parameter SUPPLIED, and could not
    // do it for one initialised here, which is a gap this closed on the way past.

    val prog = "class Sq\n    var side\n    var area = side * side\n    var label = s\"${side}x${side}\"\nval s = Sq.new(3)\nprint(s.area, s.label, Sq.new(2, 99).area)"

    assert_eq(out(prog), "9 3x3 99")

@test
a_class_that_declares_nothing_gets_no_constructor()
    // **Rather than one answering an object with nothing in it.** `{ proto: Square }` compiles, runs, and
    // faults later at the first field nobody set, which moves the complaint away from the mistake. A
    // class with no declarations is still instantiated by the literal that worked before classes existed.

    assert_eq(out("class Tag\n    hi(self) = \"hi\"\nprint(keys(Tag))\nprint({ proto: Tag }.hi())"), "[\"hi\"]\nhi")

@test
a_field_and_a_member_share_one_namespace()
    // An object reaches both through the same `.`, so a field and a method of one name would be one of
    // them and silently not the other.

    assert(fails("class A\n    var n\n\n    n(self) = 1\nprint(A)").contains("`n` is given twice"))
    assert(fails("class A\n    var n\n    var n = 2\nprint(A)").contains("`n` is given twice"))

// -- a constructor that names its own fields ---------------------------------------------------------

@test
a_var_parameter_declares_a_field_and_assigns_it()
    // **TypeScript's parameter property, wearing slate's word for "one of these per object".** TS needs
    // `constructor(private x: number)` because otherwise it writes `this.x = x` by hand; here the same
    // boilerplate is what the generated constructor already removes, so this form is for the constructor
    // that has something else to do as well.

    assert_eq(out(Recty + "print(Rect.new(3, 4).describe())"), "3x4 = 12")

@test
a_constructor_that_names_its_fields_runs_its_body_with_self_bound()
    // **The one shape where a constructor body has an object to talk about.** An ordinary `new` is called
    // before there is one, which is why it is handed no receiver; a `new` that names its fields has
    // already made the object by the time the body runs, so `self` is what is being made.
    //
    // The body's value is discarded -- it runs for its effect, and the object is what comes back.

    // `area` is computed in the body from two parameters, which nothing else could have done.
    assert_eq(out(Recty + "print(Rect.new(2, 5).area)"), "10")

    // And it may refuse to build one at all.
    assert_eq(out(Recty + "try\n    Rect.new(-1, 2)\ncatch e\n    print(e.message)"), "a side cannot be negative")

@test
a_field_with_an_initialiser_is_still_filled_when_the_constructor_names_others()
    // `tags` is not a parameter of `new`, so it comes from its own declaration -- once per object, as
    // always.

    val prog = Recty + "val r = Rect.new(1, 1)\nr.tags.push(\"a\")\nprint(r.tags, Rect.new(1, 1).tags)"

    assert_eq(out(prog), "[\"a\"] []")

@test
a_var_parameter_belongs_to_a_classs_new_and_nowhere_else()
    // Elsewhere it would be a parameter quietly writing a field on an object the function has no business
    // knowing about.  **The lookahead admits it and `parse_def` judges it**, so the complaint says what is
    // wrong rather than "this is not a definition".

    assert(fails("f(var x) = x\nprint(f(1))").contains("only a class's `new` is making"))
    assert(fails("class A\n    m(self, var x) = x\nprint(A)").contains("only a class's `new` is making"))

@test
a_class_that_declares_fields_may_not_write_a_constructor_that_ignores_them()
    // A `new` that builds the object itself leaves nothing to fill the declarations, and a reader who
    // wrote `var tags = []` above it would reasonably expect otherwise. The message names the spelling
    // that works.

    val said = fails("class Bag\n    var side\n\n    new(side) = { side: side }\nprint(Bag)")

    assert(said.contains("has to name the ones it takes"))
    assert(said.contains("new(var side)"))

@test
a_class_with_no_declared_fields_still_takes_the_plain_constructor()
    // **The form everything written before field declarations used, unchanged.** The body's value is the
    // object and it is given the class as its proto on the way out.

    assert_eq(out("class Box\n    new(v) = { v: v }\n\n    get(self) = self.v\nprint(Box.new(7).get(), Box.new(7) is Box)"), "7 true")

// -- `is`, which is what a class adds that a proto could not ------------------------------------------

@test
is_asks_whether_an_object_was_made_from_a_class()
    // **This is what the nominal identity buys, and `p.proto == Square` gets it wrong twice over.** `==`
    // on objects is DEEP here, so it answers true for any object that happens to hold the same fields;
    // and it looks exactly one link up the chain. `is` compares identity and walks.

    assert_eq(out(Shapely + "print(Square.new(2) is Square, Circle.new(2) is Square)"), "true false")
    
    // The lookalike: same fields, made from nothing.
    assert_eq(out(Shapely + "print({ side: 2, kind: \"square\" } is Square)"), "false")

@test
is_walks_the_whole_chain_and_not_one_link()
    // A square is a shape, which is the reading a person expects and the one a single-link test would get
    // wrong. Every language that has this walks.

    assert_eq(out(Shapely + "print(Square.new(1) is Shape, Circle.new(1) is Shape)"), "true true")

@test
a_class_is_not_an_instance_of_itself()
    // `Square is Square` is false, which is JavaScript's answer and the one the walk gives for free: the
    // test starts at the object's proto rather than at the object, so a class would have to point at
    // itself to match.

    assert_eq(out(Shapely + "print(Square is Square, Square is Shape)"), "false true")

@test
is_against_a_class_is_false_for_a_value_that_has_no_fields_at_all()
    // A pattern may not fault, so a number asked whether it was made from a class simply answers no.

    assert_eq(out(Shapely + "print(3 is Square, null is Square, \"s\" is Square)"), "false false false")

@test
a_class_name_may_be_bound_and_tested_in_one_pattern()
    // `n @ Square` is the spelling slate already had for testing and naming at once, and a class name
    // stands where any other type does.

    val prog = Shapely + "for s in [Square.new(2), Circle.new(1)]\n    print(s match\n        q @ Square -> s\"square ${q.side}\"\n        c @ Circle -> s\"circle ${c.r}\"\n        _ -> \"?\")"
    
    assert_eq(out(prog), "square 2\ncircle 1")

@test
an_annotation_naming_a_class_accepts_anything_made_from_it()
    // The annotation is the same `CheckType` any type gets, so a class costs the checker nothing and the
    // chain means what it means everywhere else.

    assert_eq(out(Shapely + "area(s: Shape) = s.area()\nprint(area(Square.new(3)))"), "9")
    assert(fails(Shapely + "area(s: Square) = s.area()\nprint(area(Circle.new(3)))").contains("was declared Square"))

// -- overriding, and reaching what was overridden -----------------------------------------------------

@test
the_base_class_is_how_a_method_reaches_the_one_it_overrides()
    // **There is no `super`, and none is needed.** A base is an ordinary value in scope, and its method is
    // its OWN field -- so the receiver rule hands it nothing and `Shape.describe(self)` passes the
    // receiver explicitly. That is lexically right where `self.proto.proto` would not be: it names the
    // class the call was written in rather than counting links from whatever object turned up.

    val prog = "class A\n    tell(self) = \"A\"\n\nclass B from A\n    tell(self) = \"B(\" + A.tell(self) + \")\"\n\nclass C from B\n    tell(self) = \"C(\" + B.tell(self) + \")\"\nprint(C.tell({ proto: C }))"
    
    assert_eq(out(prog), "C(B(A))")

@test
a_method_may_be_a_generator_or_async()
    // `parse_def` reads the member, so everything a definition already has comes with it: `async`, `yield`,
    // parameter annotations, a result annotation, and a destructuring parameter.

    val gen = "class R\n    new(n) = { n: n }\n\n    each(me) =\n        for i in 0..<me.n\n            yield i\nvar out = []\nfor i in R.new(3).each()\n    out.push(i)\nprint(out)"
    val asy = "class R\n    new(n) = { n: n }\n\n    async twice(me) = me.n * 2\nasync main() =\n    print(await R.new(4).twice())\nmain()"
    
    assert_eq(out(gen), "[0, 1, 2]")
    assert_eq(out(asy), "8")

// -- across a file ------------------------------------------------------------------------------------

@test
a_class_crosses_a_file_as_a_value_and_as_a_type()
    // **A class is the one declaration that is both, and both halves have to cross.** An ordinary type has
    // no runtime existence, so importing one binds nothing; a class is an object sitting in that module
    // and the import has to fetch it. The pattern itself says which is which.
    //
    // **The alias is the part that would have failed silently.** Under `Bird as Tweeter` the object is
    // bound as `Tweeter`, so a pattern still asking for `Bird` would look up a name that is not there --
    // and a pattern has nowhere to report from, so it would simply have matched nothing.

    assert_eq(ran_out("tests/mods/uses_menagerie.sl"), "robin says tweet on 2 legs\ntrue true\nrobin\nbound\ntrue false\nspeaks\ntrue true false\nBird true false\ntrue [{path: \"\", wanted: \"Animal\", got: \"integer\"}]")

@test
A_TYPE_DECLARATION_MAY_NAME_A_TYPE_ANOTHER_FILE_EXPORTED()
    // **`type Winged = Tweeter` was REFUSED and `b is Tweeter` on the line above it was not**, which
    // is two answers to one question about one name. `open_types` ran `check_type_shapes` before it
    // opened the imported types, so every imported type looked like a name the declaration was
    // binding -- and the refusal it drew talked about binding, which is not what the reader wrote.
    //
    // What it cost is the whole of building on somebody else's vocabulary: no alias, no
    // `{ at: Point }`, nothing. `pg` hit it re-exporting a `Decimal` and `slate:http`'s `Request`
    // could not have been composed either.

    assert(ran_out("tests/mods/uses_menagerie.sl").contains("true true false"))

@test
what_a_file_did_not_export_is_neither_a_value_nor_a_type_elsewhere()
    // `Ghost` is a class the fixture keeps to itself, so in the importing file the bare name is an ordinary
    // binding -- which is the rule every other name follows and the one `export type` already had.

    assert(ran_out("tests/mods/uses_menagerie.sl").contains("bound"))

// -- what a class body refuses ------------------------------------------------------------------------

@test
a_member_given_twice_is_refused()
    // An object literal lets a later key win, which is right for data assembled from parts. A class body is
    // one declaration a person sat down and wrote, and two methods of one name in it are a mistake nobody
    // meant and that nothing else would ever report.

    assert(fails("class A\n    area(self) = 1\n\n    area(self) = 2\nprint(A)").contains("`area` is given twice in class `A`"))

@test
a_mutable_literal_under_val_is_refused_with_what_it_would_have_meant()
    // **The trap this exists to stop, and TypeScript is why it is a trap.** `items = []` in a TS class
    // body is a NEW array per instance; the same words under `val` here would be one array every object
    // pushes to, which is Python's oldest mistake arriving through a door that looks like TS's.
    //
    // **Only a LITERAL is refused.** A shared object bound outside the class and named here is sharing
    // somebody asked for, and it still compiles -- which is what keeps this a nudge rather than a wall.
    val said = fails("class Bag\n    val items = []\nprint(Bag)")

    assert(said.contains("every object made from the class shares that one"))
    assert(said.contains("Write `var items = ...` for one per object"))
    assert_eq(out("val Defaults = { retries: 3 }\n\nclass C\n    val defaults = Defaults\nprint(C.defaults.retries)"), "3")

@test
a_class_body_holds_definitions_and_vals_and_vars_and_nothing_else()
    // A statement in a class body has nowhere to go: the body is not run, it is turned into an object.
    assert(fails("class A\n    print(\"hi\")\nprint(A)").contains("a class body holds definitions, `val`s and `var`s"))

@test
a_constructor_may_not_be_async()
    // An `async` constructor would answer a promise with the object still to come, so `Point.new(1, 2)`
    // would hand back something that is not a point and has no proto to give it one.

    assert(fails("class A\n    async new(x) = { x: x }\nprint(A)").contains("a constructor cannot be `async`"))

@test
a_class_may_not_say_from_and_give_a_proto_both()
    // They are the same field written two ways, and nothing decides which wins that would not surprise
    // half the readers.

    assert(fails("class B\n    val q = 1\n\nclass A from B\n    val proto = B\nprint(A)").contains("says `from` and also gives a `proto`"))

@test
a_class_belongs_to_the_top_level_of_a_file()
    // Its name is a type as well as a value, and a type is resolved while compiling -- so one declared
    // inside a block would not be there for `is` to resolve against. This is `type`'s rule, for `type`'s
    // reason.

    assert(fails("f() =\n    class A\n        g(self) = 1\n\n    A\nprint(f())").contains("a class belongs to the top level"))

@test
is_follows_the_name_at_run_time_and_so_a_shadow_changes_it()
    // **The name is looked up where the match runs**, which is what `instanceof` does too -- a
    // pattern lives in the unit's table and is shared by every frame that reaches it, so it cannot
    // have captured a binding.
    //
    // **A shadow that is not a class answers NO rather than complaining**, because nothing a pattern
    // does may fail: `match` has to be able to try an arm and move on. TypeScript throws on
    // `x instanceof 3` and this cannot, which is the honest cost of that rule and is written down
    // rather than dressed up.
    val prog = "class A\n    new(x) = { x: x }\nval a = A.new(1)\nf(A) = a is A\nprint(f(A), f(3))"

    assert_eq(out(prog), "true false")

// -- interfaces, and the promise a class makes about one ----------------------------------------------

@test
an_object_pattern_counts_a_field_a_proto_supplies()
    // **A pattern asks the question `.` answers.** `o.draw` walks the chain, so a pattern reading only
    // own fields disagreed with the very expression a program writes after matching -- and every
    // subclass failed the interface its base implements, which is what a `type` over function fields
    // is for. JavaScript splits the same seam and puts `in` on this side of it; `hasOwnProperty` is
    // the other question, and slate has never had syntax for it.
    //
    // **Changed 2026-08-29, and nothing else in the suite noticed** -- 996 tests, and the only one
    // that moved was the one pinning the old answer.
    val prog = "type Drawable = { draw: function }\n\nclass Base\n    draw(self) = \"drawn\"\n\nclass Sub from Base\n    val n = 1\nprint(Base is Drawable, Sub is Drawable, { draw: () -> 1 } is Drawable)"

    assert_eq(out(prog), "true true true")

    // A field a proto supplies is taken apart by a binding too, for the same reason.
    assert_eq(out("val P = { kind: \"p\" }\nval { kind } = { proto: P }\nprint(kind)"), "p")

@test
a_class_may_promise_a_type_and_the_promise_is_checked_where_it_is_made()
    // **TypeScript's `implements`, spelled with the word slate already tests with.** It inherits nothing
    // -- `from` does that -- and only checks, so the fault lands on the class that got it wrong rather
    // than on whichever call first wanted the missing method.
    //
    // **The message is `CheckType`'s because the object is bound under the CLASS's own name** inside the
    // block that checks it, which is the whole trick: a temporary would have put an unspellable binding
    // in the complaint.

    assert_eq(out(Drawn + "class Pen is Drawable\n    draw(self) = \"pen\"\nprint(Pen.draw(Pen))"), "pen")

    val said = fails(Drawn + "class Pen is Drawable\n    area(self) = 1\nprint(Pen)")

    assert(said.contains("`Pen` was declared Drawable"))

@test
a_promise_is_kept_by_a_method_a_base_supplies()
    // **The case that decided the object-pattern rule.** A subclass whose `draw` is one link up satisfies
    // the interface its base implements, which is the only reading under which `implements` is worth
    // having at all.

    val prog = Drawn + "class Base is Drawable\n    draw(self) = \"drawn\"\n\nclass Sub from Base is Drawable\n    var n\nprint(Sub.new(1).draw(), Sub.new(1) is Drawable)"

    assert_eq(out(prog), "drawn true")

@test
a_class_may_promise_several_types()
    // They compose, there being nothing to inherit and so nothing to conflict. TypeScript allows the same
    // list for the same reason.

    val prog = Drawn + "type Named = { name: string }\n\nclass Pen is Drawable, Named\n    val name = \"pen\"\n\n    draw(self) = \"pen\"\nprint(Pen.name)"

    assert_eq(out(prog), "pen")
    assert(fails(Drawn + "type Named = { name: string }\n\nclass Pen is Drawable, Named\n    draw(self) = \"pen\"\nprint(Pen)").contains("was declared Named"))

@test
a_base_may_be_written_out_in_full_before_a_promise()
    // **`is` is an ordinary operator, so the base expression had to be stopped before it.** Left to a
    // plain `parse_expr` the header `class Square from Shape is Drawable` read its base as the test
    // `Shape is Drawable` and ended there, and the complaint landed on the comma of the next promise.
    // That is the match-arm guard's bug wearing a different operator, and the same fix.
    //
    // A base that really is an `is` test wants parentheses, which is what they are for.

    // `draw` reaches `Biro` through its proto, so the receiver rule supplies it and the call takes none.
    val prog = Drawn + "val Shapes = { Pen: { draw: self -> \"pen\" } }\n\nclass Biro from Shapes.Pen is Drawable\nprint(Biro.draw())"

    assert_eq(out(prog), "pen")

@test
a_promise_naming_something_that_is_not_a_type_is_refused()
    // A bare name in pattern position is a binding where it names no type, and a binding matches
    // anything -- so this would have been a promise that could not fail, which is worse than no promise
    // because the reader believes it.

    assert(fails("class A is Nope\n    f(self) = 1\nprint(A)").contains("`Nope` is not a type, so checking `A` against it would check nothing"))

@test
a_promise_crosses_a_file_with_the_type_it_names()
    // `export type` is how the interface travels, and it is the rule every other name follows.

    assert_eq(ran_out("tests/mods/uses_menagerie.sl"), "robin says tweet on 2 legs\ntrue true\nrobin\nbound\ntrue false\nspeaks\ntrue true false\nBird true false\ntrue [{path: \"\", wanted: \"Animal\", got: \"integer\"}]")

@test
class_is_a_soft_word()
    // **Two tokens settle it**, as `type` and `end` are settled: a bare name followed by another bare name
    // begins nothing else in slate, there being no juxtaposition anywhere in the grammar. So a program
    // that was already calling a variable `class` is untouched.

    assert_eq(out("val class = 1\n\nclass Point\n    new(x) = { x: x }\nprint(class, Point.new(2).x)"), "1 2")

// -- an object with a `new` is callable ----------------------------------------------------------

@test
CALLING_A_CLASS_IS_CALLING_ITS_new()
    // **`Square(4)` and `Square.new(4)` are one thing said two ways**, which is what every language with
    // classes lets a reader write and what a data variant needs to read like a constructor. The lookup is
    // the one `.` does, so nothing new decides where the `new` comes from.

    assert_eq(out("""
        class Square
            var side

            area(self) = self.side * self.side
        print(Square(4).area(), Square.new(4).area())
        """), "16 16")

@test
A_CALLED_OBJECT_WITH_NO_new_IS_TOLD_WHAT_IS_MISSING()
    // **The reader has to learn that calling an object is a real thing before learning that this one
    // cannot be.** "an object is not something that can be called" is true of the value in front of them
    // and sends them to rewrite a call that was right; what is wrong is the object.

    assert(fails("val o = { x: 1 }\no()").contains("an object is called only where it has a `new`, and this one has none"))

@test
A_CLASS_MAY_BE_HANDED_TO_ANYTHING_THAT_CALLS()
    // The other call path: a function reached from a native rather than from a call the compiler emitted.
    // Without the same rule there, `map(xs, Box)` would refuse an object one line after `Box(1)` worked --
    // and the two paths disagreeing about what is callable is exactly the kind of seam nobody finds.

    assert_eq(out("""
        class Box
            var v
        print(map([1, 2, 3], Box).map(b -> b.v))
        """), "[1, 2, 3]")

@test
A_new_REACHED_THROUGH_A_PROTO_IS_HANDED_NO_RECEIVER()
    // A method found on a proto is handed the object it was found on; a `new` never is, there being no
    // object yet to hand it. So an inherited `new` builds exactly what a written one builds, and both
    // spellings stay the same program.

    assert_eq(out("""
        class Base
            new(n) = { n: n }

        class Sub from Base
        print(Sub(5).n, Sub.new(5).n)
        """), "5 5")

@test
AN_INHERITED_new_USED_TO_BE_HANDED_THE_CLASS_AND_FAULT()
    // **The regression test for what the rule above fixed.** A class with no `new` of its own found its
    // base's through the proto chain, where the receiver rule handed it the class as a first argument --
    // so `Sub.new(5)` said *"this function takes 1 argument and was given 2"*, naming the arity of a
    // constructor the reader never wrote. An inherited constructor was simply not callable, and nothing
    // said so.

    assert_eq(out("""
        class Base
            new(a, b) = { total: a + b }

        class Mid from Base
        class Leaf from Mid
        print(Leaf.new(2, 3).total, Leaf(2, 3).total)
        """), "5 5")

// -- taking a class apart in a pattern ---------------------------------------------------------------

// **Two classes whose fields are `var`s, which is what gives them a constructor made from a field
// list.** `Shapely` above writes its own `new`, so it is the other case on purpose and is used below
// to assert the refusal.
private const PointAndLine: string = "class Point\n    var x\n    var y\n\nclass Line\n    var a\n    var b\n"

@test
A_CLASS_IS_TAKEN_APART_BY_POSITION_LIKE_A_DATA_VARIANT()
    // **What a Scala case class buys, and slate's `data` variant already had.** The names and the order
    // are the class's own constructor parameter list, so a positional pattern says what a reader means
    // and never repeats the field names beside it.

    assert_eq(out(PointAndLine + "print(Point.new(1, 2) match\n    Point(a, b) -> s\"${a},${b}\"\n    _ -> \"?\")"), "1,2")

@test
THE_POSITIONAL_ORDER_IS_THE_ONE_THE_CONSTRUCTOR_TAKES()
    // **The invariant the whole positional form rests on: a pattern binds what the call sets.** It holds
    // by construction rather than by convention -- the field list a pattern is resolved against is the
    // same `Buf` the generated `new` was built from, so the two cannot drift apart.
    //
    // **An initialised field is the case that would have broken a rule read off the DECLARATION.** A
    // default has to be trailing, so `var kind = "plain"` above `var side` is compiled to
    // `new(side, kind = "plain")` -- and reading the class top to bottom would bind these the other way
    // round, silently and with nothing to report it.

    assert_eq(out("""
        class Tagged
            var kind = "plain"
            var side

        print(Tagged.new(7) match
            Tagged(s, k) -> s"${s} ${k}"
            _ -> "?")
        """), "7 plain")

@test
A_CLASS_IS_TAKEN_APART_BY_NAME_TOO()
    // **The other half, and the one to reach for by default.** Naming the fields is order-independent,
    // picks two out of ten without writing eight wildcards, and reads as the class's own literal does.
    // `{ x }` is the shorthand every object pattern already had.

    assert_eq(out(PointAndLine + "print(Point.new(1, 2) match\n    Point { y: b } -> s\"y=${b}\"\n    _ -> \"?\")"), "y=2")
    assert_eq(out(PointAndLine + "print(Point.new(1, 2) match\n    Point { x, y } -> s\"${x},${y}\"\n    _ -> \"?\")"), "1,2")

@test
A_FIELD_NAME_THAT_IS_NOT_THE_CLASSS_IS_REFUSED_WHERE_IT_IS_WRITTEN()
    // **This is what pairing the two halves buys that neither has alone.** A bare `{ raduis: r }` is a
    // legal pattern that simply never matches -- any object may lack any field -- so a typo in one is a
    // silent arm that never runs. Written against a class, there is a declaration to check it against.

    val said = fails(PointAndLine + "print(Point.new(1, 2) match\n    Point { z: n } -> n\n    _ -> 0)")

    assert(said.contains("`Point` has no field `z`"))
    assert(said.contains("it is made from `x` and `y`"))

@test
A_POSITIONAL_PATTERN_OVER_A_CLASS_MUST_NAME_EVERY_FIELD()
    // A pattern cannot fault, so an unchecked arity would be an arm that never matches and never says
    // why -- the failure mode every pattern defect here has.

    assert(fails(PointAndLine + "print(Point.new(1, 2) match\n    Point(a) -> a\n    _ -> 0)").contains("`Point` is made from 2 fields and this names 1"))

@test
A_CLASS_THAT_BUILDS_ITS_OWN_OBJECT_CANNOT_BE_TAKEN_APART_BY_POSITION()
    // **A positional pattern promises it binds what the call sets, and here that promise cannot be
    // kept**: `new(size)` takes a `size` and the object holds a `side`, so there is no order to read.
    // The complaint says which form does work rather than only that this one does not.

    val said = fails("class Box\n    new(size) = { side: size }\n\nprint(Box.new(3) match\n    Box(s) -> s\n    _ -> 0)")

    assert(said.contains("cannot be taken apart by position"))
    assert(said.contains("write `Box { ... }`"))

@test
THE_NAMED_FORM_STILL_WORKS_WHERE_THE_POSITIONAL_ONE_CANNOT()
    // **Two separate questions, and only one of them is unanswerable.** Whether the fields can be put in
    // an order and whether they can be named are different; a class that builds its own object answers
    // neither, and a class whose `new` takes something that is not a field answers the second.
    //
    // **A class that names no fields is not checked against a field list, and that is right** -- an
    // empty list here means "not known", so the pattern is left to match or not at run time exactly as
    // a bare `{ ... }` always has.

    assert_eq(out("class Box\n    new(size) = { side: size }\n\nprint(Box.new(3) match\n    Box { side: s } -> s\n    _ -> 0)"), "3")
    assert_eq(out("class Scaled\n    new(var w, factor)\n        self.w = w * factor\n\nprint(Scaled.new(2, 5) match\n    Scaled { w } -> w\n    _ -> 0)"), "10")

@test
A_CONSTRUCTOR_THAT_TAKES_MORE_THAN_ITS_FIELDS_REFUSES_THE_POSITIONAL_FORM()
    // `new(var w, factor)` takes two arguments and makes an object with one field, so no positional
    // pattern over it could mean what `Scaled.new(2, 5)` means -- and `Scaled(w)` would have quietly
    // meant something else instead.

    assert(fails("class Scaled\n    new(var w, factor)\n        self.w = w * factor\n\nprint(Scaled.new(2, 5) match\n    Scaled(w) -> w\n    _ -> 0)").contains("cannot be taken apart by position"))

@test
BOTH_FORMS_NEST_AND_BOTH_TAKE_AN_AT_BINDING()
    // The sub-patterns are patterns like any others, which is the whole of what makes this compose: an
    // object pattern inside a positional one inside another positional one, and `n @ pat` over the lot.

    assert_eq(out(PointAndLine + "val l = Line.new(Point.new(1, 2), Point.new(3, 4))\nprint(l match\n    Line(Point(ax, ay), Point { x: bx }) -> s\"${ax},${ay} ${bx}\"\n    _ -> \"?\")"), "1,2 3")
    assert_eq(out(PointAndLine + "val l = Line.new(Point.new(1, 2), Point.new(3, 4))\nprint(l match\n    whole @ Line { a: Point(ax, _) } -> s\"${ax} ${whole.b.x}\"\n    _ -> \"?\")"), "1 3")

@test
BOTH_FORMS_WORK_IN_AN_is_EXPRESSION()
    // A pattern is a pattern wherever it stands, so neither form needed anything of its own here.

    assert_eq(out(PointAndLine + "val p = Point.new(1, 2)\nprint(p is Point { x: 1 }, p is Point { x: 9 }, p is Point(1, 2))"), "true false true")

@test
A_SUBCLASS_MATCHES_ITS_BASES_PATTERN()
    // **The nominal test is the `proto` WALK, not one link of it**, so a pattern written for a base
    // takes an object of a class descended from it apart -- which is what `is` has always answered and
    // what makes a pattern over a base worth writing at all.

    assert_eq(out("""
        class Point
            var x
            var y

        class Point3D from Point
            var z

        val p = { x: 1, y: 2, z: 3, proto: Point3D }

        print(p match
            Point(a, b) -> s"${a},${b}"
            _ -> "?")
        """), "1,2")

@test
A_CLASS_INSTANCE_PRINTS_AS_ITS_CLASS_AND_ITS_OWN_FIELDS()
    // **It used to print the object it desugars to** -- `{x: 1, y: 2, proto: {new: <function of 2>}}`
    // -- which wrote out the whole class beside every value of it and buried the two numbers a reader
    // wanted. The names are written where a variant's are not: a class's fields are named and mutable
    // where a variant's are positional by construction, so `Rect(3, 4)` would leave a reader guessing
    // which is the width.

    assert_eq(out(PointClass + "print(Point.new(1, 2))"), "Point(x = 1, y = 2)")
    assert_eq(out(PointClass + "print([Point.new(1, 2)])"), "[Point(x = 1, y = 2)]")

    // A class that declares no fields prints as its bare name, as a variant carrying none does.
    assert_eq(out("class Empty\n\nprint({ proto: Empty })"), "Empty")

    // **The class OBJECT says it is one** rather than printing a constructor and a table of methods,
    // which is never what a reader printing `Point` wanted to see.
    assert_eq(out(PointClass + "print(Point)"), "<class Point>")

    // A subclass shadows its base's tag rather than hiding it: the lookup walks from the instance
    // upward and stops at the first, which is the name this value should print.
    assert_eq(out(PointClass + "class P3 from Point\n    var z\n\nprint({ x: 1, y: 2, z: 3, proto: P3 })"),
        "P3(x = 1, y = 2, z = 3)")

@test
A_CLASS_MAY_SAY_HOW_IT_PRINTS_AND_IT_IS_SAID_EVERYWHERE()
    // **A `toString` replaces the default at every depth**, which is the whole point of having one: a
    // rendering that applied only to a value printed on its own would be the case that matters least.
    val money = """
        class Money
            var cents

            toString(self) = "$" + string(self.cents)

        val m = Money.new(150)
        """

    assert_eq(out(money + "print(m)"), "$150")
    assert_eq(out(money + "print(string(m), m.toString())"), "$150 $150")
    assert_eq(out(money + "print(s\"cost ${m}\")"), "cost $150")
    assert_eq(out(money + "print([m], { paid: m })"), "[$150] {paid: $150}")

    // **A hook that gives back something other than a string is a fault naming what it gave.**
    // Rendering it anyway would make a `toString` answering an object print an object, which is the
    // thing the hook was written to stop.
    assert(fails("class B\n    var v\n\n    toString(self) = 42\n\nprint(B.new(1))").contains("`toString` says how a value prints"))

    // **A DIAGNOSTIC does not run the hook.** A message about a fault that renders its values with
    // the program's own code can fault again, and the second fault is the one the reader would meet.
    assert(fails(money + "print(m match\n    1 -> \"one\")").contains("no arm of this match applies to Money(cents = 150)"))

@test
EQUALITY_IS_DEEP_FOR_EVERY_VALUE_AND_A_CLASS_MAY_REDEFINE_IT()
    // **`==` and `equals` are one thing and both are content-based**, a class instance included.
    // Identity for a nominal value -- Java's rule and Scala's -- was built on 2026-09-02 and withdrawn
    // the same day: slate's `class` is the only construct with methods and operator hooks, so a value
    // object has to be one, and `slate-language/pg`'s `Decimal` had every equality test broken by it.

    assert_eq(out(PointClass + "print(Point.new(1, 2) == Point.new(1, 2))"), "true")
    assert_eq(out(PointClass + "print(Point.new(1, 2) == Point.new(9, 9))"), "false")
    assert_eq(out("print({x: 1} == {x: 1}, [1, 2] == [1, 2])"), "true true")
    assert_eq(out("data S\n    Circle(r)\n    Nothing\n\nprint(Circle(3) == Circle(3), Nothing == Nothing)"), "true true")

    // **A class instance and a plain object holding the same fields are equal**, which is what deep
    // means: the tag is not a field, so it is not compared either.
    assert_eq(out(PointClass + "print(Point.new(1, 2) == { x: 1, y: 2, proto: Point })"), "true")

    // **A class may redefine `equals`, and `==` follows it** -- there is one function, not two, so the
    // two can never disagree.
    val money = "class Money\n    var cents\n\n    equals(self, o) = o is Money && self.cents == o.cents\n\n"

    assert_eq(out(money + "print(Money(1) == Money(1), Money(1) == Money(2), Money(1) == { cents: 1 })"),
        "true false false")
    assert_eq(out(money + "print(Money(1).equals(Money(1)))"), "true")

    // **A class that wants identity says so in one line**, which is the direction that costs a line
    // in the rare case rather than in every value object.
    assert_eq(out("class Node\n    var v\n\n    equals(self, o) = self.eq(o)\n\nval n = Node(1)\nprint(n == n, n == Node(1))"),
        "true false")

    // `hash` may be redefined the same way, and a table consults it.
    assert_eq(out("class K\n    var v\n\n    hash(self) = 7\n    equals(self, o) = true\n\nvar t = {}\nt[K(1)] = \"s\"\nprint(t[K(2)], len(t))"),
        "s 1")

@test
A_TAG_A_DECLARATION_WROTE_IS_NOT_A_FIELD()
    // `keys`, `values`, `entries` and `len` all walk the table's own entries, so without this a class
    // object answers `["(class)", "new"]` to `keys` -- a name no program wrote and cannot have
    // written. `print` has hidden them from the start and these four had not caught up.

    assert_eq(out(PointClass + "print(keys(Point), len(Point))"), "[\"new\"] 1")
    assert_eq(out(PointClass + "print(keys(Point.new(1, 2)), len(Point.new(1, 2)))"), "[\"x\", \"y\"] 2")
    assert_eq(out("data S\n    Circle(r)\n\nprint(keys(Circle), len(Circle))"), "[\"new\"] 1")

// -- an operator a class answers for ------------------------------------------------------------

// **Moved here from the pattern tests**, where the section that held them was about something
// else: an operator hook is a method a class writes, looked up by name on the left operand.

@test
AN_OBJECT_MAY_ANSWER_FOR_AN_OPERATOR_AND_THE_LEFT_OPERAND_DECIDES()
    // **`equals` and `hash` were already proto hooks looked up by name**, so the mechanism existed
    // and this widens it. The words are words for the reason those two are: a class body reads
    // `plus(self, o) = ...` with the definition syntax it already has.
    val money = "class M\n    var c\n\n    plus(self, o) = M(self.c + o.c)\n    minus(self, o) = M(self.c - o.c)\n" +
        "    times(self, n) = M(self.c * n)\n    dividedBy(self, n) = M(self.c / n)\n" +
        "    remainder(self, n) = M(self.c % n)\n    negated(self) = M(-self.c)\n" +
        "    compare(self, o) = self.c - o.c\n\nval a = M(500)\nval b = M(125)\n"

    assert_eq(out(money + "print((a + b).c, (a - b).c, (a * 3).c, (a / 2).c, (a % 300).c)"),
        "625 375 1500 250 200")
    assert_eq(out(money + "print((-a).c)"), "-500")

    // **Ordering is ONE hook and not four**, `compare` answering a number whose sign the four read.
    assert_eq(out(money + "print(a < b, a > b, a <= a, a >= a)"), "false true true true")

    // So sorting falls out of it, a comparator being an ordinary `<`.
    assert_eq(out(money + "print(map(sorted([a, b], (x, y) -> x < y), m -> m.c))"), "[125, 500]")

    // **An inherited hook works**, the receiver rule handing the object to a method reached through
    // a proto -- which is what lets it be written as a method at all.
    assert_eq(out(money + "class C from M\n    new(var c) = 1\n\nprint((C(1) + C(2)).c)"), "3")

    // **THE LEFT OPERAND DECIDES AND THE RIGHT IS NEVER ASKED**, which is `equals`'s rule already:
    // there is no reflected form, so a number on the left is a number on the left.
    assert(fails(money + "print(2 * a)").contains("`*` does not apply to an integer and an object"))

    // A hook can never shadow what an operator already means -- it is the last thing tried.
    assert_eq(out(money + "print(1 + 2, \"a\" + \"b\")"), "3 ab")

    // An operator the class does not answer for says what it always said.
    assert(out(money + "print((a & b) catch e -> e.message)").contains("`&` does not apply"))

    // **`compare` must answer a NUMBER**, and a hook that does not is named rather than believed.
    assert(fails("class B\n    var n\n\n    compare(self, o) = true\n\nprint(B(1) < B(2))").contains("it answers a number below, at or above zero"))

@test
EVERY_HOOK_TAKES_THE_RECEIVER_NOW_AND_equals_WAS_THE_LAST_HOLDOUT()
    // **The asymmetry this used to pin is gone.** `equals` and `hash` were handed no receiver, so a
    // class could not write either as a method -- one reached through the chain was called with one
    // argument and died on the arity. That was a compatibility scar kept for the capture-style hook
    // used as a `proto`, and the object model is what made widening it worth the break.
    assert_eq(out("class M\n    var c\n\n    equals(self, o) = o is M && self.c == o.c\n\nprint(M(1) == M(1), M(1) == { c: 1 })"),
        "true false")

    assert_eq(out("class K\n    var v\n\n    hash(self) = 7\n    equals(self, o) = true\n\nvar t = {}\nt[K(1)] = \"s\"\nprint(t[K(2)], len(t))"),
        "s 1")

    // **A hook reached through an ordinary `proto` takes it too**, there being one rule and not one
    // rule per hook: `{ equals: (self, o) -> ... }` is how a shared one is written.
    assert_eq(out("val Keyed = { hash: (self) -> 7, equals: (self, o) -> true }\nvar t = {}\nt[{ v: 1, proto: Keyed }] = \"s\"\nprint(t[{ v: 2, proto: Keyed }], len(t))"),
        "s 1")

    // Where a hook is captured on the object instead, it takes no receiver -- the rule is about
    // where the function was FOUND, which is `CallMethod`'s rule exactly.
    assert_eq(out("val v = { n: 1, plus: o -> o.n + 1 }\nprint(v + { n: 4 })"), "5")
    assert_eq(out("print({ n: 1, equals: o -> true } == { z: 9 })"), "true")

@test
EVERY_OPERATOR_NAMES_ITSELF_IN_A_COMPLAINT_AND_SIX_OF_THEM_DID_NOT()
    // **`op_text` had `_ -> \"?\"` and the six bitwise operators fell into it**, so `v & w` on two
    // objects said *"`?` does not apply to an object and an object"* -- a sentence naming an
    // operator slate does not have, about a line holding one it does.
    assert(fails("val a = { }\nprint(a & a)").contains("`&` does not apply"))
    assert(fails("val a = { }\nprint(a | a)").contains("`|` does not apply"))
    assert(fails("val a = { }\nprint(a ^ a)").contains("`^` does not apply"))
    assert(fails("val a = { }\nprint(a << a)").contains("`<<` does not apply"))
    assert(fails("val a = { }\nprint(a >> a)").contains("`>>` does not apply"))

// A class of two numbers, which is what most of the object-model tests above want.
private const PointClass: string = "class Point\n    var x\n    var y\n\n"
