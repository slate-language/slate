module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.fs.read_bytes
import sysl.text.Search

// A file's top level is DECLARATIONS and EFFECTS, and a VM may run the first without the second.
//
// **This is what an actor's machine does to learn the program's names.** A declaration says what a
// name is -- a definition, a `class`, a `data`, a `type`, an `external`, an `import` -- and an effect
// is the program doing something: a `val`, an expression, a loop. `compile_module` emits a second
// chunk holding the declarations alone, and `load_declarations` runs that one in a VM of its own --
// the ordinary program is compiled and run exactly as it was.
//
// The rule a reader meets is in `docs/reference/modules.md`, and what it means for an actor is in
// `docs/design/actors.md`.

// Room for a small program and the objects its declarations make.
private const DeclCeiling: usize = 16777216

// A definition, a class, a top-level `val`, something printed and a timer -- one of each, so that a
// VM that ran only the declarations can be asked about all five.
private const Mixed: string = raw"""
    greet(name) = "hello " + name

    class Point
        var x
        var y

        sum(self) = self.x + self.y

    val marker = 41

    print("the body ran")
    setTimeout(() -> print("a timer fired"), 50)

    export probe() = greet("world") + " " + string(Point.new(1, 2).sum())

    export usesTheVal() = marker + 1

    export val version = "1.0"
    """

@test
A_SECOND_VM_RUNS_A_PROGRAMS_DECLARATIONS_WITHOUT_ITS_EFFECTS()
    reset_vm()
    current().output.clear()

    var second = new_vm(DeclCeiling)
    val was = enter(&second)

    val complaint = load_declarations(source_of("t", Mixed))

    // The definition and the class are both there, and the class's method runs.
    val probed = called("probe")

    // Nothing the file DOES ran: nothing was printed and no timer was armed on this VM's loop.
    val printed = current().output.len()
    val armed = current().outstanding

    // An exported `val` is an effect, so the key is there and nothing is behind it.
    val version = value_text(declared("version"))

    leave(was)
    dispose_vm(&second)

    assert_eq(complaint, "", "every module's declarations ran")
    assert_eq(probed, "hello world 3", "a declared definition answers, and so does a declared class's method")
    assert_eq(printed, 0, "a VM that ran only the declarations printed nothing")
    assert_eq(armed, 0, "and armed no timer on its loop")
    assert_eq(version, "null", "an exported `val` is a key with nothing behind it")

    current().output.clear()
end A_SECOND_VM_RUNS_A_PROGRAMS_DECLARATIONS_WITHOUT_ITS_EFFECTS

@test
A_CLASS_METHOD_THAT_NAMES_A_TOP_LEVEL_VAL_FAULTS_IN_A_VM_THAT_NEVER_RAN_THE_EFFECTS()
    reset_vm()
    current().output.clear()

    var second = new_vm(DeclCeiling)
    val was = enter(&second)

    val complaint = load_declarations(source_of("t", Mixed))
    val said = called("usesTheVal")

    leave(was)
    dispose_vm(&second)

    assert_eq(complaint, "")
    assert(said.contains("`marker` is not defined"),
        s"a name only an effect binds is simply unbound there, and the ordinary sentence says so -- ${said}")

    current().output.clear()
end A_CLASS_METHOD_THAT_NAMES_A_TOP_LEVEL_VAL_FAULTS_IN_A_VM_THAT_NEVER_RAN_THE_EFFECTS

@test
A_SECOND_VM_LOADS_THE_DECLARATIONS_OF_EVERY_MODULE_A_PROGRAM_IMPORTS()
    reset_vm()
    current().output.clear()

    var second = new_vm(DeclCeiling)
    val was = enter(&second)

    val complaint = from_disk("tests/mods/uses_decl_shapes.sl")

    // The importer's own definition works, which it can only do if the module it imported declared
    // its class in this VM too.
    val area = called("areaOf")
    val printed = current().output.len()

    leave(was)
    dispose_vm(&second)

    assert_eq(complaint, "", "a module's declarations are loaded from the declarations of what it imports")
    assert_eq(area, "12", "the imported class is there, and the importer's definition uses it")
    assert_eq(printed, 0, "and neither file's own effects ran")

    current().output.clear()
end A_SECOND_VM_LOADS_THE_DECLARATIONS_OF_EVERY_MODULE_A_PROGRAM_IMPORTS

@test
A_DEFINITION_IS_STILL_IN_SCOPE_ABOVE_THE_LINE_IT_IS_WRITTEN_ON()
    // The hoisting is `hoist_defs`' and is untouched, in both chunks: a definition is bound before a
    // line of the run it is in.
    assert_eq(out("print(later())\nlater() = \"hoisted\""), "hoisted")
end A_DEFINITION_IS_STILL_IN_SCOPE_ABOVE_THE_LINE_IT_IS_WRITTEN_ON

// A class whose own field is worked out from a name only an effect binds. It is an ordinary program
// and it runs; what it cannot do is be loaded by declarations alone.
private const Leaning: string = raw"""
    val Defaults = { size: 3 }

    class Config
        val defaults = Defaults

    export sizeOf() = Config.defaults.size

    print(sizeOf())
    """

@test
A_DECLARATION_BUILT_OUT_OF_AN_EFFECTS_BINDING_CANNOT_BE_LOADED_ON_ITS_OWN()
    // The ordinary program is untouched -- a class's field initialiser is worked out where the class
    // stands, so the `val` above it has run.
    assert_eq(out(Leaning), "3")

    reset_vm()
    current().output.clear()

    var second = new_vm(DeclCeiling)
    val was = enter(&second)
    val complaint = load_declarations(source_of("t", Leaning))

    leave(was)
    dispose_vm(&second)

    // **And a VM that runs only the declarations is told, where it stands, rather than answering
    // something wrong later.** This is the shape of program an actor cannot be handed.
    assert(complaint.contains("`Defaults` is not defined"),
        s"a declaration whose value needs an effect's binding says so when it is loaded alone -- ${complaint}")

    current().output.clear()
end A_DECLARATION_BUILT_OUT_OF_AN_EFFECTS_BINDING_CANNOT_BE_LOADED_ON_ITS_OWN

// The value an exported name of the entry module's declarations holds.
//
// **`module_values` is where a module's answer goes and the entry module is the last of them**, which
// is the order `each_module` runs them in. That object is what an importer reads its names out of, so
// asking it here is asking the same question an import asks.
private declared(name: string) -> Value
    val vals = current().module_values

    if vals.len() == 0 then return Null

    read_field(vals.at(vals.len() - 1), name, point(0)) match
        Ok(v) -> v
        Err(_) -> Null
end declared

// What calling a declared name of no arguments answered, or the complaint it drew.
private called(name: string) -> string
    var none: Buf[Value] = buf()

    apply_callback(declared(name), none, point(0), "a declared name") match
        Ok(v) -> value_text(v)
        Err(sig) -> signal_message(sig)
end called

// The declarations of a program on disk, which is the only way to reach a program of several files.
private from_disk(path: string) -> string
    read_bytes(path) match
        Err(e) -> s"cannot read ${path}: ${e} -- this suite reads its fixtures by relative path, so it must be run from the project root"
        Ok(bytes) -> load_declarations(source(path, bytes))
end from_disk
