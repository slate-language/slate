module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// What the language does WITH an instance, once a class has declared one.
//
// **Cut out of `tests_classes.sysl` when that file passed a thousand lines**, on the heading that
// was already there. What stays there is what a class DECLARES -- the sugar, the constructor, the
// fields, `is`, a promise about a type -- and what is here is the four places an instance then
// turns up as an ordinary value: taken apart in a pattern, printed, compared, and standing as the
// left operand of an operator it answers for itself.
//
// `PointAndLine` and `PointClass` are `private` and stay so: both moved with the tests that use
// them, and nothing outside this file says either name.

// -- taking a class apart in a pattern ---------------------------------------------------------------

// **Two classes whose fields are `var`s, which is what gives them a constructor made from a field
// list.** `tests_kit.sysl`'s `Shapely` writes its own `new`, so it is the other case on purpose
// and is used below to assert the refusal.
private const PointAndLine: string = "class Point\n    var x\n    var y\n\nclass Line\n    var a\n    var b\n"

@test
A_CLASS_IS_TAKEN_APART_BY_POSITION_LIKE_A_DATA_VARIANT()
    // **What a Scala case class buys, and slate's `data` variant already had.** The names and the order
    // are the class's own constructor parameter list, so a positional pattern says what a reader means
    // and never repeats the field names beside it.

    assert_eq(out(PointAndLine + "print(Point.new(1, 2) match\n    Point(a, b) -> s\"${a},${b}\"\n    _ -> \"?\")"), "1,2")

@test
THE_POSITIONAL_ORDER_IS_THE_ONE_THE_CONSTRUCTOR_TAKES()
    // **The invariant the whole positional form rests on: a pattern binds what the call sets.** It holds
    // by construction rather than by convention -- the field list a pattern is resolved against is the
    // same `Buf` the generated `new` was built from, so the two cannot drift apart.
    //
    // **An initialised field is the case that would have broken a rule read off the DECLARATION.** A
    // default has to be trailing, so `var kind = "plain"` above `var side` is compiled to
    // `new(side, kind = "plain")` -- and reading the class top to bottom would bind these the other way
    // round, silently and with nothing to report it.

    assert_eq(out("""
        class Tagged
            var kind = "plain"
            var side

        print(Tagged.new(7) match
            Tagged(s, k) -> s"${s} ${k}"
            _ -> "?")
        """), "7 plain")

@test
A_CLASS_IS_TAKEN_APART_BY_NAME_TOO()
    // **The other half, and the one to reach for by default.** Naming the fields is order-independent,
    // picks two out of ten without writing eight wildcards, and reads as the class's own literal does.
    // `{ x }` is the shorthand every object pattern already had.

    assert_eq(out(PointAndLine + "print(Point.new(1, 2) match\n    Point { y: b } -> s\"y=${b}\"\n    _ -> \"?\")"), "y=2")
    assert_eq(out(PointAndLine + "print(Point.new(1, 2) match\n    Point { x, y } -> s\"${x},${y}\"\n    _ -> \"?\")"), "1,2")

@test
A_FIELD_NAME_THAT_IS_NOT_THE_CLASSS_IS_REFUSED_WHERE_IT_IS_WRITTEN()
    // **This is what pairing the two halves buys that neither has alone.** A bare `{ raduis: r }` is a
    // legal pattern that simply never matches -- any object may lack any field -- so a typo in one is a
    // silent arm that never runs. Written against a class, there is a declaration to check it against.

    val said = fails(PointAndLine + "print(Point.new(1, 2) match\n    Point { z: n } -> n\n    _ -> 0)")

    assert(said.contains("`Point` has no field `z`"))
    assert(said.contains("it is made from `x` and `y`"))

@test
A_POSITIONAL_PATTERN_OVER_A_CLASS_MUST_NAME_EVERY_FIELD()
    // A pattern cannot fault, so an unchecked arity would be an arm that never matches and never says
    // why -- the failure mode every pattern defect here has.

    assert(fails(PointAndLine + "print(Point.new(1, 2) match\n    Point(a) -> a\n    _ -> 0)").contains("`Point` is made from 2 fields and this names 1"))

@test
A_CLASS_THAT_BUILDS_ITS_OWN_OBJECT_CANNOT_BE_TAKEN_APART_BY_POSITION()
    // **A positional pattern promises it binds what the call sets, and here that promise cannot be
    // kept**: `new(size)` takes a `size` and the object holds a `side`, so there is no order to read.
    // The complaint says which form does work rather than only that this one does not.

    val said = fails("class Box\n    new(size) = { side: size }\n\nprint(Box.new(3) match\n    Box(s) -> s\n    _ -> 0)")

    assert(said.contains("cannot be taken apart by position"))
    assert(said.contains("write `Box { ... }`"))

@test
THE_NAMED_FORM_STILL_WORKS_WHERE_THE_POSITIONAL_ONE_CANNOT()
    // **Two separate questions, and only one of them is unanswerable.** Whether the fields can be put in
    // an order and whether they can be named are different; a class that builds its own object answers
    // neither, and a class whose `new` takes something that is not a field answers the second.
    //
    // **A class that names no fields is not checked against a field list, and that is right** -- an
    // empty list here means "not known", so the pattern is left to match or not at run time exactly as
    // a bare `{ ... }` always has.

    assert_eq(out("class Box\n    new(size) = { side: size }\n\nprint(Box.new(3) match\n    Box { side: s } -> s\n    _ -> 0)"), "3")
    assert_eq(out("class Scaled\n    new(var w, factor)\n        self.w = w * factor\n\nprint(Scaled.new(2, 5) match\n    Scaled { w } -> w\n    _ -> 0)"), "10")

@test
A_CONSTRUCTOR_THAT_TAKES_MORE_THAN_ITS_FIELDS_REFUSES_THE_POSITIONAL_FORM()
    // `new(var w, factor)` takes two arguments and makes an object with one field, so no positional
    // pattern over it could mean what `Scaled.new(2, 5)` means -- and `Scaled(w)` would have quietly
    // meant something else instead.

    assert(fails("class Scaled\n    new(var w, factor)\n        self.w = w * factor\n\nprint(Scaled.new(2, 5) match\n    Scaled(w) -> w\n    _ -> 0)").contains("cannot be taken apart by position"))

@test
BOTH_FORMS_NEST_AND_BOTH_TAKE_AN_AT_BINDING()
    // The sub-patterns are patterns like any others, which is the whole of what makes this compose: an
    // object pattern inside a positional one inside another positional one, and `n @ pat` over the lot.

    assert_eq(out(PointAndLine + "val l = Line.new(Point.new(1, 2), Point.new(3, 4))\nprint(l match\n    Line(Point(ax, ay), Point { x: bx }) -> s\"${ax},${ay} ${bx}\"\n    _ -> \"?\")"), "1,2 3")
    assert_eq(out(PointAndLine + "val l = Line.new(Point.new(1, 2), Point.new(3, 4))\nprint(l match\n    whole @ Line { a: Point(ax, _) } -> s\"${ax} ${whole.b.x}\"\n    _ -> \"?\")"), "1 3")

@test
BOTH_FORMS_WORK_IN_AN_is_EXPRESSION()
    // A pattern is a pattern wherever it stands, so neither form needed anything of its own here.

    assert_eq(out(PointAndLine + "val p = Point.new(1, 2)\nprint(p is Point { x: 1 }, p is Point { x: 9 }, p is Point(1, 2))"), "true false true")

@test
A_SUBCLASS_MATCHES_ITS_BASES_PATTERN()
    // **The nominal test is the `proto` WALK, not one link of it**, so a pattern written for a base
    // takes an object of a class descended from it apart -- which is what `is` has always answered and
    // what makes a pattern over a base worth writing at all.

    assert_eq(out("""
        class Point
            var x
            var y

        class Point3D from Point
            var z

        val p = { x: 1, y: 2, z: 3, proto: Point3D }

        print(p match
            Point(a, b) -> s"${a},${b}"
            _ -> "?")
        """), "1,2")

@test
A_CLASS_INSTANCE_PRINTS_AS_ITS_CLASS_AND_ITS_OWN_FIELDS()
    // **It used to print the object it desugars to** -- `{x: 1, y: 2, proto: {new: <function of 2>}}`
    // -- which wrote out the whole class beside every value of it and buried the two numbers a reader
    // wanted. The names are written where a variant's are not: a class's fields are named and mutable
    // where a variant's are positional by construction, so `Rect(3, 4)` would leave a reader guessing
    // which is the width.

    assert_eq(out(PointClass + "print(Point.new(1, 2))"), "Point(x = 1, y = 2)")
    assert_eq(out(PointClass + "print([Point.new(1, 2)])"), "[Point(x = 1, y = 2)]")

    // A class that declares no fields prints as its bare name, as a variant carrying none does.
    assert_eq(out("class Empty\n\nprint({ proto: Empty })"), "Empty")

    // **The class OBJECT says it is one** rather than printing a constructor and a table of methods,
    // which is never what a reader printing `Point` wanted to see.
    assert_eq(out(PointClass + "print(Point)"), "<class Point>")

    // A subclass shadows its base's tag rather than hiding it: the lookup walks from the instance
    // upward and stops at the first, which is the name this value should print.
    assert_eq(out(PointClass + "class P3 from Point\n    var z\n\nprint({ x: 1, y: 2, z: 3, proto: P3 })"),
        "P3(x = 1, y = 2, z = 3)")

@test
A_CLASS_MAY_SAY_HOW_IT_PRINTS_AND_IT_IS_SAID_EVERYWHERE()
    // **A `toString` replaces the default at every depth**, which is the whole point of having one: a
    // rendering that applied only to a value printed on its own would be the case that matters least.
    val money = """
        class Money
            var cents

            toString(self) = "$" + string(self.cents)

        val m = Money.new(150)
        """

    assert_eq(out(money + "print(m)"), "$150")
    assert_eq(out(money + "print(string(m), m.toString())"), "$150 $150")
    assert_eq(out(money + "print(s\"cost ${m}\")"), "cost $150")
    assert_eq(out(money + "print([m], { paid: m })"), "[$150] {paid: $150}")

    // **A hook that gives back something other than a string is a fault naming what it gave.**
    // Rendering it anyway would make a `toString` answering an object print an object, which is the
    // thing the hook was written to stop.
    assert(fails("class B\n    var v\n\n    toString(self) = 42\n\nprint(B.new(1))").contains("`toString` says how a value prints"))

    // **A DIAGNOSTIC does not run the hook.** A message about a fault that renders its values with
    // the program's own code can fault again, and the second fault is the one the reader would meet.
    assert(fails(money + "print(m match\n    1 -> \"one\")").contains("no arm of this match applies to Money(cents = 150)"))

@test
EQUALITY_IS_DEEP_FOR_EVERY_VALUE_AND_A_CLASS_MAY_REDEFINE_IT()
    // **`==` and `equals` are one thing and both are content-based**, a class instance included.
    // The hook a class writes is named `==`; `a.equals(b)` is the universal method and asks it.
    // Identity for a nominal value -- Java's rule and Scala's -- was built on 2026-09-02 and withdrawn
    // the same day: slate's `class` is the only construct with methods and operator methods, so a value
    // object has to be one, and `slate-language/pg`'s `Decimal` had every equality test broken by it.

    assert_eq(out(PointClass + "print(Point.new(1, 2) == Point.new(1, 2))"), "true")
    assert_eq(out(PointClass + "print(Point.new(1, 2) == Point.new(9, 9))"), "false")
    assert_eq(out("print({x: 1} == {x: 1}, [1, 2] == [1, 2])"), "true true")
    assert_eq(out("data S\n    Circle(r)\n    Nothing\n\nprint(Circle(3) == Circle(3), Nothing == Nothing)"), "true true")

    // **A class instance and a plain object holding the same fields are equal**, which is what deep
    // means: the tag is not a field, so it is not compared either.
    assert_eq(out(PointClass + "print(Point.new(1, 2) == { x: 1, y: 2, proto: Point })"), "true")

    // **A class may redefine `==`, and `equals` follows it** -- there is one function, not two, so the
    // two can never disagree.
    val money = "class Money\n    var cents\n\n    ==(self, o) = o is Money && self.cents == o.cents\n\n"

    assert_eq(out(money + "print(Money(1) == Money(1), Money(1) == Money(2), Money(1) == { cents: 1 })"),
        "true false false")
    assert_eq(out(money + "print(Money(1).equals(Money(1)))"), "true")

    // **A class that wants identity says so in one line**, which is the direction that costs a line
    // in the rare case rather than in every value object.
    assert_eq(out("class Node\n    var v\n\n    ==(self, o) = self.eq(o)\n\nval n = Node(1)\nprint(n == n, n == Node(1))"),
        "true false")

    // **`hash` STAYS A WORD**, there being no operator to name it after, and a table consults it
    // beside the `==` the class wrote.
    assert_eq(out("class K\n    var v\n\n    hash(self) = 7\n    ==(self, o) = true\n\nvar t = {}\nt[K(1)] = \"s\"\nprint(t[K(2)], keys(t).length)"),
        "s 1")

@test
A_TAG_A_DECLARATION_WROTE_IS_NOT_A_FIELD()
    // `keys`, `values` and `entries` all walk the table's own entries, so without this a class
    // object answers `["(class)", "new"]` to `keys` -- a name no program wrote and cannot have
    // written. `print` has hidden them from the start and these three had not caught up.

    assert_eq(out(PointClass + "print(keys(Point), keys(Point).length)"), "[\"new\"] 1")
    assert_eq(out(PointClass + "print(keys(Point.new(1, 2)), keys(Point.new(1, 2)).length)"), "[\"x\", \"y\"] 2")
    assert_eq(out("data S\n    Circle(r)\n\nprint(keys(Circle), keys(Circle).length)"), "[\"new\"] 1")

// -- an operator a class answers for ------------------------------------------------------------

// **Moved here from the pattern tests**, where the section that held them was about something
// else: an operator method is a member a class writes, looked up by name on the left operand.

@test
AN_OBJECT_MAY_ANSWER_FOR_AN_OPERATOR_AND_THE_LEFT_OPERAND_DECIDES()
    // **THE OPERATOR IS THE METHOD'S NAME.** `+(self, o) = ...` in a class body, so the definition
    // and every call that reaches it read alike -- where a word had to be learned from a table before
    // anybody could write one.
    val money = "class M\n    var c\n\n    +(self, o) = M(self.c + o.c)\n    -(self, o) = M(self.c - o.c)\n" +
        "    *(self, n) = M(self.c * n)\n    /(self, n) = M(self.c / n)\n" +
        "    %(self, n) = M(self.c % n)\n    unary_-(self) = M(-self.c)\n" +
        "    <=>(self, o) = self.c - o.c\n\nval a = M(500)\nval b = M(125)\n"

    assert_eq(out(money + "print((a + b).c, (a - b).c, (a * 3).c, (a / 2).c, (a % 300).c)"),
        "625 375 1500 250 200")

    // **`unary_-` is the prefix minus and takes no other side**, so it is spelled apart from the `-`
    // of two operands: a class with the second has said nothing about what `-v` should be.
    assert_eq(out(money + "print((-a).c)"), "-500")

    // **`<=>` answers all four comparisons**, its sign being what each of them reads.
    assert_eq(out(money + "print(a < b, a > b, a <= a, a >= a)"), "false true true true")

    // So sorting falls out of it, a comparator being an ordinary `<`.
    assert_eq(out(money + "print(map(sorted([a, b], (x, y) -> x < y), m -> m.c))"), "[125, 500]")

    // **An inherited hook works**, the receiver rule handing the object to a method reached through
    // a proto -- which is what lets it be written as a method at all.
    assert_eq(out(money + "class C from M\n    new(var c) = 1\n\nprint((C(1) + C(2)).c)"), "3")

    // **THE LEFT OPERAND DECIDES AND THE RIGHT IS NEVER ASKED**, which is `a.equals(b)`'s rule
    // already: there is no reflected form, so a number on the left is a number on the left.
    assert(fails(money + "print(2 * a)").contains("`*` does not apply to an integer and an object"))

    // A hook can never shadow what an operator already means -- it is the last thing tried.
    assert_eq(out(money + "print(1 + 2, \"a\" + \"b\")"), "3 ab")

    // An operator the class does not answer for says what it always said.
    assert(out(money + "print((a & b) catch e -> e.message)").contains("`&` does not apply"))

    // **`<=>` must answer a NUMBER**, and a hook that does not is named rather than believed.
    assert(fails("class B\n    var n\n\n    <=>(self, o) = true\n\nprint(B(1) < B(2))").contains("it answers a number below, at or above zero"))

@test
AN_OPERATOR_METHOD_IS_AN_ORDINARY_MEMBER_AND_a_DOT_PLUS_CALLS_IT()
    // **`a.+(b)` calls what `a + b` calls**, which is what makes an operator method a member rather
    // than something only the machine can reach: it can be read off the object, handed on, and called
    // by name like anything else.
    val money = "class M\n    var c\n\n    +(self, o) = M(self.c + o.c)\n\nval a = M(1)\nval b = M(2)\n"

    assert_eq(out(money + "print(a.+(b).c)"), "3")
    assert_eq(out(money + "print((a.+)(b).c)"), "3")

@test
THE_FOUR_COMPARISONS_MAY_BE_WRITTEN_OUT_ONE_AT_A_TIME()
    // **The operator's own method is asked before `<=>`**, so a class that wants to say exactly what
    // `<` means for it says it and nothing has to be inferred from a sign.
    val v = "class Version\n    var n\n\n    <(self, o) = self.n < o.n\n    <=(self, o) = self.n <= o.n\n" +
        "    >(self, o) = self.n > o.n\n    >=(self, o) = self.n >= o.n\n\nval a = Version(1)\nval b = Version(2)\n"

    assert_eq(out(v + "print(a < b, a > b, a <= a, a >= a)"), "true false true true")

    // **A class writes `<=>` OR the comparisons, never both**, the two being ways for one type to
    // order inconsistently with itself.
    assert(fails("class B\n    var n\n\n    <(self, o) = true\n    <=>(self, o) = 0\n").contains("writes one or the other"))
    assert(fails("class B\n    var n\n\n    <=>(self, o) = 0\n    >=(self, o) = true\n").contains("writes one or the other"))

@test
A_CLASS_MAY_NOT_WRITE_A_ne_BECAUSE_IT_IS_ALWAYS_THE_OPPOSITE_OF_eq()
    // **`!=` is DERIVED and defining one is refused by name.** Two methods that could disagree about
    // whether two values are the same is a defect nothing could diagnose afterwards.
    assert(fails("class B\n    var n\n\n    !=(self, o) = true\n").contains("is always the opposite of"))

    // And it does follow from the `==` the class wrote.
    val money = "class M\n    var c\n\n    ==(self, o) = o is M && self.c == o.c\n\n"

    assert_eq(out(money + "print(M(1) != M(1), M(1) != M(2))"), "false true")

@test
AN_OPERATORS_ARITY_IS_FIXED_BY_WHERE_IT_IS_WRITTEN()
    // A `+` of three operands could never be reached, `a + b` being the only way anything calls it --
    // so it is refused where it is written rather than at a call nobody can make.
    assert(fails("class B\n    var n\n\n    +(self, o, third) = 1\n").contains("its operands are the ones"))
    assert(fails("class B\n    var n\n\n    unary_-(self, o) = 1\n").contains("its operands are the ones"))

@test
AN_OPERATOR_MAY_NOT_BE_async_BECAUSE_THERE_IS_NOWHERE_TO_AWAIT_IT()
    // `a + b` has nowhere to put an `await`, so an `async` operator would leave a pending promise in
    // the sum and every complaint about it would arrive somewhere else entirely. **The sentence has to
    // be reachable**: the lookahead reads an operator after `async` for no other reason than that
    // `parse_def` can say this instead of the class body's general complaint about the shape of a line.
    assert(fails("class B\n    var n\n\n    async +(self, o) = 1\n").contains("there is nowhere in `a + b` to await what it answers"))

@test
AN_OPERATOR_A_CLASS_MAY_NOT_ANSWER_FOR_GETS_ITS_OWN_SENTENCE()
    // **The list is closed on purpose**: the bitwise operators, `&&` and `!` are all cases where a
    // type answering for itself would be answering a question about bits or about truth, which is not
    // a thing a value object has an opinion on. The general complaint about a class body's shape
    // would send the reader to look at a line whose shape is right.
    assert(fails("class B\n    var n\n\n    &(self, o) = 1\n").contains("is not an operator a class may answer for"))
    assert(fails("class B\n    var n\n\n    &&(self, o) = 1\n").contains("is not an operator a class may answer for"))
    assert(fails("class B\n    var n\n\n    !(self) = 1\n").contains("is not an operator a class may answer for"))

@test
A_WORD_NAMED_METHOD_IS_AN_ORDINARY_METHOD_AND_NO_OPERATOR_REACHES_IT()
    // **The word hooks are GONE rather than kept beside the operators.** `plus`, `times`, `compare`
    // and `negated` are ordinary names with no operator meaning at all -- two spellings for one hook
    // would have been two ways for a class to disagree with itself.
    val worded = "class M\n    var c\n\n    plus(self, o) = M(self.c + o.c)\n    compare(self, o) = self.c - o.c\n" +
        "    negated(self) = M(-self.c)\n\nval a = M(1)\nval b = M(2)\n"

    assert(fails(worded + "print(a + b)").contains("`+` does not apply"))
    assert(fails(worded + "print(a < b)").contains("`<` does not apply"))
    assert(fails(worded + "print(-a)").contains("`-` needs a number"))

    // They are still perfectly good methods; nothing about them is refused.
    assert_eq(out(worded + "print(a.plus(b).c, a.compare(b), a.negated().c)"), "3 -1 -1")

@test
EVERY_HOOK_TAKES_THE_RECEIVER_AND_A_CAPTURED_ONE_TAKES_NONE()
    // **The rule is about where the function was FOUND**, which is `CallMethod`'s rule exactly: a
    // method reached through a `proto` is handed the object and one stored on the object is not.
    assert_eq(out("class M\n    var c\n\n    ==(self, o) = o is M && self.c == o.c\n\nprint(M(1) == M(1), M(1) == { c: 1 })"),
        "true false")

    assert_eq(out("class K\n    var v\n\n    hash(self) = 7\n    ==(self, o) = true\n\nvar t = {}\nt[K(1)] = \"s\"\nprint(t[K(2)], keys(t).length)"),
        "s 1")

    // **A hook reached through an ordinary `proto` takes it too**, there being one rule and not one
    // rule per hook.
    assert_eq(out("val Keyed = { hash: (self) -> 7, \"==\": (self, o) -> true }\nvar t = {}\nt[{ v: 1, proto: Keyed }] = \"s\"\nprint(t[{ v: 2, proto: Keyed }], keys(t).length)"),
        "s 1")

    // Where a hook is captured on the object instead, it takes no receiver.
    assert_eq(out("val v = { n: 1, \"+\": o -> o.n + 1 }\nprint(v + { n: 4 })"), "5")
    assert_eq(out("print({ n: 1, \"==\": o -> true } == { z: 9 })"), "true")

@test
EVERY_OPERATOR_NAMES_ITSELF_IN_A_COMPLAINT_AND_SIX_OF_THEM_DID_NOT()
    // **`op_text` had `_ -> \"?\"` and the six bitwise operators fell into it**, so `v & w` on two
    // objects said *"`?` does not apply to an object and an object"* -- a sentence naming an
    // operator slate does not have, about a line holding one it does.
    assert(fails("val a = { }\nprint(a & a)").contains("`&` does not apply"))
    assert(fails("val a = { }\nprint(a | a)").contains("`|` does not apply"))
    assert(fails("val a = { }\nprint(a ^ a)").contains("`^` does not apply"))
    assert(fails("val a = { }\nprint(a << a)").contains("`<<` does not apply"))
    assert(fails("val a = { }\nprint(a >> a)").contains("`>>` does not apply"))

// A class of two numbers, which is what most of the object-model tests above want.
private const PointClass: string = "class Point\n    var x\n    var y\n\n"
