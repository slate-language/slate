module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// A CALL, AND THE FUNCTION AT THE OTHER END OF IT.
//
// **Cut out of `check.sysl` when that file passed a thousand lines, and the seam was chosen by
// counting what crosses it** -- the repo's rule, and the same one that made `fits.sysl` (the
// lattice) and `signatures.sysl` (what a name nobody declared is). What is here is one question
// asked from both sides: *what does this call answer*, and *is what it was given what it takes*.
// The two are one subject because they are one lookup -- a signature -- and because the markers
// that make a result depend on the arguments make a callback's parameters depend on them too.
//
// So this file holds:
//
// - **what a FUNCTION's type is**: `signature_of` reading a definition's annotations back off the
//   checks the parser desugared them into, and `lambda_type` doing the same for a lambda, whose
//   result is read off its body because a lambda has no way to say one.
// - **what a CALL answers**: `resolved` replacing a marker with the type of the argument it names.
// - **what a call is CHECKED against**: `check_call`, `check_args` and `check_arguments`, plus
//   `check_method`, which asks whether the receiver's kind has the name at all.
// - **the METHOD spelling**, which is the free function with the receiver in front and is therefore
//   not a second set of rules: `call_shape` puts the receiver at position zero and everything after
//   it works in the signature's own numbering.
//
// **`check.sysl` is the walk and this is what the walk asks.** `type_of_expr` stayed there -- it
// answers for every expression and not only for a call -- so five names here are reached from it
// and say so where they are declared.
//
// **The rule is `check.sysl`'s and does not change at the seam**: this pass may only report what the
// machine would also refuse.

// Not `private`: `check_stmts` notes every definition in a block with it.
signature_of(params: Buf[string], required: usize, body: Expr, is_async: bool) -> Type
    var types: Buf[Type] = buf()

    // **A rest parameter is read through `plain_param`**, its name in the tree carrying the mark
    // `ast.sysl` describes -- and an annotation is looked up by the name the body binds.
    for i in 0..<params.len()
        types.push(annotation_for(plain_param(params.at(i)), body))

    // **An `async` function answers a promise and not what its body says**, so a result annotation
    // on one describes the awaited value rather than the call. Nothing here can say that yet, so it
    // says nothing.
    val result = if is_async then type_of(Any) else result_annotation(body)

    type_of(FunctionType(types, required, variadic_params(params), result))
end signature_of

// Whether the last parameter gathers what is left over.
//
// **A call on one has no upper arity**, so counting it against `params.len()` would refuse a program
// that runs -- which is the one thing this pass may not do.
private variadic_params(params: Buf[string]) -> bool =
    !params.is_empty() && rest_param(params.at(params.len() - 1)).is_some()

// How many arguments a call must give: every parameter with neither a default nor the dots.
//
// **A rest parameter is not one of them.** It is always bound -- to an empty array where a call gave
// nothing left over -- which is `compile_chunk`'s rule and has to be the same rule here, or the
// checker refuses a call the machine accepts.
// Not `private`: `check_stmts` counts a definition's required parameters with it.
floor_of(params: Buf[string], defaults: usize) -> usize =
    (if variadic_params(params) then params.len() - 1 else params.len()) - defaults

// The `CheckType` a parameter's annotation became, if it had one.
private annotation_for(name: string, body: Expr) -> Type
    *body.kind match
        Ensures(inner, _, _) -> return annotation_for(name, inner)
        Block(stmts) ->
            for i in 0..<stmts.len()
                *stmts.at(i).kind match
                    // **Only the run of checks at the TOP of the body is read.** They are what the
                    // parser put there; a `CheckType` further down could not exist, and stopping at
                    // the first ordinary statement is what keeps that true if one ever could.
                    CheckType(checked, _, pat) ->
                        if checked == name then return type_from_pattern(resolve_pattern(pat, 0))
                    _ -> return type_of(Any)

            type_of(Any)
        _ -> type_of(Any)
end annotation_for

private result_annotation(body: Expr) -> Type
    *body.kind match
        Ensures(_, _, pat) -> type_from_pattern(resolve_pattern(pat, 0))
        _ -> type_of(Any)

// **`block` is the statements this one stands among**, which is what a `val`'s shape and a `var`'s
// type are both worked out from: every assignment to a local name, and every mention of it, is
// written in the block that declared it.

// Not `private`: `check_stmt` walks a definition's body and `check_expr` a lambda's.
check_body(params: Buf[string], defaults: Buf[Expr], body: Expr, env: *TypeEnv, expect: Buf[Type])
    enter_scope(env)

    // **The name the BODY binds, which is the plain one** -- a rest parameter carries its mark only
    // in the tree, and a body that named `...rest` would be naming something unspellable.
    for i in 0..<params.len()
        note_type(env, plain_param(params.at(i)), param_type(params.at(i), body, expect, i))

    for i in 0..<defaults.len()
        check_expr(defaults.at(i), env)

    check_expr(body, env)
    leave_scope(env)
end check_body

// -- what is complained about at a call --------------------------------------------------------------

// Whether the receiver's KIND has a method of this name at all.
//
// **It asks the machine's own question**: `methods_of` in `method.sysl` is the table
// `builtin_method` dispatches through, so a name added to a kind is added in one place and the two
// can never disagree.
// Not `private`: `check_expr`'s Call arm asks it before the arguments are checked.
check_method(callee: Expr, env: *TypeEnv)
    *callee.kind match
        Field(target, name, _) ->
            val t = type_of_expr(target, env)

            if !certain(t) then return

            val kind = method_kind_word(t)

            if kind == "" then return
            if methods_of(kind, name).is_some() then return

            // **The same sentence the machine would have printed**, down to the article: a reader
            // who meets this at compile time and then at run time must not have to work out that the
            // two are one complaint.
            complain_here(callee.span, s"`${name}` is not something ${article(kind)} ${kind} can do")
        _ -> ()
end check_method

// The word a type's methods are looked up under, or `""` where it has none to look up.
//
// **Only the kinds `method.sysl` has a table for**, which is what keeps this from claiming anything
// about an object, a function or `null`: an object's names belong to the program, and the other two
// have no methods at all, so a complaint about either would have to come from somewhere that knows
// more than this does.
private method_kind_word(t: Type) -> string
    *t.kind match
        StringType -> "string"

        // **`integer` and `real` rather than `number`**, since that is what `type_name` says at run
        // time and the two messages have to read alike. `methods_of` takes all three words and
        // answers from the one table.
        IntegerType -> "integer"
        RealType -> "real"
        NumberType -> "number"
        ArrayOf(_) -> "array"
        NamedType(name) -> name
        RegexType -> "regex"
        _ -> ""
end method_kind_word

// A call whose callee is a function the pass knows the shape of.
//
// **Arity first, and it stops there when it is wrong**, because a mismatched count makes every
// argument's position a guess -- reporting four type errors for one missing argument is the
// commonest way a checker becomes something to work around.

// Not `private`: `check_expr`'s Call arm.
check_call(callee: Expr, args: Buf[Expr], env: *TypeEnv, at: Span)
    // **A spread makes the count unknowable, so this pass says nothing about the call at all.**
    // `f(...xs)` gives `f` as many arguments as `xs` has elements, which is a run-time fact; a
    // checker counting the spread as one argument would refuse a program that runs, and that is the
    // one mistake it may not make. The machine still counts, at the call.
    for i in 0..<args.len()
        *args.at(i).kind match
            Spread(_) -> return
            _ -> ()

    val shape = call_shape(callee, args, env, true)

    check_arguments(shape.sig, callee, shape.args, env, at, shape.unwritten, shape.agreed)
end check_call

// What a call is going to, and the arguments in ITS coordinates.
//
// **A BUILTIN METHOD IS THE FREE FUNCTION IT IS, receiver in front.** Without that the nicer
// spelling cost the reader every diagnostic this pass has: `xs.filter(p)` typed the callee, got a
// field read off an array, and said nothing about arity or about a single argument. So the receiver
// goes at position zero, `unwritten` is 1, and everything downstream works in the signature's own
// numbering -- which is also what lets `xs.map(n -> n * 2)` find the element type, the marker in
// `map`'s callback naming argument zero and argument zero being the receiver.
//
// **`unwritten` is subtracted from every number a COMPLAINT says**, the reader not having written
// the receiver: *"`filter` takes 2 arguments and this gives it 1"* about `xs.filter()` sends them
// looking for an argument they can see two of.
private call_shape(callee: Expr, args: Buf[Expr], env: *TypeEnv, reporting: bool) -> CallShape
    *callee.kind match
        Field(target, name, optional) ->
            if !optional
                method_signature(type_of_expr(target, env), name) match
                    Some(sig) -> return CallShape(sig, with_receiver(target, args), 1, true)
                    None -> ()
        _ -> ()

    val sig = type_of_expr(callee, env)

    // **A generic signature is solved HERE, before anything is checked or quoted**, which is the
    // arrangement a marker already has: everything downstream reads one signature and none of it
    // learns that type parameters exist.
    if has_typevar(sig)
        var agreed = true
        val solved = solved_generics(sig, args, env, reporting, &agreed)

        return CallShape(solved, args, 0, agreed)
    end if

    CallShape(sig, args, 0, true)
end call_shape

struct CallShape
    sig: Type
    args: Buf[Expr]
    unwritten: usize

    // Whether the arguments agreed on one type for every parameter they solved.
    //
    // **A call that did not is REFUSED ALREADY, so its arguments are not compared as well.** The
    // signature it was solved to holds the first candidate, and every argument that disagreed would
    // be measured against that one and complained about a second time -- which is the shape a
    // wrong ARITY already steps aside from, and for its reason: one mistake, one sentence.
    agreed: bool
end CallShape

// The arguments walked, a callback knowing what it is going to be handed.
//
// **THIS IS WHERE A LAMBDA'S PARAMETERS STOP BEING `Any`**, and it is the whole of what makes an
// element type reach a callback's body: `map(names, n -> n * 2)` is refused where `names` is an
// `array of string`, because `n` is a string inside the body and `string * integer` is a fault the
// machine would raise.
//
// **It is sound on the pass's own terms.** A callback is called with an element of the array beside
// it -- `call_on` in `array.sysl` -- and every `array of T` this pass holds is one the machine
// checked element by element at a parameter or a declared result. An empty array calls nothing, so
// the complaint is about a line that may not run; that is true of every complaint this pass makes,
// an arity error inside an untaken branch included.
// Not `private`: `check_expr`'s Call arm walks a call's arguments through this.
check_args(callee: Expr, args: Buf[Expr], env: *TypeEnv)
    // **Silent, because `check_call` asks the same question and complaining is ITS job.** Both walk
    // every call, so a refusal raised here would name one mistake twice.
    val shape = call_shape(callee, args, env, false)

    // **The guard, and it is the same one `has_marker` is**: working an expectation out means typing
    // the arguments, and a handful of signatures have anything to say. Every other call walks its
    // arguments exactly as it did.
    if !takes_callback(shape.sig)
        for i in 0..<args.len()
            check_expr(arg_body(args.at(i)), env)

        return
    end if

    val given = argument_types(shape.args, env, shape.sig)

    for i in 0..<args.len()
        val x = arg_body(args.at(i))
        val expect = callback_params(shape.sig, i + shape.unwritten, given)

        if expect.is_empty()
            check_expr(x, env)
        else
            *x.kind match
                Lambda(params, defaults, body, _) -> check_body(params, defaults, body_at(body), env, expect)
                _ -> check_expr(x, env)
end check_args

// One call, against the signature it is going to.
//
// **`unwritten` is the receiver, and it is subtracted from every number a COMPLAINT says.** The
// method spelling means a call with the receiver in front, so the check counts it -- but the reader
// did not write it, and *"`filter` takes 2 arguments and this gives it 1"* about `xs.filter()` sends
// them looking for an argument they can see two of.
private check_arguments(sig: Type, callee: Expr, args: Buf[Expr], env: *TypeEnv, at: Span, unwritten: usize, agreed: bool)
    *sig.kind match
        FunctionType(params, required, variadic, result) ->
            // A lambda's type has `Any` parameters and says nothing; a definition with no annotated
            // parameter has the same shape. Either way there is nothing here to check against.
            // **`FunctionType(no params, any result)` IS THE BARE WORD `function`**, which says
            // callable and nothing about arity -- `f: function` writes exactly that. Counting
            // against it would refuse `f(1)` inside a function whose parameter was annotated
            // `function`, which runs. The cost is that a genuine `() -> x` has the same shape and
            // goes uncounted too, and the cost is worth paying to be sure.
            if !says_nothing(params, result) && (args.len() < required || (!variadic && args.len() > params.len()))
                val floor = if required > unwritten then required - unwritten else 0
                val ceiling = if params.len() > unwritten then params.len() - unwritten else 0

                complain_here(at, s"${named(callee)} ${takes_from(floor, ceiling, variadic)} and this gives it ${args.len() - unwritten}")
                return
            end if

            // **Nothing is checked where there are more arguments than parameters**, which is also
            // the case a type saying nothing about arity leaves behind: there is no parameter
            // opposite an argument to compare it to. Where there are FEWER, every argument still
            // has one, and the ones nobody gave are the defaults.
            if variadic || args.len() > params.len() then return

            // The call has already been refused over a type parameter no argument could settle.
            if !agreed then return

            // **A NAMED ARGUMENT IS NOT AT THE POSITION IT WAS WRITTEN AT, and this pass cannot say
            // where it IS.** `FunctionType` carries the parameter TYPES and not their names, so
            // there is nothing here to match `greeting =` against -- and checking the argument
            // against the parameter it happens to sit opposite would compare a value to a type it
            // was never going to meet. That is reporting what the machine would not, which is the
            // one thing this pass may not do, so it steps aside exactly as it does for a spread.
            //
            // The COUNT above still holds: every parameter without a default has to be given and no
            // call may give more than there are, so a named call's count is between the same two
            // ends a positional one's is.
            for i in 0..<args.len()
                *args.at(i).kind match
                    Named(_, _) -> return
                    _ -> ()

            // **A MARKER IN A PARAMETER IS RESOLVED BEFORE ANYTHING IS COMPARED OR QUOTED.** A
            // callback's parameter type names an argument by position, so `map`'s says `(<an
            // element of argument 0>) -> any` until the array is looked at -- and a marker may
            // never reach a reader. Everything else takes the cheap path and types one argument at
            // a time, which is what almost every call is.
            val given: Buf[Type] = if takes_callback(sig) then argument_types(args, env, sig) else buf()

            for i in 0..<args.len()
                val raw = params.at(i)
                val want = if given.is_empty() then raw else resolved(raw, given)
                val got = if i < given.len() then given.at(i) else type_of_expr(args.at(i), env)

                // **A MARKER IS WHAT SAYS A NATIVE WILL BE DOING THE CALLING**, and that is what
                // makes the callback relaxation sound: a builtin's callback parameter names an
                // argument by position -- `map`'s is `(<an element of argument 0>) -> any` -- where a
                // parameter the PROGRAM annotated never carries one. So a function of fewer
                // parameters fits here and nowhere else, which is exactly where the caller adapts.
                val adapting = has_marker(raw)

                // **A LITERAL WRITTEN AT AN ANNOTATED PARAMETER MAY CARRY NOTHING THE PARAMETER
                // DOES NOT NAME**, which is the pass's third deliberate bend and is
                // `check_expr.sysl`'s to explain. `want` is whatever the signature says by the time
                // it reaches here, so a parameter typed by a solved `T` is checked with no arm of
                // its own. Asked BEFORE `fits`, and its refusal stands instead of that one: a
                // misspelled field is missing and spare at once, and naming the spelling is the
                // half of that worth saying.
                if !refuse_excess_fields(args.at(i), want) &&
                        !(if adapting then fits_callback(got, want) else fits(got, want))
                    complain_here(args.at(i).span, s"${named(callee)} takes ${show_type(want)} here, and this is ${show_type(got)}")
        _ -> ()
end check_arguments

// What an argument's value is, a named one carrying it inside.
private arg_body(x: Expr) -> Expr = *x.kind match
    Named(_, value) -> value
    _ -> x

// The half of an arity complaint that says what the function will accept.
// **A function that gathers has no upper end, so the only thing to say is the floor** -- and naming
// one anyway sends the reader looking for a limit the function does not have. This is the machine's
// `arity_complaint` said in the checker's voice, and the two have to agree about what they refuse.
private takes_from(required: usize, takes: usize, variadic: bool) -> string
    if variadic then return s"takes at least ${counted(required, "argument")}"

    if required == takes then return s"takes ${counted(takes, "argument")}"

    s"takes from ${required} to ${counted(takes, "argument")}"
end takes_from

private says_nothing(params: Buf[Type], result: Type) -> bool
    if !params.is_empty() then return false

    *result.kind match
        Any -> true
        _ -> false
end says_nothing

// **Only where BOTH sides are known and neither could meet the other.** `1 + "a"` is a fault the
// machine would raise, so saying it now is moving the same complaint earlier; anything less certain
// is left alone.

// Not `private`: `type_of_expr`'s Call arm.
resolved(t: Type, given: Buf[Type]) -> Type
    *t.kind match
        SameAsArg(at) -> given_at(at, given)
        ElementOf(at) -> *given_at(at, given).kind match
            ArrayOf(element) -> element
            _ -> type_of(Any)
        ResultOf(at) -> *given_at(at, given).kind match
            FunctionType(_, _, _, result) -> result
            _ -> type_of(Any)
        ArrayOf(element) -> type_of(ArrayOf(resolved(element, given)))

        // **A CALLBACK'S PARAMETERS ARE RESOLVED THE SAME WAY ITS CALLER'S RESULT IS**, which is
        // what lets `map`'s function say it is handed an element of the array beside it. Nothing
        // else about the type moves: a marker in a parameter names an argument by position exactly
        // as one in a result does.
        FunctionType(params, required, variadic, result) ->
            var out: Buf[Type] = buf()

            for i in 0..<params.len()
                out.push(resolved(params.at(i), given))

            type_of(FunctionType(out, required, variadic, resolved(result, given)))
        OneOf(alts) ->
            var out: Buf[Type] = buf()

            for i in 0..<alts.len()
                out.push(resolved(alts.at(i), given))

            type_of(OneOf(out))
        _ -> t
end resolved

private given_at(at: usize, given: Buf[Type]) -> Type =
    if at >= given.len() then type_of(Any) else given.at(at)

// Whether a signature's result depends on the call at all.
//
// **THE GUARD THAT KEEPS THIS FREE FOR EVERY OTHER CALL, and it is not an optimisation to be tidied
// away.** Resolving means typing the arguments, and typing an argument that is itself a call types
// ITS arguments -- so doing it unconditionally costs a chain like `xs.sorted().reversed()` a fresh
// walk of the whole prefix at every link. That took the suite from 25 seconds to 65. Almost no
// signature has a marker in it, so almost no call pays anything.
// Not `private`: `type_of_expr`'s Call arm, which is the guard that keeps this free.
has_marker(t: Type) -> bool
    *t.kind match
        SameAsArg(_) -> true
        ElementOf(_) -> true
        ResultOf(_) -> true
        ArrayOf(element) -> has_marker(element)
        FunctionType(params, _, _, result) ->
            for i in 0..<params.len()
                if has_marker(params.at(i)) then return true

            has_marker(result)
        OneOf(alts) ->
            for i in 0..<alts.len()
                if has_marker(alts.at(i)) then return true

            false
        _ -> false
end has_marker

// -- a call to a generic function ------------------------------------------------------------------

// Whether a signature is generic at all.
//
// **`has_marker`'s guard, one more time and for its reason**: solving means typing the arguments,
// and almost nothing is generic -- so this is asked first and a call to anything else pays nothing.
//
// Not `private`: `type_of_expr`'s Call arm asks it before it asks for a result.
has_typevar(t: Type) -> bool
    *t.kind match
        TypeVar(_) -> true
        ArrayOf(element) -> has_typevar(element)
        ObjectWith(_, values, _) ->
            for i in 0..<values.len()
                if has_typevar(values.at(i)) then return true

            false
        FunctionType(params, _, _, result) ->
            for i in 0..<params.len()
                if has_typevar(params.at(i)) then return true

            has_typevar(result)
        OneOf(alts) ->
            for i in 0..<alts.len()
                if has_typevar(alts.at(i)) then return true

            false
        _ -> false
end has_typevar

// One generic signature, with its type parameters solved from the arguments this call gives it.
//
// **THE PARAMETERS ARE SOLVED LEFT TO RIGHT, WHICH IS WHAT LETS A CALLBACK BE TYPED FROM THE
// ARGUMENTS BEFORE IT.** `map2[A, B](xs: array of A, f: A -> B) -> array of B` solves `A` from the
// array, so the lambda's own parameter is typed before its body is read -- and `B` is then whatever
// that body answered. It is `argument_types`' own order, for `argument_types`' own reason.
//
// **EVERY ARGUMENT MUST BE CONTAINED IN THE TYPE THE PARAMETER WAS SOLVED TO, and a call where none
// of the candidates contains the rest is REFUSED.** `pair[T](a: T, b: T)` given `pair(1, "x")` is a
// mistake, and TypeScript reads it as one; a union would have made it mean something instead. **A
// union is still an answer where the PROGRAM declared one** -- `val x: integer | string` handed to
// `pair(x, 1)` solves `T` to that union, because the other candidate fits it.
//
// **The candidates are gathered and then chosen between, rather than merged as they arrive.** The
// two differ, and the case that separates them is real: `integer`, then `real`, then `number` has an
// answer -- `number`, which the other two fit -- and an incremental merge refuses at the second
// argument before it has seen the one that would have settled it.
//
// **An unsolved parameter is `Any`, and it may not be left standing.** A type nobody solved would
// otherwise be quoted at a reader -- `takes T here` -- naming a thing they cannot act on, which is
// the rule a marker already follows.
//
// **`reporting` IS WHAT KEEPS ONE MISTAKE FROM BEING NAMED TWICE.** Two passes solve every generic
// call -- `call_shape` before anything is checked, and `type_of_expr` before anything is answered --
// so the complaint belongs to the one whose job is complaining, and the other asks the same question
// in silence.
//
// Not `private`: `call_shape` solves before anything is checked and `type_of_expr` before anything
// is answered.
solved_generics(sig: Type, args: Buf[Expr], env: *TypeEnv, reporting: bool, agreed: *bool) -> Type
    *sig.kind match
        FunctionType(params, required, variadic, result) ->
            // **Every candidate any argument offered, with the argument it came from.** The span is
            // carried because the complaint has to point at the argument that disagrees rather than
            // at the call, which is where a reader can do something about it.
            var seen: Buf[string] = buf()
            var offered: Buf[Type] = buf()
            var offered_at: Buf[Span] = buf()
            var names: Buf[string] = buf()
            var bound: Buf[Type] = buf()
            var stop = false

            for i in 0..<args.len()
                if !stop && i < params.len()
                    // **THE PARAMETER IS SOLVED AGAINST AS IT WAS WRITTEN, and instantiated only to
                    // ask a lambda what it will be handed.** Solving against the instantiated one
                    // erases every parameter not yet solved to `Any` -- so `array of T` becomes
                    // `array of any`, and the argument beside it then answers nothing at all. That
                    // was the first draft, and it made every type parameter come out `any`.
                    val declared = params.at(i)

                    *args.at(i).kind match
                        // **A named or a spread argument is not at the position it was written at**,
                        // so everything from there on says nothing about which parameter it fills.
                        Named(_, _) -> stop = true
                        Spread(_) -> stop = true
                        Lambda(ps, ds, body, is_async) ->
                            // **A lambda is told what it will be handed out of what the arguments
                            // BEFORE it have already said**, so the parameters it declares get the
                            // element type rather than `Any`. Chosen in silence: an argument still
                            // to come may be the one that settles the parameter, so a complaint from
                            // here would be about a call the walk has not finished reading.
                            var so_far: Buf[string] = buf()
                            var so_far_bound: Buf[Type] = buf()

                            var quietly = true

                            settled(seen, offered, offered_at, false, &quietly, &so_far, &so_far_bound)

                            val expect = wanted_params(instantiated(declared, so_far, so_far_bound))

                            solve_into(declared, lambda_type(ps, ds, body, is_async, env, expect), args.at(i).span, &seen, &offered, &offered_at)
                        _ -> solve_into(declared, type_of_expr(args.at(i), env), args.at(i).span, &seen, &offered, &offered_at)

            settled(seen, offered, offered_at, reporting, agreed, &names, &bound)

            var out: Buf[Type] = buf()

            for i in 0..<params.len()
                out.push(instantiated(params.at(i), names, bound))

            type_of(FunctionType(out, required, variadic, instantiated(result, names, bound)))
        _ -> sig
end solved_generics

// Every type parameter the arguments named, each given the one type they agree on.
private settled(seen: Buf[string], offered: Buf[Type], offered_at: Buf[Span], reporting: bool, agreed: *bool,
                names: *Buf[string], bound: *Buf[Type])
    for i in 0..<seen.len()
        val name = seen.at(i)
        var already = false

        for j in 0..<names.len()
            if names.at(j) == name then already = true

        if !already
            names.push(name)
            bound.push(agreed_type(name, seen, offered, offered_at, reporting, agreed))
end settled

// The candidate every other candidate for this parameter fits, and a complaint where there is none.
//
// **ONE WALK ANSWERS AND COMPLAINS**, for the reason `pattern_declares` is one question: an answer
// worked out here and a refusal worked out somewhere else would be two readings of the same
// arguments, and nothing would notice when they stopped agreeing.
//
// **Where nothing contains the rest the FIRST candidate is still answered**, so the pass carries on
// with a type rather than an `Any` that would draw a second complaint about every use of it. The
// program is already refused; what is left is to say one useful thing about it.
private agreed_type(name: string, seen: Buf[string], offered: Buf[Type], offered_at: Buf[Span], reporting: bool, agreed: *bool) -> Type
    for i in 0..<seen.len()
        if seen.at(i) == name
            val candidate = offered.at(i)
            var contains = true

            for j in 0..<seen.len()
                if seen.at(j) == name && !fits(offered.at(j), candidate) then contains = false

            if contains then return candidate

    val first = first_offered(name, seen, offered)

    *agreed = false

    // **The complaint points at the argument that disagrees, not at the one that got there first.**
    // A reader who believes it goes and looks at the argument they can change; naming the call would
    // send them to the definition, which is not where the mistake is.
    if reporting
        for i in 0..<seen.len()
            if seen.at(i) == name && !fits(offered.at(i), first)
                complain_here(offered_at.at(i), s"`${name}` is ${show_type(first)} from an argument before this one, and this is ${show_type(offered.at(i))}")
                return first

    first
end agreed_type

private first_offered(name: string, seen: Buf[string], offered: Buf[Type]) -> Type
    for i in 0..<seen.len()
        if seen.at(i) == name then return offered.at(i)

    type_of(Any)

// What a callback of this type is handed, where the type is a function at all.
private wanted_params(want: Type) -> Buf[Type]
    *want.kind match
        FunctionType(params, _, _, _) -> params
        _ -> buf()

// What one argument says about the parameters standing in the type it was handed to.
//
// **Structural and one-sided: it reads what the two have in common and ignores the rest.** A shape
// that does not line up says nothing rather than complaining -- whether the argument FITS is a
// separate question, asked afterwards and by `fits`, against a signature this has already solved.
private solve_into(want: Type, got: Type, at: Span, seen: *Buf[string], offered: *Buf[Type], offered_at: *Buf[Span])
    *want.kind match
        TypeVar(name) -> note_candidate(name, got, at, seen, offered, offered_at)
        ArrayOf(element) -> *got.kind match
            ArrayOf(had) -> solve_into(element, had, at, seen, offered, offered_at)
            _ -> ()
        ObjectWith(keys, values, _) -> *got.kind match
            ObjectWith(had_keys, had_values, _) ->
                for i in 0..<keys.len()
                    for j in 0..<had_keys.len()
                        if keys.at(i) == had_keys.at(j)
                            solve_into(values.at(i), had_values.at(j), at, seen, offered, offered_at)
            _ -> ()
        FunctionType(params, _, _, result) -> *got.kind match
            FunctionType(had, _, _, had_result) ->
                for i in 0..<params.len()
                    if i < had.len() then solve_into(params.at(i), had.at(i), at, seen, offered, offered_at)

                solve_into(result, had_result, at, seen, offered, offered_at)
            _ -> ()
        OneOf(_) -> ()
        _ -> ()
end solve_into

// One thing an argument said this parameter could be.
//
// **`Any` is not an answer and is dropped.** An argument nothing is known about says nothing about
// `T`, and recording it would refuse a call over a value whose type nobody wrote down -- which is
// the opposite of what this check is for.
private note_candidate(name: string, t: Type, at: Span, seen: *Buf[string], offered: *Buf[Type], offered_at: *Buf[Span])
    *t.kind match
        Any -> return
        _ -> ()

    seen.push(name)
    offered.push(t)
    offered_at.push(at)

// One type with every solved parameter put in and every unsolved one erased to `Any`.
private instantiated(t: Type, names: Buf[string], bound: Buf[Type]) -> Type
    *t.kind match
        TypeVar(name) ->
            for i in 0..<names.len()
                if names.at(i) == name then return bound.at(i)

            type_of(Any)
        ArrayOf(element) -> type_of(ArrayOf(instantiated(element, names, bound)))
        ObjectWith(keys, values, optional) ->
            var out: Buf[Type] = buf()

            for i in 0..<values.len()
                out.push(instantiated(values.at(i), names, bound))

            type_of(ObjectWith(keys, out, optional))
        FunctionType(params, required, variadic, result) ->
            var out: Buf[Type] = buf()

            for i in 0..<params.len()
                out.push(instantiated(params.at(i), names, bound))

            type_of(FunctionType(out, required, variadic, instantiated(result, names, bound)))
        OneOf(alts) ->
            var out: Buf[Type] = buf()

            for i in 0..<alts.len()
                out.push(instantiated(alts.at(i), names, bound))

            type_of(OneOf(out))
        _ -> t
end instantiated

// The types of a call's arguments, each worked out ONCE.
//
// **A named or spread argument is not at the position a marker names**, so one anywhere in the list
// gives the rest of it up rather than answering some other argument's type -- which would report
// what the machine would not.
// **A LAMBDA IS TYPED WITH WHAT THE SIGNATURE SAYS IT WILL BE HANDED**, which is where the element
// type reaches a callback's body: `map(ns, n -> n * 2)` is an `array of integer` and not an `array
// of any` because `n` is an integer while the body is read. The arguments are typed left to right
// and a marker in a callback's parameter can only name one already done — the array comes first in
// every signature that has one — so `out` is all the expectation ever needs.
// Not `private`: `type_of_expr`'s Call arm, which resolves a marker against them.
argument_types(args: Buf[Expr], env: *TypeEnv, sig: Type) -> Buf[Type]
    var out: Buf[Type] = buf()

    for i in 0..<args.len()
        *args.at(i).kind match
            Named(_, _) -> return out
            Spread(_) -> return out
            Lambda(params, defaults, body, is_async) ->
                out.push(lambda_type(params, defaults, body, is_async, env, callback_params(sig, i, out)))
            _ -> out.push(type_of_expr(args.at(i), env))

    out
end argument_types

// What the function at argument `at` will be handed, said in terms of the arguments before it.
//
// **Empty wherever the signature says nothing**, which is every parameter that is not a callback
// and every callee this pass could not see. A caller that gets an empty answer types the lambda
// exactly as it did before.
private callback_params(sig: Type, at: usize, given: Buf[Type]) -> Buf[Type]
    *sig.kind match
        FunctionType(params, _, _, _) ->
            if at >= params.len() then return buf()

            *params.at(at).kind match
                FunctionType(inner, _, _, _) ->
                    var out: Buf[Type] = buf()

                    for i in 0..<inner.len()
                        out.push(resolved(inner.at(i), given))

                    out
                _ -> buf()
        _ -> buf()
end callback_params

// Whether a signature says what any of its callbacks is handed.
//
// **`has_marker`'s guard again, for the same reason and at the other end.** Working the expectation
// out means typing the arguments, and only a handful of signatures have anything to say — so this
// is asked first and a call to anything else pays nothing.
private takes_callback(sig: Type) -> bool
    *sig.kind match
        FunctionType(params, _, _, _) ->
            for i in 0..<params.len()
                if has_marker(params.at(i)) then return true

            false
        _ -> false
end takes_callback

// THE SIGNATURE OF A BUILTIN METHOD, WHICH IS THE FREE FUNCTION OF THAT NAME.
//
// **`xs.map(f)` IS `map(xs, f)`** -- one implementation, one set of argument checks and one
// diagnostic for each, reachable two ways. That is `method.sysl`'s rule and the whole of this: the
// receiver goes in front of the written arguments, and everything the pass knows about the free
// function applies to the method spelling. Without it, writing in method style lost the checker
// entirely -- which is a bad thing to charge for the nicer spelling.
//
// **Dispatch is on the KIND of the receiver**, so an object is refused here rather than looked up: a
// method on an object is a field the PROGRAM wrote, and checking `o.filter(x)` against the builtin
// `filter` would be checking it against a function that has nothing to do with it. `method_kind_word`
// answering `""` is that test, and it covers `Any` too.
//
// **`methods_of` is asked before the signature is**, so a name that is not a method of this kind
// never reaches the free function of the same name -- `xs.upper()` is `check_method`'s complaint,
// not a complaint about `upper`'s argument.

private method_signature(t: Type, name: string) -> Option[Type]
    if !certain(t) then return None

    val kind = method_kind_word(t)

    if kind == "" then return None
    if methods_of(kind, name).is_none() then return None

    val sig = known_type(&builtin_types, name)

    *sig.kind match
        FunctionType(_, _, _, _) -> Some(sig)
        _ -> None
end method_signature

// What a builtin method call answers, which is what the free function it is answers.
// Not `private`: `type_of_expr`'s Call arm, for the method spelling.
method_result(target: Expr, name: string, args: Buf[Expr], env: *TypeEnv) -> Option[Type]
    method_signature(type_of_expr(target, env), name) match
        Some(sig) -> *sig.kind match
            FunctionType(_, _, _, result) ->
                if !has_marker(result) then return Some(result)

                Some(resolved(result, argument_types(with_receiver(target, args), env, sig)))
            _ -> None
        None -> None
end method_result

// The receiver in front of the written arguments, which is the call the method spelling means.
private with_receiver(target: Expr, args: Buf[Expr]) -> Buf[Expr]
    var out: Buf[Expr] = buf()

    out.push(target)

    for i in 0..<args.len()
        out.push(args.at(i))

    out
end with_receiver

// WHAT A LAMBDA ANSWERS, read off its body.
//
// **A lambda is the one function that cannot SAY what it answers** -- `x -> integer` is a body that
// hands back the builtin, and there is no other place to write one -- so inferring it is the only
// way `map(xs, n -> string(n))` can be an `array of string`. A named function says `-> integer` and
// is believed, which is why this is not needed there.
//
// **The parameters are `Any` and are put in scope before the body is read**, so that a body naming
// one gets nothing rather than picking up whatever an outer scope calls it. Without that,
// `val x = "s"` then `map(ns, x -> x + 1)` would read the outer `x` and answer string.
//
// **A block body says nothing**, `type_of_expr` having no arm for one: what a block answers is its
// last statement or any `return` inside it, and reading only the last would be wrong wherever a
// `return` is written above it. An expression body is what a lambda usually is.
//
// **An `async` lambda answers a PROMISE**, which is `signature_of`'s rule for the same reason: what
// the body gives back is what awaiting the call produces, not what calling it does.

private lambda_result(params: Buf[string], body: usize, is_async: bool, env: *TypeEnv, expect: Buf[Type]) -> Type
    if is_async then return type_of(Any)

    enter_scope(env)

    for i in 0..<params.len()
        note_type(env, plain_param(params.at(i)), param_type(params.at(i), body_at(body), expect, i))

    val answered = type_of_expr(body_at(body), env)

    leave_scope(env)
    answered
end lambda_result

// The type of a lambda written at a call, given what the callee says it will be handed.
//
// **An EMPTY expectation is the ordinary case and means nothing has changed** -- a lambda anywhere
// but in a callback's slot is typed exactly as it always was, its parameters saying nothing.
// Not `private`: `type_of_expr`'s Lambda arm.
lambda_type(params: Buf[string], defaults: Buf[Expr], body: usize, is_async: bool, env: *TypeEnv, expect: Buf[Type]) -> Type
    var out: Buf[Type] = buf()

    for i in 0..<params.len()
        out.push(param_type(params.at(i), body_at(body), expect, i))

    type_of(FunctionType(out, floor_of(params, defaults.len()), variadic_params(params), lambda_result(params, body, is_async, env, expect)))
end lambda_type

// What a parameter is worth to the pass: its annotation, then what the caller says it will be
// handed, and `Any` where neither says anything.
//
// **THE TWO CAN NEVER BOTH SPEAK, and the order is written down anyway.** An annotation belongs to
// a DEFINITION, which is called from anywhere and gets no expectation; an expectation belongs to a
// LAMBDA written at a call, and a lambda's parameter cannot be annotated at all -- `(n: integer) ->
// n` is a parse error, there being nowhere in the grammar for it. The annotation is asked first
// because it is what the MACHINE enforces, at the head of the body, where an expectation is only
// what the caller's signature says.
//
// **A rest parameter is an ARRAY whatever a call gave it**, so what an expectation says about one
// element has nothing to do with it.
private param_type(mark: string, body: Expr, expect: Buf[Type], i: usize) -> Type
    rest_param(mark) match
        Some(_) -> return type_of(ArrayOf(type_of(Any)))
        None -> ()

    val said = annotation_for(plain_param(mark), body)

    *said.kind match
        Any -> if i < expect.len() then expect.at(i) else said
        _ -> said
end param_type

// Whether this type says what an object's FIELDS are, and is describing an ordinary object.
//
// **A NOMINAL VALUE'S TYPE IS ITS NAME AND NOT ITS FIELDS**, so a literal carrying a `proto` or one
// of the two tags is refused here. A singleton data variant is a `val` bound to exactly such a
// literal, and keeping its shape made `Empty` a `{ proto: any, (data): string }` that no longer fit
// the data type it belongs to -- refusing a program that runs, from four tests at once.

private named(callee: Expr) -> string
    *callee.kind match
        Name(name) -> s"`${name}`"
        Field(_, name, _) -> s"`${name}`"
        _ -> "this function"
end named
