module dev.slatelang.slate

import sh.sysl.llhttp.{requests, stream, Head, Header, Limits, Part, Request, Requests, Stream}
import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{from_utf8, to_lower, Search}

// HTTP request parsing, which is node's llhttp and is not written in slate.
//
// **`slate:http` owns the server and this owns the parse, which is node's own layering.** The slate
// module keeps everything a server decides -- keep-alive and the client's `Connection` rule, the idle
// clock, `busy` and the order answers go back in, the request and response shapes, the
// 500-and-put-the-fault-back path. What moved down here is only the recognising of bytes, and it
// moved for two reasons that are not preferences:
//
// - **A byte-at-a-time scan is the worst thing an interpreted language can be asked to do**, and it
//   runs over every byte of every request. Worse, the scan restarted from the front of the buffer on
//   each arrival, so a large body cost the interpreter O(n^2).
// - **The malformed request is the whole problem, and it is malformed on purpose.** Two
//   `Content-Length` headers, or one beside a `Transfer-Encoding`, is a request-smuggling primitive:
//   one hop reads a body where the next reads two requests. llhttp is generated from a state machine
//   and refuses those by construction; the slate parser refused the second and did not know about
//   the first.
//
// **It also had no limits at all.** A connection that dribbled bytes and never finished a request
// grew a buffer until the process died, which took no attacker -- an upload sent to a JSON endpoint
// does it. `Limits` is the fix and is the reason this tier of the binding rather than the one below.
//
// ## What a slot holds, and why nothing in it is a slate value
//
// **The collector cannot see through an ARC box**, which is `net.sysl`'s rule and binds here for the
// same reason: a completed request parked in a sysl `Buf` would be invisible to the mark phase. So a
// slot holds llhttp's own `Request` -- sysl strings and buffers -- and the slate object is built in
// `take_request`, at the moment a program asks for one and can root it.
//
// **The callback cannot name the parser it belongs to**, a sysl closure capturing by value and the
// parser not existing yet when the handler is written. A box both of them hold is how that knot is
// untied, which is `Arrived` below.

// One finished request, copied out of the parser's own buffers.
//
// **THE COPY IS NOT OPTIONAL AND ITS ABSENCE IS SILENT.** `Requests` hands the callback a `Request`
// built over its OWN `headers` and `body` buffers, and it reuses those for the next message on the
// connection -- so a queued `&Request` is a window onto storage that the next request writes
// through. Keeping the reference made a pipelined `POST /a` with body `hello` arrive as `hillo`,
// the `hi` of the third request on that connection having been written over the front of the first.
// Nothing failed; the bytes were simply wrong, which is the worst way for this to go wrong.
private struct Held
    method: string
    target: string
    keep_alive: bool
    names: Buf[string]
    values: Buf[string]
    body: Buf[u8]
end Held

// Everything a finished request holds, taken out of the parser's buffers while it is still ours.
private hold_request(r: &Request) -> Held
    var names: Buf[string] = buf()
    var values: Buf[string] = buf()
    var body: Buf[u8] = buf()

    for i in 0..<r.headers.len()
        names.push(r.headers.at(i).name)
        values.push(r.headers.at(i).value)

    for i in 0..<r.body.len()
        body.push(r.body.at(i))

    Held(r.method, r.target, r.keep_alive, names, values, body)
end hold_request

// The same, for a request whose body is not going to be held. The head is bounded and is copied for
// exactly the reason a whole request is; the body is not here at all.
private hold_head(h: &Head) -> Held
    var names: Buf[string] = buf()
    var values: Buf[string] = buf()

    for i in 0..<h.headers.len()
        names.push(h.headers.at(i).name)
        values.push(h.headers.at(i).value)

    Held(h.method, h.target, h.keep_alive, names, values, buf())
end hold_head

// One thing a streaming parser has ready: a head, some bytes of a body, or the end of one.
//
// **The bytes are copied here too**, and for the harder version of the same reason. A whole request
// is handed over once; a chunk is handed over from inside `execute`, over the read buffer slate
// passed in, and that buffer is gone by the time the program is looking at anything. What the copy
// costs is one read's worth of bytes held between `httpFeed` and the pump that drains it -- not the
// body, which is the whole point.
private enum Piece
    HeldHead(h: Held)
    HeldChunk(bytes: Buf[u8])
    HeldEnd
end Piece

private copy_bytes(b: []const u8) -> Buf[u8]
    var out: Buf[u8] = buf()

    for i in 0..<b.len
        out.push(b[i])

    out
end copy_bytes

private hold_part(p: Part) -> Piece = p match
    Headers(h) -> HeldHead(hold_head(h))
    Chunk(b) -> HeldChunk(copy_bytes(b))
    End -> HeldEnd

// Where a parser puts what it has finished, until slate asks for it. A parser fills one of the two
// and never both.
private struct Arrived
    done: Buf[Held]
    parts: Buf[Piece]
end Arrived

// One parser, and what it has ready. **`reader` accumulates and `flow` streams**, and a slot holds
// exactly one of them -- which of the two it is was decided when the connection opened and cannot
// change, a parser having no way to start holding a body it has already handed out.
private struct Slot
    reader: Option[&Requests]
    flow: Option[&Stream]
    arrived: &Arrived
end Slot

private var slots: Buf[Slot] = buf()

// Forget every parser. Called when a new program is run, exactly as the socket table is.
forget_parsers()
    slots.clear()

// A new parser, answering the id slate holds it by.
//
// **The id is an index and is never reused**, so a program holding a stale one gets nothing rather
// than somebody else's connection. A parser is not counted in `outstanding`: it is a piece of
// bookkeeping about bytes that have already arrived, so it can never be the reason a program is
// still running.
new_parser(head: usize, body: usize) -> usize
    val arrived: &Arrived = Arrived(buf(), buf())
    val reader = requests((r) -> arrived.done.push(hold_request(r)), Limits(head, body))

    slots.push(Slot(Some(reader), None, arrived))
    slots.len() - 1
end new_parser

// A new parser that will not hold a body, answering the id slate holds it by.
//
// **There is no body limit and that is the point.** The head is bounded because a head has to be held
// to be useful; a body nobody holds needs no limit to be safe, so the ceiling that makes the
// accumulating parser safe -- and that refuses the upload along with the attack -- simply is not
// there.
new_stream(head: usize) -> usize
    val arrived: &Arrived = Arrived(buf(), buf())
    val flow = stream((p) -> arrived.parts.push(hold_part(p)), head)

    slots.push(Slot(None, Some(flow), arrived))
    slots.len() - 1
end new_stream

// Give a parser bytes. Answers nothing where they were taken, and why where they were not.
//
// **A refusal names the status it deserves**, which is the one piece of judgement this file makes:
// 400 for bytes that were not HTTP, 431 and 413 for HTTP this server has decided not to hold. A
// server that answered 400 to all three would be telling a client its upload was malformed.
feed_parser(id: usize, bytes: []const u8) -> Result[unit, (long, string)]
    if id >= slots.len() then return Ok(())

    val slot = slots.at(id)

    val outcome = slot.reader match
        Some(r) -> r.feed(bytes)
        None -> slot.flow match
            Some(f) -> f.feed(bytes)
            None -> return Ok(())

    outcome match
        Ok(_) -> Ok(())
        Err(why) -> why match
            Malformed(f) -> Err((400, f.reason))
            HeadTooLarge(n) -> Err((431, s"the headers are larger than ${n} bytes"))
            BodyTooLarge(n) -> Err((413, "the body is larger than " + str(n) + " bytes"))
end feed_parser

// How many whole requests are waiting.
parser_ready(id: usize) -> usize
    if id >= slots.len() then return 0

    slots.at(id).arrived.done.len()
end parser_ready

// The oldest whole request, as the object a handler is given.
//
// **Built here rather than as it arrived**, so that no slate value is ever parked where the collector
// cannot see it. The shape is the one `slate:http` has always handed a handler, plus the keep-alive
// answer -- which llhttp has already worked out from the version and the `Connection` header, and
// which the slate module used to compute for itself.
take_request(id: usize) -> Option[Value]
    if id >= slots.len() then return None

    val ready = slots.at(id).arrived

    if ready.done.len() == 0 then return None

    val r = ready.done.at(0)

    ready.done.remove(0)

    val o = request_object(r, true)

    Some(Object(o))
end take_request

// The head of a request as the object a handler is given -- shared by both parsers, since a streamed
// request and a whole one differ in one field and not in what a program calls them.
private request_object(r: Held, with_body: bool) -> *ObjectObj
    val headers = new_object()

    hold(Object(headers))

    for i in 0..<r.names.len()
        obj_put_name(headers, to_lower(r.names.at(i)), Str(new_str(r.values.at(i))))

    val target = r.target
    val len = target.bytes.len
    val cut = target.index_of("?") match
        Some(i) -> i
        None -> len

    val o = new_object()

    hold(Object(o))

    obj_put_name(o, "method", Str(new_str(r.method)))
    obj_put_name(o, "path", Str(new_str(if cut == len then target else target[0..<cut])))
    obj_put_name(o, "query", Str(new_str(if cut == len then "" else target[(cut + 1)..<len])))
    obj_put_name(o, "headers", Object(headers))

    if with_body then obj_put_name(o, "body", Str(new_str(from_utf8(r.body.view()).unwrap_or(""))))

    obj_put_name(o, "keepAlive", Bool(r.keep_alive))
    o
end request_object

// The oldest piece a streaming parser has ready, as the object `slate:http` pumps.
//
// **Three shapes rather than three natives**, because what a caller does with them is one loop: pull
// until there is nothing, and act on the `kind`. A head carries everything a whole request carries
// but its body; a body chunk carries the bytes, as an array, which is what `slate:net` hands over and
// what `httpFeed` takes back.
take_part(id: usize) -> Option[Value]
    if id >= slots.len() then return None

    val ready = slots.at(id).arrived

    if ready.parts.len() == 0 then return None

    val piece = ready.parts.at(0)

    ready.parts.remove(0)

    piece match
        HeldHead(h) ->
            val o = request_object(h, false)

            obj_put_name(o, "kind", Str(new_str("head")))
            Some(Object(o))

        HeldChunk(bytes) ->
            var items: Buf[Value] = buf()

            for i in 0..<bytes.len()
                items.push(Int(long(bytes.at(i))))

            val chunk = new_array(items)

            hold(Array(chunk))

            val o = new_object()

            hold(Object(o))

            obj_put_name(o, "kind", Str(new_str("body")))
            obj_put_name(o, "chunk", Array(chunk))
            Some(Object(o))

        HeldEnd ->
            val o = new_object()

            hold(Object(o))

            obj_put_name(o, "kind", Str(new_str("end")))
            Some(Object(o))
end take_part

// Tell a parser the connection closed, so a request ending at end-of-file completes.
finish_parser(id: usize)
    if id >= slots.len() then return

    val slot = slots.at(id)

    slot.reader match
        Some(r) ->
            r.finish() match
                Ok(_) -> ()
                Err(_) -> ()
        None -> slot.flow match
            Some(f) ->
                f.finish() match
                    Ok(_) -> ()
                    Err(_) -> ()
            None -> ()
end finish_parser

// Give a parser back. A connection that has closed will never be fed again.
close_parser(id: usize)
    if id >= slots.len() then return

    var slot = slots.at(id)

    slot.reader = None
    slot.flow = None
    slots.set(id, slot)
    slot.arrived.done.clear()
    slot.arrived.parts.clear()
end close_parser

// -- what `slate:http` calls -----------------------------------------------------------------------

// The id of a parser, checked.
private parser_of(v: Value, at: Span, name: string) -> Result[usize, Signal]
    v match
        Int(n) -> Ok(usize(n))
        other -> Err(failure(at, s"`${name}` takes a parser, and this is ${other.type_name()}"))

// A limit, which a program writes as a number of bytes.
private limit_of(v: Value, at: Span, name: string) -> Result[usize, Signal]
    v match
        Int(n) -> Ok(usize(n))
        other -> Err(failure(at, s"`${name}` takes its limits as numbers of bytes, and one of them is ${other.type_name()}"))

// `httpParser(headLimit, bodyLimit)`.
do_http_parser(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`httpParser` takes a head limit and a body limit, and was given ${counted(args.len(), "argument")}")

    val head = limit_of(args.at(0), at, "httpParser")?
    val body = limit_of(args.at(1), at, "httpParser")?

    Ok(Int(long(new_parser(head, body))))
end do_http_parser

// `httpFeed(p, bytes)` -- nothing where the bytes were taken, and `{ status, message }` where they
// were refused.
//
// **A refusal is an ANSWER rather than a fault**, because it is the ordinary thing a server does
// about a bad client: the connection writes the status back and closes. A fault would take the
// server down with the request.
do_http_feed(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`httpFeed` takes a parser and some bytes, and was given ${counted(args.len(), "argument")}")

    val id = parser_of(args.at(0), at, "httpFeed")?

    val payload = args.at(1) match
        Array(p) -> bytes_of(p, at, "httpFeed")?
        other -> return fault(at, s"`httpFeed` takes the bytes as an array, and this is ${other.type_name()}")

    feed_parser(id, payload.view()) match
        Ok(_) -> Ok(Null)
        Err(why) ->
            val o = new_object()

            hold(Object(o))
            obj_put_name(o, "status", Int(why.0))
            obj_put_name(o, "message", Str(new_str(why.1)))
            Ok(Object(o))
end do_http_feed

// `httpTake(p)` -- the oldest whole request, or null where none is ready.
do_http_take(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`httpTake` takes a parser, and was given ${counted(args.len(), "argument")}")

    take_request(parser_of(args.at(0), at, "httpTake")?) match
        Some(v) -> Ok(v)
        None -> Ok(Null)
end do_http_take

// `httpStream(headLimit)` -- a parser that hands the head over and then the body as it arrives.
do_http_stream(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`httpStream` takes a head limit, and was given ${counted(args.len(), "argument")}")

    Ok(Int(long(new_stream(limit_of(args.at(0), at, "httpStream")?))))
end do_http_stream

// `httpTakePart(p)` -- the oldest piece a streaming parser has ready, or null where none is.
do_http_take_part(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`httpTakePart` takes a parser, and was given ${counted(args.len(), "argument")}")

    take_part(parser_of(args.at(0), at, "httpTakePart")?) match
        Some(v) -> Ok(v)
        None -> Ok(Null)
end do_http_take_part

// `httpFinish(p)` -- the peer has stopped sending, so a request ending at end-of-file completes.
do_http_finish(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`httpFinish` takes a parser, and was given ${counted(args.len(), "argument")}")

    finish_parser(parser_of(args.at(0), at, "httpFinish")?)
    Ok(Null)
end do_http_finish

// `httpClose(p)` -- the connection has gone and the parser with it.
do_http_close(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`httpClose` takes a parser, and was given ${counted(args.len(), "argument")}")

    close_parser(parser_of(args.at(0), at, "httpClose")?)
    Ok(Null)
end do_http_close
