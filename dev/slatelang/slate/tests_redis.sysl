module dev.slatelang.slate
@tests

import sysl.text.Search

// `slate:redis` -- a Redis client on the loop, over hiredis's reader.
//
// **EVERY TEST HERE TALKS TO A REDIS SERVER WRITTEN IN SLATE**, a few lines of `listen` answering
// canned RESP. That is not a shortcut around a real server: the wire forms are written out longhand
// from the protocol, so they prove this client agrees with RESP rather than with whatever happened
// to be installed -- and the suite needs no daemon, no port and no fixture data.
//
// **They go through `slate:redis` rather than through the natives under it**, which are inside
// `if everything` and are not a program's to call. What is being tested is what a program sees.

@test
EVERY_RESP2_SHAPE_COMES_BACK_AS_THE_SLATE_VALUE_IT_IS()
    // **The five things RESP2 can say**, and each of them lands on the slate value a program would
    // have written: a status and a bulk string are text, an integer is an integer, a nil is `null`
    // -- distinct from an empty string, which is what makes `GET` answerable -- and an array is an
    // array.
    val body = "fake(replies)\n    var n = 0\n\n    serving(conn)\n        heard(chunk)\n            if chunk == null then return\n\n            if n < len(replies)\n                send(conn, replies[n])\n\n                n = n + 1\n\n        onData(conn, heard)\n\n    listen(0, serving)\n\nval server = fake([\"+OK\\r\\n\", \":42\\r\\n\", \"$5\\r\\nhello\\r\\n\", \"$-1\\r\\n\", \"*3\\r\\n$1\\r\\na\\r\\n:2\\r\\n$-1\\r\\n\"])\n\nasync main()\n    val r = (await redis(\"127.0.0.1\", localPort(server))).value\n\n    print((await r.command(\"PING\")).value)\n    print((await r.command(\"INCR\", \"n\")).value)\n    print((await r.command(\"GET\", \"k\")).value)\n    print((await r.command(\"GET\", \"gone\")).value)\n    print((await r.command(\"LRANGE\", \"l\", \"0\", \"2\")).value)\n\n    r.close()\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(redis_wire_out(body),
        "OK\n42\nhello\nnull\n[\"a\", 2, null]")

@test
A_REPLY_SPLIT_ACROSS_TWO_PACKETS_IS_ONE_REPLY()
    // **A short read is the ordinary case and not a failure**: a reply larger than the path's MTU
    // arrives in pieces, and a client that treated the first piece as an answer would break on every
    // value worth storing. Here the server sends four bytes, waits, and sends the rest.
    val body = "halves(conn)\n    heard(chunk)\n        if chunk == null then return\n\n        send(conn, \"$11\\r\\nhel\")\n        later()\n            send(conn, \"lo world\\r\\n\")\n\n        setTimeout(later, 40)\n\n    onData(conn, heard)\n\nval server = listen(0, halves)\n\nasync main()\n    val r = (await redis(\"127.0.0.1\", localPort(server))).value\n\n    print((await r.command(\"GET\", \"k\")).value)\n\n    r.close()\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(redis_wire_out(body),
        "hello world")

@test
AN_ERROR_REPLY_IS_A_RESULT_AND_A_CLOSED_CLIENT_IS_A_FAULT()
    // **The two channels, on one connection.** `-ERR` is the server refusing, which is an ordinary
    // thing for a program to handle; calling `command` on a client it has already closed is the
    // program's own mistake and throws.
    val body = "fake(replies)\n    var n = 0\n\n    serving(conn)\n        heard(chunk)\n            if chunk == null then return\n\n            if n < len(replies)\n                send(conn, replies[n])\n\n                n = n + 1\n\n        onData(conn, heard)\n\n    listen(0, serving)\n\nval server = fake([\"-ERR unknown command 'NOPE'\\r\\n\"])\n\nasync main()\n    val r = (await redis(\"127.0.0.1\", localPort(server))).value\n    val said = await r.command(\"NOPE\")\n\n    print(said.ok, said.error)\n\n    r.close()\n\n    try\n        await r.command(\"PING\")\n    catch e\n        print(\"threw\")\n\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(redis_wire_out(body),
        "false ERR unknown command 'NOPE'\nthrew")

@test
THE_RESP3_SHAPES_ARE_ALL_HERE_AND_A_MAP_IS_AN_OBJECT()
    // **RESP3 came with the tier and needed nothing extra**, which is worth saying because a
    // binding that did RESP2 only would look identical from the outside until somebody sent
    // `HELLO 3`. A map's children alternate key and value, so it is an object; a set is an array,
    // slate having no set; a big number is text, having no other home in 64 bits.
    val body = "fake(replies)\n    var n = 0\n\n    serving(conn)\n        heard(chunk)\n            if chunk == null then return\n\n            if n < len(replies)\n                send(conn, replies[n])\n\n                n = n + 1\n\n        onData(conn, heard)\n\n    listen(0, serving)\n\nval server = fake([\",3.25\\r\\n\", \"#t\\r\\n\", \"%2\\r\\n$1\\r\\na\\r\\n:1\\r\\n$1\\r\\nb\\r\\n:2\\r\\n\", \"~2\\r\\n$1\\r\\nx\\r\\n$1\\r\\ny\\r\\n\", \"(3492890328409238509324850943850943825024\\r\\n\", \"=15\\r\\ntxt:hello world\\r\\n\"])\n\nasync main()\n    val r = (await redis(\"127.0.0.1\", localPort(server))).value\n\n    print((await r.command(\"ZSCORE\", \"z\", \"m\")).value)\n    print((await r.command(\"SISMEMBER\", \"s\", \"m\")).value)\n    print(toJSON((await r.command(\"HGETALL\", \"h\")).value))\n    print(toJSON((await r.command(\"SMEMBERS\", \"s\")).value))\n    print((await r.command(\"BIG\")).value)\n    print((await r.command(\"LOLWUT\")).value)\n\n    r.close()\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(redis_wire_out(body),
        "3.25\ntrue\n{\"a\":1,\"b\":2}\n[\"x\",\"y\"]\n3492890328409238509324850943850943825024\ntxt:hello world")

@test
A_BULK_STRING_THAT_IS_NOT_TEXT_COMES_BACK_AS_BYTES()
    // **Lossless and with no mode flag to set.** A bulk string may hold any bytes at all -- an
    // image, a serialised object, a compressed body -- so `GET` on a JSON document answers a string
    // and `GET` on a JPEG answers an array, and `v is string` says which. Substituting `""` for what
    // will not decode would lose a value the program itself stored.
    val body = "binary(conn)\n    heard(chunk)\n        if chunk == null then return\n\n        send(conn, concat(concat(toBytes(\"$3\\r\\n\"), [255, 254, 0]), toBytes(\"\\r\\n\")))\n\n    onData(conn, heard)\n\nval server = listen(0, binary)\n\nasync main()\n    val r = (await redis(\"127.0.0.1\", localPort(server))).value\n\n    val raw = (await r.command(\"GET\", \"jpeg\")).value\n\n    print(raw is array, toJSON(raw))\n\n    r.close()\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(redis_wire_out(body),
        "true [255,254,0]")

@test
COMMANDS_ISSUED_WITHOUT_AWAITING_ARE_ANSWERED_IN_THE_ORDER_THEY_WENT_OUT()
    // **Pipelining is what happens when you do not await**, and it is the protocol's own guarantee
    // rather than anything this client arranges: RESP has no request ids because answers come back
    // in the order the commands were written. Three round trips become one.
    //
    // **The fake server waits for the third command before answering any of them**, and that is not
    // decoration: three `send`s in one turn reach the loopback as one, two or three reads however
    // they are written, so a server that answered every chunk would answer three times over. The
    // extra replies are dropped by the client -- a reply with nothing waiting has nowhere to go --
    // and the connection is then closed under data the other end has not read, which is an RST, and
    // a socket read error stops the whole program. It failed exactly once that way before the guard
    // went in.
    val body = "batched(conn)\n    var seen = \"\"\n\n    heard(chunk)\n        if chunk == null then return\n\n        seen = seen + chunk\n\n        if !seen.endsWith(\"$1\\r\\nc\\r\\n\") then return\n\n        send(conn, \"$3\\r\\none\\r\\n$3\\r\\ntwo\\r\\n$5\\r\\nthree\\r\\n\")\n\n    onData(conn, heard)\n\nval server = listen(0, batched)\n\nasync main()\n    val r = (await redis(\"127.0.0.1\", localPort(server))).value\n\n    val a = r.command(\"GET\", \"a\")\n    val b = r.command(\"GET\", \"b\")\n    val c = r.command(\"GET\", \"c\")\n\n    print((await a).value, (await b).value, (await c).value)\n\n    r.close()\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(redis_wire_out(body),
        "one two three")

@test
A_SERVER_THAT_GOES_AWAY_ANSWERS_EVERY_COMMAND_STILL_WAITING()
    // **Every waiting promise is SETTLED rather than left**, and with a result rather than a
    // failure: a connection that has gone is an outside condition like any other, and a program
    // awaiting a command it will never get an answer to would otherwise wait for the rest of the
    // run -- which in a server is a request that never finishes.
    val body = "rude(conn)\n    heard(chunk)\n        if chunk == null then return\n\n        close(conn)\n\n    onData(conn, heard)\n\nval server = listen(0, rude)\n\nasync main()\n    val r = (await redis(\"127.0.0.1\", localPort(server))).value\n    val said = await r.command(\"GET\", \"k\")\n\n    print(said.ok, said.error)\n\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(redis_wire_out(body),
        "false the redis connection was closed by the server")

@test
A_PUSH_GOES_TO_onPush_AND_IS_NEVER_MATCHED_AGAINST_A_WAITING_COMMAND()
    // **A push arrives BETWEEN replies to your own commands** -- a pub/sub message, or an
    // invalidation for client-side caching -- so a client that assumed every reply was its own would
    // hand a subscriber's message back as the answer to a `GET`. That is the bug this test exists
    // for, and it is silent: both are perfectly good replies.
    val body = "pushy(conn)\n    heard(chunk)\n        if chunk == null then return\n\n        send(conn, \">3\\r\\n$7\\r\\nmessage\\r\\n$4\\r\\nnews\\r\\n$5\\r\\nhello\\r\\n$3\\r\\nred\\r\\n\")\n\n    onData(conn, heard)\n\nval server = listen(0, pushy)\n\nasync main()\n    val r = (await redis(\"127.0.0.1\", localPort(server))).value\n\n    seen(p)\n        print(\"push\", toJSON(p))\n\n    r.onPush(seen)\n\n    print((await r.command(\"GET\", \"colour\")).value)\n\n    r.close()\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(redis_wire_out(body),
        "push [\"message\",\"news\",\"hello\"]\nred")

@test
RUBBISH_ON_THE_WIRE_ENDS_THE_CONNECTION_RATHER_THAN_BEING_STEPPED_OVER()
    // **A protocol failure is not recoverable and pretending otherwise is worse than failing.** The
    // two ends disagree about where a reply begins, so nothing after it can be trusted to belong to
    // the command it would be matched with -- a client that resynchronised would answer one command
    // with another's reply and never say so.
    val body = "broken(conn)\n    heard(chunk)\n        if chunk == null then return\n\n        send(conn, \"this is not RESP at all\\r\\n\")\n\n    onData(conn, heard)\n\nval server = listen(0, broken)\n\nasync main()\n    val r = (await redis(\"127.0.0.1\", localPort(server))).value\n    val said = await r.command(\"GET\", \"k\")\n\n    print(said.ok, startsWith(said.error, \"this is not a redis stream\"))\n\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(redis_wire_out(body),
        "false true")

@test
EVERY_ARGUMENT_CROSSES_AS_A_COUNTED_STRING()
    // **A value holding CRLF, a quote or what looks like a whole second command is still ONE
    // argument**, because a RESP array says how long each of its pieces is. There is nothing to
    // escape and no format string to get wrong, which is the injection this protocol would otherwise
    // be wide open to -- and the value here is exactly the shape somebody would try.
    val body = "watcher(conn)\n    heard(chunk)\n        if chunk == null then return\n\n        print(join(split(fromBytes(chunk).value, \"\\r\\n\"), \"|\"))\n        send(conn, \"+OK\\r\\n\")\n\n    onBytes(conn, heard)\n\nval server = listen(0, watcher)\n\nasync main()\n    val r = (await redis(\"127.0.0.1\", localPort(server))).value\n\n    await r.command(\"SET\", \"k\", \"a\\r\\nGET evil\\r\\n\")\n\n    r.close()\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(redis_wire_out(body),
        "*3|$3|SET|$1|k|$13|a|GET evil||")

@test
A_COMMAND_WORKED_OUT_WHILE_RUNNING_IS_SPREAD()
    // **`command` gathers its words, so a command a program ASSEMBLED is spread back out** --
    // `r.command(...parts)`. That is the case the old list-taking form served directly, and it is
    // the one that had to keep working when the list became a rest parameter: a client building a
    // `RPUSH` from a variable number of values has nothing else to write.
    val body = "watcher(conn)\n    heard(chunk)\n        if chunk == null then return\n\n        print(join(split(fromBytes(chunk).value, \"\\r\\n\"), \"|\"))\n        send(conn, \"+OK\\r\\n\")\n\n    onBytes(conn, heard)\n\nval server = listen(0, watcher)\n\nasync main()\n    val r = (await redis(\"127.0.0.1\", localPort(server))).value\n\n    val parts = concat([\"RPUSH\", \"l\"], [\"a\", \"b\"])\n\n    await r.command(...parts)\n\n    r.close()\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(redis_wire_out(body),
        "*4|$5|RPUSH|$1|l|$1|a|$1|b|")

@test
THE_MODULE_EXPORTS_THE_SHAPES_A_PROGRAM_ANNOTATES_WITH()
    // **`Reply` and `Client` are `export type`s carried out of a module written in slate**, which is
    // the only way a program can say what it is holding: a result and a connection are both objects,
    // and an annotation naming neither checks nothing. `Reply` matching a failure as well as a
    // success is what the optional keys are for -- only the field that applies is ever there.
    val body = "import { redis, Reply, Client } from slate:redis\n\nfake(conn)\n    heard(chunk)\n        if chunk == null then return\n\n        send(conn, \"+OK\\r\\n\")\n\n    onData(conn, heard)\n\nval server = listen(0, fake)\n\nsaid(r: Reply) = if r.ok then r.value else r.error\n\nnamed(c: Client) = \"a client\"\n\nasync main()\n    val r = (await redis(\"127.0.0.1\", localPort(server))).value\n\n    print(named(r))\n    print(said(await r.command(\"PING\")))\n    print(said({ ok: false, error: \"gone\" }))\n\n    r.close()\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(net_out(body),
        "a client\nOK\ngone")
