module dev.slatelang.slate
@tests

import sh.sysl.libuv
import sh.sysl.parsing.*
import sysl.fs.{entries, is_dir}
import sysl.text.{Search, replace_all}

// The file system in both its forms, TCP, and the examples.
//
// **A socket keeps the program alive**, so every net test carries `netted`'s watchdog: a test that
// forgets a `close` would otherwise hang the whole suite forever with nothing printed.

// -- the file system ----------------------------------------------------------------------------

@test
a_file_written_is_a_file_read_back()
    assert_eq(in_scratch("async main()\n    await writeFile(\"<dir>/a.txt\", \"hello slate\")\n    print((await readFile(\"<dir>/a.txt\")).value)\nmain()"), "hello slate")

    // A second write replaces what was there rather than appending to it.
    assert_eq(in_scratch("async main()\n    await writeFile(\"<dir>/a.txt\", \"long enough to notice\")\n    await writeFile(\"<dir>/a.txt\", \"short\")\n    print((await readFile(\"<dir>/a.txt\")).value)\nmain()"), "short")

    // Anything that is not a string is written as `print` would render it.
    assert_eq(in_scratch("async main()\n    await writeFile(\"<dir>/a.txt\", [1, 2, 3])\n    print((await readFile(\"<dir>/a.txt\")).value)\nmain()"), "[1, 2, 3]")

@test
the_answer_to_the_last_request_outstanding_is_still_handed_back()
    // **The bug this pins made the whole file system look like it did nothing.** A timer is a handle
    // and libuv counts it; an `fs` call is a *request*, and the turn of the loop that answers the
    // last one outstanding reports nothing active afterwards. The drain used to take that as its
    // signal to stop -- so the callback ran, the promise settled, and the coroutine awaiting it was
    // never handed the value, because handing it back is what the *next* turn does. A program that
    // awaited one file and printed the answer printed nothing at all and exited 0.
    assert_eq(in_scratch("async main()\n    await writeFile(\"<dir>/a.txt\", \"only\")\n    print((await readFile(\"<dir>/a.txt\")).value)\nmain()"), "only")

    // The same for a call that makes no request of its own to follow it.
    assert_eq(in_scratch("async main()\n    print(await exists(\"<dir>\"))\nmain()"), "true")

@test
every_file_system_call_answers_a_promise()
    // **There is no blocking form**, which is the one place slate is stricter than node: a call not
    // awaited answers a promise like any other, rather than a value.
    assert_eq(in_scratch("print(exists(\"<dir>\"))"), "<promise pending>")
    assert_eq(in_scratch("print(readDir(\"<dir>\"))"), "<promise pending>")

@test
read_bytes_reads_what_read_file_will_not()
    assert_eq(in_scratch("async main()\n    await writeFile(\"<dir>/a.txt\", \"AB\")\n    print((await readBytes(\"<dir>/a.txt\")).value)\nmain()"), "[65, 66]")

    // An empty file is an empty array rather than a failure.
    assert_eq(in_scratch("async main()\n    await writeFile(\"<dir>/a.txt\", \"\")\n    print((await readBytes(\"<dir>/a.txt\")).value, (await readFile(\"<dir>/a.txt\")).value)\nmain()"), "[] ")

@test
a_file_that_is_not_text_is_refused_by_name()
    // `/bin/ls` is not text on any machine this runs on, and reading it is the shortest way to say
    // so without writing bytes slate has no way to write.
    val said = fs_out("async main()\n    print((await readFile(\"/bin/ls\")).error)\nmain()")

    assert(said.contains("is not text"))
    assert(said.contains("`readBytes`"))

@test
a_directory_is_made_listed_and_taken_away()
    val prog = "async main()\n    await mkdir(\"<dir>/sub\")\n    await writeFile(\"<dir>/sub/one\", \"1\")\n    print((await readDir(\"<dir>/sub\")).value)\n    await remove(\"<dir>/sub/one\")\n    print((await readDir(\"<dir>/sub\")).value)\n    await rmdir(\"<dir>/sub\")\n    print(await exists(\"<dir>/sub\"))\nmain()"

    assert_eq(in_scratch(prog), "[\"one\"]\n[]\nfalse")

@test
stat_says_how_big_a_file_is_and_what_kind_it_is()
    val prog = "async main()\n    await writeFile(\"<dir>/a.txt\", \"12345\")\n    val f = (await stat(\"<dir>/a.txt\")).value\n    val d = (await stat(\"<dir>\")).value\n    print(f.size, f.isFile, f.isDir)\n    print(d.isFile, d.isDir)\nmain()"

    assert_eq(in_scratch(prog), "5 true false\nfalse true")

@test
exists_answers_rather_than_failing()
    // **The whole of what this adds over `stat`.** Asking whether something is there and being made
    // to survive a failure to find out would be a question the language answered with an error.
    assert_eq(in_scratch("async main()\n    print(await exists(\"<dir>\"), await exists(\"<dir>/nope\"))\nmain()"), "true false")

@test
rename_moves_a_file_and_leaves_nothing_behind()
    val prog = "async main()\n    await writeFile(\"<dir>/a.txt\", \"kept\")\n    await rename(\"<dir>/a.txt\", \"<dir>/b.txt\")\n    print((await readDir(\"<dir>\")).value, (await readFile(\"<dir>/b.txt\")).value)\nmain()"

    assert_eq(in_scratch(prog), "[\"b.txt\"] kept")

@test
a_file_system_failure_is_ANSWERED_and_does_not_stop_the_program()
    // **The promise settles rather than rejecting**, so a program that does not look at the answer
    // carries on -- which is the point of the result and the thing that changed. Every one of these
    // still carries libuv's own sentence, because a program that cannot open a file wants to know
    // whether the path was wrong or the permissions were.
    assert(said_error("readFile(\"/no/such/file\")").contains("ENOENT"))
    assert(said_error("readDir(\"/no/such/dir\")").contains("cannot list /no/such/dir"))
    assert(said_error("mkdir(\"/no/such/dir\")").contains("cannot make /no/such/dir"))
    assert(said_error("stat(\"/no/such/file\")").contains("cannot stat /no/such/file"))
    assert(said_error("writeFile(\"/no/such/dir/x\", \"hi\")").contains("cannot write /no/such/dir/x"))
    assert(said_error("remove(\"/no/such/file\")").contains("cannot remove /no/such/file"))
    assert(said_error("rename(\"/no/such/file\", \"/tmp/x\")").contains("cannot rename /no/such/file"))

    // A directory that is not empty is the failure `rmdir` is for.
    val busy = in_scratch("async main()\n    await writeFile(\"<dir>/a.txt\", \"x\")\n    print((await rmdir(\"<dir>\")).error)\nmain()")

    assert(busy.contains("cannot remove"))

@test
a_program_that_ignores_a_failed_result_keeps_running()
    // **This is what the change bought.** The same program under the old surface stopped at the
    // first missing file with a diagnostic; nothing was awaiting the promise it rejected, so the
    // fault became the program's.
    val prog = "async main()\n    await readFile(\"/no/such/file\")\n    await mkdir(\"/no/such/dir\")\n    print(\"still here\")\nmain()"

    assert_eq(fs_out(prog), "still here")

@test
a_result_is_taken_apart_by_an_ordinary_pattern()
    // **No syntax was added for this**, which is the argument for a result being an object: `match`
    // already destructures one by shape.
    val prog = "async main()\n    await readFile(\"/no/such/file\") match\n        { ok: true, value: v } -> print(v)\n        { error: e } -> print(\"no: \" + e)\nmain()"

    assert(fs_out(prog).contains("no: cannot read /no/such/file"))

@test
a_file_system_builtin_says_what_it_wanted_when_given_something_else()
    assert(fs_fails("async main()\n    await readFile(42)\nmain()").contains("`readFile` takes a path, and this is an integer"))
    assert(fs_fails("async main()\n    await mkdir(null)\nmain()").contains("`mkdir` takes a path"))
    assert(fs_fails("async main()\n    await readFile()\nmain()").contains("`readFile` takes one path and was given 0 arguments"))
    assert(fs_fails("async main()\n    await writeFile(\"a\")\nmain()").contains("`writeFile` takes a path and its contents"))
    assert(fs_fails("async main()\n    await rename(\"a\")\nmain()").contains("`rename` takes two paths"))

@test
requests_in_flight_together_all_answer()
    // Eight writes started before any of them is awaited, which is what the promises are for -- and
    // what a drain that stopped at the first quiet turn would have lost all but one of.
    val prog = "async main()\n    var ps = []\n    for i in 0..<8\n        push(ps, writeFile(\"<dir>/f\" + string(i), string(i)))\n    for p in ps\n        await p\n    val names = (await readDir(\"<dir>\")).value\n    var total = 0\n    for n in names\n        total = total + len((await readFile(\"<dir>/\" + n)).value)\n    print(len(names), total)\nmain()"

    assert_eq(in_scratch(prog), "8 8")

@test
the_collector_runs_while_a_request_is_outstanding()
    // **A pending request roots its promise through the table `event.sysl` keeps**, and nothing else
    // knows about it: the closure libuv holds captures a slot id rather than a value, precisely so
    // that a collection between the call and its answer cannot free what the answer is for.
    val prog = "async main()\n    val p = readFile(\"<dir>/a.txt\")\n    for i in 0..<2000\n        val junk = { a: i, b: [i, i, i], c: \"x\" + string(i) }\n    print((await p).value)\nmain()"
    val dir = libuv.mkdtemp_sync("/tmp/slate-fs-XXXXXX").unwrap()

    libuv.write_file_sync(s"${dir}/a.txt", "survived".bytes).unwrap()

    val said = fs_out(replace_all(prog, "<dir>", dir))

    scrub(dir)
    assert_eq(said, "survived")

@test
timers_and_the_file_system_share_one_loop()
    // A handle and a request in the same drain, which is the case the two halves of `drain_events`
    // have to agree about.
    //
    // **This one passed while the file system did not work**, and that is worth knowing: a live
    // timer is an active handle, so the loop kept saying it had work and the request's answer was
    // never the thing that ended the drain. A file system test that has a timer in it cannot see
    // the bug above, which is why the tests that pin it have no timer.
    // **The order the two arrive in is not asserted, because it is not guaranteed.** A timer set
    // for a millisecond and a write that goes through a thread pool race, and which wins says
    // something about how busy the machine is rather than about slate. What *is* guaranteed is that
    // both arrive and neither is dropped, which is the claim worth pinning.
    val prog = "async main()\n    setTimeout(() -> print(\"timer\"), 1)\n    await writeFile(\"<dir>/a.txt\", \"file\")\n    print(await readFile(\"<dir>/a.txt\"))\n    await sleep(3)\nmain()"
    val said = in_scratch(prog)

    assert(said.contains("file"))
    assert(said.contains("timer"))

// -- the examples -------------------------------------------------------------------------------

@test
every_example_runs_with_nothing_to_report()
    // **The list is WALKED and not written out, and that is the point of the name.** It used to name
    // each example by hand, and three -- `times.sl`, `generators.sl` and `http.sl` -- had been added
    // without being added here, so a test called *every example* was running twelve of eighteen and
    // saying nothing about the rest. The move of the temporal names out of the globals is what found
    // it: `times.sl` stopped compiling and this test stayed green.
    //
    // **Only the top level.** `examples/lib/` holds the two files `modules.sl` imports, which are
    // modules rather than examples: they are not run on their own and nothing here should look for
    // them beside the others.
    //
    // Three of them do more than print, and each is written to be safe to run twice:
    // **`files.sl`** makes a `scratch/` directory beside the project and removes it, in that order;
    // **`echo.sl`** and **`http.sl`** are each a server and a client in one program and close both
    // ends, which is what stops them hanging the suite rather than failing it.
    val names = entries("examples").unwrap()
    var ran: usize = 0

    for i in 0..<names.len()
        val name = names.at(i)
        val path = s"examples/${name}"

        if is_dir(path) then continue

        // **`.slx` is walked with `.sl`.** The extension says what a file holds and nothing more --
        // elements are read in every file -- but an example named for what it teaches is no use if
        // the walk that runs the examples cannot see it.
        if !name.ends_with(".sl") && !name.ends_with(".slx") then continue

        assert_eq(ran_clean(path), "")
        ran += 1

    // **Finding nothing to run would leave this green having tested nothing**, which is the failure
    // a walk can have and a written list cannot.
    assert(ran >= 18)

// -- TCP ------------------------------------------------------------------------------------------

@test
a_client_and_a_server_talk_to_each_other()
    val body = Echo + "async main()\n    val c = (await connect(\"127.0.0.1\", port)).value\n    reply(chunk)\n        print(chunk)\n        close(c)\n        close(server)\n        done()\n    onData(c, reply)\n    await send(c, \"hello\")\nmain()"

    assert_eq(net_out(body), "echo: hello")

@test
AN_ADDRESS_WRITTEN_OUT_AND_ONE_THE_RESOLVER_HAS_TO_READ_BOTH_REACH_THE_LISTENER()
    // **`connect` takes two paths and this is the only thing in the suite that can tell them
    // apart.** `127.0.0.1` is text `inet_pton` reads, so it is dialled without asking the system
    // resolver anything -- which keeps a call of unbounded latency off the front of a connection
    // whose destination was never in doubt. **`127.1` is an address the RESOLVER reads and
    // `inet_pton` does not**, so it still goes the long way, and a short cut that grew greedy would
    // break this half while every other net test went on passing.
    //
    // The two answers are stored rather than printed as they arrive: which of two connections
    // replies first is the kernel's business, and a test that pinned it would be a test of that.
    val body = Echo + "async main()\n" +
        "    val a = (await connect(\"127.0.0.1\", port)).value\n" +
        "    val b = (await connect(\"127.1\", port)).value\n" +
        "    var written = \"\"\n" + "    var looked = \"\"\n" +
        "    both()\n" +
        "        if written != \"\" && looked != \"\"\n" +
        "            print(written, looked)\n" + "            close(a)\n" + "            close(b)\n" +
        "            close(server)\n" + "            done()\n" +
        "    heardA(chunk)\n" + "        if chunk != null\n" + "            written = chunk\n" +
        "            both()\n" +
        "    heardB(chunk)\n" + "        if chunk != null\n" + "            looked = chunk\n" +
        "            both()\n" +
        "    onData(a, heardA)\n" + "    onData(b, heardB)\n" +
        "    await send(a, \"written\")\n" + "    await send(b, \"looked\")\n" + "main()"

    assert_eq(net_out(body), "echo: written echo: looked")

@test
A_TIMER_IS_THE_TIME_IT_WAS_GIVEN_WITH_A_SERVER_AND_A_SOCKET_ON_THE_LOOP()
    // **A defect was recorded against this and could not be reproduced**, and the test is here so a
    // recurrence is caught with the two legs SEPARATED. What was measured the first time was the
    // whole program -- connect and then wait -- against a five-second clock, so thirteen seconds
    // spent reaching the listener and thirteen seconds of a late timer printed the same number. This
    // starts its stopwatch at the moment the socket is up, so the figure it reports is the timer's
    // alone.
    //
    // The window is deliberately wide. What this is looking for is seconds of drift on a timer given
    // a fraction of one; a budget tight enough to notice scheduling jitter would fail on a busy
    // machine and teach everybody to ignore it.
    val body = "quiet(conn)\n" + "    onData(conn, ignore)\n" + "ignore(chunk) = chunk\n" +
        "val server = listen(0, quiet)\n" + "async main()\n" +
        "    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n" +
        "    val at = monotonic()\n" +
        "    late()\n" + "        val took = millis(monotonic() - at)\n" +
        "        print(if took >= 300 && took < 1500 then \"on time\" else \"late by \" + string(took))\n" +
        "        close(c)\n" + "        close(server)\n" + "        done()\n" +
        "    setTimeout(late, 300)\n" + "main()"

    assert_eq(out(TimeImport + netted(body)), "on time")

@test
a_port_of_zero_is_the_kernels_to_pick_and_local_port_says_which()
    // **The whole reason `localPort` exists.** A test that named a port would fail whenever anything
    // else on the machine happened to have it, which is the kind of failure nobody can reproduce.
    val body = "val s = listen(0, print)\nprint(localPort(s) > 0, localPort(s) < 65536)\nclose(s)\ndone()"

    assert_eq(net_out(body), "true true")

@test
the_end_of_a_stream_is_null_and_not_a_failure()
    // **libuv's own distinction, and the right one**: a peer closing its half is how a request
    // ordinarily ends, so it arrives as a value rather than as a fault.
    val body = "serve(conn)\n    heard(chunk)\n        send(conn, \"bye\")\n        close(conn)\n    onData(conn, heard)\nval server = listen(0, serve)\nasync main()\n    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n    reply(chunk)\n        if chunk == null\n            print(\"end\")\n            close(c)\n            close(server)\n            done()\n        else\n            print(chunk)\n    onData(c, reply)\n    await send(c, \"go\")\nmain()"

    assert_eq(net_out(body), "bye\nend")

@test
on_bytes_reads_a_socket_that_carries_something_other_than_text()
    val body = Echo + "async main()\n    val c = (await connect(\"127.0.0.1\", port)).value\n    reply(chunk)\n        if chunk != null\n            print(chunk)\n            close(c)\n            close(server)\n            done()\n    onBytes(c, reply)\n    await send(c, \"AB\")\nmain()"

    assert_eq(net_out(body), "[101, 99, 104, 111, 58, 32, 65, 66]")

@test
send_TAKES_BYTES_AS_WELL_AS_TEXT_AND_A_SPLIT_CHARACTER_SURVIVES()
    // **An array is bytes and not its own rendering**, which is what lets a program send something
    // it never decoded -- and what lets one send text it encoded itself.
    val raw = "serve(conn)\n    heard(chunk)\n        if chunk != null\n            print(fromBytes(chunk).value)\n            close(conn)\n            close(server)\n            done()\n    onBytes(conn, heard)\nval server = listen(0, serve)\nasync main()\n    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n    await send(c, toBytes(\"héllo\"))\nmain()"

    assert_eq(net_out(raw), "héllo")

    // **A character split across two sends arrives whole**, which is the failure `onData` cannot
    // avoid and `onBytes` plus one `fromBytes` at the end can: the two halves of the `é` are sent
    // separately and neither is text on its own.
    val split = "serve(conn)\n    var got = []\n    heard(chunk)\n        if chunk == null\n            print(fromBytes(got).value)\n            close(server)\n            done()\n        else\n            got = concat(got, chunk)\n    onBytes(conn, heard)\nval server = listen(0, serve)\nasync main()\n    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n    await send(c, [104, 195])\n    await send(c, [169])\n    close(c)\nmain()"

    assert_eq(net_out(split), "hé")

    // A number that is not a byte is the program's mistake, said where it was written.
    assert(net_fails("send(5, [999])").contains("a byte is between 0 and 255, and this is 999"))

@test
several_connections_are_served_at_once()
    val body = Echo + "var heardBack = 0\nasync one(n)\n    val c = (await connect(\"127.0.0.1\", port)).value\n    var got = null\n    reply(chunk)\n        if chunk != null\n            got = chunk\n            heardBack = heardBack + 1\n            close(c)\n    onData(c, reply)\n    await send(c, string(n))\n    await sleep(20)\n    got\nasync main()\n    val a = one(1)\n    val b = one(2)\n    val d = one(3)\n    print(await a, await b, await d)\n    print(heardBack)\n    close(server)\n    done()\nmain()"

    assert_eq(net_out(body), "echo: 1 echo: 2 echo: 3\n3")

@test
a_closed_socket_is_not_whatever_took_its_slot()
    // **A use-after-free wearing an integer's clothes, and it was silent.** A spent slot is reused,
    // so a socket named by its position alone came to mean whatever took the position next: the
    // closed socket compared *equal* to the live one, and `localPort` on it answered the live one's
    // port. Every id a program is handed carries the generation that claimed the slot, and a
    // generation is never reused.
    val body = "val a = listen(0, print)\nclose(a)\nval b = listen(0, print)\nprint(a == b)\nclose(b)\ndone()"

    assert_eq(net_out(body), "false")

    // And the closed one is refused by name rather than answering about the live one.
    val used = "val a = listen(0, print)\nclose(a)\nval b = listen(0, print)\nlocalPort(a)"

    assert(net_fails(used).contains("this socket is closed, and `localPort` needs an open one"))

@test
a_cancelled_timers_id_cancels_nothing_else()
    // **The same defect, found in the same place and older.** `setTimeout` handed back a slot
    // number, so cancelling an already-cancelled timer cancelled whatever had since taken the slot
    // -- and the program waiting on that second timer simply never heard from it.
    val body = "val first = setTimeout(() -> print(\"first\"), 3000)\nclearTimeout(first)\nsetTimeout(() -> print(\"second\"), 1)\nclearTimeout(first)\ndone()"

    assert_eq(net_out(body), "second")

@test
connecting_to_nothing_is_ANSWERED_and_does_not_stop_the_program()
    // A refused connection is the ordinary case a client has to handle, so it settles the promise
    // with a result rather than rejecting it -- and the program is still running afterwards.
    val body = "async main()\n    val r = await connect(\"127.0.0.1\", 1)\n    print(r.ok)\n    print(r.error)\n    done()\nmain()"
    val said = net_out(body)

    assert(said.contains("false"))
    assert(said.contains("cannot connect to 127.0.0.1:1"))
    assert(said.contains("ECONNREFUSED"))

@test
a_port_already_taken_is_refused_by_name()
    val body = "val a = listen(0, print)\nlisten(localPort(a), print)"

    assert(net_fails(body).contains("EADDRINUSE"))

@test
a_socket_builtin_says_what_it_wanted_when_given_something_else()
    assert(net_fails("listen(\"x\", print)").contains("`listen` takes a port number, or an object saying how to secure one, and this is a string"))
    assert(net_fails("listen(80)").contains("`listen` takes a port and a function, and was given 1 argument"))
    assert(net_fails("listen(0, 5)").contains("`listen` needs a function to call with each connection"))
    assert(net_fails("listen(99999, print)").contains("a port is between 0 and 65535, and this is 99999"))
    assert(net_fails("connect(1, 2)").contains("`connect` takes an address, and this is an integer"))
    assert(net_fails("send(5, \"x\")").contains("`send` takes a socket, and this is an integer"))
    assert(net_fails("close(5)").contains("`close` takes a socket, and this is an integer"))
    assert(net_fails("localPort(5)").contains("`localPort` takes a socket, and this is an integer"))
    assert(net_fails("onData(5, print)").contains("`onData` takes a socket, and this is an integer"))
    assert(net_fails("onBytes(5, print)").contains("`onBytes` takes a socket, and this is an integer"))
    assert(net_fails("onError(5, print)").contains("`onError` takes a socket, and this is an integer"))
    assert(net_fails("onError(5)").contains("`onError` takes a socket and a function, and was given 1 argument"))
    assert(net_fails("val s = listen(0, print)\nonError(s, 5)").contains("`onError` needs a function to call with the reason, and this is an integer"))

@test
closing_a_socket_twice_is_not_an_error()
    // A server closing its connections and a read callback closing its own at end-of-stream is the
    // ordinary way to write this, so the second close must not be a failure.
    val body = "val s = listen(0, print)\nclose(s)\nclose(s)\nprint(\"fine\")\ndone()"

    assert_eq(net_out(body), "fine")

@test
a_fault_in_a_socket_callback_stops_the_program()
    // **There is no statement to attach it to** -- the loop is not running one -- so it is reported
    // against the whole run, as a timer's fault is. It also has to stop a program whose server would
    // otherwise keep the loop alive forever.
    val body = "serve(conn)\n    onData(conn, chunk -> 1 / 0)\nval server = listen(0, serve)\nasync main()\n    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n    await send(c, \"boom\")\nmain()"

    assert(net_fails(body).contains("this divides by zero"))

@test
the_collector_runs_while_a_connection_is_open()
    // **A socket's slot roots the slate callback the program gave it**, and nothing else does: the
    // sysl closure libuv holds captures the slot and the generation, so a collection between the
    // call and the answer cannot free what the answer is for.
    val body = Echo + "async main()\n    val c = (await connect(\"127.0.0.1\", port)).value\n    reply(chunk)\n        if chunk != null\n            print(chunk)\n            close(c)\n            close(server)\n            done()\n    onData(c, reply)\n    for i in 0..<3000\n        val junk = { a: i, b: [i, i], c: \"x\" + string(i) }\n    await send(c, \"survived\")\nmain()"

    assert_eq(net_out(body), "echo: survived")

@test
a_second_reader_replaces_the_first()
    // What makes a protocol that changes what it expects halfway through writable at all.
    val body = Echo + "async main()\n    val c = (await connect(\"127.0.0.1\", port)).value\n    second(chunk)\n        print(\"second:\", chunk)\n        close(c)\n        close(server)\n        done()\n    first(chunk)\n        print(\"never\")\n    onData(c, first)\n    onData(c, second)\n    await send(c, \"once\")\nmain()"

    assert_eq(net_out(body), "second: echo: once")

@test
A_CONNECTION_RESET_ENDS_THE_STREAM_RATHER_THAN_THE_PROGRAM()
    // **A PEER COULD STOP THE PROGRAM, AND CANNOT NOW.** A read that fails reached `loop_fails` and
    // ended the whole run, so every slate server was killable from outside by a client that hung up
    // rudely -- and any client was killable by a server that did. It now arrives as the end of the
    // stream, which is what the ordinary reader already copes with: `if chunk == null then close(c)`
    // is the right thing to do whether the peer finished or vanished.
    //
    // **The server closes with the client's bytes still unread, which is what makes it a RESET** and
    // not an ordinary end -- a socket closed with data in its receive queue sends an RST. The test
    // below is the one that proves it is a reset; this one proves the run survives it.
    val body = "serve(conn)\n    later()\n        close(conn)\n    setTimeout(later, 60)\nval server = listen(0, serve)\nasync main()\n    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n    heard(chunk)\n        if chunk == null\n            print(\"ended\")\n            close(c)\n            close(server)\n            done()\n        else\n            print(\"chunk\")\n    onData(c, heard)\n    await send(c, repeat(\"x\", 4000))\nmain()\n"

    assert_eq(net_out(body), "ended")

@test
onError_SAYS_WHY_THE_SOCKET_STOPPED()
    // What a program gets for registering one: the reason, INSTEAD of the `null` that would
    // otherwise end the stream. Without it a reset and a peer that finished are the same event.
    val body = "serve(conn)\n    later()\n        close(conn)\n    setTimeout(later, 60)\nval server = listen(0, serve)\nasync main()\n    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n    heard(chunk)\n        print(\"heard\")\n    failed(why)\n        print(why)\n        close(c)\n        close(server)\n        done()\n    onData(c, heard)\n    onError(c, failed)\n    await send(c, repeat(\"x\", 4000))\nmain()\n"
    val said = net_out(body)

    assert(said.contains("this connection failed"))
    assert(said.contains("ECONNRESET"))

@test
AN_ERROR_HANDLER_SURVIVES_THE_NEXT_onData_WHICH_IS_WHY_IT_IS_A_REGISTRATION_OF_ITS_OWN()
    // **The whole argument for `onError(sock, fn)` over a third argument to `onData`.** `onData`
    // REPLACES its callback -- that is the point of it, and what makes a protocol that changes what
    // it expects halfway through writable -- so a handler passed alongside the reader would be
    // silently dropped by the second call. Here the second `onData` is the one that reads, and the
    // handler registered before it is still the one that hears.
    val body = "serve(conn)\n    later()\n        close(conn)\n    setTimeout(later, 60)\nval server = listen(0, serve)\nasync main()\n    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n    first(chunk)\n        print(\"first\")\n    second(chunk)\n        print(\"second\")\n    failed(why)\n        print(\"still told\")\n        close(c)\n        close(server)\n        done()\n    onData(c, first)\n    onError(c, failed)\n    onData(c, second)\n    await send(c, repeat(\"x\", 4000))\nmain()\n"

    assert_eq(net_out(body), "still told")

    // A second `onError` replaces the first, as a second `onData` does, so an error channel can be
    // moved as the reader is.
    val moved = "serve(conn)\n    later()\n        close(conn)\n    setTimeout(later, 60)\nval server = listen(0, serve)\nasync main()\n    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n    heard(chunk)\n        print(\"heard\")\n    never(why)\n        print(\"never\")\n    failed(why)\n        print(\"told:\", why)\n        close(c)\n        close(server)\n        done()\n    onData(c, heard)\n    onError(c, never)\n    onError(c, failed)\n    await send(c, repeat(\"x\", 4000))\nmain()\n"

    assert(net_out(moved).contains("told:"))
    assert(!net_out(moved).contains("never"))

@test
A_CHUNK_THAT_IS_NOT_TEXT_FAILS_THE_CONNECTION_AND_NOT_THE_RUN()
    // Reading a binary stream with `onData` is the program's mistake, but the bytes are the PEER'S:
    // a server sending one invalid sequence used to stop a client outright, which is the same
    // killable-from-outside defect a reset was. It is this connection's failure and it says so
    // through the same channel. `onBytes` is the reader that cannot have the problem.
    val body = "serve(conn)\n    send(conn, [255, 254])\nval server = listen(0, serve)\nasync main()\n    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n    heard(chunk)\n        print(\"heard\")\n    failed(why)\n        print(why)\n        close(c)\n        close(server)\n        done()\n    onData(c, heard)\n    onError(c, failed)\n    await send(c, \"go\")\nmain()\n"

    assert(net_out(body).contains("this chunk is not text"))

// -- the file system, blocking ---------------------------------------------------------------------

@test
the_blocking_calls_need_no_async_function_at_all()
    // **The point of them.** Not one `async`, `await` or promise in the program — a script whose job
    // is three file operations in order gains nothing from a promise and pays for it in an `async`
    // function that exists only to hold an `await`.
    val body = "mkdirSync(\"<dir>/sub\")\nwriteFileSync(\"<dir>/sub/a.txt\", \"hello sync\")\nprint(readFileSync(\"<dir>/sub/a.txt\").value)\nprint(readDirSync(\"<dir>/sub\").value)"

    assert_eq(in_scratch(body), "hello sync\n[\"a.txt\"]")

@test
each_blocking_call_answers_what_its_promise_would_have()
    // The two halves are meant to agree on everything but the waiting, so this asserts the pair
    // against each other rather than against a written-out expectation.
    val both = "writeFileSync(\"<dir>/a.txt\", \"12345\")\nasync main()\n    print(readFileSync(\"<dir>/a.txt\").value == (await readFile(\"<dir>/a.txt\")).value)\n    print(readBytesSync(\"<dir>/a.txt\").value == (await readBytes(\"<dir>/a.txt\")).value)\n    print(readDirSync(\"<dir>\").value == (await readDir(\"<dir>\")).value)\n    print(existsSync(\"<dir>\") == await exists(\"<dir>\"))\n    val a = statSync(\"<dir>/a.txt\").value\n    val b = (await stat(\"<dir>/a.txt\")).value\n    print(a.size == b.size, a.isFile == b.isFile, a.isDir == b.isDir)\nmain()"

    assert_eq(in_scratch(both), "true\ntrue\ntrue\ntrue\ntrue true true")

@test
a_blocking_failure_is_answered_exactly_as_the_promise_would_have()
    // **The two halves differ in the waiting and in nothing else.** A blocking call that fails
    // answers the same `{ ok: false, error }` its promise-shaped twin settles with, so a program
    // reads one the way it reads the other.
    assert(fs_out("print(readFileSync(\"/no/such/file\").error)").contains("cannot read /no/such/file"))
    assert(fs_out("print(readDirSync(\"/no/such\").error)").contains("cannot list /no/such"))
    assert(fs_out("print(mkdirSync(\"/no/such/dir\").error)").contains("cannot make /no/such/dir"))
    assert(fs_out("print(renameSync(\"/no/such\", \"/tmp/x\").error)").contains("cannot rename /no/such"))
    assert(fs_out("print(statSync(\"/no/such\").error)").contains("cannot stat /no/such"))
    assert(fs_out("print(removeSync(\"/no/such\").error)").contains("cannot remove /no/such"))

    // And a file that is not text points at the blocking reader, not the asynchronous one.
    val said = fs_out("print(readFileSync(\"/bin/ls\").error)")

    assert(said.contains("is not text"))
    assert(said.contains("`readBytesSync`"))

    // Nothing above stopped the program, which is the whole difference from what this used to be.
    assert_eq(fs_out("readFileSync(\"/no/such/file\")\nprint(\"still here\")"), "still here")

@test
exists_sync_answers_rather_than_failing()
    assert_eq(in_scratch("print(existsSync(\"<dir>\"), existsSync(\"<dir>/nope\"))"), "true false")

@test
a_blocking_builtin_says_what_it_wanted_when_given_something_else()
    assert(fs_fails("readFileSync(42)").contains("`readFileSync` takes a path, and this is an integer"))
    assert(fs_fails("readFileSync()").contains("`readFileSync` takes one path and was given 0 arguments"))
    assert(fs_fails("writeFileSync(\"a\")").contains("`writeFileSync` takes a path and its contents"))
    assert(fs_fails("renameSync(\"a\")").contains("`renameSync` takes two paths"))
    assert(fs_fails("mkdirSync(null)").contains("`mkdirSync` takes a path"))

@test
connect_TAKES_A_NAME_AND_NOT_ONLY_AN_ADDRESS()
    // **A resolver on `connect`, which is what puts a hosted service in reach.** It is not only that
    // typing an address is tiresome: TLS verifies a *name*, so a program that had resolved the name
    // itself would arrive at `startTls` holding an address and have nothing to check a certificate
    // against. `slate:http`'s client has always resolved; the socket a program drives itself did not.

    assert_eq(net_out("serve(conn)\n    heard(chunk)\n        if chunk == null\n            close(conn)\n        else\n            send(conn, \"echo: \" + chunk)\n\n    onData(conn, heard)\n\nval server = listen(0, serve)\n\nasync main()\n    val c = (await connect(\"localhost\", localPort(server))).value\n\n    reply(chunk)\n        print(chunk)\n        close(c)\n        close(server)\n        done()\n\n    onData(c, reply)\n    await send(c, \"hello\")\n\nmain()"), "echo: hello")

@test
a_name_that_does_not_resolve_is_ANSWERED_the_way_a_refused_connection_is()
    // **Settled and not thrown**, for the reason a refused connection is: a name that is not there is
    // an outcome a client has to handle rather than a mistake in the program. `.invalid` is reserved
    // by RFC 2606 precisely so that it never resolves.
    val said = net_out("async main()\n    val r = await connect(\"no-such-host.invalid\", 80)\n\n    print(r.ok)\n    print(r.error.contains(\"cannot find no-such-host.invalid\"))\n    done()\n\nmain()")

    assert_eq(said, "false\ntrue")

@test
appendFile_ADDS_TO_A_FILE_AND_MAKES_ONE_THAT_IS_NOT_THERE()
    // **`O_APPEND` and not a read followed by a write**, which is what a program had to do without
    // this: the kernel places the bytes at the end at the moment they are written, so nothing has to
    // hold a whole file to add a line to it. A log is what this is for.
    assert_eq(in_scratch("async main()\n    await writeFile(\"<dir>/a.txt\", \"one\\n\")\n    await appendFile(\"<dir>/a.txt\", \"two\\n\")\n    await appendFile(\"<dir>/a.txt\", \"three\\n\")\n    print(toJSON((await readFile(\"<dir>/a.txt\")).value))\nmain()"),
        "\"one\\ntwo\\nthree\\n\"")

    // A file that is not there yet is made, which is what `O_CREAT` says and what a program adding
    // its first line expects.
    assert_eq(in_scratch("async main()\n    await appendFile(\"<dir>/new.txt\", \"first\")\n    print((await readFile(\"<dir>/new.txt\")).value)\nmain()"),
        "first")

    // **Anything that is not text is rendered as `print` would render it**, which is `writeFile`'s
    // rule and is the reading a program adding a number expects.
    assert_eq(in_scratch("async main()\n    await appendFile(\"<dir>/n.txt\", 42)\n    print((await readFile(\"<dir>/n.txt\")).value)\nmain()"),
        "42")

@test
appendFile_TO_A_DIRECTORY_THAT_IS_NOT_THERE_ANSWERS()
    // The error path, and it is an ANSWER: a path that is not there is a condition every caller was
    // always going to deal with.
    val said = in_scratch("async main()\n    val r = await appendFile(\"<dir>/gone/a.txt\", \"x\")\n    print(r.ok, r.error)\nmain()")

    assert(said.contains("false"))
    assert(said.contains("cannot write"))

    // And a path that is not a path at all is the program's own mistake, so it faults.
    assert(fails_in_scratch("async main()\n    await appendFile(42, \"x\")\nmain()").contains("appendFile"))

@test
appendFileSync_IS_THE_BLOCKING_TWIN_EVERY_OTHER_OPERATION_ALREADY_HAD()
    // **`slate:fs`'s page says every operation has a blocking twin under a `Sync` suffix**, ten of
    // them had one, and `appendFile` arrived with the promise half alone -- so the documentation was
    // asserting something that was not true. What it cost is the case the suffix is for: a sink
    // answers nothing and cannot await, so a program logging a line had no way to know it landed.
    assert_eq(in_scratch("writeFileSync(\"<dir>/a.txt\", \"one\\n\")\nappendFileSync(\"<dir>/a.txt\", \"two\\n\")\nappendFileSync(\"<dir>/a.txt\", \"three\\n\")\nprint(toJSON(readFileSync(\"<dir>/a.txt\").value))"),
        "\"one\\ntwo\\nthree\\n\"")

    // A file that is not there yet is made, which is what `O_CREAT` says.
    assert_eq(in_scratch("appendFileSync(\"<dir>/new.txt\", \"first\")\nprint(readFileSync(\"<dir>/new.txt\").value)"), "first")

    // **The bytes go at the END and not at wherever the file happened to stop when it was opened**,
    // which is the whole difference between this and a `writeFileSync` of the joined text -- and is
    // what the flag rather than the offset buys.
    assert_eq(in_scratch("appendFileSync(\"<dir>/n.txt\", 42)\nappendFileSync(\"<dir>/n.txt\", true)\nprint(readFileSync(\"<dir>/n.txt\").value)"),
        "42true")

    // The error path is an ANSWER, as its promise half's is: a path that is not there is a condition
    // every caller was always going to deal with.
    val said = in_scratch("val r = appendFileSync(\"<dir>/gone/a.txt\", \"x\")\nprint(r.ok, r.error)")

    assert(said.contains("false"))
    assert(said.contains("cannot write"))

    // And a path that is not a path at all is the program's own mistake, so it faults.
    assert(fails_in_scratch("appendFileSync(42, \"x\")").contains("appendFileSync"))

@test
stderr_IS_A_SECOND_STREAM_AND_NOT_A_SECOND_print()
    // **`print` is the answer a program produces and `stderr` is what it says about producing it**,
    // which is the division every shell already makes. What the runner collects is standard output,
    // so a complaint written here is simply not in it -- which is the whole of the assertion.
    val prog = "import { stderr } from slate:process\n"

    assert_eq(out(prog + "stderr(\"a complaint\\n\")\nprint(\"the answer\")"), "the answer")

    // It takes as many values as `print` does, separated the same way, and answers nothing.
    assert_eq(out(prog + "print(stderr(\"x\", 1, true))"), "null")

@test
writeBytes_PUTS_THE_BYTES_ON_THE_DISK_WHERE_writeFile_PUTS_THEIR_RENDERING()
    // **This is the whole of what the pair adds.** `writeFile` renders anything that is not a
    // string the way `print` would, so an array reached the disk as the eight characters
    // `[72, 105]` -- and a program holding an image, a compressed body or a digest either encoded
    // it as text or could not write it at all.
    assert_eq(in_scratch("async main()\n    await writeFile(\"<dir>/a\", [72, 105])\n    await writeBytes(\"<dir>/b\", [72, 105])\n    print((await readFile(\"<dir>/a\")).value, (await readFile(\"<dir>/b\")).value)\nmain()"),
        "[72, 105] Hi")

    // Bytes that are not text at all go out and come back unchanged, which text could not do.
    assert_eq(in_scratch("async main()\n    await writeBytes(\"<dir>/a\", [0, 255, 128, 10])\n    print((await readBytes(\"<dir>/a\")).value)\nmain()"),
        "[0, 255, 128, 10]")

    // An empty array is an empty file rather than a refusal.
    assert_eq(in_scratch("async main()\n    await writeBytes(\"<dir>/a\", [])\n    print((await stat(\"<dir>/a\")).value.size)\nmain()"), "0")

    // A second write replaces what was there.
    assert_eq(in_scratch("async main()\n    await writeBytes(\"<dir>/a\", [1, 2, 3, 4])\n    await writeBytes(\"<dir>/a\", [9])\n    print((await readBytes(\"<dir>/a\")).value)\nmain()"),
        "[9]")

@test
appendBytes_ADDS_TO_A_FILE_AND_MAKES_ONE_THAT_IS_NOT_THERE()
    assert_eq(in_scratch("async main()\n    await writeBytes(\"<dir>/a\", [1])\n    await appendBytes(\"<dir>/a\", [2, 3])\n    await appendBytes(\"<dir>/a\", [4])\n    print((await readBytes(\"<dir>/a\")).value)\nmain()"),
        "[1, 2, 3, 4]")

    assert_eq(in_scratch("async main()\n    await appendBytes(\"<dir>/new\", [7, 8])\n    print((await readBytes(\"<dir>/new\")).value)\nmain()"),
        "[7, 8]")

@test
the_bytes_writers_HAVE_THE_BLOCKING_TWINS_EVERY_OTHER_OPERATION_HAS()
    assert_eq(in_scratch("writeBytesSync(\"<dir>/a\", [65, 66])\nappendBytesSync(\"<dir>/a\", [67])\nprint(readBytesSync(\"<dir>/a\").value, readFileSync(\"<dir>/a\").value)"),
        "[65, 66, 67] ABC")

    // The two halves answer the same file, which is what the pair promises.
    assert_eq(in_scratch("async main()\n    writeBytesSync(\"<dir>/a\", [1, 2])\n    await appendBytes(\"<dir>/a\", [3])\n    print(readBytesSync(\"<dir>/a\").value == (await readBytes(\"<dir>/a\")).value)\nmain()"),
        "true")

@test
a_write_of_BYTES_FAULTS_ON_ANYTHING_THAT_IS_NOT_BYTES()
    // **The two readings are one rule seen from opposite ends.** `writeFile` is about a file's
    // text, so a number is something the writer wanted written out; `writeBytes` is about the
    // bytes themselves, so a value that is not bytes is a mistake in the program -- and rendering
    // it would put `[72, 105]` on the disk under a name that says otherwise.
    val text = fails_in_scratch("async main()\n    await writeBytes(\"<dir>/a\", \"hi\")\nmain()")

    assert(text.contains("`writeBytes` takes an array of numbers, and this is a string"))
    assert(text.contains("`writeFile` is what writes anything else"))

    assert(fails_in_scratch("async main()\n    await appendBytes(\"<dir>/a\", 42)\nmain()").contains("`appendFile` is what writes anything else"))
    assert(fails_in_scratch("writeBytesSync(\"<dir>/a\", {})").contains("`writeFileSync` is what writes anything else"))
    assert(fails_in_scratch("appendBytesSync(\"<dir>/a\", true)").contains("`appendFileSync` is what writes anything else"))

    // An element out of range is the same complaint `send` and `fromBytes` already make.
    assert(fails_in_scratch("writeBytesSync(\"<dir>/a\", [256])").contains("a byte is between 0 and 255, and this is 256"))
    assert(fails_in_scratch("writeBytesSync(\"<dir>/a\", [-1])").contains("a byte is between 0 and 255, and this is -1"))
    assert(fails_in_scratch("writeBytesSync(\"<dir>/a\", [\"x\"])").contains("one of these is a string"))

    // A path that is not a path, and a count that is wrong.
    assert(fails_in_scratch("writeBytesSync(42, [1])").contains("`writeBytesSync` takes a path"))
    assert(fails_in_scratch("writeBytesSync(\"<dir>/a\")").contains("`writeBytesSync` takes a path and its bytes"))

@test
a_write_of_bytes_TO_A_DIRECTORY_THAT_IS_NOT_THERE_ANSWERS()
    // **Reaching the disk is an answer and not a fault**, which is the rule every other call here
    // follows: the directory is outside the program.
    val said = in_scratch("async main()\n    val r = await writeBytes(\"<dir>/gone/a\", [1])\n    print(r.ok, r.error)\nmain()")

    assert(said.contains("false"))
    assert(said.contains("cannot write"))

    val too = in_scratch("val r = appendBytesSync(\"<dir>/gone/a\", [1])\nprint(r.ok, r.error)")

    assert(too.contains("false"))
    assert(too.contains("cannot write"))
