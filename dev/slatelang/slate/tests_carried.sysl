module dev.slatelang.slate

import sysl.text.Search

// What a thrown value costs the machine, as distinct from what it means (`tests/lang/faults.sl`, and
// the interpreter's own sentences in `tests_syntax.sysl`).
//
// **The value a fault carries lives in the VM's `carried` table and a `Fail` names it by number**,
// because every arm of the instruction loop answers a `Step` and a `Value` inside `Fail` nearly
// doubled one. These tests pin both halves of that bargain: the width it bought back, and that the
// table it costs is given back as faults are consumed rather than growing with every `throw`.

// How many entries of the table are still holding a value.
private carried_live() -> usize = current().carried.len() - current().carried_free.len()

@test
A_STEP_IS_NO_WIDER_THAN_IT_WAS_BEFORE_A_FAULT_COULD_CARRY_A_VALUE()
    // **Sixty-four bytes: a tag and the widest variant, which is a `Fail` holding a span, a sentence
    // and two 32-bit numbers.** With the value in the variant it was 112, and the benchmarks ran 18%
    // slower for it -- every arm returns one, fault or no fault. A field added to `Fail` or `Skip`
    // that pushes this back up has to answer to the same measurement.
    assert(sizeof(Step) <= 64)
    assert(sizeof(Signal) <= sizeof(Step))

@test
A_PROGRAM_THAT_THROWS_AND_CATCHES_IN_A_LOOP_HOLDS_NO_CARRIED_VALUE_AFTERWARDS()
    // Each `catch` takes the value it binds out of the table, so a thousand faults reuse one entry.
    val prog = "data Failure\n    NotFound(id)\n\nvar total = 0\n\nfor i in 0..<1000\n    try\n        throw NotFound(i)\n    catch NotFound(which)\n        total = total + which\n\nprint(total)"

    assert_eq(out(prog), "499500")
    assert(carried_live() == 0)
    assert(current().carried.len() <= 1)

@test
A_REJECTION_CARRYING_A_VALUE_GIVES_ITS_ENTRY_BACK_WHEN_IT_IS_CAUGHT()
    // The value crosses a promise -- taken out of the table into the promise, put back in when the
    // awaiting machine is resumed with the fault, and taken again by that machine's `catch`.
    // `reject` is the other way in, raising the same fault from a promise already settled.
    val prog = "data Failure\n    NotFound(id)\n\nasync risky(n)\n    throw NotFound(n)\n\nvar seen = 0\n\nfor i in 0..<50\n    try\n        await risky(i)\n    catch NotFound(which)\n        seen = seen + which\n\n    try\n        await reject(NotFound(1))\n    catch NotFound(which)\n        seen = seen + which\n\nprint(seen)"

    assert_eq(out(prog), "1275")
    assert(carried_live() == 0)

@test
A_RELEASE_THAT_FAULTS_WITH_A_VALUE_WHILE_ANOTHER_TRAVELS_DROPS_ONLY_ITS_OWN()
    // The disposal's own fault is suppressed and its value dropped from the table; the fault that was
    // already going keeps its entry and is the one the `catch` binds.
    val prog = "data Failure\n    NotFound(id)\n    Other(id)\n\nbad() =\n    throw Other(2)\n\nmade() = { dispose: bad }\n\nboom()\n    using r = made()\n\n    throw NotFound(7)\n\ntry\n    boom()\ncatch NotFound(which)\n    print(which)\ncatch Other(which)\n    print(\"the release's\", which)"

    assert_eq(out(prog), "7")
    assert(carried_live() == 0)

@test
A_VALUE_FAULT_NOBODY_CATCHES_IS_STILL_REPORTED_BY_WHAT_IT_SAYS()
    // The error path: an uncaught fault is read for its sentence, which is filled where it was raised,
    // so the value sitting in the table rather than in the `Fail` changes nothing a reader sees.
    assert(fails("data Failure\n    NotFound(id)\n\nthrow NotFound(3)").contains("NotFound(3)"))
