module dev.slatelang.slate

import sh.sysl.libuv
import sysl.buf.{Buf, buf}
import sysl.text.{CString, StrBuilder, cstring, from_utf8_unchecked, str_builder}

// The C surface of the interpreter: what `sysl build-c` exports, so a C program with a `main` of its
// own can link slate as an archive and run slate programs through it.
//
// **Every signature here is C-shaped on purpose** -- integers, and a pointer with its length -- because
// C has no declaration for a sysl `string` or a slice. The facade converts at the door and hands the
// text to the very function `slate <file>` runs a file through, so an embedded run and a command-line
// run cannot drift about what running a program means.
//
// **The handle C holds is a pointer to an `Embedded`, and the header spells it as an opaque struct.**
// A VM is built with `new_vm` exactly as an actor builds its own, then entered for the length of each
// call and left again -- `enter`/`leave` are the only way a second VM runs on a thread, and a C caller
// is a second VM by definition, the program's own being the one `main_vm` the process keeps. What is
// beside the VM is what the caller asks about afterwards: the last run's complaint, kept in the shape C
// reads, because a diagnostic handed back as a sysl `string` would be bytes with no terminator and a
// length nobody told the caller.
//
// **The sysl names carry an `embed_` prefix and the exported names a `slate_` one.** The exported name
// is the C API's and follows C's habit of a library prefix; the sysl name cannot be the bare word,
// `error`, `free` and `new` all being names something in this module or the library already answers to.

// What one C caller owns: a VM of its own and the text of the last thing that went wrong in it. The
// header calls it `slate_vm`, the C API's own name for the handle, and **`opaque` is what keeps it a
// handle there**: the header declares it without a layout, as C's `struct slate_vm;`, where a struct
// with a body would be written out field by field down through the whole `Vm`.
@export("slate_vm")
opaque struct Embedded
    vm: Vm

    // What the last `slate_eval` complained of, rendered, or empty where it ran. **A `CString` and not
    // a `string`**, so the pointer handed to C is NUL-terminated and stays valid until the next call
    // replaces it, which is the promise the header makes.
    error: CString

    // What every `slate_eval` on this handle runs in, so a later call sees what an earlier one
    // defined (`session.sysl`). Its scopes are rooted in `vm` from the first call until `slate_free`
    // gives the heap back.
    session: ProgramSession

    // What the last `slate_show` rendered, kept for `error`'s reason: the pointer handed to C has to
    // outlive the call that answered it.
    shown: CString

    // Where a printed line goes, and what to hand it (`slate_on_output`); null is stdout.
    output: OutputCall
    output_user: *u8

    // How many host functions are running on this handle (`embed_host.sysl`), which is what tells
    // `slate_call` it was made from inside one.
    depth: usize

    // Whether the host owns the loop (`slate_set_manual_loop`, `embed_loop.sysl`): a program or a call
    // then returns at its first suspension and the host pumps what is left.
    manual: bool

// How many handles may be live at once.
const MaxEmbedded: usize = 64

// Every embedded VM in the process, each in a counted box this table keeps alive.
//
// **The record cannot live in storage C or libc handed over**, because a `Vm` carries `&T` fields --
// its loop, its live sink -- and an assignment into bytes the compiler did not lay out releases
// whatever those bytes looked like, a zeroed `&T` being a null the release follows. So the record is
// an ordinary box, made by a construction, and the handle C holds is the address of what is IN it: a
// box never moves, and this table is what keeps it from being released between two calls.
//
// process-wide: THE EMBEDDED VMS OF THIS PROCESS. A C caller may make and free handles from any thread,
// so the table cannot be per-VM. Every read and write of it is under `embedded_lock`, and a slot's box
// is reached by nothing else -- C holds a raw pointer, which carries no count -- so no two threads ever
// touch one box's count at once.
private var embedded: [MaxEmbedded]Option[&Embedded] = [None; MaxEmbedded]

// process-wide: what `embedded` is read and written under.
private var embedded_lock: &sync libuv.Mutex = libuv.mutex().expect("a lock for the embedded VMs")

// **Held here rather than made per call**, because the pointer handed to C has to outlive the call
// that answered it, and a `CString` made inside `embed_version` would be freed on the way out.
private val version_text: CString = cstring(SlateVersion)

// The version `slate --version` answers, as a NUL-terminated string that lives as long as the process.
@export("slate_version")
embed_version() -> *u8 = version_text.ptr

// A VM of the caller's own, over a heap of `heap_bytes`, or of the size `slate` itself uses where
// that is zero, or null where `MaxEmbedded` handles are already live. The caller frees it with
// `slate_free`.
//
// **A libuv loop of its own, as an actor is given one** (`actor_thread`), and closed by `slate_free`.
// A host that owns its main loop pumps one handle's work at a time (`slate_pump`), and a loop shared
// with the process -- or with another handle -- cannot be pumped for one VM without running every
// other VM's callbacks on the wrong heap. It costs nothing a script host notices: the loop is drained
// after every call exactly as the shared one was. Null where no loop could be made either.
@export("slate_new")
embed_new(heap_bytes: usize) -> *Embedded
    val lp = libuv.new_loop() match
        Ok(made) -> made
        Err(_) -> return null

    val ceiling = if heap_bytes == 0 then HeapBytes else heap_bytes
    val box: &Embedded = Embedded(new_vm(ceiling, lp), cstring(""), program_session(), cstring(""), null, null, 0, false)
    var h: *Embedded = null

    embedded_lock.lock()

    for i in 0..<MaxEmbedded
        if embedded[i].is_none()
            embedded[i] = Some(box)
            h = &*box
            break

    embedded_lock.unlock()

    if h == null then given_back(&box.vm)

    h
end embed_new

// Give back everything `slate_new` took: the VM's heap, with every finalizer run, and the record --
// which goes when the last hold on its box does, the slot's having been taken out under the lock. A
// pointer the table never handed out, or one already freed, is ignored.
@export("slate_free")
embed_free(h: *Embedded)
    var mine: Option[&Embedded] = None

    embedded_lock.lock()

    for i in 0..<MaxEmbedded
        val here = embedded[i] match
            Some(b) -> &*b == h
            None -> false

        if here
            mine = embedded[i]
            embedded[i] = None
            break

    embedded_lock.unlock()

    mine match
        Some(b) -> given_back(&b.vm)
        None -> ()
end embed_free

// A VM's heap and its loop, given back. **What a manual-loop handle left pending is closed first**:
// a timer or a socket still open keeps the loop from closing, so every slot is surrendered and the
// loop turned once without waiting, which is when libuv runs the close callbacks.
private given_back(vm: *Vm)
    val lp = vm.uv_loop
    val was = enter(vm)

    reset_events()
    lp.run(libuv.RUN_NOWAIT) match
        Ok(_) -> ()
        Err(_) -> ()

    leave(was)
    dispose_vm(vm)

    // **Refused only while something is still open**, which the surrender above has closed; a loop
    // that will not close is left to the process rather than failing the free.
    lp.close() match
        Ok(_) -> ()
        Err(_) -> ()
end given_back

// Run `len` bytes of slate source as a program on this VM and answer its status: zero where it ran to
// the end, what it passed to `exit` where it called that, and one where it was refused or faulted --
// in which case `slate_error` has the diagnostic. `name` is what a diagnostic quotes as the file, the
// text having none.
//
// **What the program prints goes to stdout as it prints it**, exactly as `slate <file>` behaves, or
// to the function `slate_on_output` installed; only the complaint is kept.
//
// **Refused from inside a host function** (`embed_host.sysl`): a program is a whole run of its own,
// with a fresh machine and a drained loop, and the run that called the host function is standing on
// both. `slate_call` is what a host function calls back with.
//
// **Every call on one handle runs in one session**, so what an earlier call defined at its top level
// -- a function, a `val`, a class, an import -- the next can use, and what it binds joins them. A
// refused call changes nothing; one that faults keeps whatever it bound before the fault.
// `session.sysl` has the rule, and what is per call rather than per handle.
@export("slate_eval")
embed_eval(h: *Embedded, text: *u8, len: usize, name: *u8, name_len: usize) -> i32 =
    embed_eval_with(h, owned(text, len), owned(name, name_len), line -> host_say(h, line))

// Bytes C handed over, copied into a string of the facade's own. **A session keeps every program's
// source for as long as the handle lives** -- a function one call defined may fault in a later one,
// and the diagnostic is drawn against the text it was written in -- while a slice of C's memory owns
// nothing and is good only until the call returns.
//
// Not `private`: `embed_values.sysl` copies a string, a key and a name the same way.
owned(p: *u8, n: usize) -> string
    var copy = str_builder()

    copy.push(from_utf8_unchecked(p[0..<n]))
    copy.finish()

// The call, with where the program's output goes handed in -- `print` from C, and a test's own
// buffer from `tests_embed.sysl`, which is how a test reads what one call printed.
embed_eval_with(h: *Embedded, program: string, name: string, say: string -> unit) -> i32
    if h.depth > 0
        h.error = cstring("`slate_eval` cannot run a program from inside a host function -- call `slate_call` instead")
        return 1

    var no_args: Buf[string] = buf()
    var complaint = str_builder()
    val session = &h.session
    val was = enter(&h.vm)

    val drain = !h.manual
    val code = ran_bytes("slate", name, program.bytes, no_args, say, line -> complain(line, &complaint),
                         src -> add_program(session, src, drain))

    leave(was)

    h.error = cstring(complaint.finish())
    i32(code)
end embed_eval_with

// The diagnostic the last `slate_eval` left, NUL-terminated, or an empty string where it ran. The
// pointer is good until the next call on this handle.
@export("slate_error")
embed_error(h: *Embedded) -> *u8 = h.error.ptr

// How many bytes `slate_error` points at, not counting the terminator.
@export("slate_error_len")
embed_error_len(h: *Embedded) -> usize = h.error.len

// One line of a complaint, kept. **A newline between lines and not after the last**, so a one-line
// diagnostic is exactly its sentence.
private complain(line: string, into: *StrBuilder)
    if into.bytes.len() > 0 then into.push("\n")

    into.push(line)
