module dev.slatelang.slate

import sysl.buf.{Buf, buf}

// The C surface of the interpreter: what `sysl build-c` exports, so a C program with a `main` of its
// own can link slate as an archive and run slate programs through it.
//
// **Every signature here is C-shaped on purpose** -- integers and a pointer with its length -- because
// C has no declaration for a sysl `string` or a slice. The facade converts at the door and hands the
// text to the very function `slate <file>` runs a file through, so an embedded run and a command-line
// run cannot drift about what running a program means.

// The leading number of `SlateVersion`, read off the one string `slate --version` answers rather
// than written a second time.
@export("slate_version_major")
version_major() -> i32
    var n: i32 = 0

    for c in SlateVersion.bytes
        if c < u8('0') || c > u8('9') then return n

        n = n * 10 + i32(c - u8('0'))

    n

// Runs `len` bytes of slate source as a program and answers its exit status, printing what it prints
// to stdout as it goes. `<embedded>` is the name a diagnostic quotes, there being no file.
@export("slate_run_source")
run_source(text: *u8, len: usize) -> i32
    var no_args: Buf[string] = buf()

    i32(run_bytes("slate", "<embedded>", text[0..<len], no_args, line -> print(line)))
