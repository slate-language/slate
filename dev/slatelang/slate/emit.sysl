module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// Emitting an instruction, and the two counters that make a jump correct.
//
// **Split out of `compile.sysl`, and it is the file the other two both talk to**: `compile.sysl`
// turns statements into instructions and `compile_expr.sysl` turns expressions into them, and
// neither can do anything without `put`, `here` and `patch`. So NOTHING HERE IS `private` -- these
// are the emitter's API rather than its internals, and `private` in sysl is private to the FILE.
//
// The tree to instructions.
//
// **Two counters make this whole file work, and both are compile-time.** `sp` is how many values will
// be on the operand stack when this instruction runs, and `scopes` is how deep the scope chain will
// be. Neither is needed at run time, and knowing both here is what lets `break` emit exactly the
// right number of `Pop`s and `PopScope`s to leave the loop balanced -- rather than the machine
// carrying unwind tables to work it out again.
//
// **Every statement leaves exactly one value on the stack**, and the statement after it begins by
// popping that. A block's value is therefore whatever the last statement left, which is slate's rule,
// and an empty block pushes `null` so the rule holds with nothing in it.

// What one chunk's compilation is carrying.
struct Emit
    code: Buf[Ins]

    // How tall the operand stack will be here.
    sp: usize

    // How deep the scope chain will be here.
    scopes: usize

    // The loops enclosing this point, innermost last.
    loops: Buf[LoopFrame]

    // How many `try` handlers will be owed here.
    //
    // **The third counter, and it exists for the same reason the other two do**: a `break` out of a
    // `try` body has to leave the machine balanced, and the only place the number of handlers to
    // drop is known is here.
    handlers: usize

    // Whether the chunk being compiled is an `async` one, which is what says whether `await` is
    // allowed in it. **A compile-time question rather than a run-time one**: a machine that reached an
    // `await` it could not honour would have to decide what to do with a half-evaluated expression,
    // and there is no good answer -- so the code is never emitted.
    is_async: bool

    // Whether the chunk being emitted is a generator's, which is what tells a `yield` that belongs
    // here from one written where there is nothing to yield to.
    is_gen: bool

    // -- the names this chunk resolved for itself --

    // Whether this chunk needs no `EnvObj` AT ALL: its parameters are cells, no block pushes a
    // scope, and `vm.scope` stays the one its closure captured. False for a module, whose names are
    // read by name from outside it, and for any chunk one of whose own names something outside it
    // can reach.
    //
    // **This is the STRONGER of the two questions and `cells` is the weaker one.** They were one
    // flag while a chunk either slotted everything or nothing; a chunk holding a closure that reads
    // one of its names keeps a scope for that name and puts every other one in a cell, and the two
    // answers come apart there.
    slotting: bool

    // Whether ANY name declared here may take a cell.
    //
    // **A chunk may have cells and still need its scope**, which is the whole of what per-name
    // slotting buys: the names a nested body can reach stay in the chain and everything else moves
    // into the frame. `slotting` implies this; the reverse does not hold.
    cells: bool

    // The names that may NOT take a cell, however ordinary they look.
    //
    // **Two things put a name here and both are about somebody reading it by NAME.** A nested
    // function reaches it through the scope chain it captured, and a pattern looks a type up by it
    // in the scope the match is running in. Either way a cell would be a second home the reader
    // cannot see, so these keep `LoadName` exactly as they always did.
    //
    // **A name here is kept EVERYWHERE IN THE CHUNK, not only where it was captured**, which is
    // what makes the analysis answerable by reading: a name is a cell or it is not, and no site has
    // to work out which of two bindings of one spelling it is looking at.
    kept: Buf[string]

    // How many slots the chunk reserves at entry, which is the high-water mark rather than the count
    // standing at any moment: a slot is not reused when its block ends, since working out that two
    // blocks cannot both be live is a second analysis and the cells are cheap.
    slots: usize

    // The names bound in this chunk, innermost last, and the slot each was given.
    //
    // **One flat pair of lists with a stack of block boundaries over it**, rather than a list per
    // block: a lookup walks it backwards and finds the innermost, which is the shadowing rule, and a
    // block ending is a truncate.
    named: Buf[string]
    slot_of: Buf[usize]

    // Whether each is a `var`. A write to one that is not says the sentence it always said.
    slot_var: Buf[bool]

    // Whether each is a CELL rather than a name in the scope chain.
    //
    // **A chunk with cells records its scope-bound names here too, and that is not bookkeeping for
    // its own sake.** A binding site whose pattern holds one kept name puts the WHOLE pattern in the
    // scope, so an inner block can bind by name a spelling an outer block put in a cell -- and a
    // lookup that stopped only at cells would walk past the inner binding and read the outer cell.
    // So the walk stops at whichever is innermost and answers nothing where that one is a name.
    in_cell: Buf[bool]

    // Where each open block's names begin in the four lists above.
    blocks: Buf[usize]

    // Whether each open block actually pushed an `EnvObj`.
    //
    // **`scopes` counts the scopes that were PUSHED and nothing else**, which is the invariant every
    // unwind depends on: a `break` out of a loop emits one `PopScope` per level between here and the
    // loop's, and a level that pushed nothing must not be counted or it would pop somebody else's.
    scoped: Buf[bool]

// Where `break` and `continue` have to get back to, and what they have to tidy on the way.
struct LoopFrame
    sp: usize
    scopes: usize

    // How many handlers were owed when the loop began, so a `break` out of a `try` drops its own.
    handlers: usize

    // The name this loop was given, or the empty string. A `break` with no label takes the innermost
    // frame whatever its name; one with a label walks outward until the names agree.
    label: string

    // Instruction positions to patch once the two destinations are known.
    breaks: Buf[usize]
    continues: Buf[usize]

fresh_emit(is_async: bool, is_gen: bool, slotting: bool, cells: bool, kept: Buf[string]) -> Emit =
    Emit(buf(), 0, 0, buf(), 0, is_async, is_gen, slotting, cells, kept, 0, buf(), buf(), buf(), buf(), buf(), buf())

// Open a block, in the code and in the compiler's own record of what is bound here.
//
// **A SLOTTING CHUNK OPENS NO SCOPE AT ALL, and that is where the last of the allocation goes.**
// Nothing in such a chunk declares by name -- every binding form in it takes cells now, and the ones
// that could not are what `may_slot` refuses -- so the `EnvObj` a block used to push would be built,
// written to by nothing, and thrown away. A `for` over a thousand pairs built one a turn.
//
// **The compiler's own record still opens and shuts**, which is what a block MEANS to a slotting
// chunk: `slot_named` walks it backwards and finds the innermost, so a name a loop head bound stops
// being visible where the loop ends and an outer one of the same spelling comes back.
//
// **The two have to move together and that is why this exists rather than a bare `PushScope`.** A
// scope pushed without the matching record would leave the compiler thinking an inner block's names
// were still in view after it ended, and a name resolved to the wrong slot is the one mistake this
// whole arrangement may not make. The unwinding a `break` does is the exception and emits the bare
// op: it leaves scopes it is jumping out of, and the compiler is not leaving them.
// **A MIXED CHUNK OPENS A SCOPE ONLY WHERE THE BLOCK DECLARES A NAME INTO ONE**, which is the same
// finding once more and the last place it was left standing. A chunk keeping its scope for one
// captured name still built an `EnvObj` for every block in it -- a loop body that declares nothing,
// a `for` head whose names are all cells -- and threw it away a turn later. **Skipping it is sound
// because a closure made in such a block captures `vm.scope` and every name that block bound is a
// cell**: if a closure could want one, that name would be kept and the block would push.
//
// **`scoped` is the caller's answer and not this function's**, because what a block binds is known
// where it is compiled and not here. The three `scoped_*` questions below are the only ways to ask.
//
// **The scope COUNT is kept here now rather than by each caller.** It has to be, the two having to
// agree exactly: `unwind_to` and `break` both emit one `PopScope` per counted level, so a level that
// pushed nothing and was counted anyway would pop a scope belonging to somebody else.
open_scope(e: *Emit, at: Span, scoped: bool)
    if scoped
        push_n(e, PushScope, at, 0, 0)
        e.scopes += 1

    e.blocks.push(e.named.len())
    e.scoped.push(scoped)

// Shut the block `open_scope` opened, dropping what it bound.
shut_scope(e: *Emit, at: Span)
    if block_scoped(e)
        push_n(e, PopScope, at, 0, 0)
        e.scopes -= 1

    drop_block(e)

// Whether the innermost open block pushed a scope, for a caller emitting its own matching `PopScope`.
block_scoped(e: *Emit) -> bool = if e.scoped.is_empty() then false else e.scoped.at(e.scoped.len() - 1)

// Forget an open block's names without emitting anything, for a caller that has already put its own
// `PopScope` down.
drop_block(e: *Emit)
    if e.blocks.is_empty() then return

    val back = e.blocks.at(e.blocks.len() - 1)

    e.blocks.truncate(e.blocks.len() - 1)
    e.scoped.truncate(e.scoped.len() - 1)
    e.named.truncate(back)
    e.slot_of.truncate(back)
    e.slot_var.truncate(back)
    e.in_cell.truncate(back)

// Give a name a slot in the block being emitted, answering which one.
//
// **A name declared twice in one block takes a second slot rather than reusing the first.** Nothing
// can reach the old one -- the lookup walks backwards and finds the newer -- and a `var` rebound by
// a second `val` of the same name is two bindings, not one written twice.
claim_slot(e: *Emit, name: string, assignable: bool) -> usize
    val i = e.slots

    e.slots = e.slots + 1
    e.named.push(name)
    e.slot_of.push(i)
    e.slot_var.push(assignable)
    e.in_cell.push(true)
    i

// Record that this block binds a name IN THE SCOPE, so a lookup stops at it.
//
// **Only a chunk that has cells needs this**, and for the one reason: a chunk with no cells at all
// has nothing for a lookup to find by mistake, so recording its names would be a list nobody reads.
note_scope_name(e: *Emit, name: string)
    if !e.cells then return

    e.named.push(name)
    e.slot_of.push(0)
    e.slot_var.push(false)
    e.in_cell.push(false)

// Which slot a name means here, innermost first, or nothing where it is not a cell of this chunk.
//
// **The walk stops at the innermost binding of the name whether or not that one is a cell**, which
// is the shadowing rule and is why a name in the scope has to be recorded as well: stopping only at
// cells would answer about an outer cell a nearer binding had already covered.
slot_named(e: *Emit, name: string) -> Option[usize]
    if e.named.is_empty() then return None

    var i = e.named.len()

    loop
        if i == 0 then return None

        i = i - 1

        if e.named.at(i) == name then return if e.in_cell.at(i) then Some(i) else None

// -- whether a block needs an `EnvObj` of its own -----------------------------------------------------

// **These five are the only ways to answer `open_scope`'s question**, and they all read the same
// three cases: a WHOLE chunk never opens a scope, a chunk with NO cells always does -- nothing about
// it has changed -- and a MIXED chunk opens one exactly where the block declares a name into it.
//
// **A block's own statements are what decide it, and a nested block decides for itself.** A `Group`
// is a flattening rather than a block, so its statements bind here and it is walked into; everything
// else that binds either opens a scope of its own or takes a cell.

// An ordinary block, a lambda's body, a chunk's body.
scoped_block(e: *Emit, stmts: Buf[Stmt]) -> bool
    if e.slotting then return false
    if !e.cells then return true

    block_declares(e, stmts)

// A loop, whose ONE scope holds its head's names and its body's own -- `compile_stmt_body` puts a
// block's statements into the scope already open rather than opening a second.
scoped_loop(e: *Emit, binding: Pattern, body: Expr) -> bool
    if e.slotting then return false
    if !e.cells then return true
    if pattern_declares(e, binding) then return true

    body_declares(e, body)
end scoped_loop

// A loop body with no head of its own.
scoped_body(e: *Emit, body: Expr) -> bool
    if e.slotting then return false
    if !e.cells then return true

    body_declares(e, body)

// A `match` arm, which binds through a pattern before its body runs.
//
// **The BODY is not asked about, where a loop's is.** An arm's body is compiled as an ordinary
// expression, so a block one opens a scope of its own and decides for itself; a loop's body is put
// into the scope already open, `compile_stmt_body` inlining its statements rather than opening a
// second. So the two questions differ, and they differ for that reason alone.
scoped_arm(e: *Emit, pat: Pattern) -> bool
    if e.slotting then return false
    if !e.cells then return true

    pattern_declares(e, pat)

// A `catch`, which binds one name and no pattern.
scoped_catch(e: *Emit, name: string) -> bool
    if e.slotting then return false
    if !e.cells then return true

    !may_cell(e, name)

// An `if` branch, which binds NOTHING of its own.
//
// **That is a claim about the language rather than about this block**, and it is checked: the only
// expression that declares into the scope the machine is standing in is an `is` whose pattern binds,
// and `slot_plan` refuses a chunk holding one outright — so a chunk with cells has none. A branch
// that is a block opens a scope of its own and decides for itself.
scoped_branch(e: *Emit) -> bool = !e.slotting && !e.cells

// Whether any statement of this block declares a name into the scope.
//
// **Exhaustive over `StmtKind` on purpose and it must stay so.** A statement added later that
// declares by name and fell through as harmless would have its `DeclareVal` land in the scope of
// whatever block is open OUTSIDE this one — a binding that outlives its block, silently.
block_declares(e: *Emit, stmts: Buf[Stmt]) -> bool
    for i in 0..<stmts.len()
        if stmt_declares(e, stmts.at(i)) then return true

    false

private stmt_declares(e: *Emit, s: Stmt) -> bool
    *s.kind match
        Val(name, _) -> !may_cell(e, name)
        Var(name, _) -> !may_cell(e, name)
        Unpack(pat, _, _) -> pattern_declares(e, pat)

        // A definition and a type declaration both write their name into the scope by hand --
        // `DefineFn` and a `DeclareVal` after a `PushShape` — and `slot_plan` keeps both names for
        // that reason, so this is the answer those two already gave.
        Def(_, _, _, _, _) -> true
        TypeDecl(_, _) -> true

        // A flattening rather than a block: its statements bind where it stands.
        Group(inner) -> block_declares(e, inner)

        // An import binds by name, and cannot appear in a function anyway. Written out for the
        // reason the rest are.
        ImportNames(_, _, _, _, _) -> true
        ImportAll(_, _, _, _) -> true

        // The statements that bind nothing here. A `for`, a `match`, a `try` and a lambda all bind
        // inside a block of their own, which asks this question again for itself.
        Assign(_, _, _) -> false
        MultiAssign(_, _, _) -> false
        Eval(_) -> false
        Return(_) -> false
        Throw(_) -> false
        Break(_, _) -> false
        Continue(_) -> false
        CheckType(_, _, _) -> false
end stmt_declares

// Whether a block used as a body declares a name into the scope. A body that is not a block is an
// expression, and an expression declares nothing -- see `scoped_branch`.
private body_declares(e: *Emit, body: Expr) -> bool = *body.kind match
    Block(stmts) -> block_declares(e, stmts)
    _ -> false

// Whether a name declared here may take a cell, which is the question every binding site asks.
may_cell(e: *Emit, name: string) -> bool
    if !e.cells then return false

    for i in 0..<e.kept.len()
        if e.kept.at(i) == name then return false

    true
end may_cell

// Whether the name at this index in the lists is one a program may write to.
slot_writable(e: *Emit, i: usize) -> bool = e.slot_var.at(i)

// Put one instruction down and answer where it went.
put(e: *Emit, op: Op, at: Span) -> usize
    e.code.push(Ins(op, at))
    e.code.len() - 1

// Put an instruction down and account for what it does to the stack.
push_n(e: *Emit, op: Op, at: Span, takes: usize, gives: usize) -> usize
    e.sp = e.sp - takes + gives
    put(e, op, at)

here(e: *Emit) -> usize = e.code.len()

// Aim a jump that was emitted before its destination was known.
patch(e: *Emit, at: usize, to: usize)
    val old = e.code.at(at)

    val aimed: Op = old.op match
        Jump(_) -> Jump(to)
        JumpIfFalse(_) -> JumpIfFalse(to)
        JumpIfTrueKeep(_) -> JumpIfTrueKeep(to)
        JumpIfPresentKeep(_) -> JumpIfPresentKeep(to)
        JumpIfAbsentKeep(_) -> JumpIfAbsentKeep(to)
        JumpIfFalseKeep(_) -> JumpIfFalseKeep(to)
        IterNext(_) -> IterNext(to)

        // **A default parameter's jump carries a name as well as a target**, so its arm has to hand
        // the name back. An `other -> other` would have aimed it at instruction zero and re-run the
        // whole body every time an argument WAS given.
        JumpIfBound(k, _) -> JumpIfBound(k, to)
        JumpIfGiven(n, _) -> JumpIfGiven(n, to)
        JumpIfSet(n, _) -> JumpIfSet(n, to)

        // **A handler's target is patched exactly as a jump's is**, and leaving it out of this list
        // was silent: `PushHandler(0)` is a perfectly good instruction naming instruction zero, so a
        // caught fault re-entered the chunk at its first instruction and the program looped until the
        // heap ran out. The `other -> other` arm below is what made it silent.
        PushHandler(_) -> PushHandler(to)
        other -> other

    e.code.set(at, Ins(aimed, old.at))
end patch

// Drop back to a stack height, a scope depth and a handler depth, which is what leaving a block
// means.
unwind_to(e: *Emit, sp: usize, scopes: usize, handlers: usize, at: Span)
    var n = e.sp

    while n > sp
        put(e, Pop, at)
        n -= 1

    // **One `PopScope` per level that PUSHED one.** `scopes` counts nothing else, so this needs no
    // question about the chunk: a whole chunk's count is zero and never moves, and a mixed one's
    // counts only the blocks that declared a name into a scope.
    var d = e.scopes

    while d > scopes
        put(e, PopScope, at)
        d -= 1

    // **A `break` out of a `try` body drops its handler on the way.** Left behind, it would name an
    // instruction in a block nothing is running any more, and the next fault anywhere in the program
    // would be restored into it.
    var k = e.handlers

    while k > handlers
        put(e, PopHandler, at)
        k -= 1
end unwind_to
