module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// Emitting an instruction, and the two counters that make a jump correct.
//
// **Split out of `compile.sysl`, and it is the file the other two both talk to**: `compile.sysl`
// turns statements into instructions and `compile_expr.sysl` turns expressions into them, and
// neither can do anything without `put`, `here` and `patch`. So NOTHING HERE IS `private` -- these
// are the emitter's API rather than its internals, and `private` in sysl is private to the FILE.
//
// The tree to instructions.
//
// **Two counters make this whole file work, and both are compile-time.** `sp` is how many values will
// be on the operand stack when this instruction runs, and `scopes` is how deep the scope chain will
// be. Neither is needed at run time, and knowing both here is what lets `break` emit exactly the
// right number of `Pop`s and `PopScope`s to leave the loop balanced -- rather than the machine
// carrying unwind tables to work it out again.
//
// **Every statement leaves exactly one value on the stack**, and the statement after it begins by
// popping that. A block's value is therefore whatever the last statement left, which is slate's rule,
// and an empty block pushes `null` so the rule holds with nothing in it.

// What one chunk's compilation is carrying.
struct Emit
    code: Buf[Ins]

    // The unit this chunk is being compiled into, and which chunk of it this is.
    //
    // **Both are here for one subject and it is `defs.sysl`'s.** A name a program binds closes a
    // definition of that spelling, and the one place every binding instruction passes through is
    // `put` -- which had no way to reach the unit and say so. A resolved read has to be written down
    // with the chunk it landed in, for the same reason and from the same place.
    unit: *Unit
    chunk: usize

    // Whether this is a file's own top-level chunk, which is where a hoisted definition becomes one
    // a read can be resolved to. Its declarations chunk is one too, both being the file's own level.
    module_top: bool

    // How tall the operand stack will be here.
    sp: usize

    // How deep the scope chain will be here.
    scopes: usize

    // The loops enclosing this point, innermost last.
    loops: Buf[LoopFrame]

    // How many `try` handlers will be owed here.
    //
    // **The third counter, and it exists for the same reason the other two do**: a `break` out of a
    // `try` body has to leave the machine balanced, and the only place the number of handlers to
    // drop is known is here.
    handlers: usize

    // Whether the chunk being compiled is an `async` one, which is what says whether `await` is
    // allowed in it. **A compile-time question rather than a run-time one**: a machine that reached an
    // `await` it could not honour would have to decide what to do with a half-evaluated expression,
    // and there is no good answer -- so the code is never emitted.
    is_async: bool

    // Whether the chunk being emitted is a generator's, which is what tells a `yield` that belongs
    // here from one written where there is nothing to yield to.
    is_gen: bool

    // -- the names this chunk resolved for itself --

    // Whether this chunk needs no `EnvObj` AT ALL: its parameters are cells, no block pushes a
    // scope, and `vm.scope` stays the one its closure captured. False for a module, whose names are
    // read by name from outside it, and for any chunk one of whose own names something outside it
    // can reach.
    //
    // **This is the STRONGER of the two questions and `cells` is the weaker one.** They were one
    // flag while a chunk either slotted everything or nothing; a chunk holding a closure that reads
    // one of its names keeps a scope for that name and puts every other one in a cell, and the two
    // answers come apart there.
    slotting: bool

    // Whether ANY name declared here may take a cell.
    //
    // **A chunk may have cells and still need its scope**, which is the whole of what per-name
    // slotting buys: the names a nested body can reach stay in the chain and everything else moves
    // into the frame. `slotting` implies this; the reverse does not hold.
    cells: bool

    // Whether this chunk holds an `is` whose pattern BINDS, so a block of it can gain a name that
    // reading its statements never reveals.
    //
    // **It is the one binding form left in the scope**, and it is written as an EXPRESSION -- so the
    // `scoped_*` questions, which read a block's statements, cannot see it. A chunk that holds one
    // therefore keeps a scope for every block in it, exactly as every chunk without cells used to;
    // a chunk that holds none is asked the real question and a block declaring nothing pushes
    // nothing.
    //
    // **A chunk WITH cells can never hold one**, `slot_plan` refusing such a chunk outright, so this
    // is `!plan.cells` for a function and the parser's own count for a module -- which is a chunk
    // `slot_plan` is never asked about, every module name being read from outside the file.
    tests_bind: bool

    // The names that may NOT take a cell, however ordinary they look.
    //
    // **Two things put a name here and both are about somebody reading it by NAME.** A nested
    // function reaches it through the scope chain it captured, and a pattern looks a type up by it
    // in the scope the match is running in. Either way a cell would be a second home the reader
    // cannot see, so these keep `LoadName` exactly as they always did.
    //
    // **A name here is kept EVERYWHERE IN THE CHUNK, not only where it was captured**, which is
    // what makes the analysis answerable by reading: a name is a cell or it is not, and no site has
    // to work out which of two bindings of one spelling it is looking at.
    kept: Buf[string]

    // The `JumpIfAbsentKeep`s written by the `?.` chain being compiled, innermost chain last.
    //
    // **A chain has ONE landing and every guard in it jumps there**, which is what makes the guard
    // cover the whole run of links rather than its own: the links after a guard that fired are
    // simply never reached. `compile_chain` remembers the length of this list on the way in and
    // patches everything above that mark on the way out, so a chain written inside another one --
    // a key, an argument -- lands where it belongs and not where its host does.
    chain: Buf[usize]

    // Whether the expression about to be compiled is the NEXT LINK of the chain already open, rather
    // than an expression of its own that may need a chain opening around it.
    //
    // **It is put down at the top of `compile_expr` and picked up only by the link arms**, each of
    // which sets it immediately before walking into its target. So a key, an argument or a receiver
    // written in brackets is off the spine by construction, with nothing to remember to clear.
    in_spine: bool

    // How many slots the chunk reserves at entry, which is the high-water mark rather than the count
    // standing at any moment: a slot is not reused when its block ends, since working out that two
    // blocks cannot both be live is a second analysis and the cells are cheap.
    slots: usize

    // The names bound in this chunk, innermost last, and the slot each was given.
    //
    // **One flat pair of lists with a stack of block boundaries over it**, rather than a list per
    // block: a lookup walks it backwards and finds the innermost, which is the shadowing rule, and a
    // block ending is a truncate.
    named: Buf[string]
    slot_of: Buf[usize]

    // Whether each is a `var`. A write to one that is not says the sentence it always said.
    slot_var: Buf[bool]

    // Whether each is a CELL rather than a name in the scope chain.
    //
    // **A chunk with cells records its scope-bound names here too, and that is not bookkeeping for
    // its own sake.** A binding site whose pattern holds one kept name puts the WHOLE pattern in the
    // scope, so an inner block can bind by name a spelling an outer block put in a cell -- and a
    // lookup that stopped only at cells would walk past the inner binding and read the outer cell.
    // So the walk stops at whichever is innermost and answers nothing where that one is a name.
    in_cell: Buf[bool]

    // Where each open block's names begin in the four lists above.
    blocks: Buf[usize]

    // The postconditions this chunk declared, in the order they were written.
    //
    // **Recorded rather than compiled where they stand**, because a `return` is a jump and the only
    // place to get in front of one is where it is emitted. The way a body FALLS OUT is the parser's,
    // which is why nothing here has to find the end of the body.
    ensures: Buf[Stmt]

    // What `-> type` on this chunk said, and the pattern it stands for.
    //
    // **A `return` answers as much as falling out does**, and the wrapper the parser puts around the
    // body only reaches the second: it wraps an expression, and a `return` jumps past it. So the
    // pattern is recorded on the way in and every `return` is checked against it too.
    result_declared: string
    result_pat: Option[Pattern]

    // Whether each open block actually pushed an `EnvObj`.
    //
    // **`scopes` counts the scopes that were PUSHED and nothing else**, which is the invariant every
    // unwind depends on: a `break` out of a loop emits one `PopScope` per level between here and the
    // loop's, and a level that pushed nothing must not be counted or it would pop somebody else's.
    scoped: Buf[bool]

    // Whether what is being compiled stands inside a loop's body, and therefore inside a cycle that
    // already carries a safe point at its top. See `safe_point` below.
    in_loop: bool

    // The resources this point stands inside, outermost first.
    //
    // **The fourth counter, and it is a list rather than a number because a way out has to RUN
    // something.** `sp`, `scopes` and `handlers` say how much to undo; a disposal says what to call,
    // and where the value to call it on is sitting. Every exit a block has -- falling off its end, a
    // `return`, a `break`, a `continue` -- reads this and emits the calls in reverse before it
    // unwinds anything.
    disposes: Buf[DisposeSite]
    // Whether each SLOT, by number, can never hold an absence -- true only for a slot `declare_name`
    // filled, whose `DeclareSlot` and every later `StoreSlot` refuse `undefined`.
    //
    // **By slot and not by name**, because a slot is never reused, so nothing has to be taken off
    // this when a block ends. A parameter's slot says no: a parameter nobody gave reads as the
    // absence `lay_frame` padded it with. A pattern's slots say no too, not having been asked.
    // `never_absent` in `compile_expr.sysl` is the reader.
    sure: Buf[bool]

// One live `using`: which handler is its own, and where its resource sits on the operand stack.
struct DisposeSite
    // The handler depth this resource's own `PushDispose` established, counted from one. A way out
    // that unwinds to handler depth `h` releases every site above `h` and leaves the rest alone.
    handlers: usize

    // The stack index the resource was left at. **A copy of the value, not the name it was bound
    // to**: a `using` may bind a pattern, and there is no one name to read back -- so the value is
    // duplicated where it is acquired and the copy is what every disposal reaches for.
    slot: usize

// Where `break` and `continue` have to get back to, and what they have to tidy on the way.
struct LoopFrame
    sp: usize
    scopes: usize

    // How many handlers were owed when the loop began, so a `break` out of a `try` drops its own.
    handlers: usize

    // The name this loop was given, or the empty string. A `break` with no label takes the innermost
    // frame whatever its name; one with a label walks outward until the names agree.
    label: string

    // Instruction positions to patch once the two destinations are known.
    breaks: Buf[usize]
    continues: Buf[usize]

fresh_emit(u: *Unit, chunk: usize, module_top: bool, is_async: bool, is_gen: bool, slotting: bool, cells: bool, tests_bind: bool, kept: Buf[string]) -> Emit =
    Emit(buf(), u, chunk, module_top, 0, 0, buf(), 0, is_async, is_gen, slotting, cells, tests_bind, kept, buf(), false, 0, buf(), buf(), buf(), buf(), buf(), buf(), "", None, buf(), false, buf(), buf())

// Open a block, in the code and in the compiler's own record of what is bound here.
//
// **A SLOTTING CHUNK OPENS NO SCOPE AT ALL, and that is where the last of the allocation goes.**
// Nothing in such a chunk declares by name -- every binding form in it takes cells now, and the ones
// that could not are what `may_slot` refuses -- so the `EnvObj` a block used to push would be built,
// written to by nothing, and thrown away. A `for` over a thousand pairs built one a turn.
//
// **The compiler's own record still opens and shuts**, which is what a block MEANS to a slotting
// chunk: `slot_named` walks it backwards and finds the innermost, so a name a loop head bound stops
// being visible where the loop ends and an outer one of the same spelling comes back.
//
// **The two have to move together and that is why this exists rather than a bare `PushScope`.** A
// scope pushed without the matching record would leave the compiler thinking an inner block's names
// were still in view after it ended, and a name resolved to the wrong slot is the one mistake this
// whole arrangement may not make. The unwinding a `break` does is the exception and emits the bare
// op: it leaves scopes it is jumping out of, and the compiler is not leaving them.
// **A MIXED CHUNK OPENS A SCOPE ONLY WHERE THE BLOCK DECLARES A NAME INTO ONE**, which is the same
// finding once more and the last place it was left standing. A chunk keeping its scope for one
// captured name still built an `EnvObj` for every block in it -- a loop body that declares nothing,
// a `for` head whose names are all cells -- and threw it away a turn later. **Skipping it is sound
// because a closure made in such a block captures `vm.scope` and every name that block bound is a
// cell**: if a closure could want one, that name would be kept and the block would push.
//
// **`scoped` is the caller's answer and not this function's**, because what a block binds is known
// where it is compiled and not here. The three `scoped_*` questions below are the only ways to ask.
//
// **The scope COUNT is kept here now rather than by each caller.** It has to be, the two having to
// agree exactly: `unwind_to` and `break` both emit one `PopScope` per counted level, so a level that
// pushed nothing and was counted anyway would pop a scope belonging to somebody else.
open_scope(e: *Emit, at: Span, scoped: bool)
    if scoped
        push_n(e, PushScope, at, 0, 0)
        e.scopes += 1

    e.blocks.push(e.named.len())
    e.scoped.push(scoped)

// Shut the block `open_scope` opened, dropping what it bound.
shut_scope(e: *Emit, at: Span)
    if block_scoped(e)
        push_n(e, PopScope, at, 0, 0)
        e.scopes -= 1

    drop_block(e)

// Whether the innermost open block pushed a scope, for a caller emitting its own matching `PopScope`.
block_scoped(e: *Emit) -> bool = if e.scoped.is_empty() then false else e.scoped.at(e.scoped.len() - 1)

// Forget an open block's names without emitting anything, for a caller that has already put its own
// `PopScope` down.
drop_block(e: *Emit)
    if e.blocks.is_empty() then return

    val back = e.blocks.at(e.blocks.len() - 1)

    e.blocks.truncate(e.blocks.len() - 1)
    e.scoped.truncate(e.scoped.len() - 1)
    e.named.truncate(back)
    e.slot_of.truncate(back)
    e.slot_var.truncate(back)
    e.in_cell.truncate(back)

// Give a name a slot in the block being emitted, answering which one.
//
// **A name declared twice in one block takes a second slot rather than reusing the first.** Nothing
// can reach the old one -- the lookup walks backwards and finds the newer -- and a `var` rebound by
// a second `val` of the same name is two bindings, not one written twice.
claim_slot(e: *Emit, name: string, assignable: bool) -> usize
    shadowed_name(e.unit, name)

    val i = e.slots

    e.slots = e.slots + 1
    e.named.push(name)
    e.slot_of.push(i)
    e.slot_var.push(assignable)
    e.in_cell.push(true)
    e.sure.push(false)
    i

// Record that this block binds a name IN THE SCOPE, so a lookup stops at it.
//
// **Only a chunk that has cells needs this**, and for the one reason: a chunk with no cells at all
// has nothing for a lookup to find by mistake, so recording its names would be a list nobody reads.
note_scope_name(e: *Emit, name: string)
    // **Said before the early return**, which is the whole of what a chunk with no cells at all still
    // owes: its names are bound by name and shadow a definition of the same spelling exactly as any
    // other binding does.
    shadowed_name(e.unit, name)

    if !e.cells then return

    e.named.push(name)
    e.slot_of.push(0)
    e.slot_var.push(false)
    e.in_cell.push(false)

// Which slot a name means here, innermost first, or nothing where it is not a cell of this chunk.
//
// **The walk stops at the innermost binding of the name whether or not that one is a cell**, which
// is the shadowing rule and is why a name in the scope has to be recorded as well: stopping only at
// cells would answer about an outer cell a nearer binding had already covered.
slot_named(e: *Emit, name: string) -> Option[usize]
    if e.named.is_empty() then return None

    var i = e.named.len()

    loop
        if i == 0 then return None

        i = i - 1

        if e.named.at(i) == name then return if e.in_cell.at(i) then Some(i) else None

// -- whether a block needs an `EnvObj` of its own -----------------------------------------------------

// **These five are the only ways to answer `open_scope`'s question**, and they all read the same
// three cases: a WHOLE chunk never opens a scope, a chunk holding a BINDING `is` always does, and
// every other chunk opens one exactly where the block declares a name into it.
//
// **THE MIDDLE CASE IS THE ONE THING A BLOCK'S STATEMENTS CANNOT ANSWER.** `v is n` binds `n` into
// the scope the match is running in, and it is written as an expression -- so `block_declares`,
// which reads statements, would say nothing about it and the binding would land one block further
// out. `Emit.tests_bind` is the chunk-wide answer, and a chunk carrying one keeps every scope it
// used to keep.
//
// **It used to be `!e.cells`, which is why a MODULE-level loop allocated a scope per turn.** A
// module keeps every name in its scope, so it has no cells -- and the shortcut read that as "this
// chunk cannot be asked" rather than as "this chunk binds by name", pushing an `EnvObj` for a loop
// body that declares nothing at all, six million times in `bench/globals.sl`.
//
// **A block's own statements are what decide it, and a nested block decides for itself.** A `Group`
// is a flattening rather than a block, so its statements bind here and it is walked into; everything
// else that binds either opens a scope of its own or takes a cell.

// An ordinary block, a lambda's body, a chunk's body.
scoped_block(e: *Emit, stmts: Buf[Stmt]) -> bool
    if e.slotting then return false
    if e.tests_bind then return true

    block_declares(e, stmts)

// A loop, whose ONE scope holds its head's names and its body's own -- `compile_stmt_body` puts a
// block's statements into the scope already open rather than opening a second.
scoped_loop(e: *Emit, binding: Pattern, body: Expr) -> bool
    if e.slotting then return false
    if e.tests_bind then return true
    if pattern_declares(e, binding) then return true

    body_declares(e, body)
end scoped_loop

// A loop body with no head of its own.
scoped_body(e: *Emit, body: Expr) -> bool
    if e.slotting then return false
    if e.tests_bind then return true

    body_declares(e, body)

// A `match` arm, which binds through a pattern before its body runs.
//
// **The BODY is not asked about, where a loop's is.** An arm's body is compiled as an ordinary
// expression, so a block one opens a scope of its own and decides for itself; a loop's body is put
// into the scope already open, `compile_stmt_body` inlining its statements rather than opening a
// second. So the two questions differ, and they differ for that reason alone.
scoped_arm(e: *Emit, pat: Pattern) -> bool
    if e.slotting then return false
    if e.tests_bind then return true

    pattern_declares(e, pat)

// A `catch`, which binds one name and no pattern.
//
// **`tests_bind` is not asked here and does not need to be**: a `catch` binds, so a chunk that keeps
// its names by name pushes for it either way -- `may_cell` answers false wherever there are no cells.
scoped_catch(e: *Emit, name: string) -> bool
    if e.slotting then return false

    !may_cell(e, name)

// An `if` branch, which binds NOTHING of its own.
//
// **That is a claim about the language rather than about this block**, and it is checked: the only
// expression that declares into the scope the machine is standing in is an `is` whose pattern binds,
// which is exactly what `tests_bind` counts. A branch that is a block opens a scope of its own and
// decides for itself.
scoped_branch(e: *Emit) -> bool = !e.slotting && e.tests_bind

// Whether any statement of this block declares a name into the scope.
//
// **Exhaustive over `StmtKind` on purpose and it must stay so.** A statement added later that
// declares by name and fell through as harmless would have its `DeclareVal` land in the scope of
// whatever block is open OUTSIDE this one — a binding that outlives its block, silently.
block_declares(e: *Emit, stmts: Buf[Stmt]) -> bool
    for i in 0..<stmts.len()
        if stmt_declares(e, stmts.at(i)) then return true

    false

private stmt_declares(e: *Emit, s: Stmt) -> bool
    *s.kind match
        Val(name, _) -> !may_cell(e, name)
        Var(name, _) -> !may_cell(e, name)
        Unpack(pat, _, _) -> pattern_declares(e, pat)

        // A `using` declares what its binding declares; the disposal is not a name.
        Using(bind, _) -> stmt_declares(e, bind)

        // A definition and a type declaration both write their name into the scope by hand --
        // `DefineFn` and a `DeclareVal` after a `PushShape` — and `slot_plan` keeps both names for
        // that reason, so this is the answer those two already gave.
        Def(_, _, _, _, _) -> true
        TypeDecl(_, _) -> true

        // An external declares its name by hand too -- a `DeclareVal` after a `PushExternal`.
        ExternalDecl(_, _) -> true

        // A flattening rather than a block: its statements bind where it stands.
        Group(inner) -> block_declares(e, inner)

        // An import binds by name, and cannot appear in a function anyway. Written out for the
        // reason the rest are.
        ImportNames(_, _, _, _, _) -> true
        ImportAll(_, _, _, _) -> true
        ImportAsset(_, _, _) -> true

        // The statements that bind nothing here. A `for`, a `match`, a `try` and a lambda all bind
        // inside a block of their own, which asks this question again for itself.
        Assign(_, _, _) -> false
        MultiAssign(_, _, _) -> false
        Eval(_) -> false
        Return(_) -> false
        Throw(_) -> false
        Break(_, _) -> false
        Continue(_) -> false
        CheckType(_, _, _) -> false
        Clause(_, _, _, _, _) -> false
end stmt_declares

// Whether a block used as a body declares a name into the scope. A body that is not a block is an
// expression, and an expression declares nothing -- see `scoped_branch`.
private body_declares(e: *Emit, body: Expr) -> bool = *body.kind match
    Block(stmts) -> block_declares(e, stmts)
    _ -> false

// Whether a name declared here may take a cell, which is the question every binding site asks.
may_cell(e: *Emit, name: string) -> bool
    if !e.cells then return false

    for i in 0..<e.kept.len()
        if e.kept.at(i) == name then return false

    true
end may_cell

// Whether the name at this index in the lists is one a program may write to.
slot_writable(e: *Emit, i: usize) -> bool = e.slot_var.at(i)

// Put one instruction down and answer where it went.
//
// **A NAME AN INSTRUCTION BINDS OR WRITES IS A NAME NO LONGER RESOLVABLE TO A DEFINITION**, and it is
// said here rather than at the dozen places that emit one: an import, a class, a `type`, an
// `external` and a default all bind by hand, and a list of them is a list that goes out of date
// silently. The three bindings with no instruction of their own -- a parameter, a cell, a pattern's
// names -- say it where they are claimed instead. `defs.sysl` is the subject.
put(e: *Emit, op: Op, at: Span) -> usize
    op match
        DeclareVal(k) -> shadowed_name(e.unit, e.unit.strings.at(k))
        DeclareVar(k) -> shadowed_name(e.unit, e.unit.strings.at(k))
        DeclareAbsent(k) -> shadowed_name(e.unit, e.unit.strings.at(k))
        StoreName(k) -> shadowed_name(e.unit, e.unit.strings.at(k))
        DefineFn(k, _) -> shadowed_name(e.unit, e.unit.strings.at(usize(k)))
        _ -> ()

    e.code.push(Ins(op, at))
    e.code.len() - 1

// Put an instruction down and account for what it does to the stack.
push_n(e: *Emit, op: Op, at: Span, takes: usize, gives: usize) -> usize
    e.sp = e.sp - takes + gives
    put(e, op, at)

here(e: *Emit) -> usize = e.code.len()

// **A SAFE POINT: `Tick`, WHICH IS WHERE THE COLLECTOR IS ASKED WHETHER IT IS TIME AND WHERE A
// HEAP THAT HAS OUTGROWN ITS CEILING IS REPORTED AGAINST A LINE.** It computes nothing and leaves
// the stack exactly as it found it, so it may stand anywhere an instruction may.
//
// **A STATEMENT INSIDE A LOOP'S BODY NEEDS NONE, AND THAT IS THE WHOLE OF WHAT MOVED.** One stood in
// front of every statement in the language, and a statement in a loop is the only kind that runs
// more than once for having been written once: a body of six statements asked the collector six
// times a turn where the turn itself is the thing that repeats. So the body's statements give theirs
// up and the loop carries ONE at its top -- which bounds a turn's allocation by the body's own text,
// exactly as a run of statements outside a loop is bounded by the program's.
//
// **A STATEMENT OUTSIDE A LOOP KEEPS ITS OWN, AND THAT IS NOT SYMMETRY -- IT IS WHAT MAKES A NAMED
// HEAP CEILING MEAN ANYTHING.** `heap_limit` is read here and nowhere else, so a straight run of
// statements with no safe point in it may allocate past the ceiling it was given and finish: `val b
// = toBytes("x".repeat(4194304))` in an actor holding a megabyte is two statements and no loop.
// Such a statement costs one `Tick` per time it is REACHED, which for code outside a loop is once,
// so the saving would be nothing and the guarantee is real.
//
// **AND A CHUNK WHOSE BODY IS ONE EXPRESSION GETS ONE AT ITS HEAD**, written by `compile_chunk`,
// because such a body never goes through `compile_stmts` and so had none at all -- a recursion
// through `down(n) = n > 0 && down(n - 1)` or through a lambda could run to any depth without the
// collector being asked once. So the rule reads: **every chunk passes a safe point before it can
// recurse.** A block-bodied chunk takes nothing extra, its first statement's being that safe point.
safe_point(e: *Emit, at: Span) = push_n(e, Tick, at, 0, 0)

// A safe point for a statement, which is owed only where the statement is not already inside a
// loop's cycle.
statement_safe_point(e: *Emit, at: Span)
    if !e.in_loop then safe_point(e, at)

// Compile a loop's body with its statements' safe points given up to the loop's own, and put the
// flag back -- a loop may stand inside a block that is not one.
//
// **It is LEXICAL and it reaches into every block inside the body**, which is the point: a branch, a
// `match` arm or a `try` written in a loop body is inside the same cycle and bounded by the same
// text. A `Lambda` or a `Def` in there is not, and needs nothing said about it -- it compiles into a
// chunk of its own with an `Emit` of its own.
entering_loop_body(e: *Emit) -> bool
    val was = e.in_loop

    e.in_loop = true
    was

leaving_loop_body(e: *Emit, was: bool)
    e.in_loop = was

// Aim a jump that was emitted before its destination was known.
patch(e: *Emit, at: usize, to: usize)
    val old = e.code.at(at)

    val aimed: Op = old.op match
        Jump(_) -> Jump(to)
        JumpIfFalse(_) -> JumpIfFalse(to)
        JumpIfTrueKeep(_) -> JumpIfTrueKeep(to)
        JumpIfPresentKeep(_) -> JumpIfPresentKeep(to)
        JumpIfAbsentKeep(_) -> JumpIfAbsentKeep(to)
        JumpIfFalseKeep(_) -> JumpIfFalseKeep(to)
        IterNext(_) -> IterNext(to)

        // **A default parameter's jump carries a name as well as a target**, so its arm has to hand
        // the name back. An `other -> other` would have aimed it at instruction zero and re-run the
        // whole body every time an argument WAS given.
        JumpIfBound(k, _) -> JumpIfBound(k, u32(to))
        JumpIfGiven(n, _) -> JumpIfGiven(n, u32(to))
        JumpIfSet(n, _) -> JumpIfSet(n, u32(to))

        // **A handler's target is patched exactly as a jump's is**, and leaving it out of this list
        // was silent: `PushHandler(0)` is a perfectly good instruction naming instruction zero, so a
        // caught fault re-entered the chunk at its first instruction and the program looped until the
        // heap ran out. The `other -> other` arm below is what made it silent.
        PushHandler(_) -> PushHandler(to)

        // A disposal handler's target is aimed exactly as a `catch`'s is, and for the reason above.
        PushDispose(_) -> PushDispose(to)
        other -> other

    e.code.set(at, Ins(aimed, old.at))
end patch

// -- fusing adjacent instructions ------------------------------------------------------------------

// Run over a finished chunk and replace each fusable PAIR's FIRST instruction with the one
// superinstruction that does both.
//
// **THE SECOND INSTRUCTION IS LEFT EXACTLY WHERE IT WAS, AND EVERYTHING ELSE ABOUT THIS PASS FOLLOWS
// FROM THAT.** The obvious peephole deletes what it folds away and renumbers every jump, every
// handler target, every `IterNext` and every site `defs.sysl` recorded by position -- and is wrong
// the moment one of them is missed. This one writes one slot and moves no index at all, so:
//
// - **a jump into the middle of a pair is not merely legal, it is UNCHANGED.** A loop head, a
//   `catch`, an arm's target or a default's guard that aims at the second instruction runs the very
//   instruction the emitter wrote and computes what it always computed. There is nothing to prove
//   about jump targets and no set of them to gather, which is the whole reason the pass is safe to
//   write at all;
// - **`Handler`'s recorded stack height stays right**, a fused pair leaving the stack exactly where
//   the two left it;
// - **`settle_module_defs`' put-back stays right**, it writing `LoadName` over a `LoadDef` at a
//   remembered position. **No fusion below may name `LoadDef` at either end** -- as a head its slot
//   would be overwritten and the put-back would land on the superinstruction, and as a tail it would
//   be a resolved read the fused arm stepped over. The `match` here is the enforcement: every head
//   and every tail is written out, and neither list has `LoadDef` in it.
//
// **It runs after every `patch`**, on the code as it is handed to the chunk, so no jump is aimed at
// a fused instruction after the fact and `patch` needs no arm for one.
//
// **The scan does not overlap.** A fused pair advances by two, so a run of three loads becomes one
// `LoadSlot2` and one plain `LoadSlot` rather than two overlapping pairs -- which is what keeps the
// tail of one fusion from being the head of the next, where the head is a slot this pass has just
// overwritten.
fuse(code: Buf[Ins]) -> Buf[Ins]
    var out = code
    var p: usize = 0

    while p + 1 < out.len()
        val first = out.at(p)

        // **A run is tried before a pair**, a run's first two slots being a pair's too.
        val run = fused_run(&out, p)

        if run > 0
            p += run
            continue

        val joined: Option[Op] = first.op match
            // **A pair does not take the head of a run that begins in its second slot.**
            // `m.set(i % 1000, v)` is `LoadSlot(m); LoadSlot(i); PushInt; Rem`, and pairing the two
            // loads leaves the literal and the remainder two dispatches of their own, where leaving
            // the first load alone lets `SlotIntRem` take the other three.
            LoadSlot(i) -> out.at(p + 1).op match
                LoadSlot(j) -> if slot_rem_at(&out, p + 1) then None else Some(LoadSlot2(u32(i), u32(j)))

                // **A LITERAL WIDER THAN THIRTY-TWO BITS IS NOT FUSED, AND THAT IS THE WHOLE OF THE
                // RESTRICTION.** An instruction's payload is eight bytes, so a slot and a whole
                // 64-bit literal do not both fit in one; the pair stays two instructions and runs
                // exactly as it always did. `x + 1` is what this fusion is for and no program writes
                // `x + 4294967296` in a loop.
                PushInt(v) -> if v >= -2147483648 && v <= 2147483647 then Some(LoadSlotInt(u32(i), int(v))) else None
                GetField(k, c) -> if i <= 65535 && c <= 65535 then Some(LoadSlotGetField(u16(i), u16(c), k)) else None
                _ -> None
            Add -> out.at(p + 1).op match
                StoreSlot(i) -> Some(AddStoreSlot(i))
                StoreCell(d, k) -> Some(AddStoreCell(d, k))
                _ -> None

            // **A product summed into a local is left to `AddStoreSlot`** (or into a module-level
            // `var`, to `AddStoreCell`), which writes without pushing -- so `Mul; Add; StoreSlot`
            // stays two instructions either way, and the one that skips a push and a pop is kept.
            Mul -> out.at(p + 1).op match
                Add -> if p + 2 < out.len() && fusing_store(out.at(p + 2).op) then None else Some(MulAdd)
                _ -> None
            TestSlots(k, first) -> out.at(p + 1).op match
                JumpIfFalse(_) -> Some(TestSlotsJumpIfFalse(k, first))
                _ -> None

            // **A cell read is put back to `LoadName` where the file's name turns out to be bound by
            // something else**, and `settle_module_defs` knows this form: it writes the `LoadName`
            // over it, and the `PushInt` standing behind is what runs next, exactly as unfused.
            LoadCell(d, k) -> out.at(p + 1).op match
                PushInt(v) ->
                    if d <= 65535 && k <= 65535 && v >= -2147483648 && v <= 2147483647
                        Some(LoadCellInt(u16(d), u16(k), i32(v)))
                    else
                        None
                _ -> None
            Sub -> out.at(p + 1).op match
                StoreSlot(i) -> Some(SubStoreSlot(i))
                StoreCell(d, k) -> Some(SubStoreCell(d, k))
                _ -> None
            Less -> out.at(p + 1).op match
                JumpIfFalse(to) -> Some(LessJumpIfFalse(to))
                _ -> None

            // **A call whose answer is only discarded is MARKED, not replaced** -- `AnswerUnused` in
            // `code.sysl`. The `Discard` stays where it is: a builtin steps over it and every other
            // callee returns to it.
            CallFn(argc, names) -> out.at(p + 1).op match
                Discard -> Some(CallFn(argc | AnswerUnused, names))
                _ -> None
            CallMethod(argc, w) -> out.at(p + 1).op match
                Discard -> Some(CallMethod(argc | AnswerUnused, w))
                _ -> None
            _ -> None

        joined match
            None -> p += 1

            // **The FIRST instruction's span is kept**, which is the one that can fault in three of
            // the four; `AddStoreSlot` is the exception and reads the store's own span out of the
            // slot below when it needs it.
            Some(op) ->
                // A local's field faults at the field, the load in front of it never faulting.
                val at = op match
                    LoadSlotGetField(_, _, _) -> out.at(p + 1).at
                    _ -> first.at

                out.set(p, Ins(op, at))
                p += 2

    out
end fuse

// A fused RUN beginning at `p` -- a loop's head or a loop's tail, or a local's remainder by a
// literal -- written over its first slot, answering how many slots it covers, or zero where none
// begins here.
//
// **The run's inner pair is folded where it stands as well**, so a jump that lands inside the run
// finds the pair form rather than the two unfused instructions -- and a pair steps over only what
// it covers, so what runs from there is what the unfused slots would have run. No `LoadDef` is
// named here either, for `fuse`'s reason.
fused_run(out: *Buf[Ins], p: usize) -> usize
    val five = p + 4 < out.len()

    // **A safe point is NOT folded into what follows it** unless that is a counted loop's head:
    // `Tick; LoadSlot`, `Tick; LoadSlot; LoadSlot` and a `for`'s `Tick; IterNext` were all built as
    // runs of their own and measured nothing (`bench/results/2026-09-23-superinstructions-3.md`).
    out.at(p).op match
        Tick ->
            if !five then return 0

            val slot = fused_loop_head(out, p)

            if slot > 0 then slot else fused_cell_loop_head(out, p)
        LoadSlot(i) ->
            val tail = if five then fused_loop_tail(out, p, i) else 0

            if tail > 0 then tail else fused_slot_rem(out, p, i)
        LoadCell(d, _) -> if five then fused_cell_loop_tail(out, p, d) else 0
        _ -> 0

// `LoadSlot(i); PushInt(v); Rem`, three slots, where the literal fits thirty-two bits.
fused_slot_rem(out: *Buf[Ins], p: usize, i: usize) -> usize
    if !slot_rem_at(out, p) then return 0

    val v = fusing_int(out.at(p + 1).op)

    // **The `Rem`'s span**, the division by zero being the one fault the three can raise.
    out.set(p, Ins(SlotIntRem(u32(i), int(v.unwrap())), out.at(p + 2).at))
    3
end fused_slot_rem

// Whether `fused_slot_rem` would fold the run at `p`, asked without folding it.
slot_rem_at(out: *Buf[Ins], p: usize) -> bool
    if p + 2 >= out.len() then return false

    val i = out.at(p).op match
        LoadSlot(i) -> i
        _ -> return false

    if i > 4294967295 then return false

    val v = fusing_int(out.at(p + 1).op)
    val rem = out.at(p + 2).op match
        Rem -> true
        _ -> false

    rem && v.is_some() && v.unwrap() >= -2147483648 && v.unwrap() <= 2147483647
end slot_rem_at

// `Tick; LoadSlot(i); PushInt(v); Less; JumpIfFalse(to)`. Its inner pairs are the `LoadSlotInt` at
// `p + 1` and the `LessJumpIfFalse` at `p + 3`.
fused_loop_head(out: *Buf[Ins], p: usize) -> usize
    val i = fusing_slot_read(out.at(p + 1).op)
    val v = fusing_int(out.at(p + 2).op)
    val to = fusing_false_jump(out.at(p + 4).op)
    val less = out.at(p + 3).op match
        Less -> true
        _ -> false

    if !less || i.is_none() || v.is_none() || to.is_none() then return 0
    if i.unwrap() > 4294967295 || v.unwrap() < -2147483648 || v.unwrap() > 2147483647 then return 0

    val slot = u32(i.unwrap())
    val lit = int(v.unwrap())

    out.set(p, Ins(TickSlotIntLess(slot, lit), out.at(p).at))
    out.set(p + 1, Ins(LoadSlotInt(slot, lit), out.at(p + 1).at))
    out.set(p + 3, Ins(LessJumpIfFalse(to.unwrap()), out.at(p + 3).at))
    5
end fused_loop_head

// `LoadSlot(i); PushInt(v); Add; StoreSlot(i); Jump(to)`, the one slot read and written. Its inner
// pair is the `AddStoreSlot` at `p + 2`.
//
// **A sum into a local followed by the back edge is NOT a run of its own**, though it was the
// heaviest pair left: `Add; StoreSlot; Jump` folded alone measured -0.35% of the geometric mean over
// the four programs that run it -- `loops` -6.6%, and `arrays` +3.0%, `csv` +1.5%, `nested` +1.2% --
// which is no answer, and an arm in the dispatch is not free.
// `bench/results/2026-09-23-superinstructions-2.md` has the run.
fused_loop_tail(out: *Buf[Ins], p: usize, i: usize) -> usize
    val v = fusing_int(out.at(p + 1).op)
    val stored = fusing_slot_written(out.at(p + 3).op)
    val to = fusing_jump(out.at(p + 4).op)
    val add = out.at(p + 2).op match
        Add -> true
        _ -> false

    if !add || v.is_none() || to.is_none() || stored.is_none() || stored.unwrap() != i then return 0
    if i > 65535 || v.unwrap() < -32768 || v.unwrap() > 32767 || to.unwrap() > 4294967295 then return 0

    out.set(p, Ins(SlotIntAddStoreJump(u16(i), i16(v.unwrap()), u32(to.unwrap())), out.at(p).at))
    out.set(p + 2, Ins(AddStoreSlot(i), out.at(p + 2).at))
    5
end fused_loop_tail

// `Tick; LoadCell(d, k); PushInt(v); Less; JumpIfFalse(to)`: `fused_loop_head` over a module-level
// `var`. Its inner pairs are the `LoadCellInt` at `p + 1`, which is where the arm reads the spelling
// an empty cell falls back to, and the `LessJumpIfFalse` at `p + 3`.
fused_cell_loop_head(out: *Buf[Ins], p: usize) -> usize
    val v = fusing_int(out.at(p + 2).op)
    val to = fusing_false_jump(out.at(p + 4).op)
    val less = out.at(p + 3).op match
        Less -> true
        _ -> false

    if !less || v.is_none() || to.is_none() then return 0

    val lit = v.unwrap()

    if lit < -2147483648 || lit > 2147483647 then return 0

    out.at(p + 1).op match
        LoadCell(d, k) ->
            if d > 65535 || k > 65535 then return 0

            out.set(p, Ins(TickCellIntLess(d, int(lit)), out.at(p).at))
            out.set(p + 1, Ins(LoadCellInt(u16(d), u16(k), i32(lit)), out.at(p + 1).at))
            out.set(p + 3, Ins(LessJumpIfFalse(to.unwrap()), out.at(p + 3).at))
            5
        _ -> 0
end fused_cell_loop_head

// `LoadCell(d, k); PushInt(v); Add; StoreCell(d, k); Jump(to)`, one module-level `var` read and
// written: `fused_loop_tail` over a cell. The arm reads the spelling out of the `StoreCell` at
// `p + 3`; its inner pair is the `AddStoreCell` at `p + 2`.
fused_cell_loop_tail(out: *Buf[Ins], p: usize, d: u32) -> usize
    val v = fusing_int(out.at(p + 1).op)
    val to = fusing_jump(out.at(p + 4).op)
    val add = out.at(p + 2).op match
        Add -> true
        _ -> false
    val k = out.at(p + 3).op match
        StoreCell(e, key) -> if e == d then Some(key) else None
        _ -> None

    if !add || v.is_none() || to.is_none() || k.is_none() then return 0
    if d > 65535 || v.unwrap() < -32768 || v.unwrap() > 32767 || to.unwrap() > 4294967295 then return 0

    out.set(p, Ins(CellIntAddStoreJump(u16(d), i16(v.unwrap()), u32(to.unwrap())), out.at(p).at))
    out.set(p + 2, Ins(AddStoreCell(d, k.unwrap()), out.at(p + 2).at))
    5
end fused_cell_loop_tail

// What one instruction carries, where it is the kind a run wants and `None` where it is not.
fusing_slot_read(op: Op) -> Option[usize] = op match
    LoadSlot(i) -> Some(i)
    _ -> None

fusing_slot_written(op: Op) -> Option[usize] = op match
    StoreSlot(i) -> Some(i)
    _ -> None

// Whether an instruction is a write that `Add` folds into: a local's or a module-level `var`'s.
fusing_store(op: Op) -> bool = op match
    StoreSlot(_) -> true
    StoreCell(_, _) -> true
    _ -> false

fusing_int(op: Op) -> Option[long] = op match
    PushInt(v) -> Some(v)
    _ -> None

fusing_jump(op: Op) -> Option[usize] = op match
    Jump(to) -> Some(to)
    _ -> None

fusing_false_jump(op: Op) -> Option[usize] = op match
    JumpIfFalse(to) -> Some(to)
    _ -> None

// Drop back to a stack height, a scope depth and a handler depth, which is what leaving a block
// means.
unwind_to(e: *Emit, sp: usize, scopes: usize, handlers: usize, at: Span)
    var n = e.sp

    while n > sp
        put(e, Pop, at)
        n -= 1

    // **One `PopScope` per level that PUSHED one.** `scopes` counts nothing else, so this needs no
    // question about the chunk: a whole chunk's count is zero and never moves, and a mixed one's
    // counts only the blocks that declared a name into a scope.
    var d = e.scopes

    while d > scopes
        put(e, PopScope, at)
        d -= 1

    // **A `break` out of a `try` body drops its handler on the way.** Left behind, it would name an
    // instruction in a block nothing is running any more, and the next fault anywhere in the program
    // would be restored into it.
    var k = e.handlers

    while k > handlers
        put(e, PopHandler, at)
        k -= 1
end unwind_to
