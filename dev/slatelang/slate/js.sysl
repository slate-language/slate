module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{split, str_builder, StrBuilder}

// The tree as JavaScript.
//
// **A second back end beside the machine, taking the same tree the interpreter walks.** `compile.sysl`
// turns a `Program` into instructions for `execute.sysl`; this turns the same `Program` into text a
// JavaScript engine runs. Nothing is shared between the two but the tree, which is the point: a
// second reading of the tree is what says whether the tree means one thing.
//
// **Every operator goes through the runtime rather than JavaScript's own, and that is not caution.**
// The two languages disagree about the answer often enough that the exceptions are not worth
// tracking: `7 / 2` is 3 in slate and 3.5 in JavaScript, `0` is true in slate and false in
// JavaScript, `[1] == [1]` is true in slate and false in JavaScript, and `1 << 40` is 2^40 in slate
// and 256 in JavaScript, whose shift is 32 bits wide. `$.arith`, `$.truthy`, `$.eq` and their
// neighbours in `js_rt.sysl` are where slate's answers live.
//
// **An integer is a `BigInt` and a real is a `number`**, which is the one representation decision
// everything else follows from. slate's integer is 64 bits, wraps, divides towards zero and shifts
// to 63 places; a double does none of those and cannot be told from a real afterwards, so `2.5 is
// integer` would answer whatever the value happened to look like. The cost is arithmetic through
// `BigInt`, which is the honest price of answering the same as the interpreter.
//
// The files: this one holds the entry points, the writer and the spelling of a name; `js_stmt.sysl`
// holds the statements, the assignments and the definitions; `js_expr.sysl` holds the expressions,
// `js_control.sysl` the control forms and `js_pat.sysl` the patterns. `js_rt.sysl` holds the runtime
// the emitted code calls into.
//
// **The statements were cut off here when the file passed a thousand lines, and NOTHING crosses the
// cut** -- what is left is what a whole program comes to and the two questions every emitter asks
// (how a line is written, how a name is spelled), and the statements stand on both without either
// reaching back.

// What one emission is carrying.
//
// **Nothing here is `private`, `private` in sysl being private to the FILE**: `js_expr.sysl` and
// `js_pat.sysl` write through the same builder and take temporaries from the same counter.
struct Js
    out: StrBuilder

    // The file being emitted, for the line a fault names.
    src: Source

    // Which file that is, as an index into the program's own list of them -- the number a marker
    // carries and `$.files` is indexed by.
    file: usize

    // Whether a marker names the file as well as the line.
    //
    // **A program of several files stamps every marker and a program of one file stamps none.** A
    // function defined in one module and called from another has to say where it was written, and
    // the caller's next marker has to put the caller's file back -- so once there are two files,
    // every marker has to carry one. Where there is only one file there is nothing to put back.
    stamp: bool

    // The line the emitted code last said it was on, so that a marker is written only where it
    // changed.
    last_line: usize

    // How deep the emitted code is indented.
    depth: usize

    // How many temporaries have been taken. A slate identifier cannot hold a `$`, so `$t1` can
    // collide with nothing a program wrote.
    tmp: usize

    report: Report

    // The loops enclosing this point, innermost last, so that a `break` finds the JavaScript label
    // and the temporary belonging to the loop it names.
    loops: Buf[JsLoop]

    // The types this file declared, so that `x is Shape` can be emitted as the pattern the name
    // stands for. A type has no runtime existence, exactly as in the interpreter.
    type_names: Buf[string]
    type_pats: Buf[Pattern]

    // The names the run of statements being emitted declares MORE THAN ONCE, and every name already
    // declared in the JavaScript block being written.
    //
    // **slate rebinds where JavaScript refuses to redeclare.** `val a = 1` and then `val a = 2` in
    // one scope is one slot rebound rather than two bindings -- a function written between the two
    // answers the second value -- and slate allows it for any binding, an import included. `const`
    // twice is a JavaScript *SyntaxError*, so the program would not start at all; and renaming the
    // second would be wrong for the function in the middle. So a name that is declared again is
    // introduced with `let` and every declaration after the first is an assignment.
    rebound: Buf[string]
    bound: Buf[string]

    // Names a binder has just declared into the block that is about to open: a `match` arm's
    // pattern, a `for`'s. **They are written outside the run of statements and land inside the same
    // JavaScript block**, since a slate scope that holds only a binding needs no block of its own --
    // so a body that declares one of them again is redeclaring, and has to be told so.
    pending: Buf[string]
end Js

// What a block being emitted knows, kept while a block inside it is written.
struct JsBlock
    rebound: Buf[string]
    bound: Buf[string]
end JsBlock

// One loop being emitted: what a `break` inside it has to know.
//
// **A loop is a statement in JavaScript and an expression in slate**, so a loop that is used for its
// value is emitted as a temporary plus a labelled statement. `break 7` assigns the temporary and
// breaks the label; finishing without a break leaves whatever the `else` said, or null.
struct JsLoop
    // The label the program wrote, or the empty string.
    label: string

    // The label emitted for it, which every loop has whether or not the program named one.
    js: string

    // The temporary holding the loop's value.
    value: string

    // The temporary holding whether a `break` was taken, which is what an `else` asks.
    broke: string
end JsLoop

// A program's JavaScript, and everything that was wrong with it.
struct Emitted
    code: string
    report: Report

    // Which file each complaint is about, in step with the report's own items -- the same parallel
    // list `Ran` carries and for the same reason. A program is as many files as it imports, so a
    // complaint has to be drawn against the one it came from.
    srcs: Buf[usize]

    ok(self) -> bool = !self.report.has_errors()
end Emitted

// -- the entry points ---------------------------------------------------------------------------

// One file's statements, as the body of a JavaScript function.
//
// **The runtime is not part of this, which is what makes the output readable and testable.** A test
// pins what a program compiles to; prepending nine hundred lines of runtime to every expectation
// would pin nothing but the runtime.
emit_module(prog: Program, src: Source) -> Emitted = emit_one(prog, src, 0, false, false)

// One module of a program, told which file it is and whether the markers name it.
private emit_one(prog: Program, src: Source, file: usize, stamp: bool, testing: bool) -> Emitted
    var j = Js(str_builder(), src, file, stamp, 0, 0, 0, report(), buf(), buf(), buf(), buf(), buf(), buf())

    for i in 0..<prog.type_names.len()
        j.type_names.push(prog.type_names.at(i))
        j.type_pats.push(prog.type_pats.at(i))

    // What `Point` stands for, for the patterns emitted below -- this file's own types and the ones
    // it imported, exactly as the module was compiled. `resolve_pattern` is the compiler's own, and
    // this is what it reads.
    open_module_types(&current_unit, prog, file)
    emit_stmts(&j, prog.stmts)

    for i in 0..<prog.exports.len()
        val name = prog.exports.at(i)

        line(&j, s"$$exports.setName(${quoted_js(name)}, ${js_name(name)});")

    // **A `@test` registers here, beside the exports, and for the export list's reason**: this is the
    // one place a name the program declared is still in scope. Only the ENTRY file's tests are
    // emitted, which is `compile_module`'s `is_entry` -- a test file imports the module it tests, and
    // registering every module's would run the imported file's once per importer.
    if testing
        for i in 0..<prog.tests.len()
            val name = prog.tests.at(i)

            line(&j, s"$$.$$test(${quoted_js(name)}, ${js_name(name)});")

    var srcs: Buf[usize] = buf()

    for i in 0..<j.report.len()
        srcs.push(file)

    Emitted(j.out.finish(), j.report, srcs)
end emit_one

// A whole program: the runtime, then every module it is made of, the entry last.
//
// **The module body is a function rather than the top level**, so that a program declaring `print`
// shadows the builtin of that name instead of colliding with it. The builtins are `const`s in the
// scope above, which is exactly the relationship the interpreter's scope chain gives them.
//
// **A module is a function that answers its exports**, bound to `$mN` where `N` is the file's index
// -- which is what an import in another module then takes a field out of. They are emitted in
// `Loaded.order`, every file before any file that imports it, so a `const` is always in place before
// the module that names it. That is the loader's order and not a second one worked out here.
//
// **EVERY module is a function of its own, the entry included, and that is not tidiness.** A name a
// module binds -- an import, a `val`, a definition -- would otherwise sit in the scope the other
// modules' functions are written in and shadow the builtin of that name for all of them. `import
// { now } from slate:time` did exactly that: the `const now` the entry bound was what `slate:time`
// itself found when it went looking for the builtin, and a `const` is in its dead zone until the
// line that fills it, so a program that imported the clock could not start.
//
// **A program of one file skips the wrapper**, since a scope shared with nobody cannot shadow
// anything, and a program of one file is then the same text it was before there were modules at all.
emit_program(l: Loaded, testing: bool) -> Emitted
    val body = program_body(l, testing)
    var out = str_builder()

    out.push(js_runtime())

    // **The builtins are PARAMETERS of the program, not names in the host's global scope.**
    //
    // A builtin has to be a bare name a program can write, and installing each one on `globalThis`
    // was how that was done. What it cost is that the emitted program then owns those names for the
    // whole process -- so a host API calling one gets slate's. node's own `WebSocket` does exactly
    // that: its handshake calls `setTimeout` and calls `.unref()` on what comes back, and slate
    // answers its own integer id, which has no such method. The socket never opens and nothing
    // anywhere names a timer. **In a browser it is worse**: a page's other scripts and the browser's
    // own APIs share those names, and a slate program on the page would take them from everybody.
    //
    // **Two scopes, so a program's own name still shadows.** The parameters are the outer function's
    // and the program is the inner one, so `val print = 1` in a program is ordinary shadowing rather
    // than a redeclaration -- which is what the global scheme gave for free and what a single scope
    // would have taken away.
    //
    // The names come from `builtin_names`, which reads the scope `install_natives` fills, so a
    // builtin added there arrives here on the next build and there is no second list to go stale.
    val names = builtin_names()

    out.push(scope_opens(names))

    if testing
        // **A file run for its tests is a SUITE OF ONE**, so that there is one runner and not two.
        // `slate js --test p.sl | node -` and `slate test --js .` then report in the same words
        // because they are the same code, rather than because two places were kept in step.
        out.push(suite_text(one_entry(l.sources.at(l.order.at(l.order.len() - 1)).name, body.code)))
    else
        // **The semicolon in front of the program is load-bearing.** JavaScript inserts one only
        // where the next line cannot continue the last, and `(` can: without this the prelude's
        // final statement reads the program's own function as an argument and calls it, which is a
        // `TypeError` a long way from its cause.
        out.push("\n;(() => {\n")
        out.push(body.code)
        out.push("})();\n")

    out.push(scope_shuts(names))

    Emitted(out.finish(), body.report, body.srcs)
end emit_program

// One entry of a suite: the path, and a function that evaluates that file's program.
//
// Not `private`: `main.sysl` builds a suite out of one of these per file.
one_entry(path: string, body: string) -> string
    var out = str_builder()

    out.push(s"    [${quoted_js(path)}, () => {\n")
    out.push(indented(body))
    out.push("    }]")

    out.finish()
end one_entry

// The whole suite: the runtime, then every file's program handed to one runner.
//
// **`$suite` evaluates each file and runs its tests, in one process.** A program per file would cost
// node's start-up per file, which is most of what a suite of small files costs at all; and a runner
// per file would be a second place for the report to be written.
//
// Not `private`: `main.sysl` is what assembles a suite.
js_suite(entries: Buf[string]) -> string
    var out = str_builder()

    val names = builtin_names()

    out.push(js_runtime())
    out.push(scope_opens(names))
    out.push(suite_text(joined_entries(entries)))
    out.push(scope_shuts(names))

    out.finish()
end js_suite

// The two halves of the wrapper the builtins arrive through.
//
// **One function per half rather than one that takes the body**, because the two emitters have
// nothing else in common: `emit_program` writes a program or a suite of one, and `js_suite` writes a
// suite of many. What must not differ is the wrapper, and it does not because it is written once.
private scope_opens(names: Buf[string]) -> string
    var out = str_builder()

    out.push("\n;((")

    for i in 0..<names.len()
        if i > 0 then out.push(", ")

        out.push(names.at(i))

    out.push(") => {\n")
    out.finish()
end scope_opens

private scope_shuts(names: Buf[string]) -> string
    var out = str_builder()

    out.push("})(")

    for i in 0..<names.len()
        if i > 0 then out.push(", ")

        out.push(s"$$b[${quoted_js(names.at(i))}]")

    out.push(");\n")
    out.finish()
end scope_shuts

private suite_text(entries: string) -> string = s"\n;$$.$$suite([\n${entries}\n]);\n"

private joined_entries(entries: Buf[string]) -> string
    var out = str_builder()

    for i in 0..<entries.len()
        if i > 0 then out.push(",\n")

        out.push(entries.at(i))

    out.finish()
end joined_entries

// The statements a program is, with no runtime in front and no wrapper around them.
//
// Not `private`: `main.sysl` emits one of these per file of a suite.
program_body(l: Loaded, testing: bool) -> Emitted
    var out = str_builder()
    var rep = report()
    var srcs: Buf[usize] = buf()

    // **Whether the file is stamped on a marker is decided for the whole program**, not per module,
    // so that a function's line table reads the same wherever it was written.
    val many = l.order.len() > 1

    // **The file table is set per PROGRAM and not once for a suite**, because each file of a suite
    // is its own program with its own imports and its own numbering. A marker names a file by index
    // into whatever this last set.
    out.push(s"    $$.files([${files_text(l)}]);\n")

    for i in 0..<l.order.len()
        val which = l.order.at(i)
        val body = emit_one(l.programs.at(which), l.sources.at(which), which, many, testing && i == l.order.len() - 1)

        rep.absorb(body.report)

        for k in 0..<body.srcs.len()
            srcs.push(body.srcs.at(k))

        if many
            out.push(s"\n    const $$m${which} = (() => {\n")
            out.push(s"        $$.at(0, ${which});\n")
            out.push("        const $exports = $.obj([]);\n\n")
            out.push(indented(indented(body.code)))
            out.push("\n        return $exports;\n    })();\n")
        else
            out.push("\n    const $exports = $.obj([]);\n\n")
            out.push(indented(body.code))

    Emitted(out.finish(), rep, srcs)
end program_body

// The files, in the order a marker names them by.
private files_text(l: Loaded) -> string
    var out = str_builder()

    for i in 0..<l.sources.len()
        if i > 0 then out.push(", ")

        out.push(quoted_js(l.sources.at(i).name))

    out.finish()
end files_text

// Every line of a block, moved in by one step.
//
// **By line rather than by byte**, because a byte-by-byte copy would take a multi-byte character
// apart: `char(b)` of a continuation byte is not the character it belongs to, and pushing it back
// would encode it a second time.
private indented(code: string) -> string
    var out = str_builder()
    val lines = split(code, "\n")

    for i in 0..<lines.len
        val text = lines[i]

        // The last piece of a text ending in a newline is empty, and indenting it would leave
        // trailing blanks.
        if text != ""
            out.push("    ")
            out.push(text)

        if i < lines.len - 1 then out.push_char('\n')

    out.finish()
end indented

// -- the writer ---------------------------------------------------------------------------------

// One line of JavaScript, at the depth being emitted at.
line(j: *Js, text: string)
    for i in 0..<j.depth
        j.out.push("    ")

    j.out.push(text)
    j.out.push_char('\n')
end line

// A blank line, which is how the emitted code stays readable.
blank(j: *Js) = j.out.push_char('\n')

open(j: *Js) = j.depth += 1

close(j: *Js) = j.depth -= 1

// A name nothing a program wrote can collide with.
fresh(j: *Js) -> string
    j.tmp += 1
    "$t" + s"${j.tmp}"
end fresh

// A complaint about something the back end cannot emit.
//
// **A diagnostic rather than a fault at run time**, which is the same choice `compile.sysl` makes:
// what cannot be emitted is knowable here, and a program that would have failed halfway through is
// worse than one that does not start.
complain(j: *Js, at: Span, message: string) = j.report.add(error(at, message))

// -- names ----------------------------------------------------------------------------------------

// Whether emitted text is a name and nothing else, so that evaluating it does nothing.
is_bare_name(text: string) -> bool
    val b = text.bytes

    if b.len == 0 then return false

    for i in 0..<b.len
        val c = b[i]
        val ok = is_ident_cont(c) || c == u8('$')

        if !ok then return false

    true
end is_bare_name

// A slate name as a JavaScript one.
//
// **Only JavaScript's own words are touched, and the escape is a `$`.** A slate identifier is letters,
// digits and `_` -- `is_ident_start` and `is_ident_cont` say so -- so a trailing `$` names something
// no program can write, and two slate names can never mangle to one.
js_name(name: string) -> string
    // **The parser makes names a program cannot write, and they are not JavaScript names either.**
    // `(new)` is the object a constructor is building and `(0)` is a destructured parameter, both
    // unspellable on purpose so that nothing a person wrote can shadow them. A slate identifier
    // holds no `$`, so `$` in front of the letters is a name nothing can collide with either.
    if !spellable(name) then return "$" + letters_of(name)

    if reserved_in_js(name) then return name + "$"

    name
end js_name

// Whether a name is one a program could have written, which is what makes it a JavaScript name too.
private spellable(name: string) -> bool
    for i in 0..<name.bytes.len
        val c = name.bytes[i]

        if !(c == u8('_') || is_alpha(c) || (i > 0 && is_digit(c))) then return false

    name.bytes.len > 0
end spellable

private letters_of(name: string) -> string
    var out = str_builder()

    for i in 0..<name.bytes.len
        val c = name.bytes[i]

        if c == u8('_') || is_alpha(c) || is_digit(c) then out.bytes.push(c)

    out.finish()
end letters_of

// Whether JavaScript would refuse this as a name. The list is JavaScript's reserved words together
// with the two words that are not reserved but cannot be declared in strict mode.
private reserved_in_js(name: string) -> bool = name match
    "await" -> true
    "arguments" -> true
    "break" -> true
    "case" -> true
    "catch" -> true
    "class" -> true
    "const" -> true
    "continue" -> true
    "debugger" -> true
    "default" -> true
    "delete" -> true
    "do" -> true
    "else" -> true
    "enum" -> true
    "eval" -> true
    "export" -> true
    "extends" -> true
    "false" -> true
    "finally" -> true
    "for" -> true
    "function" -> true
    "if" -> true
    "implements" -> true
    "import" -> true
    "in" -> true
    "instanceof" -> true
    "interface" -> true
    "let" -> true
    "new" -> true
    "null" -> true
    "package" -> true
    "private" -> true
    "protected" -> true
    "public" -> true
    "return" -> true
    "static" -> true
    "super" -> true
    "switch" -> true
    "this" -> true
    "throw" -> true
    "true" -> true
    "try" -> true
    "typeof" -> true
    "var" -> true
    "void" -> true
    "while" -> true
    "with" -> true
    "yield" -> true
    _ -> false
