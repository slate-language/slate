module dev.slatelang.slate

// The document, as JavaScript. What `slate:dom` is when there is a page.
//
// **This is the only part of the runtime that reaches outside the language**, which is why it is a
// file of its own rather than a section of `js_rt_builtins.sysl`. Everything else in the runtime is
// slate's own semantics written in JavaScript; this is a door.
//
// **A NODE IS A SLATE INTEGER**, and that is the decision the rest follows from. The engine keeps
// the elements in a table and hands out its index, so no foreign object ever becomes a slate value:
// `==` still compares what slate says it compares, `print` still has something to say, a node still
// travels through an array or a pattern like any other value, and there is no second kind of thing
// for the checker to learn. It is the arrangement the timers already use -- *"the id is slate's own
// number and not the engine's handle"* -- reached again for the same reason.
//
// **The cost, stated once**: a node handed out is a node held, so a table entry outlives the element
// unless something gives it back. `release` is what gives it back, and the reconciler in
// `slate-language/lath` calls it when it drops a child. A program that never releases leaks table slots
// and not much else, the elements themselves being freed by the page when they leave it.
//
// **AN EVENT ARRIVES AS A SLATE OBJECT AND NOT AS THE EVENT.** A `MouseEvent` has no representation
// here and inventing one would be inventing a foreign value; what a handler is given is a record of
// the fields a handler actually reads, built at the moment it fires. It is a summary and the module
// says so -- the alternative is a value slate cannot print, compare or store.
js_runtime_dom() -> string = raw"""
        // -- the document ------------------------------------------------------------------------------

        const isInt = $.isInt
        const isStr = $.isStr

        const noDocument = (name) =>
            fault("`" + name + "` needs a document, and this JavaScript host has none -- `slate:dom` is for a page")

        // The page, taken once and by feature rather than by name: a host with a `document` that can
        // make an element has one, and everything else does not.
        const doc = (typeof globalThis.document === "object" && globalThis.document !== null &&
            typeof globalThis.document.createElement === "function") ? globalThis.document : null

        // The table the handles index. **Slot 0 is never given out**, so that a handle is always
        // truthy and an uninitialised one cannot look like a valid node.
        const nodes = [null]

        // The slots `release` gave back. **A free LIST and not a scan**, because a scan for the first
        // empty slot is linear in the table and an interface that builds and drops elements does that
        // on every element it ever makes -- which is quadratic in a page's whole history, on the path
        // a re-render takes.
        const free = []

        // What a program is holding, or the sentence saying it is not a node.
        //
        // **The check is the whole point of the handle.** A number that came from somewhere else --
        // arithmetic on a handle, a released one, a length -- would otherwise reach the DOM as an
        // index and do something arbitrary; here it says which builtin was asked and what it got.
        const nodeOf = (v, name) => {
            if (!isInt(v)) fault("`" + name + "` takes a node, and this is " + typeName(v))

            const at = Number(v)
            const node = nodes[at]

            if (at < 1 || at >= nodes.length || node === null)
                fault("`" + name + "` was given a node that is not there -- it was released, or it never came from `slate:dom`")

            return node
        }

        // A handle for something the page handed back, and `null` for nothing at all. Reusing a
        // released slot keeps the table from growing for the lifetime of a page that builds and drops
        // elements, which is what a re-rendering interface does all day.
        const handleFor = (node) => {
            if (node === null || node === undefined) return null

            const spare = free.pop()

            if (spare !== undefined) {
                nodes[spare] = node

                return BigInt(spare)
            }

            nodes.push(node)

            return BigInt(nodes.length - 1)
        }

        const wantText = (v, name) => {
            if (!isStr(v)) fault("`" + name + "` takes a string, and this is " + typeName(v))

            return v
        }

        B.createElement = (tag) => {
            if (doc === null) noDocument("createElement")

            return handleFor(doc.createElement(wantText(tag, "createElement")))
        }

        B.createText = (s) => {
            if (doc === null) noDocument("createText")

            return handleFor(doc.createTextNode(wantText(s, "createText")))
        }

        B.byId = (id) => {
            if (doc === null) noDocument("byId")

            return handleFor(doc.getElementById(wantText(id, "byId")))
        }

        B.query = (selector) => {
            if (doc === null) noDocument("query")

            return handleFor(doc.querySelector(wantText(selector, "query")))
        }

        // **An attribute's value is written as slate would print it**, `true` being the empty string
        // that HTML uses for a bare attribute. A `null` or a `false` removes it, which is the rule
        // the string renderer in `slate-language/lath` already follows, so one component means one thing
        // on a server and in a page.
        B.setAttribute = (node, name, value) => {
            const el = nodeOf(node, "setAttribute")
            const key = wantText(name, "setAttribute")

            if (value === null || value === false || value === undefined) return el.removeAttribute(key), null

            el.setAttribute(key, value === true ? "" : text(value))

            return null
        }

        B.removeAttribute = (node, name) => {
            nodeOf(node, "removeAttribute").removeAttribute(wantText(name, "removeAttribute"))

            return null
        }

        // **A PROPERTY IS NOT AN ATTRIBUTE, and an input is where the difference shows.** Setting the
        // `value` attribute says what the field started as; setting the property says what it holds
        // now. A form that re-renders needs the second and would appear frozen with the first.
        B.setProperty = (node, name, value) => {
            const el = nodeOf(node, "setProperty")

            el[wantText(name, "setProperty")] = isInt(value) ? Number(value) : value

            return null
        }

        // The listeners this module installed, so that `off` can take back the wrapper `on` made.
        // Keyed by the element and then by the slate function, which is identity here exactly as it
        // is in the interpreter.
        const listeners = new WeakMap()

        B.on = (node, type, f) => {
            const el = nodeOf(node, "on")
            const kind = wantText(type, "on")

            if (typeof f !== "function") fault("`on` takes a function to call, and this is " + typeName(f))

            let forNode = listeners.get(el)

            if (forNode === undefined) {
                forNode = new Map()
                listeners.set(el, forNode)
            }

            const already = forNode.get(kind)

            if (already !== undefined && already.has(f)) return null

            const wrapper = (e) => $.callback(f, [eventRecord(e)], "on")

            if (already === undefined) forNode.set(kind, new Map([[f, wrapper]]))
            else already.set(f, wrapper)

            el.addEventListener(kind, wrapper)

            return null
        }

        B.off = (node, type, f) => {
            const el = nodeOf(node, "off")
            const kind = wantText(type, "off")
            const forNode = listeners.get(el)
            const forKind = forNode === undefined ? undefined : forNode.get(kind)
            const wrapper = forKind === undefined ? undefined : forKind.get(f)

            if (wrapper === undefined) return null

            el.removeEventListener(kind, wrapper)
            forKind.delete(f)

            return null
        }

        // **What a handler is given: a record, not the event.** These are the fields a handler reads
        // -- what happened, what the field holds now, which key, which modifiers were down, which
        // button -- and `stop` and `prevent` are the two things it does back. Anything else is not
        // reachable, deliberately: the alternative is handing slate a value it cannot print, compare
        // or keep.
        //
        // **`mods` and `button` are here because a LINK cannot be written without them.** A framework
        // intercepting a click has to let a cmd-click, a ctrl-click, a shift-click and a middle click
        // through to the browser, or it swallows the most ordinary thing anybody does to a link. Both
        // are plain values: `mods` is a record of four booleans and `button` is an integer, or `null`
        // where the event carries none -- which is every event that is not a mouse event.
        //
        // **`mods` is nested rather than four fields on the record**, so that a keyboard event reads
        // the same way as a mouse event and the record does not grow a flat prefix per event family.
        const eventRecord = (e) => {
            const target = e.target === null || e.target === undefined ? null : e.target
            const held = target === null ? null : target.value
            const checked = target === null ? null : target.checked

            return $.obj([
                ["type", e.type],
                ["value", held === undefined || held === null ? null : String(held)],
                ["checked", checked === undefined || checked === null ? null : checked],
                ["key", e.key === undefined || e.key === null ? null : e.key],
                ["mods", $.obj([
                    ["meta", e.metaKey === true],
                    ["ctrl", e.ctrlKey === true],
                    ["shift", e.shiftKey === true],
                    ["alt", e.altKey === true]])],
                ["button", typeof e.button === "number" ? BigInt(e.button) : null],
                ["stop", () => (e.stopPropagation(), null)],
                ["prevent", () => (e.preventDefault(), null)]])
        }

        // **The whole child list at once**, which is what the reconciler above has and what the DOM
        // does in one call. Replacing rather than appending is what makes a re-render idempotent.
        B.setChildren = (node, kids) => {
            const el = nodeOf(node, "setChildren")

            if (!Array.isArray(kids)) fault("`setChildren` takes an array of nodes, and this is " + typeName(kids))

            el.replaceChildren(...kids.map((k) => nodeOf(k, "setChildren")))

            return null
        }

        // **ONE child moved, where `setChildren` writes the whole list.** A keyed reconciler that
        // moves three rows of a thousand has `setChildren` alone, and `replaceChildren` makes the
        // browser record a mutation per row -- ~1001 of them for three rows moved, measured through
        // jsdom's `MutationObserver`, which is the instrument the hydration work already uses.
        //
        // **`before` of `null` APPENDS**, which is `Node.insertBefore`'s own rule and is what makes
        // the two ends of a list one call rather than two: a reconciler placing the last child has
        // nothing to put it in front of.
        //
        // **A node already in the tree MOVES rather than being copied**, which is the DOM's rule and
        // is the whole reason this is worth having: the element keeps its focus, its scroll position
        // and its playing media.
        B.insertBefore = (parent, node, before) => {
            const el = nodeOf(parent, "insertBefore")
            const child = nodeOf(node, "insertBefore")
            const mark = before === null ? null : nodeOf(before, "insertBefore")

            if (mark !== null && mark.parentNode !== el)
                fault("`insertBefore` was given a node to go before that is not a child of this parent")

            el.insertBefore(child, mark)

            return null
        }

        // **The parent is named as well as the child**, where the DOM's `remove()` needs only the
        // child. A reconciler holds both, and naming the parent is what turns "this node is somewhere
        // else in the page" from a silent success into a sentence.
        B.removeChild = (parent, node) => {
            const el = nodeOf(parent, "removeChild")
            const child = nodeOf(node, "removeChild")

            if (child.parentNode !== el)
                fault("`removeChild` was given a node that is not a child of this parent")

            el.removeChild(child)

            return null
        }

        B.setText = (node, s) => {
            nodeOf(node, "setText").textContent = wantText(s, "setText")

            return null
        }

        // What the page would show for this node, which is what a test reads and what `html()` in
        // `slate-language/lath` answers over a DOM host.
        //
        // **A text node has no `outerHTML`**, and handing back its `textContent` raw would be the one
        // place this answers something a browser would not show: the string host escapes its text,
        // and so must this, or the two hosts disagree about the very thing they are compared on.
        B.markup = (node) => {
            const el = nodeOf(node, "markup")

            if (el.outerHTML !== undefined) return el.outerHTML

            return String(el.textContent).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
        }

        // -- reading a page that is already there ---------------------------------------------------

        // **These four are the READ side, and they exist because hydration needs exactly them.**
        // Everything above either makes a node or changes one; a program adopting markup somebody
        // else rendered has to walk it and ask what it found.
        //
        // A handle for an existing element is not a new kind of value -- `byId` and `query` have
        // minted one since this module shipped -- so what is new here is the walk, not the handle.

        // A node's children, as handles, in order.
        //
        // **EVERY child node and not only the elements**, because a text node between two elements is
        // a position: a reconciler counting children has to count what the browser counts or it
        // adopts the wrong node. `tagName` is what tells the two apart.
        //
        // **A fresh handle per call, and they are given back with `release` like any other.** What is
        // released is the HANDLE and not the node -- the element stays exactly where it is in the
        // page -- which reads oddly the first time and is the same rule `drop` has always followed.
        B.children = (node) => {
            const el = nodeOf(node, "children")
            const kids = el.childNodes === undefined ? [] : el.childNodes
            const out = []

            for (let i = 0; i < kids.length; i += 1) out.push(handleFor(kids[i]))

            return out
        }

        // A node's tag in lower case, or `null` where it has none.
        //
        // **`null` is how a text node is told from an element**, which is the question a reconciler
        // asks first and the reason this answers rather than faulting. Lower case because that is
        // what a program wrote: the DOM answers `DIV` for HTML and a component says `div`.
        B.tagName = (node) => {
            const el = nodeOf(node, "tagName")

            return typeof el.tagName === "string" ? el.tagName.toLowerCase() : null
        }

        // What a node says, as text.
        //
        // **`textContent`, so an element answers everything under it** and a text node answers
        // itself. A hydrating reconciler asks this of the text nodes it lands on, having used
        // `tagName` to know that is what they are.
        B.nodeText = (node) => {
            const el = nodeOf(node, "nodeText")
            const said = el.textContent

            return said === null || said === undefined ? "" : String(said)
        }

        // One attribute's value, or `null` where the node does not carry it.
        //
        // **`true` for a bare attribute**, which is the reading `setAttribute` writes: it puts the
        // empty string for `true`, and a program comparing what it would set against what is there
        // has to get the same value back. Without that agreement a hydrating pass rewrites every
        // bare attribute it meets and the page it adopted is not the page it was given.
        B.attribute = (node, name) => {
            const el = nodeOf(node, "attribute")
            const key = wantText(name, "attribute")

            if (el.getAttribute === undefined || !el.hasAttribute(key)) return null

            const value = el.getAttribute(key)

            return value === "" ? true : value
        }

        // Give a handle back. **A node dropped from the page still holds a table slot until this is
        // called**, and the reconciler calls it -- so a long-running interface does not grow a table
        // as long as everything it has ever rendered.
        //
        // **It gives back the HANDLE and not the node.** A handle that came from `children` releases
        // exactly as one from `createElement` does, and the element stays in the page either way --
        // the table cannot tell the two apart and does not need to.
        B.release = (node) => {
            nodeOf(node, "release")

            const at = Number(node)

            nodes[at] = null
            free.push(at)

            return null
        }

        // -- the page's OTHER three doors: where it is, where it has been, what it remembers -------

        // **These are the parity rule read the other way.** A browser has `history`, `location` and
        // `localStorage` and nothing else does -- there is no address bar in an interpreter and no
        // per-origin store on a server -- so a host without one REFUSES naming it, exactly as
        // `slate:time`'s `abbrev` does. What would be wrong is answering something: a `location()`
        // invented for a program with no page would let a router run and route nowhere.
        const noPage = (name, what) =>
            fault("`" + name + "` needs a browser's `" + what + "`, and this JavaScript host has none")

        // **A store that is PRESENT and REFUSING is a different answer from one that is absent**, and
        // the two are told apart by which way it fails. A host with no `localStorage` at all has the
        // name undefined, and that is a fault -- the host does not have the thing. A browser told not
        // to keep data throws on the very access, and that is a RESULT: the page is running where it
        // was meant to and the user has said no, which is a condition a program deals with rather
        // than a defect in it.
        const storeOk = (v) => $.obj([["ok", true], ["value", v]])
        const storeBad = (e) => $.obj([["ok", false],
            ["error", "this browser is not letting the page use `localStorage`: " +
                String(e !== null && e !== undefined && e.message !== undefined ? e.message : e)]])

        // Whether the host has one at all, asked without touching it.
        const hasStore = () => {
            try {
                return typeof globalThis.localStorage !== "undefined"
            } catch (e) {
                // Reaching the name threw, so the name is there and the store is refusing.
                return true
            }
        }

        // Where the page is, as a record built now rather than as the host's object.
        //
        // **A `Location` has no representation in slate and inventing one would be inventing a
        // foreign value**, which is the decision a node already answers. So this is the same summary
        // an event is: the fields a program reads, at the moment it asks.
        //
        // **`query` and `hash` carry their punctuation**, `"?a=1"` and `"#top"`, which is what the
        // host calls `search` and `hash` and what a program pasting one back into a url needs. An
        // empty one is `""` and never null, so a router can concatenate without asking.
        B.location = () => {
            if (typeof globalThis.location === "undefined" || globalThis.location === null)
                noPage("location", "location")

            const l = globalThis.location

            return $.obj([
                ["href", String(l.href)],
                ["protocol", String(l.protocol)],
                ["host", String(l.host)],
                ["hostname", String(l.hostname)],
                ["port", String(l.port)],
                ["path", String(l.pathname)],
                ["query", String(l.search)],
                ["hash", String(l.hash)]])
        }

        const theHistory = (name) => {
            if (typeof globalThis.history === "undefined" || globalThis.history === null)
                noPage(name, "history")

            return globalThis.history
        }

        // **NO STATE OBJECT, AND THAT IS A MEASUREMENT RATHER THAN A SIMPLIFICATION.** `pushState`
        // structured-clones what it is given, and `structuredClone` STRIPS THE PROTOTYPE: a slate
        // object put in comes back a plain object carrying a `fields` map, which is not a slate
        // object and which nothing in the language could read. So the url is the whole of the state,
        // which is also what makes a router's two paths agree -- after a `back` the address bar is
        // the truth either way, and a state that could disagree with it is the classic way a router
        // shows the wrong page.
        B.pushPath = (url) => {
            theHistory("pushPath").pushState(null, "", wantText(url, "pushPath"))

            return null
        }

        B.replacePath = (url) => {
            theHistory("replacePath").replaceState(null, "", wantText(url, "replacePath"))

            return null
        }

        B.back = () => (theHistory("back").back(), null)

        B.forward = () => (theHistory("forward").forward(), null)

        // One handler, replaced rather than added to, which is `wsOnMessage`'s arrangement: two
        // listeners on one event is two names for one thing and a module holding one of them would
        // miss half of what happened.
        let popped = null

        // **`pushPath` does NOT fire this, and a router has to know that.** A browser raises
        // `popstate` for a movement the USER made -- back, forward, a gesture -- and never for a push
        // the program made itself, so a router renders after its own push and waits to be told about
        // everything else.
        B.onNavigate = (f) => {
            if (typeof globalThis.addEventListener !== "function")
                noPage("onNavigate", "history")

            if (popped === null)
                globalThis.addEventListener("popstate", () => {
                    if (popped === null) return

                    const l = globalThis.location

                    $.callback(popped, [String(l.pathname) + String(l.search) + String(l.hash)], "onNavigate")
                })

            popped = f

            return null
        }

        // -- what the page remembers ---------------------------------------------------------------

        // **Every one of these answers a RESULT**, which is `readFileSync`'s channel and its reason:
        // what comes back was written by somebody else -- another tab, an earlier visit, a user who
        // cleared it -- and whether the store will answer at all is the browser's decision and not
        // the program's.
        //
        // **A key that is not there is `{ ok: true, value: null }`** and not a failure. Nothing went
        // wrong; there is nothing stored.
        B.stored = (key) => {
            if (!hasStore()) noPage("stored", "localStorage")

            const k = wantText(key, "stored")

            try {
                const held = globalThis.localStorage.getItem(k)

                return storeOk(held === null ? null : String(held))
            } catch (e) {
                return storeBad(e)
            }
        }

        // **The value is written as slate would PRINT it**, `setAttribute`'s rule and for its reason:
        // a store holds strings and nothing else, so a number handed here has to become one somewhere
        // and doing it silently in one place beats every caller writing `string(...)`.
        B.store = (key, value) => {
            if (!hasStore()) noPage("store", "localStorage")

            const k = wantText(key, "store")

            try {
                globalThis.localStorage.setItem(k, isStr(value) ? value : text(value))

                return storeOk(null)
            } catch (e) {
                // **A quota that is full arrives here too**, which is the other thing this channel is
                // for: the page is running and the browser has said no more.
                return storeBad(e)
            }
        }

        B.unstore = (key) => {
            if (!hasStore()) noPage("unstore", "localStorage")

            const k = wantText(key, "unstore")

            try {
                globalThis.localStorage.removeItem(k)

                return storeOk(null)
            } catch (e) {
                return storeBad(e)
            }
        }

        // **In the order the store keeps them**, which is the browser's and is not promised to be
        // anything -- a program that wants an order sorts.
        B.storedKeys = () => {
            if (!hasStore()) noPage("storedKeys", "localStorage")

            try {
                const s = globalThis.localStorage
                const out = []

                for (let i = 0; i < s.length; i = i + 1) out.push(String(s.key(i)))

                return storeOk(out)
            } catch (e) {
                return storeBad(e)
            }
        }

        // **Everything this origin stored, including what another part of the page put there.** It is
        // the whole store rather than this program's share of it, there being no such share.
        B.clearStored = () => {
            if (!hasStore()) noPage("clearStored", "localStorage")

            try {
                globalThis.localStorage.clear()

                return storeOk(null)
            } catch (e) {
                return storeBad(e)
            }
        }
    """
