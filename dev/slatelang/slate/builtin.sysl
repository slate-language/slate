module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.text.{from_utf8_unchecked, str_builder, StrBuilder}

// The functions a slate program has without writing them.
//
// **Each is an ordinary value bound in the root scope**, so `val p = print` binds it and
// `apply(print, 1)` calls it. A builtin dispatched on the name at the call site would have been the
// one kind of function a program could not pass around, which in a language where functions are
// values is a hole rather than a simplification.

// Everything the program printed, in order.
//
// **Module storage, and the collector is what forced it.** A root function has to be a top-level
// function to have an address and has to reach the interpreter's state, so that state cannot be a
// local of anything -- which is one interpreter to a process, and this buffer with it. `run` clears
// it, which is what lets two programs run in one process.
var output: Buf[string] = buf()

// Put every builtin in a scope, whether or not a module has taken it.
//
// **This is the scope one of slate's OWN modules is compiled against**, which is how `slate:time`
// gets at `now` -- a built-in module's chunk is a `LoadName` per export, and the export list is what
// says which names it takes out of here. See `stdlib.sysl`.
install_builtins(env: *EnvObj) = install_natives(env, true)

// Put in the ones no built-in module has taken, which is the scope a PROGRAM'S own files run in.
//
// **The core shrinks as modules are added, and nothing here has to be re-listed for that**: one
// `if everything` guards each block that has moved, so the two scopes come from one list and cannot
// drift into disagreeing about what a builtin is.
install_core(env: *EnvObj) = install_natives(env, false)

private install_natives(env: *EnvObj, everything: bool)
    declare(env, "print", Native(NPrint), false)

    // **The two a `@test` is written with.** They raise rather than answer, because a failed
    // assertion is not a condition the test was going to handle -- it is the test's whole verdict,
    // and the runner catches it exactly as a `catch` would.
    declare(env, "assert", Native(NAssert), false)
    declare(env, "assertEq", Native(NAssertEq), false)

    // **Text, counted and cut in characters.** A slate string is a sequence of characters and never
    // of bytes -- `len("日本語")` is three -- so every one of these takes and answers positions a
    // person would count.
    declare(env, "chars", Native(NChars), false)
    declare(env, "split", Native(NSplit), false)
    declare(env, "join", Native(NJoin), false)
    declare(env, "contains", Native(NContains), false)
    declare(env, "indexOf", Native(NIndexOf), false)
    declare(env, "lastIndexOf", Native(NLastIndexOf), false)
    declare(env, "startsWith", Native(NStartsWith), false)
    declare(env, "endsWith", Native(NEndsWith), false)
    declare(env, "trim", Native(NTrim), false)
    declare(env, "trimStart", Native(NTrimStart), false)
    declare(env, "trimEnd", Native(NTrimEnd), false)
    declare(env, "upper", Native(NUpper), false)
    declare(env, "lower", Native(NLower), false)
    declare(env, "replace", Native(NReplace), false)
    declare(env, "repeat", Native(NRepeat), false)

    // Numbers. `num` reads one out of a string; `int` and `real` move between the two kinds slate
    // keeps apart everywhere else.
    declare(env, "number", Native(NNumber), false)
    declare(env, "integer", Native(NInteger), false)
    declare(env, "real", Native(NReal), false)
    declare(env, "boolean", Native(NBoolean), false)
    declare(env, "abs", Native(NAbs), false)
    declare(env, "floor", Native(NFloor), false)
    declare(env, "ceil", Native(NCeil), false)
    declare(env, "round", Native(NRound), false)
    declare(env, "trunc", Native(NTrunc), false)
    declare(env, "sqrt", Native(NSqrt), false)
    declare(env, "pow", Native(NPow), false)
    declare(env, "min", Native(NMin), false)
    declare(env, "max", Native(NMax), false)
    declare(env, "len", Native(NLen), false)

    // **Arrays.** Every one of these is also reachable as a method -- `xs.map(f)` is `map(xs, f)`,
    // and `method.sysl` is the whole of the difference. **The bare verb changes the array and the
    // participle answers a new one**, so `sort` against `sorted` and `reverse` against `reversed`,
    // and a mutation never hands the array back.
    declare(env, "push", Native(NPush), false)
    declare(env, "pop", Native(NPop), false)
    declare(env, "insert", Native(NInsert), false)
    declare(env, "removeAt", Native(NRemoveAt), false)
    declare(env, "clear", Native(NClear), false)
    declare(env, "map", Native(NMap), false)
    declare(env, "filter", Native(NFilter), false)
    declare(env, "reduce", Native(NReduce), false)
    declare(env, "find", Native(NFind), false)
    declare(env, "findIndex", Native(NFindIndex), false)
    declare(env, "every", Native(NEvery), false)
    declare(env, "some", Native(NSome), false)
    declare(env, "sort", Native(NSort), false)
    declare(env, "sorted", Native(NSorted), false)
    declare(env, "reverse", Native(NReverse), false)
    declare(env, "reversed", Native(NReversed), false)
    declare(env, "concat", Native(NConcat), false)
    declare(env, "flat", Native(NFlat), false)
    declare(env, "sum", Native(NSum), false)
    // **The type words double as the conversions**, so `string` tests in a pattern and converts in
    // an expression. The two positions never overlap: a word in pattern position is read by
    // `type_test_named` and nowhere else.
    declare(env, "string", Native(NString), false)
    declare(env, "keys", Native(NKeys), false)

    // **JSON, whose two directions use slate's two failure channels.** Text that will not parse is a
    // result, being a condition every caller was going to handle; a value with no JSON form is a
    // fault, being a defect in the program that built it.
    declare(env, "parseJSON", Native(NParseJson), false)
    declare(env, "toJSON", Native(NToJson), false)

    // **The bytes under a string, and back.** Global rather than behind an import for the reason
    // `string` and `number` are: this is a conversion between two of the kinds a program already
    // has, and a protocol that has to count what goes on the wire should not have to say where the
    // counting lives. `len(toBytes(s))` is the byte count, so there is no third name.
    declare(env, "toBytes", Native(NToBytes), false)
    declare(env, "fromBytes", Native(NFromBytes), false)

    // **The other two ways to walk an object.** `entries` is what makes a destructuring `for` head
    // worth having -- `for [k, v] in entries(o)` is the loop every program over a record wants.
    declare(env, "values", Native(NValues), false)
    declare(env, "entries", Native(NEntries), false)
    declare(env, "has", Native(NHas), false)
    declare(env, "setTimeout", Native(NSetTimeout), false)
    declare(env, "setInterval", Native(NSetInterval), false)
    declare(env, "clearTimeout", Native(NClearTimeout), false)

    // node has both names for one operation, and so does slate.
    declare(env, "clearInterval", Native(NClearTimeout), false)

    // **Bare names where JavaScript has `Promise.resolve` and `Promise.reject`.** slate has no
    // namespaces yet, and inventing one for three functions would be inventing it for the wrong
    // reason.
    declare(env, "sleep", Native(NSleep), false)
    declare(env, "resolve", Native(NResolve), false)
    declare(env, "reject", Native(NReject), false)

    // **The other half: a promise nobody has answered yet.** `resolve` and `reject` adapt something
    // that has already happened; these adapt something that has not. Without them a program can only
    // await what slate itself started -- a timer, a socket, a file -- and anything with a callback of
    // its own is stuck in callbacks. JavaScript grew `Promise.withResolvers()` for exactly this, and
    // these are its three pieces under slate's own names.
    declare(env, "pending", Native(NPending), false)
    declare(env, "settle", Native(NSettle), false)
    declare(env, "fail", Native(NFail), false)

    // **The file system, which is `slate:fs` and no longer global.** `fs.sysl` holds these; the
    // promise-shaped ten come first and the blocking ten answer exactly what their promises would
    // have.
    //
    // **`stat`, `exists`, `remove` and `rename` are why this module went second.** They are verbs a
    // program wants for its own, and while they were global a script writing `val stat = ...`
    // shadowed a builtin without meaning to.
    if everything
        declare(env, "readFile", Native(NReadFile), false)
        declare(env, "readBytes", Native(NReadBytes), false)
        declare(env, "writeFile", Native(NWriteFile), false)
        declare(env, "readDir", Native(NReadDir), false)
        declare(env, "stat", Native(NStat), false)
        declare(env, "exists", Native(NExists), false)
        declare(env, "remove", Native(NRemove), false)
        declare(env, "mkdir", Native(NMkdir), false)
        declare(env, "rmdir", Native(NRmdir), false)
        declare(env, "rename", Native(NRename), false)

        // The same ten, blocking. **The `Sync` suffix is node's and so is the reason**: the longer
        // name is the blocking one, so reaching for it is a decision rather than an accident.
        declare(env, "readFileSync", Native(NReadFileSync), false)
        declare(env, "readBytesSync", Native(NReadBytesSync), false)
        declare(env, "writeFileSync", Native(NWriteFileSync), false)
        declare(env, "readDirSync", Native(NReadDirSync), false)
        declare(env, "statSync", Native(NStatSync), false)
        declare(env, "existsSync", Native(NExistsSync), false)
        declare(env, "removeSync", Native(NRemoveSync), false)
        declare(env, "mkdirSync", Native(NMkdirSync), false)
        declare(env, "rmdirSync", Native(NRmdirSync), false)
        declare(env, "renameSync", Native(NRenameSync), false)

    // **TCP, which is `slate:net` and no longer global.** `connect` and `send` answer promises;
    // `listen` and the two readers take callbacks.
    //
    // **`send`, `close` and `connect` are why this module went third.** They are words a program
    // wants for its own -- a mailer sends, a file closes -- and while they were global a script
    // writing `close(handle) = ...` shadowed a builtin without meaning to.
    if everything
        declare(env, "listen", Native(NListen), false)
        declare(env, "connect", Native(NConnect), false)
        declare(env, "onData", Native(NOnData), false)
        declare(env, "onBytes", Native(NOnBytes), false)
        declare(env, "send", Native(NSend), false)
        declare(env, "close", Native(NCloseSocket), false)
        declare(env, "localPort", Native(NLocalPort), false)

    // **Dates and times, which are `slate:time` and no longer global.** `time.sysl` holds the eight
    // types and why there are eight; `calendar.sysl` holds these. The vocabulary is small because the
    // types carry the distinctions a date library usually carries in flags: which zone, exact or
    // calendar, a point or a length.
    //
    // **The generic names are why this module went first.** `at`, `offset`, `format`, `day`, `second`
    // and `time` are words a program wants for its own, and while they were global a script writing
    // `val time = ...` shadowed a builtin without meaning to.
    if everything
        declare(env, "now", Native(NNow), false)
        declare(env, "monotonic", Native(NMonotonic), false)
        declare(env, "date", Native(NDate), false)
        declare(env, "time", Native(NTime), false)
        declare(env, "dateTime", Native(NDateTime), false)
        declare(env, "zone", Native(NZone), false)
        declare(env, "localZone", Native(NLocalZone), false)
        declare(env, "instant", Native(NInstant), false)
        declare(env, "epochSeconds", Native(NEpochSeconds), false)
        declare(env, "epochMillis", Native(NEpochMillis), false)
        declare(env, "epochMicros", Native(NEpochMicros), false)

        // **`utc` is a VALUE and not a call**, being the one zone that is the same everywhere and cannot
        // fail to be found. Every other zone is `zone(name)`, which answers a result because a host may
        // not have it.
        declare(env, "utc", ZoneVal(utc_zone()), false)

        declare(env, "micros", Native(NMicros), false)
        declare(env, "millis", Native(NMillis), false)
        declare(env, "seconds", Native(NSeconds), false)
        declare(env, "minutes", Native(NMinutes), false)
        declare(env, "hours", Native(NHours), false)
        declare(env, "days", Native(NDays), false)
        declare(env, "weeks", Native(NWeeks), false)
        declare(env, "months", Native(NMonths), false)
        declare(env, "years", Native(NYears), false)

        declare(env, "year", Native(NYear), false)
        declare(env, "month", Native(NMonth), false)
        declare(env, "day", Native(NDay), false)
        declare(env, "hour", Native(NHour), false)
        declare(env, "minute", Native(NMinute), false)
        declare(env, "second", Native(NSecond), false)
        declare(env, "weekday", Native(NWeekday), false)
        declare(env, "monthName", Native(NMonthName), false)
        declare(env, "dayOfYear", Native(NDayOfYear), false)
        declare(env, "daysInMonth", Native(NDaysInMonth), false)
        declare(env, "isLeapYear", Native(NIsLeapYear), false)
        declare(env, "at", Native(NAt), false)
        declare(env, "offset", Native(NOffset), false)
        declare(env, "isDST", Native(NIsDst), false)
        declare(env, "abbrev", Native(NAbbrev), false)
        declare(env, "startOf", Native(NStartOf), false)
        declare(env, "onOrAfter", Native(NOnOrAfter), false)
        declare(env, "format", Native(NFormat), false)
        declare(env, "parseDate", Native(NParseDate), false)
        declare(env, "parseTime", Native(NParseTime), false)
        declare(env, "parseDateTime", Native(NParseDateTime), false)
        declare(env, "parseTimestamp", Native(NParseTimestamp), false)

    // **Regular expressions, which are `slate:regex` and no longer global.** One name, because a
    // pattern is one object and everything a program does with it is a method on that object.
    if everything
        declare(env, "regex", Native(NRegex), false)

    // **Another program and this program's own environment, which are `slate:process`.** `run` is
    // about as ordinary a word as a program can want -- a task runner, a test harness, a script with
    // steps -- and while it was global, defining one shadowed a builtin without meaning to.
    if everything
        declare(env, "run", Native(NRun), false)
        declare(env, "env", Native(NEnv), false)

    // **`next` is a free function like every other method here**, so `next(g)` and `g.next()` are the
    // one call. Nothing else is needed to drive a generator: `for x in g` is the loop, and this is
    // the step.
    declare(env, "next", Native(NGenNext), false)

    // **An HTTP server is not here, being `slate:http` and written in slate.** What is left native
    // is the client: `fetch` over https needs OpenSSL, so the encrypted transport stays where the
    // binding is, and a slate-level server owns the protocol and never the socket.

    // **`fetch` is node's name and the browser's**, and it answers a result rather than throwing --
    // which is slate's rule for anything that reaches the network, not a disagreement with either.
    declare(env, "fetch", Native(NFetch), false)

    // **What `slate:http` parses with, and node's `internalBinding('http_parser')` is the same
    // idea.** Inside `if everything`, so one of slate's own modules sees these and a program does
    // not -- they are not part of the language, they are the seam a module of it is written against.
    // Node draws the same line and for the same reason: `require('http')` is public, the parser under
    // it is not.
    if everything
        declare(env, "httpParser", Native(NHttpParser), false)
        declare(env, "httpStream", Native(NHttpStream), false)
        declare(env, "httpFeed", Native(NHttpFeed), false)
        declare(env, "httpTake", Native(NHttpTake), false)
        declare(env, "httpTakePart", Native(NHttpTakePart), false)
        declare(env, "httpFinish", Native(NHttpFinish), false)
        declare(env, "httpClose", Native(NHttpClose), false)
end install_natives

// Not `private`: `eval.sysl` dispatches a `Native` value here.
call_native(f: NativeFn, args: Buf[Value], at: Span) -> Step
    f match
        NPrint -> do_print(args)
        NAssert -> do_assert(args, at)
        NAssertEq -> do_assert_eq(args, at)

        NChars -> do_chars(args, at)
        NSplit -> do_split(args, at)
        NJoin -> do_join(args, at)
        // **Three names that answer about an array or about a string**, dispatched on what they
        // were given rather than duplicated under two spellings. A program asks the same question
        // of both, and `xs.contains(v)` and `s.contains(sub)` are the same word for the same reason.
        NContains -> if first_is_array(args) then do_array_contains(args, at) else do_contains(args, at)
        NIndexOf -> if first_is_array(args) then do_array_index_of(args, at, false) else do_index_of(args, at, false)
        NLastIndexOf -> if first_is_array(args) then do_array_index_of(args, at, true) else do_index_of(args, at, true)
        NStartsWith -> do_edge(args, at, true)
        NEndsWith -> do_edge(args, at, false)
        NTrim -> do_trim(args, at, true, true)
        NTrimStart -> do_trim(args, at, true, false)
        NTrimEnd -> do_trim(args, at, false, true)
        NUpper -> do_case(args, at, true)
        NLower -> do_case(args, at, false)
        NReplace -> do_replace(args, at)
        NRepeat -> do_repeat(args, at)

        NNumber -> do_number(args, at)
        NInteger -> do_integer(args, at)
        NReal -> do_real(args, at)
        NBoolean -> do_boolean(args, at)
        NAbs -> do_abs(args, at)
        NFloor -> do_round(args, at, 0)
        NCeil -> do_round(args, at, 1)
        NRound -> do_round(args, at, 2)
        NTrunc -> do_round(args, at, 3)
        NSqrt -> do_sqrt(args, at)
        NPow -> do_pow(args, at)
        NMin -> do_extreme(args, at, true)
        NMax -> do_extreme(args, at, false)
        NLen -> do_len(args, at)
        NPush -> do_push(args, at)
        NPop -> do_pop(args, at)
        NInsert -> do_insert(args, at)
        NRemoveAt -> do_remove_at(args, at)
        NClear -> do_clear_array(args, at)
        NMap -> do_map(args, at)
        NFilter -> do_filter(args, at)
        NReduce -> do_reduce(args, at)
        NFind -> do_find(args, at, false)
        NFindIndex -> do_find(args, at, true)
        NEvery -> do_quantify(args, at, true)
        NSome -> do_quantify(args, at, false)
        NSort -> do_sort(args, at, true)
        NSorted -> do_sort(args, at, false)
        NReverse -> do_reverse(args, at, true)
        NReversed -> do_reverse(args, at, false)
        NConcat -> do_concat(args, at)
        NFlat -> do_flat(args, at)
        NSum -> do_sum(args, at)
        NString -> do_string(args, at)
        NKeys -> do_keys(args, at)
        NParseJson -> do_parse_json(args, at)
        NToJson -> do_to_json(args, at)
        NToBytes -> do_to_bytes(args, at)
        NFromBytes -> do_from_bytes(args, at)
        NValues -> do_object_parts(args, at, false)
        NEntries -> do_object_parts(args, at, true)
        NHas -> do_has(args, at)
        NSetTimeout -> do_timer(args, at, false)
        NSetInterval -> do_timer(args, at, true)
        NClearTimeout -> do_clear(args, at)
        NSleep -> do_sleep(args, at)
        NResolve -> do_settled(args, at, false)
        NReject -> do_settled(args, at, true)
        NPending -> do_pending(args, at)
        NSettle -> do_answer(args, at, false)
        NFail -> do_answer(args, at, true)
        NReadFile -> with_path(args, at, "readFile", read_file_promise)
        NReadBytes -> with_path(args, at, "readBytes", read_bytes_promise)
        NReadDir -> with_path(args, at, "readDir", read_dir_promise)
        NStat -> with_path(args, at, "stat", stat_promise)
        NExists -> with_path(args, at, "exists", exists_promise)
        NRemove -> with_path(args, at, "remove", remove_promise)
        NMkdir -> with_path(args, at, "mkdir", mkdir_promise)
        NRmdir -> with_path(args, at, "rmdir", rmdir_promise)
        NWriteFile -> do_write_file(args, at)
        NRename -> do_rename(args, at)

        // **The blocking ten go through the same argument checking as the others**, which is what
        // `with_path` taking a function pointer bought: a `Sync` builtin differs from its
        // asynchronous twin only in which function it hands over.
        NReadFileSync -> with_path(args, at, "readFileSync", read_file_sync)
        NReadBytesSync -> with_path(args, at, "readBytesSync", read_bytes_sync)
        NReadDirSync -> with_path(args, at, "readDirSync", read_dir_sync)
        NStatSync -> with_path(args, at, "statSync", stat_sync)
        NExistsSync -> with_path(args, at, "existsSync", exists_sync)
        NRemoveSync -> with_path(args, at, "removeSync", remove_sync)
        NMkdirSync -> with_path(args, at, "mkdirSync", mkdir_sync)
        NRmdirSync -> with_path(args, at, "rmdirSync", rmdir_sync)
        NWriteFileSync -> do_write_file_sync(args, at)
        NRenameSync -> do_rename_sync(args, at)
        NListen -> do_listen(args, at)
        NConnect -> do_connect(args, at)
        NOnData -> do_read(args, at, true)
        NOnBytes -> do_read(args, at, false)
        NSend -> do_send(args, at)
        NCloseSocket -> do_close(args, at)
        NLocalPort -> do_local_port(args, at)

        NNow -> do_now(args, at)
        NMonotonic -> do_monotonic(args, at)
        NDate -> do_date(args, at)
        NTime -> do_time(args, at)
        NDateTime -> do_date_time(args, at)
        NZone -> do_zone(args, at)
        NLocalZone -> do_local_zone(args, at)
        NInstant -> do_instant(args, at)
        NEpochSeconds -> do_epoch(args, at, 0)
        NEpochMillis -> do_epoch(args, at, 1)
        NEpochMicros -> do_epoch(args, at, 2)
        NMicros -> do_length(args, at, 0)
        NMillis -> do_length(args, at, 1)
        NSeconds -> do_length(args, at, 2)
        NMinutes -> do_length(args, at, 3)
        NHours -> do_length(args, at, 4)
        NDays -> do_calendar_length(args, at, 0)
        NWeeks -> do_calendar_length(args, at, 1)
        NMonths -> do_calendar_length(args, at, 2)
        NYears -> do_calendar_length(args, at, 3)
        NYear -> do_part(args, at, 0)
        NMonth -> do_part(args, at, 1)
        NDay -> do_part(args, at, 2)
        NHour -> do_part(args, at, 3)
        NMinute -> do_part(args, at, 4)
        NSecond -> do_part(args, at, 5)
        NWeekday -> do_part(args, at, 6)
        NMonthName -> do_part(args, at, 7)
        NDayOfYear -> do_part(args, at, 8)
        NDaysInMonth -> do_part(args, at, 9)
        NIsLeapYear -> do_part(args, at, 10)
        NAt -> do_at(args, at)
        NOffset -> do_offset(args, at)
        NIsDst -> do_is_dst(args, at)
        NAbbrev -> do_abbrev(args, at)
        NStartOf -> do_start_of(args, at)
        NOnOrAfter -> do_on_or_after(args, at)
        NFormat -> do_format(args, at)
        NParseDate -> do_parse_temporal(args, at, 0)
        NParseTime -> do_parse_temporal(args, at, 1)
        NParseDateTime -> do_parse_temporal(args, at, 2)
        NParseTimestamp -> do_parse_temporal(args, at, 3)
        NRegex -> do_regex(args, at)
        NReTest -> do_regex_test(args, at)
        NReFind -> do_regex_find(args, at)
        NReFindAll -> do_regex_find_all(args, at)
        NReReplace -> do_regex_replace(args, at)
        NReReplaceFirst -> do_regex_replace_first(args, at)
        NReSplit -> do_regex_split(args, at)
        NRePattern -> do_regex_pattern(args, at)
        NReFlags -> do_regex_flags(args, at)
        NRun -> do_run(args, at)
        NEnv -> do_env(args, at)
        NGenNext -> do_gen_next(args, at)
        NFetch -> do_fetch(args, at)

        NHttpParser -> do_http_parser(args, at)
        NHttpStream -> do_http_stream(args, at)
        NHttpFeed -> do_http_feed(args, at)
        NHttpTake -> do_http_take(args, at)
        NHttpTakePart -> do_http_take_part(args, at)
        NHttpFinish -> do_http_finish(args, at)
        NHttpClose -> do_http_close(args, at)
end call_native

// Whether these arguments begin with an array, which is what tells the array form of a shared name
// from the text one. A wrong first argument falls through to the text form and is complained about
// there, where the message already names what it wanted.
private first_is_array(args: Buf[Value]) -> bool
    if args.is_empty() then return false

    args.at(0) match
        Array(_) -> true
        _ -> false
end first_is_array

// -- what a test is written with -------------------------------------------------------------------

// `assert(condition)` and `assert(condition, message)`.
//
// **A failed assertion raises**, which is what makes the runner's job three lines: it calls the test
// and reads the `Err`, and the fault already carries the line and the file it was raised at.
private do_assert(args: Buf[Value], at: Span) -> Step
    if args.len() == 0 || args.len() > 2
        return fault(at, s"`assert` takes a condition and an optional message, and was given ${counted(args.len(), "argument")}")

    if args.at(0).truthy() then return Ok(Null)

    if args.len() == 2
        return fault(at, value_text(args.at(1)))

    fault(at, "this assertion does not hold")
end do_assert

// `assertEq(actual, expected)`.
//
// **Both sides are rendered into the message**, because the commonest thing a reader needs from a
// failed comparison is what the two were -- and a test that had to print them itself would be a test
// written twice.
private do_assert_eq(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 && args.len() != 3
        return fault(at, s"`assertEq` takes what was got, what was wanted, and an optional message -- it was given ${counted(args.len(), "argument")}")

    if same(args.at(0), args.at(1), at)? then return Ok(Null)

    val said = if args.len() == 3 then s"${value_text(args.at(2))}: " else ""

    fault(at, s"${said}got ${show_value(args.at(0))}, wanted ${show_value(args.at(1))}")
end do_assert_eq

// -- TCP ------------------------------------------------------------------------------------------

// A port, which a program writes as a number and nothing else.
private port_of(v: Value, at: Span, name: string) -> Result[long, Signal]
    v match
        Int(n) -> Ok(n)
        other -> Err(failure(at, s"`${name}` takes a port number, and this is ${other.type_name()}"))

private do_listen(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`listen` takes a port and a function, and was given ${counted(args.len(), "argument")}")

    val (port, secure) = listen_target(args.at(0), at)?

    listen_socket(port, secure, args.at(1), at)

private do_connect(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`connect` takes an address and a port, and was given ${counted(args.len(), "argument")}")

    args.at(0) match
        Str(p) -> connect_socket(p.s, port_of(args.at(1), at, "connect")?, at)
        other -> fault(at, s"`connect` takes an address, and this is ${other.type_name()}")

private do_read(args: Buf[Value], at: Span, as_text: bool) -> Step
    val name = if as_text then "onData" else "onBytes"

    if args.len() != 2 then return fault(at, s"`${name}` takes a socket and a function, and was given ${counted(args.len(), "argument")}")

    read_socket(args.at(0), args.at(1), as_text, at)

private do_send(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`send` takes a socket and what to send, and was given ${counted(args.len(), "argument")}")

    args.at(1) match
        Str(p) -> send_socket(args.at(0), p.s, at)

        // **An array is BYTES and not its own rendering.** `send(sock, [72, 105])` meaning the six
        // characters `[72, 105]` is not something anybody wants, and bytes are how a program sends
        // what is not text -- an image, a compressed body, a string it read with `onBytes` and never
        // decoded.
        Array(p) ->
            val payload = bytes_of(p, at, "send")?

            send_bytes(args.at(0), payload.view(), at)

        // Rendered as `print` would render it, which is the reading `writeFile` already takes.
        other -> send_socket(args.at(0), value_text(other), at)

private do_close(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`close` takes a socket and was given ${counted(args.len(), "argument")}")

    close_socket(args.at(0), at)

private do_local_port(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`localPort` takes a socket and was given ${counted(args.len(), "argument")}")

    local_port(args.at(0), at)

// The path a file-system builtin was given, or the complaint about what it was given instead.
//
// Not `private`: nothing outside needs it, but it is the shape every one of them shares and pulling
// it out is what keeps ten builtins from being ten copies of the same three lines.
private path_of(v: Value, at: Span, name: string) -> Result[string, Signal]
    v match
        Str(p) -> Ok(p.s)
        other -> Err(failure(at, s"`${name}` takes a path, and this is ${other.type_name()}"))

// The eight that take one path and nothing else.
//
// **A function pointer rather than eight arms**, which is what the shape is worth: each of them
// differs only in which libuv call it makes, and writing the argument check eight times is how the
// eighth one ends up saying something the other seven do not.
private with_path(args: Buf[Value], at: Span, name: string, go: &Fn(string, Span) -> Step) -> Step
    if args.len() != 1 then return fault(at, s"`${name}` takes one path and was given ${counted(args.len(), "argument")}")

    go(path_of(args.at(0), at, name)?, at)
end with_path

private do_write_file(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`writeFile` takes a path and its contents, and was given ${counted(args.len(), "argument")}")

    val path = path_of(args.at(0), at, "writeFile")?

    args.at(1) match
        Str(p) -> write_file_promise(path, p.s, at)

        // **Anything else is rendered as `print` would render it**, which is the reading a program
        // writing a number or an array to a file expects -- and the alternative, refusing everything
        // but a string, would make `writeFile(path, str(x))` the only spelling anybody ever wrote.
        other -> write_file_promise(path, value_text(other), at)
end do_write_file

private do_write_file_sync(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`writeFileSync` takes a path and its contents, and was given ${counted(args.len(), "argument")}")

    val path = path_of(args.at(0), at, "writeFileSync")?

    args.at(1) match
        Str(p) -> write_file_sync(path, p.s, at)
        other -> write_file_sync(path, value_text(other), at)

private do_rename_sync(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`renameSync` takes two paths and was given ${counted(args.len(), "argument")}")

    rename_sync(path_of(args.at(0), at, "renameSync")?, path_of(args.at(1), at, "renameSync")?, at)

private do_rename(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`rename` takes two paths and was given ${counted(args.len(), "argument")}")

    rename_promise(path_of(args.at(0), at, "rename")?, path_of(args.at(1), at, "rename")?, at)

// `sleep(ms)` -- a promise for later.
private do_sleep(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`sleep` takes a number of milliseconds and was given ${counted(args.len(), "argument")}")

    args.at(0) match
        Int(n) -> sleep_promise(n, at)
        Real(r) -> sleep_promise(long(r), at)

        // **A duration says what a bare number cannot**, and is why `sleep(2.seconds())` reads
        // better than `sleep(2000)`. The number form stays, being what node writes and what every
        // program here already says.
        DurationVal(us) -> sleep_promise(us / 1000, at)
        other -> fault(at, s"`sleep` takes a number of milliseconds or a duration, and this is ${other.type_name()}")
end do_sleep

// `resolve(v)` and `reject(message)` -- a promise that has already settled.
//
// **Worth having even though an `async` function makes both**, because the two are what a program
// reaches for when it is adapting something that is not async at all: a cache hit that needs to look
// like a lookup, a validation that fails before any work starts.
private do_settled(args: Buf[Value], at: Span, failing: bool) -> Step
    if args.len() != 1
        val what = if failing then "`reject`" else "`resolve`"

        return fault(at, s"${what} takes one argument and was given ${args.len()}")

    val mark = root_mark()
    val pr = new_promise()

    hold(Promise(pr))

    if failing then settle_err(pr, value_text(args.at(0)), at) else settle_ok(pr, args.at(0))

    release(mark)
    Ok(Promise(pr))
end do_settled

// `pending()` -- a promise nobody has answered yet -- and `settle(p, v)` and `fail(p, message)`,
// which answer it.
//
// **This is the bridge from a callback into `await`.** `resolve` and `reject` adapt something that
// has already happened; these adapt something that has not, which is the case a program cannot write
// its way out of: without them the only things awaitable are the ones slate itself started, and
// anything with a callback of its own -- a library that calls back when a download finishes, a queue
// handing out a job, the end of a request body -- stays in callbacks and cannot be awaited at all.
//
// **A promise settles once, and a second answer is dropped rather than refused.** That is
// `settle_ok`'s rule rather than a new one, and it is JavaScript's: two callbacks racing to answer
// one promise is a program deciding late, not a program in error.
private do_pending(args: Buf[Value], at: Span) -> Step
    if args.len() != 0
        return fault(at, s"`pending` takes no arguments and was given ${counted(args.len(), "argument")}")

    Ok(Promise(new_promise()))
end do_pending

private do_answer(args: Buf[Value], at: Span, failing: bool) -> Step
    val name = if failing then "fail" else "settle"

    if args.len() != 2
        return fault(at, s"`${name}` takes a promise and an answer, and was given ${counted(args.len(), "argument")}")

    val pr = args.at(0) match
        Promise(p) -> p
        other -> return fault(at, s"`${name}` answers a promise, and this is ${other.type_name()}")

    if failing then settle_err(pr, value_text(args.at(1)), at) else settle_ok(pr, args.at(1))

    Ok(Null)
end do_answer

// `setTimeout(fn, ms)`; the delay may be left out, and means the next turn of the loop.
private do_timer(args: Buf[Value], at: Span, repeating: bool) -> Step
    if args.len() == 0 || args.len() > 2
        return fault(at, s"a timer takes a function and a delay, and was given ${counted(args.len(), "argument")}")

    val ms = if args.len() == 2
        args.at(1) match
            Int(n) -> n
            Real(r) -> long(r)
            DurationVal(us) -> us / 1000
            other -> return fault(at, s"a delay is a number of milliseconds or a duration, and this is ${other.type_name()}")
    else
        0

    set_timer(args.at(0), ms, repeating, at)
end do_timer

private do_clear(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"cancelling a timer takes its id, and was given ${counted(args.len(), "argument")}")

    clear_timer(args.at(0), at)

// `print(a, b, ...)` -- every argument rendered, a space between, one line.
private do_print(args: Buf[Value]) -> Step
    var out = str_builder()

    for i in 0..<args.len()
        if i > 0 then out.push_char(' ')

        out.push(value_text(args.at(i)))

    output.push(out.finish())
    Ok(Null)
end do_print

// `len(x)` -- of an array, an object or a string.
private do_len(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`len` takes one argument and was given ${args.len()}")

    args.at(0) match
        Array(a) -> Ok(Int(long(a.items.len())))
        Object(o) -> Ok(Int(long(obj_len(o))))
        // **Characters, not bytes.** `len("日本語")` is three; it answered nine until the day the
        // rule was settled, and every slice taken from that count cut a character in half.
        Str(p) -> Ok(Int(long(char_count(p.s))))

        // How many whole numbers it covers, which is exactly how many turns a `for` over it takes.
        RangeVal(lo, hi, inclusive, has_lo, has_hi) ->
            if !has_lo || !has_hi
                return fault(at, "a range with an end left out has no length until it is used on something")

            Ok(Int(long(range_count(lo, hi, inclusive))))
        other -> fault(at, s"`len` needs an array, an object, a string or a range, and this is ${other.type_name()}")
end do_len

// `push(xs, v)` -- onto the end of an array, which it changes.
//
// **It answers nothing, as every mutator here does.** Handing the array back is what JavaScript does
// and is what makes `xs.push(1).push(2)` read like a pipeline over fresh values when it is two
// writes to one array; `array.sysl` carries the rule and the rest of the family.
private do_push(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`push` takes two arguments and was given ${args.len()}")

    args.at(0) match
        Array(a) ->
            keepable(args.at(1), at, "stored")?
            a.items.push(args.at(1))
            Ok(Null)
        other -> fault(at, s"`push` needs an array, and this is ${other.type_name()}")
end do_push

// `str(x)` -- what `print` would have shown.
private do_string(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`string` takes one argument and was given ${args.len()}")

    Ok(str_value(value_text(args.at(0))))

// `keys(o)` -- an object's field names, as an array of strings.
private do_keys(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`keys` takes one argument and was given ${args.len()}")

    args.at(0) match
        Object(o) ->
            // In the order the fields were first written, which the table preserves.
            Ok(Array(new_array(obj_keys(o))))
        other -> fault(at, s"`keys` needs an object, and this is ${other.type_name()}")
end do_keys

// Whether an object has a key at all.
//
// **This is the only way to tell an absent field from one holding `null`.** slate has one absent value
// where JavaScript has two, so reading answers `null` either way -- and the recovery is to ask the
// question rather than to read and inspect. Python draws the line in the same place with `in`, and Go
// with the second result of a map read.
private do_has(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`has` takes an object and a key, and was given ${counted(args.len(), "argument")}")

    args.at(0) match
        Object(o) -> Ok(Bool(obj_has(o, args.at(1), at)?))
        other -> fault(at, s"`has` needs an object, and this is ${other.type_name()}")
end do_has

// -- rendering ----------------------------------------------------------------------------------

// Whether a key may be written without quotes in an object literal.
//
// A key is any value now, so most of them have to be quoted or bracketed to read back. The ones that
// look like identifiers are the ones a program actually wrote as `{ name: ... }`.
// A string as slate's own literal syntax writes it, quotes included.
//
// **The printed form of a value has to be readable back, and it was not.** A `"` inside a string was
// emitted raw, so `["a"b"]` came out and is not a program; a backslash was emitted raw, so a string
// holding the two characters `\` and `f` printed as `"e\f"` and reads back as a formfeed. Both were
// there before keys could be quoted and are the same defect -- printing is not a debugging
// convenience if what comes out means something else when read.
//
// This is the inverse of the escape reading `sh.sysl.parsing`'s `read_quoted` does, restricted to
// what slate's lexer takes. **A backtick is deliberately NOT escaped, where `escape_text` escapes
// one**: that function is for a diagnostic, where a backtick would close the span a message quotes
// into, and `\`` is not an escape slate's lexer knows.
private quoted_text(text: string) -> string
    val b = text.bytes
    var out: Buf[u8] = buf()

    out.push(u8('"'))

    for i in 0..<b.len
        val c = b[i]

        if c == u8('"') then out.extend("\\\"".bytes)
        elif c == u8('\\') then out.extend("\\\\".bytes)
        elif c == u8('\n') then out.extend("\\n".bytes)
        elif c == u8('\r') then out.extend("\\r".bytes)
        elif c == u8('\t') then out.extend("\\t".bytes)
        elif c == u8('\0') then out.extend("\\0".bytes)
        elif is_control(c)
            out.extend("\\x".bytes)
            out.push(hex_nibble(c >> 4))
            out.push(hex_nibble(c & 15))
        else
            // **The byte is copied rather than rebuilt as a character.** A lead byte read as a
            // codepoint and re-encoded becomes two bytes of mojibake, so accented text in a key or a
            // value would come back as something else entirely.
            out.push(c)

    out.push(u8('"'))

    // A slate string is valid UTF-8 by construction -- it came from a literal the lexer read or from
    // bytes something else already validated -- and every byte above is either copied or ASCII.
    from_utf8_unchecked(out.view())
end quoted_text

private hex_nibble(v: u8) -> u8 = if v < 10 then v + u8('0') else v - 10 + u8('a')

// Whether a word is a name a program could write bare: name-shaped, and not one the lexer has its
// own meaning for.
//
// **Public only because `private` is private to the FILE in sysl**; `add.sysl` asks the same
// question about the key it is about to write into a manifest, and two answers to it would drift.
plain_name(s: string) -> bool
    val b = s.bytes

    if b.len == 0 then return false

    if !is_ident_start(b[0]) then return false

    for i in 1..<b.len
        if !is_ident_cont(b[i]) then return false

    // **A word the lexer would hand back as anything but an `Ident` may not print bare**, however
    // name-shaped it is. `{ if: 1 }` is not a program, so a key called `if` printed without quotes
    // is text slate cannot read back -- which was the case this check was missing.
    word_kind(b) == Tok.Ident
end plain_name

// A value as a program would print it.
//
// **A string prints bare at the top level and quoted inside a container**, which is what Python and
// Ruby both do and is worth the extra parameter: `print("hi")` showing `"hi"` is noise, and
// `print(["hi"])` showing `[hi]` loses the only thing that said it was a string.
value_text(v: Value) -> string
    var out = str_builder()
    var path: Buf[*u8] = buf()

    write_value(&out, v, false, &path)
    out.finish()

// The same, with a string quoted rather than bare.
//
// **What a failed comparison needs and `value_text` will not give it.** `got hi, wanted hi` says
// nothing about the two being a string and a number; `got "hi", wanted hi` says it at a glance.
show_value(v: Value) -> string
    var out = str_builder()
    var path: Buf[*u8] = buf()

    write_value(&out, v, true, &path)
    out.finish()

// Whether a container is already being written, further up this same walk.
//
// **What is recorded is the PATH, not everything seen, and the difference is a correctness one.** A
// value may appear twice over without the graph cycling at all -- `val x = [1]` and then
// `print([x, x])` -- and a set of everything seen so far would render the second occurrence as
// `[...]`, which is a lie about a perfectly finite structure. What makes a printer diverge is
// re-entering a container it has not finished writing, so that is the question this asks. Python's
// `repr` draws the line in the same place.
private on_path(path: *Buf[*u8], p: *u8) -> bool
    for i in 0..<path.len()
        if path.at(i) == p then return true

    false
end on_path

// A value, as written at the top level or inside a container.
//
// **A cycle renders as `[...]` rather than crashing, and it could not arise before the collector.**
// Reference counting could not free `a[0] = a`, so nothing in slate could build one; a tracing heap
// makes it an ordinary thing to write, and a printer that descends structurally then runs out of
// stack. That arrives as a bare SIGSEGV carrying no message and none of the output the program had
// already produced, which is filed against sysl as card 0299 -- but the descent is this function's
// to stop.
private write_value(out: *StrBuilder, v: Value, quoted: bool, path: *Buf[*u8])
    v match
        Null -> out.push("null")
        Undefined -> out.push("undefined")
        Bool(b) -> out.push_bool(b)
        Int(n) -> out.push_int(n)
        Real(n) -> out.push_real(n)
        Str(p) ->
            if quoted then out.push(quoted_text(p.s)) else out.push(p.s)
        Array(a) ->
            val here: *u8 = ptr_cast(a)

            if on_path(path, here)
                out.push("[...]")
            else
                path.push(here)
                out.push_char('[')

                for i in 0..<a.items.len()
                    if i > 0 then out.push(", ")

                    write_value(out, a.items.at(i), true, path)

                out.push_char(']')
                path.truncate(path.len() - 1)
        Object(o) ->
            val here: *u8 = ptr_cast(o)

            if on_path(path, here)
                out.push("{...}")
            else
                path.push(here)
                out.push_char('{')

                var first = true

                for i in 0..<o.entries.len()
                    val e = o.entries.at(i)

                    if !e.dead
                        if !first then out.push(", ")

                        // **A key prints bare when it is a plain name and quoted otherwise**, which
                        // is what JavaScript does: `{a: 1}` reads better than `{"a": 1}`, and a key
                        // that is not a name has to be distinguishable from one that is.
                        e.key match
                            Str(kp) -> if plain_name(kp.s) then out.push(kp.s) else write_value(out, e.key, true, path)
                            _ -> write_value(out, e.key, true, path)

                        out.push(": ")
                        write_value(out, e.value, true, path)
                        first = false

                out.push_char('}')
                path.truncate(path.len() - 1)
        RangeVal(lo, hi, inclusive, has_lo, has_hi) ->
            if has_lo then out.push_int(lo)

            out.push(if inclusive then ".." else "..<")

            if has_hi then out.push_int(hi)
        Fn(c) -> out.push(s"<function of ${c.params.len()}>")
        Promise(p) ->
            if !p.settled
                out.push("<promise pending>")
            elif p.failed
                out.push(s"<promise failed: ${p.message}>")
            else
                out.push("<promise ")
                write_value(out, p.value, true, path)
                out.push_char('>')
        // **Shown by its generation and not its slot**, since the slot is a position two sockets
        // may hold one after the other and the generation is the thing that names one of them.
        Socket(_, gen) ->
            out.push("<socket ")
            out.push_int(long(gen))
            out.push_char('>')

        // **Shown as it was written, between slashes**, which is how every language that has them
        // writes one and is the only rendering a reader can paste back.
        RegexVal(id) ->
            out.push_char('/')
            out.push(regex_source(id))
            out.push_char('/')
            out.push(regex_flags(id))

        // **Every temporal value prints as ISO 8601**, which is the one rendering that sorts as text
        // in the order it sorts as time -- and, for the four with no zone in them, is exactly what
        // `parseDate` and its siblings read back. A duration and a period have no ISO form worth
        // printing (`PT1H30M` is for machines and nothing here reads it), so those two are written
        // as a person states them.
        InstantVal(_) -> out.push(temporal_text(v))
        DurationVal(_) -> out.push(temporal_text(v))
        DateVal(_) -> out.push(temporal_text(v))
        TimeVal(_) -> out.push(temporal_text(v))
        DateTimeVal(_, _) -> out.push(temporal_text(v))
        ZoneVal(_) -> out.push(temporal_text(v))
        ZonedVal(_, _) -> out.push(temporal_text(v))
        PeriodVal(_, _) -> out.push(temporal_text(v))
        // **Shown by its stamp rather than its slot**, as a socket is: a spent slot is taken by the
        // next generator, and the stamp is the thing that names this one.
        Gen(_, stamp) ->
            out.push("<generator ")
            out.push_int(long(stamp))
            out.push_char('>')
        Native(f) -> out.push(s"<builtin ${f}>")
end write_value
