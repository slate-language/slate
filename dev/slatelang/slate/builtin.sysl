module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.text.{from_utf8_unchecked, str_builder, StrBuilder}

// The functions a slate program has without writing them.
//
// **Each is an ordinary value bound in the root scope**, so `val p = print` binds it and
// `apply(print, 1)` calls it. A builtin dispatched on the name at the call site would have been the
// one kind of function a program could not pass around, which in a language where functions are
// values is a hole rather than a simplification.
//
// **The LIST of them is in `natives.sysl` and how a value is PRINTED is in `render.sysl`.** What is
// here is the dispatch and the implementations: `call_native` and the `do_*` functions it reaches.
// Nothing private crosses either cut in either direction, which is what made both of them the cuts
// to make.
// Everything the program printed, in order.
//
// **Module storage, and the collector is what forced it.** A root function has to be a top-level
// function to have an address and has to reach the interpreter's state, so that state cannot be a
// local of anything -- which is one interpreter to a process, and this buffer with it. `run` clears
// it, which is what lets two programs run in one process.
var output: Buf[string] = buf()

// Whether the test now running asked to be left out, and the reason it gave.
//
// **Read by the runner rather than matched on the signal, and the asynchronous case is why.** A
// `skip` inside an `async` test travels out of the coroutine and settles its promise as a rejection,
// which keeps the sentence and loses which variant it was -- so the fact has to be written down where
// `skip` was called. `run_one_test` clears both before every test.
//
// Not `private`: `run.sysl` reads the verdict off these.
var skip_asked: bool = false
var skip_reason: string = ""

// **EVERY ARGUMENT IS ROOTED ACROSS THE CALL, AND THIS IS THE ONE PLACE THAT SAYS SO.** `args` is a
// sysl `Buf`, which the collector does not walk -- and a call has already popped the callee and its
// arguments off the operand stack by the time it gets here, so for the length of a native call the
// only thing holding them is this buffer. That is invisible for every builtin that answers without
// running slate code, and fatal for the ten or so that call back into it: `map` walks a receiver and
// calls a function, and a callback that allocates hard enough to collect frees BOTH of them.
//
// **What it looks like is never a memory failure.** `["a", "b", "c"].map(r -> burn(500))` failed with
// *"this array was changed while `map` was walking it"* about a literal nothing can reach; binding the
// array to a `val` moved the failure onto the callback -- *"this function takes from 1 to 0
// arguments"* -- because the freed slot had been taken by something else and read back as a function
// of a different arity. Binding both made it pass, and the JavaScript back end passed throughout.
//
// **Rooting here rather than in each `do_*` is the point.** The hole was in `map`, and it was in
// `filter`, `reduce`, `sort`, `find` and every other builtin that calls back -- one rule at the
// dispatch cannot be half-applied, where a rule written out per builtin already had been.
call_native(f: NativeFn, args: Buf[Value], at: Span) -> Step
    val mark = root_mark()

    for i in 0..<args.len()
        hold(args.at(i))

    val answer = dispatch_native(f, args, at)

    // Nothing allocates between here and the caller pushing the answer, which is the same window
    // every `do_*` already ends in.
    release(mark)
    answer
end call_native

private dispatch_native(f: NativeFn, args: Buf[Value], at: Span) -> Step
    f match
        NPrint -> do_print(args, at)
        NAssert -> do_assert(args, at)
        NAssertEq -> do_assert_eq(args, at)
        NSkip -> do_skip(args, at)

        NChars -> do_chars(args, at)
        NSplit -> do_split(args, at)
        NJoin -> do_join(args, at)
        // **Three names that answer about an array or about a string**, dispatched on what they
        // were given rather than duplicated under two spellings. A program asks the same question
        // of both, and `xs.contains(v)` and `s.contains(sub)` are the same word for the same reason.
        NContains -> if first_is_array(args) then do_array_contains(args, at) else do_contains(args, at)
        NIndexOf -> if first_is_array(args) then do_array_index_of(args, at, false) else do_index_of(args, at, false)
        NLastIndexOf -> if first_is_array(args) then do_array_index_of(args, at, true) else do_index_of(args, at, true)
        NStartsWith -> do_edge(args, at, true)
        NEndsWith -> do_edge(args, at, false)
        NTrim -> do_trim(args, at, true, true)
        NTrimStart -> do_trim(args, at, true, false)
        NTrimEnd -> do_trim(args, at, false, true)
        NUpper -> do_case(args, at, true)
        NLower -> do_case(args, at, false)
        NReplace -> do_replace(args, at)
        NRepeat -> do_repeat(args, at)

        NNumber -> do_number(args, at)
        NInteger -> do_integer(args, at)
        NReal -> do_real(args, at)
        NBoolean -> do_boolean(args, at)
        NAbs -> do_abs(args, at)
        NFloor -> do_round(args, at, 0)
        NCeil -> do_round(args, at, 1)
        NRound -> do_round(args, at, 2)
        NTrunc -> do_round(args, at, 3)
        NSqrt -> do_sqrt(args, at)
        NPow -> do_pow(args, at)
        NMin -> do_extreme(args, at, true)
        NMax -> do_extreme(args, at, false)
        NLen -> do_len(args, at)
        NPush -> do_push(args, at)
        NPop -> do_pop(args, at)
        NInsert -> do_insert(args, at)
        NRemoveAt -> do_remove_at(args, at)
        NClear -> do_clear_array(args, at)
        NMap -> do_map(args, at)
        NFilter -> do_filter(args, at)
        NReduce -> do_reduce(args, at)
        NFind -> do_find(args, at, false, false)
        NFindIndex -> do_find(args, at, true, false)
        NFindLast -> do_find(args, at, false, true)
        NFindLastIndex -> do_find(args, at, true, true)
        NSlice -> do_slice(args, at)
        NShift -> do_shift(args, at)
        NUnshift -> do_unshift(args, at)
        NFlatMap -> do_flat_map(args, at)
        NForEach -> do_for_each(args, at)
        NEvery -> do_quantify(args, at, true)
        NSome -> do_quantify(args, at, false)
        NSort -> do_sort(args, at, true)
        NSorted -> do_sort(args, at, false)
        NReverse -> do_reverse(args, at, true)
        NReversed -> do_reverse(args, at, false)
        NConcat -> do_concat(args, at)
        NFlat -> do_flat(args, at)
        NSum -> do_sum(args, at)
        NString -> do_string(args, at)
        NToString -> do_to_string(args, at)
        NEq -> do_eq(args, at, true)
        NNe -> do_eq(args, at, false)
        NEquals -> do_equals(args, at)
        NKeys -> do_keys(args, at)
        NParseJson -> do_parse_json(args, at)
        NToJson -> do_to_json(args, at)
        NToBytes -> do_to_bytes(args, at)
        NFromBytes -> do_from_bytes(args, at)
        NValues -> do_object_parts(args, at, false)
        NEntries -> do_object_parts(args, at, true)
        NHas -> do_has(args, at)
        NWithout -> do_without(args, at)
        NSetTimeout -> do_timer(args, at, false)
        NSetInterval -> do_timer(args, at, true)
        NClearTimeout -> do_clear(args, at)
        NSleep -> do_sleep(args, at)
        NResolve -> do_settled(args, at, false)
        NReject -> do_settled(args, at, true)
        NPending -> do_pending(args, at)
        NSettle -> do_answer(args, at, false)
        NFail -> do_answer(args, at, true)
        NReadFile -> with_path(args, at, "readFile", read_file_promise)
        NReadBytes -> with_path(args, at, "readBytes", read_bytes_promise)
        NReadDir -> with_path(args, at, "readDir", read_dir_promise)
        NStat -> with_path(args, at, "stat", stat_promise)
        NExists -> with_path(args, at, "exists", exists_promise)
        NRemove -> with_path(args, at, "remove", remove_promise)
        NMkdir -> with_path(args, at, "mkdir", mkdir_promise)
        NRmdir -> with_path(args, at, "rmdir", rmdir_promise)
        NWriteFile -> do_write_file(args, at)
        NStderr -> do_stderr(args, at)
        NAppendFile -> do_append_file(args, at)
        NRename -> do_rename(args, at)

        // **The blocking ten go through the same argument checking as the others**, which is what
        // `with_path` taking a function pointer bought: a `Sync` builtin differs from its
        // asynchronous twin only in which function it hands over.
        NReadFileSync -> with_path(args, at, "readFileSync", read_file_sync)
        NReadBytesSync -> with_path(args, at, "readBytesSync", read_bytes_sync)
        NReadDirSync -> with_path(args, at, "readDirSync", read_dir_sync)
        NStatSync -> with_path(args, at, "statSync", stat_sync)
        NExistsSync -> with_path(args, at, "existsSync", exists_sync)
        NRemoveSync -> with_path(args, at, "removeSync", remove_sync)
        NMkdirSync -> with_path(args, at, "mkdirSync", mkdir_sync)
        NRmdirSync -> with_path(args, at, "rmdirSync", rmdir_sync)
        NWriteFileSync -> do_write_file_sync(args, at)
        NAppendFileSync -> do_append_file_sync(args, at)
        NRenameSync -> do_rename_sync(args, at)
        NListen -> do_listen(args, at)
        NConnect -> do_connect(args, at)
        NOnData -> do_read(args, at, true)
        NOnBytes -> do_read(args, at, false)
        NOnError -> do_on_error(args, at)
        NSend -> do_send(args, at)
        NCloseSocket -> do_close(args, at)
        NLocalPort -> do_local_port(args, at)
        NRemoteAddress -> do_remote_address(args, at)
        NStartTls -> do_start_tls(args, at)
        NAlpnProtocol -> do_alpn_protocol(args, at)

        NNow -> do_now(args, at)
        NMonotonic -> do_monotonic(args, at)
        NDate -> do_date(args, at)
        NTime -> do_time(args, at)
        NDateTime -> do_date_time(args, at)
        NZone -> do_zone(args, at)
        NLocalZone -> do_local_zone(args, at)
        NInstant -> do_instant(args, at)
        NEpochSeconds -> do_epoch(args, at, 0)
        NEpochMillis -> do_epoch(args, at, 1)
        NEpochMicros -> do_epoch(args, at, 2)
        NMicros -> do_length(args, at, 0)
        NMillis -> do_length(args, at, 1)
        NSeconds -> do_length(args, at, 2)
        NMinutes -> do_length(args, at, 3)
        NHours -> do_length(args, at, 4)
        NDays -> do_calendar_length(args, at, 0)
        NWeeks -> do_calendar_length(args, at, 1)
        NMonths -> do_calendar_length(args, at, 2)
        NYears -> do_calendar_length(args, at, 3)
        NYear -> do_part(args, at, 0)
        NMonth -> do_part(args, at, 1)
        NDay -> do_part(args, at, 2)
        NHour -> do_part(args, at, 3)
        NMinute -> do_part(args, at, 4)
        NSecond -> do_part(args, at, 5)
        NWeekday -> do_part(args, at, 6)
        NMonthName -> do_part(args, at, 7)
        NDayOfYear -> do_part(args, at, 8)
        NDaysInMonth -> do_part(args, at, 9)
        NIsLeapYear -> do_part(args, at, 10)
        NAt -> do_at(args, at)
        NOffset -> do_offset(args, at)
        NIsDst -> do_is_dst(args, at)
        NAbbrev -> do_abbrev(args, at)
        NStartOf -> do_start_of(args, at)
        NOnOrAfter -> do_on_or_after(args, at)
        NFormat -> do_format(args, at)
        NParseDate -> do_parse_temporal(args, at, 0)
        NParseTime -> do_parse_temporal(args, at, 1)
        NParseDateTime -> do_parse_temporal(args, at, 2)
        NParseTimestamp -> do_parse_temporal(args, at, 3)
        NRegex -> do_regex(args, at)
        NReTest -> do_regex_test(args, at)
        NReFind -> do_regex_find(args, at)
        NReFindAll -> do_regex_find_all(args, at)
        NReReplace -> do_regex_replace(args, at)
        NReReplaceFirst -> do_regex_replace_first(args, at)
        NReSplit -> do_regex_split(args, at)
        NShapeTest -> do_shape_test(args, at)
        NShapeMismatch -> do_shape_mismatch(args, at)
        NShapeName -> do_shape_name(args, at)
        NRePattern -> do_regex_pattern(args, at)
        NReFlags -> do_regex_flags(args, at)
        NRun -> do_run(args, at)
        NEnv -> do_env(args, at)
        NExit -> do_exit(args, at)
        NOnSignal -> do_on_signal(args, at)
        NOffSignal -> do_off_signal(args, at)
        NGenNext -> do_gen_next(args, at)
        NFetch -> do_fetch(args, at)

        NHttpParser -> do_http_parser(args, at)
        NHttpStream -> do_http_stream(args, at)
        NHttpFeed -> do_http_feed(args, at)
        NHttpTake -> do_http_take(args, at)
        NHttpTakePart -> do_http_take_part(args, at)
        NHttpFinish -> do_http_finish(args, at)
        NHttpClose -> do_http_close(args, at)
        NHttpUpgraded -> do_http_upgraded(args, at)

        NH2Client -> do_h2_client(args, at)
        NH2Server -> do_h2_server(args, at)
        NH2Receive -> do_h2_receive(args, at)
        NH2Send -> do_h2_send(args, at)
        NH2Next -> do_h2_next(args, at)
        NH2Request -> do_h2_request(args, at)
        NH2Respond -> do_h2_respond(args, at)
        NH2RequestStream -> do_h2_request_stream(args, at)
        NH2RespondStream -> do_h2_respond_stream(args, at)
        NH2Push -> do_h2_push(args, at)
        NH2Finish -> do_h2_finish(args, at)
        NH2Settings -> do_h2_settings(args, at)
        NH2Goaway -> do_h2_goaway(args, at)
        NH2Reset -> do_h2_reset(args, at)
        NH2WindowUpdate -> do_h2_window_update(args, at)
        NH2Consume -> do_h2_consume(args, at)
        NH2Ping -> do_h2_ping(args, at)
        NH2Wants -> do_h2_wants(args, at)
        NH2Close -> do_h2_close(args, at)

        NHpackDeflater -> do_hpack_deflater(args, at)
        NHpackInflater -> do_hpack_inflater(args, at)
        NHpackDeflate -> do_hpack_deflate(args, at)
        NHpackInflate -> do_hpack_inflate(args, at)
        NHpackClose -> do_hpack_close(args, at)
        NBrotliCompress -> do_brotli_compress(args, at)
        NBrotliDecompress -> do_brotli_decompress(args, at)
        NGzip -> do_gzip(args, at)
        NGunzip -> do_gunzip(args, at)
        NDeflate -> do_deflate(args, at)
        NInflate -> do_inflate(args, at)

        // **One arm for twelve names, because the answer is the same and it is a refusal.** The
        // interpreter has no document; naming the builtin is what makes the sentence useful, and
        // `no_document` is where that name is turned into it.
        NDomCreateElement -> no_document(at, "createElement")
        NDomCreateText -> no_document(at, "createText")
        NDomSetAttribute -> no_document(at, "setAttribute")
        NDomRemoveAttribute -> no_document(at, "removeAttribute")
        NDomSetProperty -> no_document(at, "setProperty")
        NDomOn -> no_document(at, "on")
        NDomOff -> no_document(at, "off")
        NDomSetChildren -> no_document(at, "setChildren")
        NDomInsertBefore -> no_document(at, "insertBefore")
        NDomRemoveChild -> no_document(at, "removeChild")
        NDomSetText -> no_document(at, "setText")
        NDomById -> no_document(at, "byId")
        NDomQuery -> no_document(at, "query")
        NDomChildren -> no_document(at, "children")
        NDomTagName -> no_document(at, "tagName")
        NDomNodeText -> no_document(at, "nodeText")
        NDomAttribute -> no_document(at, "attribute")
        NDomMarkup -> no_document(at, "markup")
        NDomRelease -> no_document(at, "release")

        // **The page's other three doors say which one is missing**, rather than all saying
        // "document": a program reaching for `stored` has not misunderstood the document, it has
        // written something that only a browser can run.
        NDomLocation -> no_page(at, "location", "location")
        NDomPushPath -> no_page(at, "pushPath", "history")
        NDomReplacePath -> no_page(at, "replacePath", "history")
        NDomBack -> no_page(at, "back", "history")
        NDomForward -> no_page(at, "forward", "history")
        NDomOnNavigate -> no_page(at, "onNavigate", "history")
        NDomStored -> no_page(at, "stored", "localStorage")
        NDomStore -> no_page(at, "store", "localStorage")
        NDomUnstore -> no_page(at, "unstore", "localStorage")
        NDomStoredKeys -> no_page(at, "storedKeys", "localStorage")
        NDomClearStored -> no_page(at, "clearStored", "localStorage")

        NPasswordHash -> do_password_hash(args, at, false)
        NPasswordHashStrong -> do_password_hash(args, at, true)
        NPasswordCheck -> do_password_check(args, at)
        NPasswordNeedsRehash -> do_password_needs_rehash(args, at)

        NRedisReader -> do_redis_reader(args, at)
        NRedisFeed -> do_redis_feed(args, at)
        NRedisTake -> do_redis_take(args, at)
        NRedisCommand -> do_redis_command(args, at)
        NRedisClose -> do_redis_close(args, at)

        NHostHas -> do_host_has(args, at)

        // **A host that has no `WebSocket` of its own says so through `hostHas` rather than through
        // these**, so nothing reaches them here: `slate:ws` asks first and takes its own path. They
        // refuse anyway, because a name that is declared and does nothing is worse than one that is
        // not there.
        NWsOpen -> no_host_socket(at, "wsOpen")
        NWsSend -> no_host_socket(at, "wsSend")
        NWsSendBytes -> no_host_socket(at, "wsSendBytes")
        NWsOnMessage -> no_host_socket(at, "wsOnMessage")
        NWsOnClose -> no_host_socket(at, "wsOnClose")
        NWsClose -> no_host_socket(at, "wsClose")

        NJwsSign -> do_jws_sign(args, at)
        NJwsVerify -> do_jws_verify(args, at)

        NMd5 -> do_digest(args, at, "md5", "MD5")
        NSha1 -> do_digest(args, at, "sha1", "SHA-1")
        NSha256 -> do_digest(args, at, "sha256", "SHA-256")
        NSha384 -> do_digest(args, at, "sha384", "SHA-384")
        NSha512 -> do_digest(args, at, "sha512", "SHA-512")
        NHmac -> do_hmac(args, at)
        NPbkdf2 -> do_pbkdf2(args, at)
        NRandomBytes -> do_random_bytes(args, at)
        NTimingSafeEqual -> do_timing_safe_equal(args, at)
end dispatch_native

// Whether these arguments begin with an array, which is what tells the array form of a shared name
// from the text one. A wrong first argument falls through to the text form and is complained about
// there, where the message already names what it wanted.
private first_is_array(args: Buf[Value]) -> bool
    if args.is_empty() then return false

    args.at(0) match
        Array(_) -> true
        _ -> false
end first_is_array

// -- what a test is written with -------------------------------------------------------------------

// `assert(condition)` and `assert(condition, message)`.
//
// **A failed assertion raises**, which is what makes the runner's job three lines: it calls the test
// and reads the `Err`, and the fault already carries the line and the file it was raised at.
private do_assert(args: Buf[Value], at: Span) -> Step
    if args.len() == 0 || args.len() > 2
        return fault(at, s"`assert` takes a condition and an optional message, and was given ${counted(args.len(), "argument")}")

    if args.at(0).truthy() then return Ok(Null)

    if args.len() == 2
        return fault(at, printed(args.at(1), at)?)

    fault(at, "this assertion does not hold")
end do_assert

// `skip(reason)` -- this test is not going to run here, and why.
//
// **It raises, which is `assert`'s design and matters more here.** A `skip` that merely recorded
// something would leave the rest of the test running, so every use of it would be `skip(...)` and a
// `return` on the next line -- and the day somebody forgets the `return` the test runs on a host it
// was written to be left out of and fails there for a reason nobody can read.
//
// **A reason is required.** A test left out with nothing said is one nobody ever puts back.
private do_skip(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`skip` takes the reason this test is being left out, and was given ${counted(args.len(), "argument")}")

    args.at(0) match
        Str(p) ->
            skip_asked = true
            skip_reason = p.s
            skipped(at, p.s)
        other -> fault(at, s"`skip` takes a reason as text, and this is ${other.type_name()}")
end do_skip

// `assertEq(actual, expected)`.
//
// **Both sides are rendered into the message**, because the commonest thing a reader needs from a
// failed comparison is what the two were -- and a test that had to print them itself would be a test
// written twice.
private do_assert_eq(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 && args.len() != 3
        return fault(at, s"`assertEq` takes what was got, what was wanted, and an optional message -- it was given ${counted(args.len(), "argument")}")

    if same(args.at(0), args.at(1), at)? then return Ok(Null)

    val said = if args.len() == 3 then s"${value_text(args.at(2))}: " else ""

    fault(at, s"${said}got ${show_value(args.at(0))}, wanted ${show_value(args.at(1))}")
end do_assert_eq

// -- TCP ------------------------------------------------------------------------------------------

// A port, which a program writes as a number and nothing else.
private port_of(v: Value, at: Span, name: string) -> Result[long, Signal]
    v match
        Int(n) -> Ok(n)
        other -> Err(failure(at, s"`${name}` takes a port number, and this is ${other.type_name()}"))

private do_listen(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`listen` takes a port and a function, and was given ${counted(args.len(), "argument")}")

    val (port, secure) = listen_target(args.at(0), at)?

    listen_socket(port, secure, args.at(1), at)

private do_connect(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`connect` takes an address and a port, and was given ${counted(args.len(), "argument")}")

    args.at(0) match
        Str(p) -> connect_socket(p.s, port_of(args.at(1), at, "connect")?, at)
        other -> fault(at, s"`connect` takes an address, and this is ${other.type_name()}")

private do_read(args: Buf[Value], at: Span, as_text: bool) -> Step
    val name = if as_text then "onData" else "onBytes"

    if args.len() != 2 then return fault(at, s"`${name}` takes a socket and a function, and was given ${counted(args.len(), "argument")}")

    read_socket(args.at(0), args.at(1), as_text, at)

private do_on_error(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`onError` takes a socket and a function, and was given ${counted(args.len(), "argument")}")

    error_socket(args.at(0), args.at(1), at)

private do_send(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`send` takes a socket and what to send, and was given ${counted(args.len(), "argument")}")

    args.at(1) match
        Str(p) -> send_socket(args.at(0), p.s, at)

        // **An array is BYTES and not its own rendering.** `send(sock, [72, 105])` meaning the six
        // characters `[72, 105]` is not something anybody wants, and bytes are how a program sends
        // what is not text -- an image, a compressed body, a string it read with `onBytes` and never
        // decoded.
        Array(p) ->
            val payload = bytes_of(p, at, "send")?

            send_bytes(args.at(0), payload.view(), at)

        // Rendered as `print` would render it, which is the reading `writeFile` already takes.
        other -> send_socket(args.at(0), printed(other, at)?, at)

private do_close(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`close` takes a socket and was given ${counted(args.len(), "argument")}")

    close_socket(args.at(0), at)

// `alpnProtocol(conn)` -- the name the two ends agreed on, or `null` where there is none.
private do_alpn_protocol(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`alpnProtocol` takes a connection and was given ${counted(args.len(), "argument")}")

    alpn_protocol(args.at(0), at)
end do_alpn_protocol

private do_local_port(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`localPort` takes a socket and was given ${counted(args.len(), "argument")}")

    local_port(args.at(0), at)

// `remoteAddress(conn)` -- the IP at the other end, or `null` where there is no other end.
private do_remote_address(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`remoteAddress` takes a connection and was given ${counted(args.len(), "argument")}")

    remote_address(args.at(0), at)

private do_start_tls(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`startTls` takes a socket and the host to connect as, and was given ${counted(args.len(), "argument")}")

    start_tls_target(args.at(1), at)? match
        AsClient(host, trust, alpn) -> start_tls_socket(args.at(0), host, trust.view(), alpn.view(), at)
        AsServer(certificate, key, alpn) -> present_tls_socket(args.at(0), certificate.view(), key.view(), alpn.view(), at)

// The path a file-system builtin was given, or the complaint about what it was given instead.
//
// Not `private`: nothing outside needs it, but it is the shape every one of them shares and pulling
// it out is what keeps ten builtins from being ten copies of the same three lines.
private path_of(v: Value, at: Span, name: string) -> Result[string, Signal]
    v match
        Str(p) -> Ok(p.s)
        other -> Err(failure(at, s"`${name}` takes a path, and this is ${other.type_name()}"))

// The eight that take one path and nothing else.
//
// **A function pointer rather than eight arms**, which is what the shape is worth: each of them
// differs only in which libuv call it makes, and writing the argument check eight times is how the
// eighth one ends up saying something the other seven do not.
private with_path(args: Buf[Value], at: Span, name: string, go: &Fn(string, Span) -> Step) -> Step
    if args.len() != 1 then return fault(at, s"`${name}` takes one path and was given ${counted(args.len(), "argument")}")

    go(path_of(args.at(0), at, name)?, at)
end with_path

private do_write_file(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`writeFile` takes a path and its contents, and was given ${counted(args.len(), "argument")}")

    val path = path_of(args.at(0), at, "writeFile")?

    args.at(1) match
        Str(p) -> write_file_promise(path, p.s, at)

        // **Anything else is rendered as `print` would render it**, which is the reading a program
        // writing a number or an array to a file expects -- and the alternative, refusing everything
        // but a string, would make `writeFile(path, str(x))` the only spelling anybody ever wrote.
        other -> write_file_promise(path, printed(other, at)?, at)
end do_write_file

// `stderr(text)` -- one line on the diagnostic stream.
//
// **Straight to the descriptor rather than over libuv, and it answers nothing.** A complaint is the
// one thing a program may need to have said before the next line runs -- a crash after an `await`
// would lose it -- and every other way of writing here is asynchronous. `print` is synchronous for
// the same reason and this is `print`'s sibling.
//
// **The newline is the caller's**, as node's `process.stderr.write` leaves it: a program writing a
// JSON object per line and one writing a progress bar want different answers, and only one of them
// can be the default.
private do_stderr(args: Buf[Value], at: Span) -> Step
    var out = str_builder()

    for i in 0..<args.len()
        if i > 0 then out.push_char(' ')

        out.push(printed(args.at(i), at)?)

    eprints(out.finish())
    Ok(Null)
end do_stderr

// `appendFile(path, text)` -- `writeFile` that adds rather than replaces.
private do_append_file(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`appendFile` takes a path and what to add, and was given ${counted(args.len(), "argument")}")

    val path = path_of(args.at(0), at, "appendFile")?

    args.at(1) match
        Str(p) -> append_file_promise(path, p.s, at)
        other -> append_file_promise(path, printed(other, at)?, at)
end do_append_file

private do_write_file_sync(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`writeFileSync` takes a path and its contents, and was given ${counted(args.len(), "argument")}")

    val path = path_of(args.at(0), at, "writeFileSync")?

    args.at(1) match
        Str(p) -> write_file_sync(path, p.s, at)
        other -> write_file_sync(path, printed(other, at)?, at)

// `appendFileSync(path, text)` -- `appendFile` for a program that is not on the loop.
//
// **Every operation `slate:fs` has answers under a `Sync` suffix, and this one did not.** The page
// says every one has a blocking twin, ten of them had, and the eleventh arrived with the promise
// half alone -- so a sink, which answers nothing and cannot await, had no way to write a line and
// know it had landed.
private do_append_file_sync(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`appendFileSync` takes a path and what to add, and was given ${counted(args.len(), "argument")}")

    val path = path_of(args.at(0), at, "appendFileSync")?

    args.at(1) match
        Str(p) -> append_file_sync(path, p.s, at)
        other -> append_file_sync(path, printed(other, at)?, at)

private do_rename_sync(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`renameSync` takes two paths and was given ${counted(args.len(), "argument")}")

    rename_sync(path_of(args.at(0), at, "renameSync")?, path_of(args.at(1), at, "renameSync")?, at)

private do_rename(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`rename` takes two paths and was given ${counted(args.len(), "argument")}")

    rename_promise(path_of(args.at(0), at, "rename")?, path_of(args.at(1), at, "rename")?, at)

// `sleep(ms)` -- a promise for later.
private do_sleep(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`sleep` takes a number of milliseconds and was given ${counted(args.len(), "argument")}")

    args.at(0) match
        Int(n) -> sleep_promise(n, at)
        Real(r) -> sleep_promise(long(r), at)

        // **A duration says what a bare number cannot**, and is why `sleep(2.seconds())` reads
        // better than `sleep(2000)`. The number form stays, being what node writes and what every
        // program here already says.
        DurationVal(us) -> sleep_promise(us / 1000, at)
        other -> fault(at, s"`sleep` takes a number of milliseconds or a duration, and this is ${other.type_name()}")
end do_sleep

// `resolve(v)` and `reject(message)` -- a promise that has already settled.
//
// **Worth having even though an `async` function makes both**, because the two are what a program
// reaches for when it is adapting something that is not async at all: a cache hit that needs to look
// like a lookup, a validation that fails before any work starts.
private do_settled(args: Buf[Value], at: Span, failing: bool) -> Step
    if args.len() != 1
        val what = if failing then "`reject`" else "`resolve`"

        return fault(at, s"${what} takes one argument and was given ${args.len()}")

    val mark = root_mark()
    val pr = new_promise()

    hold(Promise(pr))

    if failing then settle_err(pr, printed(args.at(0), at)?, at) else settle_ok(pr, args.at(0))

    release(mark)
    Ok(Promise(pr))
end do_settled

// `pending()` -- a promise nobody has answered yet -- and `settle(p, v)` and `fail(p, message)`,
// which answer it.
//
// **This is the bridge from a callback into `await`.** `resolve` and `reject` adapt something that
// has already happened; these adapt something that has not, which is the case a program cannot write
// its way out of: without them the only things awaitable are the ones slate itself started, and
// anything with a callback of its own -- a library that calls back when a download finishes, a queue
// handing out a job, the end of a request body -- stays in callbacks and cannot be awaited at all.
//
// **A promise settles once, and a second answer is dropped rather than refused.** That is
// `settle_ok`'s rule rather than a new one, and it is JavaScript's: two callbacks racing to answer
// one promise is a program deciding late, not a program in error.
private do_pending(args: Buf[Value], at: Span) -> Step
    if args.len() != 0
        return fault(at, s"`pending` takes no arguments and was given ${counted(args.len(), "argument")}")

    Ok(Promise(new_promise()))
end do_pending

private do_answer(args: Buf[Value], at: Span, failing: bool) -> Step
    val name = if failing then "fail" else "settle"

    if args.len() != 2
        return fault(at, s"`${name}` takes a promise and an answer, and was given ${counted(args.len(), "argument")}")

    val pr = args.at(0) match
        Promise(p) -> p
        other -> return fault(at, s"`${name}` answers a promise, and this is ${other.type_name()}")

    if failing then settle_err(pr, printed(args.at(1), at)?, at) else settle_ok(pr, args.at(1))

    Ok(Null)
end do_answer

// `setTimeout(fn, ms)`; the delay may be left out, and means the next turn of the loop.
private do_timer(args: Buf[Value], at: Span, repeating: bool) -> Step
    if args.len() == 0 || args.len() > 2
        return fault(at, s"a timer takes a function and a delay, and was given ${counted(args.len(), "argument")}")

    val ms = if args.len() == 2
        args.at(1) match
            Int(n) -> n
            Real(r) -> long(r)
            DurationVal(us) -> us / 1000
            other -> return fault(at, s"a delay is a number of milliseconds or a duration, and this is ${other.type_name()}")
    else
        0

    set_timer(args.at(0), ms, repeating, at)
end do_timer

private do_clear(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"cancelling a timer takes its id, and was given ${counted(args.len(), "argument")}")

    clear_timer(args.at(0), at)

// `print(a, b, ...)` -- every argument rendered, a space between, one line.
private do_print(args: Buf[Value], at: Span) -> Step
    var out = str_builder()

    for i in 0..<args.len()
        if i > 0 then out.push_char(' ')

        out.push(printed(args.at(i), at)?)

    output.push(out.finish())
    Ok(Null)
end do_print

// `len(x)` -- of an array, an object or a string.
private do_len(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`len` takes one argument and was given ${args.len()}")

    args.at(0) match
        Array(a) -> Ok(Int(long(a.items.len())))
        Object(o) -> Ok(Int(long(obj_len(o))))
        // **Characters, not bytes.** `len("日本語")` is three; it answered nine until the day the
        // rule was settled, and every slice taken from that count cut a character in half.
        Str(p) -> Ok(Int(long(char_count(p.s))))

        // How many whole numbers it covers, which is exactly how many turns a `for` over it takes.
        RangeVal(lo, hi, inclusive, has_lo, has_hi) ->
            if !has_lo || !has_hi
                return fault(at, "a range with an end left out has no length until it is used on something")

            Ok(Int(long(range_count(lo, hi, inclusive))))
        other -> fault(at, s"`len` needs an array, an object, a string or a range, and this is ${other.type_name()}")
end do_len

// `push(xs, v)` -- onto the end of an array, which it changes.
//
// **It answers nothing, as every mutator here does.** Handing the array back is what JavaScript does
// and is what makes `xs.push(1).push(2)` read like a pipeline over fresh values when it is two
// writes to one array; `array.sysl` carries the rule and the rest of the family.
private do_push(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`push` takes two arguments and was given ${args.len()}")

    args.at(0) match
        Array(a) ->
            keepable(args.at(1), at, "stored")?
            a.items.push(args.at(1))
            Ok(Null)
        other -> fault(at, s"`push` needs an array, and this is ${other.type_name()}")
end do_push

// `str(x)` -- what `print` would have shown.
private do_string(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`string` takes one argument and was given ${args.len()}")

    Ok(str_value(printed(args.at(0), at)?))

// `v.toString()` -- what `print` would show, and what a class may say for itself.
//
// **Reached only where the value has no `toString` of its own**, the universal table being the last
// thing a method lookup tries -- so this never recurses into the hook that would have replaced it.
private do_to_string(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`toString` takes no arguments and was given ${args.len() - 1}")

    Ok(str_value(printed(args.at(0), at)?))

// `a.eq(b)` and `a.ne(b)` -- the same OBJECT, not the same shape.
private do_eq(args: Buf[Value], at: Span, want: bool) -> Step
    if args.len() != 2 then return fault(at, s"`${if want then "eq" else "ne"}` takes one argument and was given ${args.len() - 1}")

    Ok(Bool(identical(args.at(0), args.at(1), at) == want))

// `a.equals(b)` -- `==` under its own name, hooks and all.
//
// **The two may not disagree**, which is why this is `same` rather than a second reading of it: a
// class that writes an `equals` changes both at once, and a class that writes none gets identity from
// both because that is what `same` now does for a nominal value.
private do_equals(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`equals` takes one argument and was given ${args.len() - 1}")

    Ok(Bool(same(args.at(0), args.at(1), at)?))

// `keys(o)` -- an object's field names, as an array of strings.
private do_keys(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`keys` takes one argument and was given ${args.len()}")

    args.at(0) match
        Object(o) ->
            // In the order the fields were first written, which the table preserves.
            Ok(Array(new_array(obj_keys(o))))
        other -> fault(at, s"`keys` needs an object, and this is ${other.type_name()}")
end do_keys

// Whether an object has a key at all.
//
// **This is the only way to tell an absent field from one holding `null`.** slate has one absent value
// where JavaScript has two, so reading answers `null` either way -- and the recovery is to ask the
// question rather than to read and inspect. Python draws the line in the same place with `in`, and Go
// with the second result of a map read.
private do_has(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`has` takes an object and a key, and was given ${counted(args.len(), "argument")}")

    args.at(0) match
        // **A key the walks hide is a key the object does not have**, so `has(p, "proto")` on a class
        // instance is false where `keys(p)` no longer lists it. Two answers to one question is what
        // the four walks had between them before this.
        Object(o) ->
            if !walked_key(o, args.at(1)) then return Ok(Bool(false))

            Ok(Bool(obj_has(o, args.at(1), at)?))
        other -> fault(at, s"`has` needs an object, and this is ${other.type_name()}")
end do_has

// `without(o, key)` -- the object again, with that key gone.
//
// **A NEW object, because a slate object's shape is not a thing a program changes in place.** `with`
// is the other half of this and answers a copy for the same reason; a `delete` writing through the
// value would make every name holding it see the field go, which is the surprise `with` was built to
// avoid.
//
// **A key that is not there is not an error**, so `without` is idempotent and a program removing a
// key it is unsure of writes one line. **A data value's copy is a data value**, exactly as `with`'s
// is -- and a hidden key cannot be removed, there being nothing there to a program that asks.
private do_without(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`without` takes an object and a key, and was given ${counted(args.len(), "argument")}")

    args.at(0) match
        Object(fields) ->
            val key = args.at(1)
            val mark = root_mark()
            val o = new_object()

            hold(Object(o))

            for i in 0..<fields.entries.len()
                val e = fields.entries.at(i)

                if !e.dead && !(walked_key(fields, e.key) && same(e.key, key, at)?)
                    obj_put(o, e.key, e.value, at)?

            // Set last, the writes above being how the copy was filled -- `WithObject`'s own
            // ordering and for its reason.
            o.frozen = fields.frozen

            release(mark)
            Ok(Object(o))
        other -> fault(at, s"`without` needs an object, and this is ${other.type_name()}")
end do_without


// The sentence a program gets for reaching a `slate:dom` name where there is no document.
//
// **It says which host it is running in**, because the mistake is nearly always the command rather
// than the code: the same program is correct in a browser and this one sentence is the whole of the
// difference. `slate js` is named because it is the answer.
no_document(at: Span, name: string) -> Step =
    fault(at, s"`${name}` needs a document, and the interpreter has none -- `slate:dom` is for a program compiled with `slate js` and loaded by a page")

// The same refusal for the three things a browser has that are not the document.
//
// **It names WHICH one**, because they are three different mistakes: `location` is a program asking
// where it is, `history` is one asking to move, and `localStorage` is one asking to remember. A
// single sentence about "a document" would send all three readers to look at the same wrong thing.
//
// Not `private`: `builtin.sysl` is where the dispatch is, and this is beside `no_document` for the
// reason that one is.
no_page(at: Span, name: string, what: string) -> Step =
    fault(at, s"`${name}` needs a browser's `${what}`, and the interpreter is not a browser -- `slate:dom` is for a program compiled with `slate js` and loaded by a page")
