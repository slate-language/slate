module dev.slatelang.slate

import sh.sysl.gc
import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}

// The collected heap, and the objects in it.
//
// **Reference counting cannot free a cycle, and slate makes one on every named function.** `define`
// binds a closure into the very scope that closure captured, so the scope holds the closure and the
// closure holds the scope. Nothing declared that back-edge, so `weak` cannot help: it is a cycle in
// somebody else's program, which is the case `sh.sysl.gc` exists for.
//
// ## What is collected and what is not
//
// **The collector manages exactly what refcounting cannot.** A string, an array, an object, a
// closure and a scope are collected, because a value graph made of them can cycle. The *tree* is
// not: an `Expr` is immutable and acyclic, so ARC frees it correctly and it stays where it is.
//
// A slate string is a GC object holding a sysl `string`, which its finalizer releases -- so a string
// takes part in the collector's lifetime the way Go's does, without this file reimplementing every
// string operation over raw bytes. The same bargain gives an array its `Buf` and an object its
// `Map`.
//
// **`Value` therefore holds no reference-counted member at all**: scalars and raw pointers, nothing
// else. That is what lets one be stored into GC memory, copied into a `Buf`, and passed around with
// no ARC traffic on the interpreter's hot path.

// How many bytes the collected heap gets.
//
// One block, fixed at startup -- there is no growing, and `alloc` answers null when it is full. It is
// a static rather than a `malloc` so that nothing here needs an allocator to start.
//
// **Four megabytes was the first number and it was too small to build anything with**: about twelve
// thousand objects with a proto, fewer than a program reading a modest CSV would make. This holds
// something over four hundred thousand.
//
// **THE SIZE USED TO COST BUILD TIME, AND THAT WAS A SYSL DEFECT RATHER THAN A FACT ABOUT SLATE.**
// Compiling this file once took time proportional to the size of the array -- 12 s at 4 MiB, 116 s at
// 64, and 256 MiB never finished -- though the array is zero-initialised and the linker emits it as
// BSS, so the binary never grew. `StaticEmitter.constantValue` lowered `[0; N]` as `List.fill(N)` of
// the element constant, handing LLVM an N-element array literal where `zeroinitializer` says the same
// thing in one word.
//
// **Fixed in sysl 0.0.86, card 0319, and confirmed from this end.** The IR is now flat: 5,129,651
// bytes at 4 MiB against 5,129,657 at 256 MiB, a difference of six -- the digits in the number. The
// global reads `[268435456 x i8] zeroinitializer` and the whole build takes ten seconds.
//
// **It reproduced only on MODULE storage.** The same declaration inside a function is a body local and
// lowers to an `alloca` and a fill loop, flat at every size -- sysl's first reduction was a single
// entry file and showed nothing, which nearly sent the diagnosis the other way. `storage` below is
// module storage precisely because the collector's root function needs an address, so slate could not
// have avoided it.
//
// **Zero-filled, so it is BSS**: the pages cost address space and are committed by the operating
// system only as they are touched. A program that uses a megabyte pays for a megabyte.
private const HeapBytes: usize = 268435456

private var storage: [HeapBytes]u8 = [0u8; HeapBytes]

// The one heap. **Module storage, and the collector's design is what forces it**: a root function
// must be a top-level function to have an address, and it has to reach the interpreter's state, so
// that state cannot be a local of anything. One interpreter to a process is the consequence.
var slate_heap: gc.Heap = gc.heap(&storage[0], HeapBytes)

// How much of that block a program may actually have.
//
// **The array is the ceiling and this is the setting**, which is what lets a test about running out
// of memory run out of a small one. Filling 256 MiB to find out what happens at the end of it takes
// nearly five seconds; filling one takes no time at all, and the behaviour under test is the same
// either way. Nothing but the suite changes it, and `run` puts it back.
var heap_limit: usize = HeapBytes

// Give the next program a heap of this size. `reset_heap` is what acts on it.
set_heap_limit(bytes: usize)
    heap_limit = if bytes > HeapBytes then HeapBytes else bytes

// -- the objects --------------------------------------------------------------------------------

// A slate string. Immutable, as Go's is, so nothing ever writes through one.
//
// **The GC object is the sysl string's ONLY owner, and that is the point of the arrangement.**
// `new_str` takes the string by value and stores it; the caller's copy dies with the caller's frame,
// which drops the count to one -- the one inside this object. From then on nothing but the
// collector decides when those bytes go, and `finalize_str` is what takes the count to zero. A
// caller that squirrels a second copy away somewhere would break exactly that, which is why nothing
// in slate holds a sysl `string` for a slate string value: a `Value` holds a `*StrObj` and nothing
// else.
struct StrObj
    s: string

// A slate array. Its elements are `Value`s, which is what `trace` walks.
struct ArrayObj
    items: Buf[Value]

// A slate object: a record, keyed by any value at all.
//
// **The layout is `table.sysl`'s compact dict**, so the fields keep the order they were written in
// and the tracer below is a linear walk rather than a walk of somebody else's container.
struct ObjectObj
    entries: Buf[Entry]
    index: Buf[usize]

    // How many entries are not tombstones.
    live: usize

    // Whether this object is a DATA VALUE, which does not change.
    //
    // **A field rather than a question asked of the proto chain**, which is what the alternative
    // would have been: a walk on every field write, paid by every object, to answer something that
    // is settled the moment the object is built.
    frozen: bool

// A function and the scope it was written in.
//
// **The scope is the whole of what makes it a closure**, and the reason this file exists: a function
// that outlives the call that made it keeps that scope alive, and a named function's scope holds the
// function.
struct ClosureObj
    params: Buf[string]

    // An index into `bodies`, not an `Expr`: a counted box may not live in raw GC memory.
    body: usize

    scope: *EnvObj

// A value that is not there yet.
//
// **It is a collected object like any other, and it has to be**: a promise outlives the call that
// made it by definition, is held by whoever awaits it *and* by the coroutine that will settle it, and
// those two release it in an order nobody controls.
//
// **What it holds that an object does not is a list of lines of execution.** A machine waiting here
// is parked, and its id is what this keeps -- an index into `parked` rather than a pointer, so
// nothing in the collected heap has to know what a `Machine` is.
struct PromiseObj
    // What it settled to. Meaningless until `settled`, and `Null` when it failed.
    value: Value

    settled: bool
    failed: bool

    // The complaint and where it was raised, for a promise that failed. A `string` lives here the way
    // `StrObj`'s does, with the finalizer below giving it back.
    message: string
    at: Span

    // The parked machines to hand the answer to. Emptied as they are queued.
    waiters: Buf[usize]

    // Whether anything has ever awaited this.
    //
    // **This is what tells a rejection that was dealt with from one that vanished.** A promise that
    // fails with nothing waiting on it is the commonest way an async program loses an error -- node
    // calls it an unhandled rejection and warns about it, and slate reports it as the program's fault.
    handled: bool

    // Whether the program threw this promise away -- a call whose value was discarded, which is what
    // `main()` on a line of its own is.
    //
    // **This is what says a rejection can be reported NOW rather than at the end of the run.** The
    // question "was this handled?" normally cannot be answered when a promise fails, because `val p =
    // risky()` and `await p` three lines later is ordinary -- so the answer waits until everything has
    // settled. A promise nobody was given is the one case where it can be answered at once: there is
    // no name for it and no line that could await it, so the failure is final the moment it happens.
    //
    // Without this a fault inside a coroutine is silent for as long as the program lives, which for a
    // server is forever -- the diagnostic sits in `rejections` waiting for a drain that never comes,
    // and what the program looks like from outside is a hang.
    orphaned: bool

// A scope: the names written in one block, and the scope it sits inside.
struct EnvObj
    names: Map[string, Value]

    // Which names may be written to. A `val` is absent and a `var` is present.
    mutable: Map[string, bool]

    // Null at the top level, where there is nothing outside.
    parent: *EnvObj

// -- tracing ------------------------------------------------------------------------------------

// Grey whatever a value points at. Scalars point at nothing and cost one comparison.
mark_value(h: *gc.Heap, v: Value)
    v match
        Str(p) -> gc.mark(h, ptr_cast(p))
        Array(p) -> gc.mark(h, ptr_cast(p))
        Object(p) -> gc.mark(h, ptr_cast(p))
        Fn(p) -> gc.mark(h, ptr_cast(p))
        Promise(p) -> gc.mark(h, ptr_cast(p))
        _ -> ()
end mark_value

// Grey every value in a map. Used by both the object kind and the scope kind.
private mark_map(h: *gc.Heap, m: Map[string, Value])
    var walk = m.walk()

    loop
        walk.next() match
            None -> break
            Some(pair) -> mark_value(h, pair.1)
end mark_map

// A string owns its sysl `string` and points at nothing, so it needs a finalizer and no tracer.
trace_str(p: *u8, h: *gc.Heap)
    ()

finalize_str(p: *u8)
    val o: *StrObj = ptr_cast(p)

    // Writing an empty string here releases the one that was there, which is the whole of what a
    // finalizer owes: give back what the object held outside the collected heap.
    o.s = ""

trace_array(p: *u8, h: *gc.Heap)
    val o: *ArrayObj = ptr_cast(p)

    for i in 0..<o.items.len()
        mark_value(h, o.items.at(i))

finalize_array(p: *u8)
    val o: *ArrayObj = ptr_cast(p)

    o.items = buf()

// **A key is traced as well as a value**, which is new: a field name used to be a sysl `string` that
// the collector never saw, and it is now a `Value` that may be an array or an object of its own.
trace_object(p: *u8, h: *gc.Heap)
    val o: *ObjectObj = ptr_cast(p)

    for i in 0..<o.entries.len()
        val e = o.entries.at(i)

        if !e.dead
            mark_value(h, e.key)
            mark_value(h, e.value)

finalize_object(p: *u8)
    val o: *ObjectObj = ptr_cast(p)

    o.entries = buf()
    o.index = buf()

trace_closure(p: *u8, h: *gc.Heap)
    val o: *ClosureObj = ptr_cast(p)

    gc.mark(h, ptr_cast(o.scope))

finalize_closure(p: *u8)
    val o: *ClosureObj = ptr_cast(p)

    o.params = buf()

// **A parked machine's own roots are not reached from here.** The waiters are ids, and `mark_vm`
// walks `parked` on its own -- so what this owes is the settled value and nothing else.
trace_promise(p: *u8, h: *gc.Heap)
    val o: *PromiseObj = ptr_cast(p)

    mark_value(h, o.value)

finalize_promise(p: *u8)
    val o: *PromiseObj = ptr_cast(p)

    o.message = ""
    o.waiters = buf()

trace_env(p: *u8, h: *gc.Heap)
    val o: *EnvObj = ptr_cast(p)

    gc.mark(h, ptr_cast(o.parent))
    mark_map(h, o.names)

finalize_env(p: *u8)
    val o: *EnvObj = ptr_cast(p)

    o.names = map()
    o.mutable = map()

// A `Kind` must outlive every object naming it and its address must not move, so these are module
// storage. Module storage states its type, which is why each is written out.
var str_kind: gc.Kind = gc.Kind(&trace_str, &finalize_str, null, null)
var array_kind: gc.Kind = gc.Kind(&trace_array, &finalize_array, null, null)
var object_kind: gc.Kind = gc.Kind(&trace_object, &finalize_object, null, null)
var closure_kind: gc.Kind = gc.Kind(&trace_closure, &finalize_closure, null, null)
var env_kind: gc.Kind = gc.Kind(&trace_env, &finalize_env, null, null)
var promise_kind: gc.Kind = gc.Kind(&trace_promise, &finalize_promise, null, null)

// -- the roots ----------------------------------------------------------------------------------

// **`alloc` never collects, so a value held only in a sysl local is invisible to the mark phase.**
// A tree-walker has those everywhere -- the subject of a `match`, a half-built array literal, the
// evaluated arguments of a call -- and none of them is in any scope. So the interpreter pushes what
// it is holding onto these, and pops on the way out.
//
// This is the shadow stack every precise collector's client has to keep, and it is the real cost of
// tracing over refcounting. The alternative -- scanning the machine stack -- is what makes a
// conservative collector a porting project rather than a dependency.
private var root_values: Buf[Value] = buf()
private var root_envs: Buf[*EnvObj] = buf()

// Where the stacks stand now, to be given back to `release` on the way out.
root_mark() -> usize = root_values.len()

env_mark() -> usize = root_envs.len()

// Hold a value across a point that may collect.
hold(v: Value)
    root_values.push(v)

// Let go of everything pushed since a mark.
release(mark: usize)
    root_values.truncate(mark)

// Hold a scope across a point that may collect.
hold_env(e: *EnvObj)
    root_envs.push(e)

release_env(mark: usize)
    root_envs.truncate(mark)

// Everything the program can still reach.
//
// **A top-level function, because a hook is reached by address** and a nested one has no address to
// take. That is also why the state above is module storage.
roots(h: *gc.Heap)
    // The machine's operand and frame stacks. **These are what the shadow stack below exists to
    // stand in for**, and once the walker is gone most of it goes with it.
    mark_vm(h)

    // What every module exported, which is what a name imported from one is reached through.
    mark_modules(h)

    // Everything the event loop may still call. Nothing else knows these are reachable.
    mark_pending(h)

    // And what a signal may call, which is a table of its own: a watcher is armed rather than
    // outstanding, so it is not one of the things above.
    mark_watches(h)

    // And the scope every declared type is holding, which is a table of its own for the reason a
    // watcher's is: a shape is not waiting for anything and is not armed either -- it simply lasts
    // as long as the program.
    mark_shapes(h)

    // The answers waiting to be handed back to a suspended call, and the promises that failed with
    // nobody watching. Both are held in module storage and nowhere else.
    mark_scheduler(h)

    for i in 0..<root_values.len()
        mark_value(h, root_values.at(i))

    for i in 0..<root_envs.len()
        gc.mark(h, ptr_cast(root_envs.at(i)))

    // The emergency objects a full heap is answered with. Nothing else refers to them until the
    // moment they are handed out, so nothing else would keep them.
    mark_spares(h)
end roots

// How much of the heap is spoken for.
heap_used() -> usize = gc.used(&slate_heap)

// How many collections this program has run, which is what makes a claim about *when* slate collects
// something a test can check rather than something a comment asserts.
var collections: usize = 0

// Collect, at a point the interpreter has chosen because it knows what is live.
collect_now()
    collections += 1
    gc.collect(&slate_heap, &roots)

// The smallest live set worth collecting over. Below this a program is cheap enough that tracing it
// costs more than the storage it would give back.
private const CollectFloor: usize = 262144

// How much the live set may grow to before the next collection. Raised after every collection to a
// multiple of what survived it.
var collect_above: usize = CollectFloor

// How much bigger than the surviving set the heap may get before collecting again.
//
// **Two means half the work a program does is collecting a heap that has doubled**, which is the
// usual place to start and is what most generational-free collectors settle on.
private const Headroom: usize = 2

// Collect if enough has been allocated to be worth it.
//
// **Called only at a statement boundary, and that is the whole of the safety argument.** `alloc`
// never collects, so the one moment a collection can happen is one the interpreter chose -- and it
// chose the top of a statement, where what is live is the scope chain plus whatever the frames above
// have pushed onto the shadow stack. A collection anywhere else would sweep a value some sysl local
// was halfway through building.
//
// **The number read is `live_size` and the threshold moves, and both halves were wrong here.** This
// asked whether `used` had passed a *fixed* 256 KiB, and `used` is the bump high-water mark, which
// never falls -- so once a program had ever allocated that much it ran a full mark-sweep at **every
// statement** for the rest of its life, reclaiming almost nothing each time. A 20,000-iteration loop
// building one small object per turn ran **19,629 collections**. Nothing was wrong with the answers,
// which is why it went unnoticed: the only symptom was speed.
//
// Reading `live_size` fixes half of it. The other half is that a fixed threshold puts a program
// whose genuine live set sits above it straight back into the same loop -- so the threshold is
// raised to a multiple of what survived, which is what makes the cost of collecting proportional to
// the garbage produced rather than to the statements executed.
maybe_collect()
    if gc.live_size(&slate_heap) > collect_above
        collect_now()

        val survived = gc.live_size(&slate_heap) * Headroom

        collect_above = if survived > CollectFloor then survived else CollectFloor

// Give the heap back, and run every finalizer still outstanding.
//
// **Without it a finalizer never runs for anything still reachable when the program stops**, so
// every sysl string and `Buf` a live object holds would leak. It is also what lets two programs run
// in one process, which every test in this repo does.
reset_heap()
    gc.dispose(&slate_heap)

    // **Rebuilt rather than reused, because the limit may have moved.** `dispose` hands every block
    // back to the free list, which is the right thing for a heap of the same size and the wrong one
    // for a heap that has just changed size -- the free list would still describe the old extent.
    slate_heap = gc.heap(&storage[0], heap_limit)
    root_values.clear()
    root_envs.clear()
    collections = 0
    collect_above = CollectFloor
    heap_exhausted = false
    reserve_spares()

// -- allocation ---------------------------------------------------------------------------------

// **A full heap answers null, and writing through that is a wild write.** The heap does not grow, so
// a program that outruns it has to be told rather than crashed: each of these collects first if the
// heap is nearly full, and `out_of_memory` reports the one case where that did not help.
//
// The collection here is safe for the same reason the one in `exec_block` is: these are only reached
// while the interpreter is between sub-expressions, with everything live either in a scope or on the
// shadow stack.

// Whether the last allocation failed. Read at the statement boundary, where there is a span to point
// at -- an allocator has no idea which line of the program it is serving.
var heap_exhausted: bool = false

// One object of every kind, taken while the heap is empty and never given back.
//
// **These are what a full heap is answered with, and without them it was answered with `null`.** The
// comment above has always said that writing through a full heap's answer is a wild write, and every
// one of the constructors below did exactly that: `alloc_or_collect` set `heap_exhausted` and
// returned null, and `new_str` wrote `o.s = s` straight through it. The flag is read at the *next*
// statement boundary, which the process never reached -- a slate program that outgrew the heap died
// with a bare SIGSEGV, no diagnostic, and none of the output it had already produced.
//
// A reserve is a real object in the heap with a real header, so it can be written to, traced and
// marked like any other. Handing the same one out twice makes two slate values share it, which is
// wrong and does not matter: the program stops at the end of the statement that got it.
private var spare_str: *StrObj = null
private var spare_array: *ArrayObj = null
private var spare_object: *ObjectObj = null
private var spare_closure: *ClosureObj = null
private var spare_env: *EnvObj = null
private var spare_promise: *PromiseObj = null

// Take the reserves. Called with an empty heap, where the allocation cannot fail.
private reserve_spares()
    spare_str = ptr_cast(gc.alloc(&slate_heap, sizeof(StrObj), &str_kind))
    spare_array = ptr_cast(gc.alloc(&slate_heap, sizeof(ArrayObj), &array_kind))
    spare_object = ptr_cast(gc.alloc(&slate_heap, sizeof(ObjectObj), &object_kind))
    spare_closure = ptr_cast(gc.alloc(&slate_heap, sizeof(ClosureObj), &closure_kind))
    spare_env = ptr_cast(gc.alloc(&slate_heap, sizeof(EnvObj), &env_kind))
    spare_promise = ptr_cast(gc.alloc(&slate_heap, sizeof(PromiseObj), &promise_kind))

    // A zeroed payload is a valid object of each of these kinds except the ones holding a `Buf` or a
    // `Map`, which a tracer walks -- and a zero `Buf` is an empty one, so all six are safe to trace
    // from the moment they exist.
    heap_exhausted = false
end reserve_spares

// Keep the reserves alive. They are rooted rather than special-cased in the sweep, because a rooted
// object is one the collector already knows how to keep.
private mark_spares(h: *gc.Heap)
    gc.mark(h, ptr_cast(spare_str))
    gc.mark(h, ptr_cast(spare_array))
    gc.mark(h, ptr_cast(spare_object))
    gc.mark(h, ptr_cast(spare_closure))
    gc.mark(h, ptr_cast(spare_env))
    gc.mark(h, ptr_cast(spare_promise))

// Try once, collect, try again -- and answer the reserve rather than null when even that fails.
//
// **The caller is going to write through whatever comes back**, so this may not answer null. What it
// does instead is say so in `heap_exhausted`, which the statement boundary reports against a line.
private alloc_or_collect(size: usize, kind: *gc.Kind, spare: *u8) -> *u8
    var p = gc.alloc(&slate_heap, size, kind)

    if p != null then return p

    collect_now()

    p = gc.alloc(&slate_heap, size, kind)

    if p != null then return p

    heap_exhausted = true
    spare
end alloc_or_collect
new_str(s: string) -> *StrObj
    var o: *StrObj = ptr_cast(alloc_or_collect(sizeof(StrObj), &str_kind, ptr_cast(spare_str)))

    o.s = s
    o

new_array(items: Buf[Value]) -> *ArrayObj
    var o: *ArrayObj = ptr_cast(alloc_or_collect(sizeof(ArrayObj), &array_kind, ptr_cast(spare_array)))

    o.items = items
    o

new_object() -> *ObjectObj
    var o: *ObjectObj = ptr_cast(alloc_or_collect(sizeof(ObjectObj), &object_kind, ptr_cast(spare_object)))

    o.entries = buf()
    o.index = fresh_index()
    o.live = 0
    o.frozen = false
    o

new_closure(params: Buf[string], body: usize, scope: *EnvObj) -> *ClosureObj
    var o: *ClosureObj = ptr_cast(alloc_or_collect(sizeof(ClosureObj), &closure_kind, ptr_cast(spare_closure)))

    o.params = params
    o.body = body
    o.scope = scope
    o

new_promise() -> *PromiseObj
    var o: *PromiseObj = ptr_cast(alloc_or_collect(sizeof(PromiseObj), &promise_kind, ptr_cast(spare_promise)))

    o.value = Null
    o.settled = false
    o.failed = false
    o.message = ""
    o.at = point(0)
    o.waiters = buf()
    o.handled = false
    o.orphaned = false
    o

new_env(parent: *EnvObj) -> *EnvObj
    var o: *EnvObj = ptr_cast(alloc_or_collect(sizeof(EnvObj), &env_kind, ptr_cast(spare_env)))

    o.names = map()
    o.mutable = map()
    o.parent = parent
    o
