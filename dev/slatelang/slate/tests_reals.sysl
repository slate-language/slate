module dev.slatelang.slate
@tests

// How a `real` is WRITTEN -- `render.sysl`'s `real_text`, reached through `print` and `string`.
//
// **The rule is JavaScript's `Number.prototype.toString`**: the shortest decimal that reads back as
// the same double, laid out plainly while `1e-7 <= |x| < 1e21` and as an exponent outside that band.
// These pin the interpreter's half of it; `tests/lang/numbers.sl` pins the same cases on both back
// ends, which is what says the two agree.

@test
a_real_prints_the_shortest_text_THAT_READS_BACK_AS_THE_SAME_DOUBLE()
    // The canonical one. `0.1 + 0.2` is not `0.3` and a rendering at six significant figures said it
    // was, which is a program unable to see the value it is holding.
    assert_eq(out("print(0.1 + 0.2)"), "0.30000000000000004")
    assert_eq(out("print(1 / 3.0)"), "0.3333333333333333")
    assert_eq(out("print(123456789.123)"), "123456789.123")

@test
SEVENTEEN_SIGNIFICANT_FIGURES_ARE_WRITTEN_WHERE_SIXTEEN_WOULD_NOT_READ_BACK()
    // The largest double, which is the case the search has to run all the way out for: sixteen
    // figures name a different number and seventeen name this one.
    assert_eq(out("print(1.7976931348623157e308)"), "1.7976931348623157e+308")

    // The smallest, where the shortest text is a single figure however many the value's exact
    // decimal expansion has.
    assert_eq(out("print(5e-324)"), "5e-324")

@test
A_SECOND_SUBNORMAL_ALSO_PRINTS_ITS_TRUE_SHORTEST_TEXT()
    // Sysl 0.0.119's `display_real_shortest` rounded a subnormal to fifteen digits and stopped
    // there -- `5e-324` came out as `4.94065645841247e-324`, and `1e-310` would have come out the
    // same way, both readings correct but far longer than the shortest one that round-trips. Sysl
    // 0.0.120 fixed the search itself, so this pins the fix from the caller's side: a regression in
    // either project turns either of these back into a fifteen-digit reading.
    assert_eq(out("print(1e-310)"), "1e-310")
    assert_eq(out("print(-5e-324)"), "-5e-324")

@test
A_TIE_AT_SOME_PRECISION_STILL_PRINTS_THE_FEWEST_DIGITS_THAT_READ_BACK()
    // `2^-24` falls exactly halfway at seventeen digits, and a printer that breaks that tie to the even
    // digit writes `5.9604644775390625e-8` -- a reading, and one digit longer than the shortest. Sysl
    // 0.0.133's `display_real_shortest` is Ryu and gives the shortest itself, which slate now takes as
    // it stands; this is what every JavaScript host writes.
    assert_eq(out("print(5.9604644775390625e-8)"), "5.960464477539063e-8")
    assert_eq(out("print((5.9604644775390625e-8).toExponential())"), "5.960464477539063e-8")

@test
A_WHOLE_REAL_NAMES_ITSELF_WITHOUT_ITS_TRAILING_ZEROS()
    // The library writes `100` for `100.0`, and none of those zeros is a digit the value needs:
    // `toExponential` with no count writes the fewest, so it is `1e+2`, as an integer's is.
    assert_eq(out("print((100.0).toExponential())"), "1e+2")
    assert_eq(out("print((1200.0).toExponential())"), "1.2e+3")
    assert_eq(out("print((100).toExponential())"), "1e+2")

@test
the_plain_band_is_JAVASCRIPTS_AND_ENDS_AT_1e21_AND_1e_MINUS_7()
    assert_eq(out("print(1e20)"), "100000000000000000000")
    assert_eq(out("print(1e21)"), "1e+21")
    assert_eq(out("print(1e-6)"), "0.000001")
    assert_eq(out("print(1e-7)"), "1e-7")
    assert_eq(out("print(1.5e21)"), "1.5e+21")

    // The exponent carries no padding zero, which is where `%g` and JavaScript disagreed.
    assert_eq(out("print(1e100)"), "1e+100")

@test
a_real_whose_VALUE_IS_WHOLE_still_prints_as_a_whole_number()
    // Unchanged by the shortest-text rule, and the reason to pin it: a real is not told from an
    // integer by its text, and nothing here may start writing `2.0`.
    assert_eq(out("print(2.0)"), "2")
    assert_eq(out("print(-2.0)"), "-2")
    assert_eq(out("print(100.0)"), "100")
    assert_eq(out("print(string(1.0))"), "1")

@test
NOT_A_NUMBER_AND_THE_INFINITIES_ARE_SPELLED_AS_JAVASCRIPT_SPELLS_THEM()
    assert_eq(out("print(0.0 / 0.0)"), "NaN")
    assert_eq(out("print(1.0 / 0.0)"), "Infinity")
    assert_eq(out("print(-1.0 / 0.0)"), "-Infinity")

@test
a_NEGATIVE_ZERO_KEEPS_ITS_SIGN_where_javascript_drops_it()
    // The one place slate does not follow the host: `String(-0)` is `"0"` there, which hides the
    // thing a reader printing a zero is most likely asking about.
    assert_eq(out("print(0.0)"), "0")
    assert_eq(out("print(-0.0)"), "-0")

@test
the_text_a_real_prints_READS_BACK_AS_THE_SAME_REAL()
    // The property the whole rule exists for, asked of the program rather than of the renderer.
    val src = "for x in [0.1 + 0.2, 1 / 3.0, 1e21, 1e-7, 123456789.123, 1.7976931348623157e308, 5e-324, 2.0, -0.5]\n" +
        "    print(number(string(x)) == x)\n"

    assert_eq(out(src), "true\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue")

@test
a_real_inside_a_structure_is_written_the_same_way()
    // `print` descends through `write_value`, so an element and a field go through the one renderer
    // a bare value does -- a second rendering is exactly what six-significant-figure text hid.
    assert_eq(out("print([0.1 + 0.2, 1.5])"), "[0.30000000000000004, 1.5]")
    assert_eq(out("print({ a: 0.1 + 0.2 })"), "{a: 0.30000000000000004}")
