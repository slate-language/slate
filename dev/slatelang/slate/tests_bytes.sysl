module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// The `bytes` kind: what a buffer is, what the checker may say about one, and what it costs.
//
// **Its own file rather than a section of `tests_lang.sysl`, because the KIND is the subject.** The
// operations themselves are language tests and live in `tests/lang/bytes.sl`, where both back ends
// run them; what is worth a file here is what only the interpreter can be asked -- the checker's
// vocabulary, the collector, and the storage the kind exists to save.
//
// **THE ONE BREAKING CHANGE IS `toBytes`**, which answers a buffer where it answered an array of
// numbers. Everything that took the array takes either, so a program feels it in exactly two places:
// an array's own names (`map`, `sort`) now need `.toArray()`, and `toBytes(s) == [104, 105]` is a
// buffer against an array and so false.

// -- the kind ---------------------------------------------------------------------------------------

// **`bytes` has no article in a complaint**, the word being plural -- which is the one entry in
// `type_name` that does not read "a something".
@test
A_COMPLAINT_ABOUT_A_BUFFER_SAYS_bytes_WITH_NO_ARTICLE()
    assert(fails("val b = toBytes(\"a\")\nprint(-b)").contains("`-` needs a number, and this is bytes"))
    assert(fails("print(toBytes(\"a\") + 1)").contains("bytes"))
end A_COMPLAINT_ABOUT_A_BUFFER_SAYS_bytes_WITH_NO_ARTICLE

// **The type word is the test**, as it is for every other kind a value can be.
@test
bytes_IS_A_TYPE_WORD_IN_A_PATTERN_AN_ANNOTATION_AND_A_MATCH()
    val prog = raw"""
    seen(v) = v match
        b @ bytes -> b.length
        xs @ array -> -1
        _ -> -2

    print(seen(toBytes("hi")), seen([1]), seen("hi"))
    print(toBytes("hi") is bytes)
    """

    assert_eq(out(prog), "2 -1 -2\ntrue")
end bytes_IS_A_TYPE_WORD_IN_A_PATTERN_AN_ANNOTATION_AND_A_MATCH

// -- what the checker knows -------------------------------------------------------------------------

// **A name a buffer does not carry is refused BEFORE THE PROGRAM RUNS**, which is what
// `methods_of("bytes", …)` being one table for the machine and the checker buys. An array's own
// names are the ones a reader is most likely to reach for, so those are the refusals that matter.
@test
THE_CHECKER_REFUSES_AN_ARRAYS_OWN_NAMES_ON_A_BUFFER()
    val said = fails("val b = toBytes(\"a\")\nprint(b.map(x -> x))")

    assert(said.contains("map"))
    assert(said.contains("bytes"))
    assert(fails("val b = toBytes(\"a\")\nprint(b.size)").contains("bytes"))
    assert(fails("val b = toBytes(\"a\")\nprint(b.upper())").contains("bytes"))
end THE_CHECKER_REFUSES_AN_ARRAYS_OWN_NAMES_ON_A_BUFFER

// **`length` is a property and `toArray` is a method**, which is the two-table arrangement every
// builtin kind has -- so `b.length` is the number and `b.length()` is told it is a property.
@test
length_IS_A_PROPERTY_OF_A_BUFFER_AND_toArray_IS_A_METHOD()
    assert_eq(out("print(toBytes(\"hi\").length)"), "2")
    assert_eq(out("print(toBytes(\"hi\").toArray())"), "[104, 105]")
    assert(fails("print(toBytes(\"hi\").length())").contains("property"))
end length_IS_A_PROPERTY_OF_A_BUFFER_AND_toArray_IS_A_METHOD

// **A `bytes` annotation is checked at the call**, which is what `NamedType("bytes")` is for.
@test
AN_ANNOTATION_OF_bytes_IS_CHECKED_WHERE_THE_CALL_IS_WRITTEN()
    assert_eq(out("count(b: bytes) = b.length\nprint(count(toBytes(\"abc\")))"), "3")
    assert(fails("count(b: bytes) = b.length\nprint(count(\"abc\"))").contains("bytes"))
end AN_ANNOTATION_OF_bytes_IS_CHECKED_WHERE_THE_CALL_IS_WRITTEN

// **THE BUG, 2026-09-17.** Once a name is statically known to be `bytes` -- an explicit `: bytes`
// annotation, or an `is bytes` narrowing on that bare name -- the checker refused `push(name, v)`
// naming `array`, though `docs/library/bytes.md` documents `push(b, byte)` and `push(b, other)` and
// the machine takes both. `signatures.sysl`'s table said `array` for `push`'s first parameter where
// the native itself (`do_push` in `builtin.sysl`) takes an array OR bytes; `list_or_bytes` is that
// wider truth read back as a type.
@test
push_TAKES_A_NAME_STATICALLY_ANNOTATED_bytes()
    val prog = raw"""
    putBytes(out: bytes, s) = push(out, toBytes(s, "latin1"))

    val out = bytes(0)

    putBytes(out, "hi")
    print(fromBytes(out).value)
    """

    assert_eq(out(prog), "hi")
end push_TAKES_A_NAME_STATICALLY_ANNOTATED_bytes

// **The other way a name becomes statically `bytes`: an `is` test narrows the bare name it tested.**
@test
push_TAKES_A_NAME_NARROWED_TO_bytes_BY_is()
    val prog = raw"""
    val maybe = toBytes("hi")

    if maybe is bytes
        push(maybe, toBytes(" there"))
        print(fromBytes(maybe).value)
    """

    assert_eq(out(prog), "hi there")
end push_TAKES_A_NAME_NARROWED_TO_bytes_BY_is

// **`slice` had the same signature and the same fix.**
@test
slice_TAKES_A_NAME_STATICALLY_ANNOTATED_bytes()
    assert_eq(out("firstTwo(b: bytes) = slice(b, 0, 2)\nprint(fromBytes(firstTwo(toBytes(\"hello\"))).value)"), "he")
end slice_TAKES_A_NAME_STATICALLY_ANNOTATED_bytes

// **The checker accepting `bytes` here must not widen what the MACHINE accepts** -- `push`'s second
// parameter is still `any`, so a non-byte value handed to a buffer's `push` still faults, and its
// sentence is unchanged.
@test
push_ONTO_A_STATICALLY_bytes_NAME_STILL_FAULTS_ON_A_BAD_VALUE()
    assert(fails("putBytes(out: bytes) = push(out, \"x\")\nputBytes(bytes(0))").contains("`push` onto bytes takes a byte or more bytes, and this is a string"))
end push_ONTO_A_STATICALLY_bytes_NAME_STILL_FAULTS_ON_A_BAD_VALUE

// -- the storage the kind exists to save --------------------------------------------------------------

// **A MEGABYTE OF BYTES IS A MEGABYTE, NOT SIXTEEN**, and the ratio is the whole reason this kind
// was built. It is checked against the representation rather than asserted in prose: a byte in a
// buffer is a `u8` and a byte in an array of numbers is a whole `Value`.
@test
A_BUFFER_COSTS_ONE_BYTE_PER_BYTE_WHERE_AN_ARRAY_COSTS_A_VALUE()
    assert(sizeof(Value) >= 16, "a Value is the tag and its widest payload")
    assert(sizeof(u8) == 1, "a byte in a buffer is a byte")

    // And the buffer really is that storage: a megabyte of it is made, held and read back.
    val prog = raw"""
    val b = bytes(1048576)

    b[1048575] = 7

    print(b.length, b[1048575], b[0])
    """

    assert_eq(out(prog), "1048576 7 0")
end A_BUFFER_COSTS_ONE_BYTE_PER_BYTE_WHERE_AN_ARRAY_COSTS_A_VALUE

// **The collector walks nothing inside a buffer**, a buffer holding no values -- so a program that
// makes and drops a great many of them collects and keeps running rather than filling the heap.
//
// **A falsification rather than an assertion**, which is the shape `a_cycle_is_collected_where_
// reference_counting_could_not_free_it` already uses: four hundred buffers of ten thousand bytes is
// four megabytes of storage held at once if nothing is given back. Completing is the proof, and
// `heap_used` afterwards says the objects went with it.
@test
A_BUFFER_IS_COLLECTED_AND_ITS_STORAGE_GOES_WITH_IT()
    val prog = raw"""
    var last = bytes(0)
    var n = 0

    while n < 4000
        last = bytes(10000)
        n = n + 1

    print(last.length, n)
    """

    assert_eq(out(prog), "10000 4000")
    assert(heap_used() < 1048576, "the heap is not full of dead buffers")
end A_BUFFER_IS_COLLECTED_AND_ITS_STORAGE_GOES_WITH_IT

// -- what still takes an array of numbers ---------------------------------------------------------

// **EVERY BUILTIN THAT TOOK AN ARRAY OF NUMBERS TAKES EITHER**, which is what keeps a program
// written before the kind existed running. `bytes_like` is the one reading of "bytes arrived here",
// so this is the test that the sweep reached every site rather than most of them.
@test
THE_BUILTINS_THAT_TOOK_AN_ARRAY_OF_BYTES_TAKE_A_BUFFER_TOO()
    val prog = raw"""
    import { sha256, hmac } from slate:crypto

    print(fromBytes([104, 105]).value, fromBytes(toBytes("hi")).value)
    print(sha256([104, 105]).length == sha256(toBytes("hi")).length)
    print(hmac("SHA-256", toBytes("k"), toBytes("m")).length > 0)
    """

    assert_eq(out(prog), "hi hi\ntrue\ntrue")
end THE_BUILTINS_THAT_TOOK_AN_ARRAY_OF_BYTES_TAKE_A_BUFFER_TOO

// A buffer and the array of the same numbers are two kinds, so neither is the other -- the rule a
// string and the array of its characters are already on.
@test
A_BUFFER_IS_NOT_THE_ARRAY_OF_ITS_NUMBERS_AND_NEITHER_IS_THE_OTHER()
    val prog = raw"""
    val b = toBytes("hi")

    print(b == b.toArray())
    print(b.toArray() == [104, 105])
    print(bytes(b.toArray()) == b)
    """

    assert_eq(out(prog), "false\ntrue\ntrue")
end A_BUFFER_IS_NOT_THE_ARRAY_OF_ITS_NUMBERS_AND_NEITHER_IS_THE_OTHER

// -- the file system --------------------------------------------------------------------------------

// **`readBytes` answers a buffer and `writeBytes` takes one**, which is the round trip a program
// holding an image or a digest makes. The array still works on the way in, and `toArray` is the way
// back to it.
@test
A_FILE_ROUND_TRIPS_THROUGH_A_BUFFER_AND_THROUGH_AN_ARRAY()
    val prog = "async main()\n" +
        "    await writeBytes(\"<dir>/a.bin\", toBytes(\"héllo\"))\n" +
        "    val back = (await readBytes(\"<dir>/a.bin\")).value\n" +
        "    print(back.length, back is bytes, fromBytes(back).value)\n" +
        "    await writeBytes(\"<dir>/b.bin\", [1, 2, 255])\n" +
        "    print((await readBytes(\"<dir>/b.bin\")).value.toArray())\n" +
        "main()"

    assert_eq(in_scratch(prog), "6 true héllo\n[1, 2, 255]")
end A_FILE_ROUND_TRIPS_THROUGH_A_BUFFER_AND_THROUGH_AN_ARRAY

// The blocking twin answers the same kind, `readBytesSync` and `readBytes` being one reading written
// twice.
@test
readBytesSync_ANSWERS_A_BUFFER_AS_readBytes_DOES()
    val prog = "writeBytesSync(\"<dir>/a.bin\", toBytes(\"hi\"))\n" +
        "val back = readBytesSync(\"<dir>/a.bin\").value\n" +
        "print(back, back is bytes)"

    assert_eq(in_scratch(prog), "<bytes 2: 68 69> true")
end readBytesSync_ANSWERS_A_BUFFER_AS_readBytes_DOES

// **`writeBytes` refuses what is not bytes and names the call that renders**, which is the line it
// was already on -- the sentence now says both shapes it does take.
@test
writeBytes_REFUSES_WHAT_IS_NEITHER_A_BUFFER_NOR_AN_ARRAY()
    val said = fails_in_scratch("writeBytesSync(\"<dir>/a.bin\", \"hi\")")

    assert(said.contains("bytes or an array of numbers"))
    assert(said.contains("writeFileSync"))
end writeBytes_REFUSES_WHAT_IS_NEITHER_A_BUFFER_NOR_AN_ARRAY
