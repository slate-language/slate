module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf, buf_with_capacity}
// **Case and whitespace are `case.sysl`'s and are no longer here.** Both had to know what a
// character MEANS rather than where it is, which is a database and not a walk -- and everything left
// in this file counts and cuts characters, which is Unicode-correct by construction.
//
// **Numbers are `number.sysl`'s and are no longer here either**, cut out when the registry landed
// and this file could no longer hold its own installer under a thousand lines. `text_of` is the one
// name that crosses, `number("3")` reading a string.
import sysl.text.{Search, char_indices, chars_of, from_utf8, from_utf8_unchecked, join, repeat, replace_all, str_builder}

// Text, as a slate program reaches it.
//
// **A slate string is measured in CHARACTERS and not in bytes**, which is the user's call and the
// only defensible one: `"日本語".length` answering 9 and `"日本語"[0..<1]` answering half of a
// character are not facts about the program, they are facts about UTF-8 leaking through a language
// that has no business exposing it. Everything here counts and cuts by character.
//
// **The conversion is the tax, and it is paid here rather than by every caller.** `sysl.text`'s
// searching answers byte offsets, because that is what a scanner wants; a slate program never sees
// one. `char_span` and `char_of_byte` are the two functions that translate, and every builtin below
// goes through them.
//
// **There is still no character type**, so a single character is a string of one. That is Python's
// answer and it is what lets `s[i]`, `chars(s)` and `split` all hand back the same kind of thing.

// -- counting and cutting by character -----------------------------------------------------------

// How many characters a string holds.
//
// **Bytes that are not text count as the one replacement character a walk would hand back**, so this
// agrees with what `chars` produces rather than with the byte length.
//
// **THIS IS THE SLOW ANSWER AND IS FOR TEXT NOBODY HAS COUNTED YET.** A string a program holds
// carries its count on the cell (`StrObj.chars`), so `str_count` is what every builtin asks; this is
// what makes that number in the first place, and every byte it reads is charged to `scanned`.
char_count(s: string) -> usize
    scanned(s.bytes.len)
    chars_of(s.bytes).count()

// -- the cell's own count, and the cursor that walks a string that is not all one-byte -------------
//
// **A POSITION IS A CHARACTER AND THE STORAGE IS UTF-8, so something has to turn one into the
// other.** These are the four functions that do it, and the point of every one of them is that it
// reads the count the cell already carries rather than walking the text again.

// How many characters a string holds, off the cell. This is `s.length`.
str_count(o: *StrObj) -> usize = o.chars

// Whether every character in the string is a single byte, in which case a character position and a
// byte offset are the same number. **This is the case nearly every program is in**, and it costs a
// comparison rather than a flag because the count is already there.
str_one_byte(o: *StrObj) -> bool = o.chars == o.s.bytes.len

// The byte offset character `i` begins at, with the count itself answering the end of the string.
//
// **A string that is not all one-byte is walked from the CURSOR**, which is the last position this
// cell was asked about -- so reading such a string left to right costs one step per character
// however long the string is, where walking from the front every time is the square of its length.
//
// **THE CURSOR IS FORWARD-ONLY, AND THAT IS A CORRECTNESS DECISION RATHER THAN AN OMISSION.** The
// walk has to agree with `char_count`, which is `sysl.text`'s decoder -- and that decoder counts a
// run of bytes that are not text as ONE character per maximal ill-formed subsequence, a rule with
// no reverse: stepping back over continuation bytes answers the right position for well-formed
// UTF-8 and a different one for text that arrived broken from a file or a socket. So a position
// behind the cursor is walked from the front, with the same iterator that did the counting, and the
// two can never come to disagree about where a character begins. A one-byte string is O(1) in both
// directions, which is what nearly every program is reading.
str_byte_at(o: *StrObj, i: usize) -> usize
    if i >= o.chars then return o.s.bytes.len
    if str_one_byte(o) then return i

    val bytes = o.s.bytes
    val behind = i < o.cursor_char
    val from = if behind then 0 else o.cursor_byte
    var n = if behind then 0 else o.cursor_char
    var at = from

    for entry in char_indices(bytes[from..])
        if n == i
            at = from + entry.0
            break

        n += 1

    scanned(at - from)
    o.cursor_char = i
    o.cursor_byte = at
    at
end str_byte_at

// The byte offsets a run of characters occupies, off the cell.
str_byte_span(o: *StrObj, from: usize, to: usize) -> (usize, usize)
    val lo = str_byte_at(o, from)

    (lo, str_byte_at(o, to))

// The characters a run of them is, off the cell. The answer's own count is the difference between
// the two positions, so nothing counts it again.
str_slice(o: *StrObj, from: usize, to: usize) -> Value
    if to <= from then return str_counted("", 0)

    val hi = if to > o.chars then o.chars else to

    if from >= hi then return str_counted("", 0)

    val span = str_byte_span(o, from, hi)

    cut_value(o.s, span.0, span.1, hi - from)
end str_slice

// The text of one character, for a caller assembling a string out of several -- where `str_slice`
// would make a cell per character that nothing keeps.
str_char_text(o: *StrObj, i: usize) -> string
    val a = str_byte_at(o, i)
    val b = str_byte_at(o, i + 1)

    if b <= a then "" else from_utf8_unchecked(o.s.bytes[a..<b])

// Which character a byte offset falls on, off the cell -- for turning a byte search's answer into a
// position a program can use.
str_char_at_byte(o: *StrObj, b: usize) -> usize
    if str_one_byte(o) then return if b > o.chars then o.chars else b

    var n: usize = 0

    for entry in char_indices(o.s.bytes)
        if entry.0 >= b then break

        n += 1

    scanned(if b > o.s.bytes.len then o.s.bytes.len else b)
    n
end str_char_at_byte

// The byte offsets a run of characters occupies, for text that is not a slate string and so has no
// cell to read a count off -- a rendered number, a filler, a piece of a diagnostic. **A slate string
// goes through `str_byte_span`**, which costs the distance rather than the length.
//
// Either end past the last character lands at the end of the string, which is what a slice of a
// range running off the end means and is what keeps this out of the business of refusing one.
char_span(s: string, from: usize, to: usize) -> (usize, usize)
    scanned(s.bytes.len)

    var lo = s.bytes.len
    var hi = s.bytes.len
    var i: usize = 0

    for entry in char_indices(s.bytes)
        if i == from then lo = entry.0
        if i == to then hi = entry.0

        i += 1

    (lo, hi)
end char_span

// The characters a run of them is.
char_slice(s: string, from: usize, to: usize) -> string
    val span = char_span(s, from, to)

    if span.1 <= span.0 then return ""

    from_utf8_unchecked(s.bytes[span.0..<span.1])
end char_slice

// The bytes the routines above have walked over, which is what says an ordinary character walk is
// linear in the length of the string rather than quadratic.
//
// **It is a COUNT and not a time, which is what makes it testable.** A benchmark says a program got
// faster and cannot say why; this says how much text was read to answer the questions the program
// asked, and a test can assert a bound on it.
private scanned(n: usize)
    current().chars_scanned += n

// Not `private`: the suite asserts a bound on it, and nothing else reads it.
bytes_scanned() -> usize = current().chars_scanned

// -- what a program calls: text --------------------------------------------------------------------

// The one shape nearly all of these take: some strings in, one value out.
// Not `private`: `number.sysl`'s `do_number` reads a string, that file being this one's other half.
text_of(v: Value, at: Span, name: string, which: string) -> Result[string, Signal]
    v match
        Str(p) -> Ok(p.s)
        other -> Err(failure(at, s"`${name}` takes ${which}, and this is ${other.type_name()}"))

// The same check answering the CELL rather than its text, for a builtin that counts or cuts by
// character: the count and the cursor are on the cell, and a builtin that took the string alone
// would have thrown both away.
// Not `private`: `case.sysl` trims by character and asks it too.
str_cell(v: Value, at: Span, name: string, which: string) -> Result[*StrObj, Signal]
    v match
        Str(p) -> Ok(p)
        other -> Err(failure(at, s"`${name}` takes ${which}, and this is ${other.type_name()}"))

// Not `private`, for `text_of`'s reason: every builtin checks its count the same way.
// **A count is a FLOOR, not a target**: extra arguments are dropped, following the language's own
// call rule (`docs/reference/functions.md`); too few still faults.
wants(args: Args, n: usize, at: Span, name: string, what: string) -> Result[unit, Signal]
    if args.len() < n then return Err(failure(at, s"`${name}` takes ${what}, and was given ${counted(args.len(), "argument")}"))

    Ok(())

// `chars(s)` -- every character, each as a string of one.
do_chars(args: Args, at: Span) -> Step
    wants(args, 1, at, "chars", "one string")?

    // **One walk of the bytes and one character out of each step**, where this used to ask twice per
    // character which character a byte offset was -- two walks of the whole string per character, so
    // `chars` of a long text was the square of its length before its first piece was made.
    val o = str_cell(args.at(0), at, "chars", "a string")?
    val bytes = o.s.bytes
    val mark = root_mark()
    var items: Buf[Value] = buf()
    var start: usize = 0
    var started = false

    for entry in char_indices(bytes)
        if started
            val one = cut_value(o.s, start, entry.0, 1)

            hold(one)
            items.push(one)

        start = entry.0
        started = true

    if started
        val last = cut_value(o.s, start, bytes.len, 1)

        hold(last)
        items.push(last)

    val made = Array(new_array(items))

    release(mark)
    Ok(made)
end do_chars

// `at(s, i)` -- the character at a position, counting from the END where the position is negative.
//
// **`s.at(-1)` is the whole reason this exists beside `s[i]`**, which is what `xs.at(-1)` is for an
// array and is why JavaScript grew `at` on both. The dispatch is `do_at`'s in `calendar.sysl`: a
// name is looked up by the KIND of its receiver, so one `at` serves a string, an array, a buffer
// and a reading of an instant without any of them reaching another's meaning.
//
// **A position past either end is a FAULT rather than an absence**, which is `do_array_at`'s answer
// and is forced: slate stores no `undefined`, so there is nothing for an out-of-range read to hand
// back.
do_string_at(args: Args, at: Span) -> Step
    wants(args, 2, at, "at", "a string and a position")?

    val o = str_cell(args.at(0), at, "at", "a string")?
    val n = str_count(o)
    val i = from_either_end(args.at(1), at, "at", n)?

    if i < 0 || usize(i) >= n
        return fault(at, s"`at` was given the position ${as_written(args.at(1))}, and this string has ${n} of them")

    Ok(str_char_value(o, usize(i)))
end do_string_at

// `split(s, sep)` -- the pieces between each occurrence.
//
// **An empty separator splits into characters**, which is what every language that answers this
// question at all answers, and saves a program reaching for `chars` under another name.
do_split(args: Args, at: Span) -> Step
    wants(args, 2, at, "split", "a string and a separator")?

    val o = str_cell(args.at(0), at, "split", "a string")?
    val s = o.s
    val sep = text_of(args.at(1), at, "split", "a separator")?

    // **An empty separator splits into characters**, and hands the work to the builtin that already
    // does exactly that -- over the first of these arguments, `chars` taking one where this took two.
    if sep == "" then return do_chars(args.take(1), at)

    // **The pieces are gathered in the VM's `split_pieces` and the array is allocated once, at its
    // size.** A `Buf` grown from empty starts at eight slots and doubles, so a line of three fields
    // paid for eight, every one filled and charged as payload, and a split of twenty thousand lines
    // reallocated and copied at every doubling on the way up. The gathering buffer keeps its room from
    // one call to the next, so after the first call it grows for nothing. Counting the separators
    // first was measured and was slower: it is the search the cut makes, done twice. The buffer is a
    // root, so a piece gathered there needs no `hold` of its own when the next one's allocation
    // collects.
    val v = current()
    val gathered: *Buf[Value] = &v.split_pieces

    gathered.clear()

    // **A piece of a one-byte string is one byte a character too**, so its count is its byte length
    // and nothing walks it. Where the text is not, each piece is counted on its own -- which over
    // all the pieces is one walk of the string, the same as before.
    val plain = str_one_byte(o)

    // **The pieces are cut here rather than by `sysl.text.split`**, whose answer is a slice of sysl
    // strings that this would only copy into `items` and throw away: a `malloc`, a fill and a `free`
    // per call, for a list nothing but this loop ever reads. The cut is the library's own --
    // `index_of_from` from where the last separator ended, and the rest once there is none.
    var start: usize = 0
    var last = false

    while !last
        val piece = s.index_of_from(sep, start) match
            Some(found) ->
                val cut = s[start..<found]

                start = found + sep.len
                cut
            None ->
                last = true
                s[start..]

        val one = if plain then piece_value(piece, piece.bytes.len) else str_value(piece)

        gathered.push(one)

    var items: Buf[Value] = buf_with_capacity(gathered.len(), Null)

    items.extend(gathered.view())

    // **Cleared only once the array is made**, the allocation of its cell being one that can collect
    // while the pieces are still nowhere else.
    val made = Array(new_array(items))

    gathered.clear()
    Ok(made)
end do_split

// `join(xs, sep)` -- the other direction. Anything that is not a string is rendered as `print` would.
do_join(args: Args, at: Span) -> Step
    wants(args, 2, at, "join", "an array and a separator")?

    val sepc = str_cell(args.at(1), at, "join", "a separator")?
    val sep = sepc.s

    args.at(0) match
        Array(a) ->
            var out = str_builder()

            // **The answer's count is the sum of the pieces' and the separators'**, which costs
            // nothing: a piece that is already a string carries its own, and one that had to be
            // rendered is counted where it is made rather than by a walk of the whole answer.
            var n: usize = 0

            for i in 0..<a.items.len()
                if i > 0
                    out.push(sep)
                    n += sepc.chars

                val piece = a.items.at(i)
                val text = printed(piece, at)?

                n += piece match
                    Str(p) -> p.chars
                    _ -> char_count(text)

                out.push(text)

            Ok(str_counted(out.finish(), n))
        other -> fault(at, s"`join` takes an array, and this is ${other.type_name()}")
end do_join

do_contains(args: Args, at: Span) -> Step
    wants(args, 2, at, "contains", "a string and what to look for")?

    val s = text_of(args.at(0), at, "contains", "a string")?
    val sub = text_of(args.at(1), at, "contains", "what to look for")?

    Ok(Bool(find_forward(s.bytes, sub.bytes, 0).is_some()))

// `indexOf(s, sub)` and `indexOf(s, sub, from)` -- where it is, IN CHARACTERS, or null.
//
// **Null rather than -1**, because slate has a null and the operators that go with it: `indexOf(s,
// x) ?? 0` says what a sentinel makes a reader work out.
//
// **A POSITION IS WHAT A PROGRAM WAS SLICING TO GET.** Without one, finding the second occurrence
// of something meant cutting a fresh string and adding the offset back on -- which allocates a copy
// of the tail per search and is how a scan over a document becomes quadratic. `slate:ws` and
// `slate:url` both had that shape in them.
do_index_of(args: Args, at: Span, last: bool) -> Step
    val name = if last then "lastIndexOf" else "indexOf"

    if args.len() != 2 && args.len() != 3
        return fault(at, s"`${name}` takes a string, what to look for and an optional position, and was given ${counted(args.len(), "argument")}")

    val o = str_cell(args.at(0), at, name, "a string")?
    val s = o.s
    val sub = text_of(args.at(1), at, name, "what to look for")?
    val n = o.chars

    // **Given no position a forward search starts at the beginning and a backward one at the end**,
    // which is what the two-argument form has always meant and is why the default is not one number.
    val asked = if args.len() == 3
        from_either_end(args.at(2), at, name, n)?
    else
        if last then long(n) else long(0)

    if last
        // A position below the start of the string, after counting a negative one back from the
        // end, is a search over nothing.
        if asked < 0 then return Ok(Null)

        val start = if asked > long(n) then n else usize(asked)

        find_backward(s.bytes, sub.bytes, str_byte_at(o, start)) match
            Some(b) -> Ok(Int(long(str_char_at_byte(o, b))))
            None -> Ok(Null)
    else
        // Past the end there is nothing at or after it.
        if asked > long(n) then return Ok(Null)

        val start = if asked < 0 then 0 else usize(asked)

        find_forward(s.bytes, sub.bytes, str_byte_at(o, start)) match
            Some(b) -> Ok(Int(long(str_char_at_byte(o, b))))
            None -> Ok(Null)
end do_index_of

// -- searching bytes -------------------------------------------------------------------------------

// **A BYTE SEARCH OVER UTF-8 IS CORRECT AND NOT A SHORTCUT.** UTF-8 is self-synchronizing -- a
// continuation byte is distinguishable from a lead byte -- so a well-formed needle cannot match
// starting anywhere but at a character boundary. The offsets in and out are bytes; the caller turns
// them into characters.
//
// **BOYER-MOORE-HORSPOOL RATHER THAN THE NAIVE SCAN, AND THE MEASUREMENT IS WHY.** `sysl.text`'s
// `Search` says of its own two searches that "a sub-linear one may replace them without anything
// observable changing"; this is that replacement, made here because the trait is the standard
// library's and slate owns its own builtin. `sluice` measured a megabyte at 633 ms through the
// naive scan and 48 ms through this one.
//
// The table is skipped for a needle of one byte, where building 256 entries costs more than the
// scan it saves.
private find_forward(h: []const u8, n: []const u8, from: usize) -> Option[usize]
    if from > h.len then return None
    if n.len == 0 then return Some(from)
    if n.len > h.len then return None
    if from > h.len - n.len then return None

    val last = h.len - n.len

    if n.len == 1
        val want = n[0]
        var i = from

        while i <= last
            if h[i] == want then return Some(i)

            i += 1

        return None

    // How far the window may jump when the byte at its end is not the needle's last: the distance
    // from that byte's rightmost other occurrence to the end, or the whole needle where it does not
    // occur at all.
    var shift: [256]usize = [n.len; 256]
    var k: usize = 0

    while k < n.len - 1
        shift[usize(n[k])] = n.len - 1 - k
        k += 1

    var i = from

    while i <= last
        var j = n.len
        var same = true

        while j > 0
            j -= 1

            if h[i + j] != n[j]
                same = false
                break

        if same then return Some(i)

        i += shift[usize(h[i + n.len - 1])]

    None
end find_forward

// The same walk from the other end: where `n` last occurs in `h` starting at or before `upto`.
//
// **The table is the mirror and not the same table.** A backward search compares from the window's
// start, so what a mismatch there says is where that byte occurs *nearest the front* of the needle.
private find_backward(h: []const u8, n: []const u8, upto: usize) -> Option[usize]
    if n.len > h.len then return None

    val last = h.len - n.len
    val top = if upto > last then last else upto

    if n.len == 0 then return Some(top)

    if n.len == 1
        val want = n[0]
        var i = top

        loop
            if h[i] == want then return Some(i)
            if i == 0 then break

            i -= 1

        return None

    var shift: [256]usize = [n.len; 256]
    var k = n.len - 1

    while k > 0
        shift[usize(n[k])] = k
        k -= 1

    var i = top

    loop
        var j: usize = 0
        var same = true

        while j < n.len
            if h[i + j] != n[j]
                same = false
                break

            j += 1

        if same then return Some(i)

        val step = shift[usize(h[i])]

        if i < step then break

        i -= step

    None
end find_backward

do_edge(args: Args, at: Span, start: bool) -> Step
    val name = if start then "startsWith" else "endsWith"

    wants(args, 2, at, name, "a string and what to look for")?

    val s = text_of(args.at(0), at, name, "a string")?
    val sub = text_of(args.at(1), at, name, "what to look for")?

    Ok(Bool(if start then s.starts_with(sub) else s.ends_with(sub)))


do_replace(args: Args, at: Span) -> Step
    wants(args, 3, at, "replace", "a string, what to replace, and what to put there")?

    val subject = str_cell(args.at(0), at, "replace", "a string")?
    val s = subject.s
    val gone = str_cell(args.at(1), at, "replace", "what to replace")?
    val old = gone.s
    val put = str_cell(args.at(2), at, "replace", "what to put there")?
    val new = put.s

    if old == "" then return fault(at, "`replace` cannot replace the empty string -- there is one of it between every pair of characters")

    val made = replace_all(s, old, new)

    // **A replacement of the same LENGTH leaves the count alone however many there were**, which is
    // the ordinary case -- one character for another, or a word for a word of the same size.
    if put.chars == gone.chars then return Ok(str_counted(made, subject.chars))

    // **Otherwise how many times it replaced is the difference in BYTES divided by the difference
    // each one makes**, which is exact: every occurrence moved the byte length by the same amount.
    // Where the two spellings are the same number of BYTES and a different number of characters
    // nothing in the length says how many there were, so that one is counted.
    if new.bytes.len == old.bytes.len then return Ok(str_value(made))

    val each = if new.bytes.len > old.bytes.len then new.bytes.len - old.bytes.len else old.bytes.len - new.bytes.len
    val moved = if made.bytes.len > s.bytes.len then made.bytes.len - s.bytes.len else s.bytes.len - made.bytes.len
    val times = moved / each

    Ok(str_counted(made, subject.chars + times * put.chars - times * gone.chars))
end do_replace

// `padStart(s, n)` and `padEnd(s, n)`, with an optional filler -- the string brought up to a width.
//
// **The width is in CHARACTERS**, which is the rule every position in this file reads by and is the
// whole point of the pair: a column of names lines up only if `é` counts as one.
//
// **A string already that wide is answered unchanged rather than cut**, which is JavaScript's rule
// and the only defensible one -- padding is asking for a minimum, and a `padStart` that truncated
// would lose data in the one call a program made to make it readable.
//
// **The filler REPEATS and is cut to fit**, so `padStart("7", 5, "ab")` is `"abab7"`, and an empty
// filler is a fault: it can never reach the width, so a program asking for one has made a mistake
// that would otherwise show up as a string that silently stayed short.
do_pad(args: Args, at: Span, start: bool) -> Step
    val name = if start then "padStart" else "padEnd"

    if args.len() != 2 && args.len() != 3
        return fault(at, s"`${name}` takes a string, a width and an optional filler, and was given ${counted(args.len(), "argument")}")

    val o = str_cell(args.at(0), at, name, "a string")?
    val s = o.s

    val width = args.at(1) match
        Int(n) ->
            if n < 0 then return fault(at, s"`${name}` takes a width that is not negative, and this is ${n}")

            usize(n)
        other -> return fault(at, s"`${name}` takes a whole number of characters, and this is ${other.type_name()}")

    // The filler's own count comes off its cell beside its text, a filler being a string like any
    // other; the default is one space, which is one character.
    var filler = " "
    var each: usize = 1

    if args.len() == 3
        val f = str_cell(args.at(2), at, name, "a filler")?

        filler = f.s
        each = f.chars

    if filler == "" then return fault(at, s"`${name}` cannot pad with the empty string -- no amount of it reaches a width")

    val have = o.chars

    if have >= width then return Ok(args.at(0))

    val short = width - have
    var pad = str_builder()
    var made: usize = 0

    while made < short
        val room = short - made

        pad.push(if room >= each then filler else char_slice(filler, 0, room))
        made += if room >= each then each else room

    val fill = pad.finish()

    // The padding brought it up to the width, which is what the answer's count is.
    Ok(str_counted(if start then fill + s else s + fill, width))
end do_pad

do_repeat(args: Args, at: Span) -> Step
    wants(args, 2, at, "repeat", "a string and a count")?

    val o = str_cell(args.at(0), at, "repeat", "a string")?
    val s = o.s

    args.at(1) match
        Int(n) ->
            if n < 0 then return fault(at, s"`repeat` takes a count that is not negative, and this is ${n}")

            // A count the machine cannot honour is a fault with a sentence, not an abort. The
            // product is never formed: a string of `wide` bytes repeated more than `limit / wide`
            // times is past the bound, and asking it that way cannot overflow.
            val wide = s.bytes.len
            val limit: usize = 2147483648

            if wide > 0 && usize(n) > limit / wide
                return fault(at, s"`repeat` was asked for ${n} copies of a ${wide}-byte string, and the result would be past the 2147483648 bytes a string can hold")

            // Copies of one string, so the count is that string's, that many times.
            Ok(str_counted(repeat(s, usize(n)), o.chars * usize(n)))
        other -> fault(at, s"`repeat` takes a whole number of times, and this is ${other.type_name()}")
end do_repeat

// -- what this file registers ---------------------------------------------------------------------

// **Text, counted and cut in characters.** A slate string is a sequence of characters and never of
// bytes -- `"日本語".length` is three -- so every one of these takes and answers positions a person
// would count.
var n_chars: NativeFn = 0
var n_split: NativeFn = 0
var n_join: NativeFn = 0

// **Three names that answer about an array or about a string**, dispatched on what they were given
// rather than duplicated under two spellings. A program asks the same question of both, and
// `xs.contains(v)` and `s.contains(sub)` are the same word for the same reason. `includes` is
// declared onto the same native, being that word under JavaScript's spelling.
var n_contains: NativeFn = 0
var n_index_of: NativeFn = 0
var n_last_index_of: NativeFn = 0

var n_starts_with: NativeFn = 0
var n_ends_with: NativeFn = 0
var n_replace: NativeFn = 0
var n_repeat: NativeFn = 0

// **Padding to a WIDTH, which is what a column of text is made of.** The width is counted in
// characters like every other position here, so a name with an accent in it lines up with one
// without.
var n_pad_start: NativeFn = 0
var n_pad_end: NativeFn = 0

// **The bytes under a string, and back.** Global rather than behind an import for the reason
// `string` and `number` are: this is a conversion between two of the kinds a program already has,
// and a protocol that has to count what goes on the wire should not have to say where the counting
// lives. `toBytes(s).length` is the byte count, so there is no third name.
var n_to_bytes: NativeFn = 0
var n_from_bytes: NativeFn = 0

install_text(env: *EnvObj)
    n_chars = register("chars", do_chars)
    n_split = register("split", do_split)
    n_join = register("join", do_join)
    n_contains = register("contains", (args, at) -> if first_is_bytes(args) then do_bytes_contains(args, at) elif first_is_array(args) then do_array_contains(args, at) else do_contains(args, at))
    n_index_of = register("indexOf", (args, at) -> if first_is_bytes(args) then do_bytes_index_of(args, at) elif first_is_array(args) then do_array_index_of(args, at, false) else do_index_of(args, at, false))
    n_last_index_of = register("lastIndexOf", (args, at) -> if first_is_array(args) then do_array_index_of(args, at, true) else do_index_of(args, at, true))
    n_starts_with = register("startsWith", (args, at) -> do_edge(args, at, true))
    n_ends_with = register("endsWith", (args, at) -> do_edge(args, at, false))
    n_replace = register("replace", do_replace)
    n_repeat = register("repeat", do_repeat)
    n_pad_start = register("padStart", (args, at) -> do_pad(args, at, true))
    n_pad_end = register("padEnd", (args, at) -> do_pad(args, at, false))
    n_to_bytes = register("toBytes", do_to_bytes)
    n_from_bytes = register("fromBytes", do_from_bytes)

    declare(env, "chars", Native(n_chars), false)
    declare(env, "split", Native(n_split), false)
    declare(env, "join", Native(n_join), false)
    declare(env, "contains", Native(n_contains), false)
    declare(env, "indexOf", Native(n_index_of), false)
    declare(env, "lastIndexOf", Native(n_last_index_of), false)
    declare(env, "startsWith", Native(n_starts_with), false)
    declare(env, "endsWith", Native(n_ends_with), false)
    declare(env, "replace", Native(n_replace), false)

    // **`replaceAll` IS `replace`, and it is here because a reader coming from JavaScript looks for
    // it.** There, `replace` changes the first occurrence and `replaceAll` changes every one, which
    // is a distinction nobody remembers the right way round and the commonest quiet defect in a
    // string-handling program: `s.replace(",", "")` on a number with two commas in it takes one out.
    // slate's `replace` has always changed every occurrence, so the second name is the same native
    // rather than a second behaviour -- and having it means the JavaScript habit is right rather
    // than half right.
    declare(env, "replaceAll", Native(n_replace), false)
    declare(env, "repeat", Native(n_repeat), false)
    declare(env, "padStart", Native(n_pad_start), false)
    declare(env, "padEnd", Native(n_pad_end), false)

    // **`includes` IS `contains`, under the name JavaScript gave it.** One question about a string
    // and about an array, one implementation, and a reader who typed the other word gets an answer
    // rather than "`includes` is not defined". The page says so in one line rather than describing
    // it twice.
    declare(env, "includes", Native(n_contains), false)

    declare(env, "toBytes", Native(n_to_bytes), false)
    declare(env, "fromBytes", Native(n_from_bytes), false)
end install_text

// -- what a program calls: the bytes under the text ------------------------------------------------

// `toBytes(s)` and `toBytes(s, encoding)` -- the bytes of a string.
//
// **THE ONE PLACE A SLATE PROGRAM SEES AN ENCODING, and it is here because a byte count is sometimes
// the answer to the question.** Everything above counts and cuts by character, which is right for a
// program reasoning about text -- but a protocol that says how much is about to arrive counts what
// goes on the wire, and an HTTP `Content-Length` off by the difference is a client waiting forever
// for a response that has all arrived. `toBytes(s).length` is that number, which is why there is no
// third name for it.
//
// **IT ANSWERS A BUFFER, WHERE IT USED TO ANSWER AN ARRAY OF NUMBERS.** That is the one change a
// program can see: everything that took the array takes the buffer, `toBytes(s).length` is the same
// number, and `toBytes(s).toArray()` is the array for a program that wanted the array's own names.
// The array was sixteen bytes of storage per byte and a tagged read of every one of them, which is
// what made an encoder in slate cost more than the socket it was writing to.
do_to_bytes(args: Args, at: Span) -> Step
    if args.len() != 1 && args.len() != 2
        return fault(at, s"`toBytes` takes a string and an optional encoding, and was given ${counted(args.len(), "argument")}")

    val s = text_of(args.at(0), at, "toBytes", "a string")?

    if args.len() == 1 then return Ok(bytes_value(utf8_bytes(s)))

    if encoding_named(args.at(1), at, "toBytes")?
        Ok(bytes_value(utf8_bytes(s)))
    else
        Ok(bytes_value(latin1_bytes(s, at, "toBytes")?))
end do_to_bytes

// `fromBytes(bs)` and `fromBytes(bs, encoding)` -- bytes read back as text.
//
// **A result, because arbitrary bytes are not text.** Bytes arrive from a socket or a file and
// nothing has promised they decode; answering a string regardless would mean inventing one, and
// answering an empty string would hide the difference between a file that is not text and a file
// that is empty. **latin1 answers `ok` always**, every byte value naming a character there -- which
// is what it is for.
//
// **The pair is what makes a chunked read safe.** A UTF-8 character may be split across two TCP
// chunks, so a program that decodes each chunk as it arrives mangles the character at the seam --
// `onBytes` into a buffer and one `fromBytes` at the end is the reading that cannot.
//
// **Bytes OR an array of numbers**, which is what keeps every program written against the old shape
// working: the array a socket used to deliver still reads back as text here.
do_from_bytes(args: Args, at: Span) -> Step
    if args.len() != 1 && args.len() != 2
        return fault(at, s"`fromBytes` takes bytes and an optional encoding, and was given ${counted(args.len(), "argument")}")

    val bytes = bytes_like(args.at(0), at, "fromBytes")?

    if args.len() == 2 && !encoding_named(args.at(1), at, "fromBytes")?
        return Ok(ok_value(str_value(latin1_text(bytes.view()))))

    from_utf8(bytes.view()) match
        Ok(t) -> Ok(ok_value(str_value(t)))
        Err(_) -> Ok(err_value("these bytes are not text -- they are not valid UTF-8"))
end do_from_bytes

// An array of numbers as bytes, or the complaint about the first element that is not one.
//
// **Not `private`: `send` reads an array the same way**, and two readings of "an array of bytes"
// would be two places for the range check to be got wrong.
bytes_of(a: *ArrayObj, at: Span, name: string) -> Result[Buf[u8], Signal]
    var out: Buf[u8] = buf()

    for i in 0..<a.items.len()
        a.items.at(i) match
            Int(n) ->
                if n < 0 || n > 255 then return Err(failure(at, s"a byte is between 0 and 255, and this is ${n}"))

                out.push(u8(n))
            other -> return Err(failure(at, s"`${name}` takes an array of numbers, and one of these is ${other.type_name()}"))

    Ok(out)
end bytes_of
