module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.from_utf8_unchecked

// The interned strings of one ASCII character (`small_str.sysl`).
//
// **What has to stay true is that nobody can tell**: a string is immutable and compares by text, so
// handing every holder one cell must change nothing a program reads -- through a collection, an
// append that makes a room, and a heap that is rebuilt under the table.

private cell(v: Value) -> *StrObj
    v match
        Str(p) -> return p
        _ -> ()

    assert(false, "a string answers a string cell")
    null
end cell

private st(text: string) -> *StrObj = new_str_scanned(text)

@test
THE_SAME_ASCII_CHARACTER_IS_THE_SAME_CELL_EVERY_TIME_IT_IS_ASKED_FOR()
    reset_vm()
    reset_heap()

    val a = cell(small_str(u8('a')))

    assert(cell(small_str(u8('a'))) == a, "asking twice answers one cell")
    assert(cell(str_char_value(st("xay"), 1)) == a, "`s[i]` answers the interned cell")
    assert(cell(str_slice(st("bab"), 1, 2)) == a, "a slice of one character answers it too")
    assert(cell(cut_value("za", 1, 2, 1)) == a, "and a piece `chars` cuts")
    assert(cell(piece_value("a", 1)) == a, "and a piece `split` cut")
    assert_eq(a.s, "a")
    assert_eq(a.chars, 1usize)
    assert(a.room == null, "an interned cell has no room")
end THE_SAME_ASCII_CHARACTER_IS_THE_SAME_CELL_EVERY_TIME_IT_IS_ASKED_FOR

@test
A_SINGLE_DIGIT_PRINTED_BY_string_IS_INTERNED_AND_TEN_IS_NOT()
    reset_vm()
    reset_heap()

    val seven = cell(printed_value(Int(7), point(0)).unwrap())

    assert(cell(printed_value(Int(7), point(0)).unwrap()) == seven, "string(7) makes one cell")
    assert(cell(small_str(u8('7'))) == seven, "and it is the character's own")
    assert_eq(seven.s, "7")

    val ten = cell(printed_value(Int(10), point(0)).unwrap())

    assert(cell(printed_value(Int(10), point(0)).unwrap()) != ten, "two digits are a new cell each time")
    assert_eq(ten.s, "10")
    assert_eq(cell(printed_value(Int(-3), point(0)).unwrap()).s, "-3", "a negative digit is not one character")
end A_SINGLE_DIGIT_PRINTED_BY_string_IS_INTERNED_AND_TEN_IS_NOT

@test
A_CHARACTER_OUTSIDE_ASCII_IS_NOT_INTERNED()
    reset_vm()
    reset_heap()

    val s = st("aéb€")
    val e1 = cell(str_char_value(s, 1))
    val e2 = cell(str_char_value(s, 1))

    assert(e1 != e2, "a two-byte character is a cell per read")
    assert_eq(e1.s, "é")
    assert_eq(e1.chars, 1usize)
    assert_eq(cell(str_char_value(s, 3)).s, "€")
    assert(cell(str_slice(s, 1, 2)) != cell(str_slice(s, 1, 2)), "and so is a slice of one")
    assert(cell(str_char_value(s, 2)) == cell(small_str(u8('b'))), "an ASCII character of such a string still is")

    // A lone byte of 0x80 or above counts as one character on its own and is not ASCII.
    var raw: Buf[u8] = buf()

    raw.push(0x80)

    val odd = st(from_utf8_unchecked(raw.view()))

    assert_eq(odd.chars, 1usize)
    assert(cell(str_char_value(odd, 0)) != cell(str_char_value(odd, 0)), "an ill-formed byte is not interned")
end A_CHARACTER_OUTSIDE_ASCII_IS_NOT_INTERNED

@test
AN_INTERNED_CELL_SURVIVES_A_COLLECTION_AND_A_REBUILT_HEAP_EMPTIES_THE_TABLE()
    reset_vm()
    reset_heap()

    val q = cell(small_str(u8('q')))

    // Nothing but the table holds it now.
    collect_now()
    collect_now()

    assert(cell(small_str(u8('q'))) == q, "the table still names the same cell after two collections")
    assert_eq(q.s, "q", "and the cell still reads its text")

    reset_heap()

    assert(current().small_strs.at(usize(u8('q'))) == null, "a rebuilt heap starts the table empty")
    assert_eq(cell(small_str(u8('q'))).s, "q", "and fills it again when asked")
end AN_INTERNED_CELL_SURVIVES_A_COLLECTION_AND_A_REBUILT_HEAP_EMPTIES_THE_TABLE

@test
A_PROGRAM_CANNOT_TELL_ONE_SHARED_CELL_FROM_MANY()
    reset_vm()
    reset_heap()

    // An interned character appended to until it has a room, kept prefixes, and characters read
    // back out of what was built: every one reads what it was made as.
    val said = out("val a = \"xyz\"[0]\nvar s = a\nfor i in 0..<200\n    s += string(i % 10)\nval b = chars(\"xq\")[0]\nval kept = [a, b, string(3), \"a3\"[1], split(\"x,3\", \",\")]\nprint([a, a.length, b == a, s.length, s[0], s[1], s[200], kept])")

    assert_eq(said, "[\"x\", 1, true, 201, \"x\", \"0\", \"9\", [\"x\", \"x\", \"3\", \"3\", [\"x\", \"3\"]]]")
end A_PROGRAM_CANNOT_TELL_ONE_SHARED_CELL_FROM_MANY

@test
A_PROGRAM_THAT_FILLS_A_SMALL_HEAP_WITH_ONE_CHARACTER_STRINGS_READS_THEM_ALL_BACK()
    reset_vm()
    set_heap_limit(1048576)

    val said = out("var xs = []\nfor i in 0..<5000\n    xs.push(string(i % 10))\n    xs.push(\"abcdefghij\"[i % 10])\n    val junk = [i, { a: i }]\nvar ok = true\nfor i in 0..<5000\n    if xs[2 * i] != string(i % 10) || xs[2 * i + 1] != \"abcdefghij\"[i % 10]\n        ok = false\nprint([ok, xs.length])")

    set_heap_limit(268435456)
    assert_eq(said, "[true, 10000]")
end A_PROGRAM_THAT_FILLS_A_SMALL_HEAP_WITH_ONE_CHARACTER_STRINGS_READS_THEM_ALL_BACK
