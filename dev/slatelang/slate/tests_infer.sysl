module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// What the checker works out that nobody wrote down: what a call answers, what a `var` holds after
// it is assigned to, what a field read gives, what a callback's parameter is, what a type parameter
// is filled with, and what an array literal says about its elements.
//
// **Cut out of `tests_types.sysl` on the heading that was already there.** A test file declares no
// helpers of its own -- `out`, `fails` and `Opaque` are `tests_kit.sysl`'s -- so nothing crosses.
// -- what a call answers, and `any` -----------------------------------------------------------------

@test
boolean_is_truthiness_and_slates_truthiness_is_not_javascripts()
    // **Only `null`, `undefined` and `false` are falsy**, which is Lua's rule and slate's own `if`.
    // A reader from JavaScript will expect `boolean(0)` to be false; it is not, and `if 0` agrees.
    assert_eq(out("print(boolean(null), boolean(false), boolean(0), boolean(\"\"), boolean([]))"), "false false true true true")
    assert_eq(out("print(if 0 then \"t\" else \"f\", if \"\" then \"t\" else \"f\")"), "t t")

// **`-> type` had to come first, because nothing downstream of a call can be checked without it.**
// It is read where a parameter's annotation is read and wraps the body the same way, so `Def` and
// `Lambda` learn nothing and neither does anything that reads them.
//
// The check it emits today is a runtime one, testing what the body left on the stack. What it is
// *for* is the static pass that will read `Type` instead.

@test
a_definition_may_say_what_it_answers()
    assert_eq(out("double(x: number) -> number = x * 2\nprint(double(4))"), "8")
    assert_eq(out("greet(who: string) -> string\n    s\"hello ${who}\"\nprint(greet(\"world\"))"), "hello world")
    assert_eq(out("count(xs: array) -> integer = len(xs)\nprint(count([1, 2, 3]))"), "3")

@test
answering_the_wrong_kind_is_a_fault_where_it_was_answered()
    val said = fails("name(p: { id: number }) -> string = p.id\nprint(name({ id: 7 }))")

    assert(said.contains("this answers string, and gave back 7"))

@test
a_result_annotation_naming_no_type_is_refused_and_points_at_itself()
    // **At the annotation, not at the body.** The wrapped expression is the whole function; what a
    // reader has to change is the `-> Nope`.
    val said = fails("bad(x) -> Nope = x")

    assert(said.contains("`Nope` is not a type, so `-> Nope` would check nothing"))
    assert(said.contains("1 | bad(x) -> Nope = x"))

@test
any_is_a_type_and_matches_everything()
    // **What an unannotated thing is**, and the shape a gradual system has to have: slate is
    // dynamically typed at the edges and always will be, so `any` is a claim about a value rather
    // than a refusal to make one.
    assert_eq(out("f(x: any) -> any = x\nprint(f(1), f(\"s\"), f(null))"), "1 s null")
    assert_eq(out("print(1 is any, null is any, [] is any)"), "true true true")

@test
a_type_is_read_off_an_annotation_and_said_back()
    // **`Type` is not `Pattern`, which is the whole reason it exists** -- a pattern tests a value and
    // a type describes one. One annotation makes both: the pattern goes to the machine and the type
    // stays for the checker. This is what proves the fork works before anything reads the far side.
    assert_eq(type_text("number"), "number")
    assert_eq(type_text("any"), "any")
    assert_eq(type_text("array"), "array")
    assert_eq(type_text("{ x: number, y: string }"), "{ x: number, y: string }")
    assert_eq(type_text("string | null"), "string | null")
    assert_eq(type_text("{ a: { b: boolean } }"), "{ a: { b: boolean } }")

@test
A_NAME_A_PATTERN_TESTED_AND_BOUND_CARRIES_THE_TESTS_TYPE()
    // **`n @ int` is the one place a pattern says something a walk can use.** A bare name matches
    // anything, so anything is what is known about it; `@` is the spelling slate already had for
    // testing and naming at once, and the name is worth exactly what the test proved.
    //
    // What it buys is the method-name check, which is this pass's best feature -- a name that could
    // only ever hold an integer being asked to `push`.
    assert(fails("val v = 3\nprint(v match\n    n @ int -> n.push(1)\n    _ -> \"?\")").contains("`push` is not something an integer can do"))

    // And the right call on the same name is untouched.
    assert_eq(out("val v = \"abc\"\nprint(v match\n    s @ string -> s.upper()\n    _ -> \"?\")"), "ABC")

@test
A_CLASS_NAME_IN_AN_AT_PATTERN_IS_RESOLVED_LIKE_ANY_OTHER_TYPE()
    // The sub-pattern goes through `resolve_pattern` before it is read for a type, so a declared
    // `type` and a `class` both work where a bare name would have been a binding and answered `any`.
    val prog = "type Two = { a: integer, b: integer }\nval v = { a: 1, b: 2 }\nprint(v match\n    t @ Two -> t.a + t.b\n    _ -> 0)"

    assert_eq(out(prog), "3")

@test
THE_NAME_A_catch_BINDS_IS_KNOWN_TO_BE_A_FAULT()
    // **The one name in the language whose shape is known without anybody writing it down.** `throw`
    // turns whatever a program raised into the same three fields every other fault leaves, so a
    // `catch` name is `{ message, line, file }` and nothing else has to say so.
    assert(fails("try\n    throw \"x\"\ncatch e\n    print(e.push(1))").contains("`push` is not a field of this object"))

    // **Reading a field it does not list is still allowed, and that is not an oversight.** An object
    // type means AT LEAST these fields, and a program may write more onto a fault it caught.
    assert_eq(out("try\n    throw \"x\"\ncatch e\n    e.retry = () -> \"again\"\n    print(e.message, e.retry())"), "x again")
@test
A_BUILTIN_WHOSE_LAST_ARGUMENT_MAY_BE_LEFT_OUT_IS_COUNTED_AT_BOTH_ENDS()
    // **This is what default parameters bought the natives.** A signature carries `required` as well
    // as its parameters, so a builtin taking a range of counts can be written down at last. Before
    // that a signature could say only one number and would have refused the other count, so every
    // one of these said nothing at all and was checked only by the machine, one call too late.
    assert_eq(out("print(toJSON({ a: 1 }))"), "{\"a\":1}")

    // The laid-out form differs from the compact one, which is the second argument doing its work --
    // asserted without pinning what the indentation looks like.
    assert_eq(out("print(toJSON([1, 2], 2) != toJSON([1, 2]))"), "true")

    val few = fails("print(toJSON())")
    val many = fails("print(toJSON(1, 2, 3))")

    assert(few.contains("takes from 1 to 2 arguments"))
    assert(many.contains("takes from 1 to 2 arguments"))

    // **`this gives it` is the CHECKER's wording where `was given` is the machine's**, and that is
    // the seam being tested: the complaint now arrives before the program runs.
    assert(few.contains("this gives it 0"))
    assert(many.contains("this gives it 3"))

@test
THE_OPTIONAL_ARGUMENT_OF_A_BUILTIN_IS_TYPE_CHECKED_TOO()
    // Saying the range is what put a parameter opposite the second argument at all -- with no
    // signature there was nothing to compare it to, so this went unread.
    val said = fails("print(toJSON({}, \"two\"))")

    assert(said.contains("toJSON"))
    assert(said.contains("string"))
    assert_eq(fails("print(toJSON({}, 2))"), "")

@test
A_BUILTIN_TAKING_TWO_OR_THREE_ARGUMENTS_SAYS_SO()
    assert(fails("assertEq(1, 1, \"m\", 4)").contains("takes from 2 to 3 arguments"))
    assert(fails("assertEq(1)").contains("takes from 2 to 3 arguments"))
    assert_eq(fails("assertEq(1, 1)"), "")
    assert_eq(fails("assertEq(1, 1, \"m\")"), "")

@test
AN_OPTIONAL_COMPARATOR_IS_A_PARAMETER_LIKE_ANY_OTHER()
    assert_eq(out("print(join(sorted([\"c\", \"a\", \"b\"]), \"-\"))"), "a-b-c")
    assert_eq(out("print(join(sorted([\"c\", \"a\", \"b\"], (a, b) -> a > b), \"-\"))"), "c-b-a")
    assert(fails("print(sorted([1], (a, b) -> a, 3))").contains("takes from 1 to 2 arguments"))

@test
A_TIMERS_DELAY_MAY_BE_A_NUMBER_OR_A_DURATION()
    // **The signature has to allow both or it would refuse a timer that runs**, `do_timer` reading a
    // number of milliseconds and a duration alike. This is the case a generous parameter type is for.
    assert_eq(out("setTimeout(() -> print(\"n\"), 1)"), "n")
    assert_eq(out(TimeImport + "setTimeout(() -> print(\"d\"), millis(1))"), "d")
    assert(fails("setTimeout(() -> 1, \"soon\")").contains("string"))

@test
NEWLY_TYPED_BUILTINS_STILL_ACCEPT_EVERYTHING_THEY_ACCEPTED()
    // **A wrong parameter type refuses a program that RUNS**, which is the whole risk in writing a
    // signature down where there was none. Both counts of each, and the shapes the tests elsewhere
    // in this suite already call them with.
    assert_eq(fails("assert(true)"), "")
    assert_eq(fails("assert(true, \"m\")"), "")
    assert_eq(fails("val xs = [2, 1]\nsort(xs)"), "")
    assert_eq(fails("val xs = [2, 1]\nsort(xs, (a, b) -> a < b)"), "")
    assert_eq(fails("print(len(sorted([1])))"), "")
    assert_eq(out("counter()\n    yield 1\n    yield 2\nval g = counter()\nprint(next(g).value, next(g, \"sent\").value)"), "1 2")

    // `fetch` is refused before a request is made, which is what lets this be asserted with no
    // server: a checker complaint means the program never ran.
    assert(fails("fetch(5)").contains("fetch"))

@test
A_LOOP_OVER_A_KNOWN_LIST_TYPES_ITS_NAME()
    // **`ArrayOf` has carried its element since this pass was written and had nothing but `Any` to
    // put there.** `array of T` is what finally gives it one, so the loop variable stops saying
    // nothing -- and the method-name check, which is this pass's best feature, reads it.
    val users = "type Us = array of string\n"

    assert_eq(fails(users + "walk(us: Us) =\n    for u in us\n        print(u.upper())\nwalk([\"a\"])"), "")
    assert(fails(users + "walk(us: Us) =\n    for u in us\n        print(u.push(1))\nwalk([\"a\"])").contains("`push` is not something a string can do"))

    // **A bare `array` still says nothing**, its element being `Any` -- so nothing is claimed about
    // a loop over one, which is the direction this pass is allowed to be wrong in.
    assert_eq(fails("walk(us: array) =\n    for u in us\n        print(u.push(1))\nwalk([[1]])"), "")

    // **Only a BARE name is typed.** Anything else is a pattern taking the element apart, and what
    // its names catch is the pattern's business rather than the element type's.
    assert_eq(fails("type P = array of object\nwalk(ps: P) =\n    for { a } in ps\n        print(a)\nwalk([{ a: 1 }])"), "")

@test
WHAT_A_REST_PARAMETER_CATCHES_IS_AN_ARRAY_AND_THE_PATTERN_SAYS_SO_ALONE()
    // **The one binding that has a type without a subject.** `...rest` is bound to an array
    // whatever a call gave it -- an empty one where nothing was left over -- so there is no call
    // that makes it anything else and nothing has to be known about the arguments.
    assert(fails("f(a, ...rest) = rest.upper()\nprint(f(1))").contains("`upper` is not something an array can do"))
    assert_eq(fails("f(a, ...rest) = rest.len()\nprint(f(1))"), "")

    // The same answer in a pattern, where `...` has always meant the same thing.
    assert(fails("val [a, ...r] = [1, 2]\nprint(r.upper())").contains("`upper` is not something an array can do"))
    assert_eq(fails("val [a, ...r] = [1, 2]\nprint(r.len())"), "")

@test
A_KEY_AN_ANNOTATION_MARKED_OPTIONAL_NEED_NOT_BE_THERE()
    // **The type dropped the `?` an object pattern carried, so this pass refused programs that
    // RUN** -- which is the one mistake it may not make. `match_object` skips a key the pattern
    // called optional, so `{ ok: true, value: 9 }` matches `{ ok: boolean, value?: any, error?:
    // string }` at run time; the checker was demanding all three and refusing the commonest shape
    // in the language, a result. Found writing `slate:redis`'s own `Reply`.
    val reply = "type Reply = { ok: boolean, value?: any, error?: string }\nsaid(r: Reply) = \"fine\"\n"

    assert_eq(out(reply + "print(said({ ok: true, value: 9 }))"), "fine")
    assert_eq(out(reply + "print(said({ ok: false, error: \"no\" }))"), "fine")
    assert_eq(out(reply + "print(said({ ok: true }))"), "fine")

    // **A key that IS there still has to fit**, which is also what the matcher does: optional says
    // the field may be absent, never that anything at all may be under it.
    assert(fails(reply + "print(said({ ok: true, error: 42 }))").contains("this is { ok: boolean, error: integer }"))

    // A key with no `?` is owed as it always was, and the complaint writes the `?` back so a reader
    // can see which of the fields they had to supply.
    assert(fails(reply + "print(said({ value: 9 }))").contains("{ ok: boolean, value?: any, error?: string }"))

    // **The machine agrees, which is what makes the change sound rather than merely convenient.**
    // `is` asks the pattern directly, with no annotation and no checker anywhere near it.
    assert_eq(out("type R = { ok: boolean, error?: string }\nprint({ ok: true } is R, { ok: true, error: \"x\" } is R, { ok: true, error: 1 } is R)"),
        "true true false")

// -- what a `var` holds, and what a field read answers ---------------------------------------------
//
// Two of the checker's absences rested on the same fact -- that a name may be written to, or may be
// handed somewhere that writes to what it holds -- and `flow.sysl` answers both by reading the rest
// of the block rather than by looking harder at the declaration.

@test
A_VAR_IS_TYPED_BY_EVERY_ASSIGNMENT_TO_IT_AND_NOT_BY_ITS_INITIALISER_ALONE()
    // **The union does not depend on the order the lines run in**, which is what makes reading them
    // out of order sound: every assignment to a local is written in the block that declared it, so
    // there is nothing else that could put a value there.
    assert(fails("g(n: integer) = n\nh() =\n    var x = \"s\"\n    g(x)\nh()").contains("this is string"))
    assert(fails("g(n: integer) = n\nh() =\n    var x = \"s\"\n    x = \"t\"\n    g(x)\nh()").contains("this is string"))

@test
A_VAR_THE_PROGRAM_REASSIGNS_TO_ANOTHER_KIND_IS_SAID_NOTHING_ABOUT()
    // A union of two kinds is not something to argue from, so it is `Any` -- and a program that
    // runs is not refused, which is the one thing this pass may not do.
    assert_eq(fails("g(n: integer) = n\nh() =\n    var x = \"s\"\n    x = 1\n    g(x)\nprint(h())"), "")

@test
A_COUNTER_KEEPS_ITS_TYPE_THROUGH_A_COMPOUND_ASSIGNMENT_AND_A_BUMP()
    // **A compound assignment is the operator it carries**, so what lands in the name is what
    // `binary_type` says that operator answers -- the same table the machine works to.
    assert(fails("g(s: string) = s\nh() =\n    var n = 0\n    n += 1\n    n++\n    g(n)\nh()").contains("this is integer"))

    // `+=` with an operand of another kind leaves a type there this pass will not argue from.
    //
    // **Asked of the COMPILE rather than of a run**, `js` handing back the checker's complaint where
    // there was one: a program written to show that nothing is said about `n` cannot also be one
    // that runs, since the only way to show it is to hand `n` somewhere it does not belong.
    assert(!js("g(s: string) = s\nh() =\n    var n = 0\n    n += 1.5\n    g(n)\nh()").contains("and this is"))

@test
A_MULTIPLE_ASSIGNMENT_IS_SAID_NOTHING_ABOUT()
    // Which value lands on which target is a question about counts, and this pass does not count.
    assert_eq(fails("g(n: integer) = n\nh() =\n    var x = \"s\"\n    var y = 1\n    x, y = 1, \"s\"\n    g(x)\nprint(h())"), "")

@test
A_FIELD_READ_IS_TYPED_WHERE_NOTHING_COULD_HAVE_MADE_THE_SHAPE_STALE()
    // A `val` whose name is never mentioned except to read a field off it cannot have been handed
    // anywhere, so the shape it was built with is the shape it dies with.
    assert(fails("g(n: integer) = n\nh() =\n    val o = { x: \"s\" }\n    g(o.x)\nh()").contains("this is string"))

@test
A_FIELD_READ_IS_ANY_WHERE_THE_OBJECT_COULD_HAVE_ESCAPED()
    // **Mentioning the name at all is what gives the shape up.** Passing it hands the object to code
    // that may add a field or change the type of one, and nothing local says so afterwards.
    assert(!js("g(n: integer) = n\naway(o) = o\nh() =\n    val o = { x: \"s\" }\n    away(o)\n    g(o.x)\nh()").contains("and this is"))

    // `o with { ... }` is a mention too: the whole object is what the copy is made from.
    assert(!js("g(n: integer) = n\nh() =\n    val o = { x: \"s\" }\n    val p = o with { y: 1 }\n    g(o.x)\nh()").contains("and this is"))

@test
A_FIELD_READ_IS_ANY_WHERE_A_FIELD_WAS_WRITTEN()
    // `val` binds the reference and not the fields, so a recorded shape would say `string` about
    // something that had been assigned an integer.
    assert_eq(fails("g(n: integer) = n\nh() =\n    val o = { x: \"s\" }\n    o.x = 1\n    g(o.x)\nprint(h())"), "")
    assert_eq(fails("g(n: integer) = n\nh() =\n    val o = { x: \"s\" }\n    o[\"x\"] = 1\n    g(o.x)\nprint(h())"), "")

@test
A_GUARDED_FIELD_READ_IS_SAID_NOTHING_ABOUT()
    // `o?.x` answers `null` where there is nothing to read from, so what it hands back is not the
    // field's type but that or nothing -- and reporting the field's type would refuse the guard.
    assert(!js("g(n: integer) = n\nh() =\n    val o = { x: \"s\" }\n    g(o?.x)").contains("and this is"))

    // The unguarded read of the same field is the one that is typed.
    assert(js("g(n: integer) = n\nh() =\n    val o = { x: \"s\" }\n    g(o.x)").contains("and this is string"))

@test
AN_ANNOTATED_PARAMETERS_SHAPE_IS_NOT_KEPT_AND_THE_REASON_IS_THE_CALLER()
    // **`note_type` drops a parameter's shape and `flow.sysl` cannot give it back**, because the
    // object came from somewhere else: the caller may hold another name for it and write a field
    // through that, and nothing in this function's block would say so. The annotation is checked on
    // the way in and says nothing about what happens after.
    assert(!js("g(n: integer) = n\nf(o: { x: string }) = g(o.x)").contains("and this is"))

@test
A_NOMINAL_VALUES_TYPE_IS_ITS_NAME_AND_NOT_THE_FIELDS_IT_DESUGARS_TO()
    // **A singleton data variant is a `val` bound to an object literal carrying `proto` and the
    // tag**, so keeping its shape made `Empty` a `{ proto: any, (data): string }` that no longer fit
    // the data type it belongs to -- refusing four programs that run.
    assert_eq(out("data Shape\n    Circle(r)\n    Empty\narea(s: Shape) = s match\n    Circle(r) -> r\n    Empty -> 0\nprint(area(Empty))"), "0")

// -- what a call answers, said in terms of what it was given ----------------------------------------
//
// **Not generics, and it is what generics was asked for.** `array of T` is checked element by
// element AT RUN TIME, at a parameter and at a declared result, so a complaint about an element type
// is one the machine would also make -- which is what makes it legal for this pass to make it first.
// A marker names an argument by position and is replaced by that argument's type; there is no
// binding, no scope and no unification.

@test
AN_ELEMENT_PRESERVING_BUILTIN_ANSWERS_WHAT_IT_WAS_GIVEN()
    // `filter` used to answer bare `array`, which threw away the one thing the caller knew. The
    // machine refuses this program; now the pass refuses it first.
    assert(fails("f(xs: array of string) = len(xs)\nh(ns: array of integer) = f(filter(ns, n -> n > 1))\nh([1, 2])").contains("takes array of string here, and this is array of integer"))
    assert(fails("f(xs: array of string) = len(xs)\nh(ns: array of integer) = f(reversed(sorted(ns)))\nh([2, 1])").contains("this is array of integer"))

@test
AND_STILL_ACCEPTS_THE_ONE_THAT_FITS()
    // The half that matters more: refusing a program that runs is the one thing this pass may not
    // do, and a result rule that is too narrow is exactly how that happens.
    assert_eq(fails("f(xs: array of string) = len(xs)\nh(ss: array of string) = f(filter(ss, s -> s != \"\"))\nprint(h([\"a\"]))"), "")
    assert_eq(fails("f(xs: array of string) = len(xs)\nh(ss: array of string) = f(sorted(ss))\nprint(h([\"a\"]))"), "")

    // A bare `array` says nothing about its elements, so nothing is said about the result either.
    assert_eq(fails("f(xs: array of string) = len(xs)\nh(ns) = f(filter(ns, n -> true))\nprint(h([\"a\"]))"), "")

@test
AN_ELEMENT_IS_TAKEN_OUT_OF_THE_ARRAY_IT_CAME_FROM()
    // `pop` faults on an empty array rather than answering nothing, so it always gives back an
    // element -- where `find` has to say it found nothing, which is `indexOf`'s shape one level up.
    assert(fails("g(s: string) = s\nh(ns: array of integer) =\n    var xs = ns\n    g(pop(xs))\nh([1])").contains("takes string here, and this is integer"))
    assert(fails("g(s: string) = s\nh(ns: array of integer) = g(find(ns, n -> n > 1))\nh([1, 2])").contains("this is integer | null"))

@test
A_LAMBDA_ANSWERS_WHAT_ITS_BODY_ANSWERS()
    // **A lambda is the one function that cannot SAY what it answers** -- `x -> integer` is a body
    // handing back the builtin, and there is nowhere else to write one -- so inferring it is the
    // only way `map` can say anything at all.
    assert(fails("g(n: integer) = n\nh() =\n    val f = x -> \"s\"\n    g(f(1))\nh()").contains("takes integer here, and this is string"))
    assert(fails("f(xs: array of integer) = len(xs)\nh(ns: array of integer) = f(map(ns, n -> string(n)))\nh([1])").contains("this is array of string"))

// -- A CALLBACK IS HANDED AN ELEMENT, AND THAT IS THE PART THAT IS GENERICS ------------------------
//
// A marker names an argument by position and says the same thing in a PARAMETER as it does in a
// result, so `map`'s function is `(<an element of argument 0>) -> any` and a lambda written at the
// call gets its parameter typed instead of `Any`. That is the relationship a type variable
// expresses, arrived at from the other end: there is still no binding, no scope and no unification.
//
// **It is sound on this pass's own terms.** `call_on` in `array.sysl` hands the callback the element
// and nothing else, and every `array of T` the pass holds is one the machine checked element by
// element at a parameter or a declared result -- so a complaint about what a callback does with what
// it was handed is one the machine would also make.

@test
A_LAMBDAS_PARAMETER_IS_AN_ELEMENT_OF_THE_ARRAY_BESIDE_IT()
    // This is the program the previous release could not refuse: `n` was `Any`, so `n * 2` was too,
    // and `map(ns, n -> n * 2)` answered `array of any`. The machine refused it at the call and the
    // pass refuses it first now.
    assert(fails("f(xs: array of string) = len(xs)\nh(ns: array of integer) = f(map(ns, n -> n * 2))\nprint(h([1]))").contains("takes array of string here, and this is array of integer"))

    // And the method spelling carries it, `xs.map(f)` being `map(xs, f)`.
    assert(fails("f(xs: array of string) = len(xs)\nh(ns: array of integer) = f(ns.map(n -> n * 2))\nprint(h([1]))").contains("this is array of integer"))

@test
A_MISTAKE_INSIDE_A_CALLBACKS_BODY_IS_CAUGHT_NOW()
    // The half worth more than the result type: the body is checked knowing what it was handed, so
    // an operator and a method name are both answerable inside a lambda. Both are faults the machine
    // raises the moment the callback runs.
    assert(fails("g(ss: array of string) = map(ss, s -> s * 2)\nprint(g([\"a\"]))").contains("`*` does not apply to string and integer"))
    assert(fails("h(ns: array of integer) = forEach(ns, n -> n.upper())\nh([1])").contains("`upper` is not something an integer can do"))

@test
A_CALLBACK_OF_THE_WRONG_ARITY_IS_REFUSED_AND_A_COMPARATOR_TAKES_TWO()
    // The count is the machine's: `call_on` gives one argument and `apply` faults on any other
    // number, so a function that takes two is refused where one element is handed over -- and a
    // comparator, which is handed two, is refused where it takes one.
    assert(fails("h(ns: array of integer) = map(ns, (a, b) -> a)\nprint(h([1]))").contains("`map` takes (integer) -> any here"))
    assert(fails("h(ns: array of integer) = sorted(ns, a -> a)\nprint(h([2, 1]))").contains("`sorted` takes (integer, integer) -> any here"))

    // The ordinary comparator still fits, which is the direction that matters more.
    assert_eq(fails("h(ns: array of integer) = sorted(ns, (a, b) -> a < b)\nprint(h([2, 1]))"), "")

@test
A_REDUCE_KNOWS_ITS_ELEMENT_AND_NOT_ITS_ACCUMULATOR()
    // The accumulator is the starting value on the first turn and whatever the function last
    // answered on every other, which is not one type a signature can name -- so it stays `Any` and
    // only the element is said. The result is then what the lambda answers.
    assert(fails("g(s: string) = s\nh(ns: array of integer) = g(reduce(ns, (acc, n) -> n * 2, 0))\nprint(h([1]))").contains("takes string here, and this is integer"))

    // Nothing is claimed about the accumulator, so a program that changes its kind is left alone.
    assert_eq(fails("h(ns: array of integer) = reduce(ns, (acc, n) -> string(acc) + string(n), 0)\nprint(h([1, 2]))"), "")

@test
A_REST_PARAMETER_IN_A_CALLBACK_IS_AN_ARRAY_AND_NOT_AN_ELEMENT()
    // `...rest` gathers, so what an expectation says about one element has nothing to do with it --
    // it is an array whatever a call gave it, which is the answer it already had.
    assert_eq(out("h(ns: array of integer) = map(ns, (...rest) -> len(rest))\nprint(h([1, 2]))"), "[1, 1]")

@test
A_BARE_ARRAY_STILL_SAYS_NOTHING_ABOUT_WHAT_ITS_CALLBACK_IS_HANDED()
    // `array` on its own carries `Any` for its element, so the expectation is `Any` and the lambda is
    // typed exactly as it was. Refusing a program that runs is the one mistake this pass may not
    // make, and this is where it would happen.
    assert_eq(out("h(ns) = map(ns, n -> n * 2)\nprint(h([1, 2]))"), "[2, 4]")
    assert_eq(out("print(map([1, 2], n -> n * 2))"), "[2, 4]")

@test
AN_ARGUMENT_NOBODY_CAN_PLACE_LEAVES_A_CALLBACK_WITH_NOTHING_SAID_ABOUT_IT()
    // A spread stands for an unknown number of arguments, so the array is not certainly at the
    // position the marker names and the callback is typed as it always was. The prefix before a
    // spread is still fixed, which is why the result type survives in the first of these.
    assert(fails("f(xs: array of string) = len(xs)\nh(ns: array of integer) =\n    val rest = [(n -> n > 1)]\n    f(filter(ns, ...rest))\nprint(h([1, 2]))").contains("this is array of integer"))
    assert_eq(fails("h(ns: array of integer) =\n    val all = [ns, (n -> n * 2)]\n    print(map(...all))\nh([1, 2])"), "")

@test
A_CALLBACKS_PARAMETER_MARKER_NEVER_REACHES_A_READER_EITHER()
    // `write_type` spells a marker rather than leaving it to an `else`, so one that escaped would
    // say what it is -- and a complaint about a callback quotes the parameter type, which is where
    // one would escape from. `resolved` replaces it before the message is built.
    val said = fails("h(ns: array of integer) = map(ns, (a, b) -> a)\nprint(h([1]))")

    assert(!said.contains("<the type of argument"))
    assert(!said.contains("<an element of argument"))
    assert(!said.contains("<what argument"))

@test
A_LAMBDAS_PARAMETER_DOES_NOT_PICK_UP_AN_OUTER_NAME()
    // The parameters go into a scope of their own before the body is read. Without that, the `x`
    // below would be the string one line up and the lambda would answer string.
    assert_eq(fails("g(n: integer) = n\nh() =\n    val x = \"s\"\n    val f = x -> x\n    g(f(1))\nprint(h())"), "")

@test
AN_ASYNC_LAMBDA_ANSWERS_A_PROMISE_AND_NOT_WHAT_ITS_BODY_SAYS()
    // `signature_of`'s rule for the same reason: the body's value is what AWAITING the call gives
    // back, not what calling it does.
    // The machine hands `g` a PROMISE, which is what the pass would have had to be wrong about to
    // say anything: had it read the body and answered string, it would have refused this program at
    // `g(f(1))` for the wrong reason.
    assert(fails("g(n: integer) = n\nh() =\n    val f = async x -> \"s\"\n    g(f(1))\nprint(h())").contains("was given <promise"))

@test
A_MARKER_IS_GONE_BY_THE_TIME_A_MESSAGE_QUOTES_A_TYPE()
    // A marker may only appear in a signature's result and `resolved_result` replaces it at the call
    // site, so no diagnostic can ever name one. This asserts the message a reader actually sees.
    val said = fails("f(xs: array of string) = len(xs)\nh(ns: array of integer) = f(filter(ns, n -> n > 1))\nh([1, 2])")

    assert(!said.contains("<the type of argument"))
    assert(!said.contains("<an element of argument"))
    assert(!said.contains("<what argument"))

@test
A_SPREAD_GIVES_UP_THE_POSITIONS_AFTER_IT_AND_NOT_THE_ONES_BEFORE()
    // **A spread stands for an unknown number of arguments, so everything AFTER it moves and nothing
    // before it does.** The prefix is still at the positions it was written at, which is why the
    // element type survives a spread in the second slot -- and the machine refuses the same program.
    assert(fails("f(xs: array of string) = len(xs)\nh(ns: array of integer) =\n    val rest = [(n -> n > 1)]\n    f(filter(ns, ...rest))\nprint(h([1, 2]))").contains("this is array of integer"))

    // Spread into the FIRST slot and there is nothing certain left to say, so the pass lets it
    // through and the machine is what refuses it.
    // **The complaint quotes the annotation as it was WRITTEN**, so this says `array of string`
    // rather than the `array` its first word used to read as -- the message is the source text of
    // the annotation, which is what makes it right for a structural type and a function type too.
    assert(fails("f(xs: array of string) = len(xs)\nh(ns: array of integer) =\n    val all = [ns, (n -> n > 1)]\n    f(filter(...all))\nprint(h([1, 2]))").contains("`xs` was declared array of string, and was given [2]"))

@test
A_BUILTIN_METHOD_IS_CHECKED_AS_THE_FREE_FUNCTION_IT_IS()
    // `xs.map(f)` IS `map(xs, f)` -- one implementation and one set of checks, reachable two ways.
    // Writing in method style used to cost the reader every diagnostic this pass has.
    assert(fails("f(xs: array of string) = len(xs)\nh(ns: array of integer) = f(ns.filter(n -> n > 1))\nh([1, 2])").contains("takes array of string here, and this is array of integer"))
    assert(fails("f(xs: array of string) = len(xs)\nh(ns: array of integer) = f(ns.sorted().reversed())\nh([1, 2])").contains("this is array of integer"))
    assert(fails("val xs = [1, 2]\nxs.join(5)").contains("`join` takes string here, and this is integer"))

@test
AN_ARITY_COMPLAINT_ABOUT_A_METHOD_DOES_NOT_COUNT_THE_RECEIVER()
    // The check counts the receiver, because the call it means has it in front. The reader did not
    // write it, so *"takes 2 arguments and this gives it 1"* about `xs.filter()` sends them looking
    // for an argument they can see two of.
    assert(fails("val xs = [1, 2]\nxs.filter()").contains("`filter` takes 1 argument and this gives it 0"))
    assert(fails("filter([1, 2])").contains("`filter` takes 2 arguments and this gives it 1"))

@test
A_METHOD_ON_AN_OBJECT_IS_THE_PROGRAMS_OWN_AND_NOT_THE_BUILTIN()
    // Dispatch is on the KIND of the receiver. An object's `filter` is a field the program wrote,
    // and checking it against the builtin `filter` would be checking it against a function that has
    // nothing to do with it.
    assert_eq(fails("val o = { filter: n -> n + 1 }\nprint(o.filter(1))"), "")

@test
A_PROGRAM_CANNOT_SHADOW_THE_SIGNATURE_A_METHOD_IS_CHECKED_AGAINST()
    // An array's `.filter` is the builtin whatever the program has named `filter`, so the method's
    // signature is looked up in a scope of its own rather than in the walking one.
    assert(fails("filter(a) = a\nf(xs: array of string) = len(xs)\nh(ns: array of integer) = f(ns.filter(n -> n > 1))\nh([1, 2])").contains("this is array of integer"))

@test
AN_at_IS_LEFT_WITHOUT_A_SIGNATURE_BECAUSE_TWO_KINDS_ANSWER_IT_DIFFERENTLY()
    // One native serves an array and the four temporal kinds -- `xs.at(-1)` and `t.at(zone)` -- and
    // their arities differ, so any single signature would refuse one of the two. A name this pass
    // says nothing about costs a diagnostic; one it says the wrong thing about costs a program.
    assert_eq(fails("val xs = [1, 2]\nprint(xs.at(-1))"), "")

// -- the type SYNTAX: a function type, brackets that group, and where each may be written -----------

// **A TYPE IS READ BY A GRAMMAR OF ITS OWN, AND THE FORK IS ABOUT ONE TOKEN.** `->` is the `match`
// arm arrow, so an arm's `string -> "a"` would read as a function from `string` to the literal type
// `"a"` -- both halves being perfectly good types -- and the body would be gone. So `parse_type`
// reads the arrow and `parse_pattern` does not, and the four type positions are the whole list: a
// parameter's annotation, a result, the right of a `type`, and a class's `is` promises.

@test
A_FUNCTION_TYPE_IS_WRITTEN_WHERE_A_TYPE_IS_WANTED_AND_AN_ARM_STILL_READS_AS_AN_ARM()
    // One bare parameter needs no brackets, mirroring the lambda it describes.
    assert_eq(out("apply(f: integer -> integer) -> integer = f(1)\nprint(apply(n -> n + 1))"), "2")

    // Two or more are a bracketed list, and so is none.
    assert_eq(out("check(h: (string, integer) -> boolean) = h(\"ab\", 2)\nprint(check((s, n) -> len(s) == n))"), "true")
    assert_eq(out("none(f: () -> string) = f()\nprint(none(() -> \"hi\"))"), "hi")

    // A `type` declaration takes one, and so does a class's promise.
    assert_eq(out("type Handler = (string) -> boolean\nrun(h: Handler) = h(\"a\")\nprint(run(s -> len(s) == 1))"), "true")

    // **AND THE ARM ARROW IS UNTOUCHED, which is what the fork exists for.** A literal is a type, so
    // an arm read as a type would swallow the body and nothing would say so.
    assert_eq(out("d(v) = v match\n    string -> \"a string\"\n    integer -> \"an integer\"\n    _ -> \"no idea\"\nprint(d(\"x\"), d(1), d(true))"),
        "a string an integer no idea")

    // The same token in an `is` test, which is pattern position too.
    assert_eq(out("f(v) = if v is string then \"yes\" else \"no\"\nprint(f(\"a\"), f(1))"), "yes no")

@test
AN_ARROW_IS_THE_LOOSEST_THING_IN_A_TYPE_AND_BINDS_TO_THE_RIGHT()
    // **`string | null -> integer` is a function taking either**, and the whole annotation is the
    // function type -- which is what handing it a `null` proves, that being an alternative of the
    // union and not a function.
    assert(fails("f(g: string | null -> integer) = 1\nprint(f(null))").contains("takes (string | null) -> integer here, and this is null"))

    // A union HOLDING a function says so with brackets, and then a `null` is one of the two things
    // it accepts.
    assert_eq(out("type MaybeFn = (integer -> integer) | null\nrun(f: MaybeFn) = if f is null then 0 else f(2)\nprint(run(null), run(n -> n * 10))"),
        "0 20")

    // **Right-associative**: `A -> B -> C` is a function answering a function, which is the reading
    // the message quotes back.
    assert(fails("f(g: integer -> integer -> integer) = 1\nprint(f(\"x\"))").contains("takes (integer) -> (integer) -> integer here"))

@test
BRACKETS_IN_A_TYPE_GROUP_ONE_TYPE_AND_A_LIST_OF_THEM_IS_A_PARAMETER_LIST()
    assert_eq(out("f(xs: array of (string | null)) = len(xs)\nprint(f([\"a\", null]))"), "2")

    // A list with no arrow after it is neither, and says which two things it could have been.
    assert(fails("f(x: (string, integer)) = x").contains("function type's parameter list"))
    assert(fails("f(x: ()) = x").contains("`() -> string`"))

    // **A reader coming from TypeScript names the parameters, and the name has nowhere to go here.**
    // The generic complaint is about a `)` that never arrived, which sends them to count brackets.
    assert(fails("f(cb: (n: integer) -> integer) = cb(1)").contains("says what its parameters ARE rather than what they are called"))

@test
A_NAME_WRITTEN_IN_A_FUNCTION_TYPE_IS_A_BINDING_AND_IS_REFUSED_AS_ONE()
    // `(n) -> integer` is a function taking whatever `n` names, and where nothing names it the
    // reader wrote a parameter's name in a place that has none.
    assert(fails("f(cb: (n) -> integer) = 1").contains("is not a type"))

@test
A_FUNCTION_TYPE_IS_CHECKED_BY_ARITY_AND_BY_ITS_PARAMETERS_AND_NOT_BY_ITS_RESULT()
    // The count, which is the machine's: it faults on a call that misses it one step later.
    assert(fails("apply(f: (integer, integer) -> integer) = f(1, 2)\nprint(apply(n -> n))").contains("this is (any) -> any"))

    // **A parameter is CONTRAVARIANT**, and the machine refuses this too -- `g`'s own annotation
    // faults the moment `apply` calls it with the integer it was promised it could.
    assert(fails("apply(f: integer -> integer) = f(1)\ng(n: string) = n\nprint(apply(g))").contains("this is (string) -> any"))

    // **THE RESULT IS NOT COMPARED, AND THAT IS THE INVARIANT SPEAKING.** Nothing at run time would
    // ever refuse it: a function's own `-> string` is checked against what that function answers and
    // never against what somebody who was handed it expected.
    assert_eq(fails("apply(f: integer -> string) = 1\ng(n) -> integer = n\nprint(apply(g))"), "")

    // A value that is not callable at all is refused where it is handed over.
    assert(fails("apply(f: integer -> integer) = f(1)\nprint(apply(\"x\"))").contains("takes (integer) -> integer here, and this is string"))

@test
A_LAMBDA_HANDED_TO_A_FUNCTION_TYPE_GETS_ITS_PARAMETERS_FROM_IT()
    // The whole reason writing one down pays: the expectation reaches the lambda's body, and what it
    // does with what it is handed is checked. It is the builtin callback machinery, reached through
    // a signature the program wrote.
    assert(fails("apply(f: integer -> integer) = f(1)\nprint(apply(n -> n + \"x\"))").contains("`+` does not apply to an integer and a string"))

    // And a lambda that fits is left alone.
    assert_eq(fails("apply(f: integer -> integer) = f(1)\nprint(apply(n -> n * 2))"), "")

// -- an annotation on a BINDING ---------------------------------------------------------------------

@test
A_BINDING_SAYS_WHAT_IT_HOLDS_AND_BOTH_ENDS_CHECK_IT()
    assert_eq(out("val x: number = 1\nval tags: array of string = [\"a\"]\nprint(x, tags)"), "1 [\"a\"]")

    // The pass refuses the initialiser where it can see it...
    assert(fails("val x: string = 5").contains("`x` was declared string, and this is integer"))

    // ...and the machine refuses it where the pass cannot.
    assert(fails(Opaque + "val x: string = anything(5)\nprint(x)").contains("`x` was declared string, and was given 5"))

@test
AN_ANNOTATED_var_IS_TYPESCRIPTS_let_AND_EVERY_ASSIGNMENT_IS_CHECKED()
    assert_eq(out("var n: number = 0\nn = 1.5\nn += 2\nprint(n)"), "3.5")
    assert(fails("var n: integer = 0\nn = \"x\"\nprint(n)").contains("`n` was declared integer, and this is string"))

    // **An UNANNOTATED `var` is untouched**, its recorded type being the union of every right-hand
    // side ever assigned to it -- this one included -- so the comparison is one that cannot fail.
    assert_eq(out("var m = 0\nm = \"fine\"\nprint(m)"), "fine")

@test
A_DECLARED_TYPE_IS_QUOTED_BACK_AS_THE_READER_WROTE_IT()
    // **The message is the SOURCE TEXT of the annotation.** Rebuilding it from the pattern loses the
    // name a declaration gave -- `Point` rather than the shape it stands for -- and taking the first
    // token loses everything after it, which is how `array of string` used to read as `array`.
    assert(fails(Opaque + "f(xs: array of string) = len(xs)\nprint(f(anything([1])))").contains("was declared array of string"))
    assert(fails(Opaque + "f(cb: integer -> integer) = 1\nprint(f(anything(5)))").contains("was declared integer -> integer"))
    assert(fails(Opaque + "type Point = { x: number, y: number }\nf(p: Point) = p.x\nprint(f(anything(5)))").contains("was declared Point"))

@test
A_LAMBDAS_PARAMETER_MAY_BE_ANNOTATED_AND_ITS_RESULT_STILL_MAY_NOT()
    assert_eq(out("val g = (n: integer) -> n + 1\nprint(g(2))"), "3")

    // The annotation reaches the lambda's signature, so a call through the name is checked.
    assert(fails("val g = (n: integer) -> n + 1\nprint(g(\"x\"))").contains("takes integer here, and this is string"))

@test
A_REST_PARAMETER_IS_ANNOTATED_AS_THE_ARRAY_IT_GATHERS_INTO()
    assert_eq(out("count(...rest: array of integer) = len(rest)\nprint(count(1, 2, 3))"), "3")
    assert(fails("count(...rest: array of integer) = len(rest)\nprint(count(1, \"a\"))").contains("`rest` was declared array of integer"))

// -- type parameters --------------------------------------------------------------------------------

// **A TYPE PARAMETER IS SOLVED IN THE CHECKER AND ERASED IN THE MACHINE, and everything below is
// one of those two halves.** What it buys is that a call's answer is said in terms of what the call
// was given. What it costs is that nothing may be REFUSED on account of one: a conflict widens into
// a union, because nothing at run time could have refused it.

@test
A_GENERIC_FUNCTIONS_ANSWER_IS_SAID_IN_TERMS_OF_WHAT_THE_CALL_GAVE_IT()
    assert_eq(out("first[T](xs: array of T) -> T = xs[0]\nprint(first([\"a\", \"b\"]), first([1, 2]))"), "a 1")

    // The answer is a string here, so a parameter wanting an integer is refused before it runs.
    assert(fails("first[T](xs: array of T) -> T = xs[0]\nwant(n: integer) = n\nuse(ys: array of string) = want(first(ys))\nprint(use([\"a\"]))").contains("`want` takes integer here, and this is string"))

    // And a binding wanting one is refused where the value is bound.
    assert(fails("first[T](xs: array of T) -> T = xs[0]\nval s: string = first([1, 2])").contains("`s` was declared string, and this is integer"))

@test
A_TYPE_PARAMETER_TYPES_A_CALLBACK_FROM_THE_ARGUMENTS_BEFORE_IT()
    assert_eq(out("map2[A, B](xs: array of A, f: A -> B) -> array of B = map(xs, f)\nprint(map2([1, 2], n -> string(n) + \"!\"))"),
        "[\"1!\", \"2!\"]")

    // The lambda's parameter is typed from the array beside it, so what the body does with it is
    // checked -- and the machine raises the same fault.
    assert(fails("map2[A, B](xs: array of A, f: A -> B) -> array of B = map(xs, f)\nprint(map2([\"a\"], s -> s * 2))").contains("`*` does not apply to a string and an integer"))

@test
EVERY_ARGUMENT_MUST_BE_CONTAINED_IN_THE_TYPE_A_PARAMETER_WAS_SOLVED_TO()
    // **A call whose arguments name no one type for `T` is a mistake, and TypeScript reads it as
    // one.** Widening it into a union made it MEAN something instead, which is what the reader
    // almost never wanted -- and the annotation is a promise the program made, exactly as an
    // annotated `var` is.
    val said = fails("pair[T](a: T, b: T) -> array of T = [a, b]\nprint(pair(1, \"x\"))")

    assert(said.contains("`T` is integer from an argument before this one, and this is string"))

    // **ONE SENTENCE FOR ONE MISTAKE.** Solving leaves the signature saying `integer`, so the
    // ordinary argument check would measure `"x"` against that and complain a second time about the
    // very argument this one names -- *"`pair` takes integer here, and this is string"*, true and
    // redundant. A wrong arity already steps aside for that reason and so does this.
    assert(!said.contains("takes integer here"))

    // The agreeing call is untouched.
    assert_eq(out("pair[T](a: T, b: T) -> array of T = [a, b]\nprint(pair(1, 2))"), "[1, 2]")

    // A parameter nobody solved is `any`, and it may not be left standing in a message either.
    val nothing_said = fails("first[T](xs: array of T) -> T = xs[0]\nprint(first(5))")

    assert(nothing_said.contains("takes array here"))
    assert(!nothing_said.contains("T"))
end EVERY_ARGUMENT_MUST_BE_CONTAINED_IN_THE_TYPE_A_PARAMETER_WAS_SOLVED_TO

@test
A_TYPE_PARAMETER_IS_A_UNION_ONLY_WHERE_THE_PROGRAM_DECLARED_ONE()
    // **A union is still an answer -- it is just not one the checker invents.** `x` is declared
    // `integer | string`, so that IS a candidate, and the `2` beside it fits it.
    assert_eq(out("pair[T](a: T, b: T) -> array of T = [a, b]\nval x: integer | string = 1\nprint(pair(x, 2))"),
        "[1, 2]")

    // And the other order, which is the case an incremental merge gets wrong: `integer` arrives
    // first and the union that contains it arrives second.
    assert_eq(out("pair[T](a: T, b: T) -> array of T = [a, b]\nval x: integer | string = 1\nprint(pair(2, x))"),
        "[2, 1]")
end A_TYPE_PARAMETER_IS_A_UNION_ONLY_WHERE_THE_PROGRAM_DECLARED_ONE

@test
THE_CANDIDATES_ARE_GATHERED_AND_THEN_CHOSEN_BETWEEN_RATHER_THAN_MERGED_AS_THEY_ARRIVE()
    // **The case that separates the two, and it is why this is not an incremental fold.** `integer`
    // and `real` contain each other in neither direction, so a merge refuses at the second argument
    // -- before it has read the `number` that every one of them fits.
    val prog = "three[T](a: T, b: T, c: T) -> T = a\nval n: number = 1\nprint(three(1, 2.5, n))"

    assert_eq(fails(prog), "")
    assert_eq(out(prog), "1")
end THE_CANDIDATES_ARE_GATHERED_AND_THEN_CHOSEN_BETWEEN_RATHER_THAN_MERGED_AS_THEY_ARRIVE

@test
A_VALUE_WHOSE_TYPE_IS_A_PARAMETER_GOES_ANYWHERE_INSIDE_THE_DEFINITION()
    // Inside `first[T]`, `xs[0]` is a `T` -- which may be a string, so handing it to something
    // wanting one is a program that runs and may not be refused.
    assert_eq(fails("shout[T](xs: array of T) = upper(xs[0])\nprint(shout([\"a\"]))"), "")

@test
A_TYPE_PARAMETER_MAY_NOT_NAME_ONE_OF_SLATES_OWN_TYPES()
    // `f[string](x: string)` would make every `string` in the definition test nothing, which is the
    // silent hole this repo refuses everywhere else.
    assert(fails("f[string](x: string) = x").contains("is one of slate's own types"))
    assert(fails("type Handler[boolean] = { ok: boolean }\nf(h: Handler[integer]) = h").contains("is one of slate's own types"))

@test
NOTHING_CAN_BE_TESTED_AGAINST_A_TYPE_PARAMETER_AND_THE_REFUSAL_SAYS_SO()
    // A type parameter is erased, so `x is T` would be a bare name binding the value and matching
    // everything -- a test the reader believes and does not get.
    assert(fails("f[T](x: T) = if x is T then 1 else 0").contains("not there at run time"))

@test
A_GENERIC_TYPE_IS_SUBSTITUTED_WHERE_IT_IS_USED()
    val pair = "type Pair[A, B] = { first: A, second: B }\n"

    assert_eq(out(pair + "show(p: Pair[string, integer]) = s\"${p.first}=${p.second}\"\nprint(show({ first: \"a\", second: 1 }))"), "a=1")

    // The shape that comes out is the one both declarations describe, so the ordinary object check
    // is what refuses a value that does not fit.
    assert(fails(pair + "show(p: Pair[string, integer]) = p.first\nprint(show({ first: \"a\", second: \"b\" }))").contains("{ first: string, second: integer }"))

    // A type given to a generic type may itself be a declared type, or generic in turn.
    assert_eq(out(pair + "type Point = { x: number }\nf(p: Pair[Point, Point]) = p.first.x\nprint(f({ first: { x: 1 }, second: { x: 2 } }))"), "1")
    assert_eq(out(pair + "f(p: Pair[string, Pair[string, integer]]) = p.second.second\nprint(f({ first: \"a\", second: { first: \"b\", second: 2 } }))"), "2")

@test
A_GENERIC_TYPE_COUNTS_WHAT_IT_IS_GIVEN_AND_IS_REFUSED_WITHOUT_IT()
    val pair = "type Pair[A, B] = { first: A, second: B }\n"

    assert(fails(pair + "f(p: Pair[string]) = p").contains("generic over 2 types and this gives it 1"))

    // **A bare generic name is refused rather than erased.** Erasing would be sound and is exactly
    // what makes it the wrong answer: `p is Pair` would quietly test only that the fields are there.
    assert(fails(pair + "f(p: Pair) = p").contains("generic over 2 types, so it needs them here"))

    // And a type that is not generic takes nothing in brackets.
    assert(fails("type Point = { x: number }\nf(p: Point[string]) = p").contains("is not generic"))
    assert(fails("f(p: Nope[string]) = p").contains("nothing here declares a type called `Nope`"))

@test
A_GENERIC_HEAD_IS_FOUND_WHEREVER_IN_THE_FILE_IT_STANDS()
    // **The lookahead over `[A, B]` counts from the start of the token list and the parser's own
    // `peek_kind_at` counts from the cursor**, and the two are the same number only for a file's
    // FIRST statement -- so a declaration below one is where mixing them up shows itself.
    assert_eq(out("print(1)\ntype Pair[A, B] = { first: A, second: B }\nf(p: Pair[string, integer]) = p.first\nprint(f({ first: \"a\", second: 1 }))"),
        "1\na")
    assert_eq(out("print(1)\nfirst[T](xs: array of T) -> T = xs[0]\nprint(first([2]))"), "1\n2")

@test
A_TYPE_PARAMETER_LIST_DOES_NOT_MAKE_AN_INDEX_INTO_A_DEFINITION()
    // `first[T](...)` is a definition and `handlers[0](...)` is an index followed by a call. What
    // keeps them apart is that only a list of BARE NAMES is stepped over.
    assert_eq(out("val handlers = [n -> n + 1]\nprint(handlers[0](1))"), "2")
    assert_eq(out("val t = { a: n -> n * 3 }\nprint(t[\"a\"](2))"), "6")

// -- what an array literal says about its elements ---------------------------------------------------

@test
AN_ARRAY_LITERAL_SAYS_WHAT_IT_WAS_BUILT_OUT_OF()
    // Which is what makes a type parameter useful on a literal, and what types a callback written
    // beside one.
    assert(fails("print(map([\"a\"], s -> s * 2))").contains("`*` does not apply to string and integer"))
    assert(fails("f(xs: array of string) = len(xs)\nprint(f([1, 2]))").contains("this is array of integer"))

    // An EMPTY literal says nothing, every element of nothing fitting anything.
    assert_eq(fails("f(xs: array of string) = len(xs)\nprint(f([]))"), "")

    // **An element nothing is known about gives the whole thing up**, so the pass says nothing and
    // the machine is what checks -- which it does, element by element.
    assert_eq(fails(Opaque + "f(xs: array of string) = len(xs)\nprint(f([anything(\"a\")]))"), "")
    assert(fails(Opaque + "f(xs: array of string) = len(xs)\nprint(f([anything(1)]))").contains("was declared array of string, and was given [1]"))

    // Elements that disagree are a union, which fits neither kind on its own.
    assert(fails("f(xs: array of string) = len(xs)\nprint(f([\"a\", 1]))").contains("this is array of string | integer"))

@test
A_NAME_DOES_NOT_KEEP_AN_ELEMENT_TYPE_A_LITERAL_GAVE_IT()
    // **An array is mutable and a name outlives the line that built it**, so a recorded element type
    // would refuse a program the machine runs. It is the rule an object's shape already follows.
    assert_eq(out("val xs = [1]\nxs[0] = \"a\"\nf(ys: array of string) = len(ys)\nprint(f(xs))"), "1")

    // What is NOT given up is what an annotation says, that being a promise the machine checks.
    assert(fails("val xs: array of integer = [1]\nf(ys: array of string) = len(ys)\nprint(f(xs))").contains("this is array of integer"))
