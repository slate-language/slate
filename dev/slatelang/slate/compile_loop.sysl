module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// Loops, as bytecode: `while`, `loop`, `do ... while`, `for`, `for await`, and the `break` and
// `continue` that leave them.
//
// **Cut out of `compile_stmt.sysl`, which keeps a run of statements, an assignment and a `try`.** A
// loop is an expression, so the four `compile_*` entry points were already reached from
// `compile_expr.sysl`; what crosses back is `jump_out`, which the statement walk calls for a `break`
// and a `continue`, and `nothing_left`, which this file asks for what a jump leaves behind.

// `break` and `continue`, which have to leave the loop as they found it.
//
// **A `break` leaves its value where the loop's own would have gone**, which is why the value is
// compiled AFTER the unwind: everything the loop had is dropped first, and what is pushed onto the
// bare stack is what the loop answers.
//
// Not `private`: `compile_stmt` in `compile_stmt.sysl` compiles a `Break` and a `Continue` through it.
jump_out(u: *Unit, e: *Emit, at: Span, breaking: bool, label: string, value: Option[Expr], wants: StmtValue)
    val which = loop_named(e, label)

    if which == 0
        val word = if label != ""
            s"no enclosing loop is called `'${label}`"
        elif breaking then
            "`break` outside a loop"
        else
            "`continue` outside a loop"

        push_n(e, FailWith(intern_str(u, word)), at, 0, 0)
        nothing_left(e, at, wants)
        return
    end if

    val slot = which - 1
    var frame = e.loops.at(slot)
    val sp = e.sp
    val scopes = e.scopes
    val handlers = e.handlers

    if breaking
        // **The value is compiled BEFORE anything is unwound**, and that is not an optimisation: the
        // scopes the unwind is about to close are the ones holding the names it may use, so
        // `for x in xs do if p(x) then break x` would find `x` already gone. It is then slid beneath
        // the values the loop had and they are dropped from above it.
        value match
            Some(x) -> compile_expr(u, e, x)
            None -> push_n(e, PushNull, at, 0, 1)

        // **The resources are released BEFORE the stack is cut back**, for the reason the value was
        // compiled first: a release reaches its resource where it stands, and the cut is about to
        // take that copy away with everything else the loop had.
        emit_disposes_above(u, e, frame.handlers, at)

        val extra = sp - frame.sp

        if extra > 0
            push_n(e, RotUp(extra), at, 0, 0)

            for i in 0..<extra
                push_n(e, Pop, at, 1, 0)

        // **One `PopScope` per level that PUSHED one**, `e.scopes` counting nothing else -- which is
        // what lets a chunk where some blocks opened a scope and some did not unwind correctly.
        var d = e.scopes

        while d > frame.scopes
            put(e, PopScope, at)
            d -= 1

        e.scopes = frame.scopes

        var k = e.handlers

        while k > frame.handlers
            put(e, PopHandler, at)
            k -= 1

        e.handlers = frame.handlers
    else
        emit_disposes_above(u, e, frame.handlers, at)
        unwind_to(e, frame.sp, frame.scopes, frame.handlers, at)

    val j = put(e, Jump(0), at)

    if breaking then frame.breaks.push(j) else frame.continues.push(j)
    e.loops.set(slot, frame)

    // Control never falls through, so the counters go back to what the following code expects.
    e.sp = sp
    e.scopes = scopes
    e.handlers = handlers
    nothing_left(e, at, wants)
end jump_out

private open_loop(e: *Emit, label: string)
    e.loops.push(LoopFrame(e.sp, e.scopes, e.handlers, label, buf(), buf()))

// Which enclosing loop a `break` or a `continue` means, counted from the innermost.
//
// **The empty string means "the nearest one", not "the one with no name"**, so a labelled loop is
// still what an unlabelled `break` inside it leaves.
private loop_named(e: *Emit, label: string) -> usize
    if e.loops.len() == 0 then return 0

    var i = e.loops.len()

    while i > 0
        i -= 1

        if label == "" || e.loops.at(i).label == label then return i + 1

    0
end loop_named

private close_loop(e: *Emit, continue_to: usize, break_to: usize)
    val frame = e.loops.at(e.loops.len() - 1)

    for i in 0..<frame.breaks.len()
        patch(e, frame.breaks.at(i), break_to)

    for i in 0..<frame.continues.len()
        patch(e, frame.continues.at(i), continue_to)

    e.loops.truncate(e.loops.len() - 1)
end close_loop

// **A loop is an expression, and a `break` is what gives it a value other than null.** The two exits
// therefore meet at one place with one value already on the stack: the normal one runs any `else` and
// pushes null, and a `break` arrives with its own value already pushed.
//
// Not `private`: reached from `compile_expr.sysl` -- every loop is an EXPRESSION.
compile_while(u: *Unit, e: *Emit, label: string, cond: Expr, body: Expr, otherwise: Option[Expr], at: Span)
    val top = here(e)

    // **The safe point stands AT `top`, which is what both the back edge and a `continue` are aimed
    // at** -- so there is no way round this loop that steps over it. Written at the back edge
    // instead, a body ending in `continue` would go round for ever without one.
    safe_point(e, at)
    open_loop(e, label)
    compile_expr(u, e, cond)

    val out = push_n(e, JumpIfFalse(0), at, 1, 0)
    val was = entering_loop_body(e)

    compile_body(u, e, body)
    leaving_loop_body(e, was)
    put(e, Jump(top), at)
    patch(e, out, here(e))
    compile_else(u, e, otherwise, at)

    // **A `break` lands just past what the normal exit pushed, having pushed its own value instead.**
    // Both exits therefore leave exactly one value and no jump is needed to join them.
    close_loop(e, top, here(e))
end compile_while

// What a loop answers when it finished on its own.
//
// **The `else`'s value IS the loop's**, which was checked against sysl rather than assumed: a `for`
// over nothing with an `else -1` answers `-1` there. That is what makes the search idiom read --
// `break` gives the answer that was found and `else` gives the one for having found none -- and it
// is why this leaves a value where a Python-style clause run for effect would not.
private compile_else(u: *Unit, e: *Emit, otherwise: Option[Expr], at: Span)
    otherwise match
        Some(x) -> compile_expr(u, e, x)
        None -> push_n(e, PushNull, at, 0, 1)

// Not `private`: reached from `compile_expr.sysl` -- every loop is an EXPRESSION.
compile_loop(u: *Unit, e: *Emit, label: string, body: Expr, at: Span)
    val top = here(e)

    // **This is the loop the guarantee is usually stated about**: `loop` with nothing in it that
    // calls anything still reaches a safe point every turn, so it can be collected and it can be
    // stopped.
    safe_point(e, at)
    open_loop(e, label)

    val was = entering_loop_body(e)

    compile_body(u, e, body)
    leaving_loop_body(e, was)
    put(e, Jump(top), at)

    // There is no normal exit from a `loop`, so the only way out already carries a value -- and the
    // counter is told about it here, there being no instruction that pushed one.
    close_loop(e, top, here(e))
    e.sp += 1
end compile_loop

// **`continue` goes to the TEST, not to the top**, which is the whole reason this is not desugared
// into a `while`: the body has already run once by the time the condition is first asked.
//
// Not `private`: reached from `compile_expr.sysl` -- every loop is an EXPRESSION.
compile_do_while(u: *Unit, e: *Emit, label: string, body: Expr, cond: Expr, otherwise: Option[Expr], at: Span)
    val top = here(e)

    open_loop(e, label)

    val was = entering_loop_body(e)

    compile_body(u, e, body)
    leaving_loop_body(e, was)

    val test = here(e)

    // **The safe point goes at the TEST and not at the top, for the same reason `continue` does.**
    // Every way round this loop passes through here -- falling out of the body, or jumping here from
    // a `continue` -- and the only back edge is the `Jump` below it.
    safe_point(e, at)
    compile_expr(u, e, cond)

    val out = push_n(e, JumpIfFalse(0), at, 1, 0)

    put(e, Jump(top), at)
    patch(e, out, here(e))
    compile_else(u, e, otherwise, at)
    close_loop(e, test, here(e))
end compile_do_while

// Not `private`: reached from `compile_expr.sysl` -- every loop is an EXPRESSION.
compile_for(u: *Unit, e: *Emit, label: string, binding: Pattern, iter: Expr, body: Expr, otherwise: Option[Expr], waits: bool, at: Span)
    if waits
        compile_for_await(u, e, label, binding, iter, body, otherwise, at)
        return

    compile_expr(u, e, iter)
    unveil_operand(e, iter.span)

    // **`IterInit` KEEPS the subject and pushes a counter beside it**, so it gives one and takes
    // none. Accounting it as taking the subject left the counter unmatched: the compiler believed
    // the stack was one shallower than it was, the single `Pop` below removed only the counter, and
    // every `for` a program ran stranded its subject for the rest of the enclosing chunk. Fifty
    // thousand turns of a loop containing one was a SIGSEGV with no output.
    push_n(e, IterInit, at, 0, 1)

    // **The iterator is closed on every way out but running out** (`iter_close.sysl`), so the loop
    // guards itself the way a `using` guards its block -- and the guard goes up BEFORE the loop
    // frame, which is what makes a `continue` of this loop leave it standing and a `break` of an
    // outer one release it.
    val subject = e.sp - 2
    val guard = push_n(e, PushDispose(0), at, 0, 0)
    val scopes = e.scopes

    e.handlers += 1
    e.disposes.push(DisposeSite(e.handlers, subject, Close))

    val top = here(e)

    // The walk's own two values are standing on the stack here, which is a root the collector
    // already walks -- so a collection at this point sees them exactly as it would anywhere else.
    safe_point(e, at)
    open_loop(e, label)

    // Answers the next element, or jumps out when there is none.
    val out = push_n(e, IterNext(0), at, 0, 1)

    open_scope(e, at, scoped_loop(e, binding, body))

    // **One name costs one instruction, as it always did.** Only a head that takes the element
    // apart pays for the pattern machinery, and a `for` that binds one name emits nothing new.
    *binding.kind match
        Bind(name) -> declare_name(u, e, name, at, false)
        _ ->
            refuse_optionals(binding, "and a `for` head binds")
            bind_pattern(u, e, binding, at, false)

    val was = entering_loop_body(e)

    compile_stmt_body(u, e, body)
    leaving_loop_body(e, was)

    shut_scope(e, at)
    put(e, Jump(top), at)
    patch(e, out, here(e))

    // **Running out closes nothing**, the iterator having said itself that it was done.
    e.disposes.truncate(e.disposes.len() - 1)
    push_n(e, PopHandler, at, 0, 0)
    e.handlers -= 1

    // The counter and the subject both go -- two values, which is what `IterInit` left -- and they go
    // *before* the answer is built, so that the two Pops cannot take it.
    push_n(e, Pop, at, 1, 0)
    push_n(e, Pop, at, 1, 0)
    compile_else(u, e, otherwise, at)

    val done = put(e, Jump(0), at)

    // **A `break` arrives with the walk still on the stack under its value**, having unwound only to
    // the frame's own height -- so the value is slid beneath them and they are dropped from above it.
    // The guard is taken down BEFORE the iterator is closed, so a `return()` that faults is not
    // called a second time by it.
    val brk = here(e)
    val after = e.sp

    // **The counter is told what the machine has here**, the walk's two values and the `break`'s
    // own -- which is two more than the way out above left -- since the close reaches its copy by
    // counting down from the top.
    e.sp = subject + 3
    put(e, PopHandler, at)
    emit_close(u, e, subject, false, at)
    push_n(e, RotUp(2), at, 0, 0)
    push_n(e, Pop, at, 1, 0)
    push_n(e, Pop, at, 1, 0)

    // The two paths meet, so the counter follows the one that fell through rather than this one.
    e.sp = after
    close_loop(e, top, brk)
    closing_guard(u, e, guard, subject + 2, scopes, subject, at)
    patch(e, done, here(e))
end compile_for

// The loop's guard, reached only by a fault: close the iterator and let the fault carry on.
//
// **The counters are set to what the MACHINE has at the release** -- `guarded` cuts the stack back
// to where `PushDispose` stood and the scope chain with it -- which is `compile_using`'s arrangement.
// **Nothing is awaited here, a `for await`'s `return()` included**: the release runs inside the
// unwind, where a machine cannot park.
private closing_guard(u: *Unit, e: *Emit, guard: usize, height: usize, scopes: usize, slot: usize, at: Span)
    val over = put(e, Jump(0), at)
    val fell_through = e.sp

    patch(e, guard, here(e))
    e.sp = height
    e.scopes = scopes
    emit_close(u, e, slot, false, at)
    push_n(e, DisposeDone, at, 0, 0)
    e.sp = fell_through
    e.scopes = scopes
    patch(e, over, here(e))
end closing_guard

// `for await x in source` -- ask the subject for its next value, await the answer, and stop when it
// says it is done.
//
// **The subject is asked with `next()` and nothing else, which is what lets ONE rule cover both
// kinds of source.** A generator's `next()` answers `{value, done}` outright and an asynchronous one
// answers a promise of the same shape -- and `await` of a plain value answers it, so the synchronous
// case needs no fallback branch and no second protocol name. slate's well-known names are fields
// (`proto`, `equals`, `hash`, `toString`, `toJSON`), and this is that mechanism once more rather than
// a new one.
//
// **The shape is a `while` and not the counted walk above.** There is no counter, because what says
// whether another value is coming is the subject; and there is one value on the stack through the
// loop -- the subject -- where the ordinary `for` keeps two.
//
// **Two values stand through the loop, the subject and a second copy of it that is `null` while
// `next()` is being asked.** The second is what the loop's guard closes (`iter_close.sysl`), so a
// `next()` that faults closes nothing -- JavaScript's rule -- while a fault in the body does. The
// subject never changes, so it is checked once, before the loop rather than every turn.
private compile_for_await(u: *Unit, e: *Emit, label: string, binding: Pattern, iter: Expr, body: Expr, otherwise: Option[Expr], at: Span)
    compile_expr(u, e, iter)
    push_n(e, IterAwaitCheck, at, 0, 0)
    push_n(e, PushNull, at, 0, 1)

    val live = e.sp - 1
    val guard = push_n(e, PushDispose(0), at, 0, 0)
    val scopes = e.scopes

    e.handlers += 1
    e.disposes.push(DisposeSite(e.handlers, live, CloseAwaited))

    val top = here(e)

    // The subject is standing on the stack here, as the counted walk's two values are.
    safe_point(e, at)
    open_loop(e, label)

    // **The second copy is emptied first**, taken out and dropped -- never popped from under the
    // guard's height, which a fault arriving in between would cut the stack back to.
    push_n(e, TakeAt(0), at, 0, 1)
    push_n(e, Pop, at, 1, 0)

    // **The subject is copied**, `CallMethod` taking its receiver: the loop asks the same object
    // every turn, so what is duplicated is the thing being walked rather than the answer.
    push_n(e, DupAt(1), at, 0, 1)
    push_n(e, CallMethod(0, intern_wide(u, intern_str(u, "next"), 0, fresh_site(u))), at, 1, 1)

    // **Refused here rather than at the head**, so the complaint points at the line the awaiting
    // happens on -- which is the whole loop, and is where a reader would put the `async`.
    if e.is_async
        push_n(e, Op.Await, at, 1, 1)
    else
        push_n(e, FailWith(intern_str(u, "`for await` belongs in an `async` function")), at, 1, 1)

    // `{ value, done }`, read without being taken apart: `done` decides and `value` is what binds.
    push_n(e, Dup, at, 0, 1)
    push_n(e, GetField(u32(intern_str(u, "done")), u32(fresh_site(u))), at, 1, 1)

    // **Two jumps because there is no `JumpIfTrue` that pops**, and inverting is the honest way to
    // spell it with what the instruction set has: fall into the body while `done` is false, and take
    // the second jump out when it is not.
    val into = push_n(e, JumpIfFalse(0), at, 1, 0)
    val out = put(e, Jump(0), at)

    // **The way out leaves the subject, the empty copy AND the step standing, and the body's path
    // does not**: the body binds the step's `value`, so control falling back to the top carries two
    // values where the jump out carries three. The counter is put back to the jump's own height
    // where the two meet, or it believes the stack one shallower than it is for the rest of the
    // chunk -- and a `using` after the loop reaches for its resource one slot off.
    val leaving = e.sp

    patch(e, into, here(e))
    push_n(e, GetField(u32(intern_str(u, "value")), u32(fresh_site(u))), at, 1, 1)

    // The step came back, so the iterator is one to close from here on: the empty copy goes from
    // under the value and the subject is copied into its place.
    push_n(e, RotUp(1), at, 0, 0)
    push_n(e, Pop, at, 1, 0)
    push_n(e, DupAt(1), at, 0, 1)
    push_n(e, RotUp(1), at, 0, 0)
    open_scope(e, at, scoped_loop(e, binding, body))

    *binding.kind match
        Bind(name) -> declare_name(u, e, name, at, false)
        _ ->
            refuse_optionals(binding, "and a `for await` head binds")
            bind_pattern(u, e, binding, at, false)

    val was = entering_loop_body(e)

    compile_stmt_body(u, e, body)
    leaving_loop_body(e, was)

    shut_scope(e, at)
    put(e, Jump(top), at)
    patch(e, out, here(e))
    e.sp = leaving

    // **Running out closes nothing.** The step that said `done` is still standing, with the empty
    // copy and the subject under it; all three go before the answer is built, so no Pop can take it.
    e.disposes.truncate(e.disposes.len() - 1)
    push_n(e, PopHandler, at, 0, 0)
    e.handlers -= 1
    push_n(e, Pop, at, 1, 0)
    push_n(e, Pop, at, 1, 0)
    push_n(e, Pop, at, 1, 0)
    compile_else(u, e, otherwise, at)

    val done = put(e, Jump(0), at)

    // A `break` arrives with the subject and its copy still under its value, having unwound only to
    // the frame's own height. The guard comes down, the copy is closed and its answer awaited, and
    // both go from under the value.
    val brk = here(e)
    val after = e.sp

    e.sp = live + 2
    put(e, PopHandler, at)
    emit_close(u, e, live, true, at)
    push_n(e, RotUp(2), at, 0, 0)
    push_n(e, Pop, at, 1, 0)
    push_n(e, Pop, at, 1, 0)

    e.sp = after
    close_loop(e, top, brk)
    closing_guard(u, e, guard, live + 1, scopes, live, at)
    patch(e, done, here(e))
end compile_for_await

// A loop body, run for effect: its value is discarded each turn.
private compile_body(u: *Unit, e: *Emit, body: Expr)
    open_scope(e, body.span, scoped_body(e, body))
    compile_stmt_body(u, e, body)
    shut_scope(e, body.span)
end compile_body

// The inside of a loop body, with its own scope already open.
//
// **A body written as a block answers nothing, so not one of its statements does either** -- which
// is where most of the bookkeeping a loop used to run every turn came from: a null pushed for each
// statement, a `Discard` to take each one away, and a `Pop` at the end for the last. A body written
// as a bare expression is one statement standing in the same place, so it is asked the same thing:
// `while ready() do if x then go(x)` makes no value for the turn to cut back either.
private compile_stmt_body(u: *Unit, e: *Emit, body: Expr)
    *body.kind match
        Block(stmts) -> compile_stmts(u, e, stmts, body.span, Cut)
        _ -> compile_unread(u, e, body, Cut)
end compile_stmt_body
