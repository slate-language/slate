module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// What one type fits, and what is known about a name.
//
// **The lattice the check is made of, split out of `check.sysl`, which is the walk over it.** Four
// names here are not `private` because that walk asks them: `is_kind_of`, `has_name`, `may_narrow`
// and `narrow_by`.

// The static check: what the compiler can say about a program without running it.
//
// **THE RULE THIS PASS IS BUILT ON: IT MAY ONLY REPORT WHAT THE MACHINE WOULD ALSO REFUSE.** slate is
// dynamically typed and stays that way -- the checker's job is to move a fault from the run that
// finds it to the compile that could have, and never to invent one. So every relation here mirrors
// the run-time test exactly (`fits` against `is_kind`), and anything the walk is not sure of is
// `Any`, which fits everything. A checker that is sometimes wrong is worse than no checker, because
// a program then has to be written around it.
//
// **That is also what makes it gradual rather than optional.** An unannotated parameter is `Any` and
// says nothing; an annotated one says everything it can. TypeScript's bargain, and the reason
// `types.sysl` starts from `Any` rather than from a lattice.
//
// What it checks today: **a call's arity and its arguments**, against a function whose parameters
// were annotated, and a **binary operator** whose two sides cannot meet. What it does not yet check
// is written down at the end of this file.

// -- what fits where -------------------------------------------------------------------------------

// Whether a value known to be `got` may stand where `want` is asked for.
//
// **`Any` fits in both directions and that is not a hole**, it is the whole of gradual typing: a
// value nothing is known about may go anywhere, and anything may go where nothing is asked. Every
// unknown in the walk becomes `Any`, so this is what keeps the pass from reporting a program it
// merely failed to understand.
fits(got: Type, want: Type) -> bool
    *want.kind match
        Any -> return true
        _ -> ()

    *got.kind match
        Any -> return true

        // **A VALUE WHOSE TYPE IS A PARAMETER GOES ANYWHERE, exactly as `Any` does.** Inside
        // `first[T](xs: array of T)`, `xs[0]` is a `T` -- and `T` may be a string, so handing it to
        // something wanting a string is a program that runs and may not be refused. What a type
        // parameter buys is said at the CALL, where it is solved; inside the definition it is a
        // value nothing is known about.
        TypeVar(_) -> return true

        // **Every alternative must fit, since the value is one of them and nobody knows which.**
        OneOf(alts) ->
            for i in 0..<alts.len()
                if !fits(alts.at(i), want) then return false

            return true
        _ -> ()

    *want.kind match
        // One that accepts is enough on this side.
        OneOf(alts) ->
            for i in 0..<alts.len()
                if fits(got, alts.at(i)) then return true

            false
        NullType -> is_kind_of(got, NullType)
        BooleanType -> is_kind_of(got, BooleanType)
        StringType -> is_kind_of(got, StringType)

        // **An integer does NOT fit a `real`, and that mirrors `is_kind`.** Arithmetic promotes one
        // to the other and a type test does not, so `f(x: real)` given `1` faults at run time --
        // and a checker that let it through would be describing a different language.
        // **A `number` on THIS side fits both, because it may be either.** Refusing it would be
        // refusing a program on the strength of not knowing which one it is, which is the one thing
        // this pass may not do.
        IntegerType -> is_kind_of(got, IntegerType) || is_kind_of(got, NumberType)
        RealType -> is_kind_of(got, RealType) || is_kind_of(got, NumberType)
        NumberType -> is_kind_of(got, IntegerType) || is_kind_of(got, RealType) || is_kind_of(got, NumberType)
        ArrayOf(want_element) -> *got.kind match
            ArrayOf(got_element) -> fits(got_element, want_element)
            _ -> false

        // **`ArrayOf`'s rule, twice**: the members have to fit, and a bare `Set` carries `Any` on
        // both sides so every set fits one. `HoldsPat` is checked member by member at run time,
        // which is what makes a complaint here one the machine would also make.
        SetOf(want_element) -> *got.kind match
            SetOf(got_element) -> fits(got_element, want_element)
            _ -> false
        MapOf(want_key, want_value) -> *got.kind match
            MapOf(got_key, got_value) -> fits(got_key, want_key) && fits(got_value, want_value)
            _ -> false
        ObjectWith(want_keys, want_values, want_optional) -> *got.kind match
            // **At least these fields**, which is the object pattern's rule and has to be the type's
            // too, or one annotation would mean two things.
            //
            // **A key the annotation marked `?` need not be there at all**, which is what
            // `match_object` does at run time -- it skips a missing key the pattern called optional.
            // Where it IS there it still has to fit: `{ n?: integer }` is not satisfied by an object
            // whose `n` is a string, and neither the matcher nor this accepts one.
            ObjectWith(got_keys, got_values, _) ->
                for i in 0..<want_keys.len()
                    var found = false
                    var present = false

                    for j in 0..<got_keys.len()
                        if got_keys.at(j) == want_keys.at(i)
                            present = true

                            if fits(got_values.at(j), want_values.at(i)) then found = true

                    if !found && !(want_optional.at(i) && !present) then return false

                true
            _ -> false
        // **A named kind fits its own word and nothing else**, which mirrors `is_kind` exactly: each
        // of them tests one variant of `Value` and no two overlap. There is no promotion here as
        // there is between an integer and a real -- a date is a date.
        NamedType(want_name) -> *got.kind match
            NamedType(got_name) -> got_name == want_name
            _ -> false

        // **A data type is fitted by any of its variants**, which is the one place in this file a
        // type is wider than a single kind -- and it is sound for the reason the rest of the file is:
        // the machine asks the same question, `DataPat` walking the proto chain to the data type that
        // every variant has as its own.
        DataType(want_name, variants) -> *got.kind match
            DataType(got_name, _) -> got_name == want_name
            VariantType(got_name) ->
                for i in 0..<variants.len()
                    if variants.at(i) == got_name then return true

                false
            _ -> false

        // A variant fits itself and nothing else. **It is deliberately NOT fitted by its data type**:
        // a value known only to be some `Shape` may be a `Rect`, so letting one through where a
        // `Circle` was asked for would be describing a language slate is not.
        VariantType(want_name) -> *got.kind match
            VariantType(got_name) -> got_name == want_name
            _ -> false

        // A regular expression fits a regular expression and nothing else, which mirrors `is_kind`.
        RegexType -> is_kind_of(got, RegexType)

        // An external fits an external and nothing else, which mirrors `is_kind` again -- what a
        // host value can do is not a shape this pass knows, so the kind is the whole of the question.
        ExternalType -> is_kind_of(got, ExternalType)
        // **The arity and the parameters, and deliberately NOT the result.**
        //
        // **What is wanted is a call of a fixed size, and what fits is anything that ACCEPTS one
        // that size** -- so a function with defaults fits wherever the count it is being asked for
        // falls inside the range it takes, and one that gathers fits any count at all.
        //
        // **A parameter is CONTRAVARIANT**: the function being handed over has to accept everything
        // the type promises will be passed to it, so the wanted parameter must fit the one the value
        // declares. `g(n: string)` handed to `f(cb: integer -> integer)` is refused here, and the
        // machine refuses it too -- `g`'s own annotation faults the moment `f` calls it with the
        // integer it was promised it could. That is the same one-step-later reading the count has.
        //
        // **THE RESULT IS NOT COMPARED, AND THAT IS THE INVARIANT SPEAKING RATHER THAN AN OMISSION.**
        // Nothing at run time would ever refuse it: a function's own `-> string` is checked against
        // what that function answers, and never against what somebody who was handed it expected. So
        // a mismatch there is a complaint no machine makes, which this pass may not invent. Where the
        // result MATTERS -- `f(cb) = cb(1) + 1` -- it is read off the annotation and the arithmetic
        // is checked on its own, which catches the same mistake from the side that faults.
        FunctionType(want_params, _, _, _) -> *got.kind match
            FunctionType(got_params, got_required, got_variadic, _) ->
                // The bare word `function` says callable and nothing else, and is written as a
                // function type with no parameters -- so an empty list asks nothing here.
                if want_params.is_empty() then return true

                // **Only the floor, because only the floor is a limit.** A call giving more than the
                // function declares drops the surplus, so a function of FEWER parameters is usable
                // wherever more are supplied -- which is TypeScript's rule and is what makes
                // `apply(f: (integer, integer) -> integer) = f(1, 2)` accept `n -> n`. Refusing it
                // would be reporting what the machine does not.
                if want_params.len() < got_required then return false

                // **A GATHERING FUNCTION'S LAST PARAMETER IS AN ARRAY OF ARGUMENTS AND NOT ONE OF
                // THEM**, so comparing it against what the caller will pass is comparing an array
                // against an element -- which refused `map(ns, (...rest) -> rest.length)`, a program
                // that runs. Everything before the gathering one is an ordinary parameter and is
                // compared.
                val fixed = if got_variadic then got_params.len() - 1 else got_params.len()

                for i in 0..<want_params.len()
                    if i < fixed && !fits(want_params.at(i), got_params.at(i)) then return false

                true
            _ -> false
        _ -> true
end fits

is_kind_of(t: Type, k: TypeKind) -> bool
    *t.kind match
        NullType -> k match
            NullType -> true
            _ -> false
        BooleanType -> k match
            BooleanType -> true
            _ -> false
        IntegerType -> k match
            IntegerType -> true
            _ -> false
        RealType -> k match
            RealType -> true
            _ -> false
        NumberType -> k match
            NumberType -> true
            _ -> false
        StringType -> k match
            StringType -> true
            _ -> false

        // **The two kinds that are neither a number nor a name, and leaving them out refused a
        // program that runs.** `fits`' arms for both are written as this question, so a walk that
        // fell through here answered no about a regular expression handed to a parameter annotated
        // `regex` -- reachable only where the pass is CERTAIN of both sides, which an annotated
        // parameter handed on to another one is.
        RegexType -> k match
            RegexType -> true
            _ -> false
        ExternalType -> k match
            ExternalType -> true
            _ -> false
        _ -> false
end is_kind_of

// -- what is known about a name ----------------------------------------------------------------

// The names in scope and what is known about each.
//
// **A flat stack with marks rather than a chain of tables**, because this is compile-time and short:
// a lookup walks backwards to the first match, which is shadowing for free, and leaving a scope is
// one `truncate`. A chain would need a counted box per scope for a structure that never outlives the
// walk.
// What a `val` was bound to, where the answer decides a PROPERTY assignment and nothing else.
//
// **It is deliberately not a type.** This pass carries no object shape through a name — `unshaped`
// drops one on the way in, because a stale shape is too narrow and refuses a program that runs — and
// nothing here changes that. What is recorded is a class NAME and the literal a `class` declaration
// made, read by `check_property_assign`.
//
// **`BoundNative` says the name is a BUILTIN, and it is here because arity stopped being one rule.**
// A call to a function the program wrote drops what it cannot bind; a builtin's parameters are
// sysl's and it refuses a count it does not take, in its own words. So the checker may still say
// *"too many"* about a builtin and may not about anything else -- and what tells the two apart is
// where the signature came from, which is exactly what an entry in the scope knows and a `Type` does
// not. It travels beside `types`, so a `val print = …` shadows it like any other binding.
enum Bound
    BoundPlain
    BoundClass(lit: Expr)
    BoundInstance(cls: string)
    BoundNative
end Bound

struct TypeEnv
    names: Buf[string]
    types: Buf[Type]

    // **WHAT AN ASSIGNMENT IS CHECKED AGAINST, WHICH IS NOT WHAT A READ ANSWERS.** An annotated
    // `var` carries two types: the one the program declared, which every assignment is held to for
    // the name's whole life, and the one it holds at the line being walked, which is what a use of
    // the name is checked against. `types` is the second and this is the first; for every other name
    // the two are one type written twice.
    declared: Buf[Type]

    // **Whether a name may be written to, which only NARROWING needs.** A name reassigned inside
    // the branch that narrowed it makes the narrowed type stale, and a stale type here is too narrow
    // -- which refuses a program that runs. So a name is narrowed only where the writes to it are
    // followed, which is what `tracked` below says.
    settled: Buf[bool]

    // Whether this entry says what the name holds AT THIS POINT -- a narrowing, an assignment, or
    // the join of an `if`'s two branches -- rather than what it was declared. **A branch's scope is
    // read for these before it is left**, which is how the type each branch leaves a name at reaches
    // the join below the branch.
    flowed: Buf[bool]

    // Whether assignments to the name are FOLLOWED, so that a read answers what the last one put
    // there rather than what the name was declared. True for an annotated `var` all of whose writes
    // are in the block that declared it, and for nothing else -- so a flow note about any other name
    // dies with the scope that made it, exactly as a narrowing always has.
    tracked: Buf[bool]

    // **It travels BESIDE `types` rather than in a table of its own**, so leaving a scope drops it
    // and an inner binding shadows an outer one — both of which a separate table would have had to be
    // taught, and getting either wrong would refuse a program that runs.
    bound: Buf[Bound]

    marks: Buf[usize]
end TypeEnv

type_env() -> TypeEnv = TypeEnv(buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf())

enter_scope(e: *TypeEnv)
    e.marks.push(e.names.len())

leave_scope(e: *TypeEnv)
    drop_scope(e, false, false)

// The same, keeping what the names in the scope were left HOLDING.
//
// **A block runs to its end, so what it left a name at is what the line below it holds** -- and the
// scope a block opened is not a place that fact may die in. `widen` is for the scopes where it may:
// a loop runs an unknown number of times and a `try` may stop anywhere in its body, so a name
// assigned inside either is left at what it was DECLARED, which is the only thing true of every way
// out. Only a tracked name travels; everything else is dropped exactly as it always was.
leave_scope_flowing(e: *TypeEnv, widen: bool)
    drop_scope(e, true, widen)

private drop_scope(e: *TypeEnv, carry: bool, widen: bool)
    e.marks.pop() match
        Some(mark) ->
            var out_names: Buf[string] = buf()
            var out_types: Buf[Type] = buf()

            if carry
                gather_flow(e, mark, &out_names, &out_types)

            e.names.truncate(mark)
            e.types.truncate(mark)
            e.declared.truncate(mark)
            e.settled.truncate(mark)
            e.flowed.truncate(mark)
            e.tracked.truncate(mark)
            e.bound.truncate(mark)

            for i in 0..<out_names.len()
                if is_tracked(e, out_names.at(i))
                    note_flow(e, out_names.at(i), if widen then declared_of(e, out_names.at(i)) else out_types.at(i))
        None -> ()
end drop_scope

// What the scope standing open has left the names bound OUTSIDE it holding.
//
// **This is how a branch's exit type reaches the join below it**, so it is read before the scope is
// left rather than after. A name the scope DECLARED is left out -- an inner binding of the same
// spelling says nothing whatever about the outer one, and taking it for the outer one's type would
// be a claim that refuses a program that runs.
flow_here(e: *TypeEnv, names_out: *Buf[string], types_out: *Buf[Type])
    if e.marks.len() == 0 then return

    gather_flow(e, e.marks.at(e.marks.len() - 1), names_out, types_out)

private gather_flow(e: *TypeEnv, mark: usize, names_out: *Buf[string], types_out: *Buf[Type])
    for i in mark..<e.names.len()
        if e.flowed.at(i) && e.tracked.at(i) && !redeclared_above(e, e.names.at(i), mark)
            names_out.push(e.names.at(i))
            types_out.push(e.types.at(i))

// Whether the scope declared a name of this spelling itself, which makes every entry for it inside
// the scope a statement about a DIFFERENT name.
private redeclared_above(e: *TypeEnv, name: string, mark: usize) -> bool
    for i in mark..<e.names.len()
        if e.names.at(i) == name && !e.flowed.at(i) then return true

    false
end redeclared_above

// **AN OBJECT'S SHAPE IS NOT CARRIED BY A NAME, AND THAT IS THE CONSERVATIVE BOUNDARY OF THIS
// PASS.** An object is mutable and a field may be added to it anywhere -- by the next line, by a
// function it was passed to, through a second name for the same object -- so a shape recorded when
// it was built is a claim that goes out of date without anything local saying so. A stale shape is
// too NARROW, which makes the check refuse a program that runs, and that is the one mistake this
// pass may not make.
//
// **So a shape is checked only where the argument is an object LITERAL written at the call**, which
// cannot have been touched between being built and being handed over. That is the case the mistake
// is actually made in -- `distance(here, { x: 0 })` -- and it costs nothing to be sure about.
// Carrying one through a name wants either immutable records or an escape analysis, and is the next
// piece of work rather than a thing to guess at.
note_type(e: *TypeEnv, name: string, t: Type)
    note_binding(e, name, t, true)

// The same, keeping a shape the caller has PROVED cannot go stale.
//
// **`flow.sysl`'s `shape_survives` is the proof, and it is the escape analysis this note called the
// next piece of work.** A `val` whose name is never mentioned except to read a field off it cannot
// have been handed anywhere, so nothing outside the block that declared it holds the object -- and
// no field of it is ever written, so the shape it was built with is the shape it dies with.
note_shaped(e: *TypeEnv, name: string, t: Type)
    push_entry(e, name, t, t, true, false, false)

// The same, over a name the environment already has: what a DECLARATION says it is.
//
// **Whether the name may be written to was settled where it was bound and is not this one's
// business** -- a parameter is narrowable and a `var` is not, and an annotation changes neither. A
// name nothing has heard of is narrowable, which is what a parameter's own annotation wants.
//
// **AND WHETHER THE NAME IS FOLLOWED TRAVELS WITH IT TOO.** A parameter's annotation is read into
// scope before the body is entered and then met a second time as the `CheckType` the parser left at
// the top of it -- so a re-note that dropped the flag would untrack every parameter the moment its
// own annotation was walked, and an assignment below a narrowing would leave the narrowing standing.
renote_declared(e: *TypeEnv, name: string, t: Type)
    push_entry(e, name, unshaped(t), unshaped(t), !has_name(e, name) || may_narrow(e, name), false, is_tracked(e, name))

// The same, saying whether the name may later be written to.
note_binding(e: *TypeEnv, name: string, t: Type, settled: bool)
    push_entry(e, name, unshaped(t), unshaped(t), settled, false, false)

// **AN ANNOTATED `var`, WHICH IS THE ONE NAME WHOSE TWO TYPES DIFFER.** `flow` is what it holds
// where it was declared and `declared` is what it may ever hold; a read is checked against the
// first and an assignment against the second. It is narrowable for the reason it is followed: an
// assignment inside a branch is a flow note of its own, so nothing a branch does can leave a stale
// claim behind it.
note_var(e: *TypeEnv, name: string, flow: Type, declared: Type)
    push_entry(e, name, unshaped(flow), unshaped(declared), true, false, true)

// What a name holds AT THIS POINT: a narrowing, an assignment, or the join of the branches above.
//
// **What the name was DECLARED travels with it**, or an assignment inside a branch that narrowed the
// name would be measured against the narrowing rather than against the annotation -- and
// `var m: string | number` assigned a number inside `if m is string` would be refused, which is a
// program that runs.
note_flow(e: *TypeEnv, name: string, t: Type)
    val b = bound_to(e, name)

    push_entry(e, name, unshaped(t), declared_of(e, name), may_narrow(e, name), true, is_tracked(e, name))
    note_bound(e, b)

private push_entry(e: *TypeEnv, name: string, t: Type, declared: Type, settled: bool, flowed: bool, tracked: bool)
    e.names.push(name)
    e.types.push(t)
    e.declared.push(declared)
    e.settled.push(settled)
    e.flowed.push(flowed)
    e.tracked.push(tracked)
    e.bound.push(BoundPlain)

// What the name just noted was BOUND to, where that is a class or one of its instances.
//
// **Written over the entry the note above just pushed**, so the two cannot come apart: every way of
// putting a name into the scope goes through one of the three above and pushes `BoundPlain`, and this
// is the one line that says otherwise.
note_bound(e: *TypeEnv, b: Bound)
    if e.bound.len() != 0 then e.bound.set(e.bound.len() - 1, b)

// What a name was bound to, walked backwards so the innermost binding answers.
bound_to(e: *TypeEnv, name: string) -> Bound
    var i = e.names.len()

    loop
        if i == 0 then return BoundPlain

        i -= 1

        if e.names.at(i) == name then return e.bound.at(i)
end bound_to

private unshaped(t: Type) -> Type
    *t.kind match
        ObjectWith(_, _, _) -> type_of(Any)
        _ -> t

// **Backwards, so the innermost binding of a name is the one found.**
known_type(e: *TypeEnv, name: string) -> Type
    var i = e.names.len()

    loop
        if i == 0 then return type_of(Any)

        i -= 1

        if e.names.at(i) == name then return e.types.at(i)
end known_type

// Whether this environment has heard of a name at all.
//
// **The same walk `known_type` makes, answering presence rather than a type**, which is the question
// an undefined name asks: `known_type` answers `Any` for a name it has never seen and for a name it
// has seen and knows nothing about, and those two are the same answer to a different question.
has_name(e: *TypeEnv, name: string) -> bool
    var i = e.names.len()

    loop
        if i == 0 then return false

        i -= 1

        if e.names.at(i) == name then return true

// **WHAT THE PROGRAM DECLARED THE NAME, which is what an assignment to it is checked against.** For
// every name but an annotated `var` it is what `known_type` answers as well; for that one it is the
// annotation, where `known_type` is what the name holds at the line being walked.
declared_of(e: *TypeEnv, name: string) -> Type
    var i = e.names.len()

    loop
        if i == 0 then return type_of(Any)

        i -= 1

        if e.names.at(i) == name then return e.declared.at(i)
end declared_of

// Whether assignments to the name move what a read of it answers.
is_tracked(e: *TypeEnv, name: string) -> bool
    var i = e.names.len()

    loop
        if i == 0 then return false

        i -= 1

        if e.names.at(i) == name then return e.tracked.at(i)
end is_tracked

// Whether a name is one narrowing may say anything about.
may_narrow(e: *TypeEnv, name: string) -> bool
    var i = e.names.len()

    loop
        if i == 0 then return false

        i -= 1

        if e.names.at(i) == name then return e.settled.at(i)
end may_narrow

// **`x is string` makes `x` a string for as long as the test held.** The feature a reader coming
// from TypeScript looks for first, and the reason it is safe here is the flag above: a name that may
// be written to is left alone, so a branch that reassigns what it narrowed cannot leave a stale
// claim behind.
//
// **Only a bare name is narrowed.** `o.f is string` would need to say something about `o` that the
// next line could undo by writing to the field, and this pass says nothing about an object's fields
// in the first place.
narrow_by(cond: Expr, want_true: bool, env: *TypeEnv)
    *cond.kind match
        IsPattern(subject, pat, negated) ->
            *subject.kind match
                Name(name) ->
                    if !may_narrow(env, name) then return

                    // A pattern that binds tells us nothing; one that tests tells us everything.
                    val binds = first_binding(pat) match
                        Some(_) -> true
                        None -> false

                    if binds then return

                    val narrowed = type_from_pattern(resolve_pattern(pat, 0))

                    // A negated test says on this side what the plain one says on the other, which
                    // is the same rule read backwards.
                    if negated != want_true
                        note_flow(env, name, narrowed)
                    else
                        // **THE SIDE THE TEST DID NOT HOLD ON TAKES THE ALTERNATIVE AWAY.** `x is
                        // string` failing says the value is not a string, so a name declared
                        // `string | number` holds a number in the else branch -- and until this was
                        // here the pass refused that call, which is the one mistake it may not make.
                        without_type(known_type(env, name), narrowed) match
                            Some(rest) -> note_flow(env, name, rest)
                            None -> ()
                _ -> ()

        // **`a && b` narrows by both**, which is what makes `if x is string && x.length > 0` work --
        // the second operand is already inside the first's narrowing when the machine evaluates it.
        //
        // **`x != null` narrows too, and it has to**, because it is how slate asks the question:
        // `indexOf` answers `integer | null`, `safePath` answers `string | null`, and every one of
        // those is guarded with a comparison rather than with `is`. Without this a union annotation
        // could not be written at all -- the pass would refuse the very program the annotation was
        // describing, which is the one mistake it may not make.
        Binary(op, lhs, rhs) ->
            if op == AndAnd && want_true
                narrow_by(lhs, true, env)
                narrow_by(rhs, true, env)

            // **`a || b` is that rule on the other side.** Reaching the else means neither operand
            // held, so both of them narrow by their false side -- which is what makes
            // `if x == null || done then ... else f(x)` the program it reads as.
            if op == OrOr && !want_true
                narrow_by(lhs, false, env)
                narrow_by(rhs, false, env)

            if op == EqEq || op == BangEq
                // The name may be written either side of the comparison; only one of the two is a
                // name and only one is `null`, so this reads both orders without deciding anything.
                val subject = if is_null_literal(rhs) then lhs elif is_null_literal(lhs) then rhs else lhs

                if is_null_literal(rhs) || is_null_literal(lhs)
                    *subject.kind match
                        Name(name) ->
                            if !may_narrow(env, name) then return

                            // `x == null` on the true side says it IS null, and on the false side
                            // says it is not; `!=` is the same two answers the other way round.
                            val says_null = (op == EqEq) == want_true

                            if says_null
                                note_flow(env, name, type_of(NullType))
                            else
                                without_null(known_type(env, name)) match
                                    Some(rest) -> note_flow(env, name, rest)
                                    None -> ()
                        _ -> ()

        // **`!c` is `c` with its two sides swapped**, so `if !(x is string) then a else b` narrows
        // in `b` exactly as `if x is not string` does. Written without this the two spellings of one
        // test did not mean the same thing.
        Unary(op, rhs) ->
            if op == Bang then narrow_by(rhs, !want_true, env)
        _ -> ()
end narrow_by

private is_null_literal(x: Expr) -> bool
    *x.kind match
        NullLit -> true
        _ -> false

// A union with one of its alternatives taken out, or nothing where there was nothing to take.
//
// **This is the else branch of a type test**, and the only narrowing that sharpens a type without a
// test having held: `x is string` failing says as much about a `string | number` as its holding says
// about the other side.
//
// **Nothing where there was nothing to take, and `Any` where taking it leaves nothing.** A name
// whose type is `Any` stays `Any`, this pass having nothing to sharpen; and a type with every
// alternative ruled out describes a branch nothing reaches, where a claim could only complain about
// code that never runs.
private without_type(t: Type, drop: Type) -> Option[Type]
    *t.kind match
        OneOf(alts) ->
            var kept: Buf[Type] = buf()

            // **`same_type` is already false for `Any` and for a union**, which is exactly the
            // caution wanted here: taking an alternative away on either would be claiming something
            // about a value this pass is not sure of, and a claim that is too narrow refuses a
            // program that runs.
            for i in 0..<alts.len()
                if !same_type(alts.at(i), drop) then kept.push(alts.at(i))

            if kept.len() == alts.len() then return None

            // **A UNION WITH EVERYTHING TAKEN OUT OF IT DESCRIBES A BRANCH NOTHING REACHES**, so the
            // name becomes `Any` there rather than keeping the type the test just ruled out. Keeping
            // it would leave the pass complaining about code that never runs, which is a complaint
            // no run could make.
            if kept.len() == 0 then return Some(type_of(Any))
            if kept.len() == 1 then return Some(kept.at(0))

            Some(type_of(OneOf(kept)))

        // The same answer where the type was never a union: `x is string` failing on an `x: string`
        // is the unreachable branch written without one.
        _ -> if same_type(t, drop) then Some(type_of(Any)) else None
end without_type

// A union with `null` taken out of it, or nothing where there was no `null` to take.
//
// **Nothing where the type is not a union**, because this pass may only sharpen what it already
// knew: a name whose type is `Any` is still `Any` after a null test, an unannotated value being one
// this pass has nothing to say about either way.
private without_null(t: Type) -> Option[Type]
    *t.kind match
        OneOf(alts) ->
            var kept: Buf[Type] = buf()

            for i in 0..<alts.len()
                *alts.at(i).kind match
                    NullType -> ()
                    _ -> kept.push(alts.at(i))

            if kept.len() == alts.len() then return None
            if kept.len() == 0 then return None
            if kept.len() == 1 then return Some(kept.at(0))

            Some(type_of(OneOf(kept)))
        _ -> None
end without_null

// -- where two branches meet -----------------------------------------------------------------------

// The two types together: what a name holds below an `if` whose branches left it holding each.
//
// **`Any` swallows everything**, a branch this pass knows nothing about being one it may claim
// nothing about below. Alternatives are flattened as they are collected, so a union never holds one,
// and `same_type` is what keeps `string | string` from being written down as two.
union_type(a: Type, b: Type) -> Type
    var alts: Buf[Type] = buf()

    if !add_alternatives(a, &alts) then return type_of(Any)
    if !add_alternatives(b, &alts) then return type_of(Any)

    if alts.len() == 0 then return type_of(Any)
    if alts.len() == 1 then return alts.at(0)

    type_of(OneOf(alts))
end union_type

private add_alternatives(t: Type, alts: *Buf[Type]) -> bool
    *t.kind match
        Any -> return false
        OneOf(inner) ->
            for i in 0..<inner.len()
                if !add_alternatives(inner.at(i), alts) then return false
        _ ->
            var held = false

            for i in 0..<alts.len()
                if same_type(alts.at(i), t) then held = true

            if !held then alts.push(t)

    true
end add_alternatives

// What the branches walked so far have left each name holding.
//
// **A join is the union of the branches that can FALL OUT of the construct**, and a branch that
// always leaves -- a `return`, a `throw`, a `break` -- contributes nothing, because control below
// the construct never came from it. A branch that says nothing about a name contributes what the
// name held ABOVE the construct, which is what that branch left it at.
struct FlowJoin
    names: Buf[string]
    types: Buf[Type]
    reached: bool
end FlowJoin

join_start() -> FlowJoin = FlowJoin(buf(), buf(), false)

join_arm(j: *FlowJoin, e: *TypeEnv, names: Buf[string], types: Buf[Type])
    if !j.reached
        for i in 0..<names.len()
            j.names.push(names.at(i))
            j.types.push(types.at(i))

        j.reached = true

        return

    var merged_names: Buf[string] = buf()
    var merged_types: Buf[Type] = buf()

    for i in 0..<j.names.len()
        if !holds_name(merged_names, j.names.at(i)) then merged_names.push(j.names.at(i))

    for i in 0..<names.len()
        if !holds_name(merged_names, names.at(i)) then merged_names.push(names.at(i))

    for i in 0..<merged_names.len()
        val name = merged_names.at(i)
        val above = known_type(e, name)

        merged_types.push(union_type(last_flow(name, j.names, j.types, above), last_flow(name, names, types, above)))

    j.names = merged_names
    j.types = merged_types
end join_arm

// What the join says, written into the scope the construct stood in.
join_apply(j: *FlowJoin, e: *TypeEnv)
    if !j.reached then return

    for i in 0..<j.names.len()
        if is_tracked(e, j.names.at(i)) then note_flow(e, j.names.at(i), j.types.at(i))

// **The LAST note wins**, a scope holding one per assignment and narrowing in the order they were
// walked.
private last_flow(name: string, names: Buf[string], types: Buf[Type], fallback: Type) -> Type
    var out = fallback

    for i in 0..<names.len()
        if names.at(i) == name then out = types.at(i)

    out
end last_flow

private holds_name(names: Buf[string], name: string) -> bool
    for i in 0..<names.len()
        if names.at(i) == name then return true

    false
end holds_name
