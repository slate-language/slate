module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// `data` -- algebraic data types, and the closed list of variants that makes a `match` over one worth
// checking.
//
// **A variant IS a class from the data type**, so most of what these assert is that the machinery
// `class` already had reaches them: `is`, an annotation, `export`, a cross-file import, a generated
// constructor, a method on the shared object. What is new is the positional pattern, the singleton
// variant, and that a data value does not change.

private val DataShapes: string = """
    data Shape
        Circle(r)
        Rect(w, h)
        Empty

        area(self) = self match
            Circle(r) -> r * r * 3
            Rect(w, h) -> w * h
            Empty -> 0
    """

// -- making one and taking it apart -----------------------------------------------------------------

@test
A_VARIANT_IS_MADE_BY_CALLING_IT_AND_ITS_FIELDS_ARE_ORDINARY()
    // `Circle(3)` is the whole of it -- the generated constructor a class gets, reached by the rule
    // that calling an object calls its `new`.

    assert_eq(out(DataShapes + "print(Circle(3).r, Rect(2, 5).w, Rect(2, 5).h)"), "3 2 5")

@test
A_PATTERN_TAKES_A_VARIANT_APART_BY_POSITION()
    // The field names are the declaration's, filled in while compiling, so the pattern says what a
    // reader means and never repeats the names.

    assert_eq(out(DataShapes + "print(Circle(4).area(), Rect(3, 5).area(), Empty.area())"), "48 15 0")

@test
A_NESTED_PATTERN_AND_A_GUARD_WORK_AS_THEY_DO_ANYWHERE()
    // A variant's fields are patterns like any others, so nesting, literals and guards all arrive
    // without this feature knowing about them.

    assert_eq(out(DataShapes + """
        describe(s) = s match
            Circle(0) -> "a point"
            Circle(r) if r > 10 -> "a big circle"
            Circle(_) -> "a circle"
            Rect(w, h) if w == h -> "a square"
            Rect(_, _) -> "a rectangle"
            Empty -> "nothing"
        print(describe(Circle(0)), describe(Circle(20)), describe(Circle(2)))
        print(describe(Rect(3, 3)), describe(Rect(3, 4)), describe(Empty))
        """), "a point a big circle a circle\na square a rectangle nothing")

@test
A_VARIANT_THAT_DECLARES_NO_FIELDS_IS_A_VALUE_AND_A_PATTERN()
    // Scala's `case object`. `Empty` is the object itself, so the test is identity with it rather than
    // a walk up a chain -- which would reach the data type and answer yes for every variant.

    assert_eq(out(DataShapes + "print(Empty is Empty, Circle(1) is Empty, Empty is Shape)"), "true false true")

@test
is_ASKS_ABOUT_A_VARIANT_AND_ABOUT_THE_WHOLE_DATA_TYPE()
    // Both come from the type each name registers, which is `class`'s one piece of machinery reused.

    assert_eq(out(DataShapes + """
        val c = Circle(1)
        print(c is Circle, c is Rect, c is Shape, 4 is Shape)
        """), "true false true false")

@test
AN_ANNOTATION_MAY_NAME_A_DATA_TYPE_OR_A_VARIANT()
    assert_eq(out(DataShapes + """
        wide(s: Shape) = s.area()
        round(c: Circle) = c.r
        print(wide(Rect(2, 3)), round(Circle(9)))
        """), "6 9")

    assert(fails(DataShapes + "wide(s: Shape) = s.area()\nprint(wide(4))").contains("was declared Shape"))

@test
A_METHOD_ON_THE_DATA_TYPE_IS_REACHED_FROM_EVERY_VARIANT()
    // The data type is the `proto` of every variant, so a definition under it is found by the receiver
    // rule that was already there -- including from a singleton, which is an object like the rest.

    assert_eq(out("""
        data Colour
            Red
            Green
            Blue

            name(self) = if self is Red then "red" elif self is Green then "green" else "blue"
        print(Red.name(), Green.name(), Blue.name())
        """), "red green blue")

@test
A_val_UNDER_data_IS_ONE_VALUE_THE_WHOLE_TYPE_SHARES()
    assert_eq(out("""
        data Suit
            Hearts
            Spades

            val deck = 52
        print(Hearts.deck, Spades.deck)
        """), "52 52")

@test
A_VARIANTS_FIELD_MAY_CARRY_A_DEFAULT()
    // The generated constructor's default, which is worked out at the call -- so an array written here
    // gives every value its own.

    assert_eq(out("""
        data Item
            Note(text, tags = [])
        val a = Note("hi")
        val b = Note("ho")
        print(a.tags, b.tags, Note("x", ["k"]).tags)
        """), "[] [] [\"k\"]")

@test
A_DATA_TYPE_MAY_BE_RECURSIVE()
    // A pattern looks its name up rather than expanding it, which is what a `type` could not do --
    // `type T = { next: T }` is refused for hitting the resolver's depth cap.

    assert_eq(out("""
        data Tree
            Leaf(v)
            Node(left, right)

            total(self) = self match
                Leaf(v) -> v
                Node(l, r) -> l.total() + r.total()
        print(Node(Leaf(1), Node(Leaf(2), Leaf(3))).total())
        """), "6")

// -- a data value does not change ---------------------------------------------------------------

@test
WRITING_A_FIELD_OF_A_DATA_VALUE_IS_REFUSED_AND_THE_MESSAGE_NAMES_with()
    // **The fix is the whole of the sentence.** Told only that the write is refused, a reader has
    // nowhere to go; told that `with` answers a copy, they have the line to write.

    val said = fails(DataShapes + "val c = Circle(3)\nc.r = 5")

    assert(said.contains("belongs to a data value"))
    assert(said.contains("`v with { `r`: ... }`") || said.contains("with"))

@test
WRITING_THROUGH_AN_INDEX_IS_REFUSED_TOO()
    // The other way into an object, and it says the same thing -- `obj_put` is where that one lands.

    assert(fails(DataShapes + "val c = Circle(3)\nc[\"r\"] = 5").contains("belongs to a data value"))

@test
with_ANSWERS_A_NEW_DATA_VALUE_THAT_IS_STILL_ONE()
    // Still a `Circle`, still sealed, so the copy is not a way round the rule.

    assert_eq(out(DataShapes + """
        val c = Circle(3)
        val d = c with { r: 5 }
        print(c.r, d.r, d is Circle, d.area())
        """), "3 5 true 75")

    assert(fails(DataShapes + "val d = Circle(3) with { r: 5 }\nd.r = 9").contains("belongs to a data value"))

@test
A_DATA_VALUE_IS_A_KEY_LIKE_ANY_OTHER_AND_TWO_EQUAL_ONES_ARE_ONE_KEY()
    // Hashing and equality are structural here, so this needs nothing of its own -- what immutability
    // buys is that a key cannot change under the table it is in.

    assert_eq(out(DataShapes + """
        var seen = {}
        seen[Circle(3)] = "three"
        seen[Rect(1, 2)] = "one by two"
        print(seen[Circle(3)], seen[Rect(1, 2)], Circle(3) == Circle(3), Circle(3) == Circle(4))
        """), "three one by two true false")

// -- what is refused, and what each refusal says ---------------------------------------------------

@test
A_PATTERN_NAMING_THE_WRONG_NUMBER_OF_FIELDS_IS_REFUSED_WHILE_COMPILING()
    // **A pattern cannot fault**, so an unchecked mismatch would simply never match -- silently, which
    // is the failure mode every pattern defect here has. This is the one place that has both the
    // pattern a person wrote and the declaration it names.

    val said = fails(DataShapes + "print(Circle(1) match\n    Circle(a, b) -> a)")

    assert(said.contains("`Circle` carries 1 field and this names 2"))

@test
A_PATTERN_NAMING_SOMETHING_THAT_IS_NOT_A_VARIANT_IS_REFUSED()
    assert(fails("print(1 match\n    Nope(a) -> a)").contains("nothing here declares `Nope`"))
    assert(fails("class Box\n    var v\nprint(Box(1) match\n    Box(a) -> a)").contains("`Box` is not one"))

@test
A_var_IN_A_DATA_BODY_IS_REFUSED_WITH_THE_LINE_THAT_WOULD_HAVE_WORKED()
    // A data type makes no objects itself -- its variants do -- so a per-object field there has
    // nowhere to live. The message names the variant's own brackets.

    val said = fails("data Shape\n    Circle(r)\n\n    var side\nprint(Circle(1))")

    assert(said.contains("a field belongs to a VARIANT"))
    assert(said.contains("Circle(r)"))

@test
A_DATA_TYPE_WITH_NO_VARIANTS_IS_REFUSED()
    assert(fails("data Shape\nprint(Shape)").contains("declares no variants"))

@test
A_VARIANT_MAY_NOT_BE_NAMED_AFTER_ITS_DATA_TYPE_OR_DECLARED_TWICE()
    assert(fails("data Shape\n    Shape(r)\nprint(1)").contains("may not be called `Shape` too"))
    assert(fails("data Shape\n    Circle(r)\n    Circle(x)\nprint(1)").contains("`Circle` is given twice"))

@test
A_DATA_TYPE_HAS_NO_from()
    // It IS the base its variants descend from, so there is nothing for a `from` to say.

    assert(fails("class Thing\ndata Shape from Thing\n    Circle(r)\nprint(1)").contains("has no `from`"))

@test
A_DATA_DECLARATION_BELONGS_TO_THE_TOP_LEVEL()
    // `type`'s rule for `type`'s reason: its name is resolved while compiling, and one declared inside
    // a block would not be there for `is` to resolve against.

    assert(fails("if true\n    data Shape\n        Circle(r)\nprint(1)").contains("top level of a file"))

@test
data_IS_A_SOFT_WORD()
    // Two tokens settle it, as `class` and `type` are settled, so a program already calling a variable
    // `data` is untouched.

    assert_eq(out("val data = 1\n\ndata Shape\n    Circle(r)\nprint(data, Circle(2).r)"), "1 2")

// -- across a file ---------------------------------------------------------------------------------

@test
A_DATA_TYPE_AND_ITS_VARIANTS_CROSS_A_FILE_TOGETHER()
    // **`export data` exports every name it wrote**, which is what makes it different from a class: a
    // file importing `Shape` and not `Circle` could match nothing.

    // **One variant is imported under an ALIAS**, which is the half that would otherwise pass with a
    // bug in: a pattern carries the name it was declared under, and one still asking for `Circle`
    // where the import bound it as `Round` matches nothing and says nothing.

    assert_eq(ran_out("tests/mods/uses_figures.sl"), "48 15 0\ntrue true false\ncircle rect empty")

// -- what one looks like when it is printed --------------------------------------------------------

@test
A_DATA_VALUE_PRINTS_AS_THE_VARIANT_THAT_MADE_IT()
    // **Most of what makes a data type readable.** Printed as the object it is, `Circle(3)` comes out
    // as `{r: 3, proto: {...}}` with the whole shared object written after it -- so every print of a
    // tree would be pages of the same methods over and over. The name is read off the maker, which is
    // where the declaration put it, and it is on the maker rather than on the value so that it costs
    // an instance nothing and stays out of `keys`, `==` and a `with` copy.

    assert_eq(out(DataShapes + "print(Circle(3), Rect(2, 5), Empty)"), "Circle(3) Rect(2, 5) Empty")

@test
A_NESTED_DATA_VALUE_PRINTS_ALL_THE_WAY_DOWN()
    assert_eq(out("""
        data Tree
            Leaf(v)
            Node(left, right)
        print(Node(Leaf(1), Node(Leaf(2), Leaf(3))))
        """), "Node(Leaf(1), Node(Leaf(2), Leaf(3)))")

@test
THE_NAME_A_DATA_VALUE_PRINTS_BY_IS_NOT_A_FIELD_OF_IT()
    // It sits on the maker, so it is not in `keys`, not in a `with` copy's own fields, and not
    // something `==` compares. An instance that carried it would have a field nobody wrote.

    assert_eq(out(DataShapes + "print(keys(Circle(3)), Circle(3) == Circle(3))"), "[\"r\", \"proto\"] true")

@test
AN_ORDINARY_OBJECT_GIVEN_A_MAKER_AS_ITS_proto_PRINTS_AS_ITSELF()
    // **The frozen flag is what decides, not the chain.** A program may point any object's `proto`
    // wherever it likes, and one that was not made by a variant's constructor is not a data value --
    // printing it as one would be a claim about how it was made.

    val said = out(DataShapes + "print({ r: 9, proto: Circle })")

    assert(said.starts_with("{r: 9"))
