module dev.slatelang.slate
@tests

// `fetch`'s `redirect` option, and the refusal of an option `fetch` does not have.
//
// **`tests_fetch.sysl`'s arrangement with a server and probes of its own**: what both back ends
// answer alike is one probe held to one written answer on each; what only the interpreter can do --
// `"manual"`, which a browser withholds -- is a probe of its own, and the JavaScript back end's
// refusal of it is a third.

// Every redirect carries a relative `Location`, two cookies and a body, so `"manual"` has something
// to lose in each. `/hN` is a chain of N redirects ending at `/h0`, which is what the cap is
// measured with.
private val RedirectServer: string =
    "import { serve, close as stop } from slate:http\n" +
    "import { localPort } from slate:net\n" +
    "\n" +
    "moved(code, to) = { status: code, headers: { Location: to, \"Set-Cookie\": [\"sid=7; Path=/; HttpOnly\", \"seen=1; Expires=Wed, 21 Oct 2026 07:28:00 GMT\"], \"X-Why\": \"moved\" }, body: \"moved \" + string(code) }\n" +
    "\n" +
    "val server = serve(0, (req) ->\n" +
    "    if req.path == \"/s301\" then moved(301, \"/there\")\n" +
    "    elif req.path == \"/s302\" then moved(302, \"/there\")\n" +
    "    elif req.path == \"/s303\" then moved(303, \"/there\")\n" +
    "    elif req.path == \"/s307\" then moved(307, \"/there\")\n" +
    "    elif req.path == \"/s308\" then moved(308, \"../up/there?x=1\")\n" +
    "    elif req.path == \"/there\" then \"arrived\"\n" +
    "    elif req.path == \"/h6\" then moved(302, \"/h5\")\n" +
    "    elif req.path == \"/h5\" then moved(302, \"/h4\")\n" +
    "    elif req.path == \"/h4\" then moved(302, \"/h3\")\n" +
    "    elif req.path == \"/h3\" then moved(302, \"/h2\")\n" +
    "    elif req.path == \"/h2\" then moved(302, \"/h1\")\n" +
    "    elif req.path == \"/h1\" then moved(302, \"/h0\")\n" +
    "    elif req.path == \"/h0\" then \"landed\"\n" +
    "    else \"plain\")\n"

// What both back ends answer alike: following, the cap, `"error"`, and every way to write the
// options wrongly.
private val SharedProbe: string =
    "anything(v) = v\n" +
    "\n" +
    "async main()\n" +
    "    val f = await fetch(base + \"/s302\")\n" +
    "    print(f.value.status, f.value.body)\n" +
    "    val g = await fetch(base + \"/s303\", { redirect: \"follow\" })\n" +
    "    print(g.value.status, g.value.body)\n" +
    "    print((await fetch(base + \"/h5\")).value.body)\n" +
    "    val e = await fetch(base + \"/s307\", { redirect: \"error\" })\n" +
    "    print(e.ok, e.error == base + \"/s307 redirected, and `redirect: \\\"error\\\"` asked for a redirect to fail the fetch\")\n" +
    "    val p = await fetch(base + \"/plain\", { redirect: \"error\" })\n" +
    "    print(p.value.status, p.value.body)\n" +
    "    print(fetch(base, { redirect: anything(\"stop\") }) catch x -> x.message)\n" +
    "    print(fetch(base, { redirect: anything(5) }) catch x -> x.message)\n" +
    "    print(fetch(base, { timout: anything(100) }) catch x -> x.message)\n" +
    "    finish()\n" +
    "\n" +
    "main()\n"

private val SharedExpected: string =
    "200 arrived\n" +
    "200 arrived\n" +
    "landed\n" +
    "false true\n" +
    "200 plain\n" +
    "`redirect` is \"follow\", \"manual\" or \"error\", and this is \"stop\"\n" +
    "`redirect` is a string, and this is an integer\n" +
    "`fetch` has no option `timout` -- it takes `method`, `body`, `headers`, `timeout`, `stream`, `reuse`, `redirect` and `trust`"

// **Following, the five-redirect cap from both sides, `"error"` on a redirect and on a response that
// is not one, and three wrong options**, the same on both back ends.
@test
redirect_FOLLOWS_OR_FAILS_AND_A_WRONG_OPTION_IS_REFUSED_THE_SAME_WAY_ON_BOTH_BACK_ENDS()
    assert_eq(out(fetch_under_slate(RedirectServer, SharedProbe)).trim(), SharedExpected)
    assert_eq(fetch_under_node(RedirectServer, SharedProbe).trim(), SharedExpected)

// The sixth redirect is the one refused. The interpreter's sentence; a JavaScript host's cap and its
// words are the host's own.
@test
redirect_follow_STILL_STOPS_AFTER_FIVE()
    val probe = "async main()\n" +
        "    val r = await fetch(base + \"/h6\")\n" +
        "    print(r.ok, r.error == base + \"/h1 redirected more than 5 times\")\n" +
        "    finish()\n" +
        "main()\n"

    assert_eq(out(fetch_under_slate(RedirectServer, probe)).trim(), "false true")

// **Every redirect status answered as it came**: the status, `location` exactly as written --
// relative, `..` and all -- both `Set-Cookie` lines, the other headers, and the body. Then a
// response that is not a redirect, which `"manual"` does not change.
private val ManualProbe: string =
    "async main()\n" +
    "    for code in [301, 302, 303, 307, 308]\n" +
    "        val r = await fetch(base + \"/s\" + string(code), { redirect: \"manual\" })\n" +
    "        val h = r.value.headers\n" +
    "        print(r.ok, r.value.status, h[\"location\"], toJSON(h[\"set-cookie\"]), h[\"x-why\"], r.value.body)\n" +
    "    val p = await fetch(base + \"/plain\", { redirect: \"manual\" })\n" +
    "    print(p.value.status, p.value.body)\n" +
    "    finish()\n" +
    "main()\n"

private val Cookies: string = "[\"sid=7; Path=/; HttpOnly\",\"seen=1; Expires=Wed, 21 Oct 2026 07:28:00 GMT\"]"

@test
redirect_manual_ANSWERS_THE_3XX_ITSELF_WITH_EVERY_HEADER_AND_THE_LOCATION_UNRESOLVED()
    assert_eq(out(fetch_under_slate(RedirectServer, ManualProbe)).trim(),
        s"true 301 /there ${Cookies} moved moved 301\n" +
        s"true 302 /there ${Cookies} moved moved 302\n" +
        s"true 303 /there ${Cookies} moved moved 303\n" +
        s"true 307 /there ${Cookies} moved moved 307\n" +
        s"true 308 ../up/there?x=1 ${Cookies} moved moved 308\n" +
        "200 plain")

// **A streamed fetch is the same question asked of the head**, so `"manual"` hands the 3xx over with
// its body as a source, `"error"` fails it, and `"follow"` streams the place it lands.
@test
redirect_manual_AND_error_WORK_ON_A_STREAMED_FETCH()
    val probe = "async drain(path, opts)\n" +
        "    val r = await fetch(base + path, opts)\n" +
        "    if !r.ok then return r.error == base + path + \" redirected, and `redirect: \\\"error\\\"` asked for a redirect to fail the fetch\"\n" +
        "    using body = r.value.body\n" +
        "    var got = bytes(0)\n" +
        "    for await c in body\n" +
        "        push(got, c)\n" +
        "    string(r.value.status) + \" \" + (r.value.headers[\"location\"] ?? \"-\") + \" \" + string((r.value.headers[\"set-cookie\"] ?? []).length) + \" \" + fromBytes(got).value\n" +
        "async main()\n" +
        "    print(await drain(\"/s303\", { stream: true, redirect: \"manual\" }))\n" +
        "    print(await drain(\"/s308\", { stream: true, redirect: \"manual\" }))\n" +
        "    print(await drain(\"/s302\", { stream: true, redirect: \"error\" }))\n" +
        "    print(await drain(\"/s302\", { stream: true }))\n" +
        "    finish()\n" +
        "main()\n"

    assert_eq(out(fetch_under_slate(RedirectServer, probe)).trim(),
        "303 /there 2 moved 303\n" +
        "308 ../up/there?x=1 2 moved 308\n" +
        "true\n" +
        "200 - 0 arrived")

// **The JavaScript back end refuses `"manual"`**, a browser withholding the status, headers and
// location of a manual redirect -- the one thing the option asks for. node is held to the browser's
// answer so the two JavaScript hosts agree.
@test
redirect_manual_REFUSES_ON_A_JAVASCRIPT_HOST_BECAUSE_A_BROWSER_HIDES_THE_REDIRECT()
    val probe = "async main()\n" +
        "    print(fetch(base + \"/s303\", { redirect: \"manual\" }) catch x -> x.message)\n" +
        "    finish()\n" +
        "main()\n"

    assert_eq(fetch_under_node(RedirectServer, probe).trim(),
        "`redirect: \"manual\"` hands back the 3xx itself, and a browser gives a page no status, headers or location for one -- so no JavaScript host offers it here")
