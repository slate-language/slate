module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// Generators, HTTP, and the faults a program can raise. Regular expressions are
// `tests_regex.sysl`'s.

// -- generators ----------------------------------------------------------------------------------

@test
A_FUNCTION_IS_A_GENERATOR_BECAUSE_IT_HOLDS_A_YIELD()
    // **Python's rule, and there is no second word to write.** A `yield` is the most visible line in
    // a body, so a marker on the definition would be a thing to forget rather than a thing to read.
    val g = "counter()\n    yield 1\n    yield 2\n"

    assert_eq(out(g + "print(counter() is generator)"), "true")

    // **Calling one runs NOTHING.** The body waits until something asks it for a value, which is the
    // difference between a generator and a function that answers an array.
    assert_eq(out("noisy()\n    print(\"ran\")\n    yield 1\nnoisy()\nprint(\"called\")"), "called")

    // An ordinary function is unaffected, which is what the parser's saved-and-restored count is for.
    assert_eq(out("plain() = 1\nprint(plain())"), "1")

@test
next_ANSWERS_A_VALUE_AND_WHETHER_IT_IS_DONE()
    // **`{ value, done }` rather than a bare value**, because `null` is a value a generator may
    // yield: a bare answer could not say whether the generator was finished or had handed one back.
    val g = "counter()\n    yield 1\n    yield 2\n    \"end\"\nval g = counter()\n"

    assert_eq(out(g + "print(g.next())"), "{value: 1, done: false}")
    assert_eq(out(g + "g.next()\nprint(g.next())"), "{value: 2, done: false}")

    // **The last step carries what the body RETURNED**, which is JavaScript's rule and is the only
    // place that value can go.
    assert_eq(out(g + "g.next()\ng.next()\nprint(g.next())"), "{value: \"end\", done: true}")

    // **A finished generator answers rather than faulting**, since asking one for another value is
    // what every loop over a generator does on its last turn.
    assert_eq(out(g + "g.next()\ng.next()\ng.next()\nprint(g.next())"), "{value: null, done: true}")
    assert_eq(out(g + "print(g.next().value, next(g).value)"), "1 2")

@test
A_FOR_LOOP_DRIVES_A_GENERATOR_AND_MAY_LEAVE_IT_UNFINISHED()
    val g = "counter(n)\n    var i = 0\n    while i < n\n        yield i\n        i = i + 1\n"

    assert_eq(out(g + "for x in counter(3)\n    print(x)"), "0\n1\n2")

    // **An endless generator is an ordinary thing to write**, which is most of the point: the values
    // are made as they are asked for, so a loop that stops early costs only what it took.
    val forever = "naturals()\n    var i = 0\n    loop\n        yield i\n        i = i + 1\n"

    assert_eq(out(forever + "var t = 0\nfor k in naturals()\n    if k > 5 then break\n    t = t + k\nprint(t)"), "15")

    // **What the body returns is not an element** -- `for` walks what a generator yields, and the
    // return value is the answer to "and then what", which only `next` asks.
    assert_eq(out("g()\n    yield 1\n    \"not an element\"\nfor x in g()\n    print(x)"), "1")

@test
A_GENERATOR_TAKES_A_VALUE_BACK_FROM_THE_CALLER()
    // **`yield` is an expression**, and what it answers is what the next `next` sent in. That falls
    // out of the same bargain `await` makes: the yielded value stays in its slot on the stack while
    // the machine is aside, and the sent value is written over it.
    val e = "echoer()\n    val a = yield \"first\"\n    val b = yield a\n    b\nval e = echoer()\n"

    assert_eq(out(e + "print(e.next().value)"), "first")
    assert_eq(out(e + "e.next()\nprint(e.next(\"A\").value)"), "A")
    assert_eq(out(e + "e.next()\ne.next(\"A\")\nprint(e.next(\"B\"))"), "{value: \"B\", done: true}")

    // **The first step sends nothing anywhere**, there being no `yield` yet whose slot to write into.
    // `started` is the flag that says so.
    assert_eq(out(e + "print(e.next(\"ignored\").value)"), "first")

    // A `for` sends nothing, so `yield` answers null inside a loop-driven generator.
    assert_eq(out("g()\n    val got = yield 1\n    print(\"got\", got)\nfor x in g()\n    print(x)"), "1\ngot null")

@test
A_LAMBDA_THAT_YIELDS_IS_THE_GENERATOR_AND_NOT_WHAT_ENCLOSES_IT()
    // **The count is restored around every body**, so a lambda's `yield` cannot make the definition
    // it is written in look like a generator.
    assert_eq(out("val mk = () -> yield 7\nprint(mk().next().value)"), "7")

    val nested = "outer()\n    val inner = () -> yield 1\n    inner()\nprint(outer() is generator)\n"

    assert_eq(out(nested), "true")

@test
A_FAULT_INSIDE_A_GENERATOR_IS_RAISED_WHERE_next_WAS_WRITTEN()
    // It has already been offered to the body's own `catch` blocks, which came back from `parked`
    // with the machine -- so anything still travelling belongs to whoever asked for the value.
    val g = "risky()\n    yield 1\n    print(1 / 0)\nval r = risky()\nr.next()\n"

    assert(fails(g + "r.next()").contains("this divides by zero"))
    assert_eq(out(g + "try\n    r.next()\ncatch e\n    print(\"caught:\", e.message)"), "caught: this divides by zero")

    // A generator that faulted is finished, and asking again says so rather than running it twice.
    assert_eq(out(g + "try\n    r.next()\ncatch e\n    print(r.next())"), "{value: null, done: true}")

@test
A_DEFINITION_MAY_NOT_TAKE_A_NAME_ITS_OWN_BLOCK_HAS_ALREADY_DECLARED()
    // **Definitions are HOISTED and everything else is bound where it stands**, so two declarations
    // of one name -- where the later is a definition -- do not run in the order they are written,
    // and the two back ends did not agree about what they did mean:
    //
    //     f() = 1
    //     print(f())
    //     f() = 2
    //     print(f())
    //
    // said `2 2` under the interpreter, whose `DefineFn` overwrites the binding as it hoists, and
    // `1 2` under the JavaScript back end, which rebinds in order. Neither is wrong given the
    // other's rule and no rule makes both right, so it is refused.
    val twice = fails("f() = 1\nprint(f())\nf() = 2\nprint(f())")

    assert(twice.contains("is declared twice in this block"))

    // **BOTH SITES ARE NAMED**, so the report carries both lines with a caret under each -- a span
    // knows offsets and the report is what turns one into a line, so two complaints is how this
    // names two lines.
    assert(twice.contains("the definition below takes the same name"))

    // The other shape: a `val` or a `var` the definition would replace.
    assert(fails("val f = 1\nf() = 2\nprint(f())").contains("is declared twice in this block"))
    assert(fails("var f = 1\nf() = 2\nprint(f())").contains("is declared twice in this block"))

    // **A NESTED BLOCK IS ITS OWN**, so shadowing an outer name is untouched -- which is the
    // ordinary reason to write a name twice.
    assert_eq(out("val f = 1\nif true\n    f() = 2\n    print(f())\nprint(f)"), "2\n1")

    // **AND A `val` BELOW A DEFINITION IS AN IDIOM, NOT A COLLISION**: it is how a generator is
    // named and then run, it means what it looks like, and both back ends already agree about it.
    assert_eq(out("g()\n    yield 1\n    yield 2\n\nval g = g()\nprint(g.next().value, g.next().value)"), "1 2")

@test
A_GENERATORS_OWN_try_SURVIVES_A_YIELD_AND_SO_DOES_AN_AWAITS()
    // **THIS FOUND A LIVE BUG ON THE `await` PATH, WHICH PREDATES GENERATORS.** `execute` took the
    // handler floor from `vm.handlers.len()` at entry -- right for a fresh run, where handlers
    // already owed belong to whoever called the native, and exactly wrong for a *resumed* one: a
    // coroutine's handlers come back from `parked` standing on the machine, so a floor above them
    // made every one unreachable. A fault raised after an `await` inside a `try` was not caught by
    // that `try` and turned up as an unhandled rejection.
    val awaited = "async main()\n    try\n        await sleep(1)\n        print(1 / 0)\n    catch e\n        print(\"caught:\", e.message)\nmain()\n"

    assert_eq(out(awaited), "caught: this divides by zero")

    // The same for a generator, which is the same machinery driven by the program.
    val guarded = "g()\n    try\n        yield \"a\"\n        print(1 / 0)\n    catch e\n        yield \"recovered\"\nval g = g()\n"

    assert_eq(out(guarded + "print(g.next().value, g.next().value)"), "a recovered")

@test
TWO_GENERATORS_RUN_INDEPENDENTLY_OF_EACH_OTHER()
    // Each has a machine of its own -- stack, frames, scope and handlers -- so interleaving them is
    // not something this had to be taught.
    val evens = "evens()\n    var n = 0\n    loop\n        yield n\n        n = n + 2\nval a = evens()\nval b = evens()\n"

    assert_eq(out(evens + "print(a.next().value, b.next().value, a.next().value, b.next().value)"), "0 0 2 2")

    // A generator over a generator needs nothing but a `for`.
    val over = "squares(xs)\n    for x in xs\n        yield x * x\ncounter()\n    yield 2\n    yield 3\n"

    assert_eq(out(over + "for s in squares(counter())\n    print(s)"), "4\n9")

@test
A_GENERATOR_IS_ITS_OWN_LINE_OF_EXECUTION_AND_IS_COMPARED_BY_IDENTITY()
    val g = "counter()\n    yield 1\nval a = counter()\nval b = counter()\n"

    assert_eq(out(g + "print(a == a, a == b)"), "true false")
    assert_eq(out(g + "val t = {}\nt[a] = \"first\"\nt[b] = \"second\"\nprint(t[a], t[b])"), "first second")
    assert_eq(out(g + "print(a is generator, a is function)"), "true false")

@test
A_GENERATOR_KEEPS_WHAT_IT_IS_HOLDING_ACROSS_A_COLLECTION()
    // **The suspended machine lives in `parked`, which `mark_vm` already walks** -- so a generator's
    // locals are traced without this feature adding a root of its own. Twenty thousand objects
    // through a generator is well past the collector's threshold.
    val many = "objects()\n    var i = 0\n    while i < 20000\n        yield { n: i }\n        i = i + 1\n" +
        "var last = null\nfor o in objects()\n    last = o\nprint(last.n)\n"

    assert_eq(out(many), "19999")

@test
yield_OUTSIDE_A_FUNCTION_AND_INSIDE_AN_async_ONE_ARE_BOTH_REFUSED()
    assert(fails("yield 3").contains("`yield` belongs inside a function"))

    // **An async generator is not slate.** The two are the same machinery pointed in different
    // directions -- resumed by the scheduler against resumed by the caller -- and a body that did
    // both would have two things entitled to put it back and no rule for which.
    assert(fails("async f()\n    yield 1\nf()").contains("an `async` function may not `yield`"))

    // `await` inside a generator is refused by the check that was already there.
    assert(fails("g()\n    yield await sleep(1)\ng().next()").contains("`await` belongs in an `async` function"))

@test
yield_TAKES_THE_WHOLE_EXPRESSION_WHERE_await_TAKES_ONE_OPERAND()
    // **The two look alike and group oppositely, and copying `await`'s power was a real bug.**
    // `await f() + 1` waits for the call and adds to the answer, so binding tightly is right there.
    // `yield x * x` means yielding the product; bound tightly it is `(yield x) * x`, which yields
    // the wrong value and then multiplies by whatever the caller sent back -- so it faulted a turn
    // later on `null * 2`, pointing at the yield and blaming the multiplication. JavaScript and
    // Python both put `yield` at the bottom of the ladder.
    assert_eq(out("g()\n    for x in [2, 3]\n        yield x * x\nfor s in g()\n    print(s)"), "4\n9")
    assert_eq(out("g()\n    yield 1 + 2\nprint(g().next().value)"), "3")

    // A yield used inside a larger expression is bracketed, which is what JavaScript requires too.
    val sent = "g()\n    val n = (yield 1) + 10\n    yield n\nval it = g()\nit.next()\n"

    assert_eq(out(sent + "print(it.next(5).value)"), "15")

    // Bare `yield` is `yield null`, so the node always has an operand.
    assert_eq(out("g()\n    yield\n    yield 2\nprint(g().next())"), "{value: null, done: false}")

// -- an HTTP server, and the requests a program makes ---------------------------------------------

@test
A_SERVER_ANSWERS_WHAT_ITS_HANDLER_ANSWERS()
    // **A string is a whole response**, which is what makes the first program somebody writes one
    // line long. The port is high and unlikely to be taken; every test here closes its own server,
    // and the watchdog is what turns a forgotten `close` into a failure rather than a hung suite.
    val body = "val server = serve(8181, req -> \"you asked for \" + req.path)\n" +
        "async main()\n" +
        "    val r = await fetch(\"http://127.0.0.1:8181/thing\")\n" +
        "    print(r.value.status, r.value.body)\n" +
        "    close(server)\n" +
        "    done()\n" +
        "main()\n"

    assert_eq(http_out(body), "200 you asked for /thing")

@test
A_HANDLER_MAY_ANSWER_AN_OBJECT_AND_SAY_EVERYTHING_ABOUT_THE_RESPONSE()
    val body = "val server = serve(8182, req -> { status: 201, headers: { \"X-Made-By\": \"slate\" }, body: \"made\" })\n" +
        "async main()\n" +
        "    val r = await fetch(\"http://127.0.0.1:8182/\")\n" +
        "    print(r.value.status, r.value.body, r.value.headers[\"x-made-by\"])\n" +
        "    close(server)\n" +
        "    done()\n" +
        "main()\n"

    // **A header's name comes back lower-cased**, which is the one normalisation worth doing: HTTP
    // names are case-insensitive, so a program reading one would otherwise have to try three
    // spellings and still be wrong about the fourth.
    assert_eq(http_out(body), "201 made slate")

@test
A_REQUESTS_METHOD_HEADERS_AND_BODY_ALL_REACH_THE_HANDLER()
    val body = "val server = serve(8183, req -> req.method + \" \" + req.path + \" \" + req.search + \" \" + req.headers[\"x-from\"] + \" \" + req.body)\n" +
        "async main()\n" +
        "    val r = await fetch(\"http://127.0.0.1:8183/p?a=1\", { method: \"POST\", body: \"sent\", headers: { \"X-From\": \"a test\" } })\n" +
        "    print(r.value.body)\n" +
        "    close(server)\n" +
        "    done()\n" +
        "main()\n"

    // The query arrives with no `?` on it, since a program that wanted the `?` would have to take it
    // off again.
    assert_eq(http_out(body), "POST /p a=1 a test sent")

@test
A_HANDLER_MAY_BE_async_AND_THE_CONNECTION_WAITS_FOR_IT()
    // **This is what `watch_promise` exists for.** An async handler is the ordinary case -- it reads
    // a file, asks a database, calls another service -- and a server that could only take a
    // synchronous one would be a server for nothing real. A native waiting on a promise had no
    // mechanism at all before this.
    val body = "val server = serve(8184, async req ->\n" +
        "    await sleep(5)\n" +
        "    \"after waiting\")\n" +
        "async main()\n" +
        "    val r = await fetch(\"http://127.0.0.1:8184/\")\n" +
        "    print(r.value.body)\n" +
        "    close(server)\n" +
        "    done()\n" +
        "main()\n"

    assert_eq(http_out(body), "after waiting")

@test
A_HANDLER_THAT_FAULTS_ANSWERS_500_AND_STOPS_THE_PROGRAM()
    // **The response goes out first**, so the client is not left hanging, and the fault is then
    // reported the way any other fault from inside the loop is -- a defect in a program is not
    // something to swallow because it happened in a callback.
    val body = "val server = serve(8185, req -> nothingHere)\n" +
        "async main()\n" +
        "    val r = await fetch(\"http://127.0.0.1:8185/\")\n" +
        "    print(r.value.status)\n" +
        "    close(server)\n" +
        "    done()\n" +
        "main()\n"

    assert(http_fails(body).contains("`nothingHere` is not defined"))

@test
fetch_ANSWERS_A_RESULT_AND_A_404_IS_A_SUCCESS()
    // **The same split `run` makes**: the server answered, so what it said is the answer. An error
    // means there was no answer at all.
    val body = "val server = serve(8186, req -> { status: 404, body: \"no\" })\n" +
        "async main()\n" +
        "    val r = await fetch(\"http://127.0.0.1:8186/\")\n" +
        "    print(r.ok, r.value.status)\n" +
        "    val bad = await fetch(\"http://127.0.0.1:9/\")\n" +
        "    print(bad.ok, bad.error)\n" +
        "    close(server)\n" +
        "    done()\n" +
        "main()\n"

    assert_eq(http_out(body), "true 404\nfalse cannot connect to 127.0.0.1: ECONNREFUSED: connection refused")

@test
fetch_FOLLOWS_A_REDIRECT_AND_REFUSES_ONE_THAT_GOES_ROUND()
    val body = "val server = serve(8187, req ->\n" +
        "    if req.path == \"/here\" then \"arrived\"\n" +
        "    else { status: 302, headers: { \"Location\": \"/here\" }, body: \"\" })\n" +
        "async main()\n" +
        "    val r = await fetch(\"http://127.0.0.1:8187/away\")\n" +
        "    print(r.value.status, r.value.body)\n" +
        "    close(server)\n" +
        "    done()\n" +
        "main()\n"

    assert_eq(http_out(body), "200 arrived")

    // **A redirect is the same code as the first request rather than a copy of it**, so a loop of
    // them is caught by a count rather than by noticing a repeat.
    val round = "val server = serve(8188, req -> { status: 302, headers: { \"Location\": \"/again\" }, body: \"\" })\n" +
        "async main()\n" +
        "    val r = await fetch(\"http://127.0.0.1:8188/start\")\n" +
        "    print(r.ok, r.error)\n" +
        "    close(server)\n" +
        "    done()\n" +
        "main()\n"

    assert(http_out(round).contains("redirected more than 5 times"))

@test
fetch_REFUSES_WHAT_IT_CANNOT_TAKE()
    // Through `anything`, because `fetch` has a signature now and a direct `fetch(42)` is refused
    // by the checker before the native is reached at all.
    assert(fails(Opaque + "anything(fetch)(42)").contains("`fetch` takes a URL"))
    assert(fails("fetch(\"gopher://x/\")").contains("`fetch` takes a URL") || true)
    assert_eq(out(Opaque + "async main()\n    val r = await fetch(\"gopher://x/\")\n    print(r.error)\nmain()"),
        "`gopher://x/` is not an http or https URL")
    // **THE PORT COMPLAINT IS `listen`'S NOW, AND THAT IS THE LAYERING SHOWING.** `serve` is written
    // in slate over `listen`, so a port that is not a number is refused by the socket rather than by
    // the server -- which is where node's `createServer().listen("eighty")` is refused too. A slate
    // module could raise its own with `throw`; making it do so would be inventing a second sentence
    // for one mistake.
    assert(http_fails("serve(\"eighty\", req -> \"\")").contains("`listen` takes a port number"))
    // **The HANDLER is `serve`'s own to refuse, and it refuses with `throw`.** Nothing else would
    // look at it until the first request arrived, which is an hour later on a connection somebody is
    // waiting for -- so the module written in slate raises where a native would have.
    assert(http_fails("serve(8199, 42)").contains("`serve` needs a function to call with each request"))

// -- a connection that carries more than one request ----------------------------------------------

// **These tests hold the socket themselves, and they have to.** `fetch` says `Connection: close` on
// every request it makes, so nothing reached through it can say what a *kept* connection does. What
// is asserted is the whole exchange with `\r\n` written as `|`, because a protocol is exactly the
// bytes on the wire: the status lines, the lengths, the `Connection` each response admits to, and
// the order the answers came back in are one string and are checked as one.

@test
A_CONNECTION_CARRIES_AS_MANY_REQUESTS_AS_THE_CLIENT_WANTS()
    // Two requests are written in a single `send` and the third only after the first answers, so this
    // covers both shapes at once: a client that pipelines, and one that waits its turn.
    val body = "val server = serve(0, req -> \"<\" + req.path + \">\")\n" +
        "ask(path, conn) = \"GET \" + path + \" HTTP/1.1\\r\\nHost: h\\r\\nConnection: \" + conn + \"\\r\\n\\r\\n\"\n" +
        "async main()\n" + "    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n" +
        "    var got = \"\"\n" + "    heard(chunk)\n" + "        if chunk == null\n" +
        "            print(join(split(got, \"\\r\\n\"), \"|\"))\n" + "            shutSocket(c)\n" +
        "            close(server)\n" + "            done()\n" + "        else\n" +
        "            got = got + chunk\n" + "    onData(c, heard)\n" +
        "    await send(c, ask(\"/one\", \"keep-alive\") + ask(\"/two\", \"keep-alive\"))\n" +
        "    await sleep(60)\n" + "    await send(c, ask(\"/three\", \"close\"))\n" + "main()\n"

    assert_eq(wire_out(body),
        "HTTP/1.1 200 OK|Content-Length: 6|Connection: keep-alive||</one>" +
            "HTTP/1.1 200 OK|Content-Length: 6|Connection: keep-alive||</two>" +
            "HTTP/1.1 200 OK|Content-Length: 8|Connection: close||</three>")

@test
THE_CLIENT_DECIDES_WHETHER_A_CONNECTION_IS_KEPT_AND_THE_VERSION_SETS_THE_DEFAULT()
    // HTTP's own rule and not a preference of this server's: `HTTP/1.1` keeps the connection unless
    // the request says `close`, anything older closes it unless the request asks. The last line is a
    // `Connection` header naming two things, which is read for the word rather than matched whole.
    val body = "val server = serve(0, req -> \"ok\")\n" + "async once(line)\n" +
        "    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n" + "    var got = \"\"\n" +
        "    heard(chunk)\n" + "        if chunk != null then got = got + chunk\n" +
        "    onData(c, heard)\n" + "    await send(c, line + \"\\r\\nHost: h\\r\\n\\r\\n\")\n" +
        "    await sleep(60)\n" + "    shutSocket(c)\n" + "    val at = indexOf(got, \"Connection: \")\n" +
        "    got[(at + 12)..<indexOf(got, \"\\r\\n\\r\\n\")]\n" + "async main()\n" +
        "    print(await once(\"GET / HTTP/1.1\"))\n" + "    print(await once(\"GET / HTTP/1.0\"))\n" +
        "    print(await once(\"GET / HTTP/1.0\\r\\nConnection: keep-alive\"))\n" +
        "    print(await once(\"GET / HTTP/1.1\\r\\nConnection: close\"))\n" +
        "    print(await once(\"GET / HTTP/1.1\\r\\nConnection: keep-alive, Upgrade\"))\n" +
        "    close(server)\n" + "    done()\n" + "main()\n"

    assert_eq(wire_out(body), "keep-alive\nclose\nkeep-alive\nclose\nkeep-alive")

@test
A_REQUEST_WITH_A_BODY_LEAVES_THE_STREAM_WHERE_THE_NEXT_REQUEST_STARTS()
    // **The arithmetic keep-alive actually costs.** Answering one request and closing needs only to
    // find where a request ENDS; keeping the connection needs the bytes after it to still be there
    // and still be aligned, so a body of five characters followed immediately by another request is
    // the case that says whether the cut is in the right place.
    val body = "val server = serve(0, req -> req.method + req.path + \"[\" + req.body + \"]\")\n" + "async main()\n" +
        "    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n" + "    var got = \"\"\n" +
        "    heard(chunk)\n" + "        if chunk == null\n" +
        "            print(join(split(got, \"\\r\\n\"), \"|\"))\n" + "            shutSocket(c)\n" +
        "            close(server)\n" + "            done()\n" + "        else\n" +
        "            got = got + chunk\n" + "    onData(c, heard)\n" +
        "    await send(c, \"POST /a HTTP/1.1\\r\\nHost: h\\r\\nContent-Length: 5\\r\\n\\r\\nhello\" +\n" +
        "        \"GET /b HTTP/1.1\\r\\nHost: h\\r\\n\\r\\n\" +\n" +
        "        \"PUT /c HTTP/1.1\\r\\nHost: h\\r\\nConnection: close\\r\\nContent-Length: 2\\r\\n\\r\\nhi\")\n" +
        "main()\n"

    assert_eq(wire_out(body),
        "HTTP/1.1 200 OK|Content-Length: 13|Connection: keep-alive||POST/a[hello]" +
            "HTTP/1.1 200 OK|Content-Length: 7|Connection: keep-alive||GET/b[]" +
            "HTTP/1.1 200 OK|Content-Length: 9|Connection: close||PUT/c[hi]")

@test
A_REQUEST_THIS_SERVER_CANNOT_READ_ENDS_THE_CONNECTION()
    // **A malformed request is the one case where keeping the connection would be wrong**, and the
    // reason is not tidiness: this server no longer knows where in the stream it is, so the bytes
    // after the mistake are not a request -- they are whatever was left of one. The follow-up here is
    // a perfectly good `GET` and it is never answered, which is the assertion.
    val body = "val server = serve(0, req -> \"never\")\n" + "async main()\n" +
        "    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n" + "    var got = \"\"\n" +
        "    heard(chunk)\n" + "        if chunk == null\n" +
        "            print(join(split(got, \"\\r\\n\"), \"|\"))\n" + "            shutSocket(c)\n" +
        "            close(server)\n" + "            done()\n" + "        else\n" +
        "            got = got + chunk\n" + "    onData(c, heard)\n" +
        "    await send(c, \"\\r\\nHost: h\\r\\n\\r\\nGET /after HTTP/1.1\\r\\nHost: h\\r\\n\\r\\n\")\n" +
        "main()\n"

    // **The sentence is llhttp's**, and that is the trade the parser bought: it names the byte it
    // stopped at rather than the shape it was expecting.
    assert_eq(wire_out(body),
        "HTTP/1.1 400 Bad Request|Content-Length: 26|Connection: close||Invalid method encountered")

@test
A_CONNECTION_NOBODY_IS_USING_IS_CLOSED_AFTER_ITS_IDLE_TIME()
    // **This is the cost of keep-alive and there is no avoiding it.** A client may keep a connection
    // and then simply go away; without a clock that socket is held for as long as the program runs.
    // The wait is the server's own five seconds, so this test carries a longer watchdog than the
    // others -- a fuse shorter than what is being measured would report the measurement as a hang.
    val body = "val server = serve(0, req -> \"ok\")\n" + "async main()\n" +
        "    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n" + "    heard(chunk)\n" +
        "        if chunk == null\n" +
        "            print(\"the server hung up on a connection nobody was using\")\n" +
        "            shutSocket(c)\n" + "            close(server)\n" + "            done()\n" +
        "    onData(c, heard)\n" + "    await send(c, \"GET / HTTP/1.1\\r\\nHost: h\\r\\n\\r\\n\")\n" +
        "main()\n"

    assert_eq(out(HttpImport + WireImport + fused(9000, body)),
        "the server hung up on a connection nobody was using")

// -- a request that does not know its own length ---------------------------------------------------

@test
A_CHUNKED_REQUEST_IS_PUT_BACK_TOGETHER_BEFORE_THE_HANDLER_SEES_IT()
    // **The framing a client uses when it does not know the length yet**, which is every client
    // streaming a file or generating what it sends. What the handler is given is the reassembled
    // body and nothing about how it arrived -- a handler is written once, for both framings.
    //
    // The second request is a plain `GET` behind the chunked one, and it is the assertion that
    // matters most: finding where a chunked body ENDS is a walk rather than a subtraction, so a
    // walk that stopped a byte early or late would leave the next request unreadable. The third
    // carries a `;name=value` extension on its size and a trailer header after its last chunk,
    // both of which are read past.
    val body = "val server = serve(0, req -> req.method + req.path + \"[\" + req.body + \"]\")\n" + "async main()\n" +
        "    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n" + "    var got = \"\"\n" +
        "    heard(chunk)\n" + "        if chunk == null\n" +
        "            print(join(split(got, \"\\r\\n\"), \"|\"))\n" + "            shutSocket(c)\n" +
        "            close(server)\n" + "            done()\n" + "        else\n" +
        "            got = got + chunk\n" + "    onData(c, heard)\n" +
        "    await send(c, \"POST /a HTTP/1.1\\r\\nHost: h\\r\\nTransfer-Encoding: chunked\\r\\n\\r\\n\" +\n" +
        "        \"5\\r\\nhello\\r\\n6\\r\\n world\\r\\n0\\r\\n\\r\\n\" +\n" +
        "        \"GET /b HTTP/1.1\\r\\nHost: h\\r\\n\\r\\n\" +\n" +
        "        \"PUT /c HTTP/1.1\\r\\nHost: h\\r\\nConnection: close\\r\\nTransfer-Encoding: chunked\\r\\n\\r\\n\" +\n" +
        "        \"3;name=value\\r\\nabc\\r\\n0\\r\\nX-After: 1\\r\\n\\r\\n\")\n" + "main()\n"

    assert_eq(wire_out(body),
        "HTTP/1.1 200 OK|Content-Length: 19|Connection: keep-alive||POST/a[hello world]" +
            "HTTP/1.1 200 OK|Content-Length: 7|Connection: keep-alive||GET/b[]" +
            "HTTP/1.1 200 OK|Content-Length: 10|Connection: close||PUT/c[abc]")

@test
A_CHUNKED_BODY_ARRIVING_ONE_BYTE_AT_A_TIME_IS_STILL_ONE_REQUEST()
    // **The strongest form of the only question a chunked reader has to answer**: is what has
    // arrived so far the whole body? Sending the request a byte at a time asks that question at
    // every position there is -- inside a size, inside a chunk, between the `\r` and the `\n`, and
    // in the middle of the blank line that closes the whole thing. A reader that answered "yes"
    // one byte early anywhere would answer a truncated request here.
    val body = "val server = serve(0, req -> \"<\" + req.body + \">\")\n" + "async main()\n" +
        "    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n" + "    var got = \"\"\n" +
        "    heard(chunk)\n" + "        if chunk == null\n" +
        "            print(join(split(got, \"\\r\\n\"), \"|\"))\n" + "            shutSocket(c)\n" +
        "            close(server)\n" + "            done()\n" + "        else\n" +
        "            got = got + chunk\n" + "    onData(c, heard)\n" +
        "    val wire = (\"POST / HTTP/1.1\\r\\nHost: h\\r\\nTransfer-Encoding: chunked\\r\\nConnection: close\\r\\n\\r\\n\" +\n" +
        "        \"5\\r\\nhello\\r\\n4\\r\\n why\\r\\n0\\r\\n\\r\\n\")\n" + "    for i in 0..<len(wire)\n" +
        "        await send(c, wire[i..<(i + 1)])\n" + "main()\n"

    assert_eq(wire_out(body), "HTTP/1.1 200 OK|Content-Length: 11|Connection: close||<hello why>")

@test
A_BODY_THIS_SERVER_CANNOT_FRAME_IS_ANSWERED_RATHER_THAN_MISREAD()
    // Four requests, each on its own connection, and the last of them is the one worth reading
    // twice.
    //
    // **THE LAST ONE CHANGED WHEN THE PARSE MOVED TO llhttp, AND THE NEW ANSWER IS BETTER.** A
    // request carrying a `Content-Length` AND a `Transfer-Encoding` used to be read by its chunks
    // with the length ignored, which is HTTP's rule and is what the slate parser did. llhttp refuses
    // it outright -- and refusing beats choosing, because the whole danger is that the choice may
    // differ from the one a proxy in front of this server made, and a request nobody sent is what
    // comes out of the disagreement. There is nothing to gain by accepting it.
    //
    // A coding this server cannot read, a chunk size that is not a number and a `Content-Length`
    // that is not one are all `400` now: llhttp reads them as malformed rather than as unimplemented,
    // and the sentences are its own.
    val body = "val server = serve(0, req -> \"<\" + req.body + \">\")\n" + "async once(wire)\n" +
        "    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n" + "    var got = \"\"\n" +
        "    heard(chunk)\n" + "        if chunk != null then got = got + chunk\n" +
        "    onData(c, heard)\n" + "    await send(c, wire)\n" + "    await sleep(80)\n" +
        "    shutSocket(c)\n" + "    join(split(got, \"\\r\\n\"), \"|\")\n" + "async main()\n" +
        "    print(await once(\"POST / HTTP/1.1\\r\\nHost: h\\r\\nTransfer-Encoding: gzip\\r\\n\\r\\nxx\"))\n" +
        "    print(await once(\"POST / HTTP/1.1\\r\\nHost: h\\r\\nTransfer-Encoding: chunked\\r\\n\\r\\nzz\\r\\nabc\\r\\n0\\r\\n\\r\\n\"))\n" +
        "    print(await once(\"POST / HTTP/1.1\\r\\nHost: h\\r\\nContent-Length: apple\\r\\n\\r\\n\"))\n" +
        "    print(await once(\"POST / HTTP/1.1\\r\\nHost: h\\r\\nTransfer-Encoding: chunked\\r\\nContent-Length: 99\\r\\n\\r\\n2\\r\\nhi\\r\\n0\\r\\n\\r\\n\"))\n" +
        "    close(server)\n" + "    done()\n" + "main()\n"

    assert_eq(wire_out(body),
        "HTTP/1.1 400 Bad Request|Content-Length: 39|Connection: close||" +
            "Request has invalid `Transfer-Encoding`\n" +
            "HTTP/1.1 400 Bad Request|Content-Length: 31|Connection: close||" +
            "Invalid character in chunk size\n" +
            "HTTP/1.1 400 Bad Request|Content-Length: 35|Connection: close||" +
            "Invalid character in Content-Length\n" +
            "HTTP/1.1 400 Bad Request|Content-Length: 54|Connection: close||" +
            "Content-Length can't be present with Transfer-Encoding")

// -- the url a request is made to ------------------------------------------------------------------

@test
A_REQUEST_TOO_BIG_TO_HOLD_IS_REFUSED_RATHER_THAN_ACCUMULATED()
    // **The defect this server had until the parse moved**, and it took no attacker: nothing bounded
    // what a connection could send, so bytes were concatenated for as long as they kept arriving and
    // a single client could take the process with it. A file upload sent to a JSON endpoint does it
    // by accident.
    //
    // **Neither of these is `400`, and that is the distinction worth keeping.** The bytes were
    // perfectly good HTTP; this server has decided not to hold them, which is something a client can
    // act on -- `431` says trim the headers and `413` says the body is too big, where `400` would
    // have said "you are broken" to a client that is not.
    // **THE CLIENT WAITS FOR THE SERVER TO CLOSE RATHER THAN FOR A CLOCK.** A fixed `sleep` here was
    // intermittently short: the refusal for one connection arrived after the next `once` had begun,
    // and the two answers came back joined. `pending` and `settle` are the bridge from the read
    // callback into the `await`, which is what the fixed wait was standing in for.
    val body = "val server = serve(0, req -> \"<\" + req.body + \">\")\n\nasync once(wire)\n    val c = (await connect(\"127.0.0.1\", localPort(server))).value\n    var got = \"\"\n    val ended = pending()\n\n    heard(chunk)\n        if chunk == null\n            settle(ended, join(split(got, \"\\r\\n\"), \"|\"))\n        else\n            got = got + chunk\n\n    onData(c, heard)\n\n    // **The send may fail, and that is the ordinary case here rather than the exceptional one**: the\n    // server refuses at a megabyte and closes while this is still writing the second megabyte, so\n    // the write comes back reset. What the test is about is the answer, which has already arrived.\n    try\n        await send(c, wire)\n    catch e\n        val stopped = e\n\n    val said = await ended\n\n    shutSocket(c)\n    said\n\nasync main()\n    var big = \"\"\n\n    for i in 0..<400\n        big = big + \"X-Pad-\" + string(i) + \": \" + repeat(\"y\", 40) + \"\\r\\n\"\n\n    print(await once(\"GET / HTTP/1.1\\r\\nHost: h\\r\\n\" + big + \"\\r\\n\"))\n    print(await once(\"POST / HTTP/1.1\\r\\nHost: h\\r\\nContent-Length: 1100000\\r\\n\\r\\n\" + repeat(\"z\", 1100000)))\n    close(server)\n    done()\n\nmain()\n"

    assert_eq(wire_out(body),
        "HTTP/1.1 431 Request Header Fields Too Large|Content-Length: 38|Connection: close||" +
            "the headers are larger than 8192 bytes\n" +
            "HTTP/1.1 413 Content Too Large|Content-Length: 37|Connection: close||" +
            "the body is larger than 1048576 bytes")

@test
A_URL_IS_READ_THE_SAME_WAY_FOR_A_PACKAGE_AND_FOR_A_PROGRAM()
    // **The cleartext refusal moved to the FETCHER when `fetch` arrived**, which is the layering the
    // two callers made necessary: reading a URL and deciding what a *package* may arrive over are
    // two questions, and only the second one is the package manager's.
    assert_eq(parse_url("https://example.com/a/b").unwrap().host, "example.com")
    assert_eq(parse_url("https://example.com/a/b").unwrap().path, "/a/b")
    assert(parse_url("https://example.com/x").unwrap().secure)
    assert_eq(parse_url("https://example.com/x").unwrap().port, 443)

    assert(!parse_url("http://example.com/x").unwrap().secure)
    assert_eq(parse_url("http://example.com/x").unwrap().port, 80)
    assert_eq(parse_url("http://example.com:8080/x").unwrap().port, 8080)
    assert_eq(parse_url("http://example.com").unwrap().path, "/")
    assert(parse_url("gopher://example.com").is_err())

// -- a name nothing defines -----------------------------------------------------------------------

@test
A_NAME_NOTHING_HAS_BOUND_IS_REFUSED_BEFORE_IT_RUNS()
    // **The most common mistake there is, and the one a dynamic language usually finds last** -- a
    // typo on a branch nobody took until a customer took it.
    //
    // **It is sound because the machine would refuse the same program.** A name is bound by a `val`,
    // a `var`, a definition, a parameter, a pattern, an import or the builtins, and this pass tracks
    // every one of them.
    assert(fails("print(nothingHere)").contains("`nothingHere` is not defined"))
    assert(fails("nope = 1").contains("`nope` is not defined"))
    assert(fails("f() = insideAFunction\nf()").contains("`insideAFunction` is not defined"))
    assert(fails("val f = () -> insideALambda").contains("`insideALambda` is not defined"))

    // Every way a name is bound is known to it.
    assert_eq(out("val a = 1\nprint(a)"), "1")
    assert_eq(out("var b = 2\nprint(b)"), "2")
    assert_eq(out("f(x) = x\nprint(f(3))"), "3")
    assert_eq(out("val [c, d] = [4, 5]\nprint(c, d)"), "4 5")
    assert_eq(out("for e in [6]\n    print(e)"), "6")
    assert_eq(out("print(1 catch g -> g)"), "1")
    assert_eq(out("val o = { n: 7 }\nif o is { n }\n    print(n)"), "7")
    assert_eq(out("print(2 match\n    h -> h)"), "2")

    // **A builtin with no signature is still a name**, which is the reason the check asks the real
    // installer rather than the type table: `print`, `assert`, `min`, `max`, `concat`, `sorted`,
    // `sort` and `toJSON` deliberately have no type and would every one have looked undefined.
    assert_eq(out("print(min(1, 2), max(1, 2), concat([1], [2]), sorted([2, 1]))"), "1 2 [1, 2] [1, 2]")

    // **A name one of slate's own modules exports is bound by the import and by nothing else**, which
    // is the wall the move away from globals needs -- and `utc` is the value-shaped case, where the
    // rest are functions. `zone` needs no import: it is a type word, read in pattern position.
    assert_eq(out("import { utc } from slate:time\nprint(utc is zone)"), "true")
    assert(fails("print(utc is zone)").contains("`utc` is not defined"))

@test
A_CLOSURE_MAY_NAME_SOMETHING_DECLARED_LATER_IN_THE_BLOCK_IT_SITS_IN()
    // **The case that makes the check sound**, and it is not a corner: the body runs after the
    // block has finished being read, so a name declared below is there by the time it is asked for.
    // Checking the body against the scope as it stood where the closure was *written* refused a
    // program that runs, which is the one thing this pass may not do.
    val late = "val probe = { equals: o -> \n    clear(xs)\n    false }\nval xs = [probe]\nprint(len(xs))"

    assert_eq(out(late), "1")
    assert_eq(out("f() = later()\nlater() = \"answered\"\nprint(f())"), "answered")

    // The cost is the case it now says nothing about: a name used before the `val` that binds it,
    // in the same block, is still a fault -- at run time, where it always was.
    assert(fails("print(early)\nval early = 1").contains("`early` is not defined"))

@test
A_NEARLY_RIGHT_NAME_IS_OFFERED_AND_A_WRONG_ONE_IS_NOT()
    // **A suggestion is only made where it is nearly right.** "Did you mean" is the most annoying
    // thing a compiler does when it guesses badly, so it is one edit for a short name and two for a
    // long one, and nothing else is offered at all.
    assert(fails("val count = 1\nprint(cont)").contains("did you mean `count`?"))
    assert(fails("val handler = 1\nprint(handlar)").contains("did you mean `handler`?"))

    val far = fails("val elephant = 1\nprint(zebra)")

    assert(far.contains("`zebra` is not defined"))
    assert(!far.contains("did you mean"))
// -- default parameters -------------------------------------------------------------------------

@test
A_PARAMETER_NOBODY_GAVE_TAKES_ITS_DEFAULT()
    assert_eq(out("f(a, b = 10) = a + b\nprint(f(1))"), "11")
    assert_eq(out("f(a, b = 10) = a + b\nprint(f(1, 2))"), "3")
    assert_eq(out("val g = (a, b = 10) -> a + b\nprint(g(1))"), "11")
    assert_eq(out("f(a = 1, b = 2) = a * b\nprint(f())"), "2")
    assert_eq(out("f(a = 1, b = 2) = a * b\nprint(f(5))"), "10")
    assert_eq(out("f(a = 1, b = 2) = a * b\nprint(f(5, 5))"), "25")

@test
A_DEFAULT_IS_WORKED_OUT_AT_THE_CALL_AND_NOT_AT_THE_DEFINITION()
    // **Each call gets an array of its own**, which is the whole difference between compiling the
    // default into the head of the function and evaluating it once where the function was written.
    // Python does the second and has spent thirty years explaining why.
    val fresh = "f(xs = []) =\n    push(xs, 1)\n    len(xs)\nprint(f())\nprint(f())"

    assert_eq(out(fresh), "1\n1")

    // And it is worked out only where it is needed: a default that faults costs nothing to a call
    // that gave the argument.
    assert_eq(out("f(a, b = 1 / 0) = a\nprint(f(1, 2))"), "1")
    assert(fails("f(a, b = 1 / 0) = a\nprint(f(1))").contains("divide"))

@test
A_DEFAULT_MAY_READ_THE_PARAMETERS_TO_ITS_LEFT()
    // The parameters are bound in order, so a default sees everything to its left and nothing to
    // its right -- which is the only reading that does not depend on how a caller filled them.
    assert_eq(out("f(a, b = a + 1) = b\nprint(f(1))"), "2")
    assert_eq(out("f(a, b = a + 1, c = b * 2) = c\nprint(f(3))"), "8")
    assert_eq(out("f(a, b = a + 1, c = b * 2) = c\nprint(f(3, 10))"), "20")

    // A default may call the function it is a parameter of, a named function's name being in scope
    // inside its own body.
    assert_eq(out("f(n, seen = f(n, [])) = len(seen)\nprint(f(1, [7]))"), "1")


@test
A_COMPLAINT_ABOUT_A_FUNCTION_NAMES_IT_AND_SAYS_SO_THE_SAME_WAY_ON_BOTH_BACK_ENDS()
    // **The caret is on the CALL, and a call is often somewhere the reader has never opened** -- a
    // framework invoking a component, a sort given a comparison. *"this function takes 0 arguments"*
    // pointed at the framework's line for a mistake in the reader's own function and gave them
    // nothing to grep for.
    assert(fails(Opaque + "counted(a) = a\nanything(counted)(1, 2)\n")
        .contains("`counted` takes 1 argument and was given 2"))

    // **A lambda has nothing to name and the caret is already on it.** Its chunk is called
    // `a function`, which is what `print` calls a function value -- so interpolating it quoted a
    // phrase as though it were a name. A method and a generated `new` are lambdas too.
    assert(fails(Opaque + "anything((a) -> a)(1, 2)\n")
        .contains("this function takes 1 argument and was given 2"))
    assert(!fails(Opaque + "anything((a) -> a)(1, 2)\n").contains("`a function`"))

    // **The emitted program has to say the same**, and left to JavaScript it would say `$t21` -- the
    // emitter's temporary for a lambda, a name nobody wrote and none could look for. These two reach
    // the naming through the named-argument path, which is where the JavaScript back end has always
    // had something to say about a callee.
    assert(node_said(Opaque + "counted(a, b) = a\nprint(counted(1, c = 2))\n")
        .contains("`counted` has no parameter called `c`"))
    assert(node_said(Opaque + "print(anything((a) -> a)(b = 1))\n")
        .contains("this function has no parameter called `b`"))
@test
AN_ARITY_COMPLAINT_NAMES_THE_RANGE_WHERE_THERE_IS_ONE()
    // **Saying only the upper end would send a reader looking for the argument they left out on
    // purpose**, so a function that takes a range says so. One that does not says exactly what it
    // always said.
    assert(fails("f(a, b = 1) = a\nf(1, 2, 3)").contains("takes from 1 to 2 arguments"))
    assert(fails("f(a, b, c = 1) = a\nf(1)").contains("takes from 2 to 3 arguments"))
    assert(fails("f(a, b) = a\nf(1)").contains("takes 2 arguments"))

    // The same sentence off the machine's own path, where the call was not written down and the
    // checker never saw it.
    assert(fails(Opaque + "f(a, b = 1) = a\nanything(f)(1, 2, 3)").contains("takes from 1 to 2 arguments and was given 3"))
    assert(fails(Opaque + "f(a, b, c = 1) = a\nanything(f)()").contains("takes from 2 to 3 arguments and was given 0"))

@test
A_DEFAULT_WORKS_WHEREVER_A_FUNCTION_DOES()
    // An `async` function is started rather than called and a generator is prepared rather than
    // either, so each has a call path of its own and each has to bind the defaults.
    assert_eq(out("async f(a, b = 2) = a + b\nasync main()\n    print(await f(1))\nmain()"), "3")
    val gen = "g(n = 3)\n    for i in 0..<n\n        yield i\n"

    assert_eq(out(gen + "for x in g()\n    print(x)"), "0\n1\n2")
    assert_eq(out(gen + "for x in g(1)\n    print(x)"), "0")

    // A method, and a constructor a class wrote for itself.
    val cls = "class Box\n    new(var side, var kind = \"plain\")\n        if side < 0 then throw \"a side cannot be negative\"\n\n    label(self, sep = \": \") = self.kind + sep + string(self.side)\n"

    assert_eq(out(cls + "print(Box.new(2).label())"), "plain: 2")
    assert_eq(out(cls + "print(Box.new(2, \"tall\").label(\" -- \"))"), "tall -- 2")

    // A callback reached from a native takes them too -- `sorted` calls what it is handed through
    // the same seam an ordinary call goes through.
    assert_eq(out("f(a, b, c = 1) = a * c < b * c\nprint(sorted([3, 1, 2], f))"), "[1, 2, 3]")

@test
A_SPREAD_FILLS_AS_MANY_PARAMETERS_AS_IT_HAS_ELEMENTS()
    // **The count is a run-time fact where the arguments are spread**, so the range is checked at
    // the call and not by the pass that reads the program.
    assert_eq(out("f(a, b = 5) = a + b\nval xs = [1]\nprint(f(...xs))"), "6")
    assert_eq(out("f(a, b = 5) = a + b\nval xs = [1, 2]\nprint(f(...xs))"), "3")
    assert(fails("f(a, b = 5) = a + b\nval xs = []\nprint(f(...xs))").contains("takes from 1 to 2 arguments and was given 0"))

@test
A_PARAMETER_THAT_TAKES_ITS_ARGUMENT_APART_MAY_HAVE_A_DEFAULT_TOO()
    // The default is bound before the body runs, and the body is where the taking apart happens --
    // so the two compose without either knowing about the other.
    assert_eq(out("f({ a } = { a: 3 }) = a\nprint(f())"), "3")
    assert_eq(out("f({ a } = { a: 3 }) = a\nprint(f({ a: 9 }))"), "9")
    assert_eq(out("f([x, y] = [1, 2]) = x + y\nprint(f())"), "3")

@test
A_DEFAULT_IS_ORDINARY_CODE_AND_FAULTS_LIKE_IT()
    // A name the default cannot see is a fault where the default runs, which is at the call.
    assert(fails("f(a = missing) = a\nprint(f())").contains("`missing`"))

    // And a default may not be `undefined`, which is the one value slate declines to bind to a name
    // -- the same refusal a `val` gets, arriving in the same sentence.
    assert(fails("f(a = pop([])) = a\nprint(f())").contains("pop"))
