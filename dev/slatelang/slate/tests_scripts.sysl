module dev.slatelang.slate
@tests

import sh.sysl.libuv
import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, read_bytes, write_text}
import sysl.text.{Search, from_utf8_unchecked}

// `slate run` -- the scripts a project declares, the three things one may be, and the rule that
// nothing else ever evaluates a manifest.
//
// **Every test here goes in through `run_in_project`, which writes a real directory and types the
// command inside it.** That is not ceremony: `slate run` finds the project by walking up from where
// a person is standing, so a helper that ran it from the repository root would find slate's own
// manifest -- and a helper built on a source made up in memory would be testing neither the walk nor
// the file a `.sl` script names.

// -- a function ---------------------------------------------------------------------------------------

@test
A_SCRIPT_THAT_ANSWERS_AN_INTEGER_LEAVES_THAT_STATUS_AND_ONE_THAT_ANSWERS_NOTHING_LEAVES_ZERO()
    // **The integer is a status and anything else is success**, so a script whose last line happens
    // to be a `print` does not hand the shell whatever `print` came to.
    val (zero, _, a) = run_in_project(DemoManifest, [], [], "", ["ok"])

    scrub(a)
    assert_eq(zero, 0)

    val (three, _, b) = run_in_project(DemoManifest, [], [], "", ["three"])

    scrub(b)
    assert_eq(three, 3)

    val (said_nothing, said, c) = run_in_project(DemoManifest, [], [], "", ["quiet"])

    scrub(c)
    assert_eq(said, "hushed")
    assert_eq(said_nothing, 0)

@test
A_FUNCTION_SCRIPT_IS_HANDED_WHAT_CAME_AFTER_ITS_NAME()
    // One parameter and not one per word: what a person typed is an array, in the order they typed
    // it, and a script that wants none of it declares none.
    val (status, said, dir) = run_in_project(DemoManifest, [], [], "", ["shout", "ed", "and", "co"])

    scrub(dir)
    assert_eq(said, "[\"ed\", \"and\", \"co\"]")
    assert_eq(status, 0)

@test
A_SCRIPT_THAT_FAULTS_LEAVES_ONE_AND_THE_SENTENCE_THAT_SAYS_WHY()
    val (status, said, dir) = run_in_project(DemoManifest, [], [], "", ["boom"])

    scrub(dir)

    // The caret is drawn against the manifest, which is the file the script was written in.
    assert(said.contains("the index 9 is outside an array of 0"))
    assert(said.contains("package.sl"))
    assert_eq(status, 1)

@test
AN_async_SCRIPT_IS_AWAITED_AND_ITS_ANSWER_IS_STILL_THE_STATUS()
    // **Awaited rather than read straight off**, or every asynchronous script would answer a promise
    // and leave zero whatever it came to.
    val (status, _, dir) = run_in_project(DemoManifest, [], [], "", ["later"])

    scrub(dir)
    assert_eq(status, 5)

@test
AN_async_SCRIPT_THAT_REJECTS_IS_A_FAILURE_WITH_THE_ORDINARY_REPORT()
    val (status, said, dir) = run_in_project(DemoManifest, [], [], "", ["badly"])

    scrub(dir)
    assert(said.contains("the index 9 is outside an array of 0"))
    assert_eq(status, 1)

// -- a slate file ---------------------------------------------------------------------------------------

@test
A_FIRST_WORD_ENDING_IN_sl_NAMES_A_PROGRAM_AND_THE_REST_ARE_ITS_ARGUMENTS()
    // **The script's own words first, then what the command line added**, which is the order a
    // person writing `slate run deploy extra` means: the manifest said `--fast` and they said one
    // more thing after it.
    val (status, said, dir) = run_in_project(DemoManifest, ["job.sl"], [JobFile], "", ["deploy", "extra"])

    scrub(dir)
    assert_eq(said, "[\"--fast\", \"extra\"]")
    assert_eq(status, 0)

@test
A_FILE_SCRIPT_LEAVES_THE_STATUS_ITS_PROGRAM_ASKED_FOR()
    val (status, _, dir) = run_in_project(DemoManifest, ["quit.sl"], [QuitFile], "", ["stop"])

    scrub(dir)
    assert_eq(status, 6)

@test
A_FILE_A_SCRIPT_NAMES_IS_FOUND_BESIDE_THE_MANIFEST_AND_NOT_BESIDE_THE_PERSON()
    // A path is the project's, so it means the same thing from anywhere under it. The file that is
    // not there gets the driver's own sentence rather than a shell's.
    val (status, said, dir) = run_in_project(DemoManifest, [], [], "", ["deploy"])

    scrub(dir)
    assert(said.contains("cannot read"))
    assert(said.contains("job.sl"))
    assert_eq(status, 1)

// -- a command line -------------------------------------------------------------------------------------

@test
ANY_OTHER_STRING_IS_A_COMMAND_LINE_AND_A_SHELL_RUNS_IT()
    val (status, _, dir) = run_in_project(DemoManifest, [], [], "", ["write"])
    val wrote = from_utf8_unchecked(read_bytes(s"${dir}/out.txt").unwrap())

    scrub(dir)
    assert_eq(wrote, "hi\n")
    assert_eq(status, 0)

@test
A_COMMAND_LINE_LEAVES_THE_STATUS_THE_SHELL_LEFT()
    val (fine, _, a) = run_in_project(DemoManifest, [], [], "", ["have", "package.sl"])

    scrub(a)
    assert_eq(fine, 0)

    val (missing, _, b) = run_in_project(DemoManifest, [], [], "", ["have", "nothing.txt"])

    scrub(b)
    assert_eq(missing, 1)

@test
AN_ARGUMENT_APPENDED_TO_A_COMMAND_LINE_IS_QUOTED_SO_A_SPACE_STAYS_ONE_ARGUMENT()
    // **The line is the author's text and an argument is a value**, so a file name with a space in
    // it reaches `test -f` as one word rather than as two.
    val (status, _, dir) = run_in_project(DemoManifest, ["a b.txt"], ["x"], "", ["have", "a b.txt"])

    scrub(dir)
    assert_eq(status, 0)

// -- listing and refusing --------------------------------------------------------------------------------

@test
slate_run_WITH_NO_NAME_LISTS_WHAT_THE_PROJECT_DECLARED()
    val (status, said, dir) = run_in_project(ListingManifest, ["job.sl"], [JobFile], "", [])

    scrub(dir)

    // A function is its name and nothing else; a command line is its own description; a slate file's
    // first comment line is one read away, so that is what is shown instead of the path.
    assert_eq(said, "ok\ndeploy  // what a job says it does\nwrite  echo hi > out.txt")
    assert_eq(status, 0)

@test
A_NAME_THE_PROJECT_DOES_NOT_DECLARE_IS_REFUSED_NAMING_THE_ONES_IT_DOES()
    val (status, said, dir) = run_in_project(ListingManifest, [], [], "", ["nosuch"])

    scrub(dir)
    assert(said.contains("no script called `nosuch`"))
    assert(said.contains("`ok`"))
    assert(said.contains("`deploy`"))

    // **Two and not one**: slate could not work out what it was asked for, which a shell script has
    // to tell from the script itself having failed.
    assert_eq(status, 2)

@test
A_PROJECT_THAT_DECLARES_NO_SCRIPTS_SAYS_SO_RATHER_THAN_SAYING_NOTHING()
    val (status, said, dir) = run_in_project(BareManifest, [], [], "", [])

    scrub(dir)
    assert_eq(said, "this project declares no scripts")
    assert_eq(status, 0)

// -- and nothing else ever evaluates a manifest ------------------------------------------------------------

@test
A_FUNCTION_IN_A_MANIFEST_IS_READ_AS_DATA_AND_RESOLUTION_RUNS_NONE_OF_IT()
    // **`slate deps` resolves the whole graph and the manifest reader is what it goes through.** The
    // script here prints the moment it is called, so the proof is that nothing printed it: the
    // restriction pass skipped the function rather than refusing it, and nothing ran it.
    val dir = project_at(NoisyManifest)
    val (status, said) = cache_run(["slate", "deps", dir])

    scrub(dir)
    assert(!said.contains("RAN"))
    assert(said.contains("kit 1.0.0"))
    assert_eq(status, 0)

@test
A_MANIFEST_HOLDING_A_FUNCTION_IS_STILL_A_PROJECT_THE_READER_CAN_READ()
    // The data reader answers the same project it always did, the `scripts` block being recorded as
    // nothing at all.
    assert_eq(proj(NoisyManifest), "kit-user 0.1.0 kit@1.0.0<-github.com/example/kit")

@test
A_FUNCTION_WRITTEN_ANYWHERE_BUT_UNDER_scripts_IS_STILL_REFUSED()
    // **The hole is one key wide.** A manifest is data, and the one place code may be written is the
    // block whose whole purpose is to hold some.
    assert(proj_said("{ name: \"a\", version: \"1\", main: (x) -> x }").contains("this is a function"))
    assert(proj_said("{ name: \"a\", version: \"1\", main: (x) -> x }").contains("under `scripts`"))

@test
A_DEPENDENCY_S_SCRIPTS_ARE_NEVER_READ_AND_NEVER_RUN()
    // A package's own scripts are its own. Nothing a project installs can put a line in front of
    // `slate run`, and `slate run` with no name lists the project's and only the project's.
    val cache = loud_cache()
    val (status, said, dir) = run_in_project(LoudManifest, [], [], cache, [])

    scrub(dir)
    scrub(cache)
    assert(!said.contains("RAN"))
    assert(!said.contains("evil"))
    assert(said.contains("ok"))
    assert_eq(status, 0)

@test
A_SCRIPT_MAY_IMPORT_ONE_OF_THE_PROJECT_S_DEPENDENCIES()
    // **The manifest is compiled in the project's own context**, so what a script runs resolves the
    // packages the project declared exactly as any other program in it would.
    val (status, said, dir) = run_in_project(KitManifest, ["use.sl"], [UsesKitFile], "tests/cache", ["show"])

    scrub(dir)
    assert_eq(said, "base")
    assert_eq(status, 0)

// -- a manifest may open with `import` lines ---------------------------------------------------------------

@test
A_MANIFEST_MAY_OPEN_WITH_AN_IMPORT_AND_A_SCRIPT_MAY_USE_WHAT_IT_IMPORTED()
    // **The imports bind in the manifest's own scope**, so a function script reaches `run` exactly as
    // any program that wrote the same import would -- `slate run` evaluates the manifest as it does
    // today, and nothing about `scripts` changes for it.
    val (status, _, dir) = run_in_project(ProcessImportManifest, [], [], "", ["echoed"])

    scrub(dir)
    assert_eq(status, 0)

@test
A_MANIFEST_S_IMPORT_MAY_NAME_ONE_OF_THE_PROJECT_S_OWN_DEPENDENCIES()
    // The import at the top of the manifest resolves in the project's own context exactly as `use.sl`
    // does above -- so a function script may call straight into a dependency with no file of its own.
    val (status, said, dir) = run_in_project(KitImportManifest, [], [], "tests/cache", ["show"])

    scrub(dir)
    assert_eq(said, "base")
    assert_eq(status, 0)

@test
RESOLUTION_OVER_A_MANIFEST_WITH_IMPORTS_READS_EXACTLY_AS_WITHOUT_THEM()
    // **The reader skips the imports rather than resolving them**, so a manifest opening with one
    // resolves its dependencies exactly as `A_FUNCTION_IN_A_MANIFEST_IS_READ_AS_DATA...` above did for
    // `scripts` -- and the marker proves nothing ran.
    val dir = project_at(NoisyImportManifest)
    val (status, said) = cache_run(["slate", "deps", dir])

    scrub(dir)
    assert(!said.contains("RAN"))
    assert(said.contains("kit 1.0.0"))
    assert_eq(status, 0)

@test
AN_IMPORT_AFTER_THE_OBJECT_IS_REFUSED()
    // An import is welcome only ahead of the object -- one written below it is the "second statement"
    // the reader has always refused, now said in words that name both halves of the new shape.
    val said = proj_said("{ name: \"a\", version: \"1\" }\nimport { run } from slate:process\n")

    assert(said.contains("a manifest is imports, then one object"))
    assert(said.contains("a second statement after it"))

@test
A_STATEMENT_THAT_IS_NOT_AN_IMPORT_BEFORE_THE_OBJECT_IS_REFUSED()
    // Only `import` may stand ahead of the object -- an ordinary statement there is refused exactly as
    // one written after it would be.
    val said = proj_said("val x = 1\n{ name: \"a\", version: \"1\" }\n")

    assert(said.contains("a manifest is imports, then one object"))

@test
AN_IMPORT_OF_AN_UNKNOWN_PACKAGE_RESOLVES_FINE_AND_FAILS_ONLY_UNDER_slate_run()
    // **Resolution never asks what the import names**, the reader skipping it exactly as it skips a
    // known one -- `slate deps` sees only `dependencies`, which this manifest declares none of.
    // `slate run` is the one place that evaluates the file for real, and that is where a name nothing
    // has said the project depends on is refused, in the ordinary sentence.
    val depsDir = project_at(UnknownImportManifest)
    val (deps_status, _) = cache_run(["slate", "deps", depsDir])

    scrub(depsDir)
    assert_eq(deps_status, 0)

    val (status, said, dir) = run_in_project(UnknownImportManifest, [], [], "", [])

    scrub(dir)
    assert(said.contains("nothing this project depends on is called `ghost`"))
    assert_eq(status, 1)

// -- the fixtures ------------------------------------------------------------------------------------------

// A cache holding one package whose manifest declares a script that would announce itself.
private loud_cache() -> string
    val dir = libuv.mkdtemp_sync("/tmp/slate-cache-XXXXXX").unwrap()
    val home = s"${dir}/github.com/example/loudly/@v1.0.0"

    make_dir_all(home).unwrap()
    write_text(s"${home}/package.sl",
        "{\n" +
        "    name: \"loudly\",\n" +
        "    version: \"1.0.0\",\n" +
        "    main: \"loudly.sl\",\n" +
        "\n" +
        "    scripts: {\n" +
        "        evil: (args) -> print(\"RAN\"),\n" +
        "    },\n" +
        "}\n").unwrap()
    write_text(s"${home}/loudly.sl", "export nothing() = 1\n").unwrap()
    dir
end loud_cache

private val DemoManifest: string =
    "{\n" +
    "    name: \"demo\",\n" +
    "    version: \"0.1.0\",\n" +
    "\n" +
    "    scripts: {\n" +
    "        ok: (args) -> 0,\n" +
    "        three: (args) -> 3,\n" +
    "        quiet: (args) -> print(\"hushed\"),\n" +
    "        shout: (args) -> print(args),\n" +
    "        boom: (args) -> args[9],\n" +
    "        later: async (args) -> 5,\n" +
    "        badly: async (args) -> args[9],\n" +
    "        deploy: \"job.sl --fast\",\n" +
    "        stop: \"quit.sl\",\n" +
    "        write: \"echo hi > out.txt\",\n" +
    "        have: \"test -f\",\n" +
    "    },\n" +
    "}\n"

private val ListingManifest: string =
    "{\n" +
    "    name: \"demo\",\n" +
    "    version: \"0.1.0\",\n" +
    "\n" +
    "    scripts: {\n" +
    "        ok: (args) -> 0,\n" +
    "        deploy: \"job.sl\",\n" +
    "        write: \"echo hi > out.txt\",\n" +
    "    },\n" +
    "}\n"

private val BareManifest: string = "{ name: \"demo\", version: \"0.1.0\" }\n"

private val NoisyManifest: string =
    "{\n" +
    "    name: \"kit-user\",\n" +
    "    version: \"0.1.0\",\n" +
    "\n" +
    "    dependencies: {\n" +
    "        kit: { git: \"github.com/example/kit\", version: \"1.0.0\" },\n" +
    "    },\n" +
    "\n" +
    "    scripts: {\n" +
    "        evil: (args) -> print(\"RAN\"),\n" +
    "    },\n" +
    "}\n"

private val LoudManifest: string =
    "{\n" +
    "    name: \"demo\",\n" +
    "    version: \"0.1.0\",\n" +
    "\n" +
    "    dependencies: {\n" +
    "        loudly: { git: \"github.com/example/loudly\", version: \"1.0.0\" },\n" +
    "    },\n" +
    "\n" +
    "    scripts: {\n" +
    "        ok: (args) -> 0,\n" +
    "    },\n" +
    "}\n"

private val KitManifest: string =
    "{\n" +
    "    name: \"demo\",\n" +
    "    version: \"0.1.0\",\n" +
    "\n" +
    "    dependencies: {\n" +
    "        kit: { git: \"github.com/example/kit\", version: \"1.0.0\" },\n" +
    "    },\n" +
    "\n" +
    "    scripts: {\n" +
    "        show: \"use.sl\",\n" +
    "    },\n" +
    "}\n"

private val ProcessImportManifest: string =
    "import { run } from slate:process\n" +
    "\n" +
    "{\n" +
    "    name: \"demo\",\n" +
    "    version: \"0.1.0\",\n" +
    "\n" +
    "    scripts: {\n" +
    "        echoed: async (args) -> (await run(\"echo\", [\"hi\"])).value.status,\n" +
    "    },\n" +
    "}\n"

private val KitImportManifest: string =
    "import { base } from kit\n" +
    "\n" +
    "{\n" +
    "    name: \"demo\",\n" +
    "    version: \"0.1.0\",\n" +
    "\n" +
    "    dependencies: {\n" +
    "        kit: { git: \"github.com/example/kit\", version: \"1.0.0\" },\n" +
    "    },\n" +
    "\n" +
    "    scripts: {\n" +
    "        show: (args) -> print(base()),\n" +
    "    },\n" +
    "}\n"

private val NoisyImportManifest: string =
    "import { run } from slate:process\n" +
    "\n" +
    "{\n" +
    "    name: \"kit-user\",\n" +
    "    version: \"0.1.0\",\n" +
    "\n" +
    "    dependencies: {\n" +
    "        kit: { git: \"github.com/example/kit\", version: \"1.0.0\" },\n" +
    "    },\n" +
    "\n" +
    "    scripts: {\n" +
    "        evil: (args) -> print(\"RAN\"),\n" +
    "    },\n" +
    "}\n"

private val UnknownImportManifest: string =
    "import { foo } from ghost\n" +
    "\n" +
    "{ name: \"demo\", version: \"0.1.0\" }\n"

private val JobFile: string =
    "// what a job says it does\n" +
    "import { args } from slate:process\n" +
    "\n" +
    "print(args)\n"

private val QuitFile: string =
    "import { exit } from slate:process\n" +
    "\n" +
    "exit(6)\n"

private val UsesKitFile: string =
    "import { base } from kit\n" +
    "\n" +
    "print(base())\n"
