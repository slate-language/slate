module dev.slatelang.slate
@tests

// `fetch`'s `body` as bytes, which is what an upload is and what a proxy passing a request on has.
//
// **`tests_fetch.sysl`'s arrangement**: one server, one probe held to one written answer, run under
// the interpreter and under node, so the two back ends cannot disagree about what was sent.

// Answers what arrived as its length and its bytes in hex, so a byte that was re-encoded on the way
// -- a 0xff turned into U+FFFD, say -- shows.
private val BytesServer: string =
    "import { serve, close as stop } from slate:http\n" +
    "import { localPort } from slate:net\n" +
    "\n" +
    "hexOf(bs) = bs.toArray().map(b -> \"0123456789abcdef\"[b >> 4] + \"0123456789abcdef\"[b & 15]).join(\"\")\n" +
    "\n" +
    "val server = serve(0, (req) ->\n" +
    "    if req.path == \"/accept\" then req.headers[\"accept\"] ?? \"none\"\n" +
    "    else req.method + \" \" + string(req.bytes.length) + \" \" + hexOf(req.bytes))\n"

private val BytesProbe: string =
    "anything(v) = v\n" +
    "\n" +
    "async main()\n" +
    "    val a = await fetch(base + \"/\", { method: \"POST\", body: bytes([0, 255, 1, 128, 10]) })\n" +
    "    print(a.value.body)\n" +
    "    val b = await fetch(base + \"/\", { method: \"PUT\", body: toBytes(\"héllo\") })\n" +
    "    print(b.value.body)\n" +
    "    val c = await fetch(base + \"/\", { method: \"POST\", body: bytes(0) })\n" +
    "    print(c.value.body)\n" +
    "    val d = await fetch(base + \"/\", { method: \"POST\", body: \"text\" })\n" +
    "    print(d.value.body)\n" +
    "    print((await fetch(base + \"/accept\")).value.body)\n" +
    "    print((await fetch(base + \"/accept\", { headers: { Accept: \"text/html\" } })).value.body)\n" +
    "    print((await fetch(base + \"/accept\", { headers: { accept: \"application/json\" } })).value.body)\n" +
    "    print(fetch(base, { body: anything(42) }) catch x -> x.message)\n" +
    "    print(fetch(base, { body: anything([1, 2]) }) catch x -> x.message)\n" +
    "    finish()\n" +
    "\n" +
    "main()\n"

private val BytesExpected: string =
    "POST 5 00ff01800a\n" +
    "PUT 6 68c3a96c6c6f\n" +
    "POST 0 \n" +
    "POST 4 74657874\n" +
    "*/*\n" +
    "text/html\n" +
    "application/json\n" +
    "`body` is a string or bytes, and this is an integer\n" +
    "`body` is a string or bytes, and this is an array"

// **Bytes go as they are, text goes as UTF-8, an empty buffer sends no body, and anything else is a
// mistake in the program** -- the same on both back ends. And **an `Accept` the caller names is the
// one sent**, in either case, rather than `*/*` beside it.
@test
A_FETCH_BODY_MAY_BE_BYTES_AND_THEY_ARRIVE_EXACTLY_ON_BOTH_BACK_ENDS()
    assert_eq(out(fetch_under_slate(BytesServer, BytesProbe)).trim(), BytesExpected)
    assert_eq(fetch_under_node(BytesServer, BytesProbe).trim(), BytesExpected)
