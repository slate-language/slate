module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.fs.{remove_file, write_text}
import sysl.text.{str_builder, Search, StrBuilder}

// `tests/lang/` -- slate's own test suite, run on every back end there is.
//
// **THIS IS WHERE THE LANGUAGE IS TESTED, AND THE REST OF `tests_*.sysl` IS WHERE THE COMPILER IS.**
// A test written in sysl drives the interpreter in this process, so it is a statement about the
// interpreter however it is worded -- and 1567 of them said nothing whatever about `slate js`, which
// is how `indexOf` answering `-1` instead of `null`, a `toString` hook running inside a diagnostic,
// and an object model that could not use an object as a key each reached a shipped release. A test
// written in slate is a statement about the LANGUAGE, so it can be put to both.
//
// The division, which is the user's:
//
// - **sysl tests the compiler**: the lexer, the parser, the layout, what the checker refuses, the
//   text the emitter writes, the driver and its exit status, packages and manifests. Anything about
//   *compiling*.
// - **slate `@test` tests the language**: arithmetic, strings, arrays, objects, classes, patterns,
//   the object model, JSON, generators, async. Anything about what a *running program* does.
//
// **WHAT IS COMPARED IS THE WHOLE REPORT, not a list of verdicts.** Both runs go through `run_cli`,
// so what this diffs is what a person sees -- which catches a back end that ran the right tests and
// described them differently, and needs no second rendering to be kept in step with `say_results`.
// Only the durations are taken out, being the one thing the two cannot agree on.

// Where the language suite lives, and the only path any of this names.
private const LangDir: string = "tests/lang"

@test
THE_LANGUAGE_SUITE_IS_NOT_EMPTY()
    // **A harness that runs nothing is green**, which is the failure this whole file exists to
    // prevent wearing a different hat -- and a directory that has been renamed or emptied is exactly
    // how it would happen.
    assert(lang_report(false).contains(" passed"))
    assert(!lang_report(false).contains("no .sl or .slx files"))

@test
EVERY_LANGUAGE_TEST_PASSES_ON_THE_INTERPRETER()
    assert_eq(lang_failures(false), "")
    assert_eq(cli_status(["slate", "test", LangDir]), 0)

@test
EVERY_LANGUAGE_TEST_PASSES_UNDER_NODE()
    // **The same files, the same assertions, the other back end.** A failure here is a divergence
    // and not a broken test: the interpreter's run above has already said the test itself holds.
    assert_eq(lang_failures(true), "")
    assert_eq(cli_status(["slate", "test", "--js", LangDir]), 0)

@test
THE_TWO_BACK_ENDS_REPORT_THE_SAME_THING()
    // **What the two runs above cannot notice between them.** A back end that registered half the
    // file's tests would pass everything it ran, twice, and the suite would be green while a third
    // of the language went unchecked -- which is the shape of the bug that made this whole
    // arrangement necessary in the first place.
    assert_eq(untimed(lang_report(false)), untimed(lang_report(true)))

@test
A_FILE_WHOSE_TESTS_FAIL_IS_REPORTED_FAILING_BY_BOTH()
    // The error path, which matters more here than usual: a harness that reads its verdicts out of
    // a subprocess could report every test as passing by reading nothing at all, and a suite of
    // passing tests could never tell.
    val path = s"${LangDir}.tmp.sl"

    write_text(path, "@test\nholds() = assert(true)\n\n@test\ndoes_not() = assert(1 == 2)\n").unwrap()

    val here = cli_said(["slate", "test", path])
    val there = cli_said(["slate", "test", "--js", path])

    // **THE VERDICTS AGREE AND THE DETAIL UNDER A FAILURE DOES NOT, DELIBERATELY.** The interpreter
    // renders a failed assertion against the file — the line, the caret, the source — and the
    // JavaScript back end has no source to draw against, so it says the sentence alone. That is the
    // same limit `parseJSON`'s error has and it is not a divergence about the language: what both
    // must agree on is which tests ran and which of them passed.
    assert_eq(verdicts(here), verdicts(there))
    assert(here.contains("1 passed, 1 failed"))
    assert(here.contains("  ok    " + path + " :: holds"))
    assert(here.contains("  FAIL  " + path + " :: does_not"))
    assert_eq(cli_status(["slate", "test", path]), 1)
    assert_eq(cli_status(["slate", "test", "--js", path]), 1)

    // **And a file that will not compile is the FILE failing on both**, not a test failing: there
    // are no verdicts to report, so both name the file and quote the complaint. `slate js` never
    // sees such a file at all -- it is left out of the program so that one bad file does not stop
    // every other file's tests from running.
    write_text(path, "@test\nbroken() = assert(\n").unwrap()

    assert(cli_said(["slate", "test", path]).contains("  FAIL  " + path))
    assert(cli_said(["slate", "test", "--js", path]).contains("  FAIL  " + path))
    assert_eq(cli_status(["slate", "test", "--js", path]), 1)

    remove_file(path).unwrap()

@test
NODE_IS_REQUIRED_AND_ITS_ABSENCE_WOULD_BE_A_FAILURE_RATHER_THAN_A_SKIP()
    // `slate test --js` shells out, so node is a hard requirement of this suite exactly as it is of
    // `tests_js_run.sysl`. **A harness that skips when its engine is missing is a harness that is
    // green having run nothing**, so the sentence it would print is pinned here rather than trusted.
    assert(!lang_report(true).contains("node could not be started"))

// What one back end said about the language suite.
private lang_report(js: bool) -> string =
    if js then cli_said(["slate", "test", "--js", LangDir]) else cli_said(["slate", "test", LangDir])

// Only the lines that are not `ok`, which is what a failure is worth reading.
private lang_failures(js: bool) -> string
    var out = str_builder()

    for_each_line(lang_report(js), (line: string) -> keep_failure(line, &out))

    out.finish()
end lang_failures

// Every line of a report, the last one included where it has no newline after it.
private for_each_line(said: string, on: string -> unit)
    var line = str_builder()

    for i in 0..<said.bytes.len
        if said.bytes[i] == u8('\n')
            on(line.finish())
            line = str_builder()
        else
            line.bytes.push(said.bytes[i])

    on(line.finish())
end for_each_line

private keep_failure(line: string, out: *StrBuilder)
    if line == "" then return
    if line.starts_with("  ok    ") then return
    if line.ends_with(" passed") then return

    out.push(line)
    out.push("\n")
end keep_failure

// The `ok`/`FAIL` lines and the count, with the durations taken out — what both back ends must say.
private verdicts(said: string) -> string
    var out = str_builder()

    for_each_line(said, (line: string) ->
        if line.starts_with("  ok    ") || line.starts_with("  FAIL  ") || line.ends_with(" failed")
            out.push(without_time(line))
            out.push("\n"))

    out.finish()
end verdicts

// The same report with the durations taken out.
//
// **The one thing the two back ends cannot agree on**, a test taking however long it takes on
// whichever machine ran it. Everything else in a line is what the back end decided.
private untimed(said: string) -> string
    var out = str_builder()

    for_each_line(said, (line: string) ->
        out.push(without_time(line))
        out.push("\n"))

    out.finish()
end untimed

// A verdict line without its `   12ms`, which is the last run of spaces on it.
private without_time(line: string) -> string
    if !line.ends_with("ms") then return line

    line.last_index_of("   ") match
        Some(at) -> line[0..<at]
        None -> line
end without_time
