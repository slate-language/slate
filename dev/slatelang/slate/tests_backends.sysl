module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.fs.{entries, read_bytes, remove_file, write_text}
import sysl.text.{str_builder, Search}

// `tests/lang/` -- slate's own test suite, run on every back end there is.
//
// **THIS IS WHERE THE LANGUAGE IS TESTED, AND THE REST OF `tests_*.sysl` IS WHERE THE COMPILER IS.**
// A test written in sysl drives the interpreter in this process, so it is a statement about the
// interpreter however it is worded -- and 1567 of them said nothing whatever about `slate js`, which
// is how `indexOf` answering `-1` instead of `null`, a `toString` hook running inside a diagnostic,
// and an object model that could not use an object as a key each reached a shipped release. A test
// written in slate is a statement about the LANGUAGE, so it can be put to both.
//
// The division, which is the user's:
//
// - **sysl tests the compiler**: the lexer, the parser, the layout, what the checker refuses, the
//   text the emitter writes, the driver and its exit status, packages and manifests. Anything about
//   *compiling*.
// - **slate `@test` tests the language**: arithmetic, strings, arrays, objects, classes, patterns,
//   the object model, JSON, generators, async. Anything about what a *running program* does.
//
// **The engine is linked in rather than started**, so this needs no `node` -- `js_engine.sysl` says
// why that matters. `tests_js_run.sysl` still runs its corpus under node on purpose, and the two are
// not the same check: that one asks whether emitted text runs in the engine people actually deploy
// to, and this one asks whether the two back ends agree about the language.

// Every `.sl` file in the language suite.
private lang_files() -> Buf[string]
    var out: Buf[string] = buf()
    val names = entries("tests/lang").unwrap()

    for i in 0..<names.len()
        val name = names.at(i)

        if name.ends_with(".sl") then out.push(s"tests/lang/${name}")

    out
end lang_files

private lang_source(path: string) -> Source = source(path, read_bytes(path).unwrap())

@test
THE_LANGUAGE_SUITE_IS_NOT_EMPTY()
    // **A harness that runs nothing is green**, which is the failure this whole file exists to
    // prevent wearing a different hat -- and a directory that has been renamed or emptied is exactly
    // how it would happen.
    assert(lang_files().len() > 0)

@test
EVERY_LANGUAGE_TEST_PASSES_ON_THE_INTERPRETER()
    assert_eq(lang_complaints(false), "")

@test
EVERY_LANGUAGE_TEST_PASSES_IN_THE_JAVASCRIPT_ENGINE()
    // **The same files, the same assertions, the other back end.** A failure here is a divergence
    // and not a broken test: the interpreter's run above has already said the test itself holds.
    assert_eq(lang_complaints(true), "")

@test
THE_TWO_BACK_ENDS_RUN_THE_SAME_TESTS_IN_THE_SAME_ORDER()
    // **What the two runs above cannot notice between them.** A back end that registered half the
    // file's tests would pass everything it ran, twice, and the suite would be green while a third
    // of the language went unchecked -- which is the shape of the bug that made this whole
    // arrangement necessary in the first place.
    val files = lang_files()
    var said = str_builder()

    for i in 0..<files.len()
        val path = files.at(i)
        val src = lang_source(path)
        val here = run_tests(src)
        val there = run_tests_js(src)

        if lang_named(here) != lang_named(there)
            said.push(s"${path}\n  the interpreter ran ${lang_named(here)}\n  the engine ran ${lang_named(there)}\n")

    assert_eq(said.finish(), "")

@test
A_FILE_WHOSE_TESTS_FAIL_IS_REPORTED_FAILING_BY_BOTH()
    // The error path, which matters more here than usual: a harness that reads its verdicts out of
    // an engine could report every test as passing by reading nothing at all, and a suite of
    // passing tests could never tell.
    val path = "tests/lang.tmp.sl"

    write_text(path, "@test\nholds() = assert(true)\n\n@test\ndoes_not() = assert(1 == 2)\n").unwrap()

    val src = lang_source(path)

    assert_eq(lang_named(run_tests(src)), "holds does_not")
    assert_eq(lang_named(run_tests_js(src)), "holds does_not")
    assert_eq(run_tests(src).failed(), 1)
    assert_eq(run_tests_js(src).failed(), 1)

    // **And a file that will not compile is the FILE failing on both**, not a test failing: there
    // are no verdicts to report, so both answer a report and no results.
    write_text(path, "@test\nbroken() = assert(\n").unwrap()

    val bad = lang_source(path)

    assert(run_tests(bad).report != "")
    assert(run_tests_js(bad).report != "")
    assert_eq(run_tests(bad).results.len(), 0)
    assert_eq(run_tests_js(bad).results.len(), 0)

    remove_file(path).unwrap()

// The names of the tests a run found, in the order it ran them.
private lang_named(t: Tested) -> string
    var out = str_builder()

    for i in 0..<t.results.len()
        if i > 0 then out.push(" ")

        out.push(t.results.at(i).name)

    out.finish()
end lang_named

// What did not pass, said file by file. Empty when everything did.
private lang_complaints(js: bool) -> string
    val files = lang_files()
    var said = str_builder()

    for i in 0..<files.len()
        val path = files.at(i)
        val src = lang_source(path)
        val t = if js then run_tests_js(src) else run_tests(src)

        if t.report != ""
            said.push(s"${path} would not run:\n${t.report}\n")

            continue

        for k in 0..<t.results.len()
            val r = t.results.at(k)

            if !r.ok
                said.push(s"${path} :: ${r.name}\n")

                if r.printed != "" then said.push(s"${r.printed}\n")

                said.push(s"${r.said}\n")

    said.finish()
end lang_complaints
