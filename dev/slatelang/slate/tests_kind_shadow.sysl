module dev.slatelang.slate
@tests

import sysl.text.Search

// A type declared or imported under one of slate's own kind words.
//
// **A local wins.** A name in a pattern is shadowed exactly as it is everywhere else, so a `class
// Set`, a `data period`, a `type integer = ...` or an imported `Map` is what `is`, an annotation, a
// `match` arm and `Set.test` mean in the file that has it. The parser reads a kind word before
// anything is in scope, so `shadowed_kind` in `compile.sysl` is where `resolve_pattern` finds the
// declaration -- and the JavaScript back end resolves through the same function.

@test
A_CLASS_NAMED_Set_IS_WHAT_is_Set_TESTS_FOR()
    assert_eq(out("class Set\n    var n\nprint(Set(4) is Set, 3 is Set)"), "true false")

@test
A_CLASS_NAMED_Set_IS_WHAT_AN_ANNOTATION_CHECKS()
    assert_eq(out("class Set\n    var n\nf(x: Set) = x.n\nprint(f(Set(5)))"), "5")

@test
A_CLASS_NAMED_Set_IS_WHAT_A_match_ARM_TESTS_FOR()
    assert_eq(out("class Set\n    var n\nf(v) = v match\n    Set -> \"mine\"\n    _ -> \"other\"\nprint(f(Set(1)), f(2))"), "mine other")

@test
A_PARAMETER_NAMED_Set_SHADOWS_THE_CLASS_IN_ITS_TURN()
    // The class's pattern looks `Set` up in the scope it matches in, so the parameter has to stay
    // in that scope rather than a slot -- `f(A) = v is A`'s rule, reached through a kind word.
    assert_eq(out("class Set\n    var n\nf(Set, v) = v is Set\nprint(f(1, Set(1)))"), "false")

@test
A_CLASS_NAMED_Set_ANSWERS_test_AND_mismatch_FOR_ITSELF()
    assert_eq(out("class Set\n    var n\nprint(Set.test(Set(1)), Set.test(7), Set.mismatch(Set(1)).length, Set.mismatch(7).length > 0)"), "true false 0 true")

@test
A_type_ALIAS_NAMED_integer_IS_WHAT_THE_WORD_MEANS()
    assert_eq(out("type integer = { count: number }\nf(c: integer) = c.count\nprint(f({ count: 8 }), { count: 1 } is integer, 3 is integer)"), "8 true false")

@test
A_data_TYPE_NAMED_period_IS_WHAT_THE_WORD_MEANS()
    assert_eq(out("data period\n    Weekly\n    Monthly(day)\nf(p: period) = p match\n    Monthly(d) -> d\n    _ -> 0\nprint(f(Monthly(9)), Weekly is period, \"x\" is period)"), "9 true false")

@test
A_GENERIC_TYPE_NAMED_Set_IS_WHAT_Set_OF_A_TYPE_APPLIES()
    // `Set[T]` is read as the kind's own form by the parser, and the declaration claims it back --
    // including a count the kind would refuse.
    assert_eq(out("type Set[T] = { item: T }\nf(s: Set[integer]) = s.item\nprint(f({ item: 4 }), { item: \"x\" } is Set[integer])"), "4 false")
    assert_eq(out("type Map[K, V, W] = { w: W }\ng(m: Map[string, integer, boolean]) = m.w\nprint(g({ w: true }))"), "true")

@test
A_CLASS_NAMED_Set_IS_NOT_GENERIC_SO_Set_OF_A_TYPE_IS_REFUSED()
    assert(fails("class Set\n    var n\nprint(Set(1) is Set[integer])").contains("`Set` is not generic, so it takes no types in brackets"))

@test
A_CLASS_NAMED_array_TAKES_NO_of()
    // Testing the kind anyway would be the shadowed word answering after all.
    assert(fails("class array\n    var n\nprint([1] is array of integer)").contains("`array` here is the type this file declares, which takes no `of`"))

@test
WITH_NOTHING_DECLARED_THE_KIND_WORDS_STILL_MEAN_THE_KINDS()
    // The control: every form above, with no declaration taking the word.
    assert_eq(out("print(Set([1]) is Set, 3 is Set, Map() is Map, 3 is integer, [1] is array of integer)"), "true false true true true")
    assert_eq(out("f(s: Set[integer]) = s.size\nprint(f(Set([1, 2])))"), "2")
    assert(fails("print(Map() is Map[string])").contains("`Map` takes a key type and a value type"))
    assert(fails("print(Set() is Set[string, integer])").contains("`Set` holds one kind of thing, so it takes one type"))

@test
THE_CORPUS_PROGRAM_SAYS_THE_DECLARATION_WINS_EVERYWHERE()
    // `tests/js/p46.sl` is diffed against node by `tests_js_run.sysl`; this pins what both say, which
    // is what the differential alone cannot -- two back ends agreeing on the kind would pass it.
    assert_eq(cli_said(["slate", "tests/js/p46.sl"]), "true true true true true\nfalse false false false\n7 8 9 0\nthe class the import the renamed import the data type the alias\nsomething else something else something else\ntrue false true true\n0 true\nfalse\ntrue false")
