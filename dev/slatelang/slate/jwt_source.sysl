module dev.slatelang.slate

// slate's JWT module, written in slate and carried in the binary.
//
// **THE SECOND KIND OF BUILT-IN MODULE, and the second one there is.** `slate:http` was the first;
// `stdlib.sysl` says how the two kinds differ, which is in `take_builtin` and nowhere else. What
// makes this one worth writing in slate rather than in sysl is that nearly all of a JWT is JSON,
// text and a clock -- and slate has all three. Only the signature needed the machine, and that is
// `jws.sysl`.
//
// **A RAW TEXT BLOCK, SO WHAT IS WRITTEN HERE IS WHAT SLATE READS.** `raw"""` takes no escapes and
// strips only the incidental indentation, so the module sits below at four spaces and reaches the
// lexer at the margin -- and a `\r\n`, a quote or a `${...}` in it means itself. It was an array of
// escaped strings, one per line, until 2026-08-30: this file's own header said sysl had no raw string
// literal, and that had stopped being true long before. `http_source.sysl` says the rest.

// The module's source, as slate will read it.
jwt_source() -> string = raw"""
    // JSON Web Tokens, written in slate on the one thing slate could not do itself.
    //
    // A token is three base64url pieces separated by dots -- a JSON header, a set of JSON claims, and a
    // signature over the first two joined by the dot between them. Everything but the signature is
    // something slate already had: JSON both ways, a clock, and text. So this module is slate, and
    // `jwsSign` and `jwsVerify` are the seam it stands on, exactly as `slate:http` stands on `httpParser`.
    //
    // ## The algorithm is an argument, and that is the whole security of it
    //
    // **A verifier that reads the algorithm out of the token it is checking accepts whatever an attacker
    // wrote there.** That is not a subtle hole: `alg: none` was accepted by most libraries for years, and
    // the RS256-public-key-used-as-an-HMAC-secret confusion turns a *published* key into a signing key.
    // So `verify` is told which algorithm it expects and the token gets no vote -- if the header disagrees
    // with what was asked for, the token is refused before a signature is checked at all.
    //
    // ## What is refused, and what is merely reported
    //
    // **A token that will not parse, a signature that does not check out, and a claim that has expired are
    // all the same kind of answer**: the token is not acceptable, and a program handling requests wants to
    // say `401` and carry on. So `verify` answers a result -- `{ ok, value }` or `{ ok: false, error }` --
    // where the two channels rule puts every other reachable-from-outside failure. A key that is not a key
    // is the other kind and faults, because that is the program's own mistake.

    import { epochSeconds, now } from slate:time
    import { base64urlEncode, base64urlDecode } from slate:url

    // What `verify` and `decode` answer: the claims under `value`, or why the token was not
    // acceptable under `error`.
    //
    // **Only the field that applies is ever there**, which is why the two are optional -- reading
    // `r.value` off a refusal is `undefined`, and slate refuses to carry that anywhere. An
    // annotation naming this therefore describes both halves of the answer and neither on its own.
    export type Checked = { ok: boolean, value?: any, error?: string }

    // `sign(claims, key, alg)` -- a signed token.
    //
    // **Three arguments and no options object**, which defaults now allow and which would still be the
    // wrong shape: every one of the three is a decision the caller has to make anyway, and an option is
    // for what has a sensible answer when nobody says. Extra header fields -- `kid`, most of all --
    // go in `claims` under `header`, which is taken out and merged rather than signed as a claim.
    // **The three parameters carry their own refusals rather than annotations**, and that is not an
    // oversight: `CheckType` would say `alg` was declared string and this pass wants to say what a
    // string here looks like. A key may be text or bytes depending on the algorithm, which is a
    // union no annotation here could tighten usefully.
    export sign(claims, key, alg) -> string =
        if !(claims is object) then throw "`sign` takes the claims as an object"
        if !(alg is string) then throw "`sign` takes the algorithm as a string, such as \"HS256\""

        var header = { alg: alg, typ: "JWT" }
        var payload = claims

        // **`header` in the claims is the way to say `kid`**, and it is removed rather than signed: a
        // claim called `header` would be a surprising thing to find in the payload of a token you signed.
        if has(claims, "header")
            if !(claims.header is object) then throw "`header` in the claims is an object of extra header fields"

            header = header with claims.header
            payload = {}

            for [k, v] in entries(claims)
                if k != "header"
                    payload[k] = v

        val signing = encode(header) + "." + encode(payload)

        signing + "." + base64urlEncode(jwsSign(alg, key, signing))

    // `verify(token, key, alg)` -- the claims, where everything about the token is right.
    //
    // **`alg` is what the caller expects and is checked against the header before anything else.** A
    // token whose header says something different is refused there and then; reading the algorithm out of
    // the token would be letting whoever wrote it choose how it is checked.
    export verify(token, key, alg) -> Checked =
        if !(token is string) then return { ok: false, error: "a token is text" }
        if !(alg is string) then throw "`verify` takes the algorithm as a string, such as \"HS256\""

        val parts = split(token, ".")

        if len(parts) != 3
            return { ok: false, error: "a token is three pieces separated by dots, and this has " + string(len(parts)) }

        val header = readPart(parts[0], "header")

        if !header.ok then return header
        if !(header.value is object) then return { ok: false, error: "the header of a token is an object" }

        val said = header.value.alg ?? null

        if said != alg
            return { ok: false, error: "this token says it is " + string(said) + " and " + alg + " was expected" }

        val signature = base64urlDecode(parts[2])

        if !signature.ok then return { ok: false, error: "the signature of this token is not base64url" }

        if !jwsVerify(alg, key, parts[0] + "." + parts[1], signature.value)
            return { ok: false, error: "the signature is not this key's" }

        val claims = readPart(parts[1], "claims")

        if !claims.ok then return claims
        if !(claims.value is object) then return { ok: false, error: "the claims of a token are an object" }

        val when = epochSeconds(now())

        // **`exp` is the moment it stops being valid and `nbf` the moment it starts**, both in seconds
        // since the epoch, both optional, and neither is trusted to be a number.
        if has(claims.value, "exp")
            if !(claims.value.exp is number) then return { ok: false, error: "`exp` is a number of seconds" }
            if when >= claims.value.exp then return { ok: false, error: "this token expired" }

        if has(claims.value, "nbf")
            if !(claims.value.nbf is number) then return { ok: false, error: "`nbf` is a number of seconds" }
            if when < claims.value.nbf then return { ok: false, error: "this token is not valid yet" }

        { ok: true, value: claims.value }

    // `decode(token)` -- what a token says, WITHOUT checking any of it.
    //
    // **For looking at a token, never for deciding anything.** It answers the header and the claims of
    // something nobody has verified: the `kid` that says which key to fetch, a log line, a debugging
    // session. A program that acts on what this answers has no security at all, and the name is as loud
    // as a name can be about it.
    export decode(token) -> Checked =
        if !(token is string) then return { ok: false, error: "a token is text" }

        val parts = split(token, ".")

        if len(parts) != 3
            return { ok: false, error: "a token is three pieces separated by dots, and this has " + string(len(parts)) }

        val header = readPart(parts[0], "header")

        if !header.ok then return header

        val claims = readPart(parts[1], "claims")

        if !claims.ok then return claims

        { ok: true, value: { header: header.value, claims: claims.value } }

    // One base64url piece, read as JSON.
    readPart(piece: string, which: string) -> Checked =
        val bytes = base64urlDecode(piece)

        if !bytes.ok then return { ok: false, error: "the " + which + " of this token is not base64url" }

        val text = fromBytes(bytes.value)

        if !text.ok then return { ok: false, error: "the " + which + " of this token is not text" }

        // **`parseJSON` answers a RESULT**, which is slate's rule for anything read from outside -- and a
        // token's two JSON pieces are as outside as text gets.
        val doc = parseJSON(text.value)

        if !doc.ok then return { ok: false, error: "the " + which + " of this token is not JSON" }

        { ok: true, value: doc.value }

    // ## base64url comes from `slate:url`
    //
    // **A token is three base64url pieces, and this module had the only encoder there was.** It was
    // private, so a program signing a cookie or a webhook could not reach it and wrote hex instead --
    // and hex is a third longer for a thing that is already going into a header. So the pair moved to
    // `slate:url`, which is where a URL-safe encoding of bytes belongs and which asks nothing of the
    // host, and this module imports it like anything else.
    //
    // **`base64urlDecode` answers a RESULT where the copy that lived here answered `null`**, so the
    // three readers below say `!r.ok` rather than `== null` and hand on `r.value`. What that buys a
    // token is nothing; what it buys everybody else is a sentence naming the character that was
    // wrong.
    encode(v: object) -> string = base64urlEncode(toJSON(v))
    """
