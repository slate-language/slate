module dev.slatelang.slate

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}

// What a hash answers with. A user-supplied `hash` can fault, so this carries the fault out.
type Hashed = Result[u64, Signal]

// What a lookup answers with, for the same reason.
type Found = Result[Option[Value], Signal]

// The hash table an object is.
//
// **Written here rather than reached for, and the reason is not speed.** `sysl.container.Map` keys on
// `Hash` and `Eq`, whose methods are `hash(self) -> u64` and `eq(self, rhs: Self) -> bool` -- and
// there is nowhere in either signature to put the three things slate needs. A key that reaches itself
// needs the set of pairs already being compared, or the comparison does not terminate. A
// user-supplied `equals` is a slate closure, so calling it needs the interpreter. And that closure can
// fault, which a bare `bool` cannot carry. All three would have to be smuggled through module
// storage; a table of slate's own takes them as arguments.
//
// **The layout is the compact dict Python has used since 3.7.** Entries are appended in insertion
// order and never move; a separate open-addressed array of positions does the bucketing. Two things
// fall out of that, and both matter here:
//
//   - **Order is preserved for free**, which is what an object wants -- `keys()` answers the order
//     the fields were written, as JavaScript's objects and Python's dicts both do.
//   - **The tracer is a linear walk** of one array, rather than a walk of somebody else's container.

// One key and its value, with the hash kept beside them.
//
// **The hash is stored rather than recomputed** because a rehash on growth would otherwise re-walk
// every key -- and a key here can be an array or an object, so that walk is not free.
struct Entry
    hash: u64
    key: Value
    value: Value

    // A removed entry stays in place so that the positions in the index do not all shift. It is
    // skipped by every walk and dropped at the next growth.
    dead: bool

// What the slots of the index array mean.
//
// **A position is stored biased by two**, so that the two markers can be ordinary values rather than
// a wider type or a parallel array of flags.
private const Empty: usize = 0

// A slot whose entry was removed. A search must walk through one, since something inserted after it
// may have probed past it; only an `Empty` ends a search.
private const Dead: usize = 1

private const Bias: usize = 2

// Where an index array starts. A power of two, because the probe masks rather than divides.
private const InitialSlots: usize = 8

// Make the index of an empty table.
fresh_index() -> Buf[usize]
    var ix: Buf[usize] = buf()

    for i in 0..<InitialSlots
        ix.push(Empty)

    ix
end fresh_index

// -- hashing --------------------------------------------------------------------------------------

// How far into a structure a hash looks.
//
// **A bound rather than a visit set, and it stays consistent with `==` for a reason worth stating.**
// Two values that compare equal are equal all the way down, so they agree on their first eight levels
// too and hash alike -- which is the whole of the contract a table needs. The bound is what makes a
// key that reaches itself terminate, and eight levels is far past where real keys differ.
private const MaxDepth: usize = 8

// The hash of a value, structural and total.
//
// **Every value has one, not only an object.** A set and a dictionary are general only if `1`, `"x"`
// and `[1, 2]` can all be keys, so hashing is defined for the whole union rather than for the one
// kind that could carry a method.
// **A `Result`, because a user-supplied `hash` is a slate closure and a slate closure can fault.**
// That is the whole reason this is not `sysl.container.Map`: `Hash::hash(self) -> u64` has nowhere to
// put the failure, so the table would have to abort the process or lie.
hash_value(v: Value, at: Span) -> Hashed = hash_at(v, 0, at)

// The hook an object supplies for itself, if it has one and it is callable.
//
// **A field rather than new syntax.** An object already holds closures, so `{ hash: () -> 1 }` is a
// thing a program can write today -- Java gives every object an overridable `hashCode` and slate gives
// it an overridable field, which is the same idea spelled in what the language already has.
// **A hook may come from a proto**, which is what makes a proto a place to put shared behaviour
// rather than only shared data: a table of methods carrying `hash` and `equals` gives them to every
// object delegating to it.
//
// It takes no receiver, and cannot: these are called from inside a table lookup where there is no
// call expression to have written `o.hash()` in. A hook that needs the object captures it, which is
// how every one written so far already works.
hook_of(v: Value, name: string) -> Option[Value] = v match
    Object(p) -> hook_field(p, name) match
        Some(f) -> f match
            Fn(_) -> Some(f)
            Native(_) -> Some(f)
            _ -> None
        None -> None
    _ -> None

private hash_at(v: Value, depth: usize, at: Span) -> Hashed
    hook_of(v, "hash") match
        Some(f) ->
            var none: Buf[Value] = buf()

            apply(f, none, at)? match
                Int(n) -> return Ok(u64(n))
                other -> return Err(failure(at, s"`hash` must answer an integer, and this answered ${other.type_name()}"))
        None -> ()

    hash_plain(v, depth, at)
end hash_at

private hash_plain(v: Value, depth: usize, at: Span) -> Hashed = v match
    Null -> Ok(0x9e3779b97f4a7c15u64)

    // Never reached through a key -- a key that is absent is refused before it gets here -- but the
    // union has to be covered.
    Undefined -> Ok(0x5f11u64)
    Bool(b) -> Ok(if b then hash_u64(1u64) else hash_u64(2u64))

    // **An integer and a real that are numerically equal MUST hash alike**, because `==` says they
    // are equal: `1 == 1.0` is true in slate, so `t[1]` and `t[1.0]` have to find each other. A real
    // that holds an exact integer therefore hashes as that integer.
    Int(n) -> Ok(hash_u64(u64(n)))
    Real(r) -> Ok(hash_real(r))

    Str(p) -> Ok(p.s.hash())
    Array(p) -> hash_array(p, depth, at)
    Object(p) -> hash_object(p, depth, at)

    // **A function hashes by identity, because that is how it compares.** `same` answers false for
    // two functions whatever they are, so nothing is promised here beyond a value that is stable for
    // as long as the closure lives.
    Fn(p) -> Ok(hash_u64(u64(usize(p))))

    // The same bargain a function gets, and for the same reason: `same` answers identity here too.
    Promise(p) -> Ok(hash_u64(u64(usize(p)) + 0x9du64))

    // **Hashed from the numbers it covers, not from how it was written**, because that is how it
    // compares: `1..3` and `1..<4` are equal, so they have to land in the same slot.
    RangeVal(lo, hi, inclusive, has_lo, has_hi) ->
        val last = if inclusive then hi else hi - 1

        Ok(mix(hash_u64(u64(lo) + 0x4e1u64), hash_u64(u64(last) + (if has_lo then 2u64 else 0u64) + (if has_hi then 1u64 else 0u64))))
    Native(f) -> Ok(hash_u64(u64(usize(f)) + 0x51u64))

    // A socket is its slot, and its slot is a number -- so unlike a function this hashes by what it
    // *is* rather than by where it happens to live.
    Socket(id, gen) -> Ok(mix(hash_u64(u64(id) + 0x50cu64), hash_u64(u64(gen))))

private hash_real(r: real) -> u64
    val whole = long(r)

    if real(whole) == r then hash_u64(u64(whole)) else hash_u64(u64(bits_of(r)))

// The bit pattern of a real, for a value that has no integer to stand in for it.
private bits_of(r: real) -> long = long(r * 4194304.0)

private hash_array(p: *ArrayObj, depth: usize, at: Span) -> Hashed
    if depth >= MaxDepth then return Ok(0x7a1cu64)

    // **Order matters here and must**, because `[1, 2]` and `[2, 1]` are not equal.
    var h = hash_u64(u64(p.items.len()) + 0xa11u64)

    for i in 0..<p.items.len()
        h = mix(h, hash_at(p.items.at(i), depth + 1, at)?)

    Ok(h)
end hash_array

private hash_object(p: *ObjectObj, depth: usize, at: Span) -> Hashed
    if depth >= MaxDepth then return Ok(0x0b1eu64)

    // **Order must NOT matter here, and that is not a stylistic choice.** `same_object` compares two
    // objects by their contents whatever order the fields were written in, so two equal objects would
    // hash differently under any order-sensitive mix -- and a key would be lost in its own table. The
    // fields are therefore summed, which commutes.
    var h = 0u64

    for i in 0..<p.entries.len()
        val e = p.entries.at(i)

        if !e.dead
            h += mix(hash_at(e.key, depth + 1, at)?, hash_at(e.value, depth + 1, at)?)

    Ok(hash_u64(h + u64(p.live)))
end hash_object

// Combine two hashes so that order is kept.
private mix(a: u64, b: u64) -> u64 = hash_u64(a ^ (b + 0x9e3779b97f4a7c15u64 + (a << 6u64) + (a >> 2u64)))

// -- lookup ---------------------------------------------------------------------------------------

// Where a key sits, or nothing.
//
// **A search ends at an `Empty` and walks through a `Dead`**, because an entry inserted later may
// have probed past the slot this one used to hold.
private find_entry(o: *ObjectObj, k: Value, h: u64, at: Span) -> Result[Option[usize], Signal]
    val slots = o.index.len()
    val mask = slots - 1
    var probe = usize(h) & mask
    var steps: usize = 0

    while steps < slots
        val slot = o.index.at(probe)

        if slot == Empty then return Ok(None)

        if slot != Dead
            val where = slot - Bias
            val e = o.entries.at(where)

            if e.hash == h && !e.dead && same(e.key, k, at)? then return Ok(Some(where))

        probe = (probe + 1) & mask
        steps += 1

    Ok(None)
end find_entry

// Put a position into the index, at the first slot free for it.
private place(ix: *Buf[usize], h: u64, at: usize)
    val slots = ix.len()
    val mask = slots - 1
    var probe = usize(h) & mask

    loop
        val slot = ix.at(probe)

        if slot == Empty || slot == Dead
            ix.set(probe, at + Bias)
            return

        probe = (probe + 1) & mask
end place

// Double the index and drop the removed entries.
//
// **Growth is where a table pays for its tombstones**, which is why removal costs nothing at the time:
// the dead entries go here, in one pass, and the positions that shift are rebuilt anyway.
private grow(o: *ObjectObj)
    var kept: Buf[Entry] = buf()

    for i in 0..<o.entries.len()
        val e = o.entries.at(i)

        if !e.dead then kept.push(e)

    var slots = InitialSlots

    while slots < (kept.len() + 1) * 2
        slots = slots * 2

    var ix: Buf[usize] = buf()

    for i in 0..<slots
        ix.push(Empty)

    o.entries = kept
    o.index = ix
    o.live = kept.len()

    for i in 0..<o.entries.len()
        place(&o.index, o.entries.at(i).hash, i)
end grow

// -- what the interpreter calls -------------------------------------------------------------------

// How many fields an object has.
obj_len(o: *ObjectObj) -> usize = o.live

// What a key holds, or nothing.
obj_get(o: *ObjectObj, k: Value, at: Span) -> Found
    find_entry(o, k, hash_value(k, at)?, at)? match
        None -> Ok(None)
        Some(where) -> Ok(Some(o.entries.at(where).value))

// Whether a key is present.
obj_has(o: *ObjectObj, k: Value, at: Span) -> Result[bool, Signal] = find_entry(o, k, hash_value(k, at)?, at)? match
    None -> Ok(false)
    Some(_) -> Ok(true)

// Write a key, keeping the position it already had if it has one.
//
// **Re-writing a field does not move it**, which is what makes the order `keys()` answers the order
// the fields were *first* written -- the rule JavaScript and Python both follow.
obj_put(o: *ObjectObj, k: Value, v: Value, at: Span) -> Step
    val h = hash_value(k, at)?

    find_entry(o, k, h, at)? match
        Some(where) ->
            var e = o.entries.at(where)

            e.value = v
            o.entries.set(where, e)
        None ->
            // Two thirds full is where an open-addressed table's probes start to lengthen.
            if (o.entries.len() + 1) * 3 >= o.index.len() * 2 then grow(o)

            val where = o.entries.len()

            o.entries.push(Entry(h, k, v, false))
            place(&o.index, h, where)
            o.live += 1

    Ok(Null)
end obj_put

// Take a key out. Answers whether there was one.
obj_remove(o: *ObjectObj, k: Value, at: Span) -> Result[bool, Signal]
    val h = hash_value(k, at)?

    find_entry(o, k, h, at)? match
        None -> Ok(false)
        Some(where) ->
            var e = o.entries.at(where)

            e.dead = true
            e.key = Null
            e.value = Null
            o.entries.set(where, e)
            o.live -= 1

            val slots = o.index.len()
            val mask = slots - 1
            var probe = usize(h) & mask

            loop
                if o.index.at(probe) == where + Bias
                    o.index.set(probe, Dead)
                    break

                probe = (probe + 1) & mask

            Ok(true)
end obj_remove

// The keys, in the order they were first written.
obj_keys(o: *ObjectObj) -> Buf[Value]
    var out: Buf[Value] = buf()

    for i in 0..<o.entries.len()
        val e = o.entries.at(i)

        if !e.dead then out.push(e.key)

    out
end obj_keys

// -- the string fast path -------------------------------------------------------------------------
//
// **`o.name` is the commonest thing a program does to an object, and it must not allocate.** A key is
// a `Value` now, so the obvious spelling of a field read would box the name into a `StrObj` on the
// collected heap once per access, and then drop it. These take the sysl `string` straight and hash it
// exactly as `hash_value` hashes a `Str`, so the two agree on every bucket.

private find_named(o: *ObjectObj, name: string, h: u64) -> Option[usize]
    val slots = o.index.len()
    val mask = slots - 1
    var probe = usize(h) & mask
    var steps: usize = 0

    while steps < slots
        val slot = o.index.at(probe)

        if slot == Empty then return None

        if slot != Dead
            val at = slot - Bias
            val e = o.entries.at(at)

            if e.hash == h && !e.dead
                e.key match
                    Str(p) -> if p.s == name then return Some(at)
                    _ -> ()

        probe = (probe + 1) & mask
        steps += 1

    None
end find_named

// What a named field holds, without boxing the name.
// A field or a proto's, without a span to complain with -- a circular chain simply answers nothing,
// since the caller is a hash or an equality that has nowhere to report.
private hook_field(o: *ObjectObj, name: string) -> Option[Value]
    var up = o
    var depth: usize = 0

    loop
        obj_get_name(up, name) match
            Some(v) -> return Some(v)
            None -> ()

        depth += 1

        if depth >= 64 then return None

        up = obj_get_name(up, "proto") match
            Some(Object(p)) -> p
            _ -> return None
end hook_field

obj_get_name(o: *ObjectObj, name: string) -> Option[Value]
    find_named(o, name, name.hash()) match
        None -> None
        Some(at) -> Some(o.entries.at(at).value)

// Write a named field. **Only an insert boxes the name**, because only then is a key stored.
obj_put_name(o: *ObjectObj, name: string, v: Value)
    val h = name.hash()

    find_named(o, name, h) match
        Some(at) ->
            var e = o.entries.at(at)

            e.value = v
            o.entries.set(at, e)
        None ->
            if (o.entries.len() + 1) * 3 >= o.index.len() * 2 then grow(o)

            val at = o.entries.len()

            o.entries.push(Entry(h, str_value(name), v, false))
            place(&o.index, h, at)
            o.live += 1
end obj_put_name
