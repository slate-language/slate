module dev.slatelang.slate

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
// `trunc` is `Float`'s, and a trait has to be in scope for its member to be reached.
import sysl.math.Float
// `leading_zeros` is `Bits`', for the same reason.
import sysl.math.Bits
import sysl.math.bigint.from_real as big_from_real

// What a hash answers with. A user-supplied `hash` can fault, so this carries the fault out.
type Hashed = Result[u64, Signal]

// What a lookup answers with, for the same reason.
type Found = Result[Option[Value], Signal]

// The hash table an object is.
//
// **Written here rather than reached for, and the reason is not speed.** `sysl.container.Map` keys on
// `Hash` and `Eq`, whose methods are `hash(self) -> u64` and `eq(self, rhs: Self) -> bool` -- and
// there is nowhere in either signature to put the three things slate needs. A key that reaches itself
// needs the set of pairs already being compared, or the comparison does not terminate. A
// user-supplied `equals` is a slate closure, so calling it needs the interpreter. And that closure can
// fault, which a bare `bool` cannot carry. All three would have to be smuggled through module
// storage; a table of slate's own takes them as arguments.
//
// **The layout is the compact dict Python has used since 3.7.** Entries are appended in insertion
// order and never move; a separate open-addressed array of positions does the bucketing. Two things
// fall out of that, and both matter here:
//
//   - **Order is preserved for free**, which is what an object wants -- `keys()` answers the order
//     the fields were written, as JavaScript's objects and Python's dicts both do.
//   - **The tracer is a linear walk** of one array, rather than a walk of somebody else's container.

// One key and its value, with the hash kept beside them.
//
// **The hash is stored rather than recomputed** because a rehash on growth would otherwise re-walk
// every key -- and a key here can be an array or an object, so that walk is not free.
struct Entry
    hash: u64
    key: Value
    value: Value

    // A removed entry stays in place so that the positions in the index do not all shift. It is
    // skipped by every walk and dropped at the next growth.
    dead: bool

// What the slots of the index array mean.
//
// **A position is stored biased by two**, so that the two markers can be ordinary values rather than
// a wider type or a parallel array of flags.
private const Empty: usize = 0

// A slot whose entry was removed. A search must walk through one, since something inserted after it
// may have probed past it; only an `Empty` ends a search.
private const Dead: usize = 1

private const Bias: usize = 2

// Where an index array starts. A power of two, because the probe masks rather than divides.
private const InitialSlots: usize = 8

// 2^64 divided by the golden ratio, the multiplier `home` spreads a hash with.
private const Golden: u64 = 0x9e3779b97f4a7c15u64

// The slot a hash's probe starts at, in an index whose size is `mask + 1`.
//
// **THE TOP BITS OF THE HASH TIMES THE GOLDEN RATIO, NOT ITS LOW BITS** -- Knuth's multiplicative
// hashing. It is what lets an integer hash as ITSELF (`hash_plain`): the multiples of an irrational
// number spread as evenly as any sequence can, so a run of consecutive integers lands in distinct
// slots with no collision at all -- which is what a map keyed `0..n` wants, and which a scrambled
// hash under a low-bit mask can only approach with a collision about one lookup in three, each one
// a mispredicted branch in the probe loop. A stride of any power of two spreads too, where the low
// bits of an identity hash would put every key in one slot; so does a class's own `hash`, which is
// whatever integer the program answered and is often exactly that kind of number.
@inline
private home(h: u64, mask: usize) -> usize = usize((h * Golden) >> u64(u64(mask).leading_zeros()))

// How many entries a table holds before it has an index at all.
//
// **BELOW THIS THERE IS NO INDEX AND A LOOKUP WALKS THE ENTRIES**, which is what Ruby's `Hash` does
// up to eight and what Scala's `Map1`..`Map4` do up to four. A handful of comparisons costs less
// than a hash and a probe, and the index is storage a small table never earns.
//
// **It matters more here than it does anywhere else, because this one table serves `Map`, `Set`,
// every object literal and every class instance.** Most objects a program builds have a handful of
// fields, so the small case is the ordinary case rather than a corner of it -- and an object used
// to allocate an eight-slot index before its first field was written.
//
// Eight is where the measurement put it; see `bench/results/2026-09-19-table-hashing-small-index.md`.
private const SmallTable: usize = 8

// -- hashing --------------------------------------------------------------------------------------

// How far into a structure a hash looks.
//
// **A bound rather than a visit set, and it stays consistent with `==` for a reason worth stating.**
// Two values that compare equal are equal all the way down, so they agree on their first eight levels
// too and hash alike -- which is the whole of the contract a table needs. The bound is what makes a
// key that reaches itself terminate, and eight levels is far past where real keys differ.
private const MaxDepth: usize = 8

// The hash of a value, structural and total.
//
// **Every value has one, not only an object.** A set and a dictionary are general only if `1`, `"x"`
// and `[1, 2]` can all be keys, so hashing is defined for the whole union rather than for the one
// kind that could carry a method.
// **A `Result`, because a user-supplied `hash` is a slate closure and a slate closure can fault.**
// That is the whole reason this is not `sysl.container.Map`: `Hash::hash(self) -> u64` has nowhere to
// put the failure, so the table would have to abort the process or lie.
hash_value(v: Value, at: Span) -> Hashed = hash_at(v, 0, at)

// The hook an object supplies for itself, if it has one and it is callable.
//
// **A field rather than new syntax.** An object already holds closures, so `{ hash: () -> 1 }` is a
// thing a program can write today -- Java gives every object an overridable `hashCode` and slate gives
// it an overridable field, which is the same idea spelled in what the language already has.
// **A hook may come from a proto**, which is what makes a proto a place to put shared behaviour
// rather than only shared data: a table of methods carrying `hash` and `equals` gives them to every
// object delegating to it.
//
// It takes no receiver, and cannot: these are called from inside a table lookup where there is no
// call expression to have written `o.hash()` in. A hook that needs the object captures it, which is
// how every one written so far already works.
hook_of(v: Value, name: string) -> Option[Value] = v match
    Object(p) -> field_through(p, name) match
        Some(f) -> f match
            Fn(_) -> Some(f)
            Native(_) -> Some(f)
            _ -> None
        None -> None
    _ -> None

private hash_at(v: Value, depth: usize, at: Span) -> Hashed
    // **ONLY AN OBJECT CAN CARRY A HOOK, SO ONLY AN OBJECT PAYS FOR THE LOOKUP.** `call_hook`
    // answers nothing for every other kind, and asking it anyway built an argument buffer and made
    // a call for an integer key -- which is the commonest key there is.
    //
    // **The receiver rule, as `==` and the operator methods take it**, so a class writes
    // `hash(self)` with the definition syntax every other member uses -- and a captured
    // `{ hash: () -> 7 }` sitting on the object itself still takes none, which is the difference
    // `call_hook` answers for.
    v match
        Object(_) ->
            var none: Buf[Value] = buf()

            call_hook(v, "hash", none, at) match
                Some(step) -> step? match
                    Int(n) -> return Ok(u64(n))
                    other -> return Err(failure(at, s"`hash` must answer an integer, and this answered ${other.type_name()}"))
                None -> ()
        _ -> ()

    hash_plain(v, depth, at)
end hash_at

private hash_plain(v: Value, depth: usize, at: Span) -> Hashed = v match
    Null -> Ok(0x9e3779b97f4a7c15u64)

    // Never reached through a key -- a key that is absent is refused before it gets here -- but the
    // union has to be covered.
    Undefined -> Ok(0x5f11u64)
    Bool(b) -> Ok(if b then hash_u64(1u64) else hash_u64(2u64))

    // **An integer and a real that are numerically equal MUST hash alike**, because `==` says they
    // are equal: `1 == 1.0` is true in slate, so `t[1]` and `t[1.0]` have to find each other. A real
    // that holds an exact integer therefore hashes as that integer.
    //
    // **An integer hashes as ITSELF**, which is sound only because `home` spreads a hash by its top
    // bits: under a low-bit mask a stride of 1024 would put every key in one slot.
    Int(n) -> Ok(u64(n))

    // **It owes nothing to `Int` and everything to `Real`.** A `Big` that fits a `long` never
    // exists, so no big integer is ever equal to an `Int` and the two are free to hash by different
    // rules. A REAL of the same value is another matter: a big integer and a real compare exactly,
    // so `1 << 100` equals `pow(2.0, 100)` and the two have to land in one slot. `hash_real` below
    // is the other half of that and reaches this very function for a whole real too large for a
    // `long`.
    Big(p) -> Ok(p.n.hash())
    Real(r) -> Ok(hash_real(r))

    Str(p) -> Ok(p.s.hash())
    Array(p) -> hash_array(p, depth, at)

    // **Hashed from the bytes, because that is how `==` compares them**, and salted away from the
    // array of the same numbers: the two are not equal, so they must not be made to collide on
    // purpose.
    Bytes(p) -> Ok(hash_bytes(p))
    Object(p) -> hash_object(p, depth, at)

    // **A function hashes by identity, because that is how it compares.** `same` answers false for
    // two functions whatever they are, so nothing is promised here beyond a value that is stable for
    // as long as the closure lives.
    Fn(p) -> Ok(hash_u64(u64(usize(p))))

    // The same bargain a function gets, and for the same reason: `same` answers identity here too.
    Promise(p) -> Ok(hash_u64(u64(usize(p)) + 0x9du64))

    // **Hashed from the numbers it covers, not from how it was written**, because that is how it
    // compares: `1..3` and `1..<4` are equal, so they have to land in the same slot.
    RangeVal(r) ->
        val last = range_reach(r)

        Ok(mix(hash_u64(u64(r.lo) + 0x4e1u64), mix(hash_u64(u64(r.step) + 0x5764u64),
            hash_u64(u64(last) + (if r.has_lo then 2u64 else 0u64) + (if r.has_hi then 1u64 else 0u64)))))
    Native(f) -> Ok(hash_u64(u64(usize(f)) + 0x51u64))

    // A socket is its slot, and its slot is a number -- so unlike a function this hashes by what it
    // *is* rather than by where it happens to live.
    Socket(id, gen) -> Ok(mix(hash_u64(u64(id) + 0x50cu64), hash_u64(u64(gen))))

    // A child is its slot, exactly as a socket is, so it hashes what `same` compares.
    ChildVal(id, gen) -> Ok(mix(hash_u64(u64(id) + 0xc41du64), hash_u64(u64(gen))))
    ChannelVal(id) -> Ok(hash_u64(u64(id) + 0xc4a2u64))

    // An actor is its slot and a message is that slot with a handler's name on it, so both hash what
    // `same` compares -- which is what every arm of this function must do.
    ActorVal(id, gen) -> Ok(mix(hash_u64(u64(id) + 0xac70u64), hash_u64(u64(gen))))
    MessageVal(gen, id, name) ->
        Ok(mix(hash_u64(u64(id) + 0x3e55u64), mix(hash_u64(u64(gen)), message_name_of(usize(name)).hash())))

    // A regular expression is its slot, and equal patterns share one -- so this hashes what `same`
    // compares, as everything in this function must.
    RegexVal(id) -> Ok(hash_u64(u64(id) + 0x2e2au64))

    // An external is its interned path, which is what `same` compares.
    External(path) -> Ok(hash_u64(u64(path) + 0x0e11u64))

    // A shape is its slot too, and one declaration makes one slot -- so this hashes what `same`
    // compares, as everything in this function must.
    Shape(id) -> Ok(hash_u64(u64(id) + 0x5ba9u64))

    // **Every temporal value hashes from exactly what `same` compares**, which is the rule this
    // whole function is written to: a date and an instant holding the same number are not equal, so
    // each kind is salted differently rather than hashing its number bare. A key of `date(2026, 8,
    // 28)` must not find one stored under a duration of 20,693 microseconds.
    InstantVal(us) -> Ok(hash_u64(u64(us) + 0x1751u64))
    DurationVal(us) -> Ok(hash_u64(u64(us) + 0x2752u64))
    DateVal(d) -> Ok(hash_u64(u64(long(d)) + 0x3753u64))
    TimeVal(us) -> Ok(hash_u64(u64(us) + 0x4754u64))
    DateTimeVal(p) -> Ok(mix(hash_u64(u64(long(p.day)) + 0x5755u64), hash_u64(u64(p.us))))
    ZoneVal(id) -> Ok(hash_u64(u64(id) + 0x6756u64))
    ZonedVal(p) -> Ok(mix(hash_u64(u64(p.us) + 0x7757u64), hash_u64(u64(p.zone))))
    PeriodVal(months, days) -> Ok(mix(hash_u64(u64(long(months)) + 0x8758u64), hash_u64(u64(long(days)))))

    // A generator is its slot and its stamp, which is what `same` compares -- identity arrived at
    // from the other direction, as a socket's is.
    Gen(id, gen) -> Ok(mix(hash_u64(u64(id) + 0x9759u64), hash_u64(u64(gen))))

    // **A set and a map hash by identity, because that is how they compare** -- the bargain a
    // function and a promise already take here, and for the same reason: a container whose members
    // may change cannot hash from them, or a key would move out of its own slot the moment somebody
    // added to it. Salted apart so that a set and the map at the same address never collide.
    SetVal(p) -> Ok(hash_u64(u64(usize(p)) + 0x5e7u64))
    MapVal(p) -> Ok(hash_u64(u64(usize(p)) + 0x3a9u64))

    // **The weak pair hashes by identity for the same reason and with one more of its own**: a weak
    // map's entries come and go as the collector decides, so nothing about its contents is stable
    // enough to hash from, and a weak reference's target may be gone by the time it is asked.
    WeakMapVal(p) -> Ok(hash_u64(u64(usize(p)) + 0x7b1u64))
    WeakRefVal(p) -> Ok(hash_u64(u64(usize(p)) + 0x2c5u64))

private hash_real(r: real) -> u64
    val whole = long(r)

    if real(whole) == r then return u64(whole)

    // **A WHOLE REAL TOO LARGE FOR A `long` IS EQUAL TO A BIG INTEGER, SO IT HASHES AS ONE.**
    // `1e30 == pow(10, 30)` -- the comparison is exact both ways -- and a table that hashed the two
    // apart would hold them as separate keys. `from_real` is exact for every finite real and
    // answers nothing for an infinity or a NaN, which is what sends those on to the bits below.
    if r.trunc() == r
        big_from_real(r) match
            Some(n) -> return n.hash()
            None -> ()

    hash_u64(u64(bits_of(r)))
end hash_real

// The bit pattern of a real, for a value that has no integer to stand in for it.
private bits_of(r: real) -> long = long(r * 4194304.0)

private hash_array(p: *ArrayObj, depth: usize, at: Span) -> Hashed
    if depth >= MaxDepth then return Ok(0x7a1cu64)

    // **Order matters here and must**, because `[1, 2]` and `[2, 1]` are not equal.
    var h = hash_u64(u64(p.items.len()) + 0xa11u64)

    for i in 0..<p.items.len()
        h = mix(h, hash_at(p.items.at(i), depth + 1, at)?)

    Ok(h)
end hash_array

// **FNV-1a over the bytes, with the length folded in.** No recursion and no depth, a buffer holding
// nothing but bytes -- so unlike an array this cannot cycle and has no `MaxDepth` to stop at.
private hash_bytes(p: *BytesObj) -> u64
    var h = 0xcbf29ce484222325u64

    for i in 0..<p.data.len()
        h = (h ^ u64(p.data.at(i))) * 0x100000001b3u64

    hash_u64(h + u64(p.data.len()) + 0xb17e5u64)
end hash_bytes

private hash_object(p: *ObjectObj, depth: usize, at: Span) -> Hashed
    if depth >= MaxDepth then return Ok(0x0b1eu64)

    // **Order must NOT matter here, and that is not a stylistic choice.** `same_object` compares two
    // objects by their contents whatever order the fields were written in, so two equal objects would
    // hash differently under any order-sensitive mix -- and a key would be lost in its own table. The
    // fields are therefore summed, which commutes.
    var h = 0u64

    for i in 0..<p.entries.len()
        val e = p.entries.at(i)

        if !e.dead
            h += mix(hash_at(e.key, depth + 1, at)?, hash_at(e.value, depth + 1, at)?)

    Ok(hash_u64(h + u64(p.live)))
end hash_object

// Combine two hashes so that order is kept.
private mix(a: u64, b: u64) -> u64 = hash_u64(a ^ (b + 0x9e3779b97f4a7c15u64 + (a << 6u64) + (a >> 2u64)))

// -- lookup ---------------------------------------------------------------------------------------

// The hash this table keys by, which is not the same question for every table.
//
// **A WEAK MAP KEYS BY IDENTITY AND EVERY OTHER TABLE KEYS STRUCTURALLY**, so the two ask different
// things of a key. `{ a: 1 }` and another `{ a: 1 }` are `==` in slate, so a map finds one under the
// other -- and a weak map keyed that way would be neither JavaScript's `WeakMap` nor implementable
// on a host that has one, its keys being the host's own objects. **It also keeps a collection from
// running a program's `hash` hook**, which `weaken` could not do at all.
//
// **An integer is answered here, before either question is asked**: it is the commonest key there
// is, it carries no hook, and both rules hash it the same way -- `identity_hash` has no arm for it
// and `hash_plain`'s is this line.
@inline
private key_hash(o: *ObjectObj, k: Value, at: Span) -> Hashed = k match
    Int(n) -> if o.by_identity then Ok(identity_hash(k)) else Ok(u64(n))
    _ -> if o.by_identity then Ok(identity_hash(k)) else hash_value(k, at)

// The hash that agrees with `identical`, which is what an identity-keyed table compares with.
//
// **An external hashes by its interned PATH and a builtin by its variant**, neither being an address
// -- and both compare that way, so the two answers are one decision stated twice.
private identity_hash(v: Value) -> u64 = v match
    Object(p) -> hash_u64(u64(usize(p)))
    Array(p) -> hash_u64(u64(usize(p)))
    Bytes(p) -> hash_u64(u64(usize(p)))
    SetVal(p) -> hash_u64(u64(usize(p)))
    MapVal(p) -> hash_u64(u64(usize(p)))
    WeakMapVal(p) -> hash_u64(u64(usize(p)))
    WeakRefVal(p) -> hash_u64(u64(usize(p)))
    Fn(p) -> hash_u64(u64(usize(p)))
    Promise(p) -> hash_u64(u64(usize(p)))
    External(path) -> hash_u64(u64(path) + 0x11u64)
    Native(f) -> hash_u64(u64(usize(f)) + 0x51u64)

    // Nothing else reaches an identity-keyed table, a key it could not free being refused at the
    // call -- but the union has to be covered.
    _ -> 0x4d3fu64

// **Two integers are compared here and nowhere else**, which is `same`'s answer for them without
// the walk that gets there -- the walk exists for hooks and for containers, and an integer has
// neither. An integer against anything else still asks `same`, since `1` finds a key written `1.0`.
// Inlined into the probe loops, so two integer keys cost one comparison and no call.
@inline
private keys_match(o: *ObjectObj, a: Value, b: Value, at: Span) -> Result[bool, Signal] = a match
    Int(x) -> b match
        Int(y) -> Ok(x == y)
        _ -> if o.by_identity then Ok(identical(a, b, at)) else same(a, b, at)
    _ -> if o.by_identity then Ok(identical(a, b, at)) else same(a, b, at)

// Where a key sits, or nothing.
//
// **A search ends at an `Empty` and walks through a `Dead`**, because an entry inserted later may
// have probed past the slot this one used to hold.
private find_entry(o: *ObjectObj, k: Value, h: u64, at: Span) -> Result[Option[usize], Signal]
    if o.index.len() == 0 then return scan_entry(o, k, h, at)

    val slots = o.index.len()
    val mask = slots - 1
    var probe = home(h, mask)
    var steps: usize = 0

    while steps < slots
        val slot = o.index.at(probe)

        if slot == Empty then return Ok(None)

        if slot != Dead
            val where = slot - Bias
            val e = o.entries.at(where)

            if e.hash == h && !e.dead && keys_match(o, e.key, k, at)? then return Ok(Some(where))

        probe = (probe + 1) & mask
        steps += 1

    Ok(None)
end find_entry

// Where a key sits in a table too small to have an index, or nothing.
//
// **The entries are walked in the order they were written and the hash each one carries is
// compared first**, so a step is one integer comparison and a key is only looked at where the
// hashes agree. The answer is the same one the index would have given: a table holds at most one
// live entry per key, so the first match is the only match.
private scan_entry(o: *ObjectObj, k: Value, h: u64, at: Span) -> Result[Option[usize], Signal]
    for i in 0..<o.entries.len()
        val e = o.entries.at(i)

        if e.hash == h && !e.dead && keys_match(o, e.key, k, at)? then return Ok(Some(i))

    Ok(None)
end scan_entry

// Put a position into the index, at the first slot free for it.
private place(ix: *Buf[usize], h: u64, at: usize)
    val slots = ix.len()
    val mask = slots - 1
    var probe = home(h, mask)

    loop
        val slot = ix.at(probe)

        if slot == Empty || slot == Dead
            ix.set(probe, at + Bias)
            return

        probe = (probe + 1) & mask
end place

// Double the index and drop the removed entries.
//
// **Growth is where a table pays for its tombstones**, which is why removal costs nothing at the time:
// the dead entries go here, in one pass, and the positions that shift are rebuilt anyway.
private grow(o: *ObjectObj)
    val was = object_payload(o)
    var kept: Buf[Entry] = buf()

    for i in 0..<o.entries.len()
        val e = o.entries.at(i)

        if !e.dead then kept.push(e)

    o.entries = kept
    o.live = kept.len()

    // **A table still small once its tombstones have gone keeps no index**, which is what stops a
    // small table that is written to and deleted from being indexed the first time it fills. It is
    // also how a large table that has shrunk comes back to the cheap case.
    if kept.len() + 1 <= SmallTable
        o.index = buf()
        object_recharged(o, was)
        return

    var slots = InitialSlots

    while slots < (kept.len() + 1) * 2
        slots = slots * 2

    var ix: Buf[usize] = buf()

    for i in 0..<slots
        ix.push(Empty)

    o.index = ix

    for i in 0..<o.entries.len()
        place(&o.index, o.entries.at(i).hash, i)

    // **Both buffers were replaced, so what this table holds outside the heap has changed** -- and a
    // rehash is where it changes most, the index doubling and the tombstones going.
    object_recharged(o, was)
end grow

// -- what the interpreter calls -------------------------------------------------------------------

// What a key holds, or nothing.
obj_get(o: *ObjectObj, k: Value, at: Span) -> Found
    find_entry(o, k, key_hash(o, k, at)?, at)? match
        None -> Ok(None)
        Some(where) -> Ok(Some(o.entries.at(where).value))

// Whether a key is present.
obj_has(o: *ObjectObj, k: Value, at: Span) -> Result[bool, Signal] = find_entry(o, k, key_hash(o, k, at)?, at)? match
    None -> Ok(false)
    Some(_) -> Ok(true)

// Where an integer key already stands in an indexed table, found with no call -- or `None`, which
// means only "ask the general road", never "absent".
//
// **This is `find_entry` for the one case a set or a map method meets nearly every time**, inlined
// into the natives so that `m.set(k, v)` and `s.has(k)` on an integer key are a hash, a probe and a
// comparison where they were a call into `obj_put` or `obj_has` and everything that function has to
// be ready for. Everything it is not sure of it hands back: a table too small for an index (`scan_entry`
// is the road there), one keyed by identity, a key it did not find (which the general road then
// inserts or answers `false` for), and -- the one that matters for correctness -- an entry whose hash
// agrees but whose key is not an integer. That is `1.0` stored and `1` asked, which `same` says is
// the same key; answering "not found" there would put a second entry beside the first.
@inline
obj_int_at(o: *ObjectObj, n: long) -> Option[usize]
    val slots = o.index.len()

    if slots == 0 || o.by_identity then return None

    val h = u64(n)
    val mask = slots - 1
    var probe = home(h, mask)
    var steps: usize = 0

    while steps < slots
        val slot = o.index.at(probe)

        if slot == Empty then return None

        if slot != Dead
            val where = slot - Bias
            val e = o.entries.at(where)

            if e.hash == h && !e.dead
                return e.key match
                    Int(m) -> if m == n then Some(where) else None
                    _ -> None

        probe = (probe + 1) & mask
        steps += 1

    None
end obj_int_at

// The most slots any live key of the table has to look at past its own `home` before it finds
// itself -- nothing for a table too small to have an index.
//
// **The witness for `home`**, which no answer a program prints can show: a table that put every
// key in one slot answers every lookup correctly, one probe at a time. Not `private`:
// `tests_mapset_chain.sysl` asserts it stays small for a run of integers and for a strided one.
longest_probe(o: *ObjectObj) -> usize
    val slots = o.index.len()

    if slots == 0 then return 0

    val mask = slots - 1
    var worst: usize = 0

    for probe in 0..<slots
        val slot = o.index.at(probe)

        if slot == Empty || slot == Dead then continue

        val start = home(o.entries.at(slot - Bias).hash, mask)
        val far = (probe + slots - start) & mask

        if far > worst then worst = far

    worst
end longest_probe

// Write a key, keeping the position it already had if it has one.
//
// **Re-writing a field does not move it**, which is what makes the order `keys()` answers the order
// the fields were *first* written -- the rule JavaScript and Python both follow.
obj_put(o: *ObjectObj, k: Value, v: Value, at: Span) -> Step
    if o.frozen then return fault(at, write_refusal(o, value_text(k)))

    val h = key_hash(o, k, at)?

    find_entry(o, k, h, at)? match
        Some(where) ->
            var e = o.entries.at(where)

            e.value = v
            o.entries.set(where, e)
        None ->
            // **Two thirds full is where an open-addressed table's probes start to lengthen** --
            // and below `SmallTable` there is no index to fill, so what makes one is passing that
            // line rather than filling anything.
            if o.index.len() == 0
                if o.entries.len() + 1 > SmallTable then grow(o)
            elif (o.entries.len() + 1) * 3 >= o.index.len() * 2
                grow(o)

            val where = o.entries.len()

            entry_push(o, Entry(h, k, v, false))

            if o.index.len() != 0 then place(&o.index, h, where)

            o.live += 1

            // **Asked only where a key is NEW**, which a class object's marks are exactly once. An
            // overwrite cannot make a table hold a mark it did not hold before.
            k match
                Str(p) -> if val_key(p.s) then o.has_vals = true
                _ -> ()

    Ok(Null)
end obj_put

// Take a key out. Answers whether there was one.
// What to say when something writes into a data value.
//
// **The fix is the whole of the sentence.** A reader told only that the write is refused has nowhere
// to go; told that `with` answers a copy that differs, they have the line to write. Naming the field
// is what says which write it was, a statement often holding several.
//
// Not `private`: the machine writes a field through `obj_put_name`, which cannot report anything, so
// `run_frames.sysl` asks the question itself and says this.
frozen_complaint(what: string) -> string =
    s"${what} belongs to a data value, and a data value does not change -- `v with { ${what}: ... }` answers a new one that differs there"

// What to say when something writes into a value a program handed to `freeze`.
//
// **A SEPARATE SENTENCE FROM A DATA VALUE'S, and the reason is the fix each one names.** A data
// value was never writable and `with` is the line to write instead; a frozen value was writable
// until the program said otherwise, so what a reader wants is the `freeze` they wrote and the fact
// that a copy is still free to change. Told the data-value sentence about an object they built
// themselves, a reader goes looking for a `data` declaration that is not there.
//
// Not `private`: `site_cache.sysl` and `index.sysl` both refuse a write and say this.
sealed_complaint(what: string) -> string =
    s"${what} belongs to a frozen value, and `freeze` is what closed it -- a copy made with `with` or a spread is a new value that is free to change"

// The sentence a refused write gets, which of the two it is being the object's own answer.
//
// Not `private`: read wherever a write is refused.
write_refusal(o: *ObjectObj, what: string) -> string =
    if o.data_value then frozen_complaint(what) else sealed_complaint(what)

// What a program gets for changing a frozen value that is not keyed by names a reader wrote.
//
// **IT NAMES THE OPERATION RATHER THAN A FIELD, which is the difference from an object's sentence.**
// `push` is not a key and `clear` is not a member, so the shape above reads as nonsense about one;
// what a reader wants here is the name of the call that was refused.
//
// Not `private`: every collection refuses a write in the file that implements it.
frozen_kind_complaint(kind: string, name: string) -> string =
    s"this ${kind} is frozen, and `${name}` would change it -- `freeze` is what closed it"

// The same, plus the copy that would have worked, which every kind but one has.
//
// Not `private`: read beside `frozen_kind_complaint`.
frozen_copy_complaint(kind: string, name: string, copy: string) -> string =
    frozen_kind_complaint(kind, name) + s", and ${copy} answers a copy that is free to change"

// Not `private`: `array.sysl` refuses a mutator and `runtime.sysl` refuses `xs[i] = v`.
frozen_array_complaint(name: string) -> string = frozen_copy_complaint("array", name, "`[...xs]`")

// Not `private`: `builtin.sysl`'s `push` and `runtime.sysl`'s `b[i] = v` both write through bytes.
frozen_bytes_complaint(name: string) -> string =
    frozen_copy_complaint("buffer", name, "`bytes(b.toArray())`")

// Not `private`: `setmap.sysl` refuses `add`, `delete` and `clear`.
frozen_set_complaint(name: string) -> string = frozen_copy_complaint("set", name, "`Set(s)`")

// Not `private`: `setmap.sysl` refuses `set`, `delete` and `clear`.
frozen_map_complaint(name: string) -> string = frozen_copy_complaint("map", name, "`Map(m)`")

// **A weak map is the one frozen kind with NO COPY TO POINT AT**, which is what the kind is for: a
// walk over one is the very thing it refuses, so there is no way to build a second holding what the
// first holds.
//
// Not `private`: `weak.sysl` refuses `set` and `delete`.
frozen_weak_map_complaint(name: string) -> string = frozen_kind_complaint("weak map", name)

// What `with` says about a field a data value never declared, or nothing where the field is one it
// has.
//
// **A data value's fields are the ones its declaration named, and `with` may only differ at one of
// them.** `One(5) with { id: "3" }` answered `One(5, "3")` -- a variant carrying a field its own type
// does not have, printed as though the declaration had a second positional one. Nothing else in the
// language can build such a value, so this is the whole of the hole.
//
// **The value's own keys ARE the declared list**, which is what makes the check a lookup rather than
// a walk up to the shape: a variant is built by a constructor that names every field, so a field the
// declaration has is a field the value has.
//
// Not `private`: `run_frames.sysl` asks it once per key written and once per key merged.
unknown_field_complaint(o: *ObjectObj, k: Value) -> Option[string]
    if !o.data_value then return None
    if !walked_key(o, k) then return None

    for i in 0..<o.entries.len()
        val e = o.entries.at(i)

        if !e.dead && same_plain_key(e.key, k) then return None

    val named = variant_name(o) match
        Some(n) -> s"`${n}`"
        None -> "this data value"

    Some(s"${named} has no field `${value_text(k)}` -- a data value's fields are the ones its declaration named, and `with` answers a copy that differs at one of them")
end unknown_field_complaint

// Whether two keys are the same key, for a comparison that may not fault.
//
// **A hook cannot run here**, `with` being mid-instruction with a half-built object on the stack, so
// this is the plain comparison and nothing else -- which is all a field name ever needs.
private same_plain_key(a: Value, b: Value) -> bool
    a match
        Str(p) -> b match
            Str(q) -> p.s == q.s
            _ -> false
        _ -> false
end same_plain_key

obj_remove(o: *ObjectObj, k: Value, at: Span) -> Result[bool, Signal]
    if o.frozen then return Err(failure(at, write_refusal(o, value_text(k))))

    val h = key_hash(o, k, at)?

    find_entry(o, k, h, at)? match
        None -> Ok(false)
        Some(where) ->
            obj_drop_at(o, where)
            Ok(true)
end obj_remove

// Tombstone the entry at a position, given the position rather than the key.
//
// **Cut out of `obj_remove` so that the COLLECTOR can drop an entry**, which is what a weak map's
// `weaken` hook does to a key that did not survive. Hashing that key again is exactly what a hook
// may not do -- a slate value's hash may run a class's own `hash`, and no program code runs inside a
// collection -- so this works from `e.hash`, which the entry has carried since it was written.
//
// Not `private`: `collector.sysl`'s `weaken_weak_map` is the other caller.
obj_drop_at(o: *ObjectObj, where: usize)
    var e = o.entries.at(where)
    val h = e.hash

    e.dead = true
    e.key = Null
    e.value = Null
    o.entries.set(where, e)
    o.live -= 1

    // A table with no index has no position to take back -- the tombstone in the entries is the
    // whole of the removal there.
    if o.index.len() == 0 then return

    val slots = o.index.len()
    val mask = slots - 1
    var probe = home(h, mask)

    loop
        if o.index.at(probe) == where + Bias
            o.index.set(probe, Dead)
            break

        probe = (probe + 1) & mask
end obj_drop_at

// The keys, in the order they were first written.
obj_keys(o: *ObjectObj) -> Buf[Value]
    var out: Buf[Value] = buf()

    for i in 0..<o.entries.len()
        val e = o.entries.at(i)

        if !e.dead && walked_key(o, e.key) then out.push(e.key)

    out
end obj_keys

// -- the string fast path -------------------------------------------------------------------------
//
// **`o.name` is the commonest thing a program does to an object, and it must not allocate.** A key is
// a `Value` now, so the obvious spelling of a field read would box the name into a `StrObj` on the
// collected heap once per access, and then drop it. These take the sysl `string` straight and hash it
// exactly as `hash_value` hashes a `Str`, so the two agree on every bucket.

// Where a named field sits in a table too small to have an index, or nothing.
//
// **THE NAME IS COMPARED OUTRIGHT AND NEVER HASHED, which is the whole of what the small case buys
// a field read.** Hashing a string walks its bytes, and a handful of string comparisons -- nearly
// all of which stop at the first character, and every one of which stops at the length -- costs
// less than one walk of the name being looked up.
private scan_named(o: *ObjectObj, name: string) -> Option[usize]
    for i in 0..<o.entries.len()
        val e = o.entries.at(i)

        if !e.dead
            e.key match
                Str(p) -> if p.s == name then return Some(i)
                _ -> ()

    None
end scan_named

private find_named(o: *ObjectObj, name: string, h: u64) -> Option[usize]
    val slots = o.index.len()
    val mask = slots - 1
    var probe = home(h, mask)
    var steps: usize = 0

    while steps < slots
        val slot = o.index.at(probe)

        if slot == Empty then return None

        if slot != Dead
            val at = slot - Bias
            val e = o.entries.at(at)

            if e.hash == h && !e.dead
                e.key match
                    Str(p) -> if p.s == name then return Some(at)
                    _ -> ()

        probe = (probe + 1) & mask
        steps += 1

    None
end find_named

// What a named field holds, the object's own or a proto's, without boxing the name.
//
// **Without a span to complain with**, so a circular chain simply answers nothing: every caller is a
// hash, an equality or a pattern, and none of those has anywhere to report.
//
// Not `private`: `index.sysl` matches an object pattern with it, an object pattern asking the same
// question `.` does -- whether this value HAS the field, wherever it keeps it.
field_through(o: *ObjectObj, name: string) -> Option[Value]
    var up = o
    var depth: usize = 0

    loop
        obj_get_name(up, name) match
            Some(v) -> return Some(v)
            None -> ()

        depth += 1

        if depth >= 64 then return None

        up = obj_get_name(up, "proto") match
            Some(Object(p)) -> p
            _ -> return None
end field_through

obj_get_name(o: *ObjectObj, name: string) -> Option[Value]
    // **The two-way switch is written out here rather than read off `obj_index_named` below**, and
    // that is measured rather than tidy: a pattern match walking an object asks this twelve million
    // times in `bench/options`, and routing it through one more call read +2.3% there.
    val found = if o.index.len() == 0 then scan_named(o, name) else find_named(o, name, name.hash())

    found match
        None -> None
        Some(at) -> Some(o.entries.at(at).value)

// WHERE a named field sits in this object's own table, rather than what it holds.
//
// Not `private`: an inline cache remembers the position so that the next lookup at the same
// instruction is one key comparison. `site_cache.sysl` is the reader.
obj_index_named(o: *ObjectObj, name: string) -> Option[usize] =
    if o.index.len() == 0 then scan_named(o, name) else find_named(o, name, name.hash())

// The same, for a caller that already has the name's hash -- which the machine does, a field name
// being hashed once when it is interned.
//
// **The summary is asked FIRST and is the whole point of this form**: a name whose bit is clear is
// not in the table, so a miss costs one `and` rather than a walk.
obj_index_hashed(o: *ObjectObj, name: string, h: u64) -> Option[usize]
    if obj_lacks(o, h) then return None

    if o.index.len() == 0 then scan_named(o, name) else find_named(o, name, h)
end obj_index_hashed

// Whether this table is CERTAIN to have no key of this hash. False means only that it may.
obj_lacks(o: *ObjectObj, h: u64) -> bool = (o.keys_bloom >> (h & 63)) & 1 == 0

// What the entry at a position holds, which a caller that already has the position asks.
//
// Not `private`: `site_cache.sysl` reads and writes a position it checked for itself.
obj_value_at(o: *ObjectObj, at: usize) -> Value = o.entries.at(at).value

// Write over the value at a position, leaving the key and the hash where they are.
obj_set_value_at(o: *ObjectObj, at: usize, v: Value)
    var e = o.entries.at(at)

    e.value = v
    o.entries.set(at, e)

// Write a named field. **Only an insert boxes the name**, because only then is a key stored -- and
// only an insert hashes it, a small table finding an existing field by comparing the name.
obj_put_name(o: *ObjectObj, name: string, v: Value)
    obj_put_named(o, name, name.hash(), v) match
        _ -> ()

// The same write for a caller that already holds the name's hash, answering WHERE the field ended
// up so that an instruction can remember the position.
obj_put_named(o: *ObjectObj, name: string, h: u64, v: Value) -> usize
    val small = o.index.len() == 0
    val found = if obj_lacks(o, h) then None elif small then scan_named(o, name) else find_named(o, name, h)

    found match
        Some(at) ->
            obj_set_value_at(o, at, v)
            return at
        None -> ()

    if small
        if o.entries.len() + 1 > SmallTable then grow(o)
    elif (o.entries.len() + 1) * 3 >= o.index.len() * 2
        grow(o)

    val at = o.entries.len()

    entry_push(o, Entry(h, str_value(name), v, false))

    if o.index.len() != 0 then place(&o.index, h, at)

    o.live += 1

    if val_key(name) then o.has_vals = true

    at
end obj_put_named

// The same write for a caller that holds the key's CELL as well as its text and hash, which is what
// an object literal and a `with { ... }` hold: every key either writes is a literal, whose cell
// `literal.sysl` keeps and whose hash the unit took when it interned the text.
//
// **Nothing is hashed and nothing is boxed**, which is the whole difference from `obj_put`: a key a
// literal writes is one the compiler has already seen. The slot is the one `obj_put` would have
// found, the hash being `hash_value`'s answer for a string and the comparison the same text
// equality. The table is fresh -- a literal's, or the copy a `with` is filling, which is frozen only
// after its writes and never keyed by identity -- so neither of
// `obj_put`'s other two questions has anything to ask.
obj_put_keyed(o: *ObjectObj, k: Value, name: string, h: u64, v: Value)
    val small = o.index.len() == 0
    val found = if obj_lacks(o, h) then None elif small then scan_named(o, name) else find_named(o, name, h)

    found match
        Some(at) ->
            obj_set_value_at(o, at, v)
            return
        None -> ()

    if small
        if o.entries.len() + 1 > SmallTable then grow(o)
    elif (o.entries.len() + 1) * 3 >= o.index.len() * 2
        grow(o)

    val at = o.entries.len()

    entry_push(o, Entry(h, k, v, false))

    if o.index.len() != 0 then place(&o.index, h, at)

    o.live += 1

    if val_key(name) then o.has_vals = true
end obj_put_keyed
