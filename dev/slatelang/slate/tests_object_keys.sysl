module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// An object literal's keys arrive with their cells and their hashes (`compose_object`), and the
// table takes them through `obj_put_keyed` rather than `obj_put`. What these pin is that the two
// writes are ONE write: the same hash, the same slot, the same winner for a key written twice -- so
// a table a literal built answers every lookup the general path makes, and the other way about. The
// same answers as a running program sees them, on both back ends, are `tests/lang/objectkeys.sl`.

// Two tables written with the same keys and values, one each way.
private struct Pair
    plain: *ObjectObj
    keyed: *ObjectObj

private both_ways(names: Buf[string]) -> Pair
    val plain = new_object()
    val keyed = new_object()

    hold(Object(plain))
    hold(Object(keyed))

    for i in 0..<names.len()
        val n = names.at(i)
        val v = Int(long(i))

        obj_put(plain, str_value(n), v, point(0)) match
            _ -> ()

        obj_put_keyed(current(), keyed, str_value(n), n, n.hash(), v)

    Pair(plain, keyed)
end both_ways

// The two tables hold the same entries in the same places, and their indexes put every key in the
// same slot.
private assert_same_table(p: Pair)
    assert_eq(p.keyed.entries.len(), p.plain.entries.len(), "the same number of entries")
    assert_eq(p.keyed.live, p.plain.live, "the same number live")
    assert_eq(p.keyed.keys_bloom, p.plain.keys_bloom, "the same summary")
    assert_eq(p.keyed.has_vals, p.plain.has_vals, "the same answer about marks")

    for i in 0..<p.plain.entries.len()
        val a = p.plain.entries.at(i)
        val b = p.keyed.entries.at(i)

        assert_eq(b.hash, a.hash, s"entry ${str(i)} carries the hash `obj_put` gave it")
        assert(same_plain_text(a.key, b.key), s"entry ${str(i)} holds the same key")
        assert(same_plain_text(a.value, b.value), s"entry ${str(i)} holds the same value")

    assert_eq(p.keyed.index.len(), p.plain.index.len(), "the same index size")

    for s in 0..<p.plain.index.len()
        assert_eq(p.keyed.index.at(s), p.plain.index.at(s), s"slot ${str(s)} holds the same position")
end assert_same_table

private same_plain_text(a: Value, b: Value) -> bool = value_text(a) == value_text(b)

// The general lookup, which hashes the key for itself, finds what the keyed write put.
private assert_found_plainly(o: *ObjectObj, names: Buf[string])
    for i in 0..<names.len()
        obj_get(o, str_value(names.at(i)), point(0)) match
            Ok(Some(_)) -> ()
            _ -> assert(false, s"`${names.at(i)}` is not found by the general lookup")
end assert_found_plainly

private names_of(prefix: string, n: usize) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<n
        out.push(prefix + str(i))

    out

@test
THE_KEYED_WRITE_PUTS_EVERY_KEY_WHERE_THE_PLAIN_ONE_DOES()
    reset_vm()
    reset_heap()

    // Across the line where a table builds an index, and well past two rehashes.
    for n in [1, 2, 7, 8, 9, 12, 30, 70]
        val names = names_of("f", usize(n))
        val p = both_ways(names)

        assert_same_table(p)
        assert_found_plainly(p.keyed, names)
end THE_KEYED_WRITE_PUTS_EVERY_KEY_WHERE_THE_PLAIN_ONE_DOES

@test
A_KEY_WRITTEN_TWICE_IS_ONE_ENTRY_WITH_THE_LATER_VALUE()
    reset_vm()
    reset_heap()

    var names: Buf[string] = buf()

    names.push("a")
    names.push("b")
    names.push("a")

    val p = both_ways(names)

    assert_same_table(p)
    assert_eq(p.keyed.entries.len(), 2usize, "the second `a` wrote over the first")

    obj_get_name(p.keyed, "a") match
        Some(Int(v)) -> assert_eq(v, long(2), "the later value won")
        _ -> assert(false, "`a` is gone")
end A_KEY_WRITTEN_TWICE_IS_ONE_ENTRY_WITH_THE_LATER_VALUE

@test
A_KEY_SHARING_PROTOS_SUMMARY_BIT_IS_STILL_ITS_OWN_ENTRY()
    reset_vm()
    reset_heap()

    // A name whose hash lands on `proto`'s bit of the summary, so the keyed write cannot skip the
    // search on the summary's word and has to compare the text.
    val bit = "proto".hash() & 63
    var twin = ""

    for i in 0..<10000
        val n = "t" + str(i)

        if n.hash() & 63 == bit
            twin = n
            break

    assert(twin != "", "no name shares proto's bit")

    var names: Buf[string] = buf()

    names.push("proto")
    names.push(twin)
    names.push("proto")

    val p = both_ways(names)

    assert_same_table(p)
    assert_eq(p.keyed.entries.len(), 2usize, "`proto` and its twin are two keys")
    assert_found_plainly(p.keyed, names)
end A_KEY_SHARING_PROTOS_SUMMARY_BIT_IS_STILL_ITS_OWN_ENTRY

@test
A_KEY_THAT_IS_A_MARK_IS_NOTED_THE_WAY_OBJ_PUT_NOTES_IT()
    reset_vm()
    reset_heap()

    var names: Buf[string] = buf()

    names.push("x")
    names.push(ValPrefix + "x")

    val p = both_ways(names)

    assert_same_table(p)
    assert(p.keyed.has_vals, "the mark was noted")
end A_KEY_THAT_IS_A_MARK_IS_NOTED_THE_WAY_OBJ_PUT_NOTES_IT

// -- what the compiler emits -----------------------------------------------------------------------

@test
AN_OBJECT_LITERAL_PUSHES_NO_KEY_AND_NAMES_ITS_KEYS_IN_THE_UNIT()
    assert_eq(out("val o = { alpha: 1, beta: 2, alpha: 3 }\nprint(o.alpha + o.beta)"), "5")

    val u = running_unit()
    var found = false

    for c in 0..<u.chunks.len()
        val code = u.chunks.at(c).code

        for i in 0..<code.len()
            code.at(i).op match
                PushStr(k) ->
                    val s = u.strings.at(usize(k))

                    assert(s != "alpha" && s != "beta", s"the key `${s}` was pushed")
                MakeObject(first, n) ->
                    if n == 3
                        var said: Buf[string] = buf()

                        for j in 0..<usize(n)
                            said.push(u.strings.at(usize(u.object_keys.at(usize(first) + j))))

                        assert_eq(said.at(0), "alpha")
                        assert_eq(said.at(1), "beta")
                        assert_eq(said.at(2), "alpha")
                        found = true
                _ -> ()

    assert(found, "no `MakeObject` names the literal's three keys")
end AN_OBJECT_LITERAL_PUSHES_NO_KEY_AND_NAMES_ITS_KEYS_IN_THE_UNIT

@test
A_LITERALS_KEYS_ARE_THE_LITERAL_CELLS()
    // **The key a literal writes is the cell `literal.sysl` keeps**, so a loop of constructions
    // makes one string per key for the whole run rather than one per object.
    assert_eq(out("var xs = []\nfor i in 0..<50\n    push(xs, { quux: i })\nprint(xs[49].quux)"), "49")

    val u = running_unit()
    val kept = current().literals
    var cell = false

    for k in 0..<u.strings.len()
        if u.strings.at(k) == "quux" && k < kept.len()
            kept.at(k) match
                Str(_) -> cell = true
                _ -> ()

    assert(cell, "the key has no literal cell")
end A_LITERALS_KEYS_ARE_THE_LITERAL_CELLS

// -- `with { ... }`, which writes its keys the same way ------------------------------------------

@test
A_WITH_PUSHES_NO_KEY_AND_NAMES_ITS_KEYS_IN_THE_UNIT()
    assert_eq(out("val b = { gamma: 1 }\nval o = b with { gamma: 5, delta: 2, gamma: 7 }\nprint(o.gamma + o.delta)"), "9")

    val u = running_unit()
    var found = false

    for c in 0..<u.chunks.len()
        val code = u.chunks.at(c).code

        for i in 0..<code.len()
            code.at(i).op match
                PushStr(k) ->
                    val s = u.strings.at(usize(k))

                    assert(s != "gamma" && s != "delta", s"the key `${s}` was pushed")
                WithObject(first, n) ->
                    assert_eq(n, 3u32, "the `with` writes three keys")

                    var said: Buf[string] = buf()

                    for j in 0..<usize(n)
                        said.push(u.strings.at(usize(u.object_keys.at(usize(first) + j))))

                    assert_eq(said.at(0), "gamma")
                    assert_eq(said.at(1), "delta")
                    assert_eq(said.at(2), "gamma")
                    found = true
                _ -> ()

    assert(found, "no `WithObject` names the `with`'s three keys")
end A_WITH_PUSHES_NO_KEY_AND_NAMES_ITS_KEYS_IN_THE_UNIT

@test
A_WITH_KEEPS_THE_BASES_ORDER_AND_THE_LAST_VALUE_OF_A_KEY_WRITTEN_TWICE()
    assert_eq(out("val o = { a: 1, b: 2 } with { b: 3, c: 4, b: 5 }\nprint(keys(o))\nprint(o.b)"), "[\"a\", \"b\", \"c\"]\n5")

@test
AN_EMPTY_WITH_NAMES_NO_KEYS_AND_COPIES()
    assert_eq(out("val b = { a: 1 }\nval o = b with { }\no.a = 2\nprint(b.a, o.a)"), "1 2")

@test
A_WITH_ON_A_DATA_VALUE_STILL_ASKS_THE_BASE_FOR_EACH_KEY()
    // **The complaint is asked of the base**, so the second of two writes to one field is a field
    // the type has, and a field it does not have is refused even after one it does.
    val shape = "data WkShape\n    WkRect(w, h)\n"

    assert_eq(out(shape + "val r = WkRect(1, 2) with { w: 3, h: 4, w: 5 }\nprint(r.w, r.h)"), "5 4")
    assert(fails(shape + "print(WkRect(1, 2) with { w: 3, depth: 4 })").contains("`WkRect` has no field `depth`"))

@test
A_WITH_ON_A_VALUE_THAT_IS_NOT_AN_OBJECT_IS_STILL_REFUSED()
    assert(fails("val xs = [1]\nprint(xs with { a: 1 })").contains("`with` copies an object, and this is"))
