module dev.slatelang.slate

import sh.sysl.gc
import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// The machine.
//
// **The operand stack and the frame stack are ordinary arrays, and that is the point.** The walker
// kept its working values in sysl locals, which the mark phase cannot see -- so every one of them had
// to be pushed onto a shadow stack by hand, and a forgotten `hold` was a crash that only appeared
// under memory pressure. Here the tracer walks two arrays and is finished.
//
// **A frame is data, which is what `await` will need.** Suspending a call means leaving its frame
// where it is and running something else; resuming means putting it back. Neither is possible while
// the state of a call is sysl's own call stack, and that -- not speed -- is why this exists.

// One call in progress.
struct Frame
    chunk: usize
    pc: usize

    // The scope names are looked up in. A block moves this to a child and back.
    scope: *EnvObj

    // How tall the operand stack was when this call started. `Ret` cuts back to it.
    base: usize

// Everything one line of execution is: its values, its calls, and where it is looking names up.
//
// **Bundled because `await` moves them together.** Suspending a call means setting all of them aside
// and running something else; resuming means putting them back. They were three module variables
// until it became clear that no operation ever wants one without the others.
struct Machine
    stack: Buf[Value]
    frames: Buf[Frame]

    // The promise this line of execution settles when it finishes, and null for the main program.
    //
    // **This is the whole of what makes a machine a coroutine.** An `async` function is called by
    // giving its body a machine of its own with this filled in; the caller is handed the promise
    // straight back and carries on, and whatever the body eventually answers -- a value, or a fault --
    // is written here for whoever awaited it.
    promise: *PromiseObj

    // The scope the running frame is looking names up in. **Not a sysl local, and that is not a style
    // choice**: `alloc` can collect at any allocation, so the scope in hand has to be reachable from
    // the root function at every instant. Keeping it in a local once swept the whole live scope chain
    // out from under the machine.
    scope: *EnvObj

    // **Whether this slot holds something, said rather than inferred.** Emptiness was read off the
    // frames and the scope until a machine parked with values on its stack and nothing else matched
    // the same test -- and the next park wrote over it.
    live: bool

// The line of execution currently running.
var vm: Machine = Machine(buf(), buf(), null, null, true)

// The ones set aside. **Empty until `await` exists**, and here now because the thing that makes a
// coroutine possible is that its state is data rather than sysl's own call stack -- which is the
// whole reason the tree-walker was replaced.
var parked: Buf[Machine] = buf()

// Set the running machine aside and answer where it went. The caller gets a clean one.
park() -> usize
    val saved = vm

    vm = Machine(buf(), buf(), null, null, true)

    for i in 0..<parked.len()
        if !parked.at(i).live
            parked.set(i, saved)
            return i

    parked.push(saved)
    parked.len() - 1
end park

// Put one back, and answer what was running in its place.
unpark(id: usize) -> Machine
    val displaced = vm

    vm = parked.at(id)
    parked.set(id, Machine(buf(), buf(), null, null, false))
    displaced
end unpark


// How deep a slate program may call.
//
// **A machine has to impose this, where a tree-walker got it imposed on it.** The walker recursed in
// sysl, so runaway recursion exhausted the host stack and the process died with no diagnostic and
// none of the output it had already produced (card 0299). Frames live in an ordinary array here, so
// nothing stops them but this -- and a limit slate owns is a limit slate can *report*, pointing at
// the call that went one too deep.
//
// Ten thousand is roughly what node and the JVM allow, and far past any honest recursion; a program
// that wants more depth than this wants a loop.
private const MaxCallDepth: usize = 10000

// The unit being run.
//
// **Module storage, because a hook has to reach it.** A user-supplied `equals` is called from inside
// a table lookup, which is called from `same`, which knows nothing about units -- so the chunk it
// needs is found here rather than threaded through every comparison.
var current_unit: Unit = new_unit()

// Empty the machine between runs.
reset_vm()
    vm = Machine(buf(), buf(), null, null, true)
    parked.clear()

// Everything the machine can still reach, for the collector.
//
// **This replaces most of the shadow stack.** What is left of `hold`/`release` is only what code
// outside the machine holds -- a native builtin building an array, say.
mark_vm(h: *gc.Heap)
    mark_machine(h, vm)

    // **Every parked line of execution is a root too.** A suspended call is not running, and is not
    // therefore any less alive -- everything it will touch when it resumes has to survive until then.
    for i in 0..<parked.len()
        if parked.at(i).live then mark_machine(h, parked.at(i))

private mark_machine(h: *gc.Heap, m: Machine)
    for i in 0..<m.stack.len()
        mark_value(h, m.stack.at(i))

    for i in 0..<m.frames.len()
        gc.mark(h, ptr_cast(m.frames.at(i).scope))

    gc.mark(h, ptr_cast(m.scope))
    gc.mark(h, ptr_cast(m.promise))

// -- running ---------------------------------------------------------------------------------------

private pop() -> Value
    val v = vm.stack.at(vm.stack.len() - 1)

    vm.stack.truncate(vm.stack.len() - 1)
    v

private peek(back: usize) -> Value = vm.stack.at(vm.stack.len() - 1 - back)

// Run a chunk to completion and answer what it left.
run_chunk(u: *Unit, start: usize, scope0: *EnvObj) -> Step
    // **Where this call stops unwinding.** A native can call back into slate -- a user `equals` does
    // exactly that -- so a nested run must hand back at its own depth rather than at an empty stack.
    val floor = vm.frames.len()
    val outer_scope = vm.scope

    vm.scope = scope0
    execute(u, start, 0, vm.stack.len(), floor, outer_scope)
end run_chunk

// Carry on from where an `await` left off.
//
// **The frame on top says where.** `Await` writes the frame it was standing in back before it parks,
// which is the one thing `execute` never does for itself -- so putting a machine back is popping that
// frame and starting the loop at the numbers in it.
//
// The floor is zero and the outer scope is null because a coroutine's machine is its own: it was
// created empty by the call that started it, so there is nothing underneath to hand back to.
// Not `private`: `private` in sysl is private to the *file*, and the scheduler in `async.sysl` is
// what puts a machine back.
resume_chunk(u: *Unit) -> Step
    val back = vm.frames.at(vm.frames.len() - 1)

    vm.frames.truncate(vm.frames.len() - 1)
    vm.scope = back.scope
    execute(u, back.chunk, back.pc, back.base, 0, null)
end resume_chunk

// The instruction loop.
//
// **The instruction pointer and the scope are sysl locals rather than fields of the top frame**, and
// written back only when a call pushes or pops one -- or when an `await` suspends. Reading them out of
// a `Buf` on every instruction would copy a whole frame per step.
private execute(u: *Unit, start: usize, from: usize, base0: usize, floor: usize, outer_scope: *EnvObj) -> Step
    var chunk_ix = start
    var pc = from
    var base = base0
    var code = u.chunks.at(chunk_ix).code

    loop
        if pc >= code.len()
            // A chunk that ran off its end answers null, which only happens for an empty body.
            vm.stack.push(Null)
            pc = code.len()

        val ins = code.at(pc)
        val at = ins.at

        pc += 1

        ins.op match
            PushNil -> vm.stack.push(Null)
            PushUndefined -> vm.stack.push(Undefined)
            PushBool(v) -> vm.stack.push(Bool(v))
            PushInt(v) -> vm.stack.push(Int(v))
            PushReal(v) -> vm.stack.push(Real(v))
            PushStr(k) -> vm.stack.push(str_value(u.strings.at(k)))

            LoadName(k) ->
                val name = u.strings.at(k)

                lookup(vm.scope, name) match
                    Some(v) -> vm.stack.push(v)
                    None -> return fault(at, s"`${name}` is not defined")
            DeclareVal(k) ->
                val v = pop()

                keepable(v, at, s"bound to `${u.strings.at(k)}`")?
                declare(vm.scope, u.strings.at(k), v, false)
            DeclareVar(k) ->
                val v = pop()

                keepable(v, at, s"bound to `${u.strings.at(k)}`")?
                declare(vm.scope, u.strings.at(k), v, true)
            StoreName(k) ->
                val name = u.strings.at(k)

                val stored = pop()

                keepable(stored, at, s"written to `${name}`")?

                assign_name(vm.scope, name, stored) match
                    Written -> ()
                    Immutable -> return fault(at, s"`${name}` is a `val`, so it is written once")
                    Unknown -> return fault(at, s"`${name}` is not defined")

            UnaryOp(op) ->
                val v = pop()

                vm.stack.push(unary(op, v, at)?)
            BinaryOp(op) ->
                val b = pop()
                val a = pop()

                vm.stack.push(on_values(op, a, b, at)?)

            MakeArray(n) ->
                var items: Buf[Value] = buf()

                for i in 0..<n
                    keepable(peek(n - 1 - i), at, "put in an array")?
                    items.push(peek(n - 1 - i))

                // **Allocated before the stack shrinks.** Between the truncate and the alloc the
                // elements would live only in `items`, which the mark phase cannot see -- and `alloc`
                // collects when the heap is full.
                val made = Array(new_array(items))

                vm.stack.truncate(vm.stack.len() - n)
                vm.stack.push(made)
            MakeObject(n) ->
                val o = new_object()
                val mark = root_mark()

                hold(Object(o))

                for i in 0..<n
                    val key = peek((n - 1 - i) * 2 + 1)
                    val value = peek((n - 1 - i) * 2)

                    keepable(value, at, "put in an object")?

                    obj_put(o, key, value, at)?

                release(mark)
                vm.stack.truncate(vm.stack.len() - n * 2)
                vm.stack.push(Object(o))

            GetIndex ->
                val k = pop()
                val target = pop()

                vm.stack.push(read_at(target, k, at)?)
            SetIndex ->
                val v = pop()
                val k = pop()
                val target = pop()

                keepable(v, at, "stored")?
                keepable(k, at, "used as a key")?

                store_at(target, k, v, at)?
            GetField(k) ->
                val target = pop()

                vm.stack.push(read_field(target, u.strings.at(k), at)?)
            SetField(k) ->
                val v = pop()

                keepable(v, at, s"stored in `${u.strings.at(k)}`")?

                pop() match
                    Object(o) -> obj_put_name(o, u.strings.at(k), v)
                    other -> return fault(at, s"a field belongs to an object, and this is ${other.type_name()}")

            Jump(to) -> pc = to
            JumpIfFalse(to) -> if !pop().truthy() then pc = to
            JumpIfTrueKeep(to) -> if peek(0).truthy() then pc = to
            JumpIfPresentKeep(to) -> if !is_nullish(peek(0)) then pc = to
            JumpIfFalseKeep(to) -> if !peek(0).truthy() then pc = to

            Pop -> vm.stack.truncate(vm.stack.len() - 1)
            Dup -> vm.stack.push(peek(0))

            PushScope -> vm.scope = new_env(vm.scope)
            PopScope -> vm.scope = vm.scope.parent

            MakeClosure(c) -> vm.stack.push(Fn(new_closure(u.chunks.at(c).params, c, vm.scope)))
            DefineFn(k, c) ->
                val name = u.strings.at(k)

                // Bound before the closure is built, so the body can see its own name -- which is the
                // whole of what makes a named function recursive.
                declare(vm.scope, name, Null, false)
                declare(vm.scope, name, Fn(new_closure(u.chunks.at(c).params, c, vm.scope)), false)

            TestPat(k) ->
                val took = match_pattern(u.patterns.at(k), peek(0), vm.scope)

                vm.stack.push(Bool(took))

            IterInit ->
                peek(0) match
                    Array(_) -> vm.stack.push(Int(0))
                    other -> return fault(at, s"`for` walks an array, and this is ${other.type_name()}")
            IterNext(to) ->
                val i = peek(0) match
                    Int(n) -> usize(n)
                    _ -> 0

                val items = peek(1) match
                    Array(p) -> p
                    _ -> return fault(at, "`for` walks an array")

                if i >= items.items.len()
                    pc = to
                else
                    vm.stack.set(vm.stack.len() - 1, Int(long(i + 1)))
                    vm.stack.push(items.items.at(i))

            FailWith(k) -> return fault(at, u.strings.at(k))
            FailNoArm -> return fault(at, s"no arm of this match applies to ${value_text(peek(0))}")

            Tick ->
                maybe_collect()

                // A full heap is reported where there is a line to point at; the allocator has no
                // idea which statement it was serving.
                if heap_exhausted then return fault(at, "this program has run out of memory")

            CallFn(argc) ->
                var args: Buf[Value] = buf()

                for i in 0..<argc
                    keepable(peek(argc - 1 - i), at, "passed to a function")?
                    args.push(peek(argc - 1 - i))

                val callee = peek(argc)

                vm.stack.truncate(vm.stack.len() - argc - 1)

                callee match
                    Native(f) -> vm.stack.push(call_native(f, args, at)?)
                    Fn(c) ->
                        if args.len() != c.params.len()
                            return fault(at, s"this function takes ${c.params.len()} arguments and was given ${args.len()}")

                        // **An `async` function is not called, it is STARTED**, on a machine of its
                        // own, and what the caller gets back is a promise rather than a result.
                        if u.chunks.at(c.body).is_async
                            vm.stack.push(start_async(c, args, at)?)
                            continue
                        end if

                        // The frame this call is leaving is written back only here, which is what
                        // makes the ordinary instruction cheap.
                        if vm.frames.len() >= MaxCallDepth
                            return fault(at, s"this call is ${MaxCallDepth} deep, which is farther than slate will go -- a recursion this deep is usually one that never ends")

                        vm.frames.push(Frame(chunk_ix, pc, vm.scope, base))

                        val called = new_env(c.scope)

                        for i in 0..<c.params.len()
                            declare(called, c.params.at(i), args.at(i), true)

                        chunk_ix = c.body
                        code = u.chunks.at(chunk_ix).code
                        pc = 0
                        vm.scope = called
                        base = vm.stack.len()
                    other -> return fault(at, s"${other.type_name()} is not something that can be called")

            Op.Await ->
                // **A machine that is not a coroutine has nowhere to come back from.** The compiler
                // refuses `await` outside an `async` function, so this is only reachable if a chunk
                // were started the ordinary way -- and suspending the main program would leave `run`
                // with nothing to return.
                if vm.promise == null || floor != 0
                    return fault(at, "`await` cannot suspend this call")

                // **The awaited value stays on the stack while the machine is parked**, which is what
                // keeps a pending promise reachable: the shadow stack cannot hold it across the park,
                // and the machine's own operand stack is a root the tracer already walks. The answer
                // is written over it when the machine comes back.
                val awaited = peek(0)

                // What `resume_chunk` will pick the loop up from.
                vm.frames.push(Frame(chunk_ix, pc, vm.scope, base))

                val id = park()

                awaited match
                    Promise(pr) ->
                        pr.handled = true

                        // **A settled promise still goes round the queue.** Continuing here instead
                        // would make `await` on a finished promise run the rest of the function before
                        // anything else queued ahead of it -- which is the ordering bug every async
                        // runtime that took the shortcut has had to undo. JavaScript resolves this
                        // case through a microtask for the same reason.
                        if pr.settled
                            ready.push(Resumption(id, pr.value, pr.failed, pr.message, pr.at))
                        else
                            pr.waiters.push(id)
                    other ->
                        // `await 5` is 5, as in JavaScript -- and it still yields, so that a program
                        // cannot tell which of the two it was given by watching what runs next.
                        ready.push(Resumption(id, other, false, "", at))

                return Err(Wait)

            Ret ->
                val v = pop()

                vm.stack.truncate(base)

                if vm.frames.len() == floor
                    vm.scope = outer_scope
                    return Ok(v)

                val back = vm.frames.at(vm.frames.len() - 1)

                vm.frames.truncate(vm.frames.len() - 1)
                chunk_ix = back.chunk
                code = u.chunks.at(chunk_ix).code
                pc = back.pc
                vm.scope = back.scope
                base = back.base
                vm.stack.push(v)
end execute

// -- the entry point --------------------------------------------------------------------------------

// Compile a source and run it on the machine.
run(src: Source) -> Ran
    reset_heap()
    reset_vm()
    reset_events()
    reset_async()
    output.clear()

    val parsed = parse(src)

    if !parsed.ok() then return Ran(Null, parsed.report, output)

    current_unit = new_unit()

    compile_program(&current_unit, parsed.program)

    var env = new_env(null)

    hold_env(env)
    install_builtins(env)

    var rep = parsed.report

    // **The program runs, and then the loop drains.** A slate program with a timer or a pending
    // `await` in it does not exit when its last statement does, which is node's rule and the whole
    // point of having a loop.
    //
    // **A failure nothing was waiting for is the program's failure**, checked once everything has
    // settled: until then there is no telling a promise that will be awaited on the next line from
    // one that never will be.
    val answer: Step = run_chunk(&current_unit, 0, env) match
        Ok(v) -> drain_events() match
            Ok(_) -> unhandled_rejection() match
                Some(s) -> Err(s)
                None -> Ok(v)
            Err(s) -> Err(s)
        Err(s) -> Err(s)

    answer match
        Ok(v) -> Ran(v, rep, output)
        Err(s) ->
            rep.add(error(signal_span(s), signal_message(s)))
            Ran(Null, rep, output)
end run
