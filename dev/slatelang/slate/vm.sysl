module dev.slatelang.slate

import sh.sysl.gc
import sh.sysl.libuv
import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.str_builder

// The machine.
//
// **The operand stack and the frame stack are ordinary arrays, and that is the point.** The walker
// kept its working values in sysl locals, which the mark phase cannot see -- so every one of them had
// to be pushed onto a shadow stack by hand, and a forgotten `hold` was a crash that only appeared
// under memory pressure. Here the tracer walks two arrays and is finished.
//
// **A frame is data, which is what `await` will need.** Suspending a call means leaving its frame
// where it is and running something else; resuming means putting it back. Neither is possible while
// the state of a call is sysl's own call stack, and that -- not speed -- is why this exists.

// One call in progress.
struct Frame
    chunk: usize
    pc: usize

    // The scope names are looked up in. A block moves this to a child and back.
    scope: *EnvObj

    // How tall the operand stack was when this call started. `Ret` cuts back to it.
    base: usize

    // How many handlers were owed when this call started.
    //
    // **`return` out of a `try` body would otherwise leave its handler behind**, and a handler left
    // behind is worse than a missing one: it names a place in a chunk nobody is standing in any
    // more, so the next fault anywhere would restore the machine into the middle of a function that
    // has already returned.
    handlers: usize

// Where to put the machine back to when a fault is caught.
//
// **Everything here is what the machine will be given back, not what it had.** A fault can be raised
// any number of frames deep and with any amount of half-evaluated arithmetic on the stack, so
// unwinding is not a matter of undoing steps -- it is a matter of having written down, once, what
// the world looked like where the `try` began.
struct Handler
    // Where the `catch` starts. Both are needed: a `try` and its `catch` are always in one chunk,
    // but the fault may have been raised several chunks away.
    chunk: usize
    pc: usize

    // What the operand stack, the frame stack and the scope chain are cut back to.
    sp: usize
    frames: usize
    scope: *EnvObj

    // The frame base the `catch` runs at, which is the one the `try` was written in.
    base: usize

// Everything one line of execution is: its values, its calls, and where it is looking names up.
//
// **Bundled because `await` moves them together.** Suspending a call means setting all of them aside
// and running something else; resuming means putting them back. They were three module variables
// until it became clear that no operation ever wants one without the others.
struct Machine
    stack: Buf[Value]
    frames: Buf[Frame]

    // The promise this line of execution settles when it finishes, and null for the main program.
    //
    // **This is the whole of what makes a machine a coroutine.** An `async` function is called by
    // giving its body a machine of its own with this filled in; the caller is handed the promise
    // straight back and carries on, and whatever the body eventually answers -- a value, or a fault --
    // is written here for whoever awaited it.
    promise: *PromiseObj

    // The scope the running frame is looking names up in. **Not a sysl local, and that is not a style
    // choice**: `alloc` can collect at any allocation, so the scope in hand has to be reachable from
    // the root function at every instant. Keeping it in a local once swept the whole live scope chain
    // out from under the machine.
    scope: *EnvObj

    // The `try` blocks this line of execution is inside, innermost last.
    //
    // **A field of the machine and not module storage, because a coroutine takes its handlers with
    // it.** `await` inside a `try` parks the whole machine; the promise may fail minutes later, and
    // the `catch` that is owed the fault is the parked machine's own.
    handlers: Buf[Handler]

    // **Whether this slot holds something, said rather than inferred.** Emptiness was read off the
    // frames and the scope until a machine parked with values on its stack and nothing else matched
    // the same test -- and the next park wrote over it.
    live: bool

// The line of execution currently running.
var vm: Machine = Machine(buf(), buf(), null, null, buf(), true)

// The ones set aside. **Empty until `await` exists**, and here now because the thing that makes a
// coroutine possible is that its state is data rather than sysl's own call stack -- which is the
// whole reason the tree-walker was replaced.
var parked: Buf[Machine] = buf()

// Set the running machine aside and answer where it went. The caller gets a clean one.
park() -> usize
    val saved = vm

    vm = Machine(buf(), buf(), null, null, buf(), true)

    for i in 0..<parked.len()
        if !parked.at(i).live
            parked.set(i, saved)
            return i

    parked.push(saved)
    parked.len() - 1
end park

// Put one back, and answer what was running in its place.
unpark(id: usize) -> Machine
    val displaced = vm

    vm = parked.at(id)
    parked.set(id, Machine(buf(), buf(), null, null, buf(), false))
    displaced
end unpark


// How deep a slate program may call.
//
// **A machine has to impose this, where a tree-walker got it imposed on it.** The walker recursed in
// sysl, so runaway recursion exhausted the host stack and the process died with no diagnostic and
// none of the output it had already produced (card 0299). Frames live in an ordinary array here, so
// nothing stops them but this -- and a limit slate owns is a limit slate can *report*, pointing at
// the call that went one too deep.
//
// Ten thousand is roughly what node and the JVM allow, and far past any honest recursion; a program
// that wants more depth than this wants a loop.
private const MaxCallDepth: usize = 10000

// The unit being run.
//
// **Module storage, because a hook has to reach it.** A user-supplied `equals` is called from inside
// a table lookup, which is called from `same`, which knows nothing about units -- so the chunk it
// needs is found here rather than threaded through every comparison.
var current_unit: Unit = new_unit()

// One `@test` the entry file declared.
struct TestCase
    name: string

    // Which file it came from, so a failure is rendered against the right one.
    source: usize

    fn: Value

// The tests the file being run declared, in the order they were written.
//
// **A root the collector has to walk.** A test function is reached from nothing else once its
// module's scope has been left, and it is the closure that keeps that scope -- and everything the
// test can see -- alive.
var registered_tests: Buf[TestCase] = buf()

// What each module exported, in the order the modules ran.
//
// **A root the collector has to walk, and the only one the module system adds.** A module's exports
// are an ordinary object, so nothing else here is new: the closures in it hold their module's scope,
// the scope holds whatever it captured, and the tracer already knows how to follow all of it.
var module_values: Buf[Value] = buf()

// Empty the machine between runs.
reset_vm()
    vm = Machine(buf(), buf(), null, null, buf(), true)
    parked.clear()
    module_values.clear()
    registered_tests.clear()

// Everything the loaded modules still hold.
mark_modules(h: *gc.Heap)
    for i in 0..<module_values.len()
        mark_value(h, module_values.at(i))

    for i in 0..<registered_tests.len()
        mark_value(h, registered_tests.at(i).fn)

// Everything the machine can still reach, for the collector.
//
// **This replaces most of the shadow stack.** What is left of `hold`/`release` is only what code
// outside the machine holds -- a native builtin building an array, say.
mark_vm(h: *gc.Heap)
    mark_machine(h, vm)

    // **Every parked line of execution is a root too.** A suspended call is not running, and is not
    // therefore any less alive -- everything it will touch when it resumes has to survive until then.
    for i in 0..<parked.len()
        if parked.at(i).live then mark_machine(h, parked.at(i))

private mark_machine(h: *gc.Heap, m: Machine)
    for i in 0..<m.stack.len()
        mark_value(h, m.stack.at(i))

    for i in 0..<m.frames.len()
        gc.mark(h, ptr_cast(m.frames.at(i).scope))

    gc.mark(h, ptr_cast(m.scope))
    gc.mark(h, ptr_cast(m.promise))

    // **A handler's scope is a root, and nothing else refers to it.** It is the scope the `try` was
    // written in, which the machine has since moved out of -- so between entering the body and
    // catching a fault, this is the only thing keeping it alive.
    for i in 0..<m.handlers.len()
        gc.mark(h, ptr_cast(m.handlers.at(i).scope))

// -- running ---------------------------------------------------------------------------------------

private pop() -> Value
    val v = vm.stack.at(vm.stack.len() - 1)

    vm.stack.truncate(vm.stack.len() - 1)
    v

private peek(back: usize) -> Value = vm.stack.at(vm.stack.len() - 1 - back)

// Run a chunk to completion and answer what it left.
run_chunk(u: *Unit, start: usize, scope0: *EnvObj) -> Step
    // **Where this call stops unwinding.** A native can call back into slate -- a user `equals` does
    // exactly that -- so a nested run must hand back at its own depth rather than at an empty stack.
    val floor = vm.frames.len()
    val outer_scope = vm.scope

    // **The file has to be put back, and forgetting to was a diagnostic that named the wrong file
    // entirely.** `execute` sets `current_source` from the chunk it is starting, and a nested run --
    // an `async` call routed through `start_async`, a user `equals` reached from inside a table --
    // returns into the middle of an outer `execute` whose own `chunk_ix` never changed. So the outer
    // chunk carried on stamping its faults with the callee's file: a fault three lines after
    // `await slowly(1)` was reported against `waits.sl`, at a line number that happened to exist and
    // was blank. Nothing about that message says it is pointing at the wrong file.
    val outer_source = current_source

    vm.scope = scope0

    val answer = execute(u, start, 0, vm.stack.len(), floor, outer_scope)

    current_source = outer_source
    answer
end run_chunk

// Carry on from where an `await` left off.
//
// **The frame on top says where.** `Await` writes the frame it was standing in back before it parks,
// which is the one thing `execute` never does for itself -- so putting a machine back is popping that
// frame and starting the loop at the numbers in it.
//
// The floor is zero and the outer scope is null because a coroutine's machine is its own: it was
// created empty by the call that started it, so there is nothing underneath to hand back to.
// Not `private`: `private` in sysl is private to the *file*, and the scheduler in `async.sysl` is
// what puts a machine back.
resume_chunk(u: *Unit) -> Step
    val back = vm.frames.at(vm.frames.len() - 1)
    val outer_source = current_source

    vm.frames.truncate(vm.frames.len() - 1)
    vm.scope = back.scope

    val answer = execute(u, back.chunk, back.pc, back.base, 0, null)

    current_source = outer_source
    answer
end resume_chunk

// Carry on from an `await` whose promise FAILED, raising the fault where the `await` was written.
//
// **The machine is put back before the fault is raised, and that ordering is the whole point.** A
// coroutine's `try` blocks are its own and went into `parked` with it, so a fault made into an `Err`
// without restoring the machine would be offered to whatever happened to be running instead -- which
// is the scheduler, which has no handlers and is not the code that wrote the `await`.
resume_failed(u: *Unit, at: Span, message: string) -> Step
    val back = vm.frames.at(vm.frames.len() - 1)
    val outer_source = current_source

    vm.frames.truncate(vm.frames.len() - 1)
    vm.scope = back.scope
    current_source = u.chunks.at(back.chunk).source

    // Everything this machine has is its own, so every handler in it is allowed the fault.
    val answer = guarded(u, Err(failure(at, message)), 0, null, 0)

    current_source = outer_source
    answer
end resume_failed

// What calling a value came to.
//
// **The two instructions that call share everything but six lines.** Arity, the `async` detour, the
// depth limit and building the callee's scope are the same whether the function was named or reached
// through a field; what differs is only that a method may be handed the object it was found on. The
// six lines that stay behind write back the frame, which needs `run_frames`'s own locals.
private enum Called
    // A native, or an `async` function -- there is a value already and no chunk to enter.
    Answered(v: Value)

    // An ordinary slate function: the chunk to run and the scope to run it in.
    Enter(chunk: usize, scope: *EnvObj)

private invoke(u: *Unit, callee: Value, args: Buf[Value], at: Span, depth: usize) -> Result[Called, Signal]
    callee match
        Native(f) -> Ok(Answered(call_native(f, args, at)?))
        Fn(c) ->
            if args.len() != c.params.len()
                return Err(failure(at, s"this function takes ${c.params.len()} arguments and was given ${args.len()}"))

            // **An `async` function is not called, it is STARTED**, on a machine of its own, and what
            // the caller gets back is a promise rather than a result.
            if u.chunks.at(c.body).is_async then return Ok(Answered(start_async(c, args, at)?))

            if depth >= MaxCallDepth
                return Err(failure(at, s"this call is ${MaxCallDepth} deep, which is farther than slate will go -- a recursion this deep is usually one that never ends"))

            // **The arguments are held while the scope is built.** They are off the operand stack by
            // now and live only in a sysl local, which the mark phase cannot see -- and a full heap
            // collects inside `new_env`. `start_async` has always guarded them for this reason; the
            // ordinary path was relying on the heap not being full at that instant.
            val mark = root_mark()

            for i in 0..<args.len()
                hold(args.at(i))

            val called = new_env(c.scope)

            for i in 0..<c.params.len()
                declare(called, c.params.at(i), args.at(i), true)

            release(mark)
            Ok(Enter(c.body, called))
        other -> Err(failure(at, s"${other.type_name()} is not something that can be called"))
end invoke

// The instruction loop, with any `catch` this call owns given first refusal on a fault.
//
// **The loop itself is untouched and keeps returning `Err` the way it always has**, which is the
// whole reason this is a wrapper rather than a rewrite. A fault leaves `run_frames` from about
// thirty-five places, every one of them a `?` or a bare `return fault(...)`; threading a handler
// check through all of them would have been thirty-five chances to get it wrong. Catching a fault is
// instead re-entering the loop somewhere else, which is exactly what resuming an `await` already is.
private execute(u: *Unit, start: usize, from: usize, base0: usize, floor: usize, outer_scope: *EnvObj) -> Step
    // **Handlers that were already owed are not this call's to answer**, which is what keeps a
    // native's callback -- a user `equals` reached from inside a table lookup -- from being caught by
    // a `try` in the function that called the native. The fault leaves here as an `Err`, unwinds the
    // native, and is caught by the outer loop's wrapper instead, which is where it belongs.
    val floor_of_handlers = vm.handlers.len()
    val answer = guarded(u, run_frames(u, start, from, base0, floor, outer_scope), floor, outer_scope, floor_of_handlers)

    // **Not on a park.** `Await` swaps `vm` for a fresh machine before it raises `Wait`, so the
    // handlers standing here are the new machine's and the count means nothing against them. The
    // suspended machine took its own away with it, which is the point.
    answer match
        Err(Wait) -> ()
        _ -> vm.handlers.truncate(floor_of_handlers)

    answer
end execute

// Give a fault to the nearest `catch` that is allowed to have it, and run on from there.
//
// Not `private`: `async.sysl` hands a failed promise's fault to the machine that awaited it, and
// that machine's handlers are the ones owed it.
guarded(u: *Unit, first: Step, floor: usize, outer_scope: *EnvObj, floor_of_handlers: usize) -> Step
    var outcome = first

    loop
        val caught = outcome match
            Err(Fail(at, src, message)) -> (at, src, message)
            _ -> return outcome

        if vm.handlers.len() <= floor_of_handlers then return outcome

        val (at, src, message) = caught
        val h = vm.handlers.at(vm.handlers.len() - 1)

        vm.handlers.truncate(vm.handlers.len() - 1)

        // **The value is built before the stack is cut back, and held while it is built.** It is an
        // object, so making it allocates, and allocating collects -- and everything the program still
        // owns is on the very stack about to be truncated.
        val mark = root_mark()
        val v = fault_value(u, at, src, message)

        hold(v)
        vm.stack.truncate(h.sp)
        vm.frames.truncate(h.frames)
        vm.scope = h.scope
        vm.stack.push(v)
        release(mark)

        outcome = run_frames(u, h.chunk, h.pc, h.base, floor, outer_scope)
end guarded

// What a `catch` binds: the sentence, and where it was raised.
//
// **An ordinary object, which is the same answer modules got.** A fault is a value a program reads,
// sorts on, prints and puts in an array, and slate objects already do all of that -- so there is no
// new kind of value here and nothing new for the collector to trace.
private fault_value(u: *Unit, at: Span, src: usize, message: string) -> Value
    val o = new_object()
    val mark = root_mark()

    hold(Object(o))

    val where = u.sources.at(src)

    obj_put_name(o, "message", str_value(message))
    obj_put_name(o, "line", Int(long(where.locate(at.start).line)))
    obj_put_name(o, "file", str_value(where.name))
    release(mark)
    Object(o)
end fault_value

// The instruction loop.
//
// **The instruction pointer and the scope are sysl locals rather than fields of the top frame**, and
// written back only when a call pushes or pops one -- or when an `await` suspends. Reading them out of
// a `Buf` on every instruction would copy a whole frame per step.
private run_frames(u: *Unit, start: usize, from: usize, base0: usize, floor: usize, outer_scope: *EnvObj) -> Step
    var chunk_ix = start

    // **The machine keeps `current_source` in step with the chunk it is running**, which is what
    // lets `failure` stamp a fault with the file its span belongs to. It is set here and at every
    // point below that changes `chunk_ix`; there are three, and they are the only three.
    current_source = u.chunks.at(chunk_ix).source
    var pc = from
    var base = base0
    var code = u.chunks.at(chunk_ix).code

    loop
        if pc >= code.len()
            // A chunk that ran off its end answers null, which only happens for an empty body.
            vm.stack.push(Null)
            pc = code.len()

        val ins = code.at(pc)
        val at = ins.at

        pc += 1

        ins.op match
            PushNil -> vm.stack.push(Null)
            PushUndefined -> vm.stack.push(Undefined)
            PushBool(v) -> vm.stack.push(Bool(v))
            PushInt(v) -> vm.stack.push(Int(v))
            PushReal(v) -> vm.stack.push(Real(v))
            PushStr(k) -> vm.stack.push(str_value(u.strings.at(k)))
            PushModule(m) -> vm.stack.push(module_values.at(m))

            CheckType(k, t, pk) ->
                val name = u.strings.at(k)

                val v = lookup(vm.scope, name) match
                    Some(found) -> found
                    None -> return fault(at, s"`${name}` is not defined")

                if !match_pattern(u.patterns.at(pk), v, vm.scope)
                    return fault(at, s"`${name}` was declared ${u.strings.at(t)}, and was given ${show_value(v)}")

            DefineTest(k) -> registered_tests.push(TestCase(u.strings.at(k), u.chunks.at(chunk_ix).source, pop()))

            PushHandler(to) -> vm.handlers.push(Handler(chunk_ix, to, vm.stack.len(), vm.frames.len(), vm.scope, base))
            PopHandler -> vm.handlers.truncate(vm.handlers.len() - 1)

            LoadName(k) ->
                val name = u.strings.at(k)

                lookup(vm.scope, name) match
                    Some(v) -> vm.stack.push(v)
                    None -> return fault(at, s"`${name}` is not defined")
            DeclareVal(k) ->
                val v = pop()

                keepable(v, at, s"bound to `${u.strings.at(k)}`")?
                declare(vm.scope, u.strings.at(k), v, false)
            DeclareVar(k) ->
                val v = pop()

                keepable(v, at, s"bound to `${u.strings.at(k)}`")?
                declare(vm.scope, u.strings.at(k), v, true)
            StoreName(k) ->
                val name = u.strings.at(k)

                val stored = pop()

                keepable(stored, at, s"written to `${name}`")?

                assign_name(vm.scope, name, stored) match
                    Written -> ()
                    Immutable -> return fault(at, s"`${name}` is a `val`, so it is written once")
                    Unknown -> return fault(at, s"`${name}` is not defined")

            UnaryOp(op) ->
                val v = pop()

                vm.stack.push(unary(op, v, at)?)
            BinaryOp(op) ->
                val b = pop()
                val a = pop()

                vm.stack.push(on_values(op, a, b, at)?)

            MakeArray(n) ->
                var items: Buf[Value] = buf()

                for i in 0..<n
                    keepable(peek(n - 1 - i), at, "put in an array")?
                    items.push(peek(n - 1 - i))

                // **Allocated before the stack shrinks.** Between the truncate and the alloc the
                // elements would live only in `items`, which the mark phase cannot see -- and `alloc`
                // collects when the heap is full.
                val made = Array(new_array(items))

                vm.stack.truncate(vm.stack.len() - n)
                vm.stack.push(made)
            MakeObject(n) ->
                val o = new_object()
                val mark = root_mark()

                hold(Object(o))

                for i in 0..<n
                    val key = peek((n - 1 - i) * 2 + 1)
                    val value = peek((n - 1 - i) * 2)

                    keepable(value, at, "put in an object")?

                    obj_put(o, key, value, at)?

                release(mark)
                vm.stack.truncate(vm.stack.len() - n * 2)
                vm.stack.push(Object(o))

            GetIndex ->
                val k = pop()
                val target = pop()

                vm.stack.push(read_at(target, k, at)?)
            SetIndex ->
                val v = pop()
                val k = pop()
                val target = pop()

                keepable(v, at, "stored")?
                keepable(k, at, "used as a key")?

                store_at(target, k, v, at)?
            GetField(k) ->
                val target = pop()

                vm.stack.push(read_field(target, u.strings.at(k), at)?)
            SetField(k) ->
                val v = pop()

                keepable(v, at, s"stored in `${u.strings.at(k)}`")?

                pop() match
                    Object(o) -> obj_put_name(o, u.strings.at(k), v)
                    other -> return fault(at, s"a field belongs to an object, and this is ${other.type_name()}")

            Jump(to) -> pc = to
            JumpIfFalse(to) -> if !pop().truthy() then pc = to
            JumpIfTrueKeep(to) -> if peek(0).truthy() then pc = to
            JumpIfPresentKeep(to) -> if !is_nullish(peek(0)) then pc = to
            JumpIfFalseKeep(to) -> if !peek(0).truthy() then pc = to

            Pop -> vm.stack.truncate(vm.stack.len() - 1)
            Dup -> vm.stack.push(peek(0))
            DupAt(n) -> vm.stack.push(peek(n))
            RotUp(n) ->
                // `[a, b, c]` with an `n` of two becomes `[c, a, b]`: the top slides down and
                // everything it passed shifts up one.
                val top = vm.stack.len() - 1
                val v = vm.stack.at(top)
                var i = top

                while i > top - n
                    vm.stack.set(i, vm.stack.at(i - 1))
                    i -= 1

                vm.stack.set(top - n, v)

            Join(n) ->
                var out = str_builder()

                for i in 0..<n
                    keepable(peek(n - 1 - i), at, "put in a string")?
                    out.push(value_text(peek(n - 1 - i)))

                val joined = str_value(out.finish())

                vm.stack.truncate(vm.stack.len() - n)
                vm.stack.push(joined)
            Repeat ->
                val n = pop() match
                    Int(k) ->
                        if k < 0 then return fault(at, s"an array of ${k} copies is not something to make") else usize(k)
                    other -> return fault(at, s"a repeat count is a whole number, and this is ${other.type_name()}")

                keepable(peek(0), at, "put in an array")?

                var items: Buf[Value] = buf()

                for i in 0..<n
                    items.push(peek(0))

                // Allocated before the stack shrinks, for the reason `MakeArray` gives.
                val made = Array(new_array(items))

                vm.stack.truncate(vm.stack.len() - 1)
                vm.stack.push(made)
            WithObject(n) ->
                val base = peek(n * 2)

                val fields = base match
                    Object(o) -> o
                    other -> return fault(at, s"`with` copies an object, and this is ${other.type_name()}")

                val o = new_object()
                val mark = root_mark()

                hold(Object(o))

                // The base's own fields first, in the order it holds them, so that the copy keeps
                // the order and a changed field keeps the place it already had.
                for i in 0..<fields.entries.len()
                    val entry = fields.entries.at(i)

                    if !entry.dead then obj_put(o, entry.key, entry.value, at)?

                for i in 0..<n
                    val key = peek((n - 1 - i) * 2 + 1)
                    val value = peek((n - 1 - i) * 2)

                    keepable(value, at, "put in an object")?
                    obj_put(o, key, value, at)?

                release(mark)
                vm.stack.truncate(vm.stack.len() - n * 2 - 1)
                vm.stack.push(Object(o))

            MakeRange(inclusive, has_lo, has_hi) ->
                val hi = if has_hi then range_end(pop(), at, "the end")? else 0
                val lo = if has_lo then range_end(pop(), at, "the start")? else 0

                vm.stack.push(RangeVal(lo, hi, inclusive, has_lo, has_hi))
            IsPat(k, negated) ->
                val took = match_pattern(u.patterns.at(k), pop(), vm.scope)

                vm.stack.push(Bool(if negated then !took else took))

            PushScope -> vm.scope = new_env(vm.scope)
            PopScope -> vm.scope = vm.scope.parent

            MakeClosure(c) -> vm.stack.push(Fn(new_closure(u.chunks.at(c).params, c, vm.scope)))
            DefineFn(k, c) ->
                val name = u.strings.at(k)

                // Bound before the closure is built, so the body can see its own name -- which is the
                // whole of what makes a named function recursive.
                declare(vm.scope, name, Null, false)
                declare(vm.scope, name, Fn(new_closure(u.chunks.at(c).params, c, vm.scope)), false)

            TestPat(k) ->
                val took = match_pattern(u.patterns.at(k), peek(0), vm.scope)

                vm.stack.push(Bool(took))

            IterInit ->
                peek(0) match
                    Array(_) -> vm.stack.push(Int(0))

                    // **A range with an end left out is refused rather than walked**, because the
                    // walk would not stop: an end taken from what the range is used on has nothing to
                    // take it from here.
                    RangeVal(_, _, _, has_lo, has_hi) ->
                        if !has_lo || !has_hi
                            return fault(at, "`for` needs a range with both ends, since one left out would never finish")

                        vm.stack.push(Int(0))
                    other -> return fault(at, s"`for` walks an array or a range, and this is ${other.type_name()}")
            IterNext(to) ->
                val i = peek(0) match
                    Int(n) -> usize(n)
                    _ -> 0

                val step = peek(1) match
                    Array(p) ->
                        if i >= p.items.len() then None else Some(p.items.at(i))
                    RangeVal(lo, hi, inclusive, _, _) ->
                        if i >= range_count(lo, hi, inclusive) then None else Some(Int(lo + long(i)))
                    _ -> return fault(at, "`for` walks an array or a range")

                step match
                    None -> pc = to
                    Some(v) ->
                        vm.stack.set(vm.stack.len() - 1, Int(long(i + 1)))
                        vm.stack.push(v)

            FailWith(k) -> return fault(at, u.strings.at(k))
            FailNoArm -> return fault(at, s"no arm of this match applies to ${value_text(peek(0))}")

            Tick ->
                maybe_collect()

                // A full heap is reported where there is a line to point at; the allocator has no
                // idea which statement it was serving.
                if heap_exhausted then return fault(at, "this program has run out of memory")

            CallFn(argc) ->
                var args: Buf[Value] = buf()

                for i in 0..<argc
                    keepable(peek(argc - 1 - i), at, "passed to a function")?
                    args.push(peek(argc - 1 - i))

                val callee = peek(argc)

                vm.stack.truncate(vm.stack.len() - argc - 1)

                invoke(u, callee, args, at, vm.frames.len())? match
                    Answered(v) -> vm.stack.push(v)
                    Enter(body, called) ->
                        // The frame this call is leaving is written back only here, which is what
                        // makes the ordinary instruction cheap.
                        vm.frames.push(Frame(chunk_ix, pc, vm.scope, base, vm.handlers.len()))
                        chunk_ix = body
                        code = u.chunks.at(chunk_ix).code
                        current_source = u.chunks.at(chunk_ix).source
                        pc = 0
                        vm.scope = called
                        base = vm.stack.len()

            // `o.m(a)`, which is where the receiver rule lives.
            //
            // **The lookup and the call are one instruction because the rule needs both.** By the
            // time a `GetField` has handed a function to a `CallFn`, the fact that decides whether
            // an object is passed -- was it the object's own, or a shared one reached through a
            // proto -- has been thrown away.
            CallMethod(k, argc) ->
                val name = u.strings.at(k)
                val target = peek(argc)

                val found = target match
                    Object(fields) -> field_from(fields, name, at)?
                    other -> return fault(at, s"a field belongs to an object, and this is ${other.type_name()}")

                var args: Buf[Value] = buf()

                // **The object goes in front of the written arguments where it was delegated to.**
                // A method the object carries itself has already captured what it needs; a shared
                // one cannot have, there being one of it for every instance.
                if found.1 then args.push(target)

                for i in 0..<argc
                    keepable(peek(argc - 1 - i), at, "passed to a function")?
                    args.push(peek(argc - 1 - i))

                vm.stack.truncate(vm.stack.len() - argc - 1)

                if is_absent(found.0)
                    return fault(at, s"`${name}` is not a field of this object, so there is nothing to call")

                invoke(u, found.0, args, at, vm.frames.len())? match
                    Answered(v) -> vm.stack.push(v)
                    Enter(body, called) ->
                        vm.frames.push(Frame(chunk_ix, pc, vm.scope, base, vm.handlers.len()))
                        chunk_ix = body
                        code = u.chunks.at(chunk_ix).code
                        current_source = u.chunks.at(chunk_ix).source
                        pc = 0
                        vm.scope = called
                        base = vm.stack.len()

            Op.Await ->
                // **A machine that is not a coroutine has nowhere to come back from.** The compiler
                // refuses `await` outside an `async` function, so this is only reachable if a chunk
                // were started the ordinary way -- and suspending the main program would leave `run`
                // with nothing to return.
                if vm.promise == null || floor != 0
                    return fault(at, "`await` cannot suspend this call")

                // **The awaited value stays on the stack while the machine is parked**, which is what
                // keeps a pending promise reachable: the shadow stack cannot hold it across the park,
                // and the machine's own operand stack is a root the tracer already walks. The answer
                // is written over it when the machine comes back.
                val awaited = peek(0)

                // What `resume_chunk` will pick the loop up from.
                vm.frames.push(Frame(chunk_ix, pc, vm.scope, base, vm.handlers.len()))

                val id = park()

                awaited match
                    Promise(pr) ->
                        pr.handled = true

                        // **A settled promise still goes round the queue.** Continuing here instead
                        // would make `await` on a finished promise run the rest of the function before
                        // anything else queued ahead of it -- which is the ordering bug every async
                        // runtime that took the shortcut has had to undo. JavaScript resolves this
                        // case through a microtask for the same reason.
                        if pr.settled
                            ready.push(Resumption(id, pr.value, pr.failed, pr.message, pr.at))
                        else
                            pr.waiters.push(id)
                    other ->
                        // `await 5` is 5, as in JavaScript -- and it still yields, so that a program
                        // cannot tell which of the two it was given by watching what runs next.
                        ready.push(Resumption(id, other, false, "", at))

                return Err(Wait)

            Ret ->
                val v = pop()

                vm.stack.truncate(base)

                if vm.frames.len() == floor
                    vm.scope = outer_scope
                    return Ok(v)

                val back = vm.frames.at(vm.frames.len() - 1)

                vm.frames.truncate(vm.frames.len() - 1)

                // **Anything the returning call was inside goes with it.** A `return` written in a
                // `try` body skips its `PopHandler`, and a handler outliving the frame it was
                // established in names an instruction nobody is standing at.
                vm.handlers.truncate(back.handlers)
                chunk_ix = back.chunk
                code = u.chunks.at(chunk_ix).code
                current_source = u.chunks.at(chunk_ix).source
                pc = back.pc
                vm.scope = back.scope
                base = back.base
                vm.stack.push(v)
end run_frames

// -- the entry point --------------------------------------------------------------------------------

// Compile a source and everything it imports, and run the lot.
run(src: Source) -> Ran
    reset_heap()
    reset_vm()
    reset_events()
    reset_async()
    reset_types()
    output.clear()

    val loaded = load_program(src)

    // **Nothing is compiled while anything is wrong with any file**, which is what makes a
    // diagnostic about a missing export a diagnostic rather than a fault at run time.
    if !loaded.ok() then return Ran(Null, loaded.report, loaded.srcs, loaded.sources, output)

    current_unit = new_unit()

    // **The unit is told about every file before anything is compiled from any of them**, because a
    // chunk is stamped with an index into this list and a fault carries the same index out.
    for i in 0..<loaded.sources.len()
        current_unit.sources.push(loaded.sources.at(i))

    // Post-order, so a module is compiled -- and later run -- only once everything it imports has
    // been. The entry is the last of them.
    for i in 0..<loaded.order.len()
        val which = loaded.order.at(i)

        compile_module(&current_unit, loaded.programs.at(which), which, loaded.sources.at(which).name, which == 0)

    // **The compiler has complaints of its own, and they stop the program exactly as the parser's
    // do.** A name in a pattern that turned out to be a binding where a type was wanted is knowable
    // only once the types are resolved, which is here rather than while parsing.
    if compile_went_wrong()
        var found = loaded.report
        var found_srcs = loaded.srcs

        found.absorb(compile_report())

        val more = compile_report_srcs()

        for i in 0..<more.len()
            found_srcs.push(more.at(i))

        return Ran(Null, found, found_srcs, loaded.sources, output)
    end if

    var env = new_env(null)

    hold_env(env)
    install_builtins(env)

    var rep = loaded.report

    // **The report and the file list are copied out of `loaded` because a fault appends to both.**
    // The signal the program stopped with carries the file its span belongs to, so the pair stays in
    // step exactly as the parse-time ones did.
    var srcs = loaded.srcs

    // **The program runs, and then the loop drains.** A slate program with a timer or a pending
    // `await` in it does not exit when its last statement does, which is node's rule and the whole
    // point of having a loop.
    //
    // **A failure nothing was waiting for is the program's failure**, checked once everything has
    // settled: until then there is no telling a promise that will be awaited on the next line from
    // one that never will be.
    val answer: Step = run_modules(env) match
        Ok(v) -> drain_events() match
            Ok(_) -> unhandled_rejection() match
                Some(s) -> Err(s)
                None -> Ok(v)
            Err(s) -> Err(s)
        Err(s) -> Err(s)

    answer match
        Ok(v) -> Ran(v, rep, srcs, loaded.sources, output)
        Err(s) ->
            rep.add(error(signal_span(s), signal_message(s)))
            srcs.push(signal_source(s))
            Ran(Null, rep, srcs, loaded.sources, output)
end run

// -- running the tests a file declared -------------------------------------------------------------

// How one `@test` went.
struct TestRan
    name: string
    ok: bool

    // The failure, rendered against the file that raised it. Empty where it passed.
    said: string

    // What the test printed, which is worth showing only when it did not pass.
    printed: string

    // How long it took, in milliseconds.
    ms: u64
end TestRan

// Everything `slate test` found in one file.
struct Tested
    // Empty unless the file would not load or would not compile, in which case no test ran.
    report: string

    results: Buf[TestRan]

    passed(self) -> usize
        var n: usize = 0

        for i in 0..<self.results.len()
            if self.results.at(i).ok then n += 1

        n
    end passed

    failed(self) -> usize = self.results.len() - self.passed()
end Tested

// Load a file, run its top level, and then run every `@test` it declared.
//
// **The top level runs first and its faults are the file's, not any test's.** A file whose module
// body fails has no working tests to speak of, so that is reported as the file failing to load
// rather than as every test failing for the same reason.
run_tests(src: Source) -> Tested
    val started = prepare(src)

    if started != "" then return Tested(started, buf())

    // The tests were registered as the entry module ran, and the closures in `registered_tests` are
    // what keep their module's scope -- and everything they can see -- alive.
    var results: Buf[TestRan] = buf()

    for i in 0..<registered_tests.len()
        results.push(run_one_test(registered_tests.at(i)))

    Tested("", results)
end run_tests

// Everything `run` does up to and including the modules, answering a rendered complaint or nothing.
private prepare(src: Source) -> string
    reset_heap()
    reset_vm()
    reset_events()
    reset_async()
    reset_types()
    output.clear()

    val loaded = load_program(src)

    if !loaded.ok() then return Ran(Null, loaded.report, loaded.srcs, loaded.sources, output).render()

    current_unit = new_unit()

    for i in 0..<loaded.sources.len()
        current_unit.sources.push(loaded.sources.at(i))

    for i in 0..<loaded.order.len()
        val which = loaded.order.at(i)

        compile_module(&current_unit, loaded.programs.at(which), which, loaded.sources.at(which).name, which == 0)

    if compile_went_wrong()
        var found = loaded.report
        var found_srcs = loaded.srcs

        found.absorb(compile_report())

        val more = compile_report_srcs()

        for i in 0..<more.len()
            found_srcs.push(more.at(i))

        return Ran(Null, found, found_srcs, loaded.sources, output).render()
    end if

    var env = new_env(null)

    hold_env(env)
    install_builtins(env)

    run_modules(env) match
        Err(sig) -> return complaint(sig)
        Ok(_) -> ()

    drain_events() match
        Err(sig) -> return complaint(sig)
        Ok(_) -> ()

    unhandled_rejection() match
        Some(sig) -> complaint(sig)
        None -> ""
end prepare

// One signal, drawn against the file it came from.
private complaint(sig: Signal) -> string
    var rep = report()
    var srcs: Buf[usize] = buf()

    rep.add(error(signal_span(sig), signal_message(sig)))
    srcs.push(signal_source(sig))
    Ran(Null, rep, srcs, current_unit.sources, output).render()
end complaint

// One test: call it, let the loop settle, and read the verdict.
//
// **An `async` test is waited for rather than refused.** Calling one starts a coroutine and hands
// back a promise that has not settled, so a runner that read the answer straight away would call
// every asynchronous test a pass. The promise is marked handled first, so that a failure is reported
// here as this test's rather than at the end of the drain as the file's.
private run_one_test(t: TestCase) -> TestRan
    val began = libuv.hrtime()
    var args: Buf[Value] = buf()

    output.clear()

    val outcome = apply(t.fn, args, point(0))

    outcome match
        Ok(v) ->
            v match
                Promise(pr) -> pr.handled = true
                _ -> ()

            val after = drain_events() match
                Err(sig) -> complaint(sig)
                Ok(_) -> unhandled_rejection() match
                    Some(sig) -> complaint(sig)
                    None -> awaited_verdict(v)

            finished(t, after, began)
        Err(sig) -> finished(t, complaint(sig), began)
end run_one_test

// What an `async` test's promise came to, once the loop has run it to the end.
private awaited_verdict(v: Value) -> string
    v match
        Promise(pr) ->
            if !pr.settled
                return "this test never finished -- something it awaited was never going to settle"

            if pr.failed then said_at(pr.message, pr.at) else ""
        _ -> ""
end awaited_verdict

// A message and a place, drawn against the file the machine was last in.
private said_at(message: string, at: Span) -> string
    var rep = report()
    var srcs: Buf[usize] = buf()

    rep.add(error(at, message))
    srcs.push(current_source)
    Ran(Null, rep, srcs, current_unit.sources, output).render()
end said_at

private finished(t: TestCase, said: string, began: u64) -> TestRan
    var out = str_builder()

    for i in 0..<output.len()
        if i > 0 then out.push_char('\n')

        out.push(output.at(i))

    TestRan(t.name, said == "", said, out.finish(), (libuv.hrtime() - began) / 1000000)
end finished

// Every module in turn, each in a scope of its own under the builtins.
//
// **A module gets its own scope and not a shared one**, which is the whole of what makes a file's
// top-level `val` private to it: nothing but what the file exported can be reached from outside, and
// two files may each call something `helper` without either knowing.
//
// The value answered is the entry module's exports, the entry being the last to run.
private run_modules(builtins: *EnvObj) -> Step
    var last: Value = Null

    for i in 0..<current_unit.modules.len()
        val scope = new_env(builtins)
        val mark = env_mark()

        hold_env(scope)

        val answer = run_chunk(&current_unit, current_unit.modules.at(i), scope)

        release_env(mark)

        answer match
            Ok(v) ->
                // **Pushed with nothing allocated in between**, so the object cannot be swept
                // between being answered and becoming a root.
                module_values.push(v)
                last = v
            Err(s) -> return Err(s)

    Ok(last)
end run_modules
