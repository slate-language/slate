module dev.slatelang.slate

import sh.sysl.gc
import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// The machine.
//
// **The operand stack and the frame stack are ordinary arrays, and that is the point.** The walker
// kept its working values in sysl locals, which the mark phase cannot see -- so every one of them had
// to be pushed onto a shadow stack by hand, and a forgotten `hold` was a crash that only appeared
// under memory pressure. Here the tracer walks two arrays and is finished.
//
// **A frame is data, which is what `await` will need.** Suspending a call means leaving its frame
// where it is and running something else; resuming means putting it back. Neither is possible while
// the state of a call is sysl's own call stack, and that -- not speed -- is why this exists.

// One call in progress.
struct Frame
    chunk: usize
    pc: usize

    // The scope names are looked up in. A block moves this to a child and back.
    scope: *EnvObj

    // How tall the operand stack was when this call started. `Ret` cuts back to it.
    base: usize

    // How many handlers were owed when this call started.
    //
    // **`return` out of a `try` body would otherwise leave its handler behind**, and a handler left
    // behind is worse than a missing one: it names a place in a chunk nobody is standing in any
    // more, so the next fault anywhere would restore the machine into the middle of a function that
    // has already returned.
    handlers: usize

    // Which of this call's parameters an argument arrived for, one bit each, lowest bit first.
    //
    // **`JumpIfGiven` is the only thing that reads it, and only in the head of a chunk with default
    // parameters.** It is here rather than in a local of the instruction loop alone because a
    // suspended call has to come back with its own answer: a coroutine parks between the head of a
    // chunk and the rest of it, and a generator is parked before it has run at all.
    given: usize

// Where to put the machine back to when a fault is caught.
//
// **Everything here is what the machine will be given back, not what it had.** A fault can be raised
// any number of frames deep and with any amount of half-evaluated arithmetic on the stack, so
// unwinding is not a matter of undoing steps -- it is a matter of having written down, once, what
// the world looked like where the `try` began.
struct Handler
    // Where the `catch` starts. Both are needed: a `try` and its `catch` are always in one chunk,
    // but the fault may have been raised several chunks away.
    chunk: usize
    pc: usize

    // What the operand stack, the frame stack and the scope chain are cut back to.
    sp: usize
    frames: usize
    scope: *EnvObj

    // The frame base the `catch` runs at, which is the one the `try` was written in.
    base: usize

    // And that frame's parameter mask, for the same reason it records the base: the `catch` carries
    // on in the chunk the `try` was written in, and the fault may have been raised in another one.
    given: usize

    // Whether this handler DISPOSES a resource rather than catching the fault.
    //
    // **One flag rather than a second stack, because the two nest with each other.** A `using`
    // inside a `try` and a `try` inside a `using` both have to unwind in the order they were
    // written, and one stack in written order is the only arrangement that gets that right for
    // free.
    disposing: bool

// Everything one line of execution is: its values, its calls, and where it is looking names up.
//
// **Bundled because `await` moves them together.** Suspending a call means setting all of them aside
// and running something else; resuming means putting them back. They were three module variables
// until it became clear that no operation ever wants one without the others.
struct Machine
    stack: Buf[Value]
    frames: Buf[Frame]

    // The promise this line of execution settles when it finishes, and null for the main program.
    //
    // **This is the whole of what makes a machine a coroutine.** An `async` function is called by
    // giving its body a machine of its own with this filled in; the caller is handed the promise
    // straight back and carries on, and whatever the body eventually answers -- a value, or a fault --
    // is written here for whoever awaited it.
    promise: *PromiseObj

    // The scope the running frame is looking names up in. **Not a sysl local, and that is not a style
    // choice**: `alloc` can collect at any allocation, so the scope in hand has to be reachable from
    // the root function at every instant. Keeping it in a local once swept the whole live scope chain
    // out from under the machine.
    scope: *EnvObj

    // The `try` blocks this line of execution is inside, innermost last.
    //
    // **A field of the machine and not module storage, because a coroutine takes its handlers with
    // it.** `await` inside a `try` parks the whole machine; the promise may fail minutes later, and
    // the `catch` that is owed the fault is the parked machine's own.
    handlers: Buf[Handler]

    // **Whether this slot holds something, said rather than inferred.** Emptiness was read off the
    // frames and the scope until a machine parked with values on its stack and nothing else matched
    // the same test -- and the next park wrote over it.
    live: bool

    // A fault raised by a `dispose` while another fault was already on its way out.
    //
    // **The signal itself and not the object a `catch` reads**, which is what keeps this off the
    // collector's books: a `Signal` is three sysl values and holds nothing the heap owns, so the
    // register can sit here across an allocation without the tracer having to learn about it. The
    // object is built where the ordinary fault's is, in `fault_value`, and only if somebody catches
    // it.
    //
    // **The FIRST one wins where a run of disposals faults.** It is the thing that went wrong
    // nearest to the original fault, and a chain of them is more than `suppressed` is worth.
    suppressed: Option[Signal]

// A machine with nothing in it, which is what a run and a park both start from.
//
// Not `private`: `new_vm` in `vm_state.sysl` builds the VM's first one.
fresh_machine() -> Machine = Machine(buf(), buf(), null, null, buf(), true, None)

// The line of execution currently running is `current().machine`, and the ones set aside are
// `current().parked`. **Both are fields of the VM rather than module storage** -- see
// `vm_state.sysl`, and `docs/design/vm-state.md` for why the whole runtime's state moved there.
//
// `parked` is empty until a coroutine parks, and the thing that makes a coroutine possible at all is
// that a machine's state is data rather than sysl's own call stack -- which is the whole reason the
// tree-walker was replaced.

// Set the running machine aside and answer where it went. The caller gets a clean one.
park() -> usize
    val v = current()
    val saved = v.machine

    v.machine = fresh_machine()

    for i in 0..<v.parked.len()
        if !v.parked.at(i).live
            v.parked.set(i, saved)
            return i

    v.parked.push(saved)
    v.parked.len() - 1
end park

// Put one back, and answer what was running in its place.
unpark(id: usize) -> Machine
    val v = current()
    val displaced = v.machine

    v.machine = v.parked.at(id)
    v.parked.set(id, Machine(buf(), buf(), null, null, buf(), false, None))
    displaced
end unpark


// How deep a slate program may call.
//
// **A machine has to impose this, where a tree-walker got it imposed on it.** The walker recursed in
// sysl, so runaway recursion exhausted the host stack and the process died with no diagnostic and
// none of the output it had already produced (card 0299). Frames live in an ordinary array here, so
// nothing stops them but this -- and a limit slate owns is a limit slate can *report*, pointing at
// the call that went one too deep.
//
// Ten thousand is roughly what node and the JVM allow, and far past any honest recursion; a program
// that wants more depth than this wants a loop.
//
// Not `private`: `execute.sysl` is what counts frames against it.
const MaxCallDepth: usize = 10000

// The unit being run is `current().current_unit`.
//
// **A field of the VM, because a hook has to reach it.** A user-supplied `equals` is called from
// inside a table lookup, which is called from `same`, which knows nothing about units -- so the chunk
// it needs is found through the VM rather than threaded through every comparison.
//
// Not `private`: everything that compiles into the unit or runs a chunk out of it wants a `*Unit`,
// which is what this answers.
running_unit() -> *Unit = &current().current_unit

// One `@test` the entry file declared.
struct TestCase
    name: string

    // Which file it came from, so a failure is rendered against the right one.
    source: usize

    fn: Value

// The tests the file being run declared are `current().registered_tests`, in the order they were
// written.
//
// **A root the collector has to walk.** A test function is reached from nothing else once its
// module's scope has been left, and it is the closure that keeps that scope -- and everything the
// test can see -- alive.

// The four things that can be written around a file's tests, as the index each is held under.
//
// **A number rather than four names, because everything about them is the same but when they run.**
// One instruction registers any of them, one buffer holds them and one function calls one, so the
// only place the four differ is the order `run_tests` asks for them in.
const HookSetup: usize = 0
const HookTeardown: usize = 1
const HookSetupAll: usize = 2
const HookTeardownAll: usize = 3

// How many of them there are, for the buffers below and for anything walking them.
const HookCount: usize = 4

// What the file being run wrote around its tests is `current().hook_fns`, `Null` where it wrote
// nothing, and `current().hook_names` is what each of them is called -- so that a failure in one
// names the function rather than the test that happened to be standing next to it.
//
// **A root the collector has to walk, for `registered_tests`'s reason**: a hook is reached from
// nothing else once its module's scope has been left, and it is the closure that keeps the file's
// top-level `var`s -- which is the whole point of having one -- alive.

// Not `private`: `new_vm` in `vm_state.sysl` builds both buffers, and `reset_vm` puts them back.
no_hooks() -> Buf[Value]
    var out: Buf[Value] = buf()

    for _ in 0..<HookCount
        out.push(Null)

    out
end no_hooks

no_hook_names() -> Buf[string]
    var out: Buf[string] = buf()

    for _ in 0..<HookCount
        out.push("")

    out
end no_hook_names

// Remember one of them, which is what `DefineHook` does.
set_hook(kind: usize, name: string, fn: Value)
    val v = current()

    v.hook_fns.set(kind, fn)
    v.hook_names.set(kind, name)

// What each module exported is `current().module_values`, in the order the modules ran.
//
// **A root the collector has to walk, and the only one the module system adds.** A module's exports
// are an ordinary object, so nothing else here is new: the closures in it hold their module's scope,
// the scope holds whatever it captured, and the tracer already knows how to follow all of it.

// Empty the machine between runs.
reset_vm()
    val v = current()

    v.machine = fresh_machine()
    v.parked.clear()
    v.module_values.clear()
    v.defs.clear()
    v.module_scopes.clear()
    v.registered_tests.clear()
    v.hook_fns = no_hooks()
    v.hook_names = no_hook_names()

    // **A shape holds the module scope it was declared in**, so the table goes back when the module
    // values do rather than when the event loop does.
    forget_shapes()

// Everything the loaded modules still hold.
mark_modules(h: *gc.Heap)
    val v = current()

    for i in 0..<v.module_values.len()
        mark_value(h, v.module_values.at(i))

    // **And every definition a read was resolved to.** Each is also in its module's scope, which is
    // walked below, so this adds no lifetime -- and a root that is not walked is a dangling one the
    // moment that stops being true.
    for i in 0..<v.defs.len()
        mark_value(h, v.defs.at(i))

    // **And the scope each module's statements ran in.** A class a file did not export is reachable
    // from nothing else once the file has finished, and `declared_here` looks one up by name when a
    // message carries an instance of it.
    for i in 0..<v.module_scopes.len()
        gc.mark(h, ptr_cast(v.module_scopes.at(i)))

    for i in 0..<v.registered_tests.len()
        mark_value(h, v.registered_tests.at(i).fn)

    for i in 0..<v.hook_fns.len()
        mark_value(h, v.hook_fns.at(i))

// Everything the machine can still reach, for the collector.
//
// **This replaces most of the shadow stack.** What is left of `hold`/`release` is only what code
// outside the machine holds -- a native builtin building an array, say.
mark_vm(h: *gc.Heap)
    val v = current()

    mark_machine(h, v.machine)

    // **Every parked line of execution is a root too.** A suspended call is not running, and is not
    // therefore any less alive -- everything it will touch when it resumes has to survive until then.
    for i in 0..<v.parked.len()
        if v.parked.at(i).live then mark_machine(h, v.parked.at(i))

private mark_machine(h: *gc.Heap, m: Machine)
    for i in 0..<m.stack.len()
        mark_value(h, m.stack.at(i))

    for i in 0..<m.frames.len()
        gc.mark(h, ptr_cast(m.frames.at(i).scope))

    gc.mark(h, ptr_cast(m.scope))
    gc.mark(h, ptr_cast(m.promise))

    // **A handler's scope is a root, and nothing else refers to it.** It is the scope the `try` was
    // written in, which the machine has since moved out of -- so between entering the body and
    // catching a fault, this is the only thing keeping it alive.
    for i in 0..<m.handlers.len()
        gc.mark(h, ptr_cast(m.handlers.at(i).scope))
