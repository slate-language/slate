module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.str_builder

// The walk: every statement and every expression, checked against what `fits.sysl` knows.
//
// **`fits.sysl` holds the rule this pass is built on** and is worth reading first -- the check may
// only report what the machine would also refuse, and every relation there mirrors a run-time test
// exactly. What is NOT checked yet is listed at the foot of this file.
//
// **What the builtins and the imports are known to be is in `signatures.sysl`**, cut out when this
// file reached a thousand lines: that one answers what a name nothing declared is, this one walks.

// -- the walk -----------------------------------------------------------------------------------

// Check one file's statements. Reported through the compiler's own channel, so a complaint from here
// stops the program exactly as a parse error does.
check_program(prog: Program, internal: bool)
    var env = type_env()

    // **THE BUILTINS ARE ASKED OF THE INSTALLER RATHER THAN LISTED AGAIN.** An undefined-name check
    // needs to know every name a program starts with, and `install_builtin_types` below carries only
    // the ones whose *type* is worth stating -- `print`, `assert`, `min` and five others deliberately
    // say nothing and would have looked undefined. A second list of 140 names would drift the first
    // time one was added; this builds a real scope with the real installer and asks it.
    //
    // **`install_core` and not `install_builtins`: a name a module has taken is NOT one a program
    // starts with.** `date(2026, 1, 1)` with no `import ... from slate:time` above it is a fault the
    // machine raises, so this pass has to see it too -- and asking the wrong installer would have
    // made the migration silent exactly where it needs to be loud.
    //
    // **ONE OF SLATE'S OWN MODULES IS THE EXCEPTION, and it is `run_modules`' exception in the same
    // words.** A slate-source module is compiled against every builtin, because the seam it is
    // written against -- `httpParser` and the rest -- is deliberately not part of the language. Ask
    // the wrong installer here and the module cannot see what it is made of.
    builtin_scope = new_env(null)

    if internal then install_builtins(builtin_scope) else install_core(builtin_scope)
    enter_scope(&env)
    install_builtin_types(&env)
    check_stmts(prog.stmts, &env)
    leave_scope(&env)
end check_program

// The scope every program starts in, built once per check. **Module storage because the walk reaches
// it from everywhere**, and a root nothing else refers to -- it is thrown away when the next program
// is checked.
var builtin_scope: *EnvObj = null

// Whether a program could find this name at all: something it wrote, or something it was given.
private defined(env: *TypeEnv, name: string) -> bool
    if has_name(env, name) then return true
    if builtin_scope == null then return true

    knows(builtin_scope, name)

// The shape of the object a `catch` binds. **`message`, `line` and `file`, always** -- `throw` turns
// whatever a program raised into the same three fields every other fault already leaves.
private fault_shape() -> Type
    var keys: Buf[string] = buf()
    var types: Buf[Type] = buf()
    var optional: Buf[bool] = buf()

    keys.push("message")
    types.push(type_of(StringType))
    optional.push(false)
    keys.push("line")
    types.push(type_of(IntegerType))
    optional.push(false)
    keys.push("file")
    types.push(type_of(StringType))
    optional.push(false)

    type_of(ObjectWith(keys, types, optional))
end fault_shape

// Every name a pattern introduces, as `Any`.
//
// **This is shadowing rather than typing.** A pattern's bindings are not given types yet -- what
// matters here is that a name a pattern took is no longer whatever an outer scope said it was, and
// most of all is no longer a builtin's signature. Without it, `for len in xs` would leave `len`
// looking like the builtin and the next call to it would be counted against the wrong thing.
private note_bindings(pat: Pattern, e: *TypeEnv)
    *pat.kind match
        // **A bare name says nothing about what it caught**, which is the whole of its job: it
        // matches anything, so anything is what is known about it.
        Bind(name) -> note_type(e, name, type_of(Any))

        // **`n @ int` is a test AND a name, so the name has the test's type.** This is the one place
        // a pattern says something a walk can use, and it is the spelling slate already had for
        // testing and naming at once -- so `n @ int -> n.push(1)` is refused before it runs, by the
        // method-name check that is this pass's best feature.
        //
        // **Resolved first, so a declared type or a class name works here too.** `q @ Square` reads
        // through `resolve_pattern` exactly as an annotation does; without that the name would be a
        // binding and the answer `Any`.
        At(name, inner) ->
            note_type(e, name, type_from_pattern(resolve_pattern(inner, 0)))
            note_bindings(inner, e)
        ArrayPat(items, _, rest, _) ->
            for i in 0..<items.len()
                note_bindings(items.at(i), e)

            // **What `...rest` catches is an ARRAY, whatever is in it.** The pattern says so on its
            // own -- no subject needed -- so this is the one binding in a pattern that has a type
            // without anybody writing one. `val [a, ...rest] = xs` then `rest.upper()` is refused.
            rest match
                Some(name) -> note_type(e, name, type_of(ArrayOf(type_of(Any))))
                None -> ()
        ObjectPat(_, values, _, _) ->
            for i in 0..<values.len()
                note_bindings(values.at(i), e)
        OrPat(alts) ->
            for i in 0..<alts.len()
                note_bindings(alts.at(i), e)
        AndPat(parts) ->
            for i in 0..<parts.len()
                note_bindings(parts.at(i), e)

        // A variant's fields are patterns like any others, and missing this made every name a
        // `Circle(r)` bound look undefined -- by the check that exists to catch a name nothing bound.
        VariantPat(_, items, _, _) ->
            for i in 0..<items.len()
                note_bindings(items.at(i), e)
        MadeFrom(_, inner) -> note_bindings(inner, e)
        _ -> ()
end note_bindings

// **Every definition in a block is noted before any statement is walked**, so a function may call
// one written below it and one written above may call it back. Whether the *machine* has run the
// definition by then is a different question and a different fault.
private check_stmts(stmts: Buf[Stmt], env: *TypeEnv)
    for i in 0..<stmts.len()
        *stmts.at(i).kind match
            Def(name, params, defaults, body, is_async) ->
                note_type(env, name, signature_of(params, floor_of(params, defaults.len()), body_at(body), is_async))

            // **EVERY name this block binds is noted before any body is walked, not only the
            // definitions.** A closure may name something declared later in the block it sits in --
            //
            //     val probe = { equals: o -> clear(xs) }
            //     val xs = [probe]
            //
            // -- which runs, because the body runs after `xs` exists. Checking that body against the
            // scope as it stood where the closure was *written* would refuse it, and refusing a
            // program that runs is the one thing this pass may not do. The type is `Any` here and the
            // real one is noted in the walk below, which shadows this by being nearer.
            Val(name, _) -> note_type(env, name, type_of(Any))
            Var(name, _) -> note_binding(env, name, type_of(Any), false)
            Unpack(pat, _, _) -> note_bindings(pat, env)

            // A group holds nothing but the `val`s one `data` line wrote, so this is the `Val` arm
            // above applied to each of them -- and it has to be here, or a function written above a
            // data declaration could not name one of its variants.
            Group(stmts) ->
                for j in 0..<stmts.len()
                    *stmts.at(j).kind match
                        Val(name, _) -> note_type(env, name, type_of(Any))
                        _ -> ()
            ImportNames(path, _, origin, names, locals) ->
                for j in 0..<locals.len()
                    note_type(env, locals.at(j), import_signature(path, origin, names.at(j)))
            ImportAll(_, _, _, alias) -> note_type(env, alias, type_of(Any))

            // **A type binds a value under its own name**, so a function written above the
            // declaration may name it -- which is the whole reason this is in the pre-pass rather
            // than only in the walk below.
            TypeDecl(name, _) -> note_type(env, name, shape_type())
            _ -> ()

    for i in 0..<stmts.len()
        check_stmt(stmts.at(i), env)
        guard_narrows(stmts.at(i), env)
end check_stmts

// **A GUARD CLAUSE NARROWS WHAT FOLLOWS IT**, which is the shape nearly every function in slate's
// own modules is written in:
//
//     val rel = safePath(asked)
//
//     if rel == null then return { status: 403, body: "Forbidden" }
//
//     joinPath(root, rel)
//
// Narrowing inside an `if`'s two branches is not enough for that, because the interesting half is
// what comes *after* the statement. It is sound for the reason the whole pass is: where the branch
// always leaves, reaching the line below it means the condition was false, so the rest of the block
// is exactly the else branch written out flat.
//
// **A guard with an `else` is not a guard** -- both halves rejoin below it and nothing more is known
// there than was known above.
private guard_narrows(s: Stmt, env: *TypeEnv)
    *s.kind match
        Eval(x) ->
            *x.kind match
                IfExpr(cond, then_branch, else_branch) ->
                    else_branch match
                        Some(_) -> ()
                        None ->
                            if always_leaves(then_branch) then narrow_by(cond, false, env)
                _ -> ()
        _ -> ()
end guard_narrows

// Whether control that reaches the end of this branch has left the block the branch is in.
//
// **The LAST statement is the whole of the question.** A branch ending in a `return`, a `throw`, a
// `break` or a `continue` cannot fall out of its bottom, and anything that jumped out earlier has
// left as well. A branch that leaves only sometimes says nothing here, which is the safe answer.
private always_leaves(x: Expr) -> bool
    *x.kind match
        Block(stmts) ->
            if stmts.len() == 0 then return false

            *stmts.at(stmts.len() - 1).kind match
                Return(_) -> true
                Throw(_) -> true
                Break(_, _) -> true
                Continue(_) -> true
                _ -> false
        _ -> false
end always_leaves

// The type of a definition, read back off the checks its annotations were desugared into.
//
// **The annotations are not on the `Def` and must not be put there.** The parser turns `f(x: string)`
// into a `CheckType` statement at the top of the body and `-> string` into an `Ensures` around it,
// which is what keeps every node downstream of a definition free of them. So this reads them back,
// and a parameter with no `CheckType` is `Any` -- which is what an unannotated parameter means.
private signature_of(params: Buf[string], required: usize, body: Expr, is_async: bool) -> Type
    var types: Buf[Type] = buf()

    // **A rest parameter is read through `plain_param`**, its name in the tree carrying the mark
    // `ast.sysl` describes -- and an annotation is looked up by the name the body binds.
    for i in 0..<params.len()
        types.push(annotation_for(plain_param(params.at(i)), body))

    // **An `async` function answers a promise and not what its body says**, so a result annotation
    // on one describes the awaited value rather than the call. Nothing here can say that yet, so it
    // says nothing.
    val result = if is_async then type_of(Any) else result_annotation(body)

    type_of(FunctionType(types, required, variadic_params(params), result))
end signature_of

// Whether the last parameter gathers what is left over.
//
// **A call on one has no upper arity**, so counting it against `params.len()` would refuse a program
// that runs -- which is the one thing this pass may not do.
private variadic_params(params: Buf[string]) -> bool =
    !params.is_empty() && rest_param(params.at(params.len() - 1)).is_some()

// How many arguments a call must give: every parameter with neither a default nor the dots.
//
// **A rest parameter is not one of them.** It is always bound -- to an empty array where a call gave
// nothing left over -- which is `compile_chunk`'s rule and has to be the same rule here, or the
// checker refuses a call the machine accepts.
private floor_of(params: Buf[string], defaults: usize) -> usize =
    (if variadic_params(params) then params.len() - 1 else params.len()) - defaults

// The `CheckType` a parameter's annotation became, if it had one.
private annotation_for(name: string, body: Expr) -> Type
    *body.kind match
        Ensures(inner, _, _) -> return annotation_for(name, inner)
        Block(stmts) ->
            for i in 0..<stmts.len()
                *stmts.at(i).kind match
                    // **Only the run of checks at the TOP of the body is read.** They are what the
                    // parser put there; a `CheckType` further down could not exist, and stopping at
                    // the first ordinary statement is what keeps that true if one ever could.
                    CheckType(checked, _, pat) ->
                        if checked == name then return type_from_pattern(resolve_pattern(pat, 0))
                    _ -> return type_of(Any)

            type_of(Any)
        _ -> type_of(Any)
end annotation_for

private result_annotation(body: Expr) -> Type
    *body.kind match
        Ensures(_, _, pat) -> type_from_pattern(resolve_pattern(pat, 0))
        _ -> type_of(Any)

private check_stmt(s: Stmt, env: *TypeEnv)
    *s.kind match
        Val(name, init) ->
            check_expr(init, env)
            note_type(env, name, type_of_expr(init, env))

        // **A `var` is `Any` whatever it was initialised with**, because a later assignment may put
        // anything there and this pass does not follow assignments. Narrowing one would be reporting
        // a program the checker had not read all of.
        Var(name, init) ->
            check_expr(init, env)
            note_binding(env, name, type_of(Any), false)
        Group(stmts) -> for i in 0..<stmts.len() do check_stmt(stmts.at(i), env)
        Unpack(pat, init, _) ->
            check_expr(init, env)
            note_bindings(pat, env)
        Assign(_, target, value) ->
            check_expr(target, env)
            check_expr(value, env)
        MultiAssign(_, targets, values) ->
            for i in 0..<targets.len()
                check_expr(targets.at(i), env)

            for i in 0..<values.len()
                check_expr(values.at(i), env)
        Def(_, params, defaults, body, _) -> check_body(params, defaults, body_at(body), env)

        // **An imported name is `Any` and, more to the point, is no longer a builtin's signature.**
        // A file that imports its own `map` would otherwise be checked against slate's -- and one of
        // slate's own modules is the exception, its exports being the builtins under another name.
        ImportNames(path, _, origin, names, locals) ->
            for i in 0..<locals.len()
                note_type(env, locals.at(i), import_signature(path, origin, names.at(i)))
        ImportAll(_, _, _, alias) -> note_type(env, alias, type_of(Any))
        Eval(x) -> check_expr(x, env)
        Return(value) -> value match
            Some(x) -> check_expr(x, env)
            None -> ()
        Throw(x) -> check_expr(x, env)
        TypeDecl(name, _) -> note_type(env, name, shape_type())
        _ -> ()
end check_stmt

// A definition's body, with its parameters in scope at the types its annotations gave them.
//
// **A default is code the program wrote and is walked like any other**, so a name it gets wrong is
// caught where it is written rather than at whichever call first leaves that argument out. Every
// parameter is in scope for it, which is wider than the run-time truth -- a default sees only the
// ones to its left -- and wider is the safe direction: this pass may not refuse a program that runs.
private check_body(params: Buf[string], defaults: Buf[Expr], body: Expr, env: *TypeEnv)
    enter_scope(env)

    // **The name the BODY binds, which is the plain one** -- a rest parameter carries its mark only
    // in the tree, and a body that named `...rest` would be naming something unspellable.
    //
    // **And a rest parameter is an ARRAY whatever a call gave it**, which is the same free answer
    // `...rest` gets in a pattern: it is bound to an empty one where nothing was left over, so
    // there is no call that makes it anything else.
    for i in 0..<params.len()
        val name = plain_param(params.at(i))

        rest_param(params.at(i)) match
            Some(_) -> note_type(env, name, type_of(ArrayOf(type_of(Any))))
            None -> note_type(env, name, annotation_for(name, body))

    for i in 0..<defaults.len()
        check_expr(defaults.at(i), env)

    check_expr(body, env)
    leave_scope(env)
end check_body

// -- what an expression is -------------------------------------------------------------------------

// The type of an expression, as far as the pass can tell. **`Any` wherever it cannot.**
type_of_expr(x: Expr, env: *TypeEnv) -> Type
    *x.kind match
        IntLit(_) -> type_of(IntegerType)
        RealLit(_) -> type_of(RealType)
        StrLit(_) -> type_of(StringType)
        BoolLit(_) -> type_of(BooleanType)
        Interp(_) -> type_of(StringType)
        Name(name) -> known_type(env, name)
        ArrayLit(_) -> type_of(ArrayOf(type_of(Any)))
        ArrayRepeat(_, _) -> type_of(ArrayOf(type_of(Any)))
        DataLit(inner) -> type_of_expr(inner, env)
        ObjectLit(keys, _, values) ->
            var out: Buf[Type] = buf()
            var certain: Buf[bool] = buf()

            for i in 0..<values.len()
                out.push(type_of_expr(values.at(i), env))

                // A literal's fields are all there -- optionality is something an annotation says
                // about what it will accept, never something a value says about itself.
                certain.push(false)

            type_of(ObjectWith(keys, out, certain))
        Lambda(params, defaults, _, _) ->
            var out: Buf[Type] = buf()

            for i in 0..<params.len()
                out.push(type_of(Any))

            type_of(FunctionType(out, floor_of(params, defaults.len()), variadic_params(params), type_of(Any)))

        // A comparison and an `is` are booleans whatever they compared.
        Compare(_, _) -> type_of(BooleanType)
        IsPattern(_, _, _) -> type_of(BooleanType)
        Unary(op, rhs) -> op match
            Bang -> type_of(BooleanType)
            _ -> type_of_expr(rhs, env)
        Binary(op, lhs, rhs) -> binary_type(op, type_of_expr(lhs, env), type_of_expr(rhs, env))
        Call(callee, _) -> *type_of_expr(callee, env).kind match
            FunctionType(_, _, _, result) -> result
            _ -> type_of(Any)
        Ensures(_, _, pat) -> type_from_pattern(resolve_pattern(pat, 0))
        _ -> type_of(Any)
end type_of_expr

// What an operator answers, given what it was handed.
//
// **Only the cases that are certain.** `+` over two integers is an integer; over anything less known
// it is `Any`, because the operator is overloaded on strings and promotes across the two number
// kinds. Saying `number` where it could be a string would be a claim the checker cannot support.
private binary_type(op: Tok, lhs: Type, rhs: Type) -> Type
    op match
        AndAnd -> return type_of(BooleanType)
        OrOr -> return type_of(BooleanType)
        _ -> ()

    if !is_arithmetic(op) then return type_of(Any)

    if is_kind_of(lhs, StringType) && is_kind_of(rhs, StringType) && op == Plus
        return type_of(StringType)

    if is_kind_of(lhs, IntegerType) && is_kind_of(rhs, IntegerType) then return type_of(IntegerType)

    // **A real anywhere in it makes the answer a real**, which is slate's promotion. Saying
    // `number` here instead would be true and too weak: `1.0 * 2` would then not fit a `real`
    // parameter, and the checker would be refusing a program that runs.
    if numeric(lhs) && numeric(rhs)
        if is_kind_of(lhs, RealType) || is_kind_of(rhs, RealType) then return type_of(RealType)

        return type_of(NumberType)

    type_of(Any)
end binary_type

private numeric(t: Type) -> bool =
    is_kind_of(t, IntegerType) || is_kind_of(t, RealType) || is_kind_of(t, NumberType)

private is_arithmetic(op: Tok) -> bool = op match
    Plus -> true
    Minus -> true
    Star -> true
    Slash -> true
    Percent -> true
    _ -> false

// -- what is complained about ----------------------------------------------------------------------

// Whether a `match` over a data type leaves one of its variants unmatched.
//
// **This is the one check in this pass that reports something the machine would refuse for a value
// nobody has yet written down.** It is sound because the subject's own ANNOTATION is the promise: a
// name declared `Shape` admits every variant of `Shape`, and a match that answers none of them for
// one of those is a function that refuses a value its own signature accepts -- which the machine
// meets as *"no arm of this match applies to ..."*. Where the subject's type is anything else, this
// says nothing at all, which is nearly everywhere.
private check_covers(subject: Expr, arms: Buf[Arm], env: *TypeEnv)
    val subject_type = type_of_expr(subject, env)

    val known = *subject_type.kind match
        DataType(name, variants) -> (name, variants)
        _ -> return

    val data = known.0
    val variants = known.1

    // **A variant reached under another name says nothing here.** An import may rename, so a list
    // naming `Circle` where the file binds it as `Round` would report a variant missing that is
    // matched on the very next line. Silence is the safe direction and this is the whole of the
    // guard: unless every name still resolves to the variant it names, nothing is claimed.
    for i in 0..<variants.len()
        if !variant_still_named(variants.at(i), subject.span) then return

    var covered: Buf[string] = buf()

    for i in 0..<arms.len()
        // **A guarded arm covers nothing.** Its guard may answer false for a value its pattern fits,
        // and the arm after it is then the one that has to have that value.
        if arms.at(i).guard.is_none()
            val pat = resolve_pattern(arms.at(i).pattern, 0)

            // A pattern that matches anything is how a program says it has finished listing cases,
            // and it is the way out of this check.
            if catches_all(pat) then return

            gather_variants(pat, &covered)

    var missing: Buf[string] = buf()

    for i in 0..<variants.len()
        if !holds(covered, variants.at(i)) then missing.push(variants.at(i))

    if missing.len() != 0
        complain_here(subject.span, s"this match does not cover every ${data} -- ${listed(missing)} unmatched. Add an arm for it, or `_` for whatever is left")
end check_covers

// Whether a name still resolves to the variant of that name.
private variant_still_named(name: string, at: Span) -> bool =
    *resolve_pattern(pattern(at, Bind(name)), 0).kind match
        VariantPat(n, _, _, _) -> n == name
        _ -> false

// Whether a pattern fits every value there is, which is what ends the listing.
private catches_all(pat: Pattern) -> bool =
    *pat.kind match
        Wild -> true
        Bind(_) -> true
        At(_, inner) -> catches_all(inner)
        _ -> false

// The variants an arm accounts for.
//
// **An alternative may not bind, so `Circle | Rect` is the one shape that covers two** -- and an
// alternative that is not a variant covers nothing, which is right: `Circle | 0` says nothing about
// `Rect`.
private gather_variants(pat: Pattern, into: *Buf[string])
    *pat.kind match
        VariantPat(name, _, _, _) -> if !holds(*into, name) then into.push(name)

        // `Circle { r }` accounts for `Circle` exactly as `Circle(r)` does -- how an arm took the
        // variant apart says nothing about which variant it was for.
        MadeFrom(name, _) -> if !holds(*into, name) then into.push(name)
        OrPat(alts) ->
            for i in 0..<alts.len()
                gather_variants(alts.at(i), into)

        // **An intersection covers only what EVERY part covers, and no variant is every part** --
        // an exhaustiveness listing built from one would name variants the arm cannot actually
        // take. Saying nothing is the safe direction for this pass.
        AndPat(_) -> ()
        At(_, inner) -> gather_variants(inner, into)
        _ -> ()
end gather_variants

// `Circle` / `Circle and Rect` / `Circle, Rect and Empty` -- one name or a list read aloud.
private listed(names: Buf[string]) -> string
    if names.len() == 1 then return s"`${names.at(0)}` is"

    var out = str_builder()

    for i in 0..<names.len()
        if i != 0 then out.push(if i == names.len() - 1 then " and " else ", ")

        out.push_char('`')
        out.push(names.at(i))
        out.push_char('`')

    out.push(" are")
    out.finish()
end listed

private check_expr(x: Expr, env: *TypeEnv)
    val at = x.span

    *x.kind match
        Call(callee, args) ->
            check_expr(callee, env)

            for i in 0..<args.len()
                check_expr(arg_body(args.at(i)), env)

            check_method(callee, env)
            check_call(callee, args, env, at)
        Binary(op, lhs, rhs) ->
            check_expr(lhs, env)
            check_expr(rhs, env)
            check_binary(op, lhs, rhs, env, at)
        Unary(_, rhs) -> check_expr(rhs, env)
        Block(stmts) ->
            enter_scope(env)
            check_stmts(stmts, env)
            leave_scope(env)
        ArrayLit(items) -> for i in 0..<items.len() do check_expr(items.at(i), env)
        DataLit(inner) -> check_expr(inner, env)
        ObjectLit(_, _, values) -> for i in 0..<values.len() do check_expr(values.at(i), env)
        Interp(pieces) -> for i in 0..<pieces.len() do check_expr(pieces.at(i), env)
        Compare(operands, _) -> for i in 0..<operands.len() do check_expr(operands.at(i), env)
        Field(target, _, _) -> check_expr(target, env)
        Index(target, key) ->
            check_expr(target, env)
            check_expr(key, env)
        WithAll(base, other, _) ->
            check_expr(base, env)
            check_expr(other, env)
        WithFields(base, _, values) ->
            check_expr(base, env)

            for i in 0..<values.len()
                check_expr(values.at(i), env)
        Await(inner) -> check_expr(inner, env)
        Ensures(value, declared, pat) ->
            check_expr(value, env)

            // **A body that is one expression is checked against what the definition promised.** A
            // block answers `Any` here and is left alone, which is also what keeps an early `return`
            // out of it: nothing about a block's value is known, so nothing is claimed.
            val answered = type_of_expr(value, env)
            val promised = type_from_pattern(resolve_pattern(pat, 0))

            if !fits(answered, promised)
                complain_here(value.span, s"this was declared to answer ${declared}, and answers ${show_type(answered)}")
        IfExpr(cond, then_branch, else_branch) ->
            check_expr(cond, env)

            enter_scope(env)
            narrow_by(cond, true, env)
            check_expr(then_branch, env)
            leave_scope(env)

            else_branch match
                Some(other) ->
                    enter_scope(env)
                    narrow_by(cond, false, env)
                    check_expr(other, env)
                    leave_scope(env)
                None -> ()
        MatchExpr(subject, arms) ->
            check_expr(subject, env)

            for i in 0..<arms.len()
                // **A pattern's bindings are not typed yet**, so the arm's body is walked in a scope
                // that knows nothing new -- which is `Any` for every name the pattern introduced, and
                // therefore silent about all of them.
                enter_scope(env)
                note_bindings(arms.at(i).pattern, env)
                narrow_by_arm(subject, arms.at(i).pattern, env)

                // **The guard is walked in the ARM's scope, and was not walked at all until now.**
                // It runs where the pattern's names are bound, which is what it is for -- and a name
                // misspelled in one was the single place the undefined-name check could not see.
                arms.at(i).guard match
                    Some(g) -> check_expr(g, env)
                    None -> ()

                check_expr(arms.at(i).body, env)
                leave_scope(env)

            check_covers(subject, arms, env)
        While(_, cond, body, otherwise) ->
            check_expr(cond, env)
            check_expr(body, env)
            check_otherwise(otherwise, env)
        For(_, binding, iter, body, otherwise) ->
            check_expr(iter, env)
            enter_scope(env)

            // **A `for` OVER A KNOWN LIST TYPES ITS NAME, and that became possible the day
            // `array of T` did.** `ArrayOf` has carried its element since the checker was written
            // and had nothing but `Any` to put there, so the loop variable said nothing; now
            // `for u in users` where `users: array of User` makes `u` a `User`, which the
            // method-name check reads.
            //
            // **Only a BARE name is typed**, for narrowing's reason: anything else is a pattern
            // taking the element apart, and what its names catch is the pattern's business.
            element_of(type_of_expr(iter, env)) match
                Some(element) -> *binding.kind match
                    Bind(name) -> note_type(env, name, element)
                    _ -> note_bindings(binding, env)
                None -> note_bindings(binding, env)

            check_expr(body, env)
            leave_scope(env)
            check_otherwise(otherwise, env)
        Loop(_, body) -> check_expr(body, env)
        DoWhile(_, body, cond, otherwise) ->
            check_expr(body, env)
            check_expr(cond, env)
            check_otherwise(otherwise, env)
        TryCatch(body, caught, handler) ->
            check_expr(body, env)
            enter_scope(env)

            // **A fault is an ordinary object and its three fields are always there**, so the name a
            // `catch` binds is the one name in the language whose shape is known without anybody
            // writing it down. What that buys today is the method-name check -- `catch e` then
            // `e.push(1)` is refused -- and it will buy more the day a field read is typed.
            note_type(env, caught, fault_shape())
            check_expr(handler, env)
            leave_scope(env)
        Lambda(params, defaults, body, _) -> check_body(params, defaults, body_at(body), env)

        // **A NAME NOTHING HAS BOUND IS REFUSED BEFORE IT RUNS**, which is the most common mistake
        // there is in any language and the one a dynamic language usually finds last -- a typo on a
        // branch nobody took until a customer took it.
        //
        // **It is sound because the machine would refuse the same program**: a name is bound by a
        // `val`, a `var`, a definition, a parameter, a pattern, an import or the builtins, and this
        // pass tracks every one of those. A name used before the `val` that binds it in the same
        // block faults at run time too -- the scope has nothing in it yet -- so refusing it early is
        // the same answer sooner.
        Name(name) ->
            if !defined(env, name)
                complain_here(x.span, s"`${name}` is not defined${nearest(env, name)}")

        // **An `is` BINDS INTO THE SURROUNDING SCOPE**, which is the machine's rule -- `if x is
        // { n }` leaves `n` standing after it. Nothing here checked the subject or noted the
        // bindings before, which was harmless while every unknown name was `Any` and is not once a
        // name nothing bound is a complaint.
        IsPattern(subject, pat, _) ->
            check_expr(subject, env)
            note_bindings(pat, env)
        _ -> ()
end check_expr

// The nearest name the program does know, where one is close enough to be worth naming.
//
// **A suggestion is only offered where it is nearly right.** "Did you mean" is the most annoying
// thing a compiler does when it guesses badly, so the distance has to be one edit for a short name
// and two for a long one, and nothing else is offered at all.
private nearest(env: *TypeEnv, name: string) -> string
    var best = ""
    var best_at: usize = 3

    for i in 0..<env.names.len()
        val d = distance(name, env.names.at(i))

        if d < best_at
            best = env.names.at(i)
            best_at = d

    val limit: usize = if name.bytes.len <= 4 then 1 else 2

    if best == "" || best_at > limit then "" else s" -- did you mean `${best}`?"

// How many single-character edits apart two names are, up to the point where nobody cares.
//
// **Public only because `private` is private to the FILE in sysl.** `module.sysl` offers the same
// suggestion about a name a module does not export, and two edit distances kept in step by hand is
// the sort of duplication that drifts.
distance(a: string, b: string) -> usize
    val x = a.bytes
    val y = b.bytes

    if x.len == 0 then return y.len
    if y.len == 0 then return x.len

    var previous: Buf[usize] = buf()
    var current: Buf[usize] = buf()

    for j in 0..<(y.len + 1)
        previous.push(j)
        current.push(0)

    for i in 0..<x.len
        current.set(0, i + 1)

        for j in 0..<y.len
            val substitute = previous.at(j) + (if x[i] == y[j] then 0 else 1)
            val insert = current.at(j) + 1
            val remove = previous.at(j + 1) + 1
            var least = substitute

            if insert < least then least = insert
            if remove < least then least = remove

            current.set(j + 1, least)

        for j in 0..<(y.len + 1)
            previous.set(j, current.at(j))

    previous.at(y.len)
end distance

// **An arm narrows its subject the way an `is` narrows its operand**, and for the same reason: the
// arm only runs where the pattern took. `note_bindings` has already put the arm's own names in, so
// this is on top of them and a name the pattern bound wins by being nearer.
private narrow_by_arm(subject: Expr, pat: Pattern, env: *TypeEnv)
    *subject.kind match
        Name(name) ->
            if !may_narrow(env, name) then return

            first_binding(pat) match
                Some(_) -> ()
                None -> note_binding(env, name, type_from_pattern(resolve_pattern(pat, 0)), true)
        _ -> ()
end narrow_by_arm

private check_otherwise(otherwise: Option[Expr], env: *TypeEnv)
    otherwise match
        Some(x) -> check_expr(x, env)
        None -> ()

// `x.m(...)` where the kind of `x` is known: a method name that kind does not have.
//
// **This is the most common mistake a checker can catch in a dynamic language** -- a name off by a
// letter, or one borrowed from another type -- and it is sound here because it asks the machine's own
// question. `methods_of` is the table `builtin_method` dispatches through, so what this refuses is
// exactly what the machine would refuse, and a name added to a kind is added in one place.
//
// **An object is not asked about**, its names being the program's; nor is anything whose type is not
// certain, which is the ordinary case in unannotated code.
private check_method(callee: Expr, env: *TypeEnv)
    *callee.kind match
        Field(target, name, _) ->
            val t = type_of_expr(target, env)

            if !certain(t) then return

            val kind = method_kind_word(t)

            if kind == "" then return
            if methods_of(kind, name).is_some() then return

            // **The same sentence the machine would have printed**, down to the article: a reader
            // who meets this at compile time and then at run time must not have to work out that the
            // two are one complaint.
            complain_here(callee.span, s"`${name}` is not something ${article(kind)} ${kind} can do")
        _ -> ()
end check_method

// The word a type's methods are looked up under, or `""` where it has none to look up.
//
// **Only the kinds `method.sysl` has a table for**, which is what keeps this from claiming anything
// about an object, a function or `null`: an object's names belong to the program, and the other two
// have no methods at all, so a complaint about either would have to come from somewhere that knows
// more than this does.
private method_kind_word(t: Type) -> string
    *t.kind match
        StringType -> "string"

        // **`integer` and `real` rather than `number`**, since that is what `type_name` says at run
        // time and the two messages have to read alike. `methods_of` takes all three words and
        // answers from the one table.
        IntegerType -> "integer"
        RealType -> "real"
        NumberType -> "number"
        ArrayOf(_) -> "array"
        NamedType(name) -> name
        RegexType -> "regex"
        _ -> ""
end method_kind_word

// `a` or `an`, so that a complaint reads as English.
private article(word: string) -> string
    val b = word.bytes

    if b.len == 0 then return "a"

    val c = b[0]

    if c == u8('a') || c == u8('e') || c == u8('i') || c == u8('o') || c == u8('u') then "an" else "a"
end article

// A call whose callee is a function the pass knows the shape of.
//
// **Arity first, and it stops there when it is wrong**, because a mismatched count makes every
// argument's position a guess -- reporting four type errors for one missing argument is the
// commonest way a checker becomes something to work around.
private check_call(callee: Expr, args: Buf[Expr], env: *TypeEnv, at: Span)
    // **A spread makes the count unknowable, so this pass says nothing about the call at all.**
    // `f(...xs)` gives `f` as many arguments as `xs` has elements, which is a run-time fact; a
    // checker counting the spread as one argument would refuse a program that runs, and that is the
    // one mistake it may not make. The machine still counts, at the call.
    for i in 0..<args.len()
        *args.at(i).kind match
            Spread(_) -> return
            _ -> ()

    *type_of_expr(callee, env).kind match
        FunctionType(params, required, variadic, result) ->
            // A lambda's type has `Any` parameters and says nothing; a definition with no annotated
            // parameter has the same shape. Either way there is nothing here to check against.
            // **`FunctionType(no params, any result)` IS THE BARE WORD `function`**, which says
            // callable and nothing about arity -- `f: function` writes exactly that. Counting
            // against it would refuse `f(1)` inside a function whose parameter was annotated
            // `function`, which runs. The cost is that a genuine `() -> x` has the same shape and
            // goes uncounted too, and the cost is worth paying to be sure.
            if !says_nothing(params, result) && (args.len() < required || (!variadic && args.len() > params.len()))
                complain_here(at, s"${named(callee)} ${takes_from(required, params.len(), variadic)} and this gives it ${args.len()}")
                return
            end if

            // **Nothing is checked where there are more arguments than parameters**, which is also
            // the case a type saying nothing about arity leaves behind: there is no parameter
            // opposite an argument to compare it to. Where there are FEWER, every argument still
            // has one, and the ones nobody gave are the defaults.
            if variadic || args.len() > params.len() then return

            // **A NAMED ARGUMENT IS NOT AT THE POSITION IT WAS WRITTEN AT, and this pass cannot say
            // where it IS.** `FunctionType` carries the parameter TYPES and not their names, so
            // there is nothing here to match `greeting:` against -- and checking the argument
            // against the parameter it happens to sit opposite would compare a value to a type it
            // was never going to meet. That is reporting what the machine would not, which is the
            // one thing this pass may not do, so it steps aside exactly as it does for a spread.
            //
            // The COUNT above still holds: every parameter without a default has to be given and no
            // call may give more than there are, so a named call's count is between the same two
            // ends a positional one's is.
            for i in 0..<args.len()
                *args.at(i).kind match
                    Named(_, _) -> return
                    _ -> ()

            for i in 0..<args.len()
                val want = params.at(i)
                val got = type_of_expr(args.at(i), env)

                if !fits(got, want)
                    complain_here(args.at(i).span, s"${named(callee)} takes ${show_type(want)} here, and this is ${show_type(got)}")
        _ -> ()
end check_call

// What an argument's value is, a named one carrying it inside.
private arg_body(x: Expr) -> Expr = *x.kind match
    Named(_, value) -> value
    _ -> x

// The half of an arity complaint that says what the function will accept.
// **A function that gathers has no upper end, so the only thing to say is the floor** -- and naming
// one anyway sends the reader looking for a limit the function does not have. This is the machine's
// `arity_complaint` said in the checker's voice, and the two have to agree about what they refuse.
private takes_from(required: usize, takes: usize, variadic: bool) -> string
    if variadic then return s"takes at least ${counted(required, "argument")}"

    if required == takes then return s"takes ${counted(takes, "argument")}"

    s"takes from ${required} to ${counted(takes, "argument")}"
end takes_from

private says_nothing(params: Buf[Type], result: Type) -> bool
    if !params.is_empty() then return false

    *result.kind match
        Any -> true
        _ -> false
end says_nothing

// **Only where BOTH sides are known and neither could meet the other.** `1 + "a"` is a fault the
// machine would raise, so saying it now is moving the same complaint earlier; anything less certain
// is left alone.
private check_binary(op: Tok, lhs: Expr, rhs: Expr, env: *TypeEnv, at: Span)
    if !is_arithmetic(op) then return

    val a = type_of_expr(lhs, env)
    val b = type_of_expr(rhs, env)

    if numeric(a) && numeric(b) then return
    if op == Plus && is_kind_of(a, StringType) && is_kind_of(b, StringType) then return

    // **A temporal operand is left to the machine, and this pass may not do otherwise.** What `+`,
    // `-` and `*` mean over the eight temporal kinds is a table of its own in `time.sysl` -- an
    // instant minus an instant is a duration, a zoned reading plus a period is a zoned reading, a
    // duration times an integer is a duration -- and restating it here would be a second copy to
    // keep in step by hand. It refused `monotonic() - a`, which runs, the first time it was tried.
    if is_named_kind(a) || is_named_kind(b) then return

    // Anything not certainly one of the two workable pairings is left to the machine.
    if !certain(a) || !certain(b) then return

    complain_here(at, s"`${op_text(op)}` does not apply to ${show_type(a)} and ${show_type(b)}")
end check_binary

// Whether this is one of the kinds that is nothing but its word. Their operators are their own
// subject, and a generator has none at all.
private is_named_kind(t: Type) -> bool
    *t.kind match
        NamedType(_) -> true
        _ -> false

// Whether enough is known about a type to argue from it.
private certain(t: Type) -> bool
    *t.kind match
        Any -> false
        OneOf(_) -> false
        _ -> true
end certain

// How a callee is named in a complaint, which is its name where it has one.
private named(callee: Expr) -> string
    *callee.kind match
        Name(name) -> s"`${name}`"
        Field(_, name, _) -> s"`${name}`"
        _ -> "this function"
end named

// -- what this pass does NOT do yet ----------------------------------------------------------------
//
// Written down because the absences are decisions rather than oversights, and because each one is
// the next piece of work rather than a thing to be surprised by.
//
// - **A name bound by a PATTERN has no type.** A `match` arm, a `catch`, a destructuring binding and
//   a `for` head all introduce names the walk leaves as `Any`. The patterns already carry the
//   information -- `type_from_pattern` would answer for most of them -- and threading it in is the
//   obvious next step.
// - **A `var` is always `Any`**, because this pass does not follow assignments. Narrowing one would
//   be reporting a program the checker has not read all of.
// - **A field read is `Any`, and it is NOT just a missing lookup** -- that reading was wrong and is
//   worth correcting here rather than being rediscovered. The information does sit in `ObjectWith`,
//   but a field is *mutable* and this pass does not follow assignments: `val o = { x: 1 }` then
//   `o.x = "s"` leaves the recorded type saying `integer` about a string. **`val` binds the
//   reference, not the fields.** So typing a field read would report what the machine would not, and
//   that is the one thing this pass may not do -- the same reason a `var` is `Any`, applied one level
//   in. Following field assignment is the way in, and it is a real piece of work rather than a
//   lookup.
// - **A function's RESULT is not checked against its body.** `-> integer` is enforced by
//   `CheckResult` at run time and believed here.
// - **A NAMED ARGUMENT is not placed.** `FunctionType` carries parameter types and not parameter
//   names, so `f(b: 1)` cannot be matched to a slot here and the per-argument type check steps
//   aside for the whole call. The count is still checked, that being the same between the two ends
//   whichever way the arguments were written. **Carrying the names in `FunctionType` is the way
//   in**, and it would pay for itself twice: the machine's own message names the parameter, and
//   this pass could say the same thing before the program runs.
// - **Narrowing reaches an `if` and a `match` arm and nothing else.** A `while`, a guard and the
//   right-hand side of `||` all leave the subject as it was.
// - **A temporal operator is not checked at all.** What `+`, `-` and `*` mean over the eight
//   temporal kinds is a table in `time.sysl`, and restating it here would be a second copy kept in
//   step by hand -- so `check_binary` steps aside for them. Reading that table rather than copying
//   it is the way in, if it is ever worth doing.
//
// **A METHOD NAME IS CHECKED NOW, AND IT IS THE MOST USEFUL THING THIS PASS DOES.** `"abc".push(1)`
// and `date(2026, 1, 1).hour()` are refused before they run, which is the commonest mistake there is
// in a language with per-kind method tables. It is sound because it asks the machine's own question:
// `methods_of` in `method.sysl` is the table `builtin_method` dispatches through, so a name added to
// a kind is added in one place and the two can never disagree. An object is never asked about -- its
// names are the program's -- and nor is a receiver whose type is not certain.

