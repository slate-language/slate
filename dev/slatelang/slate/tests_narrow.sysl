module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// NARROWING -- what a name is known to hold inside a branch that tested it.
//
// **Cut out of `tests_builtins.sysl` on the heading it already had**, when the side a test did NOT
// hold on started saying something too and the topic outgrew a corner of the file about signatures.
//
// **One rule holds every test here together: narrowing may only ever take a report AWAY.** A branch
// that tested a name knows more about it than the line above did, and the pass is allowed to use
// that -- but wherever the extra knowledge is not certain, it says nothing at all. A `var` may be
// written to, a name of type `any` was never anything to sharpen, and a union with every alternative
// taken away describes a branch nothing reaches. Each of those has a test below whose whole point is
// that a program RUNS.

@test
A_TEST_NARROWS_THE_NAME_IT_TESTED()
    // **The feature a reader coming from TypeScript looks for first.** `x is string` makes `x` a
    // string for as long as the test held, so a call inside the branch is checked against that.
    val setup = "takes_string(s: string) = s\ntakes_number(n: number) = n\n"

    assert(fails(setup + "f(x) = if x is number then takes_string(x) else 0\nf(1)").contains("takes string here, and this is number"))
    assert_eq(out(setup + "f(x) = if x is string then takes_string(x) else 0\nprint(f(\"a\"))"), "a")

    // A `match` arm narrows its subject by the same rule, the arm only running where it took.
    val armed = setup + "f(x) = x match\n    string -> takes_number(x)\n    _ -> 0\nf(\"a\")"

    assert(fails(armed).contains("takes number here, and this is string"))

    // `&&` narrows by both, which is what the second operand is already inside when it runs.
    assert(fails(setup + "f(x) = if x is string && len(x) > 0 then takes_number(x) else 0\nf(\"a\")").contains("takes number here, and this is string"))

    // A negated test narrows the OTHER branch, which is the same rule read backwards.
    assert(fails(setup + "f(x) = if x is not string then 0 else takes_number(x)\nf(\"a\")").contains("takes number here, and this is string"))

@test
THE_RIGHT_OPERAND_OF_A_CONNECTIVE_IS_WALKED_WHERE_THE_LEFT_ONE_HELD()
    // **The narrowing reaches INSIDE the condition, not only into the branch.** `x != null && f(x)`
    // is the same claim as an `if` around an `if` -- the right operand runs nowhere else -- and
    // refusing one while accepting the other broke this pass's own first rule.
    val setup = "takes_string(s: string) = s\ntakes_number(n: number) = n\n"

    assert_eq(out(setup + "f(x: string | null) = x != null && takes_string(x) == \"a\"\nprint(f(\"a\"), f(null))"), "true false")
    assert_eq(out(setup + "f(x) = x is string && len(takes_string(x)) == 1\nprint(f(\"a\"), f(1))"), "true false")

    // **`||` is the same rule read backwards**, its right operand running where the left did not.
    assert_eq(out(setup + "f(x: string | null) = x == null || takes_string(x) == \"a\"\nprint(f(null), f(\"b\"))"), "true false")

    // And the narrowing is still a claim that can be wrong, so the wrong call in the same place is
    // still refused -- which is what says the two above are being checked at all.
    assert(fails(setup + "f(x: string | null) = x != null && takes_number(x) == 1\nf(\"a\")").contains("takes number here, and this is string"))

    // **It does not leak past the connective.** The name is what it was declared once the operand
    // that narrowed it is done with.
    assert(fails(setup + "f(x: string | null) = (x != null && len(x) > 0) || takes_string(x) == \"\"\nf(null)").contains("takes string here, and this is string | null"))

@test
A_VAR_IS_NEVER_NARROWED_BECAUSE_THE_BRANCH_MAY_WRITE_TO_IT()
    // **A stale narrowing is too NARROW, which refuses a program that runs** -- so the environment
    // records whether a name may be written to, and a mutable one is left alone however it tested.
    val prog = "takes_string(s: string) = s\nvar m = 1\nif m is number\n    m = \"text\"\n    print(takes_string(m))"

    assert_eq(out(prog), "text")

@test
THE_SIDE_A_TEST_DID_NOT_HOLD_ON_TAKES_THE_ALTERNATIVE_AWAY()
    // **`x is string` failing says as much about a union as its holding says about the other side.**
    // Until the else branch subtracted, this pass refused the plainest program a union is written
    // for -- and refusing a program that runs is the one mistake it may not make.
    val setup = "takes_string(s: string) = s\ntakes_number(n: number) = n\n"

    assert_eq(out(setup + "f(x: string | number) = if x is string then 0 else takes_number(x)\nprint(f(1))"), "1")
    assert_eq(out(setup + "f(x: string | number) = if x is number then 0 else takes_string(x)\nprint(f(\"a\"))"), "a")

    // And the type it is left with is exactly the rest of the union, which the wrong call in the
    // same place says out loud.
    assert(fails(setup + "f(x: string | number) = if x is string then 0 else takes_string(x)\nf(1)").contains("takes string here, and this is number"))

    // **A union of three loses one and stays a union**, rather than collapsing to nothing.
    assert(fails(setup + "f(x: string | number | null) = if x is number then 0 else takes_number(x)\nf(1)").contains("and this is string | null"))

    // `null` comes out the same way, which is the shape a nullable annotation is written in.
    assert(fails(setup + "f(x: string | null) = if x is string then \"n\" else takes_string(x)\nf(null)").contains("and this is null"))

@test
A_SIDE_THAT_LEAVES_NOTHING_TO_SAY_SAYS_NOTHING()
    // **THE THREE PLACES NARROWING STANDS ASIDE, each one a program that RUNS.** A type that is not
    // a union has no alternative to take away; a name of type `any` was never anything to sharpen;
    // and a union that empties describes a branch nothing reaches, where a complaint could only be
    // about code that never runs.
    val setup = "takes_string(s: string) = s\ntakes_number(n: number) = n\n"

    assert_eq(out(setup + "f(x: string) = if x is string then 0 else takes_number(x)\nprint(f(\"a\"))"), "0")
    assert_eq(out(setup + "f(x) = if x is string then 0 else takes_number(x)\nprint(f(1))"), "1")
    assert_eq(out(setup + "f(x: string | number) = if x is string then takes_string(x) else takes_number(x)\nprint(f(\"a\"), f(1))"), "a 1")

    // A `var` is left alone on the side a test did NOT hold on, exactly as on the side it did --
    // the branch being free to write to it either way.
    assert_eq(out("takes_string(s: string) = s\nvar m = 1\nif m is string\n    print(\"s\")\nelse\n    m = \"text\"\n    print(takes_string(m))"), "text")

@test
A_GUARD_THAT_LEAVES_NARROWS_THE_REST_OF_THE_BLOCK()
    // **The interesting half of a guard is what comes AFTER it.** Where the branch always leaves,
    // reaching the line below means the test was false, so the rest of the block is the else branch
    // written out flat -- and it subtracts exactly as an else branch does.
    val setup = "takes_string(s: string) = s\ntakes_number(n: number) = n\n"

    assert_eq(out(setup + "f(x: string | number)\n    if x is string\n        return 0\n\n    takes_number(x)\nprint(f(1))"), "1")
    assert_eq(out(setup + "f(x: string | null)\n    if x == null then return \"n\"\n\n    takes_string(x)\nprint(f(\"a\"))"), "a")

    // **A guard with an `else` is not a guard**: both halves rejoin below it and nothing more is
    // known there than was known above.
    assert(fails(setup + "f(x: string | number)\n    if x is string\n        return 0\n    else\n        print(x)\n\n    takes_number(x)\nf(1)").contains("and this is string | number"))

@test
BOTH_SPELLINGS_OF_A_NEGATED_TEST_NARROW_THE_SAME_SIDE()
    // **`!(x is string)` and `x is not string` are one test written two ways**, so they narrow the
    // same branch -- and until `!` was read here the two did not mean the same thing.
    val setup = "takes_string(s: string) = s\ntakes_number(n: number) = n\n"

    assert_eq(out(setup + "f(x: string | null) = if !(x is string) then \"n\" else takes_string(x)\nprint(f(\"a\"))"), "a")
    assert_eq(out(setup + "f(x: string | number) = if !(x is string) then takes_number(x) else 0\nprint(f(1))"), "1")

    // A `!` in front of a null test is the same rule, and the narrowing is still a claim that can be
    // wrong -- which is what says these are being checked at all.
    assert_eq(out(setup + "f(x: string | null) = if !(x == null) then takes_string(x) else \"n\"\nprint(f(\"a\"))"), "a")
    assert(fails(setup + "f(x: string | null) = if !(x is string) then \"n\" else takes_number(x)\nf(\"a\")").contains("and this is string"))

@test
THE_ELSE_OF_A_CONNECTIVE_KNOWS_NEITHER_OPERAND_HELD()
    // **`a || b` reaching its else means both were false**, so both narrow there -- which is what
    // makes a guard written with `||` the program it reads as.
    val setup = "takes_string(s: string) = s\ntakes_number(n: number) = n\n"

    assert_eq(out(setup + "f(x: string | null, done: boolean) = if x == null || done then \"n\" else takes_string(x)\nprint(f(\"a\", false))"), "a")
    assert_eq(out(setup + "f(x: string | number, done: boolean) = if x is string || done then 0 else takes_number(x)\nprint(f(1, false))"), "1")

    // And `&&` is the same rule on the other side, its then branch knowing both held.
    assert_eq(out(setup + "f(x: string | null, done: boolean) = if x != null && done then takes_string(x) else \"n\"\nprint(f(\"a\", true))"), "a")
    assert(fails(setup + "f(x: string | null, done: boolean) = if x == null || done then \"n\" else takes_number(x)\nf(null, false)").contains("and this is string"))

@test
AN_ANNOTATED_VAR_IS_FOLLOWED_THROUGH_THE_BLOCK_IT_WAS_DECLARED_IN()
    // **THE ANNOTATION IS TWO TYPES AND NOT ONE.** `var m: string | number` may only ever be
    // ASSIGNED one of those, which is what writing the annotation asks for -- and what a READ of it
    // answers is what the last line to write to it put there. Until the second half was here the
    // pass refused the plainest program a union `var` is written for: every run reaches the call
    // with a string and the call was refused, which is the one mistake it may not make.
    val setup = "takes_string(s: string) = s\ntakes_number(n: number) = n\n"

    assert_eq(out(setup + "var m: string | number = 1\nif m is string\n    print(m)\nelse\n    m = \"text\"\n\nprint(takes_string(m))"), "text")

    // A plain assignment is the same rule with no branch around it.
    assert_eq(out(setup + "var m: string | number = 1\nm = \"x\"\nprint(takes_string(m))"), "x")

    // **AN ASSIGNMENT IS STILL MEASURED AGAINST THE ANNOTATION**, which is the half that was already
    // here: what the name holds moves, what it may hold does not.
    assert(fails("var m: string | number = 1\nm = true\nprint(m)").contains("`m` was declared string | number, and this is boolean"))

    // And an assignment inside a branch that narrowed the name is measured against the annotation
    // too -- against the narrowing it would be refused, and it is a program that runs.
    assert_eq(out(setup + "var m: string | number = \"a\"\nif m is string\n    m = 1\n\nprint(takes_number(m))"), "1")

@test
A_VAR_IS_NARROWED_NOW_AND_A_BRANCH_THAT_WRITES_TO_IT_SAYS_SO_ITSELF()
    // **A branch that reassigns what it narrowed writes a note OVER the narrowing**, which is what
    // makes narrowing a `var` sound -- the stale claim the flag used to exist to prevent cannot be
    // left behind, because the assignment is the later word on what the name holds.
    val setup = "takes_string(s: string) = s\ntakes_number(n: number) = n\n"

    assert_eq(out(setup + "var m: string | number = 1\nif m is number\n    print(takes_number(m))\nelse\n    print(takes_string(m))"), "1")

    // The narrowing is a claim that can be wrong, which is what says it is being made at all.
    assert(fails(setup + "var m: string | number = 1\nif m is number\n    takes_string(m)").contains("takes string here, and this is number"))

@test
WHAT_A_VAR_HOLDS_BELOW_AN_IF_IS_THE_UNION_OF_WHAT_THE_BRANCHES_LEFT_IT_AT()
    // **Both branches leaving it a string means it is a string below**, and neither branch's answer
    // on its own would say so.
    val setup = "takes_string(s: string) = s\ntakes_number(n: number) = n\n"

    assert_eq(out(setup + "var m: string | number = 1\nif 1 < 2\n    m = \"a\"\nelse\n    m = \"b\"\n\nprint(takes_string(m))"), "a")

    // **A branch that leaves it a number puts the number back into the union**, and the report is
    // one the machine would make: the `else` path hands `2` to a parameter wanting a string.
    val said = fails(setup + "var m: string | number = 1\nif 1 > 2\n    m = \"a\"\nelse\n    m = 2\n\ntakes_string(m)")

    assert(said.contains("takes string here, and this is string | integer"))

    // And that is the run the report is about: with the check stood down, the machine faults on the
    // very value the union named.
    assert(fails("takes_string(s: string) = s\nanything(v) = v\ntakes_string(anything(2))").contains("`s` was declared string, and was given 2"))

    // **A BRANCH THAT ALWAYS LEAVES CONTRIBUTES NOTHING**, control below the `if` never having come
    // from it -- so what the other branch left the name at is what the line below holds.
    assert_eq(out(setup + "f(c: boolean)\n    var m: string | number = 1\n\n    if c\n        return \"early\"\n    else\n        m = \"late\"\n\n    takes_string(m)\nprint(f(false))"), "late")

    // A missing `else` is the path that skipped the branch, so what the name held ABOVE the `if` is
    // in the union too.
    assert_eq(out(setup + "var m: string | number = \"a\"\nif 1 > 2\n    m = \"b\"\n\nprint(takes_string(m))"), "a")

@test
A_MATCH_JOINS_ITS_ARMS_AND_A_LOOP_AND_A_TRY_WIDEN()
    // **A subject matching no arm is a run-time fault**, so reaching the line below a `match` means
    // an arm ran -- and the join is over the arms and nothing else.
    val setup = "takes_string(s: string) = s\ntakes_number(n: number) = n\n"

    assert_eq(out(setup + "var m: string | number = 1\nval n = m match\n    string -> 0\n    _ -> 1\n\nm = \"a\"\nprint(takes_string(m), n)"), "a 1")

    assert_eq(out(setup + "f(k: integer)\n    var m: string | number = 1\n\n    k match\n        0 -> m = \"zero\"\n        _ -> m = \"other\"\n\n    takes_string(m)\nprint(f(0), f(7))"), "zero other")

    // **A LOOP LEAVES WHAT IT WROTE TO AT THE DECLARED TYPE**, which is the only thing true of a
    // body that ran once, ran a hundred times, or never ran at all -- so the annotation is what a
    // read below it answers, exactly as it was before any of this.
    assert(fails(setup + "var m: string | number = \"a\"\nfor i in 0..<2\n    m = \"b\"\n\ntakes_string(m)").contains("and this is string | number"))

    // A `try` is the same answer for the same reason: its body may stop anywhere in it.
    assert(fails(setup + "var m: string | number = \"a\"\ntry\n    m = \"b\"\ncatch e\n    print(e.message)\n\ntakes_string(m)").contains("and this is string | number"))

    // **AND THE RUN-TIME CHECK IS STILL THERE FOR THE TURN THE PASS CANNOT SEE**: a name a loop
    // leaves holding one thing on its first turn and another on its second is caught where it lands.
    assert(fails("takes_string(s: string) = s\nvar m: string | number = \"a\"\nfor i in 0..<2\n    takes_string(m)\n    m = 1").contains("`s` was declared string, and was given 1"))

@test
A_VAR_A_CLOSURE_WRITES_TO_IS_NOT_FOLLOWED_AT_ALL()
    // **A nested function runs at a time the block cannot place** -- possibly between the test and
    // the use, possibly never -- so nothing said about the name in the block is true of every run.
    // It keeps the type it was declared, which is what this pass said about every `var` before flow
    // reached them.
    val setup = "takes_string(s: string) = s\n"

    val said = fails(setup + "var m: string | number = \"a\"\nval f = () ->\n    m = 1\n\nf()\ntakes_string(m)")

    assert(said.contains("and this is string | number"))

    // And that report is one the machine would make, the closure having put a number there.
    assert(fails("takes_string(s: string) = s\nanything(v) = v\ntakes_string(anything(1))").contains("`s` was declared string, and was given 1"))

    // A definition is a closure as much as a lambda is, and it is HOISTED -- so an assignment in one
    // written above the declaration counts too.
    assert_eq(out(setup + "writes()\n    m = 2\n\nvar m: string | number = \"a\"\nwrites()\nprint(m)"), "2")

@test
THREE_PROGRAMS_THAT_RUN_AND_ARE_REPORTED_ON_BY_NOTHING()
    // **The negatives, which is what a pass following assignments is judged by.** Every one of these
    // reaches its call with the value the annotation promised, and a report about any of them would
    // be a report no run could make.
    val setup = "takes_string(s: string) = s\ntakes_number(n: number) = n\n"

    // A counter through a compound assignment and a bump, which say nothing about the type.
    assert_eq(out("var n: integer = 0\nn += 2\nn++\nprint(n)"), "3")

    // A name reassigned to the other alternative and used as that one.
    assert_eq(out(setup + "var m: string | number = 1\nprint(takes_number(m))\nm = \"a\"\nprint(takes_string(m))"), "1\na")

    // A guard that leaves, over a `var`: below it the test was false.
    assert_eq(out(setup + "f()\n    var m: string | number = 1\n\n    if m is string\n        return \"s\"\n\n    takes_number(m)\nprint(f())"), "1")
