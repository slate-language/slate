module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.str_builder

// The instructions that COMPOSE a value out of what is standing on the stack -- an array, an object,
// a range, a joined string, a repetition, a copy with fields changed -- the two that WRITE through a
// value already made, and the two that OPEN a walk.
//
// **Cut out of `run_frames.sysl`, which keeps the loop.** That file is one function whose body is one
// `match` over `Op`, so there was nothing outside the match to move: what came here instead is the
// arms that touch none of the loop's own state. Every one of these reads and writes the operand
// stack and nothing else -- no `pc`, no `base`, no `code`, no `chunk_ix`, no `given` -- which is what
// makes them expressible as functions at all. An arm that enters a frame writes all five and could
// not have come. **The pattern arms at the foot of this file read `vm.scope` as well**, which is a
// field of the machine they are handed rather than a local of the loop, and is the one thing the
// paragraph above does not cover.
//
// **They are also the arms that are COLD, and that is the other half of why these and not others.**
// Each one already allocates, already walks a list, or already runs a lookup, so the call that
// reaches it is a fraction of what it does; the cheap instructions the benchmarks are made of --
// `PushInt`, `LoadSlot`, `Jump`, `Pop`, `Dup`, the arithmetic -- stay written out in the loop where a
// call would be the whole cost. `bench/results/2026-09-20-run-frames-split.md` carries the
// measurement that says this cut is timed neutral.
//
// **Allocate BEFORE the stack shrinks**, which is the one rule every function here obeys and the
// reason several of them read odd. Between a truncate and an `alloc` the operands would live only in
// a sysl `Buf`, which the mark phase cannot see -- and `alloc` collects when the heap is full.
// `obj.sysl` states it as `A `Value` IN A SYSL LOCAL IS NOT A ROOT`.
//
// Nothing here is `private`: every name is reached from `run_frames.sysl`, which is the only caller
// of any of them.

// `[a, b, c]`.
compose_array(vm: *Machine, n: usize, at: Span) -> Result[unit, Signal]
    var items: Buf[Value] = buf()

    for i in 0..<n
        keepable(peek(n - 1 - i), at, "put in an array")?
        items.push(peek(n - 1 - i))

    // **Allocated before the stack shrinks.** Between the truncate and the alloc the elements would
    // live only in `items`, which the mark phase cannot see -- and `alloc` collects when the heap is
    // full.
    val made = Array(new_array(items))

    vm.stack.truncate(vm.stack.len() - n)
    vm.stack.push(made)
    Ok(())
end compose_array

// `{ a: 1, b: 2 }`.
compose_object(vm: *Machine, n: usize, at: Span) -> Result[unit, Signal]
    val o = new_object()
    val mark = root_mark()

    hold(Object(o))

    for i in 0..<n
        val key = peek((n - 1 - i) * 2 + 1)
        val value = peek((n - 1 - i) * 2)

        keepable(value, at, "put in an object")?

        obj_put(o, key, value, at)?

    release(mark)
    vm.stack.truncate(vm.stack.len() - n * 2)
    vm.stack.push(Object(o))
    Ok(())
end compose_object

// `a..<b`, and every other way a range can be written.
compose_range(vm: *Machine, inclusive: bool, has_lo: bool, has_hi: bool, has_step: bool,
              at: Span) -> Result[unit, Signal]
    // **A COMPUTED ZERO IS CAUGHT HERE**, a written one having been refused where it stood. The
    // sentence is the same either way, with the number that arrived in it.
    val step = if has_step then range_end(pop(), at, "the step")? else 1

    if step == 0
        return Err(failure(at, "a range steps by 0, so it would never reach its end -- `by` takes a step that moves"))

    val hi = if has_hi then range_end(pop(), at, "the end")? else 0
    val lo = if has_lo then range_end(pop(), at, "the start")? else 0

    vm.stack.push(RangeVal(lo, hi, inclusive, has_lo, has_hi, step))
    Ok(())
end compose_range

// The pieces of an interpolation, made into one string.
compose_join(vm: *Machine, n: usize, at: Span) -> Result[unit, Signal]
    var out = str_builder()

    // **An interpolation's count is the sum of its pieces'**, so a string built out of one that is
    // already long does not walk it again: the piece carries its own count and only a rendered value
    // has to be counted, where it is made.
    var chars: usize = 0

    for i in 0..<n
        val piece = peek(n - 1 - i)

        keepable(piece, at, "put in a string")?

        val text = printed(piece, at)?

        chars += piece match
            Str(p) -> p.chars
            _ -> char_count(text)

        out.push(text)

    val joined = str_counted(out.finish(), chars)

    vm.stack.truncate(vm.stack.len() - n)
    vm.stack.push(joined)
    Ok(())
end compose_join

// `[x] * n` -- one value, that many times.
compose_repeat(vm: *Machine, at: Span) -> Result[unit, Signal]
    val n = pop() match
        Int(k) ->
            if k < 0 then return Err(failure(at, s"an array of ${k} copies is not something to make")) else usize(k)
        other -> return Err(failure(at, s"a repeat count is a whole number, and this is ${other.type_name()}"))

    keepable(peek(0), at, "put in an array")?

    var items: Buf[Value] = buf()

    for i in 0..<n
        items.push(peek(0))

    // Allocated before the stack shrinks, for the reason `compose_array` gives.
    val made = Array(new_array(items))

    vm.stack.truncate(vm.stack.len() - 1)
    vm.stack.push(made)
    Ok(())
end compose_repeat

// `o with { a: 1 }` -- a copy of an object with the written fields changed.
compose_with_object(vm: *Machine, n: usize, at: Span) -> Result[unit, Signal]
    val subject = peek(n * 2)

    val fields = subject match
        Object(o) -> o
        other -> return Err(failure(at, s"`with` copies an object, and this is ${other.type_name()}"))

    val o = new_object()
    val mark = root_mark()

    hold(Object(o))

    // The base's own fields first, in the order it holds them, so that the copy keeps the order and
    // a changed field keeps the place it already had.
    for i in 0..<fields.entries.len()
        val entry = fields.entries.at(i)

        if !entry.dead then obj_put(o, entry.key, entry.value, at)?

    for i in 0..<n
        val key = peek((n - 1 - i) * 2 + 1)
        val value = peek((n - 1 - i) * 2)

        // **Asked of the BASE and not of the copy**, or the second written key would find the first
        // one already there and be taken for a field the type has.
        unknown_field_complaint(fields, key) match
            Some(said) ->
                release(mark)
                return Err(failure(at, said))
            None -> ()

        keepable(value, at, "put in an object")?
        obj_put(o, key, value, at)?

    // A copy of a data value is a data value, which is what makes `with` the answer the refusal
    // points at. Set last, the writes above being how the copy was filled.
    o.frozen = fields.frozen

    release(mark)
    vm.stack.truncate(vm.stack.len() - n * 2 - 1)
    vm.stack.push(Object(o))
    Ok(())
end compose_with_object

// `a with b`, and `{ ...o }`, which are one instruction.
//
// **`spread` picks the words and changes nothing else.** A message naming the spelling the reader did
// not write sends them looking for it.
compose_with_merge(vm: *Machine, spread: bool, at: Span) -> Result[unit, Signal]
    val other = peek(0) match
        Object(o) -> o
        got ->
            return Err(failure(at, if spread
                then s"`...` spreads the fields of an object, and this is ${got.type_name()}"
                else s"`with` copies the fields of an object, and this is ${got.type_name()}"))

    val fields = peek(1) match
        Object(o) -> o
        got -> return Err(failure(at, s"`with` copies an object, and this is ${got.type_name()}"))

    val o = new_object()
    val mark = root_mark()

    hold(Object(o))

    // The base's own fields first, in the order it holds them, so the copy keeps the order and a
    // field the other object also has keeps the place it already had.
    for i in 0..<fields.entries.len()
        val entry = fields.entries.at(i)

        if !entry.dead then obj_put(o, entry.key, entry.value, at)?

    for i in 0..<other.entries.len()
        val entry = other.entries.at(i)

        if !entry.dead
            // `c with someObject` reaches a data value exactly as `c with { ... }` does, and so does
            // `{ ...c, x: 1 }` once `object_so_far` has desugared it.
            unknown_field_complaint(fields, entry.key) match
                Some(said) ->
                    release(mark)
                    return Err(failure(at, said))
                None -> ()

            obj_put(o, entry.key, entry.value, at)?

    // **A copy of a data value is a data value**, which is what makes `with` the answer the refusal
    // points at: `c with { r: 5 }` is another `Circle`, still sealed, still usable as a key. The flag
    // is set last, the writes above being how it was filled.
    o.frozen = fields.frozen

    release(mark)
    vm.stack.truncate(vm.stack.len() - 2)
    vm.stack.push(Object(o))
    Ok(())
end compose_with_merge

// The top `n` arrays, made into one. What builds a spread argument list.
//
// **EVERYTHING `walked_into` WALKS SPREADS, which is the rule JavaScript's `...` follows too**: an
// array, a set, a map, a range, a generator and a buffer all yield exactly what a `for` over them
// yields, so the two constructs cannot come to disagree about what one value gives.
//
// **The answer is built in a HELD ARRAY rather than in a `Buf`, and a generator is why.** Stepping
// one runs the program that wrote it, which allocates -- and a `Buf[Value]` is not a root, so
// everything gathered before that step would be invisible to a collection landing inside it.
//
// **The complaint names the spread and not the call**, because that is where the reader has to
// look: `f(...42)` is a mistake about what may be spread.
compose_joined_arrays(vm: *Machine, n: usize, at: Span) -> Result[unit, Signal]
    val mark = root_mark()
    val out = new_array(buf())

    hold(Array(out))

    for i in 0..<n
        walked_into(out, peek(n - 1 - i), at, "`...`", "spreads") match
            Err(e) ->
                release(mark)
                return Err(e)
            Ok(_) -> ()

    release(mark)
    vm.stack.truncate(vm.stack.len() - n)
    vm.stack.push(Array(out))
    Ok(())
end compose_joined_arrays

// `o[k] = v`.
write_indexed(vm: *Machine, at: Span) -> Result[unit, Signal]
    val v = pop()
    val k = pop()
    val target = pop()

    keepable(v, at, "stored")?
    keepable(k, at, "used as a key")?

    store_at(target, k, v, at)?
    Ok(())
end write_indexed

// `o.name = v` is `site_cache.sysl`'s, the write being the half of a field access that remembers
// where the field was.

// -- opening a walk -------------------------------------------------------------------------------

// `IterInit`: put the counter a `for` steps with beside the subject it is walking.
//
// **Here rather than in the loop because it runs ONCE per `for`**, where `IterNext` beside it runs
// once per turn -- so this is the coldest instruction a loop has and the call reaching it is a
// fraction of the walk it opens.
compose_iter_init(vm: *Machine, at: Span) -> Result[unit, Signal]
    peek(0) match
        Array(_) -> vm.stack.push(Int(0))

        // **A buffer walks its bytes**, which is an array's counter and an array's walk: every byte
        // is at a position and the walk yields the number at it.
        Bytes(_) -> vm.stack.push(Int(0))

        // **A range with an end left out is refused rather than walked**, because the walk would not
        // stop: an end taken from what the range is used on has nothing to take it from here.
        RangeVal(_, _, _, has_lo, has_hi, _) ->
            if !has_lo || !has_hi
                return Err(failure(at, "`for` needs a range with both ends, since one left out would never finish"))

            vm.stack.push(Int(0))
        // A generator has no counter to initialise, but the loop pushes one anyway so that
        // `IterNext` is one shape: the integer is kept beside the generator and ignored, which costs
        // nothing and keeps the instruction from needing to know which kind of subject it has before
        // it asks.
        Gen(_, _) -> vm.stack.push(Int(0))

        // A set and a map count like an array does, the counter being a position in the table's
        // entries -- and the walk steps over a removed one.
        SetVal(_) -> vm.stack.push(Int(0))
        MapVal(_) -> vm.stack.push(Int(0))

        // **A string walks its CHARACTERS**, which is what every other name in the language already
        // counts in and is what JavaScript's `for...of` yields. The counter is a character position,
        // so the walk costs what `s[i]` costs -- which is O(1) through `StrObj`'s forward cursor, the
        // cursor moving one character per turn and never being asked to go back.
        Str(_) -> vm.stack.push(Int(0))
        other -> return Err(failure(at, s"`for` walks an array, bytes, a string, a range, a generator, a set or a map, and this is ${other.type_name()}"))

    Ok(())
end compose_iter_init

// `IterAwaitCheck`: whether the subject of a `for await` is a thing `next()` can be asked of.
//
// **The subject is left where it stands** -- what this decides is only whether the `next()` about to
// be called is a question worth asking of it -- so the stack is read and never written, which is why
// it takes no machine.
compose_iter_await_check(at: Span) -> Result[unit, Signal]
    peek(0) match
        Object(_) -> ()
        Gen(_, _) -> ()
        other ->
            // **The sentence names the `await` and not `next`**, which is the whole reason this
            // instruction exists: a reader who wrote `for await x in xs` over an array has no `next`
            // anywhere in their program to go and look at.
            val kind = other.type_name()

            return Err(failure(at, s"a `for await` asks its subject for `next()`, and ${kind} has none -- write `for` without `await` to walk ${kind}"))

    Ok(())
end compose_iter_await_check

// -- a value against a pattern ---------------------------------------------------------------------
//
// **Four arms that test a pattern and nothing else**, cut out of the loop for the reason at the top
// of this file: each reads `vm.scope` and the operand stack and touches none of `pc`, `base`, `code`,
// `chunk_ix` or `given`. Their slotted twins -- `CheckSlot`, `UnpackSlots`, `TestSlots` -- stay in
// the loop, each of them writing cells at `base`.
//
// **They are also the COLD half of the pair in each case.** A slotted chunk is what an ordinary
// function compiles to, so these run for an annotation on a module-level binding, an `is` written as
// an expression, a destructuring `val` in a chunk that keeps its scope, and a `match` arm whose names
// are not cells; `bench/results/2026-09-20-run-frames-split.md` carries the measurement that says the
// cut is timed neutral.

// `CheckType`: a named binding against the pattern its annotation stands for.
compose_check_named(u: *Unit, vm: *Machine, k: usize, t: usize, pk: usize, at: Span) -> Result[unit, Signal]
    val name = u.strings.at(k)

    val v = lookup(vm.scope, name) match
        Some(found) -> found
        None -> return Err(failure(at, unbound_here(name)))

    if !match_pattern(u.patterns.at(pk), v, vm.scope, false)
        return Err(failure(at, s"`${name}` was declared ${u.strings.at(t)}, and was given ${show_value(v)}"))

    Ok(())
end compose_check_named

// `CheckResult`: what the body left on the stack against a `-> type`. **A peek rather than a pop**,
// the value being the function's answer and not this instruction's.
compose_check_result(u: *Unit, vm: *Machine, t: usize, pk: usize, at: Span) -> Result[unit, Signal]
    if !match_pattern(u.patterns.at(pk), peek(0), vm.scope, false)
        return Err(failure(at, s"this answers ${u.strings.at(t)}, and gave back ${show_value(peek(0))}"))

    Ok(())

// `Unpack`: `val [a, b] = xs` in a chunk that binds by name.
//
// **A binding has no next arm, so a shape that does not fit is a fault**, where a `match` would
// simply let the next pattern try. The message says the pattern back and says what arrived, both
// being things the reader needs and neither being on the line by itself.
compose_unpack(u: *Unit, vm: *Machine, k: usize, immutable: bool, at: Span) -> Result[unit, Signal]
    val subject = pop()

    if !match_pattern(u.patterns.at(k), subject, vm.scope, !immutable)
        return Err(failure(at, unpack_complaint(u.patterns.at(k), subject)))

    Ok(())

// `IsPat`: `x is Pat`, which CONSUMES its subject -- an `is` being an expression rather than an
// arm's guard.
compose_is_pat(u: *Unit, vm: *Machine, k: usize, negated: bool)
    val took = match_pattern(u.patterns.at(k), pop(), vm.scope, false)

    vm.stack.push(Bool(if negated then !took else took))

// `TestPat`: the same question asked of an arm, which leaves the subject for the arm after it.
compose_test_pat(u: *Unit, vm: *Machine, k: usize)
    val took = match_pattern(u.patterns.at(k), peek(0), vm.scope, false)

    vm.stack.push(Bool(took))

// `RotUp`: `[a, b, c]` with an `n` of two becomes `[c, a, b]` -- the top slides down and everything
// it passed shifts up one. What needs it is `x++`, which has to leave the OLD value where the new
// one was computed.
compose_rot_up(vm: *Machine, n: usize)
    val top = vm.stack.len() - 1
    val v = vm.stack.at(top)
    var i = top

    while i > top - n
        vm.stack.set(i, vm.stack.at(i - 1))
        i -= 1

    vm.stack.set(top - n, v)
end compose_rot_up

// A `class` or a `data` variant's object, sealed by the instruction that finished building it.
//
// **Nothing else has seen it yet**, so there is no window in which a data value is writable and
// reachable.
compose_seal_data(vm: *Machine) = peek_on(vm, 0) match
    Object(o) -> o.frozen = true
    _ -> ()

// A binding's declared type, checked against the cell it was bound into.
compose_check_slot(u: *Unit, vm: *Machine, base: usize, i: usize, k: usize, t: usize, pk: usize,
                   at: Span) -> Result[unit, Signal]
    val v = vm.stack.at(base + i)

    if !match_pattern(u.patterns.at(pk), v, vm.scope, false)
        return Err(failure(at, s"`${u.strings.at(k)}` was declared ${u.strings.at(t)}, and was given ${show_value(v)}"))

    Ok(())

// `val name = v` and `var name = v` in a chunk that binds by name, which is a module's own top level
// and any chunk a closure reaches a name of. **The two differ in one flag**, which is why they are
// one function rather than two arms written out twice.
compose_declare_name(u: *Unit, vm: *Machine, here: *Vm, k: usize, mutable: bool,
                     at: Span) -> Result[unit, Signal]
    val v = pop_on(vm)

    keepable_on(here, v, at, s"bound to `${u.strings.at(k)}`")?
    declare(vm.scope, u.strings.at(k), v, mutable)
    Ok(())

// The same, for a required parameter no call supplied.
//
// **No `keepable` here on purpose** -- see `code.sysl`: a call leaving a parameter out is the one
// absence the rule allows to be bound.
compose_declare_absent(u: *Unit, vm: *Machine, k: usize)
    val v = pop_on(vm)

    declare(vm.scope, u.strings.at(k), v, true)

// `name = v`, walking out for the binding that spelling names.
compose_store_name(u: *Unit, vm: *Machine, here: *Vm, k: usize, at: Span) -> Result[unit, Signal]
    val name = u.strings.at(k)
    val stored = pop_on(vm)

    keepable_on(here, stored, at, s"written to `${name}`")?

    assign_name(vm.scope, name, stored) match
        Written -> ()
        Immutable -> return Err(failure(at, s"`${name}` is a `val`, so it is written once"))
        Unknown -> return Err(failure(at, s"`${name}` is not defined"))

    Ok(())

// A destructuring binding in a chunk whose names are numbered cells.
//
// **The subject is left standing while the walk runs**, so what a `rest` pattern builds is reachable
// from the stack -- which is a root -- rather than from a sysl local, which is not.
compose_unpack_slots(u: *Unit, vm: *Machine, base: usize, k: usize, first: usize, masked: bool,
                     at: Span) -> Result[unit, Signal]
    val mark = vm.stack.len()

    if !match_walk(u.patterns.at(k), peek_on(vm, 0), vm.scope, false, true)
        val subject = peek_on(vm, 0)

        vm.stack.truncate(mark)
        return Err(failure(at, unpack_complaint(u.patterns.at(k), subject)))

    val mask = lay_bindings(mark, base + first)

    vm.stack.truncate(mark - 1)

    if masked then vm.stack.push(Int(long(mask)))

    Ok(())
end compose_unpack_slots

// A named function.
//
// **The name is declared twice on purpose**: bound as null before the closure is built, so the
// scope that closure captures already holds the spelling and the body can see its own name -- which
// is the whole of what makes a named function recursive.
compose_define_fn(u: *Unit, vm: *Machine, k: usize, c: usize)
    val name = u.strings.at(k)

    declare(vm.scope, name, Null, false)
    declare(vm.scope, name, Fn(new_closure(u.chunks.at(c).params, c, vm.scope)), false)

// The same, for a definition at a file's own top level: it goes into the scope AND into the
// machine's table, so that `LoadDef` can read it.
//
// **The table grows to reach the cell rather than being sized in advance**: a unit's definitions are
// numbered across every file it holds, and a machine may run only some of them.
compose_define_def(u: *Unit, vm: *Machine, k: usize, c: usize, d: usize)
    val name = u.strings.at(k)

    declare(vm.scope, name, Null, false)

    val made = Fn(new_closure(u.chunks.at(c).params, c, vm.scope))

    declare(vm.scope, name, made, false)

    val v = current()

    while v.defs.len() <= d
        v.defs.push(Null)

    v.defs.set(d, made)
end compose_define_def
