module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{str_builder, StrBuilder}

// The tree, as parenthesised prefix notation.
//
// **This exists for the tests, and that is the whole of its brief.** A parser is checked by pinning
// the shape it produced, and a shape is only worth pinning if a person can read it: `(+ 1 (* 2 3))`
// says what a field-by-field dump of a nested struct does not. Precedence, associativity and the
// definition-versus-call decision are all visible at a glance in this form, which is what makes it
// worth the file.
//
// It is not a pretty-printer and will not round-trip: it drops spans, and it renders the sugar it
// was given rather than the text it came from.

// A whole program.
show_program(prog: Program) -> string
    var out = str_builder()

    for i in 0..<prog.stmts.len()
        if i > 0 then out.push_char(' ')

        write_stmt(&out, prog.stmts.at(i))

    out.finish()
end show_program

// One expression.
show_expr(e: Expr) -> string
    var out = str_builder()

    write_expr(&out, e)
    out.finish()

// One statement.
show_stmt(s: Stmt) -> string
    var out = str_builder()

    write_stmt(&out, s)
    out.finish()

private write_stmt(out: *StrBuilder, s: Stmt)
    *s.kind match
        Val(name, init) -> form2(out, "val", name, init)
        Var(name, init) -> form2(out, "var", name, init)
        Unpack(pat, init, immutable) ->
            out.push_char('(')
            out.push(if immutable then "val" else "var")
            out.push_char(' ')
            write_pattern(out, pat)
            out.push_char(' ')
            write_expr(out, init)
            out.push_char(')')
        Assign(op, target, value) ->
            out.push_char('(')
            out.push(if op == Assign then "=" else s"${op_text(op)}=")
            out.push_char(' ')
            write_expr(out, target)
            out.push_char(' ')
            write_expr(out, value)
            out.push_char(')')
        MultiAssign(op, targets, values) ->
            out.push_char('(')
            out.push(if op == Assign then "=*" else s"${op_text(op)}=*")
            out.push(" (")

            for i in 0..<targets.len()
                if i > 0 then out.push_char(' ')

                write_expr(out, targets.at(i))

            out.push(") (")

            for i in 0..<values.len()
                if i > 0 then out.push_char(' ')

                write_expr(out, values.at(i))

            out.push("))")
        Def(name, params, body, is_async) ->
            out.push(if is_async then "(async-def " else "(def ")
            out.push(name)
            out.push_char('(')

            for i in 0..<params.len()
                if i > 0 then out.push_char(' ')

                out.push(params.at(i))

            out.push(") ")
            write_expr(out, body_at(body))
            out.push_char(')')
        Eval(e) -> write_expr(out, e)
        Return(value) ->
            value match
                Some(v) ->
                    out.push("(return ")
                    write_expr(out, v)
                    out.push_char(')')
                None -> out.push("(return)")
        Break(label, value) ->
            out.push("(break")
            write_label(out, label)

            value match
                Some(v) ->
                    out.push_char(' ')
                    write_expr(out, v)
                None -> ()

            out.push_char(')')
        Continue(label) ->
            out.push("(continue")
            write_label(out, label)
            out.push_char(')')
        ImportNames(path, _, _, names, locals) ->
            out.push("(import ")
            out.push(path)

            for i in 0..<names.len()
                out.push_char(' ')
                out.push(names.at(i))

                if locals.at(i) != names.at(i)
                    out.push("->")
                    out.push(locals.at(i))

            out.push_char(')')
        TypeDecl(name, pat) ->
            out.push("(type ")
            out.push(name)
            out.push_char(' ')
            write_pattern(out, pat)
            out.push_char(')')
        CheckType(name, declared, _) -> out.push(s"(check ${name} ${declared})")
        ImportAll(path, _, _, alias) ->
            out.push("(import-all ")
            out.push(path)
            out.push_char(' ')
            out.push(alias)
            out.push_char(')')
end write_stmt

private write_label(out: *StrBuilder, label: string)
    if label != ""
        out.push(" '")
        out.push(label)

private write_otherwise(out: *StrBuilder, otherwise: Option[Expr])
    otherwise match
        Some(x) ->
            out.push(" else ")
            write_expr(out, x)
        None -> ()

// `(head name value)`, the shape both bindings take.
private form2(out: *StrBuilder, head: string, name: string, value: Expr)
    out.push_char('(')
    out.push(head)
    out.push_char(' ')
    out.push(name)
    out.push_char(' ')
    write_expr(out, value)
    out.push_char(')')
end form2

private write_expr(out: *StrBuilder, e: Expr)
    *e.kind match
        IntLit(v) -> out.push_int(v)
        RealLit(v) -> out.push_real(v)
        StrLit(v) ->
            out.push_char('"')
            out.push(v)
            out.push_char('"')
        BoolLit(v) -> out.push_bool(v)
        Yield(inner) ->
            out.push("(yield ")
            write_expr(out, inner)
            out.push_char(')')
        Spread(inner) ->
            out.push("(spread ")
            write_expr(out, inner)
            out.push_char(')')
        NullLit -> out.push("null")
        UndefinedLit -> out.push("undefined")
        Name(n) -> out.push(n)
        Unary(op, rhs) ->
            out.push_char('(')
            out.push(op_text(op))
            out.push_char(' ')
            write_expr(out, rhs)
            out.push_char(')')
        Binary(op, lhs, rhs) ->
            out.push_char('(')
            out.push(op_text(op))
            out.push_char(' ')
            write_expr(out, lhs)
            out.push_char(' ')
            write_expr(out, rhs)
            out.push_char(')')
        Call(callee, args) ->
            out.push("(call ")
            write_expr(out, callee)
            write_all(out, args)
            out.push_char(')')
        Index(target, key) ->
            out.push("(index ")
            write_expr(out, target)
            out.push_char(' ')
            write_expr(out, key)
            out.push_char(')')
        Field(target, name, optional) ->
            out.push("(. ")
            write_expr(out, target)
            out.push_char(' ')
            out.push(name)
            out.push_char(')')
        Interp(pieces) ->
            out.push("(join")
            write_all(out, pieces)
            out.push_char(')')
        ArrayRepeat(value, count) ->
            out.push("(repeat ")
            write_expr(out, value)
            out.push_char(' ')
            write_expr(out, count)
            out.push_char(')')
        WithFields(base, keys, values) ->
            out.push("(with ")
            write_expr(out, base)

            for i in 0..<keys.len()
                out.push_char(' ')
                out.push(keys.at(i))
                out.push_char(':')
                write_expr(out, values.at(i))

            out.push_char(')')
        ArrayLit(items) ->
            out.push("(array")
            write_all(out, items)
            out.push_char(')')
        ObjectLit(keys, _, values) ->
            out.push("(object")

            for i in 0..<keys.len()
                out.push_char(' ')
                out.push(keys.at(i))
                out.push_char(':')
                write_expr(out, values.at(i))

            out.push_char(')')
        Compare(operands, ops) ->
            out.push("(cmp")

            for i in 0..<ops.len()
                out.push_char(' ')
                write_expr(out, operands.at(i))
                out.push_char(' ')
                out.push(op_text(ops.at(i)))

            out.push_char(' ')
            write_expr(out, operands.at(operands.len() - 1))
            out.push_char(')')
        Range(lo, hi, inclusive) ->
            out.push_char('(')
            out.push(if inclusive then ".." else "..<")

            lo match
                Some(x) ->
                    out.push_char(' ')
                    write_expr(out, x)
                None -> out.push(" _")

            hi match
                Some(x) ->
                    out.push_char(' ')
                    write_expr(out, x)
                None -> out.push(" _")

            out.push_char(')')
        IsPattern(subject, pat, negated) ->
            out.push(if negated then "(is-not " else "(is ")
            write_expr(out, subject)
            out.push_char(' ')
            write_pattern(out, pat)
            out.push_char(')')
        IncDec(target, up, before) ->
            out.push_char('(')
            out.push(if before then "pre" else "post")
            out.push(if up then "++ " else "-- ")
            write_expr(out, target)
            out.push_char(')')
        Await(inner) ->
            out.push("(await ")
            write_expr(out, inner)
            out.push_char(')')
        Lambda(params, body, is_async) ->
            out.push(if is_async then "(async-fn(" else "(fn(")

            for i in 0..<params.len()
                if i > 0 then out.push_char(' ')

                out.push(params.at(i))

            out.push(") ")
            write_expr(out, body_at(body))
            out.push_char(')')
        IfExpr(cond, then_branch, else_branch) ->
            out.push("(if ")
            write_expr(out, cond)
            out.push_char(' ')
            write_expr(out, then_branch)

            else_branch match
                Some(b) ->
                    out.push_char(' ')
                    write_expr(out, b)
                None -> ()

            out.push_char(')')
        MatchExpr(subject, arms) ->
            out.push("(match ")
            write_expr(out, subject)

            for i in 0..<arms.len()
                val arm = arms.at(i)

                out.push(" (")
                write_pattern(out, arm.pattern)

                arm.guard match
                    Some(g) ->
                        out.push(" if ")
                        write_expr(out, g)
                    None -> ()

                out.push_char(' ')
                write_expr(out, arm.body)
                out.push_char(')')

            out.push_char(')')
        DoWhile(label, body, cond, otherwise) ->
            out.push("(do-while")
            write_label(out, label)
            out.push_char(' ')
            write_expr(out, body)
            out.push_char(' ')
            write_expr(out, cond)
            write_otherwise(out, otherwise)
            out.push_char(')')
        While(label, cond, body, otherwise) ->
            out.push("(while")
            write_label(out, label)
            out.push_char(' ')
            write_expr(out, cond)
            out.push_char(' ')
            write_expr(out, body)
            write_otherwise(out, otherwise)
            out.push_char(')')
        For(label, binding, iter, body, otherwise) ->
            out.push("(for")
            write_label(out, label)
            out.push_char(' ')
            write_pattern(out, binding)
            out.push_char(' ')
            write_expr(out, iter)
            out.push_char(' ')
            write_expr(out, body)
            write_otherwise(out, otherwise)
            out.push_char(')')
        Loop(label, body) ->
            out.push("(loop")
            write_label(out, label)
            out.push_char(' ')
            write_expr(out, body)
            out.push_char(')')
        Ensures(value, type_name, _) ->
            out.push("(ensures ")
            out.push(type_name)
            out.push_char(' ')
            write_expr(out, value)
            out.push_char(')')
        TryCatch(body, name, handler) ->
            out.push("(try ")
            write_expr(out, body)
            out.push(s" catch ${name} ")
            write_expr(out, handler)
            out.push_char(')')
        Block(stmts) ->
            out.push("(block")

            for i in 0..<stmts.len()
                out.push_char(' ')
                write_stmt(out, stmts.at(i))

            out.push_char(')')
        Bad -> out.push("<bad>")
end write_expr

// A space-separated run of expressions, each preceded by its space.
private write_all(out: *StrBuilder, xs: Buf[Expr])
    for i in 0..<xs.len()
        out.push_char(' ')
        write_expr(out, xs.at(i))

// How an operator is written. Not `private`: a runtime complaint names the operator too.
op_text(k: Tok) -> string
    k match
        Plus -> "+"
        Minus -> "-"
        Star -> "*"
        Slash -> "/"
        Percent -> "%"
        EqEq -> "=="
        BangEq -> "!="
        Lt -> "<"
        LtEq -> "<="
        Gt -> ">"
        GtEq -> ">="
        AndAnd -> "&&"
        OrOr -> "||"
        QQ -> "??"
        Bang -> "!"
        _ -> "?"
end op_text

// A pattern, in the same parenthesised form as the rest.
private write_pattern(out: *StrBuilder, pat: Pattern)
    *pat.kind match
        Wild -> out.push_char('_')
        Bind(name) -> out.push(name)
        TypePat(test) -> out.push(type_test_text(test))
        At(name, inner) ->
            out.push(name)
            out.push_char('@')
            write_pattern(out, inner)
        IntPat(v) -> out.push_int(v)
        RealPat(v) -> out.push_real(v)
        StrPat(v) ->
            out.push_char('"')
            out.push(v)
            out.push_char('"')
        BoolPat(v) -> out.push_bool(v)
        NullPat -> out.push("null")
        ArrayPat(items, open, rest) ->
            out.push("[")

            for i in 0..<items.len()
                if i > 0 then out.push_char(' ')

                write_pattern(out, items.at(i))

            if open
                if !items.is_empty() then out.push_char(' ')

                out.push("...")

                rest match
                    Some(name) -> out.push(name)
                    None -> ()
            end if

            out.push("]")
        ObjectPat(keys, values) ->
            out.push("{")

            for i in 0..<keys.len()
                if i > 0 then out.push_char(' ')

                out.push(keys.at(i))
                out.push_char(':')
                write_pattern(out, values.at(i))

            out.push("}")
        OrPat(alts) ->
            out.push("(|")

            for i in 0..<alts.len()
                out.push_char(' ')
                write_pattern(out, alts.at(i))

            out.push_char(')')
end write_pattern
