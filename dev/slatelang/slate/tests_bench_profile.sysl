module dev.slatelang.slate
@tests

import sysl.fs.{read_text, remove_file, write_text}
import sysl.process.capture
import sysl.text.Search

// `bench/profile.sl` drives macOS `sample`, which is not on every machine this suite runs on --
// **Linux has none, and the suite runs there** (`~/dev/CLAUDE.md` § "the Linux gate" and this repo's
// own release workflow both run a slate suite on Linux runners). So this test passes with nothing
// asserted where `sample` cannot be found, rather than failing a machine for a tool this project
// never claims to carry -- and it runs the real thing everywhere `sample` is.
//
// **The target sampled is `/bin/sh` running a busy loop, not a second slate binary.** `sample`
// attaches to whatever pid `profile.sl` hands it, and `profile.sl`'s own `--binary`/program
// arguments are just an executable and its one argument -- there is no need for this suite, which
// runs the interpreter IN PROCESS through `cli_status`, to also have a standalone `slate` on disk to
// spawn a second copy of. `spawn`'s own real subprocess (`/bin/sh`, exactly as `tests/lang/spawn.sl`
// uses) is what gives `sample` a genuine pid to attach to.
@test
BENCH_PROFILE_SL_BUILDS_A_MARKDOWN_TABLE_FROM_A_REAL_SAMPLE()
    val probe = capture("sample", ["-h"], "", [], true, 5000)

    probe match
        Err(_) -> return
        Ok(_) -> ()

    val script = "tests/tmp-bench-profile-busy.sh"
    val report = "tests/tmp-bench-profile-report.md"

    write_text(script, "i=0\nwhile [ $i -lt 200000000 ]; do\n  i=$((i+1))\ndone\n").unwrap()

    val status = cli_status(["slate", "bench/profile.sl",
        "--out=" + report, "--binary=/bin/sh", "--duration=2", "--interval=5", script])

    val said = read_text(report).unwrap_or("")

    remove_file(script)
    remove_file(report)

    assert_eq(status, 0, s"profile.sl exited ${status}")
    assert(said.contains("| symbol | samples | % |"), said)
end BENCH_PROFILE_SL_BUILDS_A_MARKDOWN_TABLE_FROM_A_REAL_SAMPLE
