module dev.slatelang.slate
@tests

import sysl.fs.{read_text, remove_file, write_text}
import sysl.process.capture

// `bench/profile.sl` drives macOS `sample`, which Linux does not have -- and the suite runs on Linux
// too. So the test asserts nothing where `/usr/bin/sample` cannot be started, rather than failing a
// machine for a tool this project never claims to carry, and runs the real thing everywhere it can.
//
// **What is sampled is `/bin/sh` running a busy loop, not a second slate.** `profile.sl` hands
// `sample` the pid of whatever `--binary` it started, and this suite runs the interpreter in process;
// a shell is a child every machine that has `sample` also has, and it is busy for as long as it takes.
@test
BENCH_PROFILE_SL_WRITES_A_MARKDOWN_TABLE_FROM_A_REAL_SAMPLE()
    capture("/usr/bin/sample", ["-h"], "", [], true, 5000) match
        Err(_) -> return
        Ok(_) -> ()

    val script = "tests/tmp-bench-profile-busy.sh"
    val report = "tests/tmp-bench-profile-report.md"

    write_text(script, "i=0\nwhile [ $i -lt 200000000 ]; do\n  i=$((i+1))\ndone\n").unwrap()

    val status = cli_status(["slate", "bench/profile.sl",
        "--out=" + report, "--binary=/bin/sh", "--duration=1", "--interval=1", script])

    val said = read_text(report).unwrap_or("")

    remove_file(script)
    remove_file(report)

    assert_eq(status, 0, s"profile.sl exited ${status}")
    assert(said.starts_with("# slate bench profile\n"), said)
    assert(said.contains("## " + script + "\n"), said)
    assert(said.contains("| symbol | samples | % |\n|---|---:|---:|\n| `"), said)
end BENCH_PROFILE_SL_WRITES_A_MARKDOWN_TABLE_FROM_A_REAL_SAMPLE

// The usage line and status 2, which is `slate`'s own "could not work out what it was asked", where
// `--out` is missing -- asked on every machine, `sample` or not, since nothing is sampled.
@test
BENCH_PROFILE_SL_WITHOUT_AN_OUT_FLAG_SAYS_HOW_TO_CALL_IT()
    assert_eq(cli_status(["slate", "bench/profile.sl"]), 2)
    assert(cli_said(["slate", "bench/profile.sl"]).contains("usage: slate bench/profile.sl --out=PATH"))
end BENCH_PROFILE_SL_WITHOUT_AN_OUT_FLAG_SAYS_HOW_TO_CALL_IT
