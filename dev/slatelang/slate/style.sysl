module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// `slate:style` -- the stylesheets a program brings in with a bare `import "./app.css"`.
//
// **The set is known before the program runs a line**, because slate has no dynamic modules: the
// loader reads every file a program is made of, and a bare import is one of those reads. So nothing
// registers a sheet at run time and nothing could forget to -- `sheets()` reads back what the loader
// recorded (`take_sheet` in `module.sysl`), and the JavaScript back end writes the same list into the
// emitted program, where `$.files` is handed it.
//
// **Named for what a page does with it rather than for CSS**, beside `slate:time` and `slate:url`:
// the module answers what styles the program carries, and a name like `slate:css` would read as a
// parser for the language.

// `sheets()` -- the text of every stylesheet the program bare-imported, in the order the loader first
// met them, each once. A program that imports none answers `[]`.
do_sheets(args: Args, at: Span) -> Step
    wants(args, 0, at, "sheets", "no arguments")?

    val texts = sheet_texts()
    val mark = root_mark()
    var items: Buf[Value] = buf()

    for i in 0..<texts.len()
        val one = str_value(texts[i])

        hold(one)
        items.push(one)

    val a = Array(new_array(items))

    release(mark)
    Ok(a)
end do_sheets

// -- what this file registers ---------------------------------------------------------------------

// **`slate:style`'s one name, and the built-in scope's alone** -- a program reaches it by importing
// the module, so a program's own `sheets` is never shadowed by it.
var n_sheets: NativeFn = 0

install_style(env: *EnvObj, everything: bool)
    n_sheets = register("sheets", do_sheets)

    if everything then declare(env, "sheets", Native(n_sheets), false)
end install_style

// The JavaScript half: the list is written into the emitted program as `$.files`' second argument,
// so this only hands back a copy of it. Inside the `$b` block, after the host's own WebSocket.
js_runtime_style() -> string = raw"""
        // -- the program's stylesheets (`slate:style`) ---------------------------------------------

        // `sheets()` -- what the program bare-imported, as the emitter wrote it into `$.files`.
        B.sheets = (...args) => {
            wantArgs(args.length, 0, 0, "sheets", "no arguments")

            return $.sheets()
        }
    """
