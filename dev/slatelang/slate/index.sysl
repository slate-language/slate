module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.str_builder

// Reading out of a container and writing into one, and the ranges that slice it.
//
// **Split out of `runtime.sysl`.** A slate string is counted in characters and never in bytes, so
// every offset that leaves here has crossed through `text.sysl` first.
//
// **Matching a value against a pattern is `match.sysl`**, cut out of this file when it passed a
// thousand lines: what is here is handed a container and an index, and what is there is handed a
// pattern and a value. One name crosses, `MaxProtoDepth`.

// -- ranges ---------------------------------------------------------------------------------------

// How many numbers a range covers, counting by its step. A `for` walks exactly this many.
//
// **A STEP WHOSE SIGN DISAGREES WITH THE ENDS COVERS NOTHING**, which is the answer `10..0` already
// gave before there were steps at all: `0..10 by -1` runs away from its own ceiling, so the count is
// zero rather than a refusal. The two directions are one formula read from either end -- an upward
// step measures from `lo` to the last number at or below the top, a downward one from `lo` to the
// last number at or above the bottom -- and an exclusive end is the one it leaves out in each case.
//
// Not `private`: `builtin.sysl` answers a range's `.length` with it.
range_count(lo: long, hi: long, inclusive: bool, step: long) -> usize
    if step > 0
        val last = if inclusive then hi else hi - 1

        if last < lo then 0 else usize((last - lo) / step + 1)
    else
        val last = if inclusive then hi else hi + 1

        if last > lo then 0 else usize((lo - last) / (0 - step) + 1)

// The `i`th number a range covers, counting from zero. Only asked below its count.
//
// Not `private`: the machine walks a `for` with it.
range_at(lo: long, step: long, i: usize) -> long = lo + step * long(i)

// The last number a range covers, which is what equality and the hash compare.
//
// **Two ranges are equal when they cover the same numbers**, so what is compared is the number a
// walk would stop on rather than the ceiling somebody wrote: `0..<10 by 2` and `0..8 by 2` are the
// same five numbers written two ways, exactly as `1..3` and `1..<4` are the same three. An empty
// range has no last number, so the written ceiling stands in and two empty ranges written
// differently stay different -- which is what they already did.
range_last(lo: long, hi: long, inclusive: bool, step: long) -> long
    val n = range_count(lo, hi, inclusive, step)

    if n == 0 then (if inclusive then hi else hi - 1) else range_at(lo, step, n - 1)

// The half-open pair a range picks out of something `n` long, with the ends it did not name taken
// from that length and every end held inside it.
//
// **A STEPPED RANGE DOES NOT SLICE THROUGH HERE**, a half-open pair having nowhere to put the step;
// `read_at` walks the numbers themselves instead. What is left here is the ordinary slice, unchanged.
//
// Not `private`: the machine slices with it too.
range_within(r: Value, n: usize, at: Span) -> Result[(usize, usize), Signal]
    r match
        RangeVal(lo, hi, inclusive, has_lo, has_hi, _) ->
            val start = if has_lo then lo else 0
            val stop = if has_hi then (if inclusive then hi + 1 else hi) else long(n)

            if start < 0 || stop < start || usize(stop) > n
                return Err(failure(at, s"this slice runs from ${start} to ${stop}, which is outside something ${n} long"))

            Ok((usize(start), usize(stop)))
        other -> Err(failure(at, s"a slice is taken with a range, and this is ${other.type_name()}"))
end range_within

// The positions a stepped range picks out of something `n` long, in the order it covers them.
//
// **A stepped slice is the elements AT the numbers the range covers**, which is one rule for both
// directions: `xs[0..<6 by 2]` is every other one going up and `xs[5..0 by -1]` is the whole of it
// backwards. Both ends have to be written, there being no length to take a stepped end from.
private stepped_positions(lo: long, hi: long, inclusive: bool, has_lo: bool, has_hi: bool, step: long, n: usize, at: Span) -> Result[Buf[usize], Signal]
    if !has_lo || !has_hi
        return Err(failure(at, "a slice that steps needs a range with both ends, since a stepped end cannot be taken from what it is used on"))

    val count = range_count(lo, hi, inclusive, step)
    var out: Buf[usize] = buf()
    var i: usize = 0

    while i < count
        val p = range_at(lo, step, i)

        if p < 0 || usize(p) >= n
            return Err(failure(at, s"this slice reaches ${p}, which is outside something ${n} long"))

        out.push(usize(p))
        i += 1

    Ok(out)

// -- reading ------------------------------------------------------------------------------------

read_at(container: Value, k: Value, at: Span) -> Step
    container match
        Array(items) ->
            k match
                Int(i) ->
                    if i < 0 || usize(i) >= items.items.len()
                        return fault(at, s"the index ${i} is outside an array of ${items.items.len()}")

                    Ok(items.items.at(usize(i)))

                // **A range subscript is a slice, and it is what an open end is FOR.** `xs[2..]`
                // takes an end from the array, which is the reading that makes a range with a side
                // missing mean something rather than being syntax with nowhere to go.
                RangeVal(rlo, rhi, rinc, rhl, rhh, rstep) ->
                    var out: Buf[Value] = buf()

                    if rstep != 1
                        val ps = stepped_positions(rlo, rhi, rinc, rhl, rhh, rstep, items.items.len(), at)?
                        var j: usize = 0

                        while j < ps.len()
                            out.push(items.items.at(ps.at(j)))
                            j += 1

                        return Ok(Array(new_array(out)))

                    val bounds = range_within(k, items.items.len(), at)?
                    var i = bounds.0

                    while i < bounds.1
                        out.push(items.items.at(i))
                        i += 1

                    Ok(Array(new_array(out)))
                other -> fault(at, s"an array is indexed by an integer, and this is ${other.type_name()}")
        Object(fields) ->
            k match
                _ -> Ok(obj_get(fields, k, at)?.unwrap_or(Undefined))
                other -> fault(at, s"an object is indexed by a string, and this is ${other.type_name()}")
        Str(sv) ->
            // **Both of these count CHARACTERS.** A string is a sequence of characters in slate and
            // never of bytes, so a position here is one a person would count -- and an index into
            // the bytes would hand back half of one wherever the text was not ASCII.
            val n = char_count(sv.s)

            k match
                // **A character is a string of one**, there being no character type -- which is
                // Python's answer and is what lets `s[i]`, `chars(s)` and `split` all hand back the
                // same kind of thing.
                Int(i) ->
                    if i < 0 || usize(i) >= n
                        return fault(at, s"the index ${i} is outside a string of ${n} characters")

                    Ok(str_value(char_slice(sv.s, usize(i), usize(i) + 1)))
                RangeVal(rlo, rhi, rinc, rhl, rhh, rstep) ->
                    if rstep != 1
                        val ps = stepped_positions(rlo, rhi, rinc, rhl, rhh, rstep, n, at)?
                        var picked = str_builder()
                        var j: usize = 0

                        while j < ps.len()
                            picked.push(char_slice(sv.s, ps.at(j), ps.at(j) + 1))
                            j += 1

                        return Ok(str_value(picked.finish()))

                    val bounds = range_within(k, n, at)?

                    Ok(str_value(char_slice(sv.s, bounds.0, bounds.1)))
                other -> fault(at, s"a string is not indexed by ${other.type_name()}")
        External(_) -> fault(at, js_host_only("reading a key off an external"))
        other -> fault(at, s"${other.type_name()} cannot be indexed")
end read_at

// **A field that is not there reads as `null` rather than faulting**, which is the choice every
// dynamically typed language with objects makes: a record grows fields over its life, and `o.maybe`
// is how a program asks whether this one has.
read_field(target: Value, name: string, at: Span) -> Step
    target match
        Object(fields) ->
            val found = field_from(fields, name, at)?

            // **`o.toString` on its own hands back the plain builtin**, exactly as `xs.map` does and
            // as `o.m` does for a method the object carries. It is the same value `o.toString()`
            // calls, and it is what makes the five methods real rather than a syntax.
            if is_absent(found.0)
                // **A PROPERTY IS ASKED FIRST OF THE THREE**, so a class that wrote `get toString`
                // is answered by its own before the universal method is reached -- which is the rule
                // an ordinary field of that name already has.
                read_property(target, fields, name, at)? match
                    Some(v) -> return Ok(v)
                    None -> ()

                shape_receiver(target, name) match
                    Some(pair) -> return Ok(pair.0)
                    None -> ()

                universal_receiver(name) match
                    Some(pair) -> return Ok(pair.0)
                    None -> ()

            Ok(found.0)

        External(_) -> fault(at, js_host_only(s"reading `${name}` off an external"))

        // **A builtin type has methods and no fields**, so `xs.map` hands back the plain builtin --
        // the same thing `o.m` hands back for an object, and called the same way. Anything that is
        // not a method of this kind is a fault rather than the `undefined` an object answers with,
        // because a builtin's set of names is closed and a missing one is a mistake.
        other ->
            // **A PROPERTY IS ASKED FIRST, AS IT IS ON AN OBJECT**, and it answers the value rather
            // than the function: `s.length` is the number, where `xs.push` is the function `push`.
            // The two tables are disjoint by construction -- `method.sysl` holds both -- so the
            // order settles nothing today and is the object's rule written the same way round.
            builtin_property(other, name) match
                Some(p) ->
                    var args: Buf[Value] = buf()

                    args.push(other)

                    return call_native(p, args, at)
                None -> ()

            builtin_method(other, name) match
                Some(f) -> Ok(Native(f))
                None -> fault(at, no_such_method(other, name))

// How far a chain of prototypes may go before slate decides it is a circle.
//
// **A `proto` is an ordinary field, so a program can make one point at itself** -- and a lookup that
// misses would then walk forever with nothing to report. The limit is generous enough that no honest
// arrangement reaches it and small enough that the mistake is a sentence rather than a hang.
//
// Not `private`: `match_proto` in `match.sysl` walks the same chain and stops at the same depth.
const MaxProtoDepth: usize = 64

// A field, and whether it came from a PROTO rather than from the object itself.
//
// **That second answer is the whole of slate's receiver rule.** A method stored on the object has
// already captured what it needs -- `p["=="] = o -> o.x == p.x` is the shape a plain object has always
// written -- and one shared through a proto demonstrably cannot have, there being one of it for
// every instance. So the shared kind is handed the object and the captured kind is not, and the
// difference is not a special case but the actual distinction between the two.
//
// **`new` IS THE ONE NAME THE RULE DOES NOT REACH, AND LEAVING IT IN WAS A BUG.** The rule is about
// a method that needs to be told which object it is working on; a `new` is called before there is
// one, which is exactly why a class's own `new` is handed nothing. A class that inherits its base's
// therefore used to be given the class as a first argument -- so `Sub.new(5)` on a `class Sub from
// Base` faulted with *"this function takes 1 argument and was given 2"*, naming the arity of a
// constructor the reader never wrote and could not see. It is not that `new` is special-cased out of
// the receiver rule: it is that the rule's own reason has never applied to it.
//
// Absent everywhere is `Undefined`, which is what a missing field has always been.
field_from(o: *ObjectObj, name: string, at: Span) -> Result[(Value, bool), Signal]
    obj_get_name(o, name) match
        Some(v) -> return Ok((v, false))
        None -> ()

    var up = o
    var depth: usize = 0

    loop
        val next = obj_get_name(up, "proto") match
            Some(Object(p)) -> p
            _ -> return Ok((Undefined, false))

        obj_get_name(next, name) match
            Some(v) -> return Ok((v, name != "new"))
            None -> ()

        depth += 1

        if depth >= MaxProtoDepth
            return Err(failure(at, s"this object's `proto` chain is more than ${MaxProtoDepth} deep, which means it is a circle -- looking up `${name}` would never finish"))

        up = next
end field_from

// -- properties ------------------------------------------------------------------------------------

// The function one half of a property is, looked up exactly as a method is. `None` where there is no
// such half, which is `field_from`'s `Undefined` turned into the question all three callers ask.
//
// **A PROPERTY BELONGS TO THE OBJECTS A CLASS MAKES AND NOT TO THE CLASS**, so finding one as this
// object's OWN field means it was asked of the class itself -- `Shape.area`, which is the spelling a
// reader reaches for wanting a base's property the way `Shape.describe(self)` reaches for a base's
// method. There is no such spelling and the sentence says so, which is much better than either
// alternative: handing the getter its own class runs the body against an object holding none of the
// fields it reads, and handing it nothing complains about an argument count nobody wrote.
//
// **The test is `field_from`'s own delegated flag**, which is the receiver rule the rest of the
// language uses, read here rather than assumed.
private accessor_of(o: *ObjectObj, mark: string, name: string, at: Span) -> Result[Option[Value], Signal]
    val found = field_from(o, mark + name, at)?

    if is_absent(found.0) then return Ok(None)

    if !found.1
        val whose = class_own_name(o).unwrap_or("this class")

        return Err(failure(at, s"`${name}` is a property of the objects `${whose}` makes, and this is the class itself"))
    end if

    Ok(Some(found.0))
end accessor_of

// `c.area`, where a class declared `get area(self)`.
//
// **Reached only where the object's own fields and its whole proto chain have said nothing**, which
// is `shape_receiver`'s rule and `universal_receiver`'s: a stored field of that name wins, a class
// body refuses to declare both, and an object built by hand reads as what it holds.
//
// Not `private`: `run_frames.sysl` asks the same pair of questions at a call, so that `c.area()` can
// say what is actually wrong rather than that `area` is not a field.
read_property(target: Value, o: *ObjectObj, name: string, at: Span) -> Result[Option[Value], Signal]
    accessor_of(o, GetPrefix, name, at)? match
        Some(f) ->
            var args: Buf[Value] = buf()

            args.push(target)

            Ok(Some(apply(f, args, at)?))

        // **A `set` with no `get` makes the READ the mistake**, and saying so is the whole point of
        // asking: without it the read answers the `null` a field nobody wrote answers, and a program
        // storing through the property reads back nothing with no complaint anywhere.
        None -> accessor_of(o, SetPrefix, name, at)? match
            Some(_) -> Err(failure(at, s"`${name}` is write-only${property_owner(o)} -- it has a `set` and no `get`"))
            None -> Ok(None)
end read_property

// `c.area = v`, where a class declared `set area(self, v)`. The answer is whether a setter took it.
//
// **An own field wins, which is the read rule read backwards.** A `.` that would have answered a
// field stored on this very object has to assign to that field, or one name would mean two things
// depending on which side of the `=` it stood.
//
// Not `private`: the machine's `SetField` is the one caller and lives in `run_frames.sysl`.
write_property(target: Value, o: *ObjectObj, name: string, v: Value, at: Span) -> Result[bool, Signal]
    if obj_get_name(o, name).is_some() then return Ok(false)

    accessor_of(o, SetPrefix, name, at)? match
        Some(f) ->
            var args: Buf[Value] = buf()

            args.push(target)
            args.push(v)

            // **What a setter answers is dropped**, an assignment being a statement: `c.area = 4`
            // leaves no value, so there is nothing for the setter's own answer to become.
            apply(f, args, at)? match
                _ -> ()

            Ok(true)
        None -> accessor_of(o, GetPrefix, name, at)? match
            Some(_) -> Err(failure(at, s"`${name}` is read-only${property_owner(o)} -- it has a `get` and no `set`"))
            None -> Ok(false)
end write_property

// Whether either half of a property of this name is in reach, which is what a CALL asks.
//
// Not `private`: `run_frames.sysl` asks it at both call instructions.
has_property(o: *ObjectObj, name: string, at: Span) -> Result[bool, Signal]
    if accessor_of(o, GetPrefix, name, at)?.is_some() then return Ok(true)

    Ok(accessor_of(o, SetPrefix, name, at)?.is_some())
end has_property

// A builtin method and the receiver rule's answer for it, in the shape `field_from` uses.
//
// **A builtin method is always delegated to**, which is what the `true` says: it is the free
// function of that name and the receiver is its first argument, so it is exactly the case a proto
// method is -- one implementation shared by every value of the kind, which therefore has to be told
// which one it is working on.
builtin_receiver(target: Value, name: string, at: Span) -> Result[(Value, bool), Signal]
    // **An external is asked FIRST and is never asked of the tables**, because what it can do is the
    // host's and not slate's -- reaching the universal methods here would give a host value a
    // `toString` that nothing in the host put on it.
    target match
        External(_) -> return Err(failure(at, js_host_only(s"calling `${name}` on an external")))
        _ -> ()

    builtin_method(target, name) match
        Some(f) -> Ok((Native(f), true))

        // **A PROPERTY IS NOT A METHOD, AND THE SENTENCE SAYS SO RATHER THAN THAT THE KIND CANNOT DO
        // IT.** `s.length()` reads the number and then calls it; left to the ordinary complaint the
        // reader is told a string cannot `length`, which sends them looking for a method that was
        // never the thing they wanted. An object's `c.area()` is told the same in the same words.
        None -> builtin_property(target, name) match
            Some(_) -> Err(failure(at, s"`${name}` is a property, not a method -- it is read as `.${name}`, with no brackets after it"))
            None -> Err(failure(at, no_such_method(target, name)))
end builtin_receiver

// The universal method a value falls back to where nothing nearer answered, in `field_from`'s shape.
//
// **An OBJECT reaches these only through here, and only after its own fields and its whole proto
// chain have said nothing** -- which is what keeps `method.sysl`'s rule intact for every name but
// these five: a program that put a `toString` anywhere on its object gets its own.
universal_receiver(name: string) -> Option[(Value, bool)] = universal_method(name) match
    Some(f) -> Some((Native(f), true))
    None -> None

// The three shape methods a CLASS or DATA name answers to, in `field_from`'s shape.
//
// **A class is a type as well as a value, and this is the value half catching up with the types
// page**, which has always listed a `class` or `data` name as a type expression. The declaration
// interns its own shape and writes it on the class under `ShapeTag`, so the answer is the same
// `test`, `mismatch` and `name` a `type` name gives and there is one implementation of each.
//
// **Own field, never through a proto, which is what keeps an INSTANCE out of it.** A class's tag is
// the class's own; an instance reaches its class up the chain, and if this walked the chain then
// `circle.test(v)` would answer about the class the value was made from -- a question nobody asked
// of a value that is not a type.
//
// **It is reached only after the object's own fields and its whole proto chain have said nothing**,
// so a `test` the program itself declared on the class wins. That is `universal_method`'s rule and
// it is the reason a static may be called `name` without the language taking the word.
shape_receiver(target: Value, name: string) -> Option[(Value, bool)] = target match
    Object(o) -> obj_get_name(o, ShapeTag) match
        Some(Shape(_)) -> shape_method(name) match
            Some(f) -> Some((Native(f), true))
            None -> None
        _ -> None
    _ -> None

// The arguments a call actually binds, with anything past the last parameter dropped.
//
// **A CALL MAY GIVE MORE THAN THE FUNCTION DECLARES, AND THE SURPLUS IS DROPPED.** This is
// JavaScript's rule and TypeScript's, and it is what makes a function usable wherever a wider one is
// wanted: `() -> print("hit")` is a click handler, `x -> x * 2` is a `map` callback beside a walk
// that also offers the index, and `o.f(1, 2)` reaches an `f(self, a)` that has no use for the
// second. **Too FEW is still refused**, there being nothing to bind a required parameter to --
// slate stores no absence, so a hole is not a value it could invent.
//
// **A gathering function has no surplus**: everything past its fixed parameters is what its rest
// parameter is for, so this steps aside and `gather_rest` does the work.
//
// Not `private`: `execute.sysl`'s call path is the other one, and dropping twice differently is how
// two paths come to disagree about what a call binds.
fit_arguments(chunk: Chunk, params: usize, args: Buf[Value]) -> Buf[Value]
    if chunk.variadic || args.len() <= params then return args

    var kept: Buf[Value] = buf()

    for i in 0..<params
        kept.push(args.at(i))

    kept
end fit_arguments

// The arguments a call binds, with a variadic function's surplus gathered into its last parameter.
//
// **Done at the CALL and not at the head of the chunk**, which is where a default is done -- and the
// difference is that a default answers "nobody gave this" from inside the body, where the surplus is
// the arguments that have no parameter at all and are gone by the time a chunk runs.
//
// **The array is held on the way out and the caller's own `release` is what lets it go.** Nothing
// here may allocate while the incoming values are reachable from a sysl local and nowhere else.
//
// Not `private`: `execute.sysl`'s call path is the other one, and gathering twice differently is how
// two paths come to disagree about what a call binds.
gather_rest(chunk: Chunk, args: Buf[Value]) -> Buf[Value]
    if !chunk.variadic then return args

    val fixed = chunk.params.len() - 1

    // **A DEFAULTED parameter before the rest may go unfilled**, so there can be FEWER arguments
    // than fixed parameters -- which is what makes this a `min` rather than a count. Taking `fixed`
    // of them unconditionally reads past the end of the list, and `h(a, b = 9, ...rest)` called
    // `h(1)` is the shortest program that does it.
    val kept = if args.len() < fixed then args.len() else fixed

    for i in 0..<args.len()
        hold(args.at(i))

    var rest: Buf[Value] = buf()

    for i in kept..<args.len()
        rest.push(args.at(i))

    val gathered = new_array(rest)

    hold(Array(gathered))

    var out: Buf[Value] = buf()

    for i in 0..<kept
        out.push(args.at(i))

    // **The rest lands at `kept` and not at `params.len() - 1`**, so a call that left a default
    // unfilled binds the gathered array to the parameter the head is about to skip over -- which is
    // wrong, and is why the head runs after. See the caller: a defaulted parameter is bound by the
    // chunk's own first instructions, and those look up by NAME rather than by position.
    out.push(Array(gathered))
    out
end gather_rest

// Bind a call's arguments to a chunk's parameters.
//
// **The one place that knows where a gathered array goes, and it does not go where it sits.**
// `gather_rest` appends it, and where a DEFAULTED parameter before the rest went unfilled that
// position is the defaulted one -- so `h(a, b = 9, ...rest)` called `h(1)` would bind the array to
// `b` and leave `rest` for the chunk's head to complain about. The last value goes to the last
// parameter; everything before it is positional; and what is still unbound is what the head fills.
//
// Not `private`: all four call paths bind arguments -- `invoke`, `apply`, `start_async` and
// `start_generator` -- and four copies of this rule is how they come to disagree.
bind_arguments(scope: *EnvObj, c: *ClosureObj, given: Buf[Value], variadic: bool)
    for i in 0..<given.len()
        val slot = if variadic && i == given.len() - 1 then c.params.len() - 1 else i
        val v = given.at(i)

        // **A HOLE IS `Undefined`, AND A HOLE IS NOT BOUND AT ALL.** `f(a, b = 1, c = 2)` called
        // `f(1, c: 5)` skips `b`, and what it means to skip a parameter is exactly what it means to
        // leave one off the end: the name is not in the call's scope, so the `JumpIfBound` at the
        // head of the chunk falls through and works the default out. A program cannot put one here
        // by accident -- `keepable` refuses to pass `undefined` at the call -- so this is the one
        // thing it can mean.
        val hole = v match
            Undefined -> true
            _ -> false

        if !hole then declare(scope, c.params.at(slot), v, true)

// A NATIVE calling a function the PROGRAM supplied, which is a different thing from a call the
// program wrote.
//
// **A CALLBACK IS GIVEN AS MANY ARGUMENTS AS IT DECLARES AND NO MORE.** `onClick(() -> count(n + 1))`
// is what a person writes for a handler that does not read the event, and `onData(c, () -> stop())`
// for a reader that does not care what arrived; making either name a parameter it ignores is a tax
// on the common case. TypeScript draws the line in exactly this place -- a function of fewer
// parameters is assignable where more are supplied, and a direct call with the wrong count is an
// error -- and this is that rule.
//
// **A call the PROGRAM wrote stays strict**, on both back ends: `f(1, 2)` to a one-parameter `f` is
// refused. There the count is a claim the reader made, and getting it wrong is a mistake rather than
// a convenience.
//
// **A callback that declares MORE than the native can supply is still a fault, and the sentence
// names the NATIVE.** The reader's function is not wrong; the surface they attached it to cannot
// feed it, and that is what they need to be told.
//
// Not `private`: every native with a callback is a caller.
apply_callback(f: Value, vals: Buf[Value], at: Span, native: string) -> Step
    f match
        // **A builtin passed as a callback is handed everything and checks its own arguments**,
        // there being no chunk to read an arity off -- `sorted(xs, compare)` is the shape.
        Native(_) -> apply(f, vals, at)
        Fn(c) ->
            val chunk = current_unit.chunks.at(c.body)

            if chunk.required > vals.len()
                val floor = if chunk.variadic then s"at least ${counted(chunk.required, "argument")}" else counted(chunk.required, "argument")

                return fault(at, s"`${native}` calls this with ${counted(vals.len(), "argument")} and it takes ${floor}")

            // **The trimming itself is `apply`'s**, every call dropping what it cannot bind. What is
            // left here is the sentence: a callback that declares more than the native can supply is
            // told which native could not feed it, where an ordinary call names the function.
            apply(f, vals, at)
        other -> apply(f, vals, at)
end apply_callback

// A native walking a collection, where the arguments past `plain` are there only for a callback that
// asked for them.
//
// **A BUILTIN PASSED AS A CALLBACK IS HANDED `plain` AND NO MORE, AND THAT IS WHAT KEEPS
// `map(strs, number)` WORKING.** A function the program wrote declares what it wants and the call
// drops the rest, which is what makes handing over the element, its position and the array safe. A
// builtin cannot declare: its parameters are sysl's, so it refuses a count it was not expecting --
// and `["1", "2", "3"].map(number)` would become a fault where JavaScript's `map(parseInt)` becomes
// a wrong answer. Neither is an answer worth having, so the extras are simply not offered.
//
// **The JavaScript back end draws the same line at the same place**, `$b`'s functions carrying no
// parameter list where a compiled slate function does.
// Not `private`: `array.sysl` and `reshape.sysl` are the walks.
apply_walk_callback(f: Value, vals: Buf[Value], plain: usize, at: Span, native: string) -> Step
    f match
        Native(_) ->
            var kept: Buf[Value] = buf()

            for i in 0..<plain
                kept.push(vals.at(i))

            apply_callback(f, kept, at, native)
        other -> apply_callback(f, vals, at, native)

// Call a value with arguments already evaluated.
//
// **No calling scope is passed, and that is what a closure means.** The body runs in a child of the
// scope the closure *captured*, so nothing about where the call was written matters -- which is also
// what lets `==` call a user-supplied `equals` from inside a table lookup, where there is no
// interpreter scope to hand over.
apply(f: Value, vals: Buf[Value], at: Span) -> Step
    f match
        Native(f) -> call_native(f, vals, at)
        Fn(c) ->
            val chunk = current_unit.chunks.at(c.body)
            val required = chunk.required

            if vals.len() < required
                return fault(at, arity_complaint(chunk.name, required, c.params.len(), vals.len(), chunk.variadic))

            val fitted = fit_arguments(chunk, c.params.len(), vals)

            val emark = env_mark()
            val mark = root_mark()

            // **The gather is above the two ways out**, which is `invoke`'s rule for `invoke`'s
            // reason: a rest parameter belongs to the function rather than to how it is entered, so
            // an `async` or a generator has to be started with the arguments an ordinary call would
            // bind. It holds what it makes, so this mark covers every path below.
            val given = gather_rest(chunk, fitted)

            // **An `async` function starts a coroutine wherever it is called from**, including from a
            // native -- a timer callback, a user `equals`. Running its body here instead would put an
            // `await` under a sysl frame that cannot be captured, which is the one thing the machine
            // exists to avoid.
            if chunk.is_async
                val started = start_async(c, given, at)

                release(mark)

                return started

            // **And a generator is PREPARED here too, for the same reason.** `invoke` routes both,
            // and this is the other call path -- a function reached from a native, a callback, a
            // `map`. Missing it would run a generator's body under a sysl frame that cannot be set
            // aside, which is the one thing the machine exists to avoid.
            if chunk.is_gen
                val prepared = start_generator(c, given, at)

                release(mark)

                return prepared

            // **A chunk whose parameters are slots gets no scope**, exactly as on the machine's own
            // call path: the closure's captured scope is what free names resolve against, and the
            // arguments go into the frame `run_chunk` is about to lay.
            // **The hold is kept ACROSS the call rather than dropped before it**, which the scope
            // path gets for free: there, the arguments are reachable through the `EnvObj` the moment
            // they are bound. Here they are a sysl local until `lay_frame` puts them on the stack,
            // so `gather_rest`'s hold is what covers the gap -- and holding a handful of values for
            // the length of one call costs nothing.
            if chunk.slotted
                val slotted = run_chunk(&current_unit, c.body, c.scope, given)

                release(mark)
                release_env(emark)

                return slotted

            val scope = new_env(c.scope)

            hold_env(scope)

            // Only what was given: a defaulted parameter nobody filled is bound by the head of the
            // chunk, exactly as it is on the machine's own call path.
            bind_arguments(scope, c, given, chunk.variadic)
            release(mark)

            // The annotation is the one the compiler asks for: a bare `Ok`/`Err` pair in a `match`
            // used as a value has nothing on the line to say what the other half is.
            val answer = run_chunk(&current_unit, c.body, scope, buf())

            release_env(emark)
            answer
        // The other call path's reading of the same rule -- an object with a `new` is callable, and
        // the call is that `new`. It is here as well as in `invoke` because this is where a call
        // reached from a native lands: `xs.map(Circle)` builds a Circle per element, and without
        // this it would say an object cannot be called while `Circle(x)` a line above worked.
        Object(_) -> hook_of(f, "new") match
            Some(maker) -> apply(maker, vals, at)
            None -> fault(at, no_maker())
        External(_) -> fault(at, js_host_only("calling an external"))
        other -> fault(at, s"${other.type_name()} is not something that can be called")
end apply

