module dev.slatelang.slate

// `slate:actor` -- eight names over eight natives, and nothing else.
//
// **THE MODULE EXISTS TO GIVE THE NATIVES THE DESIGN PAGE'S NAMES.** `spawn` is already
// `slate:process`'s child and `send` is already `slate:net`'s write, and the builtin registry is
// keyed by name -- so the natives are `actorSpawn`, `actorSend` and their neighbours, declared into
// the scope a built-in module compiles in, and this is where they become `spawn`, `send`, `ask`,
// `done`, `stop`, `detach`, `me` and `transfer`.
//
// **`spawn`, `send`, `ask`, `done`, `stop`, `detach`, `me` and `transfer` are FUNCTIONS and not
// methods of a handle**, which is the design page's own decision and matters: a handle's field
// namespace belongs entirely to the program, so `a.stop` is the handler somebody wrote called `stop`
// and nothing built in can collide with a name they chose.
//
// **A rest parameter and a spread are what make one wrapper serve every arity**, a handler taking
// whatever its declaration takes.
actor_source() -> string = raw"""
    // Start an actor, and answer its handle.
    //
    // `spawn(A)`, `spawn(A, args...)`, and `spawn(A, args..., { heap, mailbox, name })` where the
    // options are one more argument than the declaration's own constructor takes.
    export spawn(a, ...rest) = actorSpawn(a, ...rest)

    // Post a message nobody waits for. `send(c.bump, 2)`, or `send(c, "bump", 2)`.
    //
    // It answers nothing and never waits. A message to an actor that has stopped is dropped; one to
    // an actor whose mailbox is full is a fault here, in the sender.
    export send(m, ...rest) = actorSend(m, ...rest)

    // Post a message and answer a promise of what the handler answers.
    //
    // It composes with `all`, `race`, `any` and `allSettled` like any other promise, and a fault
    // inside the handler arrives as a rejection at the `await`.
    export ask(m, ...rest) = actorAsk(m, ...rest)

    // A promise that settles when the actor has stopped -- with the fault, if it died of one.
    export done(a) = actorDone(a)

    // Ask an actor to stop once its mailbox is empty.
    export stop(a) = actorStop(a)

    // This actor is no longer one the program waits for at the end.
    export detach(a) = actorDetach(a)

    // Inside a handler: this actor's own handle.
    export me() = actorMe()

    // Hand a buffer's storage over rather than copying it. The sender's buffer is left empty.
    export transfer(b) = actorTransfer(b)
    """
