module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// A file's own top-level `var` lives in its cell, and the scope is not written after it is bound.
//
// **What that asks of the compiler is that NOTHING it emits reads such a variable by spelling**, since
// the scope would answer what it was declared as. The file's statements and functions already read
// the cell; the export object a module answers is the reader these tests are about, together with the
// refusals a write still has to make. The answers on both back ends, across a real import, are in
// `tests/lang/modulevars.sl`.

// The reads and writes of one spelling in whichever chunks build an export object.
private struct Reads
    by_name: usize
    by_cell: usize

private export_reads(program: string, name: string) -> Reads
    out(program)

    val u = running_unit()
    var by_name: usize = 0
    var by_cell: usize = 0
    var any = false

    for c in 0..<u.chunks.len()
        val code = u.chunks.at(c).code
        var exports = false

        for i in 0..<code.len()
            code.at(i).op match
                MakeObject(_) -> exports = true
                _ -> ()

        if !exports then continue

        any = true

        for i in 0..<code.len()
            code.at(i).op match
                LoadName(k) -> if u.strings.at(usize(k)) == name then by_name += 1
                LoadCell(_, k) -> if u.strings.at(usize(k)) == name then by_cell += 1
                _ -> ()

    assert(any, "no chunk builds an export object")
    Reads(by_name, by_cell)
end export_reads

@test
AN_EXPORTED_VARIABLE_IS_READ_FROM_ITS_CELL()
    // **The export is the one read a file emits after its last statement**, and it used to be a
    // lookup by spelling -- which reads a scope that is no longer written once the cell is filled.
    val r = export_reads("export var total = 0\ntotal = total + 5\nprint(total)", "total")

    assert_eq(r.by_name, 0)
    assert(r.by_cell >= 1)
end AN_EXPORTED_VARIABLE_IS_READ_FROM_ITS_CELL

@test
AN_EXPORTED_VARIABLE_WHOSE_SPELLING_IS_REBOUND_KEEPS_THE_LOOKUP()
    // **A function binding the spelling for itself takes every site back to the scope** -- the
    // declaration, the writes and the export alike -- so the export is a lookup of a scope that is
    // still written.
    val prog = "export var total = 0\ntotal = 5\nown()\n    var total = 9\n    total\nprint(total + own())"
    val r = export_reads(prog, "total")

    assert_eq(r.by_cell, 0)
    assert(r.by_name >= 1)
    assert_eq(out(prog), "14")
end AN_EXPORTED_VARIABLE_WHOSE_SPELLING_IS_REBOUND_KEEPS_THE_LOOKUP

// How many annotation checks anywhere in the program read a cell rather than a spelling.
private checked_cells(program: string) -> usize
    out(program)

    val u = running_unit()
    var n: usize = 0

    for c in 0..<u.chunks.len()
        val code = u.chunks.at(c).code

        for i in 0..<code.len()
            code.at(i).op match
                CheckType(_, cell) -> if cell > 0 then n += 1
                _ -> ()

    n
end checked_cells

@test
AN_ANNOTATED_MODULE_VARIABLE_IS_CHECKED_AGAINST_ITS_CELL()
    // **The check stands right after the binding and has to read where the binding went**: the scope
    // holds `null` for a top-level `var`, and a check reading it refused every annotated variable
    // that was not `null`-able -- `var n: number = 0` included.
    val prog = "var n: number = 0\nbump()\n    n = n + 1.5\n    n\nbump()\nn = n * 2\nprint(n, bump())"

    assert_eq(checked_cells(prog), 1)
    assert_eq(out(prog), "3 4.5")
    assert(fails("var n: number = 0\nspoil()\n    n = \"x\"\nspoil()").contains("`n` was declared number"))
    assert(fails("var n: number = 0\nn = \"x\"").contains("`n` was declared number"))
end AN_ANNOTATED_MODULE_VARIABLE_IS_CHECKED_AGAINST_ITS_CELL

@test
AN_ANNOTATED_VARIABLE_WHOSE_SPELLING_IS_REBOUND_IS_CHECKED_BY_NAME()
    // The spelling goes back to the lookup, and the check with it.
    val prog = "var n: number = 0\nbump()\n    n = n + 1\n    n\nown()\n    var n = 9\n    n\nprint(bump() + own())"

    assert_eq(checked_cells(prog), 0)
    assert_eq(out(prog), "10")
end AN_ANNOTATED_VARIABLE_WHOSE_SPELLING_IS_REBOUND_IS_CHECKED_BY_NAME

@test
A_MODULE_VARIABLE_WRITTEN_MANY_TIMES_READS_ITS_LAST_VALUE_EVERYWHERE()
    // The file's own loop, a function of the file and a closure made before the writes all read the
    // same cell.
    val prog = "var n = 0\nval peek = () -> n\nread() = n\nwhile n < 1000\n    n = n + 1\nprint(n, read(), peek())"

    assert_eq(out(prog), "1000 1000 1000")
end A_MODULE_VARIABLE_WRITTEN_MANY_TIMES_READS_ITS_LAST_VALUE_EVERYWHERE

@test
WRITING_OR_BINDING_ABSENCE_TO_A_MODULE_NAME_IS_STILL_REFUSED_BY_NAME()
    // **The sentence is only built when it is said now**, so each of the four places that build one
    // is asked to say it: a cell's write and binding, and the same two by spelling.
    assert(fails("var x = 1\nx = {}.missing").contains("written to `x`"))
    assert(fails("var y = {}.missing").contains("bound to `y`"))
    assert(fails("var t = 0\nown()\n    var t = 1\n    t\nt = {}.nope").contains("written to `t`"))
    assert(fails("var s = {}.nope\nown()\n    var s = 1\n    s").contains("bound to `s`"))
end WRITING_OR_BINDING_ABSENCE_TO_A_MODULE_NAME_IS_STILL_REFUSED_BY_NAME

@test
A_VALUE_WRITTEN_TO_A_MODULE_VARIABLE_IS_KEPT_BY_ITS_CELL_ALONE()
    // **The cell is the only thing holding the latest value**, the scope keeping only `null`, so the
    // table has to be a collector root. A small heap and a loop that allocates on every turn make the
    // collector run many times while the only reference is the cell.
    val prog = "var keep = [0]\nvar i = 0\nwhile i < 20000\n    keep = [i, [i, i]]\n    i = i + 1\nprint(keep[1][0])"

    set_heap_limit(1048576)

    val said = out(prog)

    set_heap_limit(268435456)
    assert_eq(said, "19999")
end A_VALUE_WRITTEN_TO_A_MODULE_VARIABLE_IS_KEPT_BY_ITS_CELL_ALONE
