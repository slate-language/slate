module dev.slatelang.slate

// slate's HTTP server, written in slate and carried in the binary.
//
// **THE SECOND KIND OF BUILT-IN MODULE.** `slate:time`, `slate:fs`, `slate:net`, `slate:process` and
// `slate:regex` are export lists over natives and need no source at all -- `stdlib.sysl` says why.
// This one is a module written in slate, parsed from the text below exactly as a file would be, and
// everything after the parse is the same: it follows its own imports, it runs, and what it exports is
// what it wrote `export` in front of.
//
// **A RAW TEXT BLOCK, SO WHAT IS WRITTEN HERE IS WHAT SLATE READS.** `raw"""` takes no escapes and
// strips only the incidental indentation, so the module sits below at four spaces and reaches the
// lexer at the margin -- and a `\r\n`, a quote or a `${...}` in it means itself. `js_rt.sysl` carries
// JavaScript the same way and for the same reason.
//
// **It was 667 escaped strings in an array until 2026-08-30**, one per line, because this file's own
// header said sysl had no raw string literal. **That had stopped being true**: sysl has had `"""` on
// any quote form since before the JavaScript back end was written, and `js_rt.sysl` had been using
// one the whole time. What the array cost was that every quote and backslash in the module was
// escaped here and not in the module, so editing `slate:http` meant a round trip through an escaping
// nobody could check by eye. The conversion was verified by decoding the array and diffing it against
// what this block answers: not one byte moved.

// The module's source, as slate will read it.
// The module's source, as slate will read it.
//
// **THE TEXT IS JOINED FROM FIVE BLOCKS AND IS ONE MODULE.** `slate:http` outgrew the thousand-line
// rule at 1255 lines, before HTTP/2 and streamed responses were anywhere near it, so the block was
// cut at two section comments the code already had: `http_write_source.sysl` takes the bounds and the
// response writer, `http_parts_source.sysl` takes the query string, the router and the file server,
// and `http2_source.sysl` is the HTTP/2 speaker. What was left grew past the rule again and was cut at
// the blank line before `server`: `http_front_source.sysl` holds what a handler is given and the
// entry points, and this file holds the server they call.
//
// **Joining rather than importing is the whole of the decision.** Three slate modules would have made
// the pieces public -- a `slate:httpwrite` nobody asked for -- and would have needed export lists to
// hand the private helpers across. Concatenation changes the text not at all: what the lexer is given
// is byte for byte what it was given before.
//
// **THE FOURTH PIECE IS BEHIND THE `http2` FEATURE, AND THE OTHER THREE ARE NOT.** HTTP/2 is
// nghttp2, which is a library somebody has to install; HTTP/1.1 is llhttp, which is vendored. So a
// build without the feature joins three blocks, and what it gets is the same server speaking one
// version -- `serve`, `adopt` and `close` are the same three exports, a handler is handed the same
// request, and `shaped` frames the same answer.
#if feature_http2
http_source() -> string =
    http_front_source() + http_server_source() + http_write_source() + http_parts_source() + http2_source()
#else
http_source() -> string =
    http_front_source() + http_server_source() + http_write_source() + http_parts_source()
#endif

// The second piece: the server that `serve`, `serveStream` and `adopt` call, and the one helper two
// blocks share. The piece before it, `http_front_source.sysl`, is what a handler is given, what it
// may answer, and the entry points; it ends on the blank line this one follows.
http_server_source() -> string = raw"""
    server(port, handler, streaming, onUpgrade) =
        // **The handler is checked here and the port is not**, which is the layering rather than an
        // oversight: `listen` is given the port and complains about it in its own words, while nothing
        // would look at the handler until the first request arrived -- an hour later, on a connection
        // somebody was waiting for. This is what `throw` is for.
        // **A ROUTER IS AN OBJECT AND IS TAKEN AS ONE**, so `serve(3000, app)` works: an object with
        // a `handle` is asked for its `handle`, and everything else about the server is unchanged.
        // Nothing here knows what routing is -- what it knows is that a handler is a function, and
        // that one place to look for it is inside an object that says it has one.
        val called = if handler is object && has(handler, "handle") then handler.handle else handler

        // The key this server's connections are filed under, filled in once the port is known. **A
        // connection cannot arrive before `listen` has answered**, so nothing reads it while it is
        // still empty.
        var portKey = ""

        // How many accepted connections have not yet had a request put to the handler nor ended, and
        // the `heard()` promises waiting for that to reach nought.
        var unheard = 0
        var hearing = []

        heard()
            val p = pending()

            if unheard == 0 then settle(p, null) else hearing.push(p)

            p

        // One connection has been heard from, or has gone without a word.
        spokeOnce()
            unheard = unheard - 1

            if unheard == 0
                val waiting = hearing

                hearing = []

                for p in waiting
                    settle(p, null)

        if !(called is function) then throw "`serve` needs a function to call with each request, or an object with a `handle` that is one"

        // **Checked here for the same reason the handler is**: a connection asking to upgrade may not
        // arrive for an hour, and a program that passed the wrong thing wants to hear about it now.
        if onUpgrade != null && !(onUpgrade is function)
            throw "`serve` needs a function to call with an upgrade, and this is not one"

        // The two deadlines, read off the listening record where it names them. **Checked here
        // for the handler's reason**: a wrong value would otherwise surface at the first slow
        // client, which may be days away.
        deadline(name, otherwise)
            if !(port is object) || !has(port, name) then return otherwise

            val ms = port[name]

            if !(ms is integer) || ms <= 0
                throw "`" + name + "` is a number of milliseconds above nought, and this is " + string(ms)

            ms

        val headMillis = deadline("headMillis", HeadMillis)
        val requestMillis = deadline("requestMillis", RequestMillis)

        // **WHICH VERSION A CONNECTION IS, ASKED ONCE AND NOWHERE ELSE.** `h2` and `http/1.1` arrive
        // on one port over one socket and differ in nothing that can be sniffed -- HTTP/2's preface
        // is bytes a malformed HTTP/1.1 request could also begin with -- so ALPN is the answer and
        // `alpnProtocol` is where a program reads it. A plain socket answers `null`, which is
        // `http/1.1` by the only reading there is.
        //
        // **AND IT IS ASKED AT THE FIRST BYTE RATHER THAN AT ACCEPT, WHICH IS THE WHOLE OF WHY THIS
        // FUNCTION EXISTS.** A connection callback fires when TCP accepts, which is *before* the TLS
        // handshake has said anything -- so `alpnProtocol` there answers `null` on a connection that
        // is about to be `h2`, and every one of them would be handed to the HTTP/1.1 speaker, which
        // would meet the preface and answer `400`. By the time a byte of application data arrives the
        // handshake is long finished.
        //
        // **The chunk that decided it is handed on rather than dropped.** It is the client's first
        // frames or its first request line; nothing else is going to arrive carrying it.
        //
        // **The two speakers share the handler and nothing else.** Each frames a request and a
        // response its own way; what a handler is given and what it may answer is the same value on
        // both, which is the whole point of doing this here rather than making everybody write two
        // servers.
        accept(conn)
            // **A connection is in the server's table from the moment it is accepted, before it has
            // said which protocol it speaks.** A client that opens a connection and then says nothing
            // is one `close` has to be able to end, and until the first byte arrives there is no
            // speaker to hold it. The slot's `finish` is replaced by the speaker that takes over.
            val key = string(nextConn)

            nextConn = nextConn + 1

            // The clock a `close` started on this connection before its first byte, or null while the
            // server has not been closed.
            var hushing = null

            // Whether this connection still counts in `unheard`. **Every way it can stop counting
            // goes through `spoke`**, and each may happen more than once -- a first request that is
            // also the connection's last reaches both the handler and `retire` -- so it is a latch.
            var silent = true

            unheard = unheard + 1

            spoke()
                if silent
                    silent = false
                    spokeOnce()

            hush()
                hushing = null

                spoke()
                shutSocket(conn)

            // **A CONNECTION THAT HAS NOT SPOKEN YET IS NOT IDLE, AND CLOSING THE SERVER GIVES IT
            // `DrainMillis` TO SPEAK.** An idle connection is one that has been answered and is being
            // kept, and ending it costs its client nothing -- a keep-alive client knows to ask again.
            // One accepted a moment before the `close` has not been answered anything: its request is
            // as likely as not already in the socket, unread only because the loop has not turned since
            // the accept. Ending it there drops a request a client sent in good time, with nothing it
            // could safely retry, and a supervisor rolling its workers does exactly that -- it hands a
            // connection to the worker it is about to ask to leave. So the first byte is waited for a
            // quarter of a second, and a request it begins is answered as the last on the connection.
            startHushing()
                if hushing == null then hushing = setTimeout(hush, DrainMillis)

            // `spoke` is what a speaker calls as it puts a request to the handler; `retire` counts
            // too, since a connection that ends has nothing left to say.
            leave()
                spoke()
                retire(portKey, key)

            val slot = { finish: startHushing, spoke: spoke, retire: leave }

            enrol(portKey, key, slot)

            chosen(chunk)
                val closing = hushing != null

                if closing
                    clearTimeout(hushing)

                    hushing = null

                // A connection that closed before saying anything. **The socket is closed here, and
                // saying there was nothing to close was wrong**: the end of a stream is not the end of
                // a handle, so one left here is one the loop waits on for the rest of the run.
                if chunk == null
                    slot.retire()
                    shutSocket(conn)

                    return

#if feature_http2
                if alpnProtocol(conn) == "h2"
                    speakH2(conn, called, streaming, chunk, slot, headMillis)
                else
                    speak11(conn, chunk, slot)
#else
                speak11(conn, chunk, slot)
#endif

                // The server was closed while this connection was still silent, so the speaker that
                // has just taken it over is told at once -- with the request the first bytes began
                // already in hand, which is what makes it answered rather than cut.
                if closing then slot.finish()

            onBytes(conn, chosen)

        // **Each speaker installs a reader of its own over this one**, which is what `onBytes` being
        // a replacement rather than an addition is for.
        speak11(conn, first, slot)
            // The parser this connection's bytes go through. **Nothing is buffered here**: what a
            // request is made of is llhttp's business, and this module asks only what it has ready.
            val parser = if streaming then httpStream(HeadBytes) else httpParser(HeadBytes, BodyBytes)

            // Whether a request is being answered. **This is what puts the connection in order**: a
            // second request waits in the parser until the first has been written, because HTTP matches
            // an answer to a request by its position in the stream and by nothing else.
            var busy = false

            // Whether this connection is finished. Every way out sets it, so nothing writes to a closed
            // socket and no timer fires against one.
            var shut = false

            // Whether the server has been closed and this connection is finishing its last response.
            // **Nothing new is read once it is up**, which is what "no keep-alive after close" means.
            var closing = false

            // Whether the client has stopped sending. A request completed by the end of the stream is
            // still answered, and the connection is not kept afterwards whatever it asked for.
            var ended = false

            // The clock that closes a connection nobody is using, or null while it is not running.
            var idle = null

            // The two deadlines on the request being read, each null while it is not running. Both
            // start at a request's first byte; `headClock` stops when its head is whole and
            // `requestClock` when its body is.
            var headClock = null
            var requestClock = null

            // Whether this connection has started writing an answer. **A deadline that expires after
            // a response has begun cannot be answered `408`**, there being no way to take back the
            // status already sent, so it ends the connection instead.
            var replying = false

            // Whether bytes of a following request arrived while this one was in flight, which is
            // what `resume` reads to give that request its deadlines when its turn comes.
            var early = false

            // How to cut the streamed response being written, or null where none is. **The writer
            // hands this over when it starts and takes it back when it ends**, because a streamed
            // body lives entirely inside `streamed`'s own locals and a shutdown had no handle on it
            // at all.
            var cutting = null

            // What a streamed request is made of while it is being read. `sink` is the function the
            // handler asked to be given the body, `ending` is the promise it is awaiting, `held` is what
            // arrived before it asked, `got` is how much of the body has been handed over, and `reading`
            // says whether the parts still coming out of the parser belong to the request being answered
            // -- which is what keeps a pipelined second request waiting for the first.
            var sink = null

            // Whether the handler is still running and might yet ask for the body. **This is what says
            // where a chunk goes, and `busy` used to stand in for it wrongly**: `busy` stays up until
            // the answer has been WRITTEN, so a handler that answered without asking went on holding the
            // rest of the upload while its own response was going out -- and a large enough body was
            // refused with `413` after it had already been answered `200`.
            var holding = false

            var ending = null
            var held = []
            var heldBytes = 0
            var got = 0
            var reading = false

            // Stop the clock, a connection with something to do not being idle by definition.
            awake()
                if idle != null
                    clearTimeout(idle)

                    idle = null

            // Stop the head's deadline, the blank line that ends it having arrived.
            headDone()
                if headClock != null
                    clearTimeout(headClock)

                    headClock = null

            // Stop both deadlines, the request having arrived whole or the connection having ended.
            requestDone()
                headDone()

                if requestClock != null
                    clearTimeout(requestClock)

                    requestClock = null

            // Start both deadlines at a request's first byte. **Started once and never moved**, which
            // is the whole difference from the idle clock: a byte arriving says nothing about whether
            // the request will ever be finished.
            begin()
                if shut || headClock != null || requestClock != null then return

                replying = false
                early = false
                headClock = setTimeout(timedOut, headMillis)
                requestClock = setTimeout(timedOut, requestMillis)

            // A deadline expired. **`408` where nothing has been written for this request**, which
            // is what tells a real client that was merely slow why it was cut; where an answer has
            // begun, the status is already on the wire and the connection simply ends.
            timedOut()
                if shut then return

                requestDone()

                if replying
                    stop()

                    return

                reading = false

                refuse(408, "the request did not arrive in time")

            // Start the next request's deadlines once this connection has nothing in flight, where
            // that request has already begun.
            //
            // **A pipelined request gets its own deadlines here**, rather than none: its bytes
            // arrived while the previous request was in flight, which starts no clock, so its clocks
            // start when its turn comes. `early` says bytes came in after the previous request was
            // whole, and `httpHeading` catches a head begun in the very feed that finished it. One
            // case is left to the idle clock: a pipelined request whose head ALSO finished in that
            // feed, which no parser call can see, and which still cannot hold more than `BodyBytes`.
            resume()
                if shut || busy then return

                if early || (!streaming && httpHeading(parser)) then begin()

            stop()
                if shut then return

                shut = true

                awake()
                requestDone()
                release()
                httpClose(parser)
                slot.retire()
                shutSocket(conn)

            // What closing the server means to this connection: end now if there is nothing in flight,
            // and otherwise write the answer being written and end after it.
            //
            // **The clock runs while it finishes**, which it does not while an ordinary request is
            // being answered: a shutdown waits for what is in flight, and a request whose client has
            // gone would never finish -- so waiting for it without a clock would be a server that
            // cannot be shut down.
            finish()
                // **A STREAM THAT NEVER ENDS IS NOT SOMETHING A SHUTDOWN CAN WAIT FOR.** An event
                // stream is a response that is *meant* not to finish, so the rule above -- write
                // the answer in flight and end after it -- would hold the connection for the whole
                // of `IdleMillis` and then close the socket under a writer that was still parked in
                // its source. Five seconds to close a server, and the source found out only because
                // the next write failed. Cutting says the same thing at once and in the right
                // order: the source is told its reader has gone, and then the socket goes.
                //
                // **BUT THE SOCKET GOES WHEN THE WRITER IS DONE WITH IT AND NOT BEFORE**, which is
                // the difference between cutting a stream and dropping one. A program that ends its
                // streams and closes its server in the same breath -- which is what an orderly
                // shutdown is -- leaves the writer parked in a `next` whose answer has already been
                // settled, so closing the socket here threw away the last event of every stream.
                // The ending is handed to the writer instead: it drains what the source has left,
                // writes the terminator, and ends the connection. `DrainMillis` is what stops that
                // from being a wait for a stream that is never going to end.
                if cutting != null
                    val cut = cutting

                    cutting = null
                    closing = true

                    cut(stop)

                    return

                if busy
                    closing = true

                    quiet()
                else
                    stop()

            // What the writer calls to hand its cut over, and to take it back when the response has
            // ended. **A named function because an assignment is not an expression**, so a lambda
            // cannot be one.
            //
            // **A CUT HANDED OVER AFTER THE SERVER WAS CLOSED IS TAKEN AT ONCE.** `finish` can arrive
            // while the handler is still running or the head is still being written -- the request
            // is in flight, so the connection is busy, but no writer has handed its cut over yet.
            // `finish` can only mark the connection closing and start the clock, and a cut stored
            // after that was never taken: the source was not told and the socket went only when
            // `IdleMillis` ran out, five seconds later, under a writer still parked in its source.
            watched(f)
                if f != null && closing && !shut
                    cutting = null

                    f(stop)

                    return

                cutting = f

            // Stop being this connection's server, and leave the socket open.
            //
            // **Everything `stop` does except closing the socket**, which is the whole of what handing a
            // connection to another protocol means: the clock is stopped, the parser is let go, and every
            // path back into this module is closed by `shut` -- but the socket belongs to somebody else
            // now and closing it is theirs to do.
            //
            // **AND IT LEAVES THE SERVER'S TABLE**, for the same reason it is not closed: a socket this
            // module has given away is not one `close(server)` may take back.
            handOver()
                if shut then return

                shut = true

                awake()
                requestDone()
                release()
                httpClose(parser)
                slot.retire()

            // Let go of a handler waiting for a body that is not going to finish arriving.
            //
            // **The count it is given is short of the `Content-Length` it was promised**, which is how a
            // handler tells a client that hung up mid-upload from one that did not. Answering the promise
            // rather than failing it is deliberate: a client going away is the ordinary end of a
            // connection and not a defect in the program, and a failure here would be put back by
            // `answer` and would stop the server.
            release()
                if ending != null
                    reading = false

                    settle(ending, got)

                    ending = null

            // Start the clock, which is what every path that leaves the connection with nothing
            // outstanding ends with.
            //
            // **A CONNECTION THAT IS ALREADY FINISHED STARTS NO CLOCK.** A timer is a handle the loop
            // waits on, so a clock started after the socket has gone holds a program that has nothing
            // left to do for the whole of `IdleMillis` -- which is exactly the five seconds every
            // other rule here exists to avoid. It happens on the ordinary path: a streamed response
            // that ends the connection itself returns to a caller whose next step is to start the
            // clock for the request it thinks may be coming.
            quiet()
                if shut then return

                awake()

                idle = setTimeout(stop, IdleMillis)

            // **A handler may answer a promise, and the ordinary one does** -- it reads a file, asks a
            // database, calls another service. `await` on something that is not a promise answers it
            // unchanged, so both kinds of handler take this one path.
            //
            // **A HANDLER THAT THROWS AND A WRITE THAT FAILS ARE NOT THE SAME THING**, and they used to
            // share a `try`. A defect in a handler is a defect in the program: the client is told, and
            // the fault is put back afterwards, where nothing awaits it and it reaches the loop and stops
            // the program as any other fault would. **A write that fails is a client that has gone** --
            // it hung up, or it was never going to read the answer -- which is the ordinary end of a
            // connection and no reason at all to stop the server. Taking the second for the first meant a
            // client pressing ^C mid-request could end the process, and streaming makes that the common
            // case rather than a rare one, since a handler now runs while the client is still sending.
            async answer(req: object, again: boolean)
                var reply = null

                // **The parsed query and cookies are added HERE**, which is one place for both
                // servers rather than one in each parser -- and the raw text stays on `search`, so
                // nothing is lost by the object keeping only the last of a repeated name.
                //
                // **`params` is `{}` and not absent.** A handler reached without a router would
                // otherwise read `undefined`, which slate refuses to pass anywhere -- so the empty
                // object is what makes `req.params` safe to write whether or not one is in use.
                req.search = req.search ?? ""
                req.query = parseQuery(req.search)
                req.cookies = if has(req.headers, "cookie") then parseCookies(req.headers["cookie"]) else {}
                req.params = {}

                // **Who connected**, which until 0.0.30 a handler had no way to learn at all: a
                // rate limiter, an allow-list and a log line all wanted it and had only whatever a
                // proxy had written into a header. It is read per REQUEST rather than kept per
                // connection because it costs a cached read and nothing else, and a connection
                // holding a stale copy is a thing to keep in step.
                req.address = remoteAddress(conn)

                // Counted as heard in the same turn the handler is called, so nothing waiting on
                // `heard()` runs before the handler has seen the request.
                slot.spoke()

                try
                    reply = await called(req)
                catch e
                    holding = false

                    await refuse(500, "this request was not answered")
                    throw e

                // **The handler has had its chance to ask**, so nothing is held for it from here: the
                // rest of the body is read off the wire and dropped, which is what the three cases in
                // `pump` say and what `busy` was too coarse to express.
                //
                // **What was held BEFORE it answered goes too, and saying "holding nothing" without
                // this was not quite true.** Those bytes were kept for an `each` that is not coming;
                // leaving them would hold a whole body until the connection's next request, which on a
                // kept connection is exactly the megabyte streaming exists not to hold.
                holding = false
                held = []
                heldBytes = 0
                replying = true

                try
                    await write(conn, req, reply, again, watched)
                catch e
                    stop()
                    return

                busy = false

                // **The next request may already be here**, where a client pipelined -- so this is not a
                // wait for more bytes to arrive, it is the turn the second request has been waiting for.
                if again && !closing
                    quiet()
                    next()
                    resume()
                else
                    stop()

            // A response this connection writes for itself, and its last: a request this server could not
            // read leaves the stream at an offset nobody knows, so there is nothing to keep it open for.
            //
            // **`busy` is set here rather than by the caller, and that is safe because an `async` body
            // runs up to its first `await` before the caller goes on** -- so by the time `step` returns,
            // this connection is marked as owing an answer.
            async refuse(status: integer, message: string)
                busy = true

                // **The same rule as `answer`'s second half**: the connection this is complaining about
                // may already have gone, and failing to deliver a complaint about a client is not
                // something to complain about.
                try
                    await plainly(conn, status, message)
                catch e
                    val gone = e

                stop()

            // Take one whole request from the parser, where there is one and nothing else is owed.
            step()
                if shut || busy then return

                val req = httpTake(parser)

                if req == null then return

                busy = true

                awake()
                requestDone()

                // **A connection the client has already closed is not kept**, whatever the request asked
                // for -- there is nobody left to send the next one.
                answer(req, req.keepAlive && !ended)

            // Hand over the pieces of a streamed request as they come out of the parser.
            pump()
                if shut then return

                while true
                    // **A pipelined second request waits its turn**, exactly as it does in `step`: a
                    // part is only pulled while it still belongs to the request being answered.
                    if busy && !reading then return

                    val p = httpTakePart(parser)

                    if p == null then return

                    if p.kind == "head"
                        busy = true
                        reading = true
                        holding = true
                        sink = null
                        held = []
                        heldBytes = 0
                        got = 0
                        ending = pending()

                        awake()
                        headDone()

                        // **A connection the client has already closed is not kept**, whatever the
                        // request asked for -- there is nobody left to send the next one.
                        answer(streamed(p), p.keepAlive && !ended)
                    elif p.kind == "body"
                        got = got + p.chunk.length

                        // **Three things a chunk can be, and only the middle one is held.**
                        //
                        // The handler asked for the body, so it gets it. Or the handler has already
                        // answered without asking -- which is an ordinary thing to do, and the rest of
                        // the body is then read off the wire and **dropped**, holding nothing and
                        // keeping the stream aligned for whatever comes next. Or the handler is still
                        // running and has not asked yet, and that is the only case with anywhere to put
                        // the bytes: they are held for an `each` that may still be coming, and a handler
                        // that never asks is a handler accumulating the whole body, which is the case
                        // `serve` bounds and this has to bound the same way.
                        if sink != null
                            sink(p.chunk)
                        elif holding
                            held.push(p.chunk)

                            heldBytes = heldBytes + p.chunk.length

                            // **`reading` goes down FIRST, and without that the refusal repeats.**
                            // `refuse` is async, so `shut` is not set until after its write -- and every
                            // chunk arriving in the meantime would come back through here, be held, be
                            // over the limit again, and be refused again. The accumulating server does
                            // not have the problem because llhttp pauses itself; this one has to say so.
                            if heldBytes > BodyBytes
                                reading = false

                                tooLarge()
                                return
                    else
                        reading = false

                        requestDone()
                        resume()
                        settle(ending, got)

                        ending = null

            // The bound was passed -- but the handler is given the turn it is owed before it is refused.
            //
            // **`holding` is cleared a turn LATE for a handler that answers outright, and that turn is
            // this race.** `answer` calls the handler at once, but `await` on a value that is not a
            // promise still yields, deliberately, so `holding = false` runs only when the scheduler
            // comes back to it -- and a client that pushes a megabyte in the meantime drew a `413` for
            // a body the handler had already decided not to read. It arrived BEFORE the answer, on the
            // same connection, which is two responses to one request.
            //
            // **`await 0` IS the one turn**, and it is a timer-free one: awaiting a value that is not a
            // promise queues a resumption and nothing else, so this comes back in the same drain pass
            // rather than at whatever the event loop does next.
            //
            // **Waiting one turn settles it in the right order, and not by luck.** `ready` is drained in
            // the order it was filled, and `answer` was queued when the head was parsed -- before any of
            // these bytes existed -- so it always resumes first. What is left to ask afterwards is the
            // question the bound is actually about: is the handler STILL running and still not asking?
            // An `async` handler that has not settled is, and is refused exactly as before.
            async tooLarge()
                await 0

                if holding && sink == null
                    await refuse(413, "the body is larger than " + string(BodyBytes) + " bytes")
                    return

                // **The handler answered, or asked, in the turn it was given -- so reading goes back
                // on.** Leaving it down would be worse than the wrong refusal it replaces: a handler
                // that asked would wait forever for a body nobody is pulling any more.
                reading = true

                next()

            // The request a streaming handler is given: the head, and the one way of asking for the rest.
            streamed(p: object) -> object =
                val req = { method: p.method, path: p.path, search: p.search, headers: p.headers,
                            keepAlive: p.keepAlive }

                // **Stored on the object rather than reached through a proto**, so calling it passes the
                // function what it was given and nothing else -- `req.each(f)` is `f` and no receiver,
                // which is what this wants.
                req.each = (f) ->
                    sink = f

                    for c in held
                        f(c)

                    held = []
                    heldBytes = 0

                    ending

                // **`next` is `each` read the other way round, and it is written OVER `each` rather
                // than beside it.** The push half already knows about held chunks, the sink and the
                // ending promise; a second reader reaching into that state would be a second thing to
                // keep in step with it. So this is an ordinary queue and one pending promise, and the
                // only connection machinery it touches is `each` itself.
                //
                // What it buys is `for await chunk in req`, which is what a reader wants a streamed
                // body to look like. The two are the same bytes and a handler picks one: asking for
                // `next` starts the `each` nobody else is going to call.
                var queue = []
                var pull = null
                var started = false
                var finished = false

                // A chunk goes to whoever is already waiting for one, and to the queue otherwise.
                deliver(c)
                    if pull == null
                        queue.push(c)
                        return

                    val waiting = pull

                    pull = null

                    settle(waiting, { done: false, value: c })

                // **The end has to wake a waiting `next` as well as be remembered**, or a handler that
                // asked for one more chunk than the body had waits for the rest of the run.
                async ended_at(whole)
                    await whole

                    finished = true

                    if pull != null
                        val waiting = pull

                        pull = null

                        settle(waiting, { done: true, value: null })

                req.next = () ->
                    // **`each` drains what was held SYNCHRONOUSLY**, so the queue is checked after
                    // starting rather than before: a body that arrived whole before the handler asked
                    // is entirely in `queue` by the time this line runs.
                    if !started
                        started = true

                        ended_at(req.each(deliver))

                    if queue.length > 0 then return { done: false, value: shift(queue) }

                    if finished then return { done: true, value: null }

                    pull = pending()

                    pull

                req

            // Whichever of the two this connection reads with. Every path that has just made progress
            // ends here rather than at one of them.
            next()
                if streaming then pump() else step()

            // **Called after every chunk, because there is no other way to know a request is whole.**
            // TCP hands over whatever has arrived, and a request may be split anywhere at all --
            // including in the middle of the blank line that ends its headers.
            arrived(chunk: bytes | null)
                if shut then return

                // The client has hung up. **Not an error**: that is how a client ends a kept connection
                // it has finished with, and it is the ordinary end of most of them. A request whose body
                // ran to the end of the stream is completed by `httpFinish` and still answered.
                if chunk == null
                    ended = true

                    httpFinish(parser)
                    next()

                    // **A body that was still arriving is not going to finish.** `httpFinish` completes a
                    // request that ends at end-of-file and says nothing about one that does not, so the
                    // handler awaiting the rest of this body is let go here or waits forever.
                    release()

                    if !busy then stop()

                    return

                awake()

                // **A request's first byte starts its deadlines**, and a byte arriving while one is
                // in flight is part of that one or of a pipelined request, whose clocks start when
                // its turn comes.
                if !busy
                    begin()
                elif !streaming || !reading
                    early = true

                // **A refusal is an answer rather than a fault.** The bytes were not a request this
                // server will act on, so the status goes back and the connection ends -- taking the
                // program down over a bad client would be the wrong trade entirely.
                val bad = httpFeed(parser, chunk)

                if bad != null
                    refuse(bad.status, bad.message)
                    return

                // **The head's blank line stops the head's deadline and leaves the request's
                // running**, which is the case the two clocks exist for: a large upload is slow and
                // legitimate, and only its head is held to the short deadline.
                if !streaming && !httpHeading(parser) then headDone()

                // **A request that asked to stop being HTTP ends this module's interest in the socket.**
                // `httpUpgraded` answers where the HTTP stopped, and everything after that offset belongs
                // to whatever protocol the client asked for. **Zero is a real answer** -- a handshake that
                // arrived on its own leaves nothing behind it -- so the test is against `null`.
                val upTo = httpUpgraded(parser)

                if upTo != null
                    hoist(chunk, upTo)
                    return

                next()

                if !busy
                    if closing then stop() else quiet()

            // The request that asked to upgrade, taken from whichever parser this server is using.
            //
            // **A streaming server has no `httpTake`**, so the handshake comes out as a head part -- which
            // carries everything a whole request does but its body, and a handshake has no body.
            upgradeRequest()
                if !streaming then return httpTake(parser)

                val part = httpTakePart(parser)

                if part == null || part.kind != "head" then null else part

            // Hand this connection to whoever was told to expect one.
            //
            // **The bytes left over are from THIS FEED, not from the connection.** `httpUpgraded` counts
            // into the chunk it was given, so `chunk[upTo..]` is what the other protocol has already sent
            // and what it would otherwise never see -- a client that pipelines its first frame behind the
            // handshake is ordinary, and losing it would look like a peer that said nothing.
            hoist(chunk: bytes, upTo: integer)
                val req = upgradeRequest()

                // **A server with no upgrade handler says so rather than going quiet.** The client asked
                // for a protocol this program does not speak, which is something it can act on; leaving
                // it holding a socket nothing will ever answer is not.
                if onUpgrade == null || req == null
                    refuse(501, "this server does not upgrade connections")
                    return

                handOver()

                onUpgrade(req, conn, chunk[upTo..])

            slot.finish = finish

            onBytes(conn, arrived)

            // **The clock starts before the first request, not after it.** A client that opens a
            // connection and then says nothing is exactly as quiet as one that has stopped mid-stream.
            quiet()

            // The bytes that chose this speaker, fed to it now that everything it needs is built.
            arrived(first)

        if port == null
            // **A key that cannot collide with a port number**, since the two live in one table and
            // an adopting server has no port to be named by.
            portKey = "adopted " + string(nextAdopted)
            nextAdopted = nextAdopted + 1
            connsOf[portKey] = {}

            val key = portKey

            // `dispose` is `close` under the name a `using` looks for, which every built-in
            // resource answers to now.
            return { handle: accept, heard: heard, close: () -> shutConns(key), dispose: () -> shutConns(key) }

        val sock = listen(port, accept)

        portKey = string(localPort(sock))

        // **The table is seeded empty rather than made by the first connection**, so that HAVING one
        // is what says a socket is a server of this module's. `close` is exported for a server and is
        // reached by sockets that are not one -- a program importing `close` from `slate:http` closes
        // its client sockets with it too -- and a port number on its own would be a poor thing to
        // decide that on.
        connsOf[portKey] = {}

        sock

    // One key dropped from an object, as a new object.
    //
    // **It lives HERE rather than in the HTTP/2 block, and that was found by taking the block out.**
    // `forgotten` is a general helper with callers on both sides -- `shutConns` and `close` above,
    // and the h2 speaker's stream tables -- so a build without the `http2` feature joined three
    // blocks and every server died with ``forgotten` is not defined`. A name two blocks use belongs
    // in the one that is always there, which is this one.
    forgotten(o: object, key: string) -> object
        var out = {}

        for [k, v] in entries(o)
            if k != key then out[k] = v

        out

    """
