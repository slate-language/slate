module dev.slatelang.slate

// `slate:lmdb` in the JavaScript back end, which is nineteen refusals and no implementation.
//
// **A REFUSAL RATHER THAN AN `OWED` STUB, WHICH IS `slate:brotli`'s CASE EXACTLY.** A name on the
// `OWED` list says *not built yet*, and that is a promise somebody is waiting on; this is a promise
// nobody could keep. A browser has no memory-mapped file and no path to one -- `IndexedDB` and the
// Origin Private File System are what a page stores things in, and neither is an ordered B+tree a
// program walks with a cursor. node has no LMDB in its standard library either: every LMDB binding
// on npm is a native addon, so a program compiled by `slate js` and run anywhere would depend on
// something the tool cannot see and did not install.
//
// **So the sentence names the module, says why, and says what to reach for instead** -- which is the
// rule `abbrev`, `isDST` and `slate:brotli`'s two already follow. `docs/library/lmdb.md` says the
// same thing where a reader is deciding whether to use this at all, which is before they have
// written the program that would draw the refusal.
//
// **One sentence for all nineteen, and it names the one that was called.** Every name here fails for
// exactly one reason and it is the same reason, so nineteen hand-written sentences would be nineteen
// copies of one -- and the name is what tells a reader which line of their program it was.

js_runtime_lmdb() -> string = raw"""
        // -- lmdb ----------------------------------------------------------------------------------

        // **`slate:lmdb` is a thing no JavaScript host has**, and it says so rather than sitting on
        // `OWED`. A browser has no memory-mapped file at all and node has no LMDB in its standard
        // library -- every binding is a native addon -- so "not in the JavaScript back end yet"
        // would be a promise nobody can keep.
        const noLmdb = (name) => () =>
            fault("`" + name + "` is LMDB, and no JavaScript host has it -- a browser has no " +
                "memory-mapped file and node's LMDB is a native addon, so this module runs in the " +
                "interpreter only")

        for (const name of ["lmdbOpen", "lmdbClose", "lmdbInfo",
            "lmdbRead", "lmdbWrite", "lmdbCommit", "lmdbAbort",
            "lmdbDb", "lmdbGet", "lmdbHas", "lmdbPut", "lmdbDelete", "lmdbClear", "lmdbStat",
            "lmdbCursor", "lmdbFirst", "lmdbNext", "lmdbSeek", "lmdbCursorClose"])
            B[name] = noLmdb(name)
    """
