module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf}
import sysl.text.{str_builder}

// The builtins that reach outside the program: TCP (`slate:net`) and the file system (`slate:fs`),
// with `stderr`, which is declared beside `exit` and `args` but is written the way a file is.
//
// **Cut out of `builtin.sysl` when it passed a thousand lines, and nothing crosses the cut.** A
// builtin is `register(name, go)` where it is written, so `dispatch_native` reaches these through the
// table and the `do_*` functions here are `private` to this file. What `natives.sysl` calls is
// `install_net` and `install_fs`, and what other files read is the `n_*` ids, none of which is
// `private` (they are module `var`s of the native-id kind the census in `tests_vm_state.sysl`
// recognises by shape).

// TCP. **A socket is a handle with a lifetime**, which is what makes this different from the file
// system: `connect` and `send` answer promises, and `listen` and `onData` take callbacks, because a
// stream is a run of events rather than one answer.
var n_listen: NativeFn = 0
var n_connect: NativeFn = 0
var n_on_data: NativeFn = 0
var n_on_bytes: NativeFn = 0
var n_on_error: NativeFn = 0
var n_send: NativeFn = 0
var n_close_socket: NativeFn = 0
var n_shutdown: NativeFn = 0
var n_local_port: NativeFn = 0

// **Who is at the other end**, which a server has no other way to learn -- `slate:http` told a
// handler the method, the path and the headers and nothing at all about the client.
var n_remote_address: NativeFn = 0
var n_start_tls: NativeFn = 0

// **Which application protocol a TLS connection settled on**, which is the one question a server
// taking both HTTP/1.1 and HTTP/2 on one port cannot answer any other way.
var n_alpn_protocol: NativeFn = 0

// **TCP, which is `slate:net` and no longer global.**
//
// **`send`, `close` and `connect` are why this module went third.** They are words a program wants
// for its own -- a mailer sends, a file closes -- and while they were global a script writing
// `close(handle) = ...` shadowed a builtin without meaning to.
install_net(env: *EnvObj, everything: bool)
    n_listen = register("listen", do_listen)
    n_connect = register("connect", do_connect)
    n_on_data = register("onData", (args, at) -> do_read(args, at, true))
    n_on_bytes = register("onBytes", (args, at) -> do_read(args, at, false))
    n_on_error = register("onError", do_on_error)
    n_send = register("send", do_send)
    n_close_socket = register("close", do_close)
    n_shutdown = register("shutdown", do_shutdown)
    n_local_port = register("localPort", do_local_port)
    n_remote_address = register("remoteAddress", do_remote_address)
    n_start_tls = register("startTls", do_start_tls)
    n_alpn_protocol = register("alpnProtocol", do_alpn_protocol)

    if everything
        declare(env, "listen", Native(n_listen), false)
        declare(env, "connect", Native(n_connect), false)
        declare(env, "onData", Native(n_on_data), false)
        declare(env, "onBytes", Native(n_on_bytes), false)
        declare(env, "onError", Native(n_on_error), false)
        declare(env, "send", Native(n_send), false)
        declare(env, "close", Native(n_close_socket), false)
        declare(env, "shutdown", Native(n_shutdown), false)
        declare(env, "localPort", Native(n_local_port), false)
        declare(env, "remoteAddress", Native(n_remote_address), false)
        declare(env, "startTls", Native(n_start_tls), false)
        declare(env, "alpnProtocol", Native(n_alpn_protocol), false)
end install_net

// The file system. **node's names**, and the promise-shaped thirteen come first.
var n_read_file: NativeFn = 0
var n_read_bytes: NativeFn = 0
var n_write_file: NativeFn = 0
var n_append_file: NativeFn = 0

// **Bytes on the writing side, which is the reading `send` already had.** `writeFile` renders
// anything that is not a string the way `print` does, so an array reached the disk as its own text --
// and a program holding an image or a compressed body had to encode it to store it.
var n_write_bytes: NativeFn = 0
var n_append_bytes: NativeFn = 0

// **Where a program says what went wrong.** `print` is the answer a program produces and this is
// what it says about producing it, which is the division every shell already makes: `slate app.sl >
// answers.txt` keeps the answers and lets the complaints through. In `slate:process` rather than
// `slate:fs`, being about this program rather than about a file.
var n_stderr: NativeFn = 0

var n_read_dir: NativeFn = 0
var n_stat: NativeFn = 0
var n_exists: NativeFn = 0
var n_remove: NativeFn = 0
var n_mkdir: NativeFn = 0
var n_rmdir: NativeFn = 0
var n_rename: NativeFn = 0

// The same thirteen, blocking. **`Sync` is node's suffix and the reason for having them is node's
// too**: a program that reads its configuration before it starts, or a script whose whole job is
// three file operations in order, gains nothing from a promise and pays for it in ceremony.
var n_read_file_sync: NativeFn = 0
var n_read_bytes_sync: NativeFn = 0
var n_write_file_sync: NativeFn = 0
var n_append_file_sync: NativeFn = 0
var n_write_bytes_sync: NativeFn = 0
var n_append_bytes_sync: NativeFn = 0
var n_read_dir_sync: NativeFn = 0
var n_stat_sync: NativeFn = 0
var n_exists_sync: NativeFn = 0
var n_remove_sync: NativeFn = 0
var n_mkdir_sync: NativeFn = 0
var n_rmdir_sync: NativeFn = 0
var n_rename_sync: NativeFn = 0

// **The file system, which is `slate:fs` and no longer global.**
//
// **`stat`, `exists`, `remove` and `rename` are why this module went second.** They are verbs a
// program wants for its own, and while they were global a script writing `val stat = ...` shadowed a
// builtin without meaning to.
//
// **The blocking ten go through the same argument checking as the others**, which is what `with_path`
// taking a function pointer bought: a `Sync` builtin differs from its asynchronous twin only in which
// function it hands over.
install_fs(env: *EnvObj, everything: bool)
    n_read_file = register("readFile", (args, at) -> with_path(args, at, "readFile", read_file_promise))
    n_read_bytes = register("readBytes", (args, at) -> with_path(args, at, "readBytes", read_bytes_promise))
    n_read_dir = register("readDir", (args, at) -> with_path(args, at, "readDir", read_dir_promise))
    n_stat = register("stat", (args, at) -> with_path(args, at, "stat", stat_promise))
    n_exists = register("exists", (args, at) -> with_path(args, at, "exists", exists_promise))
    n_remove = register("remove", (args, at) -> with_path(args, at, "remove", remove_promise))
    n_mkdir = register("mkdir", (args, at) -> with_path(args, at, "mkdir", mkdir_promise))
    n_rmdir = register("rmdir", (args, at) -> with_path(args, at, "rmdir", rmdir_promise))
    n_write_file = register("writeFile", do_write_file)
    n_stderr = register("stderr", do_stderr)
    n_append_file = register("appendFile", do_append_file)
    n_write_bytes = register("writeBytes", (args, at) -> with_bytes(args, at, "writeBytes", write_bytes_promise))
    n_append_bytes = register("appendBytes", (args, at) -> with_bytes(args, at, "appendBytes", append_bytes_promise))
    n_rename = register("rename", do_rename)

    n_read_file_sync = register("readFileSync", (args, at) -> with_path(args, at, "readFileSync", read_file_sync))
    n_read_bytes_sync = register("readBytesSync", (args, at) -> with_path(args, at, "readBytesSync", read_bytes_sync))
    n_read_dir_sync = register("readDirSync", (args, at) -> with_path(args, at, "readDirSync", read_dir_sync))
    n_stat_sync = register("statSync", (args, at) -> with_path(args, at, "statSync", stat_sync))
    n_exists_sync = register("existsSync", (args, at) -> with_path(args, at, "existsSync", exists_sync))
    n_remove_sync = register("removeSync", (args, at) -> with_path(args, at, "removeSync", remove_sync))
    n_mkdir_sync = register("mkdirSync", (args, at) -> with_path(args, at, "mkdirSync", mkdir_sync))
    n_rmdir_sync = register("rmdirSync", (args, at) -> with_path(args, at, "rmdirSync", rmdir_sync))
    n_write_file_sync = register("writeFileSync", do_write_file_sync)
    n_append_file_sync = register("appendFileSync", do_append_file_sync)
    n_write_bytes_sync = register("writeBytesSync", (args, at) -> with_bytes(args, at, "writeBytesSync", write_bytes_sync))
    n_append_bytes_sync = register("appendBytesSync", (args, at) -> with_bytes(args, at, "appendBytesSync", append_bytes_sync))
    n_rename_sync = register("renameSync", do_rename_sync)

    if everything
        declare(env, "readFile", Native(n_read_file), false)
        declare(env, "readBytes", Native(n_read_bytes), false)
        declare(env, "writeFile", Native(n_write_file), false)
        declare(env, "appendFile", Native(n_append_file), false)
        declare(env, "writeBytes", Native(n_write_bytes), false)
        declare(env, "appendBytes", Native(n_append_bytes), false)
        declare(env, "readDir", Native(n_read_dir), false)
        declare(env, "stat", Native(n_stat), false)
        declare(env, "exists", Native(n_exists), false)
        declare(env, "remove", Native(n_remove), false)
        declare(env, "mkdir", Native(n_mkdir), false)
        declare(env, "rmdir", Native(n_rmdir), false)
        declare(env, "rename", Native(n_rename), false)

        declare(env, "readFileSync", Native(n_read_file_sync), false)
        declare(env, "readBytesSync", Native(n_read_bytes_sync), false)
        declare(env, "writeFileSync", Native(n_write_file_sync), false)
        declare(env, "appendFileSync", Native(n_append_file_sync), false)
        declare(env, "writeBytesSync", Native(n_write_bytes_sync), false)
        declare(env, "appendBytesSync", Native(n_append_bytes_sync), false)
        declare(env, "readDirSync", Native(n_read_dir_sync), false)
        declare(env, "statSync", Native(n_stat_sync), false)
        declare(env, "existsSync", Native(n_exists_sync), false)
        declare(env, "removeSync", Native(n_remove_sync), false)
        declare(env, "mkdirSync", Native(n_mkdir_sync), false)
        declare(env, "rmdirSync", Native(n_rmdir_sync), false)
        declare(env, "renameSync", Native(n_rename_sync), false)

        // Declared with `slate:process`'s names rather than `slate:fs`'s: what this program says
        // about its own run belongs beside `exit` and `args`.
        declare(env, "stderr", Native(n_stderr), false)
end install_fs


// -- TCP ------------------------------------------------------------------------------------------

// A port, which a program writes as a number and nothing else.
private port_of(v: Value, at: Span, name: string) -> Result[long, Signal]
    v match
        Int(n) -> Ok(n)
        other -> Err(failure(at, s"`${name}` takes a port number, and this is ${other.type_name()}"))

private do_listen(args: Args, at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`listen` takes a port and a function, and was given ${counted(args.len(), "argument")}")

    // A listening socket another program passed over a channel, which this one accepts on too.
    args.at(0) match
        Socket(_, _) -> return listen_passed(args.at(0), args.at(1), at)
        _ -> ()

    val (port, secure, reuse_port) = listen_target(args.at(0), at)?

    listen_socket(port, secure, reuse_port, args.at(1), at)

private do_connect(args: Args, at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`connect` takes an address and a port, and was given ${counted(args.len(), "argument")}")

    args.at(0) match
        Str(p) -> connect_socket(p.s, port_of(args.at(1), at, "connect")?, at)
        other -> fault(at, s"`connect` takes an address, and this is ${other.type_name()}")

private do_read(args: Args, at: Span, as_text: bool) -> Step
    val name = if as_text then "onData" else "onBytes"

    if args.len() != 2 then return fault(at, s"`${name}` takes a socket and a function, and was given ${counted(args.len(), "argument")}")

    read_socket(args.at(0), args.at(1), as_text, at)

private do_on_error(args: Args, at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`onError` takes a socket and a function, and was given ${counted(args.len(), "argument")}")

    error_socket(args.at(0), args.at(1), at)

private do_send(args: Args, at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`send` takes a socket and what to send, and was given ${counted(args.len(), "argument")}")

    args.at(1) match
        Str(p) -> send_socket(args.at(0), p.s, at)

        // **An array is BYTES and not its own rendering.** `send(sock, [72, 105])` meaning the six
        // characters `[72, 105]` is not something anybody wants, and bytes are how a program sends
        // what is not text -- an image, a compressed body, a string it read with `onBytes` and never
        // decoded.
        // **A buffer is the shape a program reaches for now**, and it is the cheap one: the bytes are
        // already bytes, so nothing is decoded on the way to the socket.
        Bytes(p) -> send_bytes(args.at(0), p.data.view(), at)
        Array(p) ->
            val payload = bytes_of(p, at, "send")?

            send_bytes(args.at(0), payload.view(), at)

        // Rendered as `print` would render it, which is the reading `writeFile` already takes.
        other -> send_socket(args.at(0), printed(other, at)?, at)

private do_close(args: Args, at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`close` takes a socket and was given ${counted(args.len(), "argument")}")

    close_socket(args.at(0), at)

// `shutdown(sock)` -- end this side's writing and keep reading.
private do_shutdown(args: Args, at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`shutdown` takes a socket and was given ${counted(args.len(), "argument")}")

    shutdown_socket(args.at(0), at)

// `alpnProtocol(conn)` -- the name the two ends agreed on, or `null` where there is none.
private do_alpn_protocol(args: Args, at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`alpnProtocol` takes a connection and was given ${counted(args.len(), "argument")}")

    alpn_protocol(args.at(0), at)
end do_alpn_protocol

private do_local_port(args: Args, at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`localPort` takes a socket and was given ${counted(args.len(), "argument")}")

    local_port(args.at(0), at)

// `remoteAddress(conn)` -- the IP at the other end, or `null` where there is no other end.
private do_remote_address(args: Args, at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`remoteAddress` takes a connection and was given ${counted(args.len(), "argument")}")

    remote_address(args.at(0), at)

private do_start_tls(args: Args, at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`startTls` takes a socket and the host to connect as, and was given ${counted(args.len(), "argument")}")

    start_tls_target(args.at(1), at)? match
        AsClient(host, trust, alpn) -> start_tls_socket(args.at(0), host, trust.view(), alpn.view(), at)
        AsServer(certificate, key, alpn) -> present_tls_socket(args.at(0), certificate.view(), key.view(), alpn.view(), at)

// The path a file-system builtin was given, or the complaint about what it was given instead.
//
// Not `private`: nothing outside needs it, but it is the shape every one of them shares and pulling
// it out is what keeps ten builtins from being ten copies of the same three lines.
private path_of(v: Value, at: Span, name: string) -> Result[string, Signal]
    v match
        Str(p) -> Ok(p.s)
        other -> Err(failure(at, s"`${name}` takes a path, and this is ${other.type_name()}"))

// The eight that take one path and nothing else.
//
// **A function pointer rather than eight arms**, which is what the shape is worth: each of them
// differs only in which libuv call it makes, and writing the argument check eight times is how the
// eighth one ends up saying something the other seven do not.
private with_path(args: Args, at: Span, name: string, go: &Fn(string, Span) -> Step) -> Step
    if args.len() != 1 then return fault(at, s"`${name}` takes one path and was given ${counted(args.len(), "argument")}")

    go(path_of(args.at(0), at, name)?, at)
end with_path

// The four that take a path and an array of bytes.
//
// **Anything that is not an array of bytes FAULTS here, where `writeFile` renders it**, and the two
// readings are the same rule seen from opposite ends: `writeFile` is about a file's text, so a
// number is something a reader would want written out, while `writeBytes` is about the bytes
// themselves and a value that is not bytes is a mistake in the program. Rendering it would put
// `[72, 105]` on the disk under a name that says otherwise.
private with_bytes(args: Args, at: Span, name: string, go: &Fn(string, Buf[u8], Span) -> Step) -> Step
    if args.len() != 2 then return fault(at, s"`${name}` takes a path and its bytes, and was given ${counted(args.len(), "argument")}")

    val path = path_of(args.at(0), at, name)?

    args.at(1) match
        Bytes(p) -> go(path, p.data, at)
        Array(p) -> go(path, bytes_of(p, at, name)?, at)
        other -> fault(at, s"`${name}` takes bytes or an array of numbers, and this is ${other.type_name()} -- `${write_twin(name)}` is what writes anything else")
end with_bytes

// The name a program reaching `writeBytes` with text was probably after.
private write_twin(name: string) -> string =
    name match
        "writeBytes" -> "writeFile"
        "appendBytes" -> "appendFile"
        "writeBytesSync" -> "writeFileSync"
        else "appendFileSync"

private do_write_file(args: Args, at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`writeFile` takes a path and its contents, and was given ${counted(args.len(), "argument")}")

    val path = path_of(args.at(0), at, "writeFile")?

    args.at(1) match
        Str(p) -> write_file_promise(path, p.s, at)

        // **Anything else is rendered as `print` would render it**, which is the reading a program
        // writing a number or an array to a file expects -- and the alternative, refusing everything
        // but a string, would make `writeFile(path, str(x))` the only spelling anybody ever wrote.
        other -> write_file_promise(path, printed(other, at)?, at)
end do_write_file

// `stderr(text)` -- one line on the diagnostic stream.
//
// **Straight to the descriptor rather than over libuv, and it answers nothing.** A complaint is the
// one thing a program may need to have said before the next line runs -- a crash after an `await`
// would lose it -- and every other way of writing here is asynchronous. `print` is synchronous for
// the same reason and this is `print`'s sibling.
//
// **The newline is the caller's**, as node's `process.stderr.write` leaves it: a program writing a
// JSON object per line and one writing a progress bar want different answers, and only one of them
// can be the default.
private do_stderr(args: Args, at: Span) -> Step
    var out = str_builder()

    for i in 0..<args.len()
        if i > 0 then out.push_char(' ')

        out.push(printed(args.at(i), at)?)

    eprints(out.finish())
    Ok(Null)
end do_stderr

// `appendFile(path, text)` -- `writeFile` that adds rather than replaces.
private do_append_file(args: Args, at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`appendFile` takes a path and what to add, and was given ${counted(args.len(), "argument")}")

    val path = path_of(args.at(0), at, "appendFile")?

    args.at(1) match
        Str(p) -> append_file_promise(path, p.s, at)
        other -> append_file_promise(path, printed(other, at)?, at)
end do_append_file

private do_write_file_sync(args: Args, at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`writeFileSync` takes a path and its contents, and was given ${counted(args.len(), "argument")}")

    val path = path_of(args.at(0), at, "writeFileSync")?

    args.at(1) match
        Str(p) -> write_file_sync(path, p.s, at)
        other -> write_file_sync(path, printed(other, at)?, at)

// `appendFileSync(path, text)` -- `appendFile` for a program that is not on the loop.
//
// **Every operation `slate:fs` has answers under a `Sync` suffix, and this one did not.** The page
// says every one has a blocking twin, ten of them had, and the eleventh arrived with the promise
// half alone -- so a sink, which answers nothing and cannot await, had no way to write a line and
// know it had landed.
private do_append_file_sync(args: Args, at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`appendFileSync` takes a path and what to add, and was given ${counted(args.len(), "argument")}")

    val path = path_of(args.at(0), at, "appendFileSync")?

    args.at(1) match
        Str(p) -> append_file_sync(path, p.s, at)
        other -> append_file_sync(path, printed(other, at)?, at)

private do_rename_sync(args: Args, at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`renameSync` takes two paths and was given ${counted(args.len(), "argument")}")

    rename_sync(path_of(args.at(0), at, "renameSync")?, path_of(args.at(1), at, "renameSync")?, at)

private do_rename(args: Args, at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`rename` takes two paths and was given ${counted(args.len(), "argument")}")

    rename_promise(path_of(args.at(0), at, "rename")?, path_of(args.at(1), at, "rename")?, at)
