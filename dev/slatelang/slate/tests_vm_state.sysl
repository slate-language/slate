module dev.slatelang.slate
@tests

import sh.sysl.gc
import sh.sysl.libuv
import sysl.buf.{Buf, buf}
import sysl.fs.{entries, read_bytes}

// **`spawn` alone, never `current`**: `sysl.posix.threads` has a `current()` of its own -- the calling
// thread's handle -- and slate's `current()` is the VM this line of execution belongs to.
import sysl.posix.threads.spawn
import sysl.slices.sort_by
import sysl.text.{Search, from_utf8_unchecked, split, str_builder}

// The census that keeps the runtime's state inside `Vm`.
//
// **A MODULE-LEVEL `var` IS PER-PROCESS STATE, AND ONE ADDED WITHOUT A THOUGHT IS A SECOND VM THAT
// CANNOT EXIST.** That is what this file is for. The runtime's state was 473 module-level `var`s
// across fifty files -- one interpreter to a process by construction -- and `vm_state.sysl` is where
// the per-VM half of it now lives. Nothing stops the fifty files growing back except a number that
// somebody has to raise on purpose, which is exactly the arrangement
// `EVERY_PAGE_CARRIES_THE_BLOCKS_IT_IS_EXPECTED_TO` uses for the documentation.
//
// Every module-level `var` in the runtime is one of four things, and the test below counts each:
//
// - **the VM itself**, `the_vm` in `vm_state.sysl`, which is the one global that remains by design;
// - **a native's id**, `var n_<name>: NativeFn = 0`, recognised by its shape. `register` is
//   append-only and answers the first id for a name it already has, so an id never moves and two VMs
//   in one process would agree on every one of them;
// - **something marked `process-wide:`** in a comment above it, which says in the same breath why it
//   is not per-VM -- the collector's `Kind` tables, the native index, and the storage for the
//   program's own VM;
// - **a `var` still owed the move**, which is stage two's work and is written down per file below.
//
// A new global is none of the first three, so it lands in the fourth and fails this test until its
// file's number is raised -- and raising it is a decision rather than an accident.

// Where the runtime's source is, relative to the project root, which is where `sysl test .` runs.
private const RuntimeDir: string = "dev/slatelang/slate"

// What the marker says. A comment carrying this on the line above a declaration means "not per-VM,
// and here is why" -- the reason is in the same comment, which is the whole point of a marker that is
// prose rather than an annotation.
private const ProcessWide: string = "process-wide:"

// The `var`s not yet moved into `Vm`, as `file count`, in the order the directory sorts.
//
// **NONE OWED: STAGE TWO IS DONE.** Every module-level `var` that was per-VM state has moved into
// `Vm`. A file that grows a new global fails this test until it either moves into `Vm` too or earns
// a `process-wide:` marker saying why it does not have to.
private val StateOwed: string = ""

// How many of each kind there are. **The totals are pinned separately from the per-file list** so
// that a `var` moving between the classes is caught even where the file's own count did not change.
private const NativeHandles: usize = 377

// **THE ARENA IS GONE FROM THIS COUNT AND THAT IS WHAT STAGE THREE BOUGHT.** It was 14 while
// `obj.sysl` held a 256 MiB module array and the one `gc.Heap` over it; a VM `malloc`s its own block
// now, so both came out and `main_vm` -- the STORAGE for the program's own VM, which has to outlive
// everything -- went in. What is left is the eight `gc.Kind` tables, the native index's four, one
// for the storage, and none for a heap.
//
// **The fifteenth is the ACTOR TABLE**, which is process-wide for a reason of its own: a handle names
// an actor wherever it is carried -- into a third actor's heap, back to the program -- so what
// resolves one cannot be per-VM. See `actor_run.sysl`.
//
// **The sixteenth is the test HARNESS's own probe-name counter** (`probe_seq` in
// `tests_kit_cli.sysl`), one per `sysl test` process and unrelated to any VM the suite starts.
//
// **The seventeenth and eighteenth are the PROFILER's** (`profile_on` and `profile_tally` in
// `profile.sysl`). An instrument measures a process rather than a VM, and the flag in particular is
// read once per instruction in the hottest loop in the project -- reaching it through `current()`
// would put an indirection there to say something no two VMs in one process could disagree about.
private const ProcessWideGlobals: usize = 18

private const StateOwedTotal: usize = 0

// What one file's module-level `var`s came to.
private struct Counted
    // Declarations of the shape `var n_<name>: NativeFn = 0`.
    handles: usize

    // Declarations the line above marked `process-wide:`.
    marked: usize

    // Everything else, which is state a VM ought to own and does not yet.
    owed: usize

    // `the_vm`, which only `vm_state.sysl` has.
    the_vm: usize

// Every `.sysl` file of the runtime, sorted, so the census is a record of what the tree holds rather
// than of the order one machine's file system answered in.
private runtime_files() -> Buf[string]
    var names = entries(RuntimeDir).unwrap()
    var out: Buf[string] = buf()

    sort_by(names.view(), (a, b) -> a < b)

    for i in 0..<names.len()
        if names.at(i).ends_with(".sysl") then out.push(names.at(i))

    out
end runtime_files

// Read one file and put each of its module-level `var`s in a class.
//
// **A declaration is one that starts at the left margin**, which is what makes it module storage: a
// `var` inside a function is indented, and a `var` inside a struct is a field.
private counted_in(name: string) -> Counted
    val text = from_utf8_unchecked(read_bytes(s"${RuntimeDir}/${name}").unwrap())
    val lines = split(text, "\n")

    var out = Counted(0, 0, 0, 0)

    // **The marker is carried by the comment BLOCK above the declaration, not by the line above it.**
    // The reason a global is not per-VM takes a sentence or three to give, and asking for it on the
    // last line would push every author into writing the short version. So this remembers whether the
    // run of comments it is standing in has said it, and an ordinary line of code forgets again.
    var marked = false

    for i in 0..<lines.len
        val line = lines[i]

        if line.starts_with("//")
            if line.contains(ProcessWide) then marked = true

            continue

        // **An ATTRIBUTE stands on its own line between the comment and the declaration**, which is
        // where `@thread_local` sits above `the_vm`, so it is stepped over exactly as a comment is.
        // Resetting the marker here would lose the reason a process-wide global gave for being one.
        if line.starts_with("@") then continue

        if !line.starts_with("var ") && !line.starts_with("private var ")
            marked = false
            continue

        if line.contains(" the_vm: ")
            out.the_vm += 1
        elif line.ends_with(": NativeFn = 0") && line.starts_with("var n_")
            out.handles += 1
        elif marked
            out.marked += 1
        else
            out.owed += 1

        marked = false

    out
end counted_in

@test
THE_RUNTIMES_STATE_LIVES_IN_VM_AND_A_NEW_GLOBAL_HAS_TO_BE_ARGUED_FOR()
    val names = runtime_files()

    var owed_census = str_builder()
    var handles: usize = 0
    var marked: usize = 0
    var owed: usize = 0
    var the_vm: usize = 0

    for i in 0..<names.len()
        val c = counted_in(names.at(i))

        handles += c.handles
        marked += c.marked
        owed += c.owed
        the_vm += c.the_vm

        if c.owed > 0 then owed_census.push(s"${names.at(i)} ${c.owed}\n")

    // **The per-file list is what a reader acts on**, a file at a time being how the remaining work
    // is done -- so it is compared as text and a file that changed says which one it was.
    assert_eq(owed_census.finish(), StateOwed)

    assert_eq(owed, StateOwedTotal, "module-level `var`s still owed the move into `Vm`")
    assert_eq(handles, NativeHandles, "`n_<name>: NativeFn` ids, which are process-wide by design")
    assert_eq(marked, ProcessWideGlobals, "globals marked `process-wide:` with a reason beside them")

    // **The VM is ONE global and the test says so**, that being the whole claim: a second `var` in
    // `vm_state.sysl` would be state outside the struct, which is the thing this file exists to stop.
    assert_eq(the_vm, 1, "`the_vm`, the POINTER `current()` answers, and it is a `@thread_local` -- one copy per thread")

@test
A_VM_STARTS_EMPTY_AND_CURRENT_ANSWERS_THE_SAME_ONE_EVERY_TIME()
    // **`current()` is a pointer and two calls must name one thing**, or every converted site would be
    // writing to a copy and reading from the original -- which would fail as lost state rather than as
    // a compile error, so it is pinned here.
    reset_vm()
    current().output.push("written through one call")

    assert_eq(current().output.len(), 1, "and read back through another")

    // A fresh VM is a VM with nothing in it, which is what an actor would be spawned with.
    var fresh = new_vm(SmallCeiling)

    assert_eq(fresh.output.len(), 0)
    assert_eq(fresh.parked.len(), 0)
    assert_eq(fresh.outstanding, 0)
    assert_eq(fresh.generation, 0)
    assert_eq(fresh.registered_tests.len(), 0)
    assert_eq(fresh.hook_fns.len(), HookCount, "the four hook slots exist before anything is written")
    assert(!fresh.draws_seeded, "and the generator has not asked the kernel for anything")

    // **A block of its own, which is the thing a second VM could not have before.**
    assert(fresh.region != null, "and a heap block it owns")
    assert_eq(fresh.heap_ceiling, SmallCeiling)

    dispose_vm(&fresh)

    assert(fresh.region == null, "given back, so a VM that is done costs the process nothing")

    current().output.clear()

// -- a second VM -------------------------------------------------------------------------------------

// What a second VM in these tests is given. Four megabytes is enough to compile and run a small
// program and small enough that taking one costs nothing.
private const SmallCeiling: usize = 4194304

// A heap a program can fill, which is what `in_small_heap` has always used.
private const TinyCeiling: usize = 1048576

// A program that outgrows any heap it is given.
private const Greedy: string = "var kept = []\nfor i in 0..<40000\n    push(kept, { a: i, b: [i, i, i], c: \"x\" + string(i) })"

@test
A_SECOND_VM_RUNS_A_PROGRAM_OF_ITS_OWN_IN_THE_SAME_PROCESS()
    reset_vm()
    current().output.clear()
    current().output.push("what the first VM was holding")

    val modules_before = current().module_values.len()

    // **`live_size` is the witness and it is the sharp one.** A second VM sharing the one arena would
    // have `reset_heap`'d this heap out from under the first VM on its way in -- everything below
    // still passes, and this does not.
    val live_before = gc.live_size(slate_heap())

    var second = new_vm(SmallCeiling)
    val was = enter(&second)

    // The ordinary compile-and-drain path: `out` is `run`, which is what a program gets.
    val said = out("print(6 * 7)\nprint(\"from a VM of my own\")")

    leave(was)

    assert_eq(said, "42\nfrom a VM of my own")

    // And the first VM is exactly where it was left.
    assert_eq(current().output.len(), 1, "the first VM's output buffer is its own")
    assert_eq(current().output.at(0), "what the first VM was holding")
    assert_eq(current().module_values.len(), modules_before, "and so is its module table")
    assert_eq(gc.live_size(slate_heap()), live_before, "and nothing of its heap was collected or freed")

    dispose_vm(&second)
    current().output.clear()
end A_SECOND_VM_RUNS_A_PROGRAM_OF_ITS_OWN_IN_THE_SAME_PROCESS

@test
A_VM_WITH_A_SMALL_CEILING_FAULTS_ON_ITS_OWN_LIMIT_NOT_THE_PROCESS()
    reset_vm()
    current().output.clear()

    val ceiling_before = current().heap_ceiling
    val live_before = gc.live_size(slate_heap())

    var small = new_vm(TinyCeiling)
    val was = enter(&small)
    val said = fails(Greedy)

    leave(was)

    assert(said.contains("this program has run out of memory"),
        "a VM runs out of ITS OWN heap, with the ordinary sentence and not a crash")

    // **The ceiling is the block, so asking for more than the VM was spawned with is refused.**
    assert_eq(small.heap_ceiling, TinyCeiling)

    // And the process's own VM never heard about any of it.
    assert_eq(current().heap_ceiling, ceiling_before, "the first VM's block is the size it always was")
    assert_eq(gc.live_size(slate_heap()), live_before, "and nothing on it moved")

    dispose_vm(&small)

    // Which is proved by running a program on it afterwards.
    assert_eq(out("print(\"the first VM is still running\")"), "the first VM is still running")

    current().output.clear()
end A_VM_WITH_A_SMALL_CEILING_FAULTS_ON_ITS_OWN_LIMIT_NOT_THE_PROCESS

// -- and two of them at once, on two threads ---------------------------------------------------------

// How many bytes of a program's output the thread below carries back. Two short lines, and the
// assertion compares the whole of it, so a longer answer fails rather than being quietly cut.
private const SaidBytes: usize = 96

// What the second thread writes back through the address it was handed.
//
// **A fixed array of bytes and not a `string`, and that is the crossing rule rather than a
// preference.** A sysl string is reference counted and a count two threads touch is torn, so
// `spawn`'s `@crossing(arg)` looks through the pointer and refuses a state holding one. Plain bytes
// carry no count, and the reading back into a `string` happens on the thread that asserts.
private struct WhatTheOtherThreadSaw
    // Whether the body ran to its end. False where it never started, so a failure says which.
    ran: bool

    // How many of `said` are the program's output.
    said_len: usize

    // What the program on that thread printed.
    said: [SaidBytes]u8
end WhatTheOtherThreadSaw

// A second VM's whole life, on a thread of its own: its own loop, its own heap, its own program.
//
// **A `*extern` taking one address is the whole of what may cross** (`sysl.posix.threads.spawn`), so
// the program text is a literal written here rather than anything handed over.
private on_a_thread_of_its_own(state: *WhatTheOtherThreadSaw)
    // **A loop of its own, because libuv's default loop is the PROCESS's** and may be turned by one
    // thread at a time. This is the one thing a thread has to arrange before it enters a VM.
    val lp = libuv.new_loop().expect("a loop of this thread's own")

    var mine = new_vm(SmallCeiling, lp)
    val was = enter(&mine)

    // A timer, so that the drain this thread runs is its own loop's and not the main thread's.
    val said = out("setTimeout(() -> print(\"from the other thread\"), 1)\nprint(6 * 7)")

    leave(was)
    dispose_vm(&mine)
    lp.close().expect("the thread's loop closes with nothing left on it")

    val bytes = said.bytes
    var n: usize = 0

    while n < bytes.len && n < SaidBytes
        state.said[n] = bytes[n]
        n += 1

    state.said_len = n
    state.ran = true
end on_a_thread_of_its_own

@test
TWO_VMS_RUN_ON_TWO_THREADS_AT_ONCE_EACH_ON_ITS_OWN_HEAP_AND_LOOP()
    reset_vm()
    current().output.clear()

    // **The process-wide tables are built here on purpose, before the second thread exists.**
    // `register` is append-only and hands out a name's id on the first program that installs the
    // builtins, so two threads installing them at once would be two threads writing one `Map`. A
    // program run first makes every later `register` a read of a table nothing writes again.
    assert_eq(out("print(\"warm\")"), "warm")

    val ceiling_before = current().heap_ceiling
    val modules_before = current().module_values.len()

    var seen = WhatTheOtherThreadSaw(false, 0, [0u8; SaidBytes])
    var thread = spawn(&on_a_thread_of_its_own, &seen).unwrap()

    // Meanwhile, on this thread: this VM, this heap, the process's own loop, and a timer on it.
    val here = out("setTimeout(() -> print(\"from the main thread\"), 1)\nprint(1 + 1)")

    assert(thread.join(), "the second thread was waited for")

    assert_eq(here, "2\nfrom the main thread", "this thread's VM ran its own program")
    assert(seen.ran, "the second VM ran to the end on a thread of its own")
    assert_eq(from_utf8_unchecked(seen.said[0..<seen.said_len]), "42\nfrom the other thread",
        "and printed what ITS program printed, on its own heap and its own loop")

    // And this VM is exactly where it was left.
    assert_eq(current().heap_ceiling, ceiling_before, "the main VM's block is the size it always was")
    assert_eq(current().module_values.len(), modules_before, "and so is its module table")

    current().output.clear()
end TWO_VMS_RUN_ON_TWO_THREADS_AT_ONCE_EACH_ON_ITS_OWN_HEAP_AND_LOOP

// -- the allocator's free list ------------------------------------------------------------------

// An object shaped like `{ a: i, b: [i, i] }`, which is what a program building a throwaway record
// compiles to underneath: one `ObjectObj` and one nested `ArrayObj`, neither the size a promise is.
private garbage_object(i: long) -> Value
    var items: Buf[Value] = buf()

    items.push(Int(i))
    items.push(Int(i))

    val o = new_object()

    obj_put_name(o, "a", Int(i))
    obj_put_name(o, "b", Array(new_array(items)))
    Object(o)

// **gc 0.2.3 replaced a first-fit walk of one free list with size-segregated free lists, and this
// is the shape that told the two apart.** Sixty-eight thousand small records are built and left
// unrooted, so the sweep below frees every one of them into the free list(s) -- a hundred-plus
// thousand blocks, none the size the next phase asks for. Under a single first-fit list, an
// allocation of a DIFFERENT size had to walk past all of them before reaching a fit or the bump
// pointer; under size-segregated lists it only ever searches its own bucket.
@test
AN_ALLOCATION_AFTER_A_FRAGMENTING_SWEEP_EXAMINES_A_BOUNDED_NUMBER_OF_FREE_BLOCKS()
    reset_heap()
    reset_vm()

    var i: long = 0

    while i < 68000
        garbage_object(i)
        i += 1

    collect_now()

    val before = gc.alloc_steps(slate_heap())

    // Sixteen thousand promises, one per call -- what an `async` function's call allocates, and a
    // size neither `ObjectObj` nor `ArrayObj` is.
    var j = 0

    while j < 16000
        val p = new_promise()
        j += 1

    val walked = gc.alloc_steps(slate_heap()) - before
    val budget: usize = 16 * 16000

    assert(walked <= budget,
        "an allocation after the sweep examines a bounded number of free blocks, not the whole swept list")

    reset_vm()
end AN_ALLOCATION_AFTER_A_FRAGMENTING_SWEEP_EXAMINES_A_BOUNDED_NUMBER_OF_FREE_BLOCKS
