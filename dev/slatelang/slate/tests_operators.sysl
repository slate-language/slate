module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// Which instruction each operator emits, and that the machine's two-integer path answers what the
// general arithmetic answers.
//
// **THE OPERATOR IS PICKED WHILE THE PROGRAM IS COMPILED, so there are now two paths to every
// answer and nothing a program prints says which one it took.** `a + b` emits `Add`, whose arm
// adds two machine integers where it is handed two and hands everything else to `arith` -- so a
// fast path that disagreed with the general one about an overflow, a real, a big integer, a string
// or a divisor of zero would be a wrong answer that every existing test agrees with. These are the
// pairs that sit either side of that seam.
//
// **A SHAPE TEST AND AN ANSWER TEST ARE BOTH NEEDED AND NEITHER IS THE OTHER.** An emitter that
// gave `<` the `Greater` instruction would print the wrong thing and be caught below; an emitter
// that quietly went back to one instruction carrying a token would print exactly the right thing
// for ever.

// The instruction names of the chunk of that name, longest first.
//
// **The largest match is the real one**, which is `tests_bookkeeping.sysl`'s rule and its reason:
// `compile_module` compiles a file twice, so a top-level definition has two chunks of one name and
// the declarations-only copy holds a subset.
private op_names(program: string, name: string) -> Buf[string]
    out(program)

    var best: Buf[string] = buf()
    var found = false

    for i in 0..<running_unit().chunks.len()
        if running_unit().chunks.at(i).name != name then continue

        found = true

        val code = running_unit().chunks.at(i).code
        var names: Buf[string] = buf()

        for k in 0..<code.len()
            names.push(op_label(code.at(k).op))

        if names.len() > best.len() then best = names

    assert(found, s"no chunk is called `${name}`")
    best
end op_names

// How many of that instruction the chunk carries.
private counted(names: Buf[string], want: string) -> usize
    var n: usize = 0

    for i in 0..<names.len()
        if names.at(i) == want then n += 1

    n

// -- what each operator emits ---------------------------------------------------------------------

@test
AN_ARITHMETIC_OPERATOR_EMITS_THE_INSTRUCTION_NAMED_AFTER_IT()
    val names = op_names("f(a, b) =\n    print(a + b, a - b, a * b, a / b, a \\ b, a % b)\n\nf(7, 2)", "f")

    assert_eq(counted(names, "Add"), 1, "one `Add`")
    assert_eq(counted(names, "Sub"), 1, "one `Sub`")
    assert_eq(counted(names, "Mul"), 1, "one `Mul`")
    assert_eq(counted(names, "Div"), 1, "one `Div`")
    assert_eq(counted(names, "IntDiv"), 1, "one `IntDiv`")
    assert_eq(counted(names, "Rem"), 1, "one `Rem`")

    // **The instruction carrying a token is what this replaced**, so its absence is the half of the
    // claim an answer can never make.
    assert_eq(counted(names, "BinaryOp"), 0, "no instruction carries an operator token")

@test
A_COMPARISON_EMITS_THE_INSTRUCTION_NAMED_AFTER_IT()
    val names = op_names("f(a, b) =\n    print(a < b, a <= b, a > b, a >= b, a == b, a != b)\n\nf(1, 2)", "f")

    assert_eq(counted(names, "Less"), 1, "one `Less`")
    assert_eq(counted(names, "LessEq"), 1, "one `LessEq`")
    assert_eq(counted(names, "Greater"), 1, "one `Greater`")
    assert_eq(counted(names, "GreaterEq"), 1, "one `GreaterEq`")
    assert_eq(counted(names, "Equal"), 1, "one `Equal`")
    assert_eq(counted(names, "NotEqual"), 1, "one `NotEqual`")

@test
A_BITWISE_OPERATOR_AND_A_SHIFT_EMIT_THE_INSTRUCTION_NAMED_AFTER_THEM()
    val names = op_names("f(a, b) =\n    print(a & b, a | b, a ^ b, a << b, a >> b)\n\nf(6, 3)", "f")

    assert_eq(counted(names, "BitAnd"), 1, "one `BitAnd`")
    assert_eq(counted(names, "BitOr"), 1, "one `BitOr`")
    assert_eq(counted(names, "BitXor"), 1, "one `BitXor`")
    assert_eq(counted(names, "ShiftLeft"), 1, "one `ShiftLeft`")
    assert_eq(counted(names, "ShiftRight"), 1, "one `ShiftRight`")

@test
A_PREFIX_OPERATOR_EMITS_THE_INSTRUCTION_NAMED_AFTER_IT()
    val names = op_names("f(a) =\n    print(-a, !a, ~a)\n\nf(1)", "f")

    assert_eq(counted(names, "Negate"), 1, "one `Negate`")
    assert_eq(counted(names, "Not"), 1, "one `Not`")
    assert_eq(counted(names, "Complement"), 1, "one `Complement`")
    assert_eq(counted(names, "UnaryOp"), 0, "no instruction carries a prefix token")

@test
A_COMPOUND_ASSIGNMENT_AND_A_STEP_GO_THROUGH_THE_SAME_MAPPING()
    // **`+=` is not desugared into `x = x + e`**, so its operator reaches the emitter as a token of
    // its own and has to be turned into an instruction by the same function a written `+` uses.
    val names = op_names("f() =\n    var x = 1\n    x += 2\n    x <<= 1\n    x++\n    x\n\nf()", "f")

    // **An `Add` written straight into a local is an `AddStoreSlot`**, `fuse` in `emit.sysl` having
    // folded the store onto it -- so the question here is asked of the pair, which is still one
    // instruction per operator and still names the operator the program wrote.
    assert_eq(counted(names, "Add") + counted(names, "AddStoreSlot"), 2, "`+=` and `++` are both an `Add`")
    assert_eq(counted(names, "ShiftLeft"), 1, "`<<=` is a `ShiftLeft`")

@test
A_CHAIN_OF_COMPARISONS_EMITS_ONE_INSTRUCTION_PER_STEP()
    // A chain is ONE comparison with the middle operand evaluated once, and each step is still an
    // instruction named after the operator that step was written with.
    val names = op_names("f(a, b, c) =\n    a < b <= c\n\nf(1, 2, 3)", "f")

    // **A `Less` standing in front of a `JumpIfFalse` is a `LessJumpIfFalse`**, the two having been
    // folded into one dispatch by `fuse` in `emit.sysl`. The step is still one instruction named
    // after the operator it was written with, which is what this test is about.
    assert_eq(counted(names, "Less") + counted(names, "LessJumpIfFalse"), 1, "one `Less`")
    assert_eq(counted(names, "LessEq"), 1, "one `LessEq`")

// -- the fast path answers what the general arithmetic answers --------------------------------------

@test
TWO_MACHINE_INTEGERS_AND_A_PAIR_THAT_GREW_ANSWER_THE_SAME_ARITHMETIC()
    // Each line is the same sum twice: once where both sides fit a machine integer, and once where
    // the same numbers arrive one width up. The second is the path the instruction hands over.
    assert_eq(out("print(7 + 2, pow(10, 30) + 2 - pow(10, 30))"), "9 2")
    assert_eq(out("print(7 - 2, pow(10, 30) - 2 - pow(10, 30))"), "5 -2")
    assert_eq(out("print(7 * 2, (pow(10, 30) * 2) \\ pow(10, 30))"), "14 2")
    assert_eq(out("print(7 \\ 2, (pow(10, 30) + 7) \\ pow(10, 30))"), "3 1")
    assert_eq(out("print(7 % 2, (pow(10, 30) + 7) % pow(10, 30))"), "1 7")
    assert_eq(out("print(7 & 3, (pow(2, 70) + 7) & 3)"), "3 3")
    assert_eq(out("print(7 | 8, (pow(2, 70) | 8) - pow(2, 70))"), "15 8")
    assert_eq(out("print(7 ^ 2, (pow(2, 70) ^ 2) - pow(2, 70))"), "5 2")

@test
AN_OVERFLOWING_PAIR_OF_INTEGERS_GROWS_RATHER_THAN_WRAPPING()
    // **The wrapped answer is what the test is made of**, so a fast path that forgot to test it
    // would print the wrapped number here and nothing else would notice.
    assert_eq(out("print(9223372036854775807 + 1)"), "9223372036854775808")
    assert_eq(out("print(-9223372036854775807 - 2)"), "-9223372036854775809")
    assert_eq(out("print(4611686018427387904 * 2)"), "9223372036854775808")
    assert_eq(out("print(9223372036854775807 * 9223372036854775807)"),
        "85070591730234615847396907784232501249")
    assert_eq(out("print(1 << 100)"), "1267650600228229401496703205376")
    assert_eq(out("print(1 << 62, 1 << 63)"), "4611686018427387904 9223372036854775808")

@test
THE_MOST_NEGATIVE_INTEGER_IS_THE_EDGE_EVERY_ARM_HAS_TO_KEEP()
    // It has no positive twin, so negating it grows, dividing it by `-1` grows, and the remainder
    // of that division is zero and is answered rather than left to a hardware trap.
    val least = "val least = -9223372036854775807 - 1\n"

    assert_eq(out(least + "print(-least)"), "9223372036854775808")
    assert_eq(out(least + "print(least \\ -1)"), "9223372036854775808")
    assert_eq(out(least + "print(least % -1)"), "0")
    assert_eq(out(least + "print(least - 1)"), "-9223372036854775809")
    assert_eq(out(least + "print(~least)"), "9223372036854775807")

@test
A_DIVISOR_OF_ZERO_IS_THE_SAME_SENTENCE_FROM_THE_INSTRUCTION_AS_FROM_THE_ARITHMETIC()
    assert(fails("print(1 \\ 0)").contains("this divides by zero"))
    assert(fails("print(1 % 0)").contains("this takes a remainder by zero"))
    assert(fails("var n = 1\nn \\= 0").contains("this divides by zero"))
    assert(fails("var n = 1\nn %= 0").contains("this takes a remainder by zero"))

    // `/` is the one that does not fault, its answer being a real whatever it was handed.
    assert_eq(out("print(1 / 0, -1 / 0, 0 / 0)"), "Infinity -Infinity NaN")

@test
A_SHIFT_BY_A_COUNT_THE_FAST_PATH_REFUSES_KEEPS_ITS_OWN_SENTENCE()
    assert(fails("print(1 << -1)").contains("not negative, and this is by -1"))
    assert(fails("print(1 >> -1)").contains("not negative, and this is by -1"))
    assert(fails("print(1 << 99999999999)").contains("slate stops at"))

    // **A right shift past the width drags the sign down** rather than being refused, so the
    // boundary at sixty-three places is an answer and not an edge to guard.
    assert_eq(out("print(-8 >> 1, -8 >> 63, -8 >> 200, 8 >> 200)"), "-4 -1 -1 0")

@test
AN_INTEGER_MEETING_A_REAL_PROMOTES_THROUGH_EVERY_OPERATOR()
    assert_eq(out("print(1 + 2.5, 2.5 + 1, 1 - 2.5, 2.5 - 1)"), "3.5 3.5 -1.5 1.5")
    assert_eq(out("print(2 * 2.5, 2.5 * 2, 5 / 2.5, 2.5 / 5)"), "5 5 2 0.5")
    assert_eq(out("print(1 < 2.5, 2.5 < 1, 1 <= 1.0, 2.5 >= 2)"), "true false true true")

    // **An integer and a real that name one number are equal and are not the same kind**, which is
    // the pair the equality instruction's fast path must not answer for on its own.
    assert_eq(out("print(1 == 1.0, 1 != 1.0, 1.0 == 1)"), "true false true")

@test
EQUALITY_ANSWERS_FOR_EVERY_PAIR_THE_FAST_PATH_DOES_NOT_TAKE()
    // Two integers and two booleans are the pairs answered in the instruction; everything below is
    // handed to the structural comparison, and the absence rule is the one special case in it.
    assert_eq(out("print(1 == 1, 1 == 2, true == true, true == false)"), "true false true false")
    assert_eq(out("print([1, 2] == [1, 2], { a: 1 } == { a: 1 })"), "true true")
    assert_eq(out("print(\"ab\" == \"ab\", \"ab\" != \"ac\")"), "true true")
    assert_eq(out("print(null == undefined, null == 0, undefined != null)"), "true false false")
    assert_eq(out("print(pow(10, 30) == pow(10, 30), pow(10, 30) == 1)"), "true false")
    assert_eq(out("print(1 == true, true != 1)"), "false true")

@test
AN_OPERATOR_METHOD_IS_STILL_THE_LAST_THING_TRIED()
    // A class answers for the operator it names, and the instruction reaches it exactly where the
    // token used to: through the general arithmetic, after every pair of numbers has been ruled out.
    val money = "class Money\n    var cents\n\n    +(self, o) = Money(self.cents + o.cents)\n" +
        "    ==(self, o) = self.cents == o.cents\n    unary_-(self) = Money(-self.cents)\n" +
        "    <=>(self, o) = self.cents - o.cents\n\n"

    assert_eq(out(money + "print((Money(2) + Money(3)).cents)"), "5")
    assert_eq(out(money + "print(Money(2) == Money(2), Money(2) == Money(3))"), "true false")
    assert_eq(out(money + "print((-Money(2)).cents)"), "-2")
    assert_eq(out(money + "print(Money(1) < Money(2), Money(2) < Money(1))"), "true false")

@test
THE_SET_ALGEBRA_AND_A_STRING_JOIN_REACH_THE_SAME_ARMS_THEY_ALWAYS_DID()
    val sets = "val a = Set([1, 2, 3])\nval b = Set([2, 3, 4])\n"

    assert_eq(out(sets + "print(a | b, a & b, a - b, a ^ b)"), "[1, 2, 3, 4] [2, 3] [1] [1, 4]")
    assert_eq(out(sets + "print(a < b, Set([2]) < a, a == a)"), "false true true")

    // **`+` on two strings joins them**, which is the one arm of the arithmetic that is reached
    // before any number is looked at.
    assert_eq(out("print(\"a\" + \"b\", (\"a\" + \"b\").length)"), "ab 2")
    assert_eq(out("print(\"a\" < \"b\", \"b\" <= \"a\")"), "true false")

@test
AN_OPERATOR_THAT_APPLIES_TO_NEITHER_SIDE_SAYS_SO_NAMING_BOTH()
    assert(fails("print(1 + true)").contains("`+` does not apply to integer and boolean"))
    assert(fails("print(\"a\" - \"b\")").contains("`-` does not apply to string and string"))
    assert(fails("print(1 < \"a\")").contains("`<` does not apply to an integer and a string"))
    assert(fails("print(1.5 & 2)").contains("`&` works on whole numbers, and a real is not one"))
    assert(fails("print(-\"a\")").contains("`-` needs a number, and this is a string"))
    assert(fails("print(~\"a\")").contains("`~` needs a whole number, and this is a string"))
