module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.str_builder

// `split` gathers its pieces in the VM's `split_pieces` and makes the array once, at its size; and
// the collector finds the VM a tracer counts payload for from the heap it was handed, and walks an
// array's items as one view. `tests/lang/splitpieces.sl` asks both back ends what a split answers;
// these ask what only the interpreter can be asked -- the room, the charge, the buffer between calls,
// and a collection landing in the middle of one.

// A heap small enough that garbage made ahead of a split fills it and the split has to collect.
private const Crowded: usize = 262144
private const Roomy: usize = 268435456

// `split(text, sep)` through the registry, as a program's call reaches it.
private split_of(text: string, sep: string) -> *ArrayObj
    // A test runs in a process of its own, so the registry is empty until something installs it.
    if n_split == 0 then install_builtins(new_env(null))

    var args: Buf[Value] = buf()

    args.push(Str(new_str_scanned(text)))
    args.push(Str(new_str_scanned(sep)))

    call_native_buf(n_split, args, Span(0, 0)) match
        Ok(Array(p)) -> return p
        _ -> ()

    assert(false, "split answers an array")
    null
end split_of

private text_at(a: *ArrayObj, i: usize) -> string
    a.items.at(i) match
        Str(p) -> return p.s
        _ -> ()

    assert(false, "every piece is a string")
    ""
end text_at

// `n` fields of the given width, separated by commas.
private fields(n: usize, width: usize) -> string
    var out = str_builder()

    for i in 0..<n
        if i > 0 then out.push(",")

        for k in 0..<width
            out.push("f")

    out.finish()
end fields

@test
A_SPLIT_ANSWERS_AN_ARRAY_WITH_EXACTLY_ROOM_FOR_ITS_PIECES()
    reset_vm()
    reset_heap()

    val three = split_of("10,20,name7", ",")

    assert_eq(three.items.len(), 3usize)
    assert_eq(three.items.cap(), 3usize, "a line of three fields takes three slots, not eight")
    assert_eq(text_at(three, 2), "name7")

    val one = split_of("", ",")

    assert_eq(one.items.len(), 1usize)
    assert_eq(one.items.cap(), 1usize, "the empty text is one empty piece in one slot")

    val many = split_of(fields(20000, 2), ",")

    assert_eq(many.items.len(), 20000usize)
    assert_eq(many.items.cap(), 20000usize, "twenty thousand pieces take twenty thousand slots and no doubling's spare")
end A_SPLIT_ANSWERS_AN_ARRAY_WITH_EXACTLY_ROOM_FOR_ITS_PIECES

@test
THE_GATHERING_BUFFER_IS_EMPTY_BETWEEN_SPLITS_AND_KEEPS_ITS_ROOM()
    reset_vm()
    reset_heap()

    split_of(fields(100, 3), ",")

    val v = current()

    assert_eq(v.split_pieces.len(), 0usize, "nothing a split gathered is left behind it")
    assert(v.split_pieces.cap() >= 100, "the room it grew to is kept for the next call")

    val next = split_of("a;b", ";")

    assert_eq(next.items.len(), 2usize, "the next split sees only its own pieces")
    assert_eq(text_at(next, 0), "a")
    assert_eq(text_at(next, 1), "b")
    assert_eq(v.split_pieces.len(), 0usize)
end THE_GATHERING_BUFFER_IS_EMPTY_BETWEEN_SPLITS_AND_KEEPS_ITS_ROOM

@test
A_SPLIT_CHARGES_ITS_PIECES_AND_THE_SLOTS_THEY_TAKE_AND_NOTHING_MORE()
    reset_vm()
    reset_heap()

    if n_split == 0 then install_builtins(new_env(null))

    var args: Buf[Value] = buf()

    args.push(Str(new_str_scanned("10,20,abc")))
    args.push(Str(new_str_scanned(",")))

    val before = current().payload

    call_native_buf(n_split, args, Span(0, 0)) match
        Ok(Array(_)) -> ()
        _ -> assert(false, "split answers an array")

    // "10", "20" and "abc" are seven bytes, and the array is three `Value`s: not eight.
    assert_eq(current().payload - before, 7 + 3 * sizeof(Value))
end A_SPLIT_CHARGES_ITS_PIECES_AND_THE_SLOTS_THEY_TAKE_AND_NOTHING_MORE

@test
A_COLLECTION_IN_THE_MIDDLE_OF_A_SPLIT_KEEPS_EVERY_PIECE_IT_HAS_GATHERED()
    reset_vm()
    reset_heap()

    if n_split == 0 then install_builtins(new_env(null))

    reset_vm()
    set_heap_limit(Crowded)
    reset_heap()

    // Fill most of the heap with cells nothing holds, so the split's own allocations run out of room
    // part of the way through and `alloc_or_collect` collects while pieces are gathered.
    for i in 0..<1500
        new_str_scanned("garbage")

    val v = current()
    val collected = v.collections
    val mark = root_mark()
    val a = split_of(fields(1500, 9), ",")

    hold(Array(a))

    val during = v.collections - collected
    var whole = 0usize

    for i in 0..<a.items.len()
        if text_at(a, i) == "fffffffff" then whole += 1

    release(mark)
    set_heap_limit(Roomy)
    reset_heap()

    assert(during > 0, "the split collected at least once while it was gathering")
    assert_eq(whole, 1500usize, "and every piece it had gathered came through whole")
end A_COLLECTION_IN_THE_MIDDLE_OF_A_SPLIT_KEEPS_EVERY_PIECE_IT_HAS_GATHERED

@test
THE_VM_A_TRACER_COUNTS_FOR_IS_THE_ONE_THAT_OWNS_THE_HEAP()
    reset_vm()
    reset_heap()
    collect_now()

    assert(heap_owner(slate_heap()) == current(), "the program's own heap belongs to the program's own VM")

    val mine = current().payload
    var second = new_vm(Roomy)
    val was = enter(&second)

    assert(heap_owner(slate_heap()) == current(), "and a second VM's heap to that VM")

    val mark = root_mark()

    hold(Str(new_str_scanned(fields(1, 4000))))
    collect_now()

    val theirs = current().payload

    release(mark)
    leave(was)
    dispose_vm(&second)

    assert(theirs >= 4000, "the recount of the second VM's live string lands on the second VM")
    assert_eq(current().payload, mine, "and none of it on the program's own")
end THE_VM_A_TRACER_COUNTS_FOR_IS_THE_ONE_THAT_OWNS_THE_HEAP

@test
EVERY_ITEM_OF_A_LIVE_ARRAY_IS_MARKED_THROUGH_A_COLLECTION()
    reset_vm()
    reset_heap()

    val mark = root_mark()
    val a = new_array(buf())

    hold(Array(a))

    for i in 0..<5000
        array_push(a, Str(new_str_scanned(fields(1, 5) + str(i))))
        new_str_scanned("dropped")

    collect_now()
    collect_now()

    var whole = 0usize

    for i in 0..<a.items.len()
        if text_at(a, i) == "fffff" + str(i) then whole += 1

    release(mark)
    assert_eq(whole, 5000usize, "every string the array holds survives and reads as it was made")
end EVERY_ITEM_OF_A_LIVE_ARRAY_IS_MARKED_THROUGH_A_COLLECTION
