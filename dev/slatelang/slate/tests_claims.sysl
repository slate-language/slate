module dev.slatelang.slate
@tests

import sysl.text.Search

// A DEFINITION THAT SAYS `-> p is T`, `-> asserts p is T` OR `-> asserts p` NARROWS ITS ARGUMENT AT
// THE CALL, as TypeScript's explicit type predicates do (`claim.sysl`, `predicate.sysl`).
//
// Every narrowing below is paired with a refusal that shows the same program not narrowing where it
// may not, so a test that passed because nothing was ever narrowed could not pass here.

val ClaimUnnarrowed: string = "`keys` takes object | array here, and this is object | null"

// More than one statement, so nothing would be inferred from it: the annotation is all there is.
val ClaimThere: string = "there(m: object | null) -> m is object =\n    val ok = m != null\n    ok\n"

val ClaimSure: string = "sure(m: object | null) -> asserts m is object =\n    if m == null then throw \"none\"\n"

val ClaimBox: string = "type Box = { size: integer }\nisBox(v: Box | string) -> v is Box =\n    if !(v is object) then return false\n    v.size is integer\nneed(b: Box) = b.size\nshout(s: string) = upper(s)\n"

// -- `-> p is T` -------------------------------------------------------------------------------------

@test
A_PREDICATE_OF_MANY_STATEMENTS_NARROWS_WHERE_ITS_ANNOTATION_SAYS_SO()
    assert_eq(out(ClaimThere + "f(m: object | null) = if there(m) then keys(m).length else 0\nprint(f({ a: 1 }), f(null))"), "1 0")

    // The control: the same body with no annotation is no predicate at all.
    assert(fails("there(m: object | null)\n    val ok = m != null\n    ok\nf(m: object | null) = if there(m) then keys(m).length else 0\nprint(f(null))").contains(ClaimUnnarrowed))

@test
A_PREDICATE_IS_READ_BY_NOT_AN_EARLY_EXIT_AND_ASSERT_AS_AN_INLINE_TEST_IS()
    assert_eq(out(ClaimThere + "f(m: object | null) = if !there(m) then 0 else keys(m).length\nprint(f({ a: 1 }), f(null))"), "1 0")
    assert_eq(out(ClaimThere + "f(m: object | null)\n    if !there(m) then return 0\n    keys(m).length\nprint(f({ a: 1 }), f(null))"), "1 0")
    assert_eq(out(ClaimThere + "f(m: object | null)\n    assert(there(m))\n    keys(m).length\nprint(f({ a: 1, b: 2 }))"), "2")

@test
A_PREDICATE_AND_ANOTHER_TEST_NARROW_TOGETHER()
    assert_eq(out(ClaimThere + "f(m: object | null, n: object | null) = if there(m) && n != null then keys(m).length + keys(n).length else 0\nprint(f({ a: 1 }, { b: 1, c: 2 }), f(null, null))"), "3 0")

    // `&&` false says nothing about either.
    assert(fails(ClaimThere + "f(m: object | null, n: object | null) = if there(m) && n != null then 0 else keys(m).length\nprint(f(null, null))").contains(ClaimUnnarrowed))

@test
THE_ELSE_BRANCH_OF_A_PREDICATE_TAKES_ITS_TYPE_OUT_OF_A_UNION()
    // TypeScript's rule: false says the argument is not a `Box`, so `Box | string` is a string.
    assert_eq(out(ClaimBox + "f(v: Box | string) = if isBox(v) then need(v) else shout(v)\nprint(f({ size: 2 }), f(\"ab\"))"), "2 AB")

    // The control: with no test, neither side is known.
    assert(fails(ClaimBox + "f(v: Box | string) = if 1 == 1 then need(v) else 0\nprint(f(\"x\"))").contains("`need` takes { size: integer } here, and this is { size: integer } | string"))

@test
THE_ELSE_BRANCH_TAKES_NOTHING_AWAY_WHERE_THE_TYPE_IS_NOT_ONE_OF_THE_ALTERNATIVES()
    // `Box` is not an alternative of `object | string`, so false leaves both standing.
    val wide = "type Box = { size: integer }\nisBox(v: object | string) -> v is Box =\n    if !(v is object) then return false\n    v.size is integer\nshout(s: string) = upper(s)\n"

    assert(fails(wide + "f(v: object | string) = if isBox(v) then \"box\" else shout(v)\nprint(f(\"x\"))").contains("`shout` takes string here, and this is object | string"))

@test
AN_EXPLICIT_PREDICATE_WINS_OVER_WHAT_ITS_BODY_WOULD_BE_INFERRED_AS()
    // Inferred, `a && b` false says nothing; declared `-> v is object`, false takes `object` away.
    val takes = "takesArr(a: array) = a.length\n"
    val body = " = v != null && !(v is array)\n"
    val use = "f(v: object | array | null) = if isObj(v) then 0 elif v == null then -1 else takesArr(v)\nprint(f({}), f(null), f([1, 2]))"

    assert_eq(out(takes + "isObj(v: object | array | null) -> v is object" + body + use), "0 -1 2")
    assert(fails(takes + "isObj(v: object | array | null)" + body + use).contains("`takesArr` takes array here, and this is object | array"))

@test
A_PREDICATE_HANDED_A_PATH_NARROWS_THE_PATH_AND_AN_EARLIER_PATH_IS_STILL_ENDED_BY_THE_CALL()
    val held = ClaimThere + "f(s: string) -> object | null = if s == \"\" then null else { a: 1 }\nval o = { m: f(\"x\"), n: f(\"y\") }\n"

    assert_eq(out(held + "print(if there(o.m) then keys(o.m) else 0)"), "[\"a\"]")
    assert_eq(out(held + "print(if o.n != null && there(o.m) then keys(o.m) else 0)"), "[\"a\"]")
    assert(fails(held + "print(if o.n != null && there(o.m) then keys(o.n) else 0)").contains(ClaimUnnarrowed))

@test
A_val_ALIAS_OF_A_PREDICATE_IS_ONE_AND_A_SPREAD_CALL_IS_NOT()
    assert_eq(out(ClaimThere + "val alias = there\nf(m: object | null) = if alias(m) then keys(m).length else 0\nprint(f({ q: 1 }), f(null))"), "1 0")
    assert(fails(ClaimThere + "f(m: object | null) = if there(...[m]) then keys(m).length else 0\nprint(f(null))").contains(ClaimUnnarrowed))

@test
AN_IMPORTED_AND_A_RE_EXPORTED_CLAIM_NARROW_AS_THEY_DO_AT_HOME()
    assert_eq(ran_out("tests/mods/claim_uses.sl"), "3 4 5 -1 7")

// -- `-> asserts p is T` and `-> asserts p` ------------------------------------------------------------

@test
AN_ASSERTION_CALLED_AS_A_STATEMENT_NARROWS_THE_LINES_BELOW_IT()
    assert_eq(out(ClaimSure + "f(m: object | null)\n    sure(m)\n    keys(m).length\nprint(f({ a: 1, b: 2 }))"), "2")

    // A call that does not hold throws what the body throws, and the machine's check never sees it.
    val threw = fails(ClaimSure + "sure(null)")

    assert(threw.contains("none"))
    assert(!threw.contains("its claim"))

@test
A_BARE_asserts_NARROWS_BY_TRUTH()
    val given = "given(m: object | null) -> asserts m =\n    if !m then throw \"nothing\"\n"

    assert_eq(out(given + "f(m: object | null)\n    given(m)\n    keys(m).length\nprint(f({ a: 1 }))"), "1")
    assert(fails(given + "f(m: object | null)\n    keys(m).length\nprint(f({ a: 1 }))").contains(ClaimUnnarrowed))

@test
AN_ASSERTION_USED_AS_A_VALUE_NARROWS_NOTHING()
    // It answers nothing, so a test made of it proves nothing on either side.
    assert(fails(ClaimSure + "f(m: object | null) = if sure(m) then keys(m).length else 0\nprint(f({ a: 1 }))").contains(ClaimUnnarrowed))
    assert(fails(ClaimSure + "f(m: object | null)\n    val r = sure(m)\n    keys(m).length\nprint(f({ a: 1 }))").contains(ClaimUnnarrowed))

    // And a predicate called as a statement asserts nothing either.
    assert(fails(ClaimThere + "f(m: object | null)\n    there(m)\n    keys(m).length\nprint(f({ a: 1 }))").contains(ClaimUnnarrowed))

@test
AN_ASSERTION_HANDED_A_PATH_NARROWS_IT_AND_STILL_ENDS_A_PATH_NARROWED_BEFORE_IT()
    val held = ClaimSure + "f(s: string) -> object | null = if s == \"\" then null else { a: 1 }\nval o = { m: f(\"x\"), n: f(\"y\") }\n"

    assert_eq(out(held + "sure(o.m)\nprint(keys(o.m))"), "[\"a\"]")
    assert(fails(held + "if o.n != null\n    sure(o.m)\n    print(keys(o.n))").contains(ClaimUnnarrowed))

// -- what the definition is held to ------------------------------------------------------------------

@test
A_CLAIM_ABOUT_A_NAME_THAT_IS_NOT_A_PARAMETER_IS_REFUSED_AND_SAYS_WHICH_ARE()
    assert(fails("isText(v: string | integer) -> w is string = true").contains("`w` is not a parameter of `isText`, so `-> w is string` is about nothing a call hands over -- `isText` takes `v`"))
    assert(fails("ens(...xs) -> asserts xs = null").contains("`xs` gathers what is left over into an array"))

@test
A_CLAIMED_TYPE_THE_PARAMETER_CANNOT_HOLD_IS_REFUSED()
    assert(fails("isText(v: integer) -> v is string = true").contains("`v` is declared integer, and string is not one, so `v is string` could never be true"))
    assert(fails("ens(v: integer) -> asserts v is Usr = null").contains("`Usr` is not a type, so `-> asserts v is Usr` would narrow to nothing"))

    // A type the parameter may hold is accepted, a union's alternative and an unannotated one alike.
    assert_eq(out("isText(v: string | integer) -> v is string = v is string\nloose(v) -> v is string = v is string\nprint(isText(1), loose(\"a\"))"), "false true")

@test
A_PREDICATE_THAT_CAN_ANSWER_SOMETHING_OTHER_THAN_A_BOOLEAN_IS_REFUSED_WHERE_IT_DOES()
    val said = fails("p(v: integer) -> v is integer =\n    if v > 1 then return true\n    print(1)\n    \"s\"")

    assert(said.contains("`p` is a type predicate (`-> v is integer`), so every way out of it answers a boolean, and this one answers string"))
    assert(said.contains("4:5"))

@test
AN_ASSERTION_THAT_ANSWERS_A_VALUE_IS_REFUSED_AT_EVERY_PLACE_IT_DOES()
    val said = fails("ens(v: integer) -> asserts v is integer =\n    if v > 1 then return 3\n    v + 1")

    assert(said.contains("`ens` is an assertion (`-> asserts v is integer`), so it answers nothing, and this answers integer"))
    assert(said.contains("2:26"))
    assert(said.contains("3:5"))

    // A body ending in a guard, a print or a loop answers nothing anyone could read.
    assert_eq(out("ens(v: any) -> asserts v is string =\n    if !(v is string) then throw \"no\"\nens2(v: any) -> asserts v is string =\n    print(\"checked\")\nens(\"a\")\nens2(\"a\")"), "checked")

@test
AN_async_DEFINITION_CANNOT_BE_A_PREDICATE()
    assert(fails("async isText(v: any) -> v is string = v is string").contains("`isText` is `async`, so a call to it answers a promise"))

// -- both hosts --------------------------------------------------------------------------------------

@test
AN_EXPLICIT_CLAIM_IS_EMITTED_WITH_ITS_CHECK_AND_AN_INFERRED_PREDICATE_WITH_NONE()
    // An inferred predicate's body IS its test, so it is right by construction and costs nothing.
    assert(!js("f(v: any) = v is string\nprint(f(1))").contains("its claim"))
    assert(!js("f(v: any) -> boolean = v is string\nprint(f(1))").contains("its claim"))

    assert(js("f(v: any) -> v is string = v is string\nprint(f(1))").contains("its claim `v is string`"))
    assert(js("f(v: any) -> asserts v is string =\n    if !(v is string) then throw \"no\"\nf(\"a\")").contains("its claim `asserts v is string`"))

@test
BOTH_BACK_ENDS_RUN_A_PROGRAM_NARROWED_BY_CLAIMS_TO_THE_SAME_ANSWER()
    val program = ClaimThere + ClaimSure + "f(m: object | null) = if there(m) then keys(m).length else 0\ng(m: object | null)\n    sure(m)\n    keys(m).length\nprint(f({ a: 1, b: 2 }), f(null), g({ c: 3 }))"

    assert_eq(out(program), "2 0 1")
    assert_eq(node_said(program), "2 0 1")
