module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.fs.{entries, remove_file}
import sysl.process.{capture, Status}
import sysl.text.Search

// The differential corpus under `tests/js/` -- RUN, on both back ends, and diffed.
//
// **`tests_js.sysl` pins the emitted TEXT and this pins what the text DOES**, and the two find
// different things. A golden text test says the shape of the output is what it was yesterday; it
// cannot say whether the runtime the output calls into answers what the interpreter answers,
// because the runtime is a `raw"""` block that no expectation ever quotes. So a builtin could
// disagree with the interpreter in every program and every golden test would stay green.
//
// **One did.** `indexOf` answered `-1` where the interpreter answers `null`, for arrays and strings
// and for `lastIndexOf` too, so `xs.indexOf(v) != null` -- which is how a slate program asks whether
// something is there, slate having no out-of-band integer -- was true for a miss. What it broke was
// `slate-language/lath`'s `isVoid`: every tag was a void tag, so `html()` under node emitted an opening
// tag and stopped. Nothing in the compiler's own suite could have seen it.
//
// **The node side is a subprocess and the interpreter side is not.** `cli_said` runs slate in this
// process, which is the established idiom and is what every other driver here does; node has to be
// started. That asymmetry is not a compromise -- it is what makes the comparison worth anything,
// since two readings of one tree run by one mechanism would agree about a mistake they shared.

// The programs whose whole answer is what they print. `p9.sl` is left out on purpose: its exit
// status is half of what it is about and it calls `exit`, which in this process would take the
// suite with it. It stays a by-hand run, and `tests/js/README.md` says how.
val Runnable: []const string = ["p1.sl", "p2.sl", "p3.sl", "p4.sl", "p5.sl", "p6.sl", "p7.sl", "p8.sl", "p10.sl", "p11.sl", "p12.sl", "p13.sl"]

@test
NODE_IS_INSTALLED_SO_THE_DIFFERENTIAL_CORPUS_CAN_RUN()
    // **A harness that skips when its engine is missing is a harness that is green having run
    // nothing**, which is the failure this whole file exists to prevent, wearing a different hat. So
    // the absence of node is a failure with a sentence rather than a silent pass.
    capture("node", ["--version"], "", [], true) match
        Err(e) -> assert_eq(s"node could not be started: ${e} -- the JavaScript back end's differential corpus needs node on PATH", "")
        Ok(out) -> assert(out.status.ok())

@test
EVERY_PROGRAM_IN_THE_CORPUS_SAYS_THE_SAME_THING_ON_BOTH_BACK_ENDS()
    for i in 0..<Runnable.len
        val name = Runnable[i]

        assert_eq(differential(s"tests/js/${name}"), "")

@test
EVERY_RUNNABLE_FILE_IN_THE_CORPUS_IS_IN_THE_LIST()
    // **A program added to `tests/js/` and not to `Runnable` is a program nobody runs**, and the
    // list cannot be replaced by a walk while `p9.sl` has to stay out of it. So the walk checks the
    // list instead: it names what it found and is not covered, which is the one thing a written list
    // cannot notice about itself.
    val names = entries("tests/js").unwrap()
    var missing = ""

    for i in 0..<names.len()
        val name = names.at(i)

        if !name.ends_with(".sl") then continue
        if name == "p9.sl" || name == "wide.sl" then continue
        if covered(name) then continue

        missing = missing + name + " "

    assert_eq(missing, "")

private covered(name: string) -> bool
    for i in 0..<Runnable.len
        if Runnable[i] == name then return true

    false
end covered

// What the two back ends disagree about, or `""`. The interpreter runs in this process and the
// emitted program runs under node; the JavaScript is written beside the program it came from so
// that a failure leaves it there to look at, and removed when the two agree.
private differential(path: string) -> string
    val want = cli_said(["slate", path])
    val out_js = path + ".js"

    val wrote = cli_status(["slate", "js", path, "-o", out_js])

    if wrote != 0 then return s"${path}: `slate js` exited ${wrote}"

    val ran = capture("node", [out_js], "", [], true)

    ran match
        Err(e) -> s"${path}: node could not be started: ${e}"
        Ok(o) ->
            val got = o.text.trim()
            val errs = o.err.unwrap_or("")

            if !o.status.ok()
                s"${path}: node ${o.status} -- ${errs.trim()}"
            else if got != want.trim()
                s"${path}: the interpreter said\n${want.trim()}\n\nand node said\n${got}\n"
            else
                remove_file(out_js)
                ""
end differential
