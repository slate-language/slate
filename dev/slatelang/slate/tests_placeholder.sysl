module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// `_` where a value goes -- the desugaring, what refuses, and what the checker makes of it.
//
// **What a placeholder function DOES at run time is `tests/lang/placeholders.sl`**, where it runs on
// both back ends. What is here is what only the compiler can be asked: the tree the parser built,
// the sentence a `_` with nowhere to go draws, and the parameter the JavaScript back end writes.

// -- the tree ---------------------------------------------------------------------------------

@test
a_placeholder_becomes_a_lambda_over_the_argument_it_stands_in()
    // The same node a written lambda makes, so nothing downstream learns that `_` exists.
    assert_eq(good_tree("f(_ + 1)"), "(call f (fn((_1)) (+ (_1) 1)))")
    assert_eq(good_tree("f(x -> x + 1)"), "(call f (fn(x) (+ x 1)))")

@test
every_placeholder_is_a_parameter_of_its_own_left_to_right()
    assert_eq(good_tree("f(_.a - _.b)"), "(call f (fn((_1) (_2)) (- (. (_1) a) (. (_2) b))))")

@test
a_lone_placeholder_is_handed_to_the_scope_outside_it()
    // `g(_)` is a way of naming `g`, not a way of handing it an identity -- and the same rule is
    // what makes a partial application read as one.
    assert_eq(good_tree("f(g(_))"), "(call f (fn((_1)) (call g (_1))))")
    assert_eq(good_tree("f(g(_, 1))"), "(call f (fn((_1)) (call g (_1) 1)))")

@test
a_lone_placeholder_with_nothing_outside_it_is_the_identity()
    assert_eq(good_tree("val id = _"), "(val id (fn((_1)) (_1)))")

@test
brackets_a_binding_an_assignment_and_a_return_are_each_a_placeholder_scope()
    assert_eq(good_tree("f((_ + 1))"), "(call f (fn((_1)) (+ (_1) 1)))")
    assert_eq(good_tree("val d = _ * 2"), "(val d (fn((_1)) (* (_1) 2)))")
    assert_eq(good_tree("var f = 0\nf = _ * 2"), "(var f 0) (= f (fn((_1)) (* (_1) 2)))")
    assert_eq(good_tree("g() =\n    return _ * 2"),
        "(def g() (block (return (fn((_1)) (* (_1) 2)))))")

@test
a_named_argument_and_a_spread_are_scopes_like_any_other_argument()
    assert_eq(good_tree("f(b = _ + 1)"), "(call f (named b (fn((_1)) (+ (_1) 1))))")

// -- what is left alone -------------------------------------------------------------------------

@test
a_placeholder_in_a_pattern_is_still_the_wildcard()
    assert_eq(good_tree("v match\n    _ -> 1"), "(match v (_ (block 1)))")
    assert_eq(good_tree("val [_, b] = xs"), "(val [_ b] xs)")

@test
an_underscore_in_a_name_is_an_ordinary_name()
    assert_eq(good_tree("f(_x + __ + a_b)"), "(call f (+ (+ _x __) a_b))")

// -- the error path -------------------------------------------------------------------------------

@test
a_placeholder_with_no_scope_around_it_is_refused_and_points_at_itself()
    val said = good_tree("_.a")

    assert(said.contains("stands for the parameter of a function"))
    assert(said.contains("x -> x.length"))

@test
a_placeholder_does_not_escape_a_BLOCK_it_was_written_in()
    // A block is statements, and the check runs where each of them ends -- so a `_` in a lambda's
    // block body or in a match arm's belongs to that block and finds nothing there to be.
    assert(good_tree("f(x ->\n    _ + 1)").contains("stands for the parameter of a function"))
    assert(good_tree("v match\n    1 -> _").contains("stands for the parameter of a function"))

@test
a_placeholder_inside_an_interpolation_is_refused_where_it_stands()
    // A hole is a parser of its own, so nothing outside the string can be the function it wanted
    // to be a parameter of -- and saying so beats reaching the checker as an unbound name.
    assert(good_tree("f(s\"${_}\")").contains("stands for the parameter of a function"))

// -- the checker ----------------------------------------------------------------------------------

@test
a_placeholder_lambda_is_typed_exactly_as_the_written_one_is()
    assert_eq(out("h(ns: array of integer) = map(ns, _ * 2)\nprint(h([1, 2]))"), "[2, 4]")
    assert_eq(out("h(ns: array of integer) = map(ns, n -> n * 2)\nprint(h([1, 2]))"), "[2, 4]")

@test
a_placeholder_lambda_is_refused_where_the_written_one_would_be()
    assert(fails("h(ns: array of integer) = map(ns, _ + \"x\")")
        .contains("does not apply to integer and string"))

@test
TWO_PLACEHOLDERS_MAKE_A_FUNCTION_OF_TWO_PARAMETERS_AND_THE_CHECKER_SAYS_SO()
    // The surprise this feature has, caught where it is written rather than where it is called.
    // What a program wanting one parameter twice writes is `n -> n > 3 && n < 9`.
    assert(fails("print(filter([1, 5], _ > 3 && _ < 9))").contains("(integer, any) -> boolean"))

// -- the JavaScript back end ---------------------------------------------------------------------

@test
the_generated_parameter_is_a_name_no_program_could_have_written()
    val code = js("f(g) = g(1)\nprint(f(_ + 1))")

    assert(code.contains("function($_1)"))
