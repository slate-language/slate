module dev.slatelang.slate
@tests

// **Two of the three imports are gated with the tests that use them**, a build that counts no
// instructions having nothing here that wants a `Map` or a `Buf`.
#if feature_profile
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
#endif

import sysl.text.Search

// What `SLATE_PROFILE` counts, and that it counts nothing until it is asked to.
//
// **THE COUNTS ARE ASSERTED AS A LINEAR LAW RATHER THAN AS A NUMBER, and that is not a hedge.**
// How many instructions a loop of N turns runs is the emitter's business -- a peephole pass, a new
// `Op`, a different shape for `while` -- so a test carrying the constant would go red for a change
// that made slate faster and left the profiler perfectly correct. What the profiler PROMISES is that
// its counts are exact, and exactness is a thing a law can say: a loop of N turns costs a fixed
// preamble plus N times whatever one turn costs, so the counts at 50, 100 and 150 turns sit on a
// straight line, for every kind of instruction at once. A profiler that missed one instruction in a
// thousand, or counted an arm of the dispatch twice, breaks that, and no rewrite of the emitter can.

// **THE TWO INSTRUCTION-COUNT TESTS AND THEIR HELPERS ARE BEHIND THE SAME FEATURE THE COUNTING IS,
// and that is the cost of keeping the branch out of the shipped loop.** They run under `sysl test .
// --features profile`, which is a third shape of the gate beside `sysl test .` and `sysl test .
// --no-default-features`; everything below the `#endif` runs in every build, because everything else
// the instrument does is built into every build.
#if feature_profile

// Run a counted loop of `turns` turns under the profiler and answer what each kind came to.
//
// **`profile_stop` is called before anything is read**, so a test that fails does not leave the
// instrument on for every test after it -- which would fail nothing and slow the rest of the run.
private counting(turns: usize) -> Map[string, u64]
    profile_start()
    out(s"run()\n    var i = 0\n    var t = 0\n\n    while i < ${turns}\n        t = t + i * 2\n        i = i + 1\n\n    t\n\nprint(run())")
    profile_stop()

    var counts: Map[string, u64] = map()
    val labels = profile_op_labels()

    for i in 0..<labels.len()
        counts.put(labels.at(i), profile_op_count(labels.at(i)))

    counts
end counting

// Every kind either run named, so the law below is asked of the union rather than of one run's.
private every_kind(a: Map[string, u64], b: Map[string, u64]) -> Buf[string]
    var names: Buf[string] = buf()
    var seen: Map[string, bool] = map()
    var walk = a.walk()

    loop
        walk.next() match
            None -> break
            Some(pair) ->
                if !seen.has(pair.0)
                    seen.put(pair.0, true)
                    names.push(pair.0)

    var other = b.walk()

    loop
        other.next() match
            None -> break
            Some(pair) ->
                if !seen.has(pair.0)
                    seen.put(pair.0, true)
                    names.push(pair.0)

    names
end every_kind

@test
A_PROFILE_COUNTS_EVERY_INSTRUCTION_A_LOOP_RUNS_AND_COUNTS_IT_EXACTLY_ONCE()
    val fifty = counting(50)
    val hundred = counting(100)
    val hundred_fifty = counting(150)
    val kinds = every_kind(fifty, hundred_fifty)

    assert(kinds.len() > 0, "the profiler counted no instructions at all")

    for i in 0..<kinds.len()
        val label = kinds.at(i)
        val a = fifty.get_or(label, 0u64)
        val b = hundred.get_or(label, 0u64)
        val c = hundred_fifty.get_or(label, 0u64)

        assert(b >= a && c >= b, s"`${label}` fell as the loop grew: ${a}, ${b}, ${c}")

        if b >= a && c >= b
            assert_eq(c - b, b - a, s"`${label}` is not counted once per turn: ${a}, ${b}, ${c}")
end A_PROFILE_COUNTS_EVERY_INSTRUCTION_A_LOOP_RUNS_AND_COUNTS_IT_EXACTLY_ONCE

// The same loop again, answering what each adjacent PAIR came to.
private pairing(turns: usize) -> Map[string, u64]
    profile_start()
    out(s"run()\n    var i = 0\n    var t = 0\n\n    while i < ${turns}\n        t = t + i * 2\n        i = i + 1\n\n    t\n\nprint(run())")
    profile_stop()

    var counts: Map[string, u64] = map()
    val labels = profile_pair_labels()

    for i in 0..<labels.len()
        counts.put(labels.at(i), profile_pair_count(labels.at(i)))

    counts
end pairing

@test
A_PROFILE_COUNTS_AN_ADJACENT_PAIR_EXACTLY_ONCE_PER_TURN()
    // The law the file's first test is written against, asked of pairs: which pairs a turn runs is
    // the emitter's business and that fifty more turns run fifty more of each is the profiler's.
    val fifty = pairing(50)
    val hundred = pairing(100)
    val hundred_fifty = pairing(150)
    val kinds = every_kind(fifty, hundred_fifty)

    assert(kinds.len() > 0, "the profiler counted no adjacent pairs at all")

    for i in 0..<kinds.len()
        val label = kinds.at(i)
        val a = fifty.get_or(label, 0u64)
        val b = hundred.get_or(label, 0u64)
        val c = hundred_fifty.get_or(label, 0u64)

        assert(b >= a && c >= b, s"the pair `${label}` fell as the loop grew: ${a}, ${b}, ${c}")

        if b >= a && c >= b
            assert_eq(c - b, b - a, s"the pair `${label}` is not counted once per turn: ${a}, ${b}, ${c}")
end A_PROFILE_COUNTS_AN_ADJACENT_PAIR_EXACTLY_ONCE_PER_TURN

@test
NO_SEQUENCE_SPANS_A_RETURN_OR_IS_COUNTED_MORE_OFTEN_THAN_ITS_PARTS()
    profile_start()
    out("twice(n) = n * 2\n\nrun()\n    var i = 0\n    var t = 0\n\n    while i < 40\n        t = t + twice(i)\n        i = i + 1\n\n    t\n\nprint(run())")
    profile_stop()

    // **A `Ret` leaves the chunk it was written in**, so the instruction that runs after one is in
    // another activation at another `base` and the two are not a sequence anything could fuse. A walk
    // that read positions alone and not the frame would count one here, this program returning forty
    // times.
    val pairs = profile_pair_labels()
    var spanning = 0

    for i in 0..<pairs.len()
        if pairs.at(i).starts_with("Ret ") then spanning += 1

    assert(pairs.len() > 0, "the profiler counted no adjacent pairs at all")
    assert_eq(spanning, 0, "a pair was counted across a return")

    // **A sequence cannot have run more often than the instruction it begins with, nor a triple more
    // often than the pair it begins with.** A walk that forgot to reset its state, or that counted a
    // triple where only one of the two steps was adjacent, breaks both.
    val kinds = profile_op_labels()
    val triples = profile_triple_labels()

    assert(triples.len() > 0, "the profiler counted no adjacent triples at all")

    for i in 0..<pairs.len()
        val label = pairs.at(i)

        for k in 0..<kinds.len()
            if label.starts_with(s"${kinds.at(k)} ")
                assert(profile_pair_count(label) <= profile_op_count(kinds.at(k)),
                       s"the pair `${label}` ran more often than `${kinds.at(k)}`")

    for i in 0..<triples.len()
        val label = triples.at(i)

        for k in 0..<pairs.len()
            if label.starts_with(s"${pairs.at(k)} ")
                assert(profile_triple_count(label) <= profile_pair_count(pairs.at(k)),
                       s"the triple `${label}` ran more often than `${pairs.at(k)}`")
end NO_SEQUENCE_SPANS_A_RETURN_OR_IS_COUNTED_MORE_OFTEN_THAN_ITS_PARTS

@test
A_PAIR_THAT_BEGINS_WITH_A_FUSED_INSTRUCTION_IS_COUNTED()
    // **A fused instruction stands for more than one slot**, so the instruction that runs after it
    // sits two or more past it rather than one -- and a walk that asked only "one past the last" read
    // every such successor as a jump landing and counted no pair at all. `op_width` is what says how
    // far a fused instruction reaches; `n + 1` is a `LoadSlotInt` and the `+` after it is the pair.
    profile_start()
    out("run(n) =\n    var t = 0\n    var i = 0\n\n    while i < 30\n        t = (n + 1) * t\n        i = i + 1\n\n    t\n\nprint(run(1))")
    profile_stop()

    assert_eq(profile_pair_count("LoadSlotInt Add"), 30u64, "the pair after a folded load was not counted once per turn")
end A_PAIR_THAT_BEGINS_WITH_A_FUSED_INSTRUCTION_IS_COUNTED

@test
A_PROFILE_COUNTS_A_LOOPS_OWN_ARITHMETIC_ONCE_PER_TURN()
    val hundred = counting(100)
    val hundred_fifty = counting(150)

    // How many additions one turn of this loop runs is the emitter's business; that fifty more turns
    // run a whole multiple of fifty more of them is the profiler's promise. **Both names are read**,
    // an addition written straight into a local being an `AddStoreSlot` since the pairs were fused --
    // which is exactly the kind of emitter change the counts here may not be written against.
    val before = hundred.get_or("Add", 0u64) + hundred.get_or("AddStoreSlot", 0u64)
    val after = hundred_fifty.get_or("Add", 0u64) + hundred_fifty.get_or("AddStoreSlot", 0u64)
    val grew = after - before

    assert(grew > 0u64, "a longer loop ran no more arithmetic")
    assert_eq(grew % 50u64, 0u64, s"`Add` grew by ${grew} over fifty extra turns")
end A_PROFILE_COUNTS_A_LOOPS_OWN_ARITHMETIC_ONCE_PER_TURN

// Every instruction a program ran under the profiler, over every kind.
private ran_in_all(program: string) -> u64
    profile_start()
    out(program)
    profile_stop()

    var n = 0u64
    val labels = profile_op_labels()

    for i in 0..<labels.len()
        n += profile_op_count(labels.at(i))

    n
end ran_in_all

// `bench/globals.sl`'s loop at the top of a file, and the same loop as a function's body.
private top_loop(turns: usize) -> string = s"var t = 0\nvar i = 0\n\nwhile i < ${turns}\n    t = t + i * 2 - 1\n    i = i + 1\n\nprint(t)"

private function_loop(turns: usize) -> string = s"run()\n    var t = 0\n    var i = 0\n\n    while i < ${turns}\n        t = t + i * 2 - 1\n        i = i + 1\n\n    t\n\nprint(run())"

@test
A_LOOP_AT_THE_TOP_OF_A_FILE_RUNS_NO_MORE_INSTRUCTIONS_A_TURN_THAN_IN_A_FUNCTION()
    // **What a turn costs is asserted against the same loop in a function, not as a number**, for
    // the reason at the top of this file: a module-level `var` is a cell where a local is a slot, and
    // the loop over cells folds into the same runs, so fifty more turns cost no more at the top of a
    // file than inside a function.
    val top = (ran_in_all(top_loop(150)) - ran_in_all(top_loop(100))) / 50u64
    val inside = (ran_in_all(function_loop(150)) - ran_in_all(function_loop(100))) / 50u64

    assert(top > 0u64, "a longer loop at the top of a file ran no more instructions")
    assert(top <= inside, s"a turn at the top of a file ran ${top} instructions and in a function ${inside}")

    // The head, the tail and the difference each run once a turn -- the head once more, to leave --
    // and no write to either variable goes through the unfused `StoreCell`.
    profile_start()
    out(top_loop(100))
    profile_stop()

    assert_eq(profile_op_count("TickCellIntLess"), 101u64)
    assert_eq(profile_op_count("CellIntAddStoreJump"), 100u64)
    assert_eq(profile_op_count("SubStoreCell"), 100u64)
    assert_eq(profile_op_count("StoreCell"), 0u64)
end A_LOOP_AT_THE_TOP_OF_A_FILE_RUNS_NO_MORE_INSTRUCTIONS_A_TURN_THAN_IN_A_FUNCTION

#endif

@test
A_PROFILE_COUNTS_A_BUILTIN_ONCE_PER_CALL()
    profile_start()
    out("run()\n    var i = 0\n\n    while i < 300\n        abs(-1)\n        i = i + 1\n\n    i\n\nprint(run())")
    profile_stop()

    assert_eq(profile_call_count("abs"), 300u64)
end A_PROFILE_COUNTS_A_BUILTIN_ONCE_PER_CALL

// **A property read is counted under the builtin's own name, exactly as a call is.** `length` is
// `NLen`, so `xs.length` charges `length` once per read -- `standing_property` brackets the whole
// read itself rather than going through `call_native`, and this is what says the count survived that.
@test
A_PROPERTY_READ_UNDER_SLATE_PROFILE_COUNTS_AS_ITS_BUILTIN()
    profile_start()
    val printed = out("run()\n    val xs = [0, 1, 2]\n    var i = 0\n    var total = 0\n\n    while i < 300\n        total = total + xs.length\n        i = i + 1\n\n    total\n\nprint(run())")
    profile_stop()

    assert_eq(printed, "900")
    assert_eq(profile_call_count("length"), 300u64)
end A_PROPERTY_READ_UNDER_SLATE_PROFILE_COUNTS_AS_ITS_BUILTIN

@test
PROFILING_IS_OFF_UNTIL_SOMETHING_ASKS_FOR_IT()
    // A claim about the instrument's default, and a check that nothing above left it on.
    assert(!profiling())

    profile_start()
    profile_stop()

    val nothing = profile_steps()

    assert_eq(nothing, 0u64, "starting and stopping the profiler counted something")

    // A program run with the instrument off moves no counter at all.
    out("print(1 + 1)")

    assert_eq(profile_steps(), 0u64, "a program ran instructions into a profile nobody asked for")
    assert(!profiling())
end PROFILING_IS_OFF_UNTIL_SOMETHING_ASKS_FOR_IT

@test
A_PROFILE_REPORT_NAMES_THE_INSTRUCTIONS_AND_THE_BUILTINS_IT_COUNTED()
    profile_start()
    out("print(abs(-1) + 1)")
    profile_stop()

    val said = profile_report()

    assert(said.contains("slate profile"), said)
    assert(said.contains("instructions"), said)
    assert(said.contains("collections"), said)
    assert(said.contains("abs"), said)

    // **The peak is on the report beside the count**, because the count says how often the schedule
    // fired and only the peak says what it let stand.
    assert(said.contains("heap high water"), said)

    // **A build that does not count instructions SAYS SO**, rather than printing an empty table --
    // which reads as a program that ran none and sends the reader to look at their own program.
    if CountingInstructions
        assert(said.contains("Add"), said)

        // The two tables a superinstruction is chosen from ride with the per-kind one.
        assert(said.contains("adjacent pairs"), said)
        assert(said.contains("adjacent triples"), said)
    else
        assert(said.contains("not counted in this build"), said)
end A_PROFILE_REPORT_NAMES_THE_INSTRUCTIONS_AND_THE_BUILTINS_IT_COUNTED
