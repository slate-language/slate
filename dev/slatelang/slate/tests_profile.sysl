module dev.slatelang.slate
@tests

// **Two of the three imports are gated with the tests that use them**, a build that counts no
// instructions having nothing here that wants a `Map` or a `Buf`.
#if feature_profile
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
#endif

import sysl.text.Search

// What `SLATE_PROFILE` counts, and that it counts nothing until it is asked to.
//
// **THE COUNTS ARE ASSERTED AS A LINEAR LAW RATHER THAN AS A NUMBER, and that is not a hedge.**
// How many instructions a loop of N turns runs is the emitter's business -- a peephole pass, a new
// `Op`, a different shape for `while` -- so a test carrying the constant would go red for a change
// that made slate faster and left the profiler perfectly correct. What the profiler PROMISES is that
// its counts are exact, and exactness is a thing a law can say: a loop of N turns costs a fixed
// preamble plus N times whatever one turn costs, so the counts at 50, 100 and 150 turns sit on a
// straight line, for every kind of instruction at once. A profiler that missed one instruction in a
// thousand, or counted an arm of the dispatch twice, breaks that, and no rewrite of the emitter can.

// **THE TWO INSTRUCTION-COUNT TESTS AND THEIR HELPERS ARE BEHIND THE SAME FEATURE THE COUNTING IS,
// and that is the cost of keeping the branch out of the shipped loop.** They run under `sysl test .
// --features profile`, which is a third shape of the gate beside `sysl test .` and `sysl test .
// --no-default-features`; everything below the `#endif` runs in every build, because everything else
// the instrument does is built into every build.
#if feature_profile

// Run a counted loop of `turns` turns under the profiler and answer what each kind came to.
//
// **`profile_stop` is called before anything is read**, so a test that fails does not leave the
// instrument on for every test after it -- which would fail nothing and slow the rest of the run.
private counting(turns: usize) -> Map[string, u64]
    profile_start()
    out(s"run()\n    var i = 0\n    var t = 0\n\n    while i < ${turns}\n        t = t + i * 2\n        i = i + 1\n\n    t\n\nprint(run())")
    profile_stop()

    var counts: Map[string, u64] = map()
    val labels = profile_op_labels()

    for i in 0..<labels.len()
        counts.put(labels.at(i), profile_op_count(labels.at(i)))

    counts
end counting

// Every kind either run named, so the law below is asked of the union rather than of one run's.
private every_kind(a: Map[string, u64], b: Map[string, u64]) -> Buf[string]
    var names: Buf[string] = buf()
    var seen: Map[string, bool] = map()
    var walk = a.walk()

    loop
        walk.next() match
            None -> break
            Some(pair) ->
                if !seen.has(pair.0)
                    seen.put(pair.0, true)
                    names.push(pair.0)

    var other = b.walk()

    loop
        other.next() match
            None -> break
            Some(pair) ->
                if !seen.has(pair.0)
                    seen.put(pair.0, true)
                    names.push(pair.0)

    names
end every_kind

@test
A_PROFILE_COUNTS_EVERY_INSTRUCTION_A_LOOP_RUNS_AND_COUNTS_IT_EXACTLY_ONCE()
    val fifty = counting(50)
    val hundred = counting(100)
    val hundred_fifty = counting(150)
    val kinds = every_kind(fifty, hundred_fifty)

    assert(kinds.len() > 0, "the profiler counted no instructions at all")

    for i in 0..<kinds.len()
        val label = kinds.at(i)
        val a = fifty.get_or(label, 0u64)
        val b = hundred.get_or(label, 0u64)
        val c = hundred_fifty.get_or(label, 0u64)

        assert(b >= a && c >= b, s"`${label}` fell as the loop grew: ${a}, ${b}, ${c}")

        if b >= a && c >= b
            assert_eq(c - b, b - a, s"`${label}` is not counted once per turn: ${a}, ${b}, ${c}")
end A_PROFILE_COUNTS_EVERY_INSTRUCTION_A_LOOP_RUNS_AND_COUNTS_IT_EXACTLY_ONCE

@test
A_PROFILE_COUNTS_A_LOOPS_OWN_ARITHMETIC_ONCE_PER_TURN()
    val hundred = counting(100)
    val hundred_fifty = counting(150)

    // How many `BinaryOp`s one turn of this loop runs is the emitter's business; that fifty more
    // turns run a whole multiple of fifty more of them is the profiler's promise.
    val grew = hundred_fifty.get_or("BinaryOp", 0u64) - hundred.get_or("BinaryOp", 0u64)

    assert(grew > 0u64, "a longer loop ran no more arithmetic")
    assert_eq(grew % 50u64, 0u64, s"`BinaryOp` grew by ${grew} over fifty extra turns")
end A_PROFILE_COUNTS_A_LOOPS_OWN_ARITHMETIC_ONCE_PER_TURN

#endif

@test
A_PROFILE_COUNTS_A_BUILTIN_ONCE_PER_CALL()
    profile_start()
    out("run()\n    var i = 0\n\n    while i < 300\n        abs(-1)\n        i = i + 1\n\n    i\n\nprint(run())")
    profile_stop()

    assert_eq(profile_call_count("abs"), 300u64)
end A_PROFILE_COUNTS_A_BUILTIN_ONCE_PER_CALL

@test
PROFILING_IS_OFF_UNTIL_SOMETHING_ASKS_FOR_IT()
    // A claim about the instrument's default, and a check that nothing above left it on.
    assert(!profiling())

    profile_start()
    profile_stop()

    val nothing = profile_steps()

    assert_eq(nothing, 0u64, "starting and stopping the profiler counted something")

    // A program run with the instrument off moves no counter at all.
    out("print(1 + 1)")

    assert_eq(profile_steps(), 0u64, "a program ran instructions into a profile nobody asked for")
    assert(!profiling())
end PROFILING_IS_OFF_UNTIL_SOMETHING_ASKS_FOR_IT

@test
A_PROFILE_REPORT_NAMES_THE_INSTRUCTIONS_AND_THE_BUILTINS_IT_COUNTED()
    profile_start()
    out("print(abs(-1) + 1)")
    profile_stop()

    val said = profile_report()

    assert(said.contains("slate profile"), said)
    assert(said.contains("instructions"), said)
    assert(said.contains("collections"), said)
    assert(said.contains("abs"), said)

    // **The peak is on the report beside the count**, because the count says how often the schedule
    // fired and only the peak says what it let stand.
    assert(said.contains("heap high water"), said)

    // **A build that does not count instructions SAYS SO**, rather than printing an empty table --
    // which reads as a program that ran none and sends the reader to look at their own program.
    if CountingInstructions
        assert(said.contains("BinaryOp"), said)
    else
        assert(said.contains("not counted in this build"), said)
end A_PROFILE_REPORT_NAMES_THE_INSTRUCTIONS_AND_THE_BUILTINS_IT_COUNTED
