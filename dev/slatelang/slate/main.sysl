module dev.slatelang.slate

import sh.sysl.parsing.{Source, source}
import sysl.buf.{Buf, buf}
import sysl.fs.{entries, is_dir, read_bytes}
import sysl.text.str_builder

// Running a slate program, and running its tests.
//
// The driver's whole job is deciding where the text comes from and where the report goes. Reading
// the program and running it are the language's, and neither knows anything about a file or a
// terminal -- which is what lets the whole of `slate/` be exercised by tests that touch no disk.
//
// **Both halves of that job are parameters here rather than assumptions.** `run_cli` is handed the
// arguments and a place to say things, and answers what the shell should hear; `main` is the six
// lines that bind those to the real ones. That is what makes the driver's own decisions -- which
// subcommand, what counts as failure, what status a shell is told -- reachable from a test, which
// they were not while it printed straight to the terminal and answered nothing.

// What the shell hears. **Three outcomes and not two**, because a shell script that has to react
// wants to tell "slate ran your program and it failed" from "slate could not work out what you
// asked for" -- the first is the program's news and the second is the script's own bug.
val Fine: int = 0
val Failed: int = 1
val Misused: int = 2

main(args: []string)
    val code = run_cli(args, line -> print(line))

    // **A driver that always exits 0 cannot be driven.** slate rendered its diagnostics and then
    // told every shell, `make`, CI step and `&&` that everything had gone well -- so a failing
    // `slate test` was indistinguishable from a passing one to anything but a human reading the
    // output. `exit` is only reached for a non-zero status so that the ordinary path still leaves
    // through the end of `main`.
    if code != Fine then exit(code)
end main

// The whole of the command line: what was asked for, where the answer goes, and what it came to.
run_cli(args: []string, say: string -> unit) -> int
    if args.len < 2
        say("usage: slate <program.sl>")
        say("       slate test [path]")

        return Misused
    end if

    if args[1] == "test" then return test_command(if args.len > 2 then args[2] else ".", say)

    run_program(args[1], say)
end run_cli

// -- slate <program.sl> ----------------------------------------------------------------------------

private run_program(path: string, say: string -> unit) -> int
    read_bytes(path) match
        Err(e) ->
            say(s"slate: cannot read ${path}: ${e}")

            Failed
        Ok(bytes) ->
            val src = source(path, bytes)
            val r = run(src)

            for i in 0..<r.output.len()
                say(r.output.at(i))

            // **`r.render()` and not `r.report.render(src)`**: a program is as many files as it
            // imports, and each complaint has to be drawn against the one it is about.
            if r.ok() then return Fine

            say(r.render())

            Failed
end run_program

// -- slate test ------------------------------------------------------------------------------------

// `slate test [path]` -- every `@test` in a file, or in every `.sl` file under a directory.
//
// **Each file is run as an entry of its own**, which is what stops a test file that imports the
// module it tests from running that module's tests a second time. Only the file being pointed at
// registers its tests; an imported one contributes its code and none of its verdicts.
private test_command(root: string, say: string -> unit) -> int
    var files: Buf[string] = buf()

    gather(root, &files)

    // **Finding nothing to run is a failure and not a quiet success.** The usual cause is a path
    // that is wrong, and a test step that passes because it tested nothing is the worst outcome
    // available to it.
    if files.len() == 0
        say(s"slate: no .sl files under ${root}")

        return Failed
    end if

    var passed: usize = 0
    var failed: usize = 0
    var unloadable: usize = 0

    for i in 0..<files.len()
        val path = files.at(i)

        read_bytes(path) match
            Err(e) ->
                unloadable += 1
                say(s"  FAIL  ${path}")
                say(s"        cannot read it: ${e}")
            Ok(bytes) ->
                val t = run_tests(source(path, bytes))

                if t.report != ""
                    unloadable += 1
                    say(s"  FAIL  ${path}")
                    indented(t.report, say)
                else
                    passed += t.passed()
                    failed += t.failed()
                    say_results(path, t, say)

    say("")

    if failed == 0 && unloadable == 0
        say(s"${passed} passed")

        return Fine
    end if

    say(s"${passed} passed, ${failed + unloadable} failed")

    Failed
end test_command

// One file's verdicts, with the file named only where it has something to say.
private say_results(path: string, t: Tested, say: string -> unit)
    for i in 0..<t.results.len()
        val r = t.results.at(i)

        if r.ok
            say(s"  ok    ${path} :: ${r.name}   ${r.ms}ms")
        else
            say(s"  FAIL  ${path} :: ${r.name}   ${r.ms}ms")

            if r.printed != "" then indented(r.printed, say)

            indented(r.said, say)
end say_results

// A block of text, moved right so that it reads as belonging to the line above it.
private indented(text: string, say: string -> unit)
    var line = str_builder()

    for i in 0..<text.bytes.len
        if text.bytes[i] == u8('\n')
            say(s"        ${line.finish()}")
            line = str_builder()
        else
            line.push_char(char(u32(text.bytes[i])))

    val last = line.finish()

    if last != "" then say(s"        ${last}")
end indented

// Every `.sl` file at or under a path, in the order the file system gives them.
//
// **A directory that cannot be read is skipped rather than fatal.** What is being asked for is the
// tests that can be run, and a directory nobody can open has none -- reporting it as a failure would
// make `slate test .` fail on a tree with an unreadable corner nothing was testing.
private gather(root: string, out: *Buf[string])
    // **A file named outright is taken whatever it is called.** The `.sl` filter is for deciding
    // what to walk INTO, not for arguing with somebody who has pointed at a file.
    if !is_dir(root)
        out.push(root)
        return
    end if

    entries(root) match
        Err(_) -> ()
        Ok(names) ->
            for i in 0..<names.len()
                val name = names.at(i)

                // Nothing under a dot directory: `.git` is the one that matters and there is no
                // reason to walk any of them.
                if name.bytes.len > 0 && name.bytes[0] != u8('.')
                    val child = if root == "." then name else s"${root}/${name}"

                    if is_dir(child) then gather(child, out) elif ends_with_sl(child) then out.push(child)
end gather

private ends_with_sl(path: string) -> bool
    val b = path.bytes

    b.len > 3 && b[b.len - 3] == u8('.') && b[b.len - 2] == u8('s') && b[b.len - 1] == u8('l')
