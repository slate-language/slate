module dev.slatelang.slate

import sh.sysl.libuv.{mkdtemp_sync}
import sh.sysl.parsing.{Source, source, source_of}
import sysl.buf.{Buf, buf}
import sysl.fs.{entries, is_dir, read_bytes, remove_dir_all, write_text}
import sysl.process.{capture}
import sysl.text.{from_utf8_unchecked, str_builder, Search}

// Running a slate program, and running its tests.
//
// The driver's whole job is deciding where the text comes from and where the report goes. Reading
// the program and running it are the language's, and neither knows anything about a file or a
// terminal -- which is what lets the whole of `slate/` be exercised by tests that touch no disk.
//
// **Both halves of that job are parameters here rather than assumptions.** `run_cli` is handed the
// arguments and a place to say things, and answers what the shell should hear; `main` is the six
// lines that bind those to the real ones. That is what makes the driver's own decisions -- which
// subcommand, what counts as failure, what status a shell is told -- reachable from a test, which
// they were not while it printed straight to the terminal and answered nothing.

// What the shell hears. **Three outcomes and not two**, because a shell script that has to react
// wants to tell "slate ran your program and it failed" from "slate could not work out what you
// asked for" -- the first is the program's news and the second is the script's own bug.
val Fine: int = 0
val Failed: int = 1
val Misused: int = 2

// What `slate --version` answers.
//
// **Written here as well as in `package.hocon`, because sysl hands a program nothing about its own
// manifest** -- there is no build stamp a program can read, so the two are kept in step by the
// release checklist and by the test below that reads the manifest and compares. That test is the
// mechanism: a version bumped in one place and not the other fails the suite rather than shipping a
// binary that misreports itself.
const SlateVersion: string = "0.0.20"

main(args: []string)
    val code = run_cli(args, line -> print(line))

    // **A driver that always exits 0 cannot be driven.** slate rendered its diagnostics and then
    // told every shell, `make`, CI step and `&&` that everything had gone well -- so a failing
    // `slate test` was indistinguishable from a passing one to anything but a human reading the
    // output. `exit` is only reached for a non-zero status so that the ordinary path still leaves
    // through the end of `main`.
    if code != Fine then exit(code)
end main

// The whole of the command line: what was asked for, where the answer goes, and what it came to.
run_cli(args: []string, say: string -> unit) -> int
    if args.len < 2
        say("usage: slate <program.sl>")
        say("       slate test [--js] [path]")
        say("       slate js <program.sl> [-o <out.js>]")
        say("       slate deps [directory]")
        say("       slate fetch [directory]")
        say("       slate add <package>[@<version>] [directory]")
        say("       slate vendor [directory]")
        say("       slate --version")

        return Misused
    end if

    // The directory a command that takes one was pointed at, which is where it is standing unless it
    // says otherwise.
    val where = if args.len > 2 then args[2] else "."

    // **One `match` and not a run of `if`s**, because these are alternatives rather than tests: the
    // whole of the command line's shape is the arms, the default arm is the ordinary case, and
    // nothing here can accidentally fall through to running a file as a program.
    args[1] match
        // **`--version` is a subcommand and not a flag on one**, because a person with a binary and
        // no idea what it is asks this first -- so asking must not depend on there being a program
        // to run. `-V` comes with it, which is what every other command line on the machine answers.
        "--version" | "-V" ->
            say(s"slate ${SlateVersion}")

            Fine
        "js" -> js_command(args, say)
        "test" -> test_command(args, say)
        "deps" -> deps_command(where, say)
        "fetch" -> fetch_command(where, say)
        "add" -> add_command(args, say)
        "vendor" -> vendor_command(where, say)

        // **Everything after the program's name is the PROGRAM'S, not slate's.** A script run
        // through a `#!` line is handed its arguments the way any other command is, so slate reads
        // none of them -- there is no flag it could add later that would not be one a script had
        // already taken.
        path -> run_program(path, rest(args, 2), say)
end run_cli

// -- slate <program.sl> ----------------------------------------------------------------------------

// The arguments from `from` onwards, which is what the program is given.
private rest(args: []string, from: usize) -> Buf[string]
    var xs: Buf[string] = buf()

    for i in from..<args.len
        xs.push(args[i])

    xs
end rest

private run_program(path: string, script_args: Buf[string], say: string -> unit) -> int
    read_bytes(path) match
        Err(e) ->
            say(s"slate: cannot read ${path}: ${e}")

            Failed
        Ok(bytes) ->
            val src = source(path, bytes)

            // **Set before the run and not during it.** `install_builtins` declares `args` from this,
            // so a program whose arguments arrived later would see the empty array declared first.
            set_program_args(script_args)

            val r = run(src)

            for i in 0..<r.output.len()
                say(r.output.at(i))

            // **`r.render()` and not `r.report.render(src)`**: a program is as many files as it
            // imports, and each complaint has to be drawn against the one it is about.
            if !r.ok()
                say(r.render())

                return Failed
            end if

            // **The program's own status, where it asked for one.** `r.status` is zero unless the
            // program called `exit`, so an ordinary run still leaves through `Fine` -- and a script
            // that exits 1 is told apart from slate itself failing only by which of them said so,
            // which is the same ambiguity every interpreter has and is not worth a third code.
            int(r.status)
end run_program

// -- slate js --------------------------------------------------------------------------------------

// `slate js <program.sl> [-o <out.js>]` -- the same program, as JavaScript.
//
// **To standard output unless a file is named**, so that it pipes: `slate js p.sl | qjs -` runs a
// slate program in a JavaScript engine, and that is the whole of the back end's user interface.
private const JsUsage: string = "usage: slate js [--test] <program.sl> [-o <out.js>]"

private js_command(args: []string, say: string -> unit) -> int
    if args.len < 3
        say(JsUsage)

        return Misused
    end if

    // **`--test` emits a program that RUNS the file's `@test` functions and reports as `slate test`
    // does**, which is what lets a slate test suite gate the JavaScript back end as well as the
    // interpreter. It comes first so that the path that follows is read the same way either way.
    val testing = args[2] == "--test"

    if testing && args.len < 4
        say(JsUsage)

        return Misused
    end if

    val at: usize = if testing then 3 else 2
    val path = args[at]
    var out = ""

    if args.len > at + 1
        if args[at + 1] != "-o" || args.len < at + 3
            say(JsUsage)

            return Misused
        end if

        out = args[at + 2]
    end if

    read_bytes(path) match
        Err(e) ->
            say(s"slate: cannot read ${path}: ${e}")

            Failed
        Ok(bytes) ->
            val src = source(path, bytes)
            val (loaded, said) = loaded_and_checked(src)

            if said != ""
                say(said)

                return Failed
            end if

            val made = emit_program(loaded, testing)

            if !made.ok()
                say(rendered_against(loaded, made.report, made.srcs))

                return Failed
            end if

            if out == ""
                say_lines(made.code, "", say)

                return Fine
            end if

            write_text(out, made.code) match
                Err(e) ->
                    say(s"slate: cannot write ${out}: ${e}")

                    Failed
                Ok(_) -> Fine
end js_command

// -- slate deps ------------------------------------------------------------------------------------

// `slate deps [directory]` -- read a `package.sl` and say what it declares.
//
// **The smallest command that makes the manifest live, and deliberately no more.** It fetches
// nothing, resolves nothing and writes nothing. What it is for is that a manifest which is wrong
// should be answered by a caret now rather than discovered by a resolver later, and that a person
// can see what slate thinks their file says.
private deps_command(dir: string, say: string -> unit) -> int
    val path = if dir == "." then ManifestFile else s"${dir}/${ManifestFile}"

    read_bytes(path) match
        Err(e) ->
            say(s"slate: cannot read ${path}: ${e}")

            Failed
        Ok(bytes) ->
            val src = source(path, bytes)
            val f = read_project(src)

            // **The whole report, not only the errors.** A warning about a key nothing knows is the
            // one thing this command exists to say about a file that is otherwise fine.
            if !f.report.is_empty() then say_lines(f.report.render(src), "", say)

            if !f.ok() then return Failed

            val p = f.project

            say(s"${p.name} ${p.version}")

            if p.main != "" then say(s"  main: ${p.main}")

            // **The RESOLVED set, not the manifest's own list.** What a program actually gets
            // includes everything its dependencies drag in, and where two of them disagree it
            // includes one version rather than both -- so printing the manifest back would be
            // printing the question rather than the answer.
            val packages = resolve_packages(dir, p)

            if packages.found.len() == 0
                say("  no dependencies")
            else
                for i in 0..<packages.found.len()
                    val d = packages.found.at(i)
                    val where = if is_fetched(d) then "" else " -- not fetched"

                    say(s"  ${d.name} ${d.version} (${d.git})${where}")

            // **This is the only place a version conflict is ever said out loud.** A program that
            // runs does not report one, because the choice was made when the manifests were written
            // and repeating it on every run would be noise -- so `slate deps` is where a person
            // finds out that something is not getting the version it asked for.
            for i in 0..<packages.notes.len()
                say(s"note: ${packages.notes.at(i)}")

            check_sums(dir, packages, say)
end deps_command

// Check what is in the cache against what `slate.sum` recorded.
//
// **A hash that has CHANGED is the one failure this whole file exists for**, and it is the only
// thing here that fails a command. A package not yet recorded is what every package looks like
// before anything has recorded it, and one not yet fetched has nothing to hash -- neither is wrong.
private check_sums(root: string, packages: Packages, say: string -> unit) -> int
    val sums = read_sums(root)
    var changed = false

    for i in 0..<packages.found.len()
        val pkg = packages.found.at(i)
        val verdict = check_package(sums, pkg)
        val note = check_note(pkg, verdict)

        if note == "" then continue

        verdict match
            Changed(_, _) ->
                changed = true
                say(s"error: ${note}")
            other -> say(s"note: ${note}")

    if changed then Failed else Fine
end check_sums

// `slate fetch [directory]` -- download whatever the project depends on and is missing.
private fetch_command(dir: string, say: string -> unit) -> int
    val path = if dir == "." then ManifestFile else s"${dir}/${ManifestFile}"

    read_bytes(path) match
        Err(e) ->
            say(s"slate: cannot read ${path}: ${e}")

            Failed
        Ok(bytes) ->
            val src = source(path, bytes)
            val f = read_project(src)

            if !f.report.is_empty() then say_lines(f.report.render(src), "", say)
            if !f.ok() then return Failed

            val packages = resolve_packages(dir, f.project)

            for i in 0..<packages.notes.len()
                say(s"note: ${packages.notes.at(i)}")

            val done = fetch_packages(dir, packages)

            for i in 0..<done.notes.len()
                say(done.notes.at(i))

            if done.failed then return Failed

            say(s"${done.got} fetched, ${done.already} already there")

            Fine
end fetch_command

// `slate add <package>[@<version>] [directory]` -- write a dependency into `package.sl`.
//
// **The manifest is written last, and only where everything else worked.** A version that does not
// exist is a 404 from GitHub, and a manifest edited before that answer arrives names a dependency
// the project cannot have -- so the rewrite is held in memory, read back, resolved and fetched, and
// put on the disk only once all of that has succeeded.
private add_command(args: []string, say: string -> unit) -> int
    if args.len < 3
        say("usage: slate add <package>[@<version>] [directory]")
        say("       slate add github.com/sysl-lang/parsing")
        say("       slate add github.com/sysl-lang/parsing@0.5.0")

        return Misused
    end if

    val dir = if args.len > 3 then args[3] else "."
    val path = if dir == "." then ManifestFile else s"${dir}/${ManifestFile}"

    val c = read_coordinate(args[2]) match
        Err(e) ->
            say(s"slate: ${e}")

            return Misused
        Ok(v) -> v

    read_bytes(path) match
        Err(e) ->
            say(s"slate: cannot read ${path}: ${e}")

            Failed
        Ok(bytes) -> added_to(dir, path, bytes, c, say)
end add_command

// The whole of `slate add` once the manifest has been read off the disk.
private added_to(dir: string, path: string, bytes: []u8, c: Coordinate, say: string -> unit) -> int
    val src = source(path, bytes)
    val f = read_project(src)

    if !f.report.is_empty() then say_lines(f.report.render(src), "", say)
    if !f.ok() then return Failed

    val version = wanted_version(c) match
        Err(e) ->
            say(s"slate: ${e}")

            return Failed
        Ok(v) -> v

    val text = from_utf8_unchecked(bytes)

    val rewrite = plan_addition(text, read_manifest(src), c, version) match
        Err(e) ->
            say(s"slate: ${e}")

            return Failed
        Ok(r) -> r

    // Nothing to change: the dependency is already written at the version asked for.
    if rewrite.patches.is_empty()
        say(rewrite.news)

        return Fine
    end if

    val updated = patched_text(text, rewrite.patches)
    val again = source_of(path, updated)
    val after = read_project(again)

    // **The rewritten manifest is read back before it is written.** A surgical edit is only as good
    // as the spans it trusted, and a file this tool has broken is a file the reader did not break --
    // so the check is here, where the original is still on the disk untouched.
    if !after.ok()
        say(s"slate: rewriting ${path} produced something slate cannot read, so it has been left alone")
        say_lines(after.report.render(again), "", say)

        return Failed
    end if

    val packages = resolve_packages(dir, after.project)

    for i in 0..<packages.notes.len()
        say(s"note: ${packages.notes.at(i)}")

    val done = fetch_packages(dir, packages)

    for i in 0..<done.notes.len()
        say(done.notes.at(i))

    if done.failed then return Failed

    write_text(path, updated) match
        Err(e) ->
            say(s"slate: cannot write ${path}: ${e}")

            Failed
        Ok(_) ->
            say(rewrite.news)

            Fine
end added_to

// The version to write: the one that was asked for, or the newest tag GitHub has.
private wanted_version(c: Coordinate) -> Result[string, string] =
    if c.version != "" then Ok(c.version) else latest_version(c.git)

// `slate vendor [directory]` -- keep a copy of everything the project depends on inside it.
//
// **The whole graph, not the direct dependencies**, since what a program compiles against is the
// resolved set -- vendoring the manifest's own list would leave every transitive package still
// coming from the cache, which is a project that only builds on a machine that has one.
private vendor_command(dir: string, say: string -> unit) -> int
    val path = if dir == "." then ManifestFile else s"${dir}/${ManifestFile}"

    read_bytes(path) match
        Err(e) ->
            say(s"slate: cannot read ${path}: ${e}")

            Failed
        Ok(bytes) ->
            val src = source(path, bytes)
            val f = read_project(src)

            if !f.report.is_empty() then say_lines(f.report.render(src), "", say)
            if !f.ok() then return Failed

            val packages = resolve_packages(dir, f.project)

            for i in 0..<packages.notes.len()
                say(s"note: ${packages.notes.at(i)}")

            val v = vendor_packages(dir, packages)

            for i in 0..<v.notes.len()
                say(v.notes.at(i))

            if v.failed then return Failed

            say(s"${v.copied} vendored, ${v.already} already there")

            Fine
end vendor_command

// -- slate test ------------------------------------------------------------------------------------

// `slate test [path]` -- every `@test` in a file, or in every `.sl` file under a directory.
//
// **Each file is run as an entry of its own**, which is what stops a test file that imports the
// module it tests from running that module's tests a second time. Only the file being pointed at
// registers its tests; an imported one contributes its code and none of its verdicts.
//
// **`--js` runs the same suite through the OTHER back end**, under node. A `@test` is written about
// the language rather than about an implementation of it, so the two runs are the same file judged
// twice -- and a package's own suite is then what notices the back ends drifting apart, which
// nothing in the compiler's tests can do.
private test_command(args: []string, say: string -> unit) -> int
    // **The flag comes before the path**, so that `slate test --js` on its own still means the
    // directory it is standing in.
    val js = args.len > 2 && args[2] == "--js"
    val at: usize = if js then 3 else 2
    val root = if args.len > at then args[at] else "."

    var files: Buf[string] = buf()

    gather(root, &files)

    // **Finding nothing to run is a failure and not a quiet success.** The usual cause is a path
    // that is wrong, and a test step that passes because it tested nothing is the worst outcome
    // available to it.
    if files.len() == 0
        say(s"slate: no .sl or .slx files under ${root}")

        return Failed
    end if

    if js then return js_test_command(files, say)

    var passed: usize = 0
    var failed: usize = 0
    var unloadable: usize = 0

    for i in 0..<files.len()
        val path = files.at(i)

        read_bytes(path) match
            Err(e) ->
                unloadable += 1
                say(s"  FAIL  ${path}")
                say(s"        cannot read it: ${e}")
            Ok(bytes) ->
                val src = source(path, bytes)
                val t = run_tests(src)

                if t.report != ""
                    unloadable += 1
                    say(s"  FAIL  ${path}")
                    indented(t.report, say)
                else
                    passed += t.passed()
                    failed += t.failed()
                    say_results(path, t, say)

    say("")

    if failed == 0 && unloadable == 0
        say(s"${passed} passed")

        return Fine
    end if

    say(s"${passed} passed, ${failed + unloadable} failed")

    Failed
end test_command

// -- slate test --js -------------------------------------------------------------------------------

// Every file's `@test` functions compiled into ONE JavaScript program and run by ONE node.
//
// **The engine is node, and it is a subprocess rather than something slate is linked to.** slate
// carried an embedded quickjs for a day and it was the wrong host twice over: quickjs has no `Intl`
// at all, so `toLocaleString` with a zone SILENTLY IGNORES it -- a `slate:time` built on it would
// answer Toronto for Tokyo rather than refusing -- and it costs a linked library, a Homebrew
// dependency and two flags on every `sysl` command in this repo. node is where slate programs
// actually run, which is the host worth testing on.
//
// **ONE program and ONE process, which is what makes that affordable.** node costs about
// twenty-three milliseconds to start; a process per file made this ten-file suite take 0.45s where
// the whole of it needs 0.06s. It is Scala Native's arrangement -- one binary, every test -- and
// once it is running node is some twenty times faster than the embedded engine was.
private js_test_command(files: Buf[string], say: string -> unit) -> int
    var entries: Buf[string] = buf()
    var refused: usize = 0

    for i in 0..<files.len()
        val path = files.at(i)

        read_bytes(path) match
            Err(e) ->
                refused += 1
                say(s"  FAIL  ${path}")
                say(s"        cannot read it: ${e}")
            Ok(bytes) ->
                // **A file that will not compile is reported HERE and left out of the program**, so
                // that one bad file does not stop every other file's tests from running. That is
                // what the interpreter does too -- a file that would not load is one failure and the
                // walk carries on.
                val src = source(path, bytes)
                val (loaded, said) = loaded_and_checked(src)

                if said != ""
                    refused += 1
                    say(s"  FAIL  ${path}")
                    indented(said, say)
                else
                    val made = program_body(loaded, true)

                    if !made.ok()
                        refused += 1
                        say(s"  FAIL  ${path}")
                        indented(rendered_against(loaded, made.report, made.srcs), say)
                    else
                        entries.push(one_entry(path, made.code))

    if entries.len() == 0
        say("")
        say(s"0 passed, ${refused} failed")

        return Failed
    end if

    val ran = node_ran(js_suite(entries), say)

    // **The two counts are added rather than one being made to carry both.** node reports what it
    // ran and this reports what never reached it, so a suite with a file that would not compile says
    // so above node's own report and fails whatever node answered.
    if refused > 0
        say(s"${refused} more failed before node was asked")

        return Failed
    end if

    ran
end js_test_command

// The program written where node can read it, run, and its report said as this program's own.
//
// **A file rather than a pipe**, because `sysl.process.capture` has no standard input to write to --
// its third parameter is the working directory. The directory is removed on the way out, and named
// rather than removed where node could not be started at all, which is the one failure worth being
// able to look at.
private node_ran(program: string, say: string -> unit) -> int
    val dir = mkdtemp_sync("/tmp/slate-js-XXXXXX") match
        Ok(d) -> d
        Err(e) ->
            say(s"slate: nowhere to write the test program: ${e}")

            return Failed

    val path = s"${dir}/suite.js"

    write_text(path, program) match
        Err(e) ->
            say(s"slate: cannot write ${path}: ${e}")

            return Failed
        Ok(_) -> ()

    val outcome = capture("node", [path], "", [], true) match
        Err(e) ->
            // **The absence of node is a failure with a sentence and not a skip.** A test step that
            // is green having run nothing is the worst outcome available to it, and the program is
            // left where a person can run it themselves.
            say(s"slate: node could not be started: ${e}")
            say(s"       `slate test --js` needs node on PATH; the program is at ${path}")

            return Failed
        Ok(o) ->
            say_lines(o.text.trim_end(), "", say)

            val errs = o.err.unwrap_or("").trim()

            if errs != "" then say_lines(errs, "", say)

            if o.status.ok() then Fine else Failed

    remove_dir_all(dir)

    outcome
end node_ran

// One file's verdicts, with the file named only where it has something to say.
private say_results(path: string, t: Tested, say: string -> unit)
    for i in 0..<t.results.len()
        val r = t.results.at(i)

        if r.ok
            say(s"  ok    ${path} :: ${r.name}   ${r.ms}ms")
        else
            say(s"  FAIL  ${path} :: ${r.name}   ${r.ms}ms")

            if r.printed != "" then indented(r.printed, say)

            indented(r.said, say)
end say_results

// A block of text, moved right so that it reads as belonging to the line above it.
private indented(text: string, say: string -> unit) = say_lines(text, "        ", say)

// A block of text said one line at a time, since `say` takes a line and a rendered report is many.
// **The BYTE, not `push_char` of it.** A slate string is UTF-8 and a character above ASCII is
// several bytes; `char(b)` of one of them is a different character, which `push_char` then encodes
// again -- so `日本語` reached the terminal as six mojibake characters. It went unnoticed because
// everything this had rendered until now -- a manifest's keys, a diagnostic's own words -- was
// ASCII, and it is the emitted JavaScript of a program with a wide string in it that showed it.
private say_lines(text: string, prefix: string, say: string -> unit)
    var line = str_builder()

    for i in 0..<text.bytes.len
        if text.bytes[i] == u8('\n')
            say(s"${prefix}${line.finish()}")
            line = str_builder()
        else
            line.bytes.push(text.bytes[i])

    val last = line.finish()

    if last != "" then say(s"${prefix}${last}")
end say_lines

// Every `.sl` file at or under a path, in the order the file system gives them.
//
// **A directory that cannot be read is skipped rather than fatal.** What is being asked for is the
// tests that can be run, and a directory nobody can open has none -- reporting it as a failure would
// make `slate test .` fail on a tree with an unreadable corner nothing was testing.
private gather(root: string, out: *Buf[string])
    // **A file named outright is taken whatever it is called.** The `.sl` filter is for deciding
    // what to walk INTO, not for arguing with somebody who has pointed at a file.
    if !is_dir(root)
        out.push(root)
        return
    end if

    entries(root) match
        Err(_) -> ()
        Ok(names) ->
            for i in 0..<names.len()
                val name = names.at(i)

                // Nothing under a dot directory: `.git` is the one that matters and there is no
                // reason to walk any of them.
                if name.bytes.len > 0 && name.bytes[0] != u8('.')
                    val child = if root == "." then name else s"${root}/${name}"

                    if is_dir(child) then gather(child, out) elif ends_with_sl(child) then out.push(child)
end gather

// **`.slx` is walked into as well as `.sl`, and it buys nothing but the name.** slx is read in every
// file -- there is no ambiguity to gate on, `<` in prefix position beginning nothing else -- so the
// extension says to a reader and to an editor what a file holds, and says nothing to the compiler.
// That is the opposite of `.tsx`, which had to be a separate parse mode because `<T>(x)` is a cast in
// TypeScript and a tag in TSX.
private ends_with_sl(path: string) -> bool
    val b = path.bytes

    if b.len > 4 && b[b.len - 4] == u8('.') && b[b.len - 3] == u8('s') && b[b.len - 2] == u8('l') && b[b.len - 1] == u8('x')
        return true

    b.len > 3 && b[b.len - 3] == u8('.') && b[b.len - 2] == u8('s') && b[b.len - 1] == u8('l')
