module dev.slatelang.slate

import sh.sysl.gc
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}

// What a slate program computes with.
//
// slate is dynamically typed, so this is the tagged union every such language has, and the whole of
// its type system lives in the arms that read it.
//
// **Not one member of it is reference counted**, and that is what makes it cheap: scalars, and raw
// pointers into the collected heap. A `Value` copies with no ARC traffic, stores into GC memory
// without a write barrier, and needs no finalizer of its own -- the objects it points at have those.
//
// **An array and an object are reference types because the pointer is the value.** Two names for one
// array see each other's writes, which is what JavaScript, Python and Ruby all do and is not
// something slate implements. A number and a boolean are copied.
enum Value
    Null

    // **Absence, and the one value a program may not keep.**
    //
    // It comes from reading a field an object does not have, and nowhere else. It may be compared,
    // defaulted with `??`, and tested in a condition -- but it may not be bound to a name, stored in
    // a container, or passed to a function, and every one of those is refused where it is attempted.
    //
    // **The point is that absence stops at the boundary it arose at.** JavaScript's `undefined` is an
    // ordinary value, so it flows into a field, through three layers, and is observed a long way from
    // the lookup that made it -- by which time nothing knows what was missing. Here the program has to
    // say what absence means where it happens, which is the one place it still knows.
    Undefined
    Bool(v: bool)
    Int(v: long)
    Real(v: real)
    Str(p: *StrObj)
    Array(p: *ArrayObj)
    Object(p: *ObjectObj)
    Fn(p: *ClosureObj)

    // A value that is not there yet, which `await` waits for and an `async` function answers.
    Promise(p: *PromiseObj)

    // `a..b` and `a..<b`.
    //
    // **All scalars, so a range needs no object in the collected heap** -- which is the reason it is
    // a variant here rather than a `*RangeObj`: two numbers and three flags copy as cheaply as an
    // integer does, and nothing about a range can cycle.
    //
    // `has_lo` and `has_hi` say which ends were written. An end left out is taken from whatever the
    // range is used on -- zero and the length, for a slice -- and a `for` over a range with no end
    // is refused rather than run forever.
    RangeVal(lo: long, hi: long, inclusive: bool, has_lo: bool, has_hi: bool)

    // A TCP socket -- a listener, or a connection at either end of one.
    //
    // **A slot in the table `event.sysl` keeps, and not the handle itself.** A `&Tcp` is a counted
    // box and a counted box may not live in the collected heap at all (see `obj.sysl`), so what a
    // program holds is the slot and what holds the handle is the slot. That also makes a socket a
    // scalar, which is what keeps this union free of reference counting.
    //
    // **`gen` is why this is two numbers and not one.** A spent slot is reused, so `id` alone names
    // a position rather than a socket: a value held across a `close` would come to mean whatever
    // took the position next, and compare equal to it. The generation is stamped at the claim and
    // never reused, so a closed socket's value matches nothing ever again.
    Socket(id: usize, gen: usize)

    // A function the interpreter supplies.
    //
    // **A closed enum rather than a name, so that a `Value` stays free of reference counting.** A
    // `string` here would be the one ARC member in the union and would put a finalizer on every
    // object that can hold a value.
    Native(f: NativeFn)

    // The name a program uses for this kind of value, which is what a runtime complaint says.
    type_name(self) -> string = self match
        Null -> "null"
        Undefined -> "undefined"
        Bool(_) -> "a boolean"
        Int(_) -> "an integer"
        Real(_) -> "a real"
        Str(_) -> "a string"
        Array(_) -> "an array"
        Object(_) -> "an object"
        Fn(_) -> "a function"
        Promise(_) -> "a promise"
        RangeVal(_, _, _, _, _) -> "a range"
        Socket(_, _) -> "a socket"
        Native(_) -> "a function"

    // Whether this counts as true in a condition.
    //
    // **Only `false` and `null` are false, and nothing else is.** The alternative -- zero and the
    // empty string being false as well -- is the rule JavaScript and Python took and is the one most
    // often written about as a mistake: it makes `if xs.len` and `if xs.len != 0` differ from each
    // other in a way nobody predicts. slate takes Ruby's and Lua's side of that argument.
    truthy(self) -> bool = self match
        Null -> false
        Undefined -> false
        Bool(v) -> v
        _ -> true
end Value

// The functions a program has without writing them.
enum NativeFn derives Display
    NPrint
    NLen
    NPush
    NStr
    NKeys
    NHas

    // The event loop's, which are node's names because a program that knows node should not have to
    // learn new ones for the same thing.
    NSetTimeout
    NSetInterval
    NClearTimeout

    // Promises. `sleep` is the one that makes `await` worth having on its own -- everything else a
    // program can build out of an async function.
    NSleep
    NResolve
    NReject

    // The file system. **node's names**, and every one of them answers a promise -- there is no
    // blocking form, which is the one place slate is stricter than node rather than looser.
    NReadFile
    NReadBytes
    NWriteFile
    NReadDir
    NStat
    NExists
    NRemove
    NMkdir
    NRmdir
    NRename

    // The same ten, blocking. **`Sync` is node's suffix and the reason for having them is node's
    // too**: a program that reads its configuration before it starts, or a script whose whole job is
    // three file operations in order, gains nothing from a promise and pays for it in ceremony.
    NReadFileSync
    NReadBytesSync
    NWriteFileSync
    NReadDirSync
    NStatSync
    NExistsSync
    NRemoveSync
    NMkdirSync
    NRmdirSync
    NRenameSync

    // TCP. **A socket is a handle with a lifetime**, which is what makes this different from the
    // file system: `connect` and `send` answer promises, and `listen` and `onData` take callbacks,
    // because a stream is a run of events rather than one answer.
    NListen
    NConnect
    NOnData
    NOnBytes
    NSend
    NCloseSocket
    NLocalPort
end NativeFn

// The text of a slate string, for the interpreter's own use.
text_of(p: *StrObj) -> string = p.s

// A slate string value over a sysl string. The GC object becomes that string's only owner.
str_value(s: string) -> Value = Str(new_str(s))

// -- scopes -------------------------------------------------------------------------------------

// What a name holds, looked up outward through the chain.
lookup(e: *EnvObj, name: string) -> Option[Value]
    var scope = e

    // A loop rather than the recursion this reads as, because a scope chain is as deep as a
    // program's nesting and a walk up it is a walk up a linked list.
    loop
        if scope == null then return None

        scope.names.get(name) match
            Some(v) -> return Some(v)
            None -> scope = scope.parent
end lookup

// Whether a name is bound anywhere in the chain.
knows(e: *EnvObj, name: string) -> bool = lookup(e, name).is_some()

// Bind a name in this scope, shadowing whatever an outer one had.
declare(e: *EnvObj, name: string, v: Value, assignable: bool)
    e.names.put(name, v)
    e.mutable.put(name, assignable)

// Write to an existing binding, wherever in the chain it lives.
//
// Three answers rather than two: the name may be unknown, or known and not writable, and the two are
// different complaints.
assign_name(e: *EnvObj, name: string, v: Value) -> Assigned
    var scope = e

    loop
        if scope == null then return Unknown

        if scope.names.has(name)
            if !scope.mutable.get_or(name, false) then return Immutable

            scope.names.put(name, v)
            return Written
        end if

        scope = scope.parent
end assign_name

// What happened when a name was written to.
enum Assigned
    Written
    Immutable
    Unknown
