module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// The JavaScript back end -- what a program compiles to.
//
// **What is pinned here is the emitted TEXT**, which is the only thing this suite can see: running it
// takes a JavaScript engine, and slate's tests have none until the `quickjs` binding is a dependency
// of this repo. So these say what the shape of the output is, and the shape is where the decisions
// are: which operators go through the runtime, where a temporary appears, what a pattern becomes.
//
// **`js` hands back the module's own statements without the runtime**, for the reason `good_tree`
// hands back a tree rather than a program: nine hundred lines of prelude in front of every
// expectation would pin the prelude instead. `emit_program` is asserted once, for the two things
// only it does.
//
// **A whole program is somebody else's file now**, this one having passed a thousand lines: several
// files, the driver, and what the emitted program does to its host are in `tests_js_program.sysl`.

// -- values ---------------------------------------------------------------------------------------

@test
an_integer_is_a_bigint_and_a_real_is_a_number()
    // **The representation decision, and the one everything else follows from.** slate's integer is
    // 64 bits, wraps and divides towards zero; a double does none of those and could not be told
    // from a real afterwards.
    assert_eq(js("""
        val x = 1
        var y = 2.5
        """), """
        $.at(1);
        const x = 1n;
        $.at(2);
        let y = 2.5;
        """)

@test
a_real_keeps_every_digit_that_reads_back_the_same()
    // `%g`'s six digits would be a different number, and the arithmetic downstream would answer
    // differently from the interpreter's.
    assert_eq(js("val pi = 3.141592653589793\n"), "$.at(1);\nconst pi = 3.141592653589793;\n")
    assert_eq(js("val big = 1e300\n"), "$.at(1);\nconst big = 1e+300;\n")

@test
a_wide_string_survives_as_the_bytes_it_was()
    // A slate string is UTF-8 and JavaScript source is too, so the bytes go straight through -- a
    // literal copied character by character would be mojibake, which it was.
    assert_eq(js("print(\"日本語\")\n"), "$.at(1);\n$.call(print, [\"日本語\"]);\n")

@test
a_javascript_word_a_program_used_gets_an_escape()
    // A slate identifier holds no `$`, so a trailing one names something no program can write and
    // two slate names can never mangle to one.
    assert_eq(js("""
        val class = 1
        print(class)
        """), """
        $.at(1);
        const class$ = 1n;
        $.at(2);
        $.call(print, [class$]);
        """)

@test
an_object_literal_keeps_its_keys_in_order()
    assert_eq(js("val o = { a: 1, \"b c\": 2 }\n"), """
        $.at(1);
        const o = $.obj([["a", 1n], ["b c", 2n]]);
        """)

// -- operators ------------------------------------------------------------------------------------

@test
every_operator_goes_through_the_runtime()
    // **Not JavaScript's own, and the exceptions are not worth tracking**: `7 / 2` is 3 in slate and
    // 3.5 there, `0` is true here and false there, `[1] == [1]` is true here and false there.
    assert_eq(js("print(1 + 2 * 3)\n"), """
        $.at(1);
        $.call(print, [$.arith("+", 1n, $.arith("*", 2n, 3n))]);
        """)
    assert_eq(js("val b = 1 < 2\n"), "$.at(1);\nconst b = $.compare(\"<\", 1n, 2n);\n")
    assert_eq(js("val b = [1] == [1]\n"), "$.at(1);\nconst b = $.eq($.arr([1n]), $.arr([1n]));\n")

@test
a_chain_of_comparisons_reads_each_operand_once()
    assert_eq(js("val b = 1 < 2 < 3\n"), """
        $.at(1);
        const $t1 = 1n;
        const $t2 = 2n;
        const $t3 = 3n;
        let $t4 = true;
        if ($t4) {
            $t4 = $.compare("<", $t1, $t2);
        }
        if ($t4) {
            $t4 = $.compare("<", $t2, $t3);
        }
        const b = $t4;
        """)

@test
a_short_circuit_answers_the_operand_that_decided()
    // slate's rule, not sysl's -- so neither side may be turned into a boolean, and `??` asks
    // whether the left side is THERE where `||` asks whether it is true.
    assert_eq(js("val v = null ?? 3\n"), """
        $.at(1);
        let $t1 = null;
        if (!$.present($t1)) {
            $t1 = 3n;
        }
        const v = $t1;
        """)

@test
an_interpolation_renders_its_holes_as_a_program_prints_them()
    assert_eq(js("val s = s\"a ${1 + 1} b\"\n"), """
        $.at(1);
        const s = $.interp(["a ", $.arith("+", 1n, 1n), " b"]);
        """)

@test
an_element_assigned_to_holds_its_target_and_key()
    assert_eq(js("""
        val xs = [1, 2]
        xs[0] = 5
        """), """
        $.at(1);
        const xs = $.arr([1n, 2n]);
        $.at(2);
        const $t1 = xs;
        const $t2 = 0n;
        $.setIndex($t1, $t2, 5n);
        """)

@test
a_method_call_is_not_a_call_of_a_field()
    // The receiver rule is the runtime's: an object's own field is called as it stands, and one
    // reached through a `proto` -- or answered by the builtin table -- takes the receiver in front.
    assert_eq(js("print(\"ab\".upper())\n"), """
        $.at(1);
        $.call(print, [$.method("ab", "upper", [])]);
        """)

@test
a_spread_needs_no_arm_of_its_own_in_either_kind_of_literal()
    // **Both halves of `...` arrive as nodes this back end already emits**, which is what the
    // parser's desugaring buys: an array's spread is the `Spread` a call's arguments carry, and an
    // object's is the `with` slate already had, so the interleaving order is encoded in the tree.
    assert_eq(js("""
        val xs = [1]
        val more = [0, ...xs, 3]
        """), """
        $.at(1);
        const xs = $.arr([1n]);
        $.at(2);
        const more = $.arr([0n, ...$.spread(xs), 3n]);
        """)
    assert_eq(js("""
        val props = { a: 1 }
        val merged = { ...props, b: 3 }
        """), """
        $.at(1);
        const props = $.obj([["a", 1n]]);
        $.at(2);
        const merged = $.withFields($.withAll($.obj([]), props, true), [["b", 3n]]);
        """)

// -- the forms that become statements -----------------------------------------------------------

@test
an_if_used_for_its_value_becomes_a_temporary()
    // **JavaScript has no block expression**, and an immediately-called function would take
    // `return`, `break`, `await` and `yield` away from the enclosing function.
    assert_eq(js("val v = if true then 1 else 2\n"), """
        $.at(1);
        let $t1;
        if ($.truthy(true)) {
            $t1 = 1n;
        } else {
            $t1 = 2n;
        }
        const v = $t1;
        """)

@test
an_if_with_no_else_is_null_where_the_condition_failed()
    assert_eq(js("val v = if true then 1\n"), """
        $.at(1);
        let $t1;
        if ($.truthy(true)) {
            $t1 = 1n;
        } else {
            $t1 = null;
        }
        const v = $t1;
        """)

@test
a_loop_is_labelled_whether_or_not_the_program_named_one()
    // `break 7` has to assign the loop's temporary and leave the right loop, and the two have to
    // agree when loops are nested.
    assert_eq(js("""
        var i = 0
        while i < 3
            i += 1
        """), """
        $.at(1);
        let i = 0n;
        $.at(2);
        let $t1 = null;
        let $t2 = false;
        $L3: while (true) {
            if (!$.truthy($.compare("<", i, 3n))) break $L3;
            $.at(3);
            i = $.arith("+", i, 1n);
        }
        """)

@test
a_loop_that_finished_on_its_own_takes_its_else()
    assert_eq(js("""
        var i = 0
        val v = while i < 3
            i += 1
        else
            "done"
        """), """
        $.at(1);
        let i = 0n;
        $.at(2);
        let $t1 = null;
        let $t2 = false;
        $L3: while (true) {
            if (!$.truthy($.compare("<", i, 3n))) break $L3;
            $.at(3);
            i = $.arith("+", i, 1n);
        }
        if (!$t2) {
            $.at(5);
            $t1 = "done";
        }
        const v = $t1;
        """)

@test
a_for_over_a_bare_name_binds_it_without_a_pattern()
    // The commonest binding there is, and it cannot fail -- so it is the assignment it is rather
    // than a walk over a pattern that always holds.
    //
    // **`let` and not `const`, since the body may declare the same name.** The binding is written
    // outside the run of statements that would say so and lands in the same JavaScript block, so
    // whether it is ever assigned again is not known when it is written.
    assert_eq(js("""
        for x in 1..3
            print(x)
        """), """
        $.at(1);
        let $t1 = null;
        let $t2 = false;
        $L3: for (const $t4 of $.iter($.range(1n, 3n, true))) {
            let x = $t4;
            $.at(2);
            $.call(print, [x]);
        }
        """)

@test
a_match_is_one_labelled_block_however_many_arms_it_has()
    // A chain of `else`s would put twelve arms twelve levels deep; breaking out of a labelled block
    // keeps the output as flat as the program.
    assert_eq(js("""
        val v = 3 match
            1 -> "one"
            n -> n
        """), """
        $.at(1);
        const $t1 = 3n;
        let $t2;
        $L3: {
            const $t4 = $.matched($t1, ["v", 1n]);
            if ($t4 !== null) {
                $.at(2);
                $t2 = "one";
                break $L3;
            }
            const $t5 = $.matched($t1, ["_"]);
            if ($t5 !== null) {
                let n = $t5[0];
                $.at(3);
                $t2 = n;
                break $L3;
            }
            $.noArm($t1);
        }
        const v = $t2;
        """)

@test
a_catch_binds_a_value_and_not_javascripts_exception()
    assert_eq(js("""
        val v = try
            1
        catch e
            e
        """), """
        $.at(1);
        let $t1;
        try {
            $.at(2);
            $t1 = 1n;
        } catch ($t2) {
            const e = $.caught($t2);
            $.at(4);
            $t1 = e;
        }
        const v = $t1;
        """)

@test
A_DESTRUCTURING_PARAMETERS_HIDDEN_NAME_IS_SPELLABLE_IN_JAVASCRIPT()
    // **`(0)` is unspellable in slate ON PURPOSE**, so that a synthetic parameter can never shadow
    // or be shadowed by a name a person wrote -- and JavaScript will not take it as a parameter
    // either, so `function f((0))` came out and would not parse. Every program with a destructuring
    // parameter failed to run, and nothing said so until one was written.
    assert_eq(js("""
        f({ a }) = a
        """), """
        $.at(1);
        function f($0) {
            let $t1;
            $.at(1);
            const $t2 = $0;
            const $t3 = $.unpacked($t2, ["obj", ["a"], [["_"]], [false]]);
            const a = $t3[0];
            $t1 = a;
            return $t1;
        }
        $.sig(f, ["(0)"], 1, "f");
        """)

@test
A_PATTERNS_DEFAULT_IS_A_FLAG_ON_THE_PATTERN_AND_A_LINE_AFTER_IT()
    // **The runtime is told which entries are optional and nothing more.** What the default IS stays
    // code, emitted after the unpack, so it is worked out where the binding is -- which is what the
    // machine does too, with `JumpIfBound` in place of the `=== undefined`.
    //
    // A defaulted name is never `const`, because the line under it writes to it. Nothing can see the
    // difference: that write is the only one there is.
    assert_eq(js("""
        val { a, b = 2 } = { a: 1 }
        """), """
        $.at(1);
        const $t1 = $.obj([["a", 1n]]);
        const $t2 = $.unpacked($t1, ["obj", ["a", "b"], [["_"], ["_"]], [false, true]]);
        const a = $t2[0];
        let b = $t2[1];
        if (b === undefined) b = 2n;
        """)

    // An array pattern carries the count that is NOT optional, so the runtime's length check asks
    // the same question the machine's does.
    assert_eq(js("""
        val [x, y = 9] = [1]
        """), """
        $.at(1);
        const $t1 = $.arr([1n]);
        const $t2 = $.unpacked($t1, ["arr", [["_"], ["_"]], false, false, 1]);
        const x = $t2[0];
        let y = $t2[1];
        if (y === undefined) y = 9n;
        """)

@test
an_is_pattern_declares_its_bindings_before_the_test()
    // **The names `is` binds outlive the test**, so they are declared in front of it and filled in
    // where it held -- which a conditional expression could not do.
    assert_eq(js("""
        val p = { x: 1 }
        val got = p is { x }
        """), """
        $.at(1);
        const p = $.obj([["x", 1n]]);
        $.at(2);
        const $t1 = p;
        const $t2 = $.matched($t1, ["obj", ["x"], [["_"]], [false]]);
        let x;
        if ($t2 !== null) {
            x = $t2[0];
        }
        const got = ($t2 !== null);
        """)

// -- definitions ------------------------------------------------------------------------------------

@test
a_definition_is_a_function_and_a_generator_is_a_function_star()
    assert_eq(js("double(x) = x * 2\n"), """
        $.at(1);
        function double(x) {
            let $t1;
            $.at(1);
            $t1 = $.arith("*", x, 2n);
            return $t1;
        }
        $.sig(double, ["x"], 1, "double");
        """)
    assert_eq(js("""
        counter()
            yield 1
        """), """
        $.at(1);
        function* counter() {
            let $t1;
            $.at(2);
            $t1 = (yield 1n);
            return $t1;
        }
        $.sig(counter, [], 0, "counter");
        """)
    assert_eq(js("async later() = 1\n"), """
        $.at(1);
        async function later() {
            let $t1;
            $.at(1);
            $t1 = 1n;
            return $t1;
        }
        $.sig(later, [], 0, "later");
        """)

@test
AN_AWAIT_OUTSIDE_AN_ASYNC_FUNCTION_IS_REFUSED_HERE_AS_IT_IS_BY_THE_INTERPRETER()
    // **The refusal has to be made here as well, and not left to node.** JavaScript reads an `await`
    // outside an `async` function as a *SyntaxError*, which is raised while the file is being parsed
    // -- so what a program got for the interpreter's one sentence about one expression was a file
    // node would not load at all, quoting a character of emitted JavaScript. The message is the
    // interpreter's, word for word, because it is the same mistake.
    assert(js("f() = await 5\n").contains("`await` belongs in an `async` function"))

    // Including in an ordinary function nested inside an `async` one -- `await` belongs to the
    // function it is written in, not to the one that called it. This is the shape the flag exists
    // for: the enclosing `async` says nothing about the body being emitted.
    assert(js("async outer()\n    inner() = await 5\n    inner()\n").contains("`await` belongs in an `async` function"))

    // And at the top level, which is not `async` on either host and is not one for node either.
    assert(js("print(await 5)\n").contains("`await` belongs in an `async` function"))

@test
AN_AWAIT_INSIDE_AN_ASYNC_FUNCTION_IS_EMITTED_AND_THE_FLAG_IS_PUT_BACK()
    // The passing half, and the second definition is the point of it: a plain function emitted in
    // between must not leave the flag off for the `async` one that follows.
    assert_eq(js("async f() = await 5\n"), """
        $.at(1);
        async function f() {
            let $t1;
            $.at(1);
            $t1 = await $.awaited(5n);
            return $t1;
        }
        $.sig(f, [], 0, "f");
        """)
    assert(!js("async a() = await 1\nplain() = 2\nasync b() = await 3\n").contains("belongs in an `async` function"))

@test
YIELD_OUTSIDE_A_FUNCTION_AND_INSIDE_AN_ASYNC_ONE_ARE_BOTH_REFUSED_HERE_AS_THEY_ARE_BY_THE_INTERPRETER()
    // **The same shape of refusal `await` gets, for the same reason.** `slate js` used to emit a
    // bare `yield` wherever it was written, so a program the interpreter stops at that expression --
    // naming it, with the span -- came out of the JavaScript host as a file node would not load at
    // all: `SyntaxError: Unexpected strict mode reserved word`, quoting a character of emitted
    // JavaScript. The message is the interpreter's, word for word.
    assert(js("print(yield 5)\n").contains("`yield` belongs inside a function"))

    // **And inside an `async` function, which the interpreter refuses for a different reason: an
    // async generator is not slate.** Left alone, `slate js` would have emitted the `Yield` into an
    // `async function*` -- a JavaScript construct the language does not offer at all -- so node
    // would have RUN a program the interpreter refuses, the two hosts disagreeing about whether it
    // means anything rather than merely about the words of the refusal.
    assert(js("async f()\n    yield 1\nf()\n").contains("an `async` function may not `yield` -- an async generator is not slate"))

@test
A_PLAIN_GENERATOR_IS_UNCHANGED_BY_THE_FLAG_AND_STILL_EMITS_A_FUNCTION_STAR()
    // **The passing half.** An ordinary generator, with no `async` anywhere near it, is neither of
    // the two refused shapes above and still emits exactly as `a_definition_is_a_function_and_a_
    // generator_is_a_function_star` already pins byte for byte -- this is the belt-and-braces check
    // that `in_gen` changed nothing about what an ordinary `yield` compiles to.
    val out = js("counter()\n    yield 1\n    yield 2\n")

    assert(out.contains("function* counter"))
    assert(out.contains("(yield 1n)"))
    assert(out.contains("(yield 2n)"))
    assert(!out.contains("belongs"))

@test
a_body_says_its_own_line_however_it_was_reached()
    // **A body runs at a different time from the text around it**, so what the last marker said
    // means nothing inside it: the marker in front of the definition ran when the definition did.
    // Without forgetting it, a body whose first statement is on the definition's own line begins
    // with no marker at all -- and a fault in it is then reported at the line of whatever CALLED it,
    // which is a file and a line the reader has no reason to look at.
    assert_eq(js("f() = 1\n\nprint(f())\n"), """
        $.at(1);
        function f() {
            let $t1;
            $.at(1);
            $t1 = 1n;
            return $t1;
        }
        $.sig(f, [], 0, "f");
        $.at(3);
        $.call(print, [$.call(f, [])]);
        """)

@test
a_default_lands_on_the_parameter_it_belongs_to()
    // **`defaults` covers the LAST of the parameters**, so reading the two lists in step gives every
    // default to the wrong parameter -- silently, since only a call that leaves one out shows it.
    assert_eq(js("greet(name, greeting = \"hello\") = greeting\n"), """
        $.at(1);
        function greet(name, greeting = "hello") {
            let $t1;
            $.at(1);
            $t1 = greeting;
            return $t1;
        }
        $.sig(greet, ["name", "greeting"], 1, "greet");
        """)

@test
a_default_that_needs_statements_stays_inside_the_parameter_list()
    // **A default is worked out at the CALL**, so a `const` in front of the function would share one
    // value between every call that left the argument out.
    assert(js("f(xs = if true then [] else [1]) = xs\n").contains("(() => {"))
    assert(!js("f(xs = if true then [] else [1]) = xs\n").contains("const $t1 = (() => {"))

@test
a_lambda_is_a_function_expression()
    // An arrow cannot be a generator, and slate's `->` may hold a `yield`.
    assert_eq(js("val f = x -> x + 1\n"), """
        $.at(1);
        const $t1 = function(x) {
            let $t2;
            $.at(1);
            $t2 = $.arith("+", x, 1n);
            return $t2;
        };
        $.sig($t1, ["x"], 1, "");
        const f = $t1;
        """)

// -- a name declared twice ---------------------------------------------------------------------------

@test
a_name_declared_again_in_one_scope_is_assigned_rather_than_redeclared()
    // **slate rebinds where JavaScript refuses to redeclare.** A function written between the two
    // answers the second value, so it is one slot and not two -- and `const` twice is a
    // *SyntaxError*, which is a program that does not start rather than one that runs differently.
    assert_eq(js("val a = 1\nval a = 2\n"), """
        $.at(1);
        let a = 1n;
        $.at(2);
        a = 2n;
        """)

    // **TWO DEFINITIONS OF ONE NAME IN ONE BLOCK ARE REFUSED, AND THIS GOLDEN USED TO PIN THE
    // EMISSION.** What it pinned was the back ends disagreeing: definitions are hoisted, so the
    // interpreter's `DefineFn` overwrote the binding as it hoisted and answered `2` for a call
    // written between the two, while the emission below rebound in order and answered `1`. Neither
    // is wrong given the other's rule, so the program is refused where it stands -- see
    // `tests_lang.sysl` for the refusal and both its shapes.
    assert(js("f() = 1\nprint(f())\nf() = 2\n").contains("is declared twice in this block"))

@test
a_name_declared_again_in_a_NESTED_scope_is_an_ordinary_shadow()
    // **The block is what decides**, since a block is where JavaScript refuses a redeclaration --
    // and a name declared again inside a nested one shadows, which it is happy with.
    assert_eq(js("""
        val a = 1
        if true
            val a = 2
        """), """
        $.at(1);
        const a = 1n;
        $.at(2);
        let $t1;
        if ($.truthy(true)) {
            $.at(3);
            const a = 2n;
            $t1 = null;
        } else {
            $t1 = null;
        }
        """)

@test
a_loop_body_may_declare_the_name_the_loop_bound()
    // The binding is written outside the run of statements and lands in the same JavaScript block,
    // so a body declaring it again is redeclaring -- which is why a binder is a `let`.
    assert_eq(js("""
        for x in 1..3
            val x = 1
            print(x)
        """), """
        $.at(1);
        let $t1 = null;
        let $t2 = false;
        $L3: for (const $t4 of $.iter($.range(1n, 3n, true))) {
            let x = $t4;
            $.at(2);
            x = 1n;
            $.at(3);
            $.call(print, [x]);
        }
        """)

@test
a_name_the_parser_made_is_given_one_javascript_will_take()
    // **`(new)` is unspellable on purpose** -- it is the object a constructor is building, and a
    // name a program could write would shadow something a person wrote. It is not a JavaScript name
    // either, and `const (new) = ...` is a *SyntaxError*: the program does not start at all.
    assert(js("""
        class Pen
            new(ink) = { ink: ink }
        """).contains("const $new = $.obj("), "the object a constructor is building")

    // The same for the hidden name a destructured parameter is given.
    assert(js("f({ x }) = x\n").contains("function f($0) {"), "a destructured parameter")

// -- the line table ----------------------------------------------------------------------------------

@test
the_line_is_said_only_where_it_changed()
    // A caught fault is an object carrying `message`, `line` and `file`, and the line has to be
    // slate's -- a `catch` reading the emitted JavaScript's line would be reading a file the
    // programmer never saw. Two statements on one line cost one marker.
    assert_eq(js("""
        val a = 1
        val b = 2
        """), """
        $.at(1);
        const a = 1n;
        $.at(2);
        const b = 2n;
        """)

