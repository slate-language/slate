module dev.slatelang.slate
@tests

import sh.sysl.parsing.*
import sysl.text.Search

// The JavaScript back end -- what a program compiles to.
//
// **What is pinned here is the emitted TEXT**, which is the only thing this suite can see: running it
// takes a JavaScript engine, and slate's tests have none until the `quickjs` binding is a dependency
// of this repo. So these say what the shape of the output is, and the shape is where the decisions
// are: which operators go through the runtime, where a temporary appears, what a pattern becomes.
//
// **`js` hands back the module's own statements without the runtime**, for the reason `good_tree`
// hands back a tree rather than a program: nine hundred lines of prelude in front of every
// expectation would pin the prelude instead. `emit_program` is asserted once, at the bottom, for the
// two things only it does.

// -- values ---------------------------------------------------------------------------------------

@test
an_integer_is_a_bigint_and_a_real_is_a_number()
    // **The representation decision, and the one everything else follows from.** slate's integer is
    // 64 bits, wraps and divides towards zero; a double does none of those and could not be told
    // from a real afterwards.
    assert_eq(js("""
        val x = 1
        var y = 2.5
        """), """
        $.at(1);
        const x = 1n;
        $.at(2);
        let y = 2.5;
        """)

@test
a_real_keeps_every_digit_that_reads_back_the_same()
    // `%g`'s six digits would be a different number, and the arithmetic downstream would answer
    // differently from the interpreter's.
    assert_eq(js("val pi = 3.141592653589793\n"), "$.at(1);\nconst pi = 3.141592653589793;\n")
    assert_eq(js("val big = 1e300\n"), "$.at(1);\nconst big = 1e+300;\n")

@test
a_wide_string_survives_as_the_bytes_it_was()
    // A slate string is UTF-8 and JavaScript source is too, so the bytes go straight through -- a
    // literal copied character by character would be mojibake, which it was.
    assert_eq(js("print(\"日本語\")\n"), "$.at(1);\n$.call(print, [\"日本語\"]);\n")

@test
a_javascript_word_a_program_used_gets_an_escape()
    // A slate identifier holds no `$`, so a trailing one names something no program can write and
    // two slate names can never mangle to one.
    assert_eq(js("""
        val class = 1
        print(class)
        """), """
        $.at(1);
        const class$ = 1n;
        $.at(2);
        $.call(print, [class$]);
        """)

@test
an_object_literal_keeps_its_keys_in_order()
    assert_eq(js("val o = { a: 1, \"b c\": 2 }\n"), """
        $.at(1);
        const o = $.obj([["a", 1n], ["b c", 2n]]);
        """)

// -- operators ------------------------------------------------------------------------------------

@test
every_operator_goes_through_the_runtime()
    // **Not JavaScript's own, and the exceptions are not worth tracking**: `7 / 2` is 3 in slate and
    // 3.5 there, `0` is true here and false there, `[1] == [1]` is true here and false there.
    assert_eq(js("print(1 + 2 * 3)\n"), """
        $.at(1);
        $.call(print, [$.arith("+", 1n, $.arith("*", 2n, 3n))]);
        """)
    assert_eq(js("val b = 1 < 2\n"), "$.at(1);\nconst b = $.compare(\"<\", 1n, 2n);\n")
    assert_eq(js("val b = [1] == [1]\n"), "$.at(1);\nconst b = $.eq($.arr([1n]), $.arr([1n]));\n")

@test
a_chain_of_comparisons_reads_each_operand_once()
    assert_eq(js("val b = 1 < 2 < 3\n"), """
        $.at(1);
        const $t1 = 1n;
        const $t2 = 2n;
        const $t3 = 3n;
        let $t4 = true;
        if ($t4) {
            $t4 = $.compare("<", $t1, $t2);
        }
        if ($t4) {
            $t4 = $.compare("<", $t2, $t3);
        }
        const b = $t4;
        """)

@test
a_short_circuit_answers_the_operand_that_decided()
    // slate's rule, not sysl's -- so neither side may be turned into a boolean, and `??` asks
    // whether the left side is THERE where `||` asks whether it is true.
    assert_eq(js("val v = null ?? 3\n"), """
        $.at(1);
        let $t1 = null;
        if (!$.present($t1)) {
            $t1 = 3n;
        }
        const v = $t1;
        """)

@test
an_interpolation_renders_its_holes_as_a_program_prints_them()
    assert_eq(js("val s = s\"a ${1 + 1} b\"\n"), """
        $.at(1);
        const s = $.interp(["a ", $.arith("+", 1n, 1n), " b"]);
        """)

@test
an_element_assigned_to_holds_its_target_and_key()
    assert_eq(js("""
        val xs = [1, 2]
        xs[0] = 5
        """), """
        $.at(1);
        const xs = $.arr([1n, 2n]);
        $.at(2);
        const $t1 = xs;
        const $t2 = 0n;
        $.setIndex($t1, $t2, 5n);
        """)

@test
a_method_call_is_not_a_call_of_a_field()
    // The receiver rule is the runtime's: an object's own field is called as it stands, and one
    // reached through a `proto` -- or answered by the builtin table -- takes the receiver in front.
    assert_eq(js("print(\"ab\".upper())\n"), """
        $.at(1);
        $.call(print, [$.method("ab", "upper", [])]);
        """)

@test
a_spread_needs_no_arm_of_its_own_in_either_kind_of_literal()
    // **Both halves of `...` arrive as nodes this back end already emits**, which is what the
    // parser's desugaring buys: an array's spread is the `Spread` a call's arguments carry, and an
    // object's is the `with` slate already had, so the interleaving order is encoded in the tree.
    assert_eq(js("""
        val xs = [1]
        val more = [0, ...xs, 3]
        """), """
        $.at(1);
        const xs = $.arr([1n]);
        $.at(2);
        const more = $.arr([0n, ...$.spread(xs), 3n]);
        """)
    assert_eq(js("""
        val props = { a: 1 }
        val merged = { ...props, b: 3 }
        """), """
        $.at(1);
        const props = $.obj([["a", 1n]]);
        $.at(2);
        const merged = $.withFields($.withAll($.obj([]), props, true), [["b", 3n]]);
        """)

// -- the forms that become statements -----------------------------------------------------------

@test
an_if_used_for_its_value_becomes_a_temporary()
    // **JavaScript has no block expression**, and an immediately-called function would take
    // `return`, `break`, `await` and `yield` away from the enclosing function.
    assert_eq(js("val v = if true then 1 else 2\n"), """
        $.at(1);
        let $t1;
        if ($.truthy(true)) {
            $t1 = 1n;
        } else {
            $t1 = 2n;
        }
        const v = $t1;
        """)

@test
an_if_with_no_else_is_null_where_the_condition_failed()
    assert_eq(js("val v = if true then 1\n"), """
        $.at(1);
        let $t1;
        if ($.truthy(true)) {
            $t1 = 1n;
        } else {
            $t1 = null;
        }
        const v = $t1;
        """)

@test
a_loop_is_labelled_whether_or_not_the_program_named_one()
    // `break 7` has to assign the loop's temporary and leave the right loop, and the two have to
    // agree when loops are nested.
    assert_eq(js("""
        var i = 0
        while i < 3
            i += 1
        """), """
        $.at(1);
        let i = 0n;
        $.at(2);
        let $t1 = null;
        let $t2 = false;
        $L3: while (true) {
            if (!$.truthy($.compare("<", i, 3n))) break $L3;
            $.at(3);
            i = $.arith("+", i, 1n);
        }
        """)

@test
a_loop_that_finished_on_its_own_takes_its_else()
    assert_eq(js("""
        var i = 0
        val v = while i < 3
            i += 1
        else
            "done"
        """), """
        $.at(1);
        let i = 0n;
        $.at(2);
        let $t1 = null;
        let $t2 = false;
        $L3: while (true) {
            if (!$.truthy($.compare("<", i, 3n))) break $L3;
            $.at(3);
            i = $.arith("+", i, 1n);
        }
        if (!$t2) {
            $.at(5);
            $t1 = "done";
        }
        const v = $t1;
        """)

@test
a_for_over_a_bare_name_binds_it_without_a_pattern()
    // The commonest binding there is, and it cannot fail -- so it is the assignment it is rather
    // than a walk over a pattern that always holds.
    //
    // **`let` and not `const`, since the body may declare the same name.** The binding is written
    // outside the run of statements that would say so and lands in the same JavaScript block, so
    // whether it is ever assigned again is not known when it is written.
    assert_eq(js("""
        for x in 1..3
            print(x)
        """), """
        $.at(1);
        let $t1 = null;
        let $t2 = false;
        $L3: for (const $t4 of $.iter($.range(1n, 3n, true))) {
            let x = $t4;
            $.at(2);
            $.call(print, [x]);
        }
        """)

@test
a_match_is_one_labelled_block_however_many_arms_it_has()
    // A chain of `else`s would put twelve arms twelve levels deep; breaking out of a labelled block
    // keeps the output as flat as the program.
    assert_eq(js("""
        val v = 3 match
            1 -> "one"
            n -> n
        """), """
        $.at(1);
        const $t1 = 3n;
        let $t2;
        $L3: {
            const $t4 = $.matched($t1, ["v", 1n]);
            if ($t4 !== null) {
                $.at(2);
                $t2 = "one";
                break $L3;
            }
            const $t5 = $.matched($t1, ["_"]);
            if ($t5 !== null) {
                let n = $t5[0];
                $.at(3);
                $t2 = n;
                break $L3;
            }
            $.noArm($t1);
        }
        const v = $t2;
        """)

@test
a_catch_binds_a_value_and_not_javascripts_exception()
    assert_eq(js("""
        val v = try
            1
        catch e
            e
        """), """
        $.at(1);
        let $t1;
        try {
            $.at(2);
            $t1 = 1n;
        } catch ($t2) {
            const e = $.caught($t2);
            $.at(4);
            $t1 = e;
        }
        const v = $t1;
        """)

@test
A_DESTRUCTURING_PARAMETERS_HIDDEN_NAME_IS_SPELLABLE_IN_JAVASCRIPT()
    // **`(0)` is unspellable in slate ON PURPOSE**, so that a synthetic parameter can never shadow
    // or be shadowed by a name a person wrote -- and JavaScript will not take it as a parameter
    // either, so `function f((0))` came out and would not parse. Every program with a destructuring
    // parameter failed to run, and nothing said so until one was written.
    assert_eq(js("""
        f({ a }) = a
        """), """
        $.at(1);
        function f($0) {
            let $t1;
            $.at(1);
            const $t2 = $0;
            const $t3 = $.unpacked($t2, ["obj", ["a"], [["_"]], [false]]);
            const a = $t3[0];
            $t1 = a;
            return $t1;
        }
        $.sig(f, ["(0)"], 1);
        """)

@test
A_PATTERNS_DEFAULT_IS_A_FLAG_ON_THE_PATTERN_AND_A_LINE_AFTER_IT()
    // **The runtime is told which entries are optional and nothing more.** What the default IS stays
    // code, emitted after the unpack, so it is worked out where the binding is -- which is what the
    // machine does too, with `JumpIfBound` in place of the `=== undefined`.
    //
    // A defaulted name is never `const`, because the line under it writes to it. Nothing can see the
    // difference: that write is the only one there is.
    assert_eq(js("""
        val { a, b = 2 } = { a: 1 }
        """), """
        $.at(1);
        const $t1 = $.obj([["a", 1n]]);
        const $t2 = $.unpacked($t1, ["obj", ["a", "b"], [["_"], ["_"]], [false, true]]);
        const a = $t2[0];
        let b = $t2[1];
        if (b === undefined) b = 2n;
        """)

    // An array pattern carries the count that is NOT optional, so the runtime's length check asks
    // the same question the machine's does.
    assert_eq(js("""
        val [x, y = 9] = [1]
        """), """
        $.at(1);
        const $t1 = $.arr([1n]);
        const $t2 = $.unpacked($t1, ["arr", [["_"], ["_"]], false, false, 1]);
        const x = $t2[0];
        let y = $t2[1];
        if (y === undefined) y = 9n;
        """)

@test
an_is_pattern_declares_its_bindings_before_the_test()
    // **The names `is` binds outlive the test**, so they are declared in front of it and filled in
    // where it held -- which a conditional expression could not do.
    assert_eq(js("""
        val p = { x: 1 }
        val got = p is { x }
        """), """
        $.at(1);
        const p = $.obj([["x", 1n]]);
        $.at(2);
        const $t1 = p;
        const $t2 = $.matched($t1, ["obj", ["x"], [["_"]], [false]]);
        let x;
        if ($t2 !== null) {
            x = $t2[0];
        }
        const got = ($t2 !== null);
        """)

// -- definitions ------------------------------------------------------------------------------------

@test
a_definition_is_a_function_and_a_generator_is_a_function_star()
    assert_eq(js("double(x) = x * 2\n"), """
        $.at(1);
        function double(x) {
            let $t1;
            $.at(1);
            $t1 = $.arith("*", x, 2n);
            return $t1;
        }
        $.sig(double, ["x"], 1);
        """)
    assert_eq(js("""
        counter()
            yield 1
        """), """
        $.at(1);
        function* counter() {
            let $t1;
            $.at(2);
            $t1 = (yield 1n);
            return $t1;
        }
        """)
    assert_eq(js("async later() = 1\n"), """
        $.at(1);
        async function later() {
            let $t1;
            $.at(1);
            $t1 = 1n;
            return $t1;
        }
        """)

@test
a_body_says_its_own_line_however_it_was_reached()
    // **A body runs at a different time from the text around it**, so what the last marker said
    // means nothing inside it: the marker in front of the definition ran when the definition did.
    // Without forgetting it, a body whose first statement is on the definition's own line begins
    // with no marker at all -- and a fault in it is then reported at the line of whatever CALLED it,
    // which is a file and a line the reader has no reason to look at.
    assert_eq(js("f() = 1\n\nprint(f())\n"), """
        $.at(1);
        function f() {
            let $t1;
            $.at(1);
            $t1 = 1n;
            return $t1;
        }
        $.at(3);
        $.call(print, [$.call(f, [])]);
        """)

@test
a_default_lands_on_the_parameter_it_belongs_to()
    // **`defaults` covers the LAST of the parameters**, so reading the two lists in step gives every
    // default to the wrong parameter -- silently, since only a call that leaves one out shows it.
    assert_eq(js("greet(name, greeting = \"hello\") = greeting\n"), """
        $.at(1);
        function greet(name, greeting = "hello") {
            let $t1;
            $.at(1);
            $t1 = greeting;
            return $t1;
        }
        $.sig(greet, ["name", "greeting"], 1);
        """)

@test
a_default_that_needs_statements_stays_inside_the_parameter_list()
    // **A default is worked out at the CALL**, so a `const` in front of the function would share one
    // value between every call that left the argument out.
    assert(js("f(xs = if true then [] else [1]) = xs\n").contains("(() => {"))
    assert(!js("f(xs = if true then [] else [1]) = xs\n").contains("const $t1 = (() => {"))

@test
a_lambda_is_a_function_expression()
    // An arrow cannot be a generator, and slate's `->` may hold a `yield`.
    assert_eq(js("val f = x -> x + 1\n"), """
        $.at(1);
        const $t1 = function(x) {
            let $t2;
            $.at(1);
            $t2 = $.arith("+", x, 1n);
            return $t2;
        };
        $.sig($t1, ["x"], 1);
        const f = $t1;
        """)

// -- a name declared twice ---------------------------------------------------------------------------

@test
a_name_declared_again_in_one_scope_is_assigned_rather_than_redeclared()
    // **slate rebinds where JavaScript refuses to redeclare.** A function written between the two
    // answers the second value, so it is one slot and not two -- and `const` twice is a
    // *SyntaxError*, which is a program that does not start rather than one that runs differently.
    assert_eq(js("val a = 1\nval a = 2\n"), """
        $.at(1);
        let a = 1n;
        $.at(2);
        a = 2n;
        """)

    // **TWO DEFINITIONS OF ONE NAME IN ONE BLOCK ARE REFUSED, AND THIS GOLDEN USED TO PIN THE
    // EMISSION.** What it pinned was the back ends disagreeing: definitions are hoisted, so the
    // interpreter's `DefineFn` overwrote the binding as it hoisted and answered `2` for a call
    // written between the two, while the emission below rebound in order and answered `1`. Neither
    // is wrong given the other's rule, so the program is refused where it stands -- see
    // `tests_lang.sysl` for the refusal and both its shapes.
    assert(js("f() = 1\nprint(f())\nf() = 2\n").contains("is declared twice in this block"))

@test
a_name_declared_again_in_a_NESTED_scope_is_an_ordinary_shadow()
    // **The block is what decides**, since a block is where JavaScript refuses a redeclaration --
    // and a name declared again inside a nested one shadows, which it is happy with.
    assert_eq(js("""
        val a = 1
        if true
            val a = 2
        """), """
        $.at(1);
        const a = 1n;
        $.at(2);
        let $t1;
        if ($.truthy(true)) {
            $.at(3);
            const a = 2n;
            $t1 = null;
        } else {
            $t1 = null;
        }
        """)

@test
a_loop_body_may_declare_the_name_the_loop_bound()
    // The binding is written outside the run of statements and lands in the same JavaScript block,
    // so a body declaring it again is redeclaring -- which is why a binder is a `let`.
    assert_eq(js("""
        for x in 1..3
            val x = 1
            print(x)
        """), """
        $.at(1);
        let $t1 = null;
        let $t2 = false;
        $L3: for (const $t4 of $.iter($.range(1n, 3n, true))) {
            let x = $t4;
            $.at(2);
            x = 1n;
            $.at(3);
            $.call(print, [x]);
        }
        """)

@test
a_name_the_parser_made_is_given_one_javascript_will_take()
    // **`(new)` is unspellable on purpose** -- it is the object a constructor is building, and a
    // name a program could write would shadow something a person wrote. It is not a JavaScript name
    // either, and `const (new) = ...` is a *SyntaxError*: the program does not start at all.
    assert(js("""
        class Pen
            new(ink) = { ink: ink }
        """).contains("const $new = $.obj("), "the object a constructor is building")

    // The same for the hidden name a destructured parameter is given.
    assert(js("f({ x }) = x\n").contains("function f($0) {"), "a destructured parameter")

// -- the line table ----------------------------------------------------------------------------------

@test
the_line_is_said_only_where_it_changed()
    // A caught fault is an object carrying `message`, `line` and `file`, and the line has to be
    // slate's -- a `catch` reading the emitted JavaScript's line would be reading a file the
    // programmer never saw. Two statements on one line cost one marker.
    assert_eq(js("""
        val a = 1
        val b = 2
        """), """
        $.at(1);
        const a = 1n;
        $.at(2);
        const b = 2n;
        """)

// -- a program of several files --------------------------------------------------------------------

@test
a_module_is_a_function_answering_its_exports_and_an_import_takes_a_field_out_of_it()
    // **The whole of a two-file program**, since what is worth pinning is the shape rather than any
    // one line of it: a module ahead of the file that imports it, its exports collected into the
    // object it answers, and the import a field taken out of that object.
    assert_eq(js_modules("tests/js/mods/two.sl"), """
            $.files(["tests/js/mods/two.sl", "tests/js/mods/lib.sl"]);

            const $m1 = (() => {
                $.at(0, 1);
                const $exports = $.obj([]);

                $.at(7, 1);
                const greeting = "hello";
                $.at(9, 1);
                function double(x) {
                    let $t1;
                    $.at(9, 1);
                    $t1 = $.arith("*", x, 2n);
                    return $t1;
                }
                $.sig(double, ["x"], 1);
                $.at(11, 1);
                const Point = $.shape(["obj", ["x", "y"], [["t", "number"], ["t", "number"]], [false, false]], "Point");
                $.at(15, 1);
                function quiet() {
                    let $t2;
                    $.at(15, 1);
                    $t2 = "unseen";
                    return $t2;
                }
                $exports.setName("greeting", greeting);
                $exports.setName("double", double);
                $exports.setName("Point", Point);

                return $exports;
            })();

            const $m0 = (() => {
                $.at(0, 0);
                const $exports = $.obj([]);

                $.at(1, 0);
                const double = $.field($m1, "double");
                const hi = $.field($m1, "greeting");
                const Point = $.field($m1, "Point");
                $.at(3, 0);
                $.call(print, [hi]);
                $.at(4, 0);
                $.call(print, [$.call(double, [21n])]);
                $.at(5, 0);
                const $t1 = $.obj([["x", 1n], ["y", 2n]]);
                const $t2 = $.matched($t1, ["obj", ["x", "y"], [["t", "number"], ["t", "number"]], [false, false]]);
                $.call(print, [($t2 !== null)]);

                return $exports;
            })();
        })();
        """)

@test
an_imported_type_is_a_value_AND_is_still_resolved_where_it_is_used()
    val made = js_modules("tests/js/mods/two.sl")

    // **Both halves, and each used to be the whole story on its own.** A type crosses a file as a
    // shape the compiler resolves -- which is why `is Point` emits the object pattern rather than a
    // name -- and it crosses as a VALUE too, so the import takes a field out of the module exactly
    // as `double` does. It took none until a type bound one, and the import path skipped it by
    // name; that skip is gone and there is one rule for every import.
    assert(made.contains("const Point = $.field($m1, \"Point\");"), "the import binds it")
    assert(made.contains("$exports.setName(\"Point\", Point);"), "and the module exported it")
    assert(made.contains("[\"obj\", [\"x\", \"y\"]"), "and what it stands for is what the test uses")

@test
a_star_import_binds_the_module_object_itself()
    assert(js_modules("tests/js/mods/star.sl").contains("const lib = $m1;"))

@test
a_package_is_a_module_like_any_other_once_it_has_been_resolved()
    // **The third import syntax, and the back end knows nothing about it.** Which file a package
    // name points at is `module_want_from`'s answer -- the compiler's own resolver, asked here so
    // that there is one rule for what a path means rather than two that can drift.
    set_package_cache("tests/cache")

    val made = js_modules("tests/proj/app.sl")

    set_package_cache("")

    assert(made.contains("const hello = $.field($m"), "a name out of one package")
    assert(made.contains("const shout = $.field($m"), "and one out of the other")

@test
one_of_slates_own_modules_is_an_object_built_over_the_builtins()
    // **A built-in module is a `Program` with no statements and an export list**, so its JavaScript
    // is its exports read out of the scope every builtin is already in -- which is the whole of the
    // mechanism here, exactly as it is for the machine.
    val made = js_program("import { now } from slate:time\nprint(1)\n")

    assert(made.contains("$exports.setName(\"now\", now);"), "the module is its names")
    assert(made.contains("const now = $.field($m1, \"now\");"), "and the import takes one out")

@test
every_module_is_a_function_of_its_own_so_a_name_it_binds_shadows_nothing()
    // **A regression test.** The entry was written out flat while the other modules were functions,
    // so every name it bound sat in the scope those functions were written in -- and `import { now }
    // from slate:time` then bound a `const now` that `slate:time` itself found when it went looking
    // for the builtin. A `const` is in its dead zone until the line that fills it, so a program that
    // imported the clock could not start.
    assert(js_program("import { now } from slate:time\nprint(1)\n").contains("const $m0 = (() => {"),
        "the entry is a function like every other module")

@test
a_marker_carries_the_file_where_a_program_has_more_than_one()
    // **A function defined in one file and called from another has to say where it was written**,
    // and the caller's next marker has to put the caller's file back -- so once there are two files
    // every marker carries one. `tests/js/mods/blames.sl` is the program that shows why.
    assert(js_modules("tests/js/mods/two.sl").contains("$.at(3, 0);"), "the file travels with the line")

    // And a program of one file says it once, a scope shared with nobody being unable to change it.
    assert_eq(js("val a = 1\n"), "$.at(1);\nconst a = 1n;\n")

// -- an annotation is checked, and says what the machine says ----------------------------------------

@test
a_declared_parameter_is_checked_against_its_type()
    // **The machine's `CheckType`, word for word.** What the reader needs is all three things: the
    // parameter, the type it was declared as, and what actually arrived.
    assert_eq(js("f(x: integer) = x\n"), """
        $.at(1);
        function f(x) {
            let $t1;
            $.at(1);
            if (!($.matches(x, ["t", "integer"]))) $.fault("`x` was declared integer, and was given " + $.plainShow(x));
            $t1 = x;
            return $t1;
        }
        $.sig(f, ["x"], 1);
        """)

@test
an_answer_annotation_is_checked_against_its_type()
    assert(js("f() -> integer = 1\n").contains(
        "$.fault(\"this answers integer, and gave back \" + $.plainShow($t2));"))

@test
the_builtins_a_host_supplies_are_built_rather_than_owed()
    // **What the suite can see of these is that they EXIST**, the emitted text for `sleep(10)` being
    // an ordinary call. That they behave as the interpreter's do is `tests/js/p7.sl` and
    // `tests/js/p8.sl`, which run the same program through both and compare what it printed -- the
    // only place a runtime's behaviour can be checked until the suite has an engine in it.
    val runtime = js_runtime()

    for name in ["setTimeout", "setInterval", "clearTimeout", "clearInterval", "sleep",
            "resolve", "reject", "pending", "settle", "fail", "writeFileSync", "writeFile",
            "renameSync", "rename", "exists", "existsSync", "env"]
        assert(runtime.contains(s"B.${name} = "), s"`${name}` is built rather than owed")

    // The fourteen that are made by a helper rather than written out, so the name is what it is
    // registered under.
    for name in ["readFileSync", "readBytesSync", "readDirSync", "statSync", "removeSync",
            "mkdirSync", "rmdirSync"]
        assert(runtime.contains(s"syncing(\"${name}\""), s"`${name}` is built rather than owed")

    for name in ["readFile", "readBytes", "readDir", "stat", "remove", "mkdir", "rmdir"]
        assert(runtime.contains(s"promising(\"${name}\""), s"`${name}` is built rather than owed")

@test
the_scripts_arguments_and_its_exit_are_the_hosts_own()
    val runtime = js_runtime()

    // **`args` is a VALUE and every other builtin is a function**, so the assertion has to be that
    // it is assigned rather than that it is owed. The loop that puts the builtins on the global
    // object copies whatever it finds, which is why nothing else was needed for a non-function.
    assert(runtime.contains("B.args = $.host.args.slice()"))
    assert(runtime.contains("B.exit = (...args) =>"))

    // **Two hosts count a command line differently and the adapter is where they are reconciled.**
    // node's `process.argv` opens with the executable and the script; quickjs's `scriptArgs` opens
    // with the script alone. A host with neither is a browser, which was asked nothing.
    assert(runtime.contains("process.argv.slice(2)"))
    assert(runtime.contains("scriptArgs.slice(1)"))

    // A host that cannot stop a program says so rather than returning, every caller of `exit` having
    // written the line after it expecting never to reach it.
    assert(runtime.contains("this host cannot stop a program"))

    // The range is checked at both ends here as it is in the interpreter, and for its reason: a
    // shell keeps the low eight bits, so a truncated 256 is a program that says it failed and is
    // recorded as having succeeded.
    assert(runtime.contains("a status is between 0 and 255"))

@test
every_name_a_built_in_module_claims_is_one_the_javascript_runtime_has()
    // **The other half of the check the machine already has.** A module declared over natives is an
    // export list and nothing else, so a name in that list which the emitted runtime does not
    // install is a module that emits and then dies on a `ReferenceError` -- and it would wait for
    // the first program to import it. The eight `slate:llhttp` names were exactly that.
    val runtime = js_runtime()
    val names = builtin_module_names()

    for i in 0..<names.len()
        val name = names.at(i)

        // A module written IN slate exports what its own statements define, so there is nothing here
        // for the runtime to owe.
        if !builtin_has_source(name)
            val exports = builtin_module(name).unwrap()

            // **Either form counts, since what matters is that the name is THERE**: a builtin that
            // is built is `B.<name> =`, and one that is not yet is a quoted entry in the owed list
            // which answers a sentence. A name in neither is the `ReferenceError`.
            for k in 0..<exports.len()
                val wanted = exports.at(k)

                assert(runtime.contains(s"\"${wanted}\"") || runtime.contains(s"B.${wanted} = "),
                    s"slate:${name} claims `${wanted}`, and the JavaScript runtime has no such name")

// -- the whole program ------------------------------------------------------------------------------

@test
a_whole_program_carries_the_runtime_and_a_scope_of_its_own()
    val made = js_program("print(1)")

    // **The module body is a function**, so a program declaring `print` shadows the builtin rather
    // than colliding with it -- the relationship the interpreter's scope chain gives them.
    assert(made.contains("const $ = (() => {"), "the runtime is part of the program")
    assert(made.contains(";(() => {"), "the module has a scope of its own")

    // **The semicolon in front of that is load-bearing**: JavaScript would otherwise read the
    // module's function as an argument to the prelude's last statement.
    assert(!made.contains("\n(() => {\n    $.files"), "the module opens with a semicolon")

@test
the_files_a_fault_may_name_are_listed_once_at_the_top()
    // **A marker names a file by its index in this list**, so that a line table costs a number per
    // statement rather than a path.
    assert(js_program("print(1)").contains("$.files([\"t\"]);"), "the files are named for a fault to carry")

// -- the driver ---------------------------------------------------------------------------------------

@test
what_slate_js_prints_is_the_program_it_wrote()
    // **A regression test for `say_lines`**, which rebuilt every line character by character out of
    // its bytes -- so a program with a wide string in it reached the terminal as mojibake while the
    // same program written to a file was correct.
    val said = cli_said(["slate", "js", "tests/js/wide.sl"])

    assert(said.contains("$.call(print, [\"日本語\"]);"), "a wide string survives being printed")

@test
a_class_pattern_emits_the_nominal_test_beside_the_fields()
    // **The two forms take one node each, and the named one hands its object half straight to the
    // ordinary object matcher** -- which is why shorthand, defaults and nesting needed nothing written
    // twice for this back end.
    //
    // **What is pinned is the emitted text, as everywhere in this file**: that these actually MATCH was
    // established by running the output under node while the feature was written, and every such
    // assertion lives in `tests_classes.sysl` against the interpreter, which the suite can run.

    assert(js("""
        class Point
            var x
            var y

        print(Point.new(1, 2) match
            Point(a, b) -> a
            _ -> 0)
        """).contains("[\"variant\", Point, [\"x\", \"y\"], [[\"_\"], [\"_\"]], \"Point\"]"), "the positional form")

    assert(js("""
        class Point
            var x
            var y

        print(Point.new(1, 2) match
            Point { y: b } -> b
            _ -> 0)
        """).contains("[\"made\", Point, [\"obj\", [\"y\"], [[\"_\"]], [false]], \"Point\"]"), "the named form")

    // **The declared name travels at the end of each nominal form and nothing that MATCHES reads
    // it.** It is there so a `mismatch` report can say `Point`, a JavaScript class knowing no name
    // of its own where the interpreter reads one off the pattern.
