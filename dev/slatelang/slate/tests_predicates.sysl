module dev.slatelang.slate
@tests

import sysl.text.Search

// A FUNCTION WHOSE BODY IS ONE TEST OF ITS PARAMETERS NARROWS ITS ARGUMENTS AT THE CALL, as
// TypeScript 5.5 infers a type predicate (`predicate.sysl`, `narrow_by_call` in `narrow.sysl`).
//
// Every refusal below is paired with the program that shows the same call narrowing where it may,
// so a test that passed because nothing narrowed at all could not pass here.

val PredPresent: string = "isPresent(m: object | null) -> boolean = m != null\n"

val PredUnnarrowed: string = "`keys` takes object | array here, and this is object | null"

// -- what a predicate narrows ------------------------------------------------------------------------

@test
A_CALL_TO_A_PREDICATE_NARROWS_ITS_ARGUMENT_AS_THE_TEST_WRITTEN_INLINE_WOULD()
    assert_eq(out(PredPresent + "f(m: object | null) = if isPresent(m) then keys(m).length else 0\nprint(f({ a: 1 }), f(null))"), "1 0")

    // `!`, an early exit, `&&` and `||` read it the same way.
    assert_eq(out(PredPresent + "f(m: object | null) = if !isPresent(m) then 0 else keys(m).length\nprint(f({ a: 1 }), f(null))"), "1 0")
    assert_eq(out(PredPresent + "f(m: object | null)\n    if !isPresent(m) then return 0\n    keys(m).length\nprint(f({ a: 1 }), f(null))"), "1 0")
    assert_eq(out(PredPresent + "f(m: object | null) = isPresent(m) && keys(m).length\nprint(f({ a: 1 }))"), "1")
    assert_eq(out(PredPresent + "f(m: object | null) = !isPresent(m) || keys(m).length\nprint(f({ a: 1 }), f(null))"), "1 true")

    // The control: the same program without the call is refused.
    assert(fails(PredPresent + "f(m: object | null) = if 1 == 1 then keys(m).length else 0\nprint(f(null))").contains(PredUnnarrowed))

@test
A_NULL_TEST_PREDICATE_NARROWS_THE_ELSE_BRANCH_TOO()
    val absent = "isAbsent(m: object | null) = m == null\n"

    assert_eq(out(absent + "f(m: object | null) = if isAbsent(m) then 0 else keys(m).length\nprint(f({ a: 1, b: 2 }), f(null))"), "2 0")

    // And says what the true side holds: the null, which has no keys.
    assert(fails(absent + "f(m: object | null) = if isAbsent(m) then keys(m) else 0\nprint(f(null))").contains("and this is null"))

@test
AN_IS_PREDICATE_NARROWS_BOTH_BRANCHES()
    val text = "isText(v: string | integer) = v is string\n"

    assert_eq(out(text + "f(v: string | integer) = if isText(v) then v.length else v + 1\nprint(f(\"abc\"), f(4))"), "3 5")
    assert_eq(out("notText(v: string | integer) = v is not string\nf(v: string | integer) = if notText(v) then v + 1 else v.length\nprint(f(\"abc\"), f(4))"), "3 5")

@test
A_CONJUNCTION_NARROWS_EVERY_PARAMETER_IT_TESTS_ON_THE_THEN_SIDE_ONLY()
    val both = "both(a: object | null, b: object | null) = a != null && b != null\n"

    assert_eq(out(both + "f(a: object | null, b: object | null) = if both(a, b) then keys(a).length + keys(b).length else 0\nprint(f({ a: 1 }, { b: 2, c: 3 }), f(null, {}))"), "3 0")

    // `&&` being false says neither was null, inline or here.
    assert(fails(both + "f(a: object | null, b: object | null) = if both(a, b) then 0 else keys(a).length\nprint(f(null, null))").contains(PredUnnarrowed))

@test
AN_ASSERT_OF_A_PREDICATE_NARROWS_THE_LINES_BELOW_IT()
    assert_eq(out(PredPresent + "f(m: object | null)\n    assert(isPresent(m))\n    keys(m).length\nprint(f({ a: 1, b: 1 }))"), "2")

@test
A_PREDICATE_HANDED_A_PATH_NARROWS_THE_PATH()
    val holder = "type Holder = { m: object | null }\n"

    assert_eq(out(PredPresent + holder + "f(o: Holder) = if isPresent(o.m) then keys(o.m).length else 0\nprint(f({ m: { z: 1 } }), f({ m: null }))"), "1 0")

    // **Its own narrowing survives its own call, and an earlier path's does not** -- the call could
    // have changed `o.n`, and the clock says the narrowing of it came first.
    val two = "type Two = { m: object | null, n: object | null }\n"

    assert_eq(out(PredPresent + two + "f(o: Two) = if o.n != null && isPresent(o.m) then keys(o.m).length else 0\nprint(f({ m: { z: 1 }, n: {} }))"), "1")
    assert(fails(PredPresent + two + "f(o: Two) = if o.n != null && isPresent(o.m) then keys(o.n).length else 0\nprint(f({ m: {}, n: {} }))").contains(PredUnnarrowed))

@test
A_LAMBDA_BOUND_BY_val_AND_ANOTHER_NAME_FOR_A_PREDICATE_ARE_PREDICATES_TOO()
    assert_eq(out("val isP = (m: object | null) -> m != null\nf(m: object | null) = if isP(m) then keys(m).length else 0\nprint(f({ q: 1 }), f(null))"), "1 0")
    assert_eq(out(PredPresent + "val alias = isPresent\nf(m: object | null) = if alias(m) then keys(m).length else 0\nprint(f({ q: 1 }), f(null))"), "1 0")

    // A `var` may be written to, so what it holds says nothing.
    assert(fails(PredPresent + "var alias = isPresent\nf(m: object | null) = if alias(m) then keys(m).length else 0\nprint(f(null))").contains(PredUnnarrowed))

@test
AN_IMPORTED_PREDICATE_NARROWS_AS_IT_DOES_AT_HOME()
    // A function, an `is` test, and one re-exported through a `val` in a file between.
    assert_eq(ran_out("tests/mods/pred_uses.sl"), "1 0 3 5 2 -1")

// -- what is not a predicate -------------------------------------------------------------------------

@test
A_BODY_OF_MORE_THAN_ONE_STATEMENT_IS_NOT_A_PREDICATE()
    assert(fails("isPresent(m: object | null)\n    val ok = m != null\n    ok\nf(m: object | null) = if isPresent(m) then keys(m).length else 0\nprint(f(null))").contains(PredUnnarrowed))
    assert(ran_fault("tests/mods/pred_uses_many.sl").contains(PredUnnarrowed))

@test
A_TRUTHINESS_PREDICATE_OVER_A_STRING_SAYS_NOTHING_ON_ITS_FALSE_SIDE()
    // **`""` is false too**, so a `string | null` the predicate turned down may still be a string.
    val filled = "filled(s: string | null) = s\nshout(s: string) = upper(s)\n"

    assert_eq(out(filled + "f(s: string | null) = if filled(s) then shout(s) else \"-\"\nprint(f(\"ab\"), f(null))"), "AB -")
    assert(fails(filled + "f(s: string | null) = if filled(s) then \"-\" else shout(s)\nprint(f(null))").contains("`shout` takes string here, and this is string | null"))

    // An object is never false, so there the false side IS the null.
    assert(fails("there(m: object | null) = m\nf(m: object | null) = if there(m) then 0 else keys(m)\nprint(f(null))").contains("and this is null"))

@test
A_PREDICATE_ON_THE_SECOND_PARAMETER_NARROWS_THE_SECOND_ARGUMENT_AND_NOT_THE_FIRST()
    val second = "second(a: object | null, m: object | null) = m != null\n"

    assert_eq(out(second + "f(a: object | null, m: object | null) = if second(a, m) then keys(m).length else 0\nprint(f(null, { x: 1 }))"), "1")
    assert(fails(second + "f(a: object | null, m: object | null) = if second(a, m) then keys(a).length else 0\nprint(f(null, {}))").contains(PredUnnarrowed))

@test
A_PARAMETER_WITH_A_DEFAULT_IS_NOT_ONE_A_PREDICATE_MAY_NAME()
    // A call that leaves it out hands the test nothing of the caller's.
    assert(fails("isPresent(m: object | null = null) = m != null\nf(m: object | null) = if isPresent(m) then keys(m).length else 0\nprint(f(null))").contains(PredUnnarrowed))

@test
A_BODY_THAT_IS_NOT_A_TEST_OF_A_PARAMETER_IS_NOT_A_PREDICATE()
    // An `||`, a test of a field, and a test of something other than a parameter.
    assert(fails("either(m: object | null, n: object | null) = m != null || n != null\nf(m: object | null) = if either(m, m) then keys(m).length else 0\nprint(f(null))").contains(PredUnnarrowed))
    assert(fails("val o = { m: null }\nlooks(m: object | null) = o.m != null\nf(m: object | null) = if looks(m) then keys(m).length else 0\nprint(f(null))").contains(PredUnnarrowed))

@test
A_PREDICATE_SHADOWED_BY_A_PARAMETER_PROMISES_NOTHING()
    assert(fails(PredPresent + "f(isPresent, m: object | null) = if isPresent(m) then keys(m).length else 0\nprint(f(x -> true, null))").contains(PredUnnarrowed))

@test
BOTH_BACK_ENDS_RUN_A_PROGRAM_NARROWED_BY_A_PREDICATE_TO_THE_SAME_ANSWER()
    val program = PredPresent + "f(m: object | null) = if isPresent(m) then keys(m).length else 0\nprint(f({ a: 1, b: 2 }), f(null))"

    assert_eq(out(program), "2 0")
    assert_eq(node_said(program), "2 0")
