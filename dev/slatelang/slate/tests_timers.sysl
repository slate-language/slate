module dev.slatelang.slate
@tests

// The timers a program arms -- `setTimeout`, `setInterval`, `clearTimeout` and `sleep` -- which ring on
// the kairos loop. **Every test here pins an ORDER or an END, and none of them a duration**: a test
// near a clock is a timing test whether or not it was written as one, and an order is what a program
// is entitled to rely on.

@test
A_PROMISE_SETTLED_BEFORE_A_TIMER_RINGS_IS_ANSWERED_FIRST()
    // **A settled promise beats a timer, even one armed before it.** The awaiting coroutine is put
    // back by the microtasks run between two passes of the loop, and a timer rings inside a pass, so
    // the resumption comes first whichever was written first.
    val prog = "setTimeout(() -> print(\"timer\"), 0)\nasync f()\n    await resolve(1)\n    print(\"resumed\")\nf()\nprint(\"sync\")"

    assert_eq(out(prog), "sync\nresumed\ntimer")

@test
A_SLEEP_AND_A_TIMER_OF_ONE_DEADLINE_RING_IN_THE_ORDER_THEY_WERE_ARMED()
    // **A `sleep` is a timer like any other and not a task that sleeps**, so it counts from the call
    // and rings in the pass a timer armed beside it rings in. The outer timer arms the inner one
    // during that pass, so the inner rings on the next -- after the sleeper has been resumed. A
    // sleep that only started counting when a task was first stepped would be a pass late, and
    // `timer` would come first.
    val prog = "async waiter()\n    await sleep(0)\n    print(\"slept\")\nwaiter()\nsetTimeout(() -> setTimeout(() -> print(\"timer\"), 0), 0)"

    assert_eq(out(prog), "slept\ntimer")

@test
TIMERS_OF_ONE_DEADLINE_RING_IN_THE_ORDER_THEY_WERE_SET()
    val prog = "setTimeout(() -> print(\"one\"), 5)\nsetTimeout(() -> print(\"two\"), 5)\nsetTimeout(() -> print(\"three\"), 5)"

    assert_eq(out(prog), "one\ntwo\nthree")

@test
SLEEPS_OF_ONE_DEADLINE_RESUME_IN_THE_ORDER_THEY_WERE_STARTED()
    val prog = "async w(name)\n    await sleep(5)\n    print(name)\nw(\"a\")\nw(\"b\")\nw(\"c\")"

    assert_eq(out(prog), "a\nb\nc")

@test
CLEARING_A_TIMER_THAT_HAS_ALREADY_RUNG_DOES_NOTHING()
    // **A one-shot is spent as it rings**, so its id names nothing afterwards: clearing it -- twice,
    // and once more after another timer has been armed and may have taken its slot -- cancels
    // nothing, and the later timer still rings.
    val prog = "var first = setTimeout(() -> print(\"first\"), 0)\nasync main()\n    await sleep(10)\n    clearTimeout(first)\n    setTimeout(() -> print(\"second\"), 0)\n    clearTimeout(first)\n    clearTimeout(first)\nmain()"

    assert_eq(out(prog), "first\nsecond")

@test
CLEARING_A_TIMER_FROM_ITS_OWN_CALLBACK_DOES_NOTHING()
    val prog = "var id = 0\nring()\n    clearTimeout(id)\n    print(\"rang\")\nid = setTimeout(ring, 0)\nsetTimeout(() -> print(\"after\"), 1)"

    assert_eq(out(prog), "rang\nafter")

@test
A_CLEARED_TIMER_NEVER_RINGS_AND_CLEARING_IT_AGAIN_DOES_NOTHING()
    val prog = "val id = setTimeout(() -> print(\"never\"), 5)\nclearTimeout(id)\nclearTimeout(id)\nsetTimeout(() -> print(\"other\"), 5)"

    assert_eq(out(prog), "other")

@test
AN_INTERVAL_KEEPS_THE_PROGRAM_RUNNING_UNTIL_IT_IS_CLEARED()
    // **The program's own statements are over before the first tick**, so every tick printed is the
    // loop being kept alive by the interval alone -- and the run ending at all is the clear inside
    // the callback cancelling the interval it was re-armed into. Re-arming AFTER the callback would
    // leave one armed past the clear and this test would never return.
    val prog = "var n = 0\nvar id = 0\ntick()\n    n += 1\n    print(\"tick\", n)\n    if n == 3 then clearInterval(id)\nid = setInterval(tick, 2)\nprint(\"armed\")"

    assert_eq(out(prog), "armed\ntick 1\ntick 2\ntick 3")

@test
AN_INTERVAL_CLEARED_FROM_ANOTHER_TIMER_STOPS_TICKING()
    val prog = "var n = 0\ntick()\n    n += 1\nval id = setInterval(tick, 1)\nasync main()\n    await sleep(20)\n    clearInterval(id)\n    val seen = n\n    await sleep(20)\n    print(seen > 0, n == seen)\nmain()"

    assert_eq(out(prog), "true true")

@test
AN_INTERVAL_A_FAULT_LEFT_ARMED_IS_CANCELLED_BY_GIVING_THE_TABLE_BACK()
    // **A program stopped by a fault ends with its interval still armed**, on a loop that belongs to
    // the process. `reset_events` has to cancel it, or the next program's drain waits on a timer that
    // nothing will ever clear.
    val complaint = out("setInterval(() -> null, 1000)\nval xs = []\nxs.pop()")

    assert(complaint != "")
    assert(loop_events().alive())

    reset_events()

    assert(!loop_events().alive())
