module dev.slatelang.slate

import sh.sysl.openssl
import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.crypto.{hmac1, hmac256, hmac384, hmac512, hmacmd5, md5, sha1, sha256, sha384, sha512}
import sysl.crypto.{pbkdf2_hmac1, pbkdf2_hmac256, pbkdf2_hmac384, pbkdf2_hmac512}
import sysl.posix.rand.entropy_from_os

// The cryptography slate's own modules stand on, and deliberately nothing above it.
//
// **Two modules reach in here and both are written in slate**: `slate:jwt` for signing and
// verifying, `slate:ws` for the one hash a WebSocket handshake needs. Everything each of those
// modules does *around* the cryptography -- base64url, the claim checks against a clock, the
// framing, the masking, the fragment reassembly -- is slate, because slate can do it. What is here
// is what slate cannot do at all, and that is the only thing that decides what goes in this file.
//
// **A token is three base64url pieces, a JSON header and a set of claims to check against a clock**,
// all of which slate can already do -- so `slate:jwt` is written in slate and this is the seam it
// stands on. What could not be done in slate at all is deciding whether a signature over
// `header.payload` was made by a given key, and that is these two functions.
//
// **THE ALGORITHM IS AN ARGUMENT BECAUSE THE `alg` HEADER IS NOT TO BE TRUSTED.** A verifier that
// read the algorithm out of the token it is checking accepts whatever an attacker wrote there, which
// is how `alg: none` and the RS256-public-key-used-as-an-HMAC-secret confusion both work. The caller
// says what it expects and the token gets no vote; `sh.sysl.openssl` draws the same line and this is
// that line reaching the language.
//
// **HMAC is the standard library's and the rest is OpenSSL's**, which is the division of labour each
// is best at: `sysl.crypto` has SHA-2 and HMAC and needs no binding, and nobody would want a second
// RSA in sysl.

// The algorithms this understands, as JOSE spells them.
private symmetric(alg: string) -> bool = alg == "HS256" || alg == "HS384" || alg == "HS512"

private asymmetric(alg: string) -> Option[openssl.Algorithm]
    if alg == "RS256" then return Some(openssl.Algorithm.Rs256)
    if alg == "RS384" then return Some(openssl.Algorithm.Rs384)
    if alg == "RS512" then return Some(openssl.Algorithm.Rs512)
    if alg == "PS256" then return Some(openssl.Algorithm.Ps256)
    if alg == "PS384" then return Some(openssl.Algorithm.Ps384)
    if alg == "PS512" then return Some(openssl.Algorithm.Ps512)
    if alg == "ES256" then return Some(openssl.Algorithm.Es256)
    if alg == "ES384" then return Some(openssl.Algorithm.Es384)
    if alg == "ES512" then return Some(openssl.Algorithm.Es512)

    None
end asymmetric

// What every algorithm this knows about is called, for a message that has to list them.
private algorithms() -> string =
    "HS256, HS384, HS512, RS256, RS384, RS512, PS256, PS384, PS512, ES256, ES384 and ES512"

// Text or bytes, since a key is a secret in one case and PEM in the other and a program has both.
private bytes_arg(v: Value, at: Span, name: string, what: string) -> Result[Buf[u8], Signal]
    v match
        Str(p) ->
            var out: Buf[u8] = buf()

            for i in 0..<p.s.bytes.len
                out.push(p.s.bytes[i])

            Ok(out)
        Array(a) -> bytes_of(a, at, name)
        other -> Err(failure(at, s"`${name}` takes ${what} as text or bytes, and this is ${other.type_name()}"))

private text_arg(v: Value, at: Span, name: string, what: string) -> Result[string, Signal]
    v match
        Str(p) -> Ok(p.s)
        other -> Err(failure(at, s"`${name}` takes ${what} as text, and this is ${other.type_name()}"))

private hmac_of(alg: string, key: []const u8, message: []const u8) -> Buf[u8]
    var out: Buf[u8] = buf()

    if alg == "HS256"
        val tag = hmac256(key, message)

        for i in 0..<tag.len
            out.push(tag[i])
    elif alg == "HS384"
        val tag = hmac384(key, message)

        for i in 0..<tag.len
            out.push(tag[i])
    else
        val tag = hmac512(key, message)

        for i in 0..<tag.len
            out.push(tag[i])

    out
end hmac_of

// **Compared in constant time, which is not superstition here.** A comparison that stops at the
// first byte that differs tells an attacker how much of a forged tag was right, and a tag can be
// guessed a byte at a time from that. The asymmetric algorithms need no such care -- verifying a
// signature is not a comparison -- which is why this is the only place it appears.
private same_tag(a: []const u8, b: []const u8) -> bool
    if a.len != b.len then return false

    var differs: u8 = 0

    for i in 0..<a.len
        differs = differs | (a[i] ^ b[i])

    differs == 0
end same_tag

private as_array(bytes: Buf[u8]) -> Value = as_array_of(bytes.view())

// The same, over a slice -- which is what a fixed-size digest is, `sha1` answering a `[20]u8`.
private as_array_of(bytes: []const u8) -> Value
    var items: Buf[Value] = buf()

    for i in 0..<bytes.len
        items.push(Int(long(bytes[i])))

    Array(new_array(items))
end as_array_of

// `jwsSign(alg, key, message)` -- the signature over `message`, as a byte array.
do_jws_sign(args: Buf[Value], at: Span) -> Step
    if args.len() != 3 then return fault(at, s"`jwsSign` takes an algorithm, a key and a message, and was given ${counted(args.len(), "argument")}")

    val alg = text_arg(args.at(0), at, "jwsSign", "the algorithm")?
    val key = bytes_arg(args.at(1), at, "jwsSign", "the key")?
    val message = bytes_arg(args.at(2), at, "jwsSign", "the message")?

    if symmetric(alg)
        val mark = root_mark()
        val made = as_array(hmac_of(alg, key.view(), message.view()))

        hold(made)
        release(mark)
        return Ok(made)

    val which = asymmetric(alg) match
        Some(a) -> a
        None -> return fault(at, s"`${alg}` is not an algorithm this understands -- there are ${algorithms()}")

    val signer = openssl.private_key(key.view()) match
        Err(e) -> return fault(at, s"this private key could not be read: ${e}")
        Ok(k) -> k

    openssl.sign(signer, which, message.view()) match
        Err(e) -> fault(at, s"this could not be signed: ${e}")
        Ok(signature) ->
            val mark = root_mark()
            val made = as_array(signature)

            hold(made)
            release(mark)
            Ok(made)
end do_jws_sign

// `jwsVerify(alg, key, message, signature)` -- whether the signature is that key's over that message.
//
// **A signature that does not check out is `false`, and a question that could not be asked is a
// fault.** A key of the wrong kind, an ECDSA signature of the wrong length, a PEM that is not a key:
// none of those is an attacker, and collapsing them into `false` would make a misconfiguration look
// like one.
do_jws_verify(args: Buf[Value], at: Span) -> Step
    if args.len() != 4 then return fault(at, s"`jwsVerify` takes an algorithm, a key, a message and a signature, and was given ${counted(args.len(), "argument")}")

    val alg = text_arg(args.at(0), at, "jwsVerify", "the algorithm")?
    val key = bytes_arg(args.at(1), at, "jwsVerify", "the key")?
    val message = bytes_arg(args.at(2), at, "jwsVerify", "the message")?
    val signature = bytes_arg(args.at(3), at, "jwsVerify", "the signature")?

    if symmetric(alg)
        return Ok(Bool(same_tag(hmac_of(alg, key.view(), message.view()).view(), signature.view())))

    val which = asymmetric(alg) match
        Some(a) -> a
        None -> return fault(at, s"`${alg}` is not an algorithm this understands -- there are ${algorithms()}")

    val checker = openssl.public_key(key.view()) match
        Err(e) -> return fault(at, s"this public key could not be read: ${e}")
        Ok(k) -> k

    openssl.verify(checker, which, message.view(), signature.view()) match
        Err(e) -> fault(at, s"this signature could not be checked: ${e}")
        Ok(good) -> Ok(Bool(good))
end do_jws_verify


// -- `slate:crypto` -------------------------------------------------------------------------------

// **The digests, HMAC, key derivation and randomness a PROGRAM reaches**, which is a different
// question from what the two modules above stand on.
//
// **The module exists because a package cannot have a native.** `slate:jwt` and `slate:ws` are
// carried in the binary and are compiled against the scope these are declared into; anything
// installed with `slate add` is not, so a package speaking a protocol with a challenge in it -- SASL,
// SCRAM, a signed webhook, an S3 request -- had no digest at all and no source of randomness at all.
// A nonce a program made up out of the clock is not a nonce, and that is the half of this that cannot
// be written in slate at any price.
//
// **What CAN be written in slate stays in slate**, which is the seam every module here is cut on:
// hex, base64 and the message layout of whatever protocol is being spoken are a package's own work,
// and `slate:jwt` writing its own base64url is the precedent. What is here is the compression
// functions and the kernel.
//
// **PBKDF2 is here rather than in a package for one reason, and it is not tidiness.** It is 4,096
// HMACs of a 32-byte message for one SCRAM handshake, which is some eight thousand SHA-256
// compressions -- seconds of interpreter time per connection, against a millisecond here. What it is
// *implemented* by is `sysl.crypto`'s, which keys the hash once and copies the keyed state per
// iteration; it was written out here until the standard library grew one.
//
// **MD5 is exported on `sha1`'s terms and for `sha1`'s reason.** It is broken, nothing new may be
// signed with it, and a client speaking PostgreSQL's `md5` authentication, HTTP Digest or an S3
// `ETag` has no say in the matter. `slate-language/pg` wrote its own in slate until this arrived.
// **`pbkdf2` does not take it**: deriving a key is the one thing here that is a program's own
// choice, and the standard library offers no PBKDF2 over MD5 to reach for.

// What every digest this knows about is called, for a message that has to list them.
private digests() -> string = "MD5, SHA-1, SHA-256, SHA-384 and SHA-512"

// The same, for key derivation, which does not take MD5.
private derivations() -> string = "SHA-1, SHA-256, SHA-384 and SHA-512"

// A fixed-size digest as a buffer, which is what everything below passes around.
private collected(bytes: []const u8) -> Buf[u8]
    var out: Buf[u8] = buf()

    for i in 0..<bytes.len
        out.push(bytes[i])

    out
end collected

// The digest by name, or nothing where the name is not one of the five.
//
// **A digest is sliced where it is answered.** Each of these hands back a `[N]u8` this frame owns,
// and a view of one that gets out of the frame moves it to the heap -- so there is nothing to bind
// first and nothing for a local to buy.
private digest_of(alg: string, data: []const u8) -> Option[Buf[u8]]
    if alg == "MD5" then return Some(collected(md5(data)[..]))
    if alg == "SHA-1" then return Some(collected(sha1(data)[..]))
    if alg == "SHA-256" then return Some(collected(sha256(data)[..]))
    if alg == "SHA-384" then return Some(collected(sha384(data)[..]))
    if alg == "SHA-512" then return Some(collected(sha512(data)[..]))

    None
end digest_of

// The same for HMAC, and the same answer where the name is not one of the five.
private hmac_by_name(alg: string, key: []const u8, message: []const u8) -> Option[Buf[u8]]
    if alg == "MD5" then return Some(collected(hmacmd5(key, message)[..]))
    if alg == "SHA-1" then return Some(collected(hmac1(key, message)[..]))
    if alg == "SHA-256" then return Some(collected(hmac256(key, message)[..]))
    if alg == "SHA-384" then return Some(collected(hmac384(key, message)[..]))
    if alg == "SHA-512" then return Some(collected(hmac512(key, message)[..]))

    None
end hmac_by_name

// PBKDF2 is `sysl.crypto`'s, one function per digest, each writing into storage the caller owns.
// It keys the hash once and copies the keyed state per iteration, so tens of thousands of iterations
// cost tens of thousands of hashes rather than twice that.
//
// **Three answers rather than two**: `None` where the name is not a digest this derives with,
// `Some(false)` where the library refused the request, and `Some(true)` where `key` was filled.
private pbkdf2_of(alg: string, password: []const u8, salt: []const u8, iterations: u32,
                  key: []u8) -> Option[bool]
    if alg == "SHA-1" then return Some(pbkdf2_hmac1(password, salt, iterations, key).is_ok())
    if alg == "SHA-256" then return Some(pbkdf2_hmac256(password, salt, iterations, key).is_ok())
    if alg == "SHA-384" then return Some(pbkdf2_hmac384(password, salt, iterations, key).is_ok())
    if alg == "SHA-512" then return Some(pbkdf2_hmac512(password, salt, iterations, key).is_ok())

    None
end pbkdf2_of

// A count of bytes, which a program writes as a number and nothing else.
private count_of(v: Value, at: Span, name: string, what: string) -> Result[usize, Signal]
    v match
        Int(n) ->
            if n < 0 then Err(failure(at, s"`${name}` takes ${what} as a count that is not negative, and this is ${n}"))
            else Ok(usize(n))
        other -> Err(failure(at, s"`${name}` takes ${what} as a number, and this is ${other.type_name()}"))

private whole_of(v: Value, at: Span, name: string, what: string) -> Result[long, Signal]
    v match
        Int(n) -> Ok(n)
        other -> Err(failure(at, s"`${name}` takes ${what} as a number, and this is ${other.type_name()}"))

// `md5(data)`, `sha1(data)`, `sha256(data)`, `sha384(data)`, `sha512(data)` -- the digest, as a byte
// array.
//
// **MD5 and SHA-1 are exported and neither is an endorsement.** Each is what an existing protocol
// asks for -- a WebSocket handshake, a Git object, an old server's SASL, PostgreSQL's `md5` login --
// and a program speaking one of those has no say in the matter. Nothing new should be signed with
// either, and no content address may be one.
do_digest(args: Buf[Value], at: Span, name: string, alg: string) -> Step
    if args.len() != 1 then return fault(at, s"`${name}` takes the data to hash, and was given ${counted(args.len(), "argument")}")

    val data = bytes_arg(args.at(0), at, name, "the data")?
    val digest = digest_of(alg, data.view()) match
        Some(d) -> d
        None -> return fault(at, s"`${alg}` is not a digest this understands -- there are ${digests()}")

    val mark = root_mark()
    val made = as_array(digest)

    hold(made)
    release(mark)
    Ok(made)
end do_digest

// `hmac(alg, key, message)` -- the tag, as a byte array.
//
// **The algorithm is an argument for the reason `jwsSign`'s is**: what a program is speaking to
// decides it, and a default would be a decision taken by whoever wrote this file rather than by the
// protocol.
do_hmac(args: Buf[Value], at: Span) -> Step
    if args.len() != 3 then return fault(at, s"`hmac` takes an algorithm, a key and a message, and was given ${counted(args.len(), "argument")}")

    val alg = text_arg(args.at(0), at, "hmac", "the algorithm")?
    val key = bytes_arg(args.at(1), at, "hmac", "the key")?
    val message = bytes_arg(args.at(2), at, "hmac", "the message")?

    val tag = hmac_by_name(alg, key.view(), message.view()) match
        Some(t) -> t
        None -> return fault(at, s"`${alg}` is not a digest this understands -- there are ${digests()}")

    val mark = root_mark()
    val made = as_array(tag)

    hold(made)
    release(mark)
    Ok(made)
end do_hmac

// `pbkdf2(alg, password, salt, iterations, length)` -- the derived key, as a byte array.
//
// **The iteration count is the caller's because the protocol says it.** SCRAM carries the server's
// count on the wire, and a client that used its own would derive a different key and be told its
// password was wrong.
do_pbkdf2(args: Buf[Value], at: Span) -> Step
    if args.len() != 5 then return fault(at, s"`pbkdf2` takes an algorithm, a password, a salt, an iteration count and a length, and was given ${counted(args.len(), "argument")}")

    val alg = text_arg(args.at(0), at, "pbkdf2", "the algorithm")?
    val password = bytes_arg(args.at(1), at, "pbkdf2", "the password")?
    val salt = bytes_arg(args.at(2), at, "pbkdf2", "the salt")?
    val iterations = whole_of(args.at(3), at, "pbkdf2", "the iteration count")?
    val length = count_of(args.at(4), at, "pbkdf2", "the length")?

    if iterations < 1 then return fault(at, s"`pbkdf2` takes at least one iteration, and was asked for ${iterations}")
    if length == 0 then return fault(at, "`pbkdf2` was asked for a key of no length")

    // The count crosses into a `u32` here, which is what the derivation takes. A number that does
    // not fit is refused rather than wrapped: a wrapped count derives a perfectly good-looking key
    // that agrees with nobody.
    if iterations > 4294967295 then return fault(at, s"`pbkdf2` takes an iteration count of at most 4294967295, and was asked for ${iterations}")

    var key: []u8 = [0u8; length]

    val filled = pbkdf2_of(alg, password.view(), salt.view(), u32(iterations), key) match
        Some(done) -> done
        None -> return fault(at, s"`${alg}` is not a digest this derives a key with -- there are ${derivations()}")

    if !filled then return fault(at, s"`pbkdf2` could not derive a key of ${length} bytes with ${alg}")

    val mark = root_mark()
    val made = as_array_of(key)

    hold(made)
    release(mark)
    Ok(made)
end do_pbkdf2

// `randomBytes(n)` -- n bytes from the kernel, as a byte array.
//
// **This is the half of the module that cannot be written in slate at any price.** Everything else
// here is a speed argument; a program has no source of unpredictability at all, and a nonce or a
// salt a program computed from the clock is neither.
do_random_bytes(args: Buf[Value], at: Span) -> Step
    if args.len() != 1 then return fault(at, s"`randomBytes` takes a count, and was given ${counted(args.len(), "argument")}")

    val n = count_of(args.at(0), at, "randomBytes", "the count")?

    if n == 0 then return fault(at, "`randomBytes` was asked for no bytes")

    var bytes: []u8 = [0u8; n]

    if !entropy_from_os(bytes)
        return fault(at, "`randomBytes` could not get randomness from the kernel, and bytes this program made up would not be worth having")

    val mark = root_mark()
    val made = as_array_of(bytes)

    hold(made)
    release(mark)
    Ok(made)
end do_random_bytes

// `timingSafeEqual(a, b)` -- whether two byte strings are the same, in time that does not say how
// much of one was right.
//
// **A comparison that stops at the first differing byte is how a tag is forged a byte at a time**,
// and `==` on two arrays is exactly that comparison. A program checking a signature it was sent
// wants this one.
do_timing_safe_equal(args: Buf[Value], at: Span) -> Step
    if args.len() != 2 then return fault(at, s"`timingSafeEqual` takes two byte strings, and was given ${counted(args.len(), "argument")}")

    val a = bytes_arg(args.at(0), at, "timingSafeEqual", "the first")?
    val b = bytes_arg(args.at(1), at, "timingSafeEqual", "the second")?

    Ok(Bool(same_tag(a.view(), b.view())))
end do_timing_safe_equal
