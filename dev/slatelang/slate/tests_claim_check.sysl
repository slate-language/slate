module dev.slatelang.slate
@tests

import sysl.text.Search

// THE MACHINE HOLDS AN EXPLICIT PREDICATE TO ITS CLAIM (`claim_check.sysl`), so a lying one faults
// in its own body instead of steering a caller's branch somewhere the run does not go.
//
// Every fault is asserted on both hosts, word for word, and every one is paired with the honest
// program that does not fault -- a check that faulted on everything would pass the first half.

val TrueLie: string = "`isText` answered true, but its claim `v is string` does not hold of what it was given -- a caller's then branch takes true to mean it does, so the predicate's body is what is wrong: `v` was 42"

val FalseLie: string = "`isText` answered false, but its claim `v is string` holds of what it was given -- a caller's else branch takes false to mean it does not, so the predicate's body is what is wrong: `v` was \"hi\""

// Both hosts refuse `prog` with `said`.
private faults_on_both(prog: string, said: string)
    assert(fails(prog).contains(said))
    assert(node_said(prog).contains(said))

// -- `-> p is T` -------------------------------------------------------------------------------------

@test
A_PREDICATE_ANSWERING_TRUE_OF_AN_ARGUMENT_THE_CLAIM_DOES_NOT_HOLD_OF_FAULTS_ON_BOTH_HOSTS()
    faults_on_both("isText(v: string | integer) -> v is string = true\nprint(isText(42))", TrueLie)

    val honest = "isText(v: string | integer) -> v is string = v is string\nprint(isText(\"a\"), isText(42))"

    assert_eq(out(honest), "true false")
    assert_eq(node_said(honest), "true false")

@test
A_PREDICATE_ANSWERING_FALSE_OF_AN_ARGUMENT_THE_CLAIM_HOLDS_OF_FAULTS_WHERE_THE_ELSE_BRANCH_LEANS_ON_IT()
    // `string` is an alternative of the parameter's union, so a caller's else branch takes it away.
    faults_on_both("isText(v: string | integer) -> v is string = false\nprint(isText(\"hi\"))", FalseLie)

    // And an undeclared parameter accepts every union, so its else branch may take `T` from any.
    faults_on_both("isText(v) -> v is string = false\nprint(isText(\"hi\"))", FalseLie)

@test
A_FALSE_ANSWER_IS_NOT_HELD_WHERE_NO_ELSE_BRANCH_COULD_LEAN_ON_IT_AND_THE_CHECKER_AGREES()
    // `integer` is not an alternative of `number`, so false says nothing -- on either side.
    val whole = "isWhole(n: number) -> n is integer = false\n"

    assert_eq(out(whole + "print(isWhole(3))"), "false")
    assert_eq(node_said(whole + "print(isWhole(3))"), "false")

    // A true answer is still held.
    assert(fails("isWhole(n: number) -> n is integer = true\nprint(isWhole(2.5))").contains("`isWhole` answered true, but its claim `n is integer` does not hold"))

    // The checker narrows such a call on its true side only, so the else branch still holds both.
    val need = "isWhole(n: number) -> n is integer = n is integer\nneed(r: real) = r\n"

    assert(fails(need + "f(x: integer | real) = if isWhole(x) then 0.0 else need(x)\nprint(f(1.5))").contains("`need` takes real here, and this is integer | real"))

    // The control: a union naming `integer` is narrowed on both sides.
    assert_eq(out("isInt(n: integer | real) -> n is integer = n is integer\nneed(r: real) = r\nf(x: integer | real) = if isInt(x) then 0.0 else need(x)\nprint(f(1.5))"), "1.5")

@test
A_return_IS_HELD_TO_THE_CLAIM_AS_FALLING_OUT_IS()
    val prog = "isText(v: string | integer) -> v is string =\n    if v is integer then return true\n    false\n"

    faults_on_both(prog + "print(isText(42))", TrueLie)
    faults_on_both(prog + "print(isText(\"hi\"))", FalseLie)

@test
THE_ARGUMENT_HELD_TO_THE_CLAIM_IS_THE_ONE_PASSED_AND_NOT_THE_PARAMETER_REASSIGNED()
    // An honest answer about what it was handed, given after the body reassigned the parameter.
    val honest = "isText(v: string | integer) -> v is string =\n    val was = v is string\n    v = 0\n    was\nprint(isText(\"a\"), isText(1))"

    assert_eq(out(honest), "true false")
    assert_eq(node_said(honest), "true false")

    // And a lie about it, which reassigning the parameter to something the claim holds of cannot hide.
    faults_on_both("isText(v: string | integer) -> v is string =\n    v = \"s\"\n    v is string\nprint(isText(42))", TrueLie)

@test
A_PREDICATE_THAT_THROWS_PROPAGATES_ITS_OWN_THROW()
    val prog = "isText(v: string | integer) -> v is string =\n    if v is integer then throw \"not text\"\n    true\nprint(isText(42))"
    val said = fails(prog)

    assert(said.contains("not text"))
    assert(!said.contains("its claim"))
    assert(node_said(prog).contains("not text"))

// -- assertions --------------------------------------------------------------------------------------

@test
AN_ASSERTION_THAT_RETURNS_FOR_AN_ARGUMENT_ITS_CLAIM_DOES_NOT_HOLD_OF_FAULTS_ON_BOTH_HOSTS()
    val sure = "sure(v: string | integer) -> asserts v is string =\n    print(\"checked\")\n"
    val said = "`sure` returned, and its claim `asserts v is string` does not hold of what it was given -- an assertion that does not hold has to throw: `v` was 1"

    faults_on_both(sure + "sure(1)", said)

    // A `return` is held as falling out is.
    faults_on_both("sure(v: string | integer) -> asserts v is string =\n    if v is integer then return\n    print(\"text\")\nsure(1)", said)

    assert_eq(out(sure + "sure(\"a\")"), "checked")
    assert_eq(node_said(sure + "sure(\"a\")"), "checked")

@test
A_BARE_ASSERTION_THAT_RETURNS_FOR_A_FALSY_ARGUMENT_FAULTS_ON_BOTH_HOSTS()
    val given = "given(n: integer) -> asserts n =\n    print(\"checked\")\n"

    faults_on_both(given + "given(0)", "`given` returned, and its claim `asserts n` does not hold of what it was given -- an assertion that does not hold has to throw: `n` was 0")

    assert_eq(out(given + "given(3)"), "checked")
    assert_eq(node_said(given + "given(3)"), "checked")
