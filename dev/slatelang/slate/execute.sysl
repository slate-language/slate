module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.str_builder

// Starting the machine, arranging a call's arguments, and the wrapper that decides whether a `catch`
// gets a fault.
//
// **`vm.sysl` owns the `Machine` and this file runs it**, which is the seam the two were already
// written across: everything here reads and writes `vm`, and nothing here defines what a `Machine`
// is. `run.sysl` is what starts one. All three want reading together -- see `vm.sysl`'s header for
// how a coroutine works, which is the arrangement they exist to serve.
//
// **THE INSTRUCTION LOOP ITSELF IS `run_frames.sysl`**, cut out when this file passed a thousand
// lines. Five names cross -- `pop`, `peek`, `arrange_named` and `invoke` go to the loop and
// `run_frames` comes back -- and the cut is where it is because everything on this side is about a
// call BEGINNING or ENDING and everything on that side is one instruction after another.
//
// **`lay_frame` and `lay_bindings` came back the other way** when the loop passed a thousand lines
// in its turn: both are about arranging a call's slots before an instruction runs, which is this
// file's subject, and two names cross to reach the loop from here.

// -- running ---------------------------------------------------------------------------------------

// The running machine, which is a field of the VM rather than module storage -- see `vm_state.sysl`.
// **A pointer taken once at the top of a function** is what keeps every `vm.<field>` below written
// the way it always was.
//
// Not `private`: reached from `run_frames.sysl` and `run.sysl`.
machine() -> *Machine = &current().machine

// Take the top of a machine's operand stack off, the machine being one the caller is already
// holding.
//
// **This is the form the instruction loop uses, and the parameter is the whole point.** `machine()`
// is `&current().machine` and `current()` is a thread-local read -- a `_tlv_get_addr` call on this
// platform, which no optimiser removes and which a `pop` written without the parameter pays on every
// instruction that takes an operand off the stack. `run_frames` already holds the pointer, so
// handing it down costs a register and takes the lookup out of the hot path altogether.
//
// Not `private`: reached from `run_frames.sysl` and `run_fused.sysl`.
pop_on(vm: *Machine) -> Value
    val v = vm.stack.at(vm.stack.len() - 1)

    vm.stack.truncate(vm.stack.len() - 1)
    v

// The same for a caller that has no machine in hand.
//
// **Kept so that a cold caller writes what it always wrote** rather than having the accessor threaded
// through a tree of functions none of which is hot.
//
// Not `private`: reached from `run_frames.sysl`.
pop() -> Value = pop_on(machine())

// Read a machine's operand stack `back` cells down without taking anything off.
//
// Not `private`: reached from `run_frames.sysl`.
peek_on(vm: *Machine, back: usize) -> Value = vm.stack.at(vm.stack.len() - 1 - back)

// Not `private`: reached from `run_frames.sysl`.
peek(back: usize) -> Value = peek_on(machine(), back)

// Run a chunk to completion and answer what it left.
//
// **`args` is a slotted chunk's arguments and is empty for every other caller.** A chunk whose
// parameters live in an `EnvObj` was given them before this was called; one whose parameters are
// slots is given them here, because the slot window does not exist until the frame does.
run_chunk(u: *Unit, start: usize, scope0: *EnvObj, args: Buf[Value]) -> Step
    val vm = machine()

    // **Where this call stops unwinding.** A native can call back into slate -- a user `equals` does
    // exactly that -- so a nested run must hand back at its own depth rather than at an empty stack.
    val floor = vm.frames.len()

    // **Where this call stops unwinding on the OTHER way out.** A `return` cuts the stack back to
    // its own base and pops its own frame; a fault cuts back nothing at all, there being thirty-five
    // places it can leave the loop from. That is harmless for the outermost run, which is over -- and
    // wrong for a nested one, which hands an `Err` to a native that carries on running: `assertFaults`
    // turns the fault into a passing assertion and returns into a machine whose frames and stack are
    // still those of the call that faulted. The next `return` then reads a frame belonging to a call
    // that is long gone.
    val sp = vm.stack.len()
    val outer_scope = vm.scope

    // **The file has to be put back, and forgetting to was a diagnostic that named the wrong file
    // entirely.** `execute` sets `current_source` from the chunk it is starting, and a nested run --
    // an `async` call routed through `start_async`, a user `equals` reached from inside a table --
    // returns into the middle of an outer `execute` whose own `chunk_ix` never changed. So the outer
    // chunk carried on stamping its faults with the callee's file: a fault three lines after
    // `await slowly(1)` was reported against `waits.sl`, at a line number that happened to exist and
    // was blank. Nothing about that message says it is pointing at the wrong file.
    val outer_source = current().current_source

    // **The caller's scope is HELD across the run, because while it runs nothing else holds it.**
    // `vm.scope` is about to become the callee's, a native pushes no frame, and a frame records the
    // scope of the call *below* it -- so for the length of a nested run the scope of the chunk that
    // called the native is in this sysl local and nowhere the collector looks. Where a closure
    // capturing it happens to be alive it survives through that; where none is yet -- a named
    // callback handed to `map`, with the lambda that keeps the scope written on the next line -- a
    // collection in the callback finalizes it, and the caller's next read of a kept name faults with
    // *"is not defined"* about a parameter it plainly has.
    val emark = env_mark()

    hold_env(outer_scope)

    vm.scope = scope0

    // A fresh run: the handlers standing here are somebody else's and stay theirs.
    val answer = execute(u, start, 0, sp, floor, outer_scope, vm.handlers.len(), true, args, 0)

    release_env(emark)

    // **Not on a park**, which is `execute`'s rule for `execute`'s reason: `Await` swapped `vm` for a
    // fresh machine before it raised `Wait`, so these numbers were taken on a machine that is no
    // longer the one standing here. Everything else -- a fault, a `skip`, an `exit` -- left this
    // machine exactly where the fault was raised, and this is the depth it was entered at.
    answer match
        Err(Wait) -> ()
        Err(_) ->
            vm.frames.truncate(floor)
            vm.stack.truncate(sp)
            vm.scope = outer_scope
        Ok(_) -> ()

    current().current_source = outer_source
    answer
end run_chunk

// Carry on from where an `await` left off.
//
// **The frame on top says where.** `Await` writes the frame it was standing in back before it parks,
// which is the one thing `execute` never does for itself -- so putting a machine back is popping that
// frame and starting the loop at the numbers in it.
//
// The floor is zero and the outer scope is null because a coroutine's machine is its own: it was
// created empty by the call that started it, so there is nothing underneath to hand back to.
//
// Not `private`: `private` in sysl is private to the *file*, and the scheduler in `async.sysl` is
// what puts a machine back.
resume_chunk(u: *Unit) -> Step
    val vm = machine()
    val back = vm.frames.at(vm.frames.len() - 1)
    val outer_source = current().current_source

    vm.frames.truncate(vm.frames.len() - 1)
    vm.scope = back.scope

    // **Everything this machine has is its own**, which is the same sentence `resume_failed` says
    // when it hands a fault to `guarded` with a floor of zero. A resumed coroutine's `try` blocks
    // came back from `parked` with it and every one of them is allowed the faults that follow.
    // **Not entering: this machine's slots are standing.** They were laid when it was started -- a
    // generator's before it had run a single instruction -- and laying them again would put the
    // arguments on top of themselves. That is why entering is said rather than guessed at from
    // `pc == 0`, which a generator resumed for the first time also satisfies.
    val answer = execute(u, back.chunk, back.pc, back.base, 0, null, 0, false, buf(), back.given)

    current().current_source = outer_source
    answer
end resume_chunk

// Carry on from an `await` whose promise FAILED, raising the signal where the `await` was written.
//
// **The machine is put back before the signal is raised, and that ordering is the whole point.** A
// coroutine's `try` blocks are its own and went into `parked` with it, so an `Err` made without
// restoring the machine would be offered to whatever happened to be running instead -- which is the
// scheduler, which has no handlers and is not the code that wrote the `await`.
//
// **Takes the `Signal` rather than building one, so the caller decides what crossed the `await`.**
// `guarded` matches `Fail` and only `Fail` -- an ordinary rejection is offered to this coroutine's
// `try` blocks, and `Quit` (`exit`, on its way out of a promise nothing caught) passes through every
// one of them unchanged, exactly as it does when it never crossed an `await` at all.
resume_failed(u: *Unit, sig: Signal) -> Step
    val vm = machine()
    val back = vm.frames.at(vm.frames.len() - 1)
    val outer_source = current().current_source

    vm.frames.truncate(vm.frames.len() - 1)
    vm.scope = back.scope
    // The frame says which file the chunk it belongs to was compiled from, so the chunk table is not
    // asked for it again.
    current().current_source = back.source

    // Everything this machine has is its own, so every handler in it is allowed the fault.
    val answer = guarded(u, Err(sig), 0, null, 0)

    current().current_source = outer_source
    answer
end resume_failed

// What calling a value came to.
//
// **The two instructions that call share everything but six lines.** Arity, the `async` detour, the
// depth limit and building the callee's scope are the same whether the function was named or reached
// through a field; what differs is only that a method may be handed the object it was found on. The
// six lines that stay behind write back the frame, which needs `run_frames`'s own locals.
//
// Not `private`: `invoke` answers one, and `run_frames.sysl` reads it.
enum Called
    // A native, or an `async` function -- there is a value already and no chunk to enter.
    Answered(v: Value)

    // An ordinary slate function: the chunk to run, the scope to run it in, and the arguments.
    //
    // **The arguments travel only for a chunk whose parameters are SLOTS**, and for one whose
    // parameters are not they are already in the scope and this is empty. A slotted chunk's scope is
    // the closure's own, unchanged and unallocated -- which is the point of the whole exercise.
    //
    // **They are a sysl local between here and the frame, which the mark phase cannot see**, so the
    // arm that receives one lays them onto the operand stack before it does anything else. Nothing
    // between the two allocates on the collected heap today, and putting them down first is what
    // makes that not need to stay true.
    // **`code` AND `source` BELONG TO `chunk` AND ARE CARRIED FOR THE REASON THE PLAN CARRIES THEM**:
    // working out that a chunk is entered reads it out of the table, and the loop would otherwise
    // read it twice more to get the two fields it goes on with.
    Enter(chunk: usize, scope: *EnvObj, args: Buf[Value], code: Buf[Ins], source: usize)

// A call's arguments in the order the callee's PARAMETERS are written.
//
// **Which parameter `b = 1` fills is a question about the callee, and the callee is a value.** So
// nothing about a named argument can be settled while compiling: the names travel in the
// instruction, the values arrive in the order they were written, and this puts the two together
// against the parameters the function turned out to have.
//
// **A skipped parameter is left as `Undefined`, which is what a HOLE is.** `f(a, b = 1, c = 2)`
// called `f(1, c: 5)` gives nothing for `b`, and `bind_arguments` leaves an `Undefined` slot unbound
// so the chunk's own head works the default out -- the same path a call that simply stopped early
// takes. A program cannot pass `undefined` itself, `keepable` having refused it at the call, so the
// marker cannot collide with a value anybody meant.
//
// **`offset` is the receiver**, which is parameter zero of a method reached through a proto and is
// already in `given` when this is called. The names cover the WRITTEN arguments only.
//
// Not `private`: reached from `run_frames.sysl`.
arrange_named(u: *Unit, callee: Value, given: Buf[Value], names: Buf[string], offset: usize, at: Span) -> Result[Buf[Value], Signal]
    callee match
        Fn(c) ->
            val chunk = u.chunks.at(c.body)

            // **A gathering function is refused rather than guessed at.** `f(a, ...rest)` has no
            // answer to "which parameter is this one" for anything past `a`: the rest parameter is
            // not a slot a name can pick out, it is everything left over. Naming an argument to one
            // is a mistake about what the function takes, and saying so is better than a rule about
            // where the surplus goes that nobody could predict.
            if chunk.variadic
                return Err(failure(at, s"${callee_named(chunk.name)} gathers what it is given with `...`, so an argument to it cannot be named"))

            var out: Buf[Value] = buf()
            var filled: Buf[bool] = buf()

            for i in 0..<c.params.len()
                out.push(Value.Undefined)
                filled.push(false)

            var next: usize = 0

            for i in 0..<given.len()
                val name = if i < offset then "" else names.at(i - offset)

                if name == ""
                    // **A positional argument past the last parameter is DROPPED**, which is what a
                    // call with no names does and what makes the two spellings one rule. There is
                    // nothing to fill and nothing to say about it.
                    if next < c.params.len()
                        out.set(next, given.at(i))
                        filled.set(next, true)
                        next += 1
                else
                    var slot = c.params.len()

                    for j in 0..<c.params.len()
                        if c.params.at(j) == name then slot = j

                    if slot == c.params.len()
                        return Err(failure(at, s"${callee_named(chunk.name)} has no parameter called `${name}` -- it takes ${param_list(c.params)}"))

                    // **Positionally as well as by name counts as twice.** `f(1, a: 2)` fills the
                    // first slot from both directions, and silently letting the later one win would
                    // make the argument that was written first do nothing.
                    if filled.at(slot)
                        return Err(failure(at, s"this call gives `${name}` twice"))

                    out.set(slot, given.at(i))
                    filled.set(slot, true)

            for i in 0..<chunk.required
                if !filled.at(i)
                    return Err(failure(at, s"this call gives nothing for `${c.params.at(i)}`, which has no default"))

            // **The trailing holes come off**, so that what reaches the ordinary arity check is the
            // count a positional call giving the same things would have given.
            var n = out.len()

            loop
                if n == 0 then break
                if filled.at(n - 1) then break

                n -= 1

            out.truncate(n)
            Ok(out)
        // A class and a data variant are made through `new`, so naming an argument to one names a
        // parameter of that -- which is where the field names are written.
        Object(_) -> hook_of(callee, "new") match
            Some(maker) -> arrange_named(u, maker, given, names, offset, at)
            None -> Err(failure(at, no_maker()))
        // **A builtin has no parameter names to match against.** Its arguments are a `Buf[Value]`
        // and the names it is documented under are in prose, so there is nothing here to look up.
        Native(_) -> Err(failure(at, "this is a builtin, and a builtin's parameters have no names an argument can pick out"))
        // Anything else is not callable at all, which `invoke` says better than this could.
        _ -> Ok(given)
end arrange_named

// The parameters a function takes, as a sentence naming them.
private param_list(params: Buf[string]) -> string
    if params.is_empty() then return "none"

    var out = str_builder()

    for i in 0..<params.len()
        if i > 0 then out.push(if i == params.len() - 1 then " and " else ", ")

        out.push(s"`${params.at(i)}`")

    out.finish()
end param_list

// Not `private`: reached from `run_frames.sysl`.
invoke(u: *Unit, callee: Value, args: Buf[Value], at: Span, depth: usize) -> Result[Called, Signal]
    callee match
        Native(f) -> Ok(Answered(call_native_buf(f, args, at)?))
        Fn(c) ->
            val chunk = u.chunks.at(c.body)

            // **TOO FEW IS NOT REFUSED EITHER, following the call rule both ways.** A parameter the
            // call left out is bound by the chunk's own guarded head
            // (`compile_required_absences`/`compile_defaults`) to `undefined` or to its default,
            // exactly as a name never given a value is elsewhere -- there is nothing left to check
            // here.
            //
            // **THE SURPLUS IS DROPPED RATHER THAN REFUSED**, which is `fit_arguments`' rule and
            // JavaScript's. It happens above the hold below, so what is held is what is bound.
            val fitted = fit_arguments(chunk, c.params.len(), args)

            // **The arguments are held while the scope is built.** They are off the operand stack by
            // now and live only in a sysl local, which the mark phase cannot see -- and a full heap
            // collects inside `new_env`. `start_async` has always guarded them for this reason; the
            // ordinary path was relying on the heap not being full at that instant.
            val mark = root_mark()

            // **The gather is ABOVE the three ways out, which is not tidiness.** A rest parameter
            // belongs to the function and not to how it is entered, so an `async` or a generator
            // must be started with the same arguments an ordinary call would bind -- and starting
            // one with the raw list would leave its rest parameter holding the first surplus
            // argument instead of an array of them. It holds what it makes, which is what lets this
            // one mark cover every path below.
            val given = gather_rest(chunk, fitted)

            for i in 0..<given.len()
                hold(given.at(i))

            // **A generator function is not called -- it is PREPARED.** The body does not run until
            // something asks it for a value, so what the caller gets back is the generator and not
            // whatever the first statement would have computed.
            //
            // **ASKED BEFORE `is_async`, AND THAT ORDER IS THE WHOLE OF WHAT MAKES AN ASYNC
            // GENERATOR ONE THING RATHER THAN TWO.** A body that is both answers a generator, and
            // its `async` half decides only what a step of it hands back: `next()` on one answers a
            // promise of `{ value, done }` where a plain generator answers the pair outright. Read
            // the other way round the body would be started as a coroutine and its first `yield`
            // would have nobody to give a value to.
            if chunk.is_gen
                val prepared = start_generator(c, given, at)

                release(mark)

                return Ok(Answered(prepared?))

            // **An `async` function is not called either, it is STARTED**, on a machine of its own,
            // and what the caller gets back is a promise rather than a result. Read here, beside
            // `is_gen`, because they are the same question asked twice: does calling this enter it?
            if chunk.is_async
                val started = start_async(c, given, at)

                release(mark)

                return Ok(Answered(started?))

            if depth >= MaxCallDepth
                release(mark)

                return Err(failure(at, s"this call is ${MaxCallDepth} deep, which is farther than slate will go -- a recursion this deep is usually one that never ends"))

            // **A chunk whose parameters are slots is entered with NO SCOPE OF ITS OWN.** The
            // closure's captured scope is what free names resolve against and is what it already
            // holds, so a call allocates nothing at all: the arguments go into the frame's own
            // cells, which the frame was going to reserve anyway.
            if chunk.slotted
                release(mark)

                return Ok(Enter(c.body, c.scope, given, chunk.code, chunk.source))

            val called = new_env(c.scope)

            // **Only the arguments that were GIVEN are bound.** A parameter with a default and no
            // argument is left unbound here, and the head of its chunk binds it -- which is what
            // lets the default be an expression rather than a constant, and lets it read the
            // parameters to its left.
            bind_arguments(called, c, given, chunk.variadic)
            release(mark)
            Ok(Enter(c.body, called, buf(), chunk.code, chunk.source))
        // **An object with a `new` is callable, and the call IS that `new`.** `Circle(3)` and
        // `Circle.new(3)` are one thing said two ways, so the lookup is the one `.` does -- through
        // the proto chain, the same field the written form would have found. What it buys is that a
        // data variant and a class read at the call site the way every other language spells making
        // one, without `new` becoming a keyword or an object becoming a function.
        //
        // **It cannot recur**, `hook_of` answering only a `Fn` or a `Native`: an object whose `new`
        // is another object is not callable at all, and says so here.
        Object(_) -> hook_of(callee, "new") match
            Some(maker) -> invoke(u, maker, args, at, depth)
            None -> Err(failure(at, no_maker()))
        External(_) -> Err(failure(at, js_host_only("calling an external")))
        other -> Err(failure(at, s"${other.type_name()} is not something that can be called"))
end invoke

// The instruction loop, with any `catch` this call owns given first refusal on a fault.
//
// **The loop itself is untouched and keeps returning `Err` the way it always has**, which is the
// whole reason this is a wrapper rather than a rewrite. A fault leaves `run_frames` from about
// thirty-five places, every one of them a `?` or a bare `return fault(...)`; threading a handler
// check through all of them would have been thirty-five chances to get it wrong. Catching a fault is
// instead re-entering the loop somewhere else, which is exactly what resuming an `await` already is.
// **`handler_floor` IS THE CALLER'S ANSWER AND MAY NOT BE READ HERE, WHICH COST A `catch` THAT NEVER
// FIRED.** Reading `vm.handlers.len()` at entry is right for a *fresh* run -- handlers already owed
// belong to whoever called the native, and a `try` in that function must not catch a fault raised
// inside a callback it never wrote. It is exactly wrong for a *resumed* one: a coroutine's handlers
// went into `parked` with it, so they are standing here on entry and a floor above them makes every
// one of them unreachable. The effect was silent and specific -- a fault raised after an `await`
// inside a `try` was not caught by that `try`, and turned up as an unhandled rejection naming a line
// three inside a block that was guarding it. It predates generators; driving one is what found it.
private execute(u: *Unit, start: usize, from: usize, base0: usize, floor: usize, outer_scope: *EnvObj,
                handler_floor: usize, entering: bool, args: Buf[Value], given0: usize) -> Step
    val floor_of_handlers = handler_floor
    val answer = guarded(u, run_frames(u, start, from, base0, floor, outer_scope, entering, args, given0), floor, outer_scope, floor_of_handlers)

    // **Not on a park.** `Await` swaps `vm` for a fresh machine before it raises `Wait`, so the
    // handlers standing here are the new machine's and the count means nothing against them. The
    // suspended machine took its own away with it, which is the point.
    answer match
        Err(Wait) -> ()
        _ -> machine().handlers.truncate(floor_of_handlers)

    answer
end execute

// Give a fault to the nearest `catch` that is allowed to have it, and run on from there.
//
// Not `private`: `async.sysl` hands a failed promise's fault to the machine that awaited it, and
// that machine's handlers are the ones owed it.
guarded(u: *Unit, first: Step, floor: usize, outer_scope: *EnvObj, floor_of_handlers: usize) -> Step
    val vm = machine()

    var outcome = first

    loop
        val caught = outcome match
            Err(Fail(at, src, message, thrown)) -> (at, src, message, thrown)
            _ -> return outcome

        if vm.handlers.len() <= floor_of_handlers then return outcome

        val (at, src, message, thrown) = caught
        val h = vm.handlers.at(vm.handlers.len() - 1)

        vm.handlers.truncate(vm.handlers.len() - 1)

        // **A DISPOSAL HANDLER RELEASES AND STANDS ASIDE**, where a `catch` stops the unwind. No
        // fault object is built and none is pushed: the resource is already on the stack, below the
        // height this handler recorded, and the instructions at `h.pc` release it and end with
        // `DisposeDone`. Whatever they answer, the signal that was travelling is put back on the
        // road -- so a fault crossing a `using` block keeps the line and the file it was raised at.
        if h.disposing
            vm.stack.truncate(h.sp)
            vm.frames.truncate(h.frames)
            vm.scope = h.scope

            // **A fault carrying a VALUE is held across the release**, which runs a program's own
            // code: the payload is in a sysl local for the length of this call and a sysl local is
            // no root, so a collection inside the release would free what the `catch` below is
            // about to be handed.
            val holding = root_mark()

            thrown match
                Some(t) -> hold(t)
                None -> ()

            run_frames(u, h.chunk, h.pc, h.base, floor, outer_scope, false, buf(), h.given) match
                // **The disposal faulted while a fault was already going**, which is the one case
                // `suppressed` exists for: the original is what the program was told about, and the
                // release's own complaint rides along with it. **Its own payload is dropped here**:
                // `suppressed` is read for a sentence and a place, and a `Value` kept on the machine
                // across everything that runs afterwards would be a root nothing walks.
                Err(Fail(a2, s2, m2, _)) -> if vm.suppressed.is_none() then vm.suppressed = Some(Fail(a2, s2, m2, None))
                _ -> ()

            release(holding)
            outcome = Err(Fail(at, src, message, thrown))
            continue
        end if

        // **The value is built before the stack is cut back, and held while it is built.** It is an
        // object, so making it allocates, and allocating collects -- and everything the program still
        // owns is on the very stack about to be truncated.
        val mark = root_mark()

        // **A fault that carries a value IS that value, and nothing is built.** The other kind -- one
        // the machine raised, or a `throw` of a string -- becomes the `{message, line, file}` object
        // every `catch` was handed before faults could carry anything.
        //
        // **A value fault carries no `suppressed` field**, so the register is emptied here rather
        // than by `fault_value`: the field belongs to the object this hands over, and the object here
        // is the program's own value -- writing a field into it would change a value the program is
        // still holding. Left set, the complaint would ride out on the next fault instead.
        val v = thrown match
            Some(t) ->
                vm.suppressed = None
                t
            None -> fault_value(u, at, src, message)

        hold(v)
        vm.stack.truncate(h.sp)
        vm.frames.truncate(h.frames)
        vm.scope = h.scope
        vm.stack.push(v)
        release(mark)

        // **The `catch` gets the mask of the frame the `try` was written in, not the faulting
        // one's.** It carries on in that chunk, and the fault may have been raised several chunks
        // away -- which is the same reason the handler records a base.
        outcome = run_frames(u, h.chunk, h.pc, h.base, floor, outer_scope, false, buf(), h.given)
end guarded

// What a `catch` binds: the sentence, and where it was raised.
//
// **An ordinary object, which is the same answer modules got.** A fault is a value a program reads,
// sorts on, prints and puts in an array, and slate objects already do all of that -- so there is no
// new kind of value here and nothing new for the collector to trace.
private fault_value(u: *Unit, at: Span, src: usize, message: string) -> Value
    val o = new_object()
    val mark = root_mark()

    hold(Object(o))

    val where = u.sources.at(src)

    obj_put_name(o, "message", str_value(message))
    obj_put_name(o, "line", Int(long(where.locate(at.start).line)))
    obj_put_name(o, "file", str_value(where.name))

    // **A disposal that faulted on the way out is a field of the fault the reader was told about.**
    // The register is emptied here because this is the one place the fault becomes something a
    // program can hold; a fault nobody catches ends the program, and the register with it.
    val vm = machine()

    vm.suppressed match
        Some(Fail(a2, s2, m2, _)) ->
            vm.suppressed = None
            obj_put_name(o, "suppressed", fault_value(u, a2, s2, m2))
        _ -> ()

    release(mark)
    Object(o)
end fault_value

// -- laying a frame ---------------------------------------------------------------------------------

// Put a chunk's slot cells on the stack before its first instruction runs, with the call's arguments
// already in them, and answer which parameters arrived.
//
// **The window begins where the stack already stands.** A call has popped its callee and its
// arguments and cut the stack back before it got here, so the top IS the callee's `base` -- which
// makes laying an argument into slot `i` a push rather than a copy into a frame built elsewhere.
//
// **THE WINDOW IS OWED TO ANY CHUNK THAT RESERVES ONE AND THE ARGUMENTS ONLY TO A SLOTTED CHUNK**,
// which is why the two answers are read off different fields. A chunk keeping its scope for one
// captured name still puts its other locals in cells, so it has a window and no laid arguments --
// its parameters were bound by name before it was entered, as they always were.
//
// **The rest rule is `bind_arguments`', and it is here because two copies of it is how they come to
// disagree.** `gather_rest` appends the gathered array, and where a DEFAULTED parameter before the
// rest went unfilled that position is the defaulted one -- so the last value goes to the last
// parameter and everything before it is positional.
//
// **A HOLE IS NOT WRITTEN AND ITS BIT STAYS 0.** `arrange_named` marks a skipped parameter with
// `Undefined`, and what it means to skip one is exactly what it means to leave one off the end: the
// cell keeps the absence it was padded with, the head of the chunk works a default out where the
// parameter has one, and no sentinel value ever sits in a slot for a `LoadSlot` to have to check for.
//
// What a call instruction does with the value it is calling.
//
// **THE THREE ARE TOLD APART BY WHETHER ANYTHING HAS TO LOOK AT THE ARGUMENTS FIRST**, which is the
// one question the call instructions ask: two of them can read the arguments where they stand and the
// third has to copy them out before it can do anything with them.
//
// Not `private`: `run_frames.sysl` matches on one.
enum CallPlan
    // A slate chunk entered with its arguments left exactly where they are.
    //
    // **IT CARRIES EVERYTHING ENTERING THAT CHUNK NEEDS, WHICH IS WHY IT IS SIX FIELDS AND NOT TWO.**
    // Deciding the plan reads the `Chunk` already; `params` and `slots` are what the window is laid
    // from and `code` and `source` are what the loop carries on with, so handing them back here is
    // what lets the ordinary call read the chunk table exactly once. A `Buf` copies with a retain,
    // which is a fraction of what copying the whole `Chunk` out of the table costs.
    InPlace(body: usize, scope: *EnvObj, params: usize, slots: usize, code: Buf[Ins], source: usize)

    // A builtin, which reads its arguments where they stand and answers a value.
    Builtin(f: NativeFn)

    // Everything else, which copies them into a buffer and asks `invoke`.
    Buffered

// Which of the three a call is.
//
// **A call's arguments are already at the position the callee's slots want them**, which is what the
// window's own design says: the stack top is the callee's `base` once the callee and the arguments
// have come off. So copying them into a buffer and pushing them back puts every value down where it
// was already standing, at the price of a malloc, a free and two copies of each one. A builtin never
// had a frame to lay, so for one the buffer bought nothing at all.
//
// **What is asked here is only whether the ordinary path is the whole story.** Everything that has to
// look at the arguments *before* the frame exists takes the buffer: a named call arranges them
// against the parameters, a spread call has them in an array rather than on the stack, a variadic one
// gathers its surplus into a fresh array, and an `async` or a generator carries them onto a machine
// of its own. A chunk that is not `slotted` binds its parameters by name into a scope, which is a
// second thing to do with them and not a place to put them.
//
// **A NAMED CALL IS THE BUFFER'S WHATEVER IT IS CALLING**, a builtin included: `arrange_named` is
// where a name is matched against a parameter list, and it is where a builtin's *having no parameter
// names* is said.
//
// Not `private`: `run_frames.sysl` is the one caller, and it is a different file.
placed_call(u: *Unit, callee: Value, names: usize, depth: usize) -> CallPlan
    if names != 0 then return Buffered

    callee match
        Fn(c) ->
            val chunk = u.chunks.at(c.body)

            if !chunk.slotted || chunk.variadic || chunk.is_async || chunk.is_gen then return Buffered

            // **The depth limit is still the ordinary path's**, so a call that has run out of room
            // goes back there and is refused with the sentence it has always been refused with.
            if depth >= MaxCallDepth then return Buffered

            InPlace(c.body, c.scope, chunk.params.len(), chunk.slots, chunk.code, chunk.source)
        Native(f) -> Builtin(f)
        // **A CONSTRUCTOR CALL IS THE SAME CALL WITH THE CALLEE LOOKED UP FIRST.** `Counter(3)` is an
        // object with a `new`, and `invoke` answers it by calling that hook with the arguments exactly
        // as they were written -- a `new` takes no receiver, the object it will make not existing yet.
        // So the arguments are already standing where that chunk's slots want them, the class sits
        // under them where a closure would have, and the whole of the move is the shift `Fn` makes.
        //
        // **The hook is asked the same question the closure is asked**, which is what keeps the two
        // paths from drifting: a `new` that is variadic, `async`, a generator or not `slotted` goes
        // back to the buffer along with everything else of that shape, and an object with no callable
        // `new` is not entered here at all -- the buffered path is where that is refused, in the one
        // sentence it has always been refused with.
        //
        // **It cannot recur past one step**, `hook_of` answering only a `Fn` or a `Native`.
        Object(_) -> hook_of(callee, "new") match
            Some(maker) -> placed_call(u, maker, names, depth)
            None -> Buffered
        _ -> Buffered
end placed_call

// Finish the frame of a call whose arguments are already standing at its `base`, and answer which
// parameters arrived.
//
// **This is `lay_frame` with the copy taken out and nothing else changed.** The surplus is dropped
// where `fit_arguments` would have dropped it, the rest of the window is padded where `lay_frame`
// would have padded it, and the mask is set for the arguments that are there.
//
// **EVERY ARGUMENT ON THIS PATH IS ONE THAT ARRIVED, so the mask is a run of ones.** A hole in the
// middle is `arrange_named`'s and a named call never comes here; `keepable` has already refused an
// `undefined` at the call, so no other value can mean "not given" either.
//
// **IT IS TOLD THE TWO COUNTS RATHER THAN LOOKING THE CHUNK UP**, because the plan that chose this
// path read the chunk to choose it: `params` is how many parameters the callee declared and `slots`
// how many cells its window is. Reading the table again here would copy the whole `Chunk` for two
// numbers, once per call.
//
// Not `private`: `run_frames.sysl` is the caller.
lay_standing(params: usize, slots: usize, argc: usize) -> usize
    val vm = machine()

    // **A SURPLUS ARGUMENT IS DROPPED RATHER THAN REFUSED**, which is `fit_arguments`' rule and
    // JavaScript's -- and here it is a truncate, there being nothing to copy it out of.
    val kept = if argc > params then params else argc

    if kept < argc then vm.stack.truncate(vm.stack.len() - (argc - kept))

    // **A PARAMETER CELL NOBODY FILLED IS PADDED WITH THE ABSENCE IT MEANS**, and a local's cell with
    // null, which is `lay_frame`'s rule and is written out in both places for the reason the rest rule
    // is: two copies of it is how they come to disagree.
    for _ in kept..<params
        vm.stack.push(Undefined)

    for _ in params..<slots
        vm.stack.push(Null)

    var given: usize = 0

    for i in 0..<kept
        given = given | (1usize << i)

    given
end lay_standing

// Run a builtin whose arguments are standing on the operand stack, and take them off once it has
// answered.
//
// **THIS IS `in_place_call` FOR BUILTINS, AND THE GEOMETRY IS THE SAME.** The value being called sits
// directly under the arguments -- the callee of `f(a, b)`, the receiver of `o.m(a, b)` -- so the
// window is `argc` cells at the top, or one more where that cell is parameter zero of a delegated
// method. Everything from there down to and including it comes off, and the answer goes where it was.
//
// **The stack is a root, so nothing is held**: for the length of the call the arguments are reachable
// exactly as any other operand is, which is what a builtin running a slate callback needs and what a
// `Buf` could never give it.
//
// **The cut is skipped after a park**, as `run_chunk`'s is: a suspended call swapped the running
// machine for a fresh one and this height belongs to the other stack.
//
// Not `private`: `run_frames.sysl`'s call instructions are the callers.
standing_native(f: NativeFn, argc: usize, with_receiver: bool, at: Span) -> Step
    val vm = machine()
    val top = vm.stack.len()

    // Where the cell under the written arguments is, which is what the whole call comes off back to.
    val under = top - argc - 1

    for i in 0..<argc
        keepable(vm.stack.at(top - argc + i), at, "passed to a function")?

    val base = if with_receiver then under else under + 1
    val count = if with_receiver then argc + 1 else argc
    val answer = call_native(f, Args(base, count), at)

    answer match
        Err(Wait) -> ()
        _ -> vm.stack.truncate(under)

    answer
end standing_native

// How many calls copied their arguments into a buffer before entering, for the whole run.
//
// **It is an instrument and it is a COUNT rather than a time**, which is `Vm.chars_scanned`'s reason:
// a benchmark can say a program got faster and cannot say that the ordinary call stopped allocating.
// `run_frames.sysl` charges it at the two call instructions.
calls_buffered() -> usize = current().args_buffered

// Not `private`: `generator.sysl` lays a generator's frame before parking its machine.
lay_frame(u: *Unit, chunk_ix: usize, args: Buf[Value]) -> usize
    val vm = machine()
    val chunk = u.chunks.at(chunk_ix)
    val n = chunk.slots

    // **A chunk that keeps its scope has only locals here**, its parameters having been bound by name
    // before it was entered, so every cell of its window is a local and starts null.
    if !chunk.slotted
        for _ in 0..<n
            vm.stack.push(Null)

        return 0

    // **A PARAMETER CELL NOBODY FILLS IS THE ABSENCE A MISSING ARGUMENT MEANS, AND THAT IS WHY A
    // REQUIRED PARAMETER NEEDS NO GUARD IN THE HEAD OF THE CHUNK.** The head used to open with a
    // `JumpIfGiven` per parameter whose only work, for a call that gave everything, was to jump over
    // the binding of an absence -- three instructions a call for a function of three parameters, on
    // functions with no defaults at all. The window says it instead, once, where it is laid.
    //
    // **This is not the sentinel `code.sysl` refuses.** `undefined` is an ordinary slate value meaning
    // exactly what a missing argument means, so a `LoadSlot` of one needs no check in front of it and
    // reads what the guarded head would have written. The mask is still the question a DEFAULT asks,
    // a default being an expression that may not be evaluated where the argument arrived.
    for _ in 0..<chunk.params.len()
        vm.stack.push(Undefined)

    for _ in chunk.params.len()..<n
        vm.stack.push(Null)

    val base = vm.stack.len() - n
    var given: usize = 0

    for i in 0..<args.len()
        val slot = if chunk.variadic && i == args.len() - 1 then chunk.params.len() - 1 else i

        args.at(i) match
            Undefined -> ()
            v ->
                vm.stack.set(base + slot, v)
                given = given | (1usize << slot)

    given
end lay_frame

// Move what a collecting match gathered into the cells the compiler claimed for it.
//
// **The gathered values stand above `mark` in `pattern_names` order**, which is the order the slots
// were claimed in, so this is a copy down and nothing else. The caller cuts the stack back.
// **A placeholder is SKIPPED rather than written**, which is what keeps the rule B1 set: no sentinel
// ever reaches a cell, so a `LoadSlot` never has to check for one and a fault raised while a default
// is being worked out cannot show a reader an `undefined` the program never wrote. The bit stays
// zero and the guarded assignment that follows fills the cell in.
// Take an answer nobody needs, there being no statement form for a call whose value is dropped.
//
// Not `private`: `run_frames.sysl` drops the mask of a collecting match it took nothing from.
discard_mask(mask: usize) = ()

// Not `private`: `run_frames.sysl` is where a collecting match lands, this being the arranging half
// of it.
lay_bindings(mark: usize, into: usize) -> usize
    val vm = machine()

    var mask: usize = 0

    for i in mark..<vm.stack.len()
        vm.stack.at(i) match
            Undefined -> ()
            v ->
                vm.stack.set(into + i - mark, v)
                mask = mask | (1usize << (i - mark))

    mask
end lay_bindings
