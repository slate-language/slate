module dev.slatelang.slate

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// Assignment as JavaScript: `x = e`, the compound and short-circuiting forms, and `a, b = b, a`,
// over a name, an index or a field.
//
// **Cut out of `js_stmt.sysl`, which keeps the statement walk and decides when an assignment is
// emitted.** Two names here are reached from there, `emit_assign` and `emit_multi_assign`, and one of
// its own is reached from here: `kept_write`, the refusal a value written to a local meets, which
// stays beside `kept_binding` because the two are one rule read at two places.

// `x = e`, `x += e` and their neighbours, over a name, an index or a field.
//
// Not `private`: `emit_stmt` in `js_stmt.sysl` emits an `Assign` through it.
emit_assign(j: *Js, op: Tok, target: Expr, value: Expr, at: Span)
    if short_circuit_assign(op)
        emit_short_assign(j, op, target, value, at)
        return

    *target.kind match
        Name(name) ->
            val v = emit_operand(j, op, target, value, at)

            // A compound assignment answers what its operator answers, which is never an absence.
            line(j, s"${js_name(name)} = ${if op == Assign then kept_write(j, name, Some(value), v) else v};")
        Index(t, k, _) ->
            val obj = emit_expr(j, t)
            val key = emit_expr(j, k)
            val a = fresh(j)
            val b = fresh(j)

            line(j, s"const ${a} = ${obj};")
            line(j, s"const ${b} = ${key};")

            var v = ""

            if op == Assign
                v = emit_expr(j, value)
            else
                v = compound(j, op, s"$$.index(${a}, ${b})", emit_expr(j, value), at)

            line(j, s"$$.setIndex(${a}, ${b}, ${v});")
        Field(t, name, _) ->
            val obj = emit_expr(j, t)
            val a = fresh(j)

            line(j, s"const ${a} = ${obj};")

            var v = ""

            if op == Assign
                v = emit_expr(j, value)
            else
                v = compound(j, op, s"$$.field(${a}, ${quoted_js(name)})", emit_expr(j, value), at)

            line(j, s"$$.setField(${a}, ${quoted_js(name)}, ${v});")
        _ -> complain(j, at, "this cannot be assigned to")
end emit_assign

// `x ??= v`, `x ||= v` and `x &&= v`.
//
// **JavaScript has all three operators and none of them is emitted**, because the value belongs
// INSIDE the test: an expression slate reads as one thing may need statements written in front of
// it here, and `x ??= f() ?? g()` would run those statements whatever the place held. The block is
// what keeps the promise that the value is not worked out at all where the place is left alone.
//
// The place's parts are held first, so an index or a field is worked out once either way.
private emit_short_assign(j: *Js, op: Tok, target: Expr, value: Expr, at: Span)
    *target.kind match
        Name(name) ->
            line(j, s"if (${writes_when(op, js_name(name))}) {")
            open(j)

            val v = kept_write(j, name, Some(value), emit_expr(j, value))

            line(j, s"${js_name(name)} = ${v};")
            close(j)
            line(j, "}")
        Index(t, k, _) ->
            val obj = emit_expr(j, t)
            val key = emit_expr(j, k)
            val a = fresh(j)
            val b = fresh(j)
            val held = fresh(j)

            line(j, s"const ${a} = ${obj};")
            line(j, s"const ${b} = ${key};")
            line(j, s"const ${held} = $$.index(${a}, ${b});")
            line(j, s"if (${writes_when(op, held)}) {")
            open(j)

            val v = emit_expr(j, value)

            line(j, s"$$.setIndex(${a}, ${b}, ${v});")
            close(j)
            line(j, "}")
        Field(t, name, _) ->
            val obj = emit_expr(j, t)
            val a = fresh(j)
            val held = fresh(j)

            line(j, s"const ${a} = ${obj};")
            line(j, s"const ${held} = $$.field(${a}, ${quoted_js(name)});")
            line(j, s"if (${writes_when(op, held)}) {")
            open(j)

            val v = emit_expr(j, value)

            line(j, s"$$.setField(${a}, ${quoted_js(name)}, ${v});")
            close(j)
            line(j, "}")
        _ -> complain(j, at, "this cannot be assigned to")
end emit_short_assign

// When a short-circuiting assignment writes: `??=` where the place is absent, `||=` where it is
// false, `&&=` where it is true.
//
// **`$.present` and not a comparison with null**, for the reason `??` itself has one: absence is a
// question slate asks of a value rather than a pair of host constants.
private writes_when(op: Tok, held: string) -> string
    if op == QQ then return s"!$$.present(${held})"
    if op == OrOr then return s"!(${held})"

    held
end writes_when

// The right-hand side of an assignment, which for `+=` is the operator applied to what is there.
private emit_operand(j: *Js, op: Tok, target: Expr, value: Expr, at: Span) -> string
    if op == Assign then return emit_expr(j, value)

    val was = emit_expr(j, target)
    val v = emit_expr(j, value)

    compound(j, op, was, v, at)
end emit_operand

// A compound assignment's operator over what is there and what is added -- both operands unveiled
// where the file declared the type, and the answer given whatever the checker proved it is owed at
// the statement. `operate_and_convert` in the interpreter, word for word.
private compound(j: *Js, op: Tok, was: string, v: string, at: Span) -> string =
    js_converted(j, at, emit_arith(j, op, js_operand(j, was), js_operand(j, v)))

// `a, b = b, a`: every value is worked out before any name is written.
//
// Not `private`: `emit_stmt` in `js_stmt.sysl` emits a `MultiAssign` through it.
emit_multi_assign(j: *Js, op: Tok, targets: Buf[Expr], values: Buf[Expr], at: Span)
    var held: Buf[string] = buf()

    for i in 0..<values.len()
        val v = emit_expr(j, values.at(i))
        val t = fresh(j)

        line(j, s"const ${t} = ${v};")
        held.push(t)

    for i in 0..<targets.len()
        if i < held.len()
            emit_assign_to(j, op, targets.at(i), held.at(i), at)
end emit_multi_assign

// An assignment whose value is already in hand.
private emit_assign_to(j: *Js, op: Tok, target: Expr, value: string, at: Span)
    *target.kind match
        Name(name) ->
            val v = if op == Assign then kept_write(j, name, None, value) else emit_arith(j, op, js_name(name), value)

            line(j, s"${js_name(name)} = ${v};")
        Index(t, k, _) ->
            val obj = emit_expr(j, t)
            val key = emit_expr(j, k)

            line(j, s"$$.setIndex(${obj}, ${key}, ${value});")
        Field(t, name, _) ->
            val obj = emit_expr(j, t)

            line(j, s"$$.setField(${obj}, ${quoted_js(name)}, ${value});")
        _ -> complain(j, at, "this cannot be assigned to")
end emit_assign_to
