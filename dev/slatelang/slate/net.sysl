module dev.slatelang.slate

import sh.sysl.kairos.uv
import sh.sysl.kairos.uv.{ByteStream, Connection, Listener}
import sh.sysl.libuv
import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{from_utf8, from_utf8_unchecked}

// TCP, as far as a language with one event loop needs it.
//
// **A socket is where this stops looking like the file system.** Every file-system call is one
// request with one answer, so every one of them is a promise and the slot that roots it is given
// back as the answer arrives. A socket is a *handle*: it is opened, it produces a run of events over
// whatever time it lives, and it ends when the program says so. So its slot is claimed once and
// surrendered only by `close`, and what a program holds is the slot's id.
//
// That split decides the shape of every builtin here:
//
// - **`connect` and `send` answer promises**, because each is one attempt with one outcome.
// - **`listen` and `onData` take callbacks**, because neither has one outcome to wait for. A
//   listener that answered a promise could answer it once, and a connection is not one connection.
//
// **A socket keeps the program alive**, exactly as a timer does and for the same reason: the slot is
// counted in `outstanding`, so a program that starts a server and reaches the end of its last
// statement does not exit. node's rule, and the reason `close` is not optional.
//
// ## kairos tasks, one per thing that waits
//
// **A socket is a kairos `Connection` or `Listener` on the `uv` driver**, and every wait is a task:
// a listener's accept loop, a connection's reader once `onData` is called (or, for a secured
// socket, once it is secured -- `net_tls.sysl`), a dial, and a small one
// per write that only hears how the write ended. Each ends in the call its libuv callback used to
// make, so every decision -- what a chunk is, what a failure tells the program, when a handshake has
// finished -- is the same code it was. **A write is issued at the call** (kairos's rule), so
// `send(a); send(b); close(c)` in one turn still puts a and b on the wire in that order.
//
// **A task carries the slot, its generation and the run's stamp, and nothing else.** It is a sysl
// frame the collector cannot see through, so it holds no `Value`; it does nothing once its slot no
// longer `holds` that generation -- the program closed the socket -- or once the stamp has moved,
// which is a reset having given the whole table back under it (`Vm.resets`).
//
// ## What a callback may capture, which is the rule `event.sysl` and `fs.sysl` also keep
//
// **A `usize` and a `Span`.** The collector cannot see through an ARC box, so a sysl closure holding
// a `Value` would hold it where the mark phase cannot find it. An id indexes the table this program
// roots; a `Span` is two integers. The slate closure a program passed lives in the slot.

// What a socket's slot holds.
//
// **`Dialling` is a slot claimed before there is a connection**, where `connect` used to make its
// socket: the generation a program is shown is the order slots were claimed in, so a connection is
// claimed where it always was and filled in when the dial answers. **`Unclaimed` is a socket that
// arrived over a channel**, which libuv cannot say was listening or connected -- so it is taken as
// whichever the program first uses it as: read from, written to or asked its address, a connection;
// handed to `listen`, a listener.
enum SockHandle
    Dialling
    Connected(c: &Connection)
    Listening(l: &Listener)
    Unclaimed(s: &uv.Socket)

// One socket, as `event.sysl`'s table holds it.
//
// Not `private`: `Pending.socket` names it.
struct Sock
    handle: SockHandle

    // Whether a task is reading it. `onData` starts one, and a second `onData` only replaces the
    // function the first one calls.
    reading: bool

    // What the reader hands over: text for `onData`, a buffer for `onBytes`. Read at each chunk, so
    // the second call decides from the next chunk on.
    as_text: bool

    // **What a secured socket decrypted before the program had a reader to hand it to**, and whether
    // its stream ended in that time. A TLS socket is read from the moment it is secured -- the
    // handshake is a conversation, and its answers arrive as reads -- so the program's own bytes can
    // arrive first. They wait here, as bytes, and go to whichever of `onData` or `onBytes` comes.
    held: Buf[u8]
    held_end: bool

    // Whether `shutdown` has ended this side's writing. `send` refuses from then on; reading goes
    // on until the peer's own end, and `close` still works.
    finished: bool
end Sock

// Close whatever a slot's socket holds. **Immediate**, as libuv's own close always was: a write the
// kernel has not taken yet is dropped, and a task waiting on the socket ends with `ECANCELED`.
//
// Not `private`: `surrender` in `event.sysl` closes a socket's slot with it.
close_sock(s: &Sock)
    s.handle match
        Dialling -> ()
        Connected(c) -> c.close()
        Listening(l) -> l.close()
        Unclaimed(u) -> u.close()

// What a leaked socket was, for the sentence `leaked_since` reports.
//
// Not `private`: `leak_description` in `event.sysl` asks it.
sock_description(s: &Sock) -> string = s.handle match
    Connected(c) -> c.local() match
        Ok(a) -> s"a TCP connection on :${a.port()}"
        Err(_) -> "a socket"
    Listening(l) -> l.port() match
        Ok(p) -> s"a TCP server on :${p}"
        Err(_) -> "a socket"
    _ -> "a socket"

// The socket in a slot, or nothing where the id names no live socket.
//
// Not `private`: `channel.sysl` passes one on.
socket_at(id: usize, gen: usize) -> Option[&Sock]
    if !holds(id, gen) then return None

    current().pending.at(id).socket
end socket_at

// The connection in a slot. **A socket that arrived over a channel is taken as one here**, which is
// how it is used nearly always -- a supervisor hands its workers the connections it accepted.
//
// Not `private`: `channel.sysl` passes a connection on.
connection_at(id: usize, gen: usize) -> Option[&Connection]
    val s = socket_at(id, gen) match
        None -> return None
        Some(it) -> it

    s.handle match
        Connected(c) -> Some(c)
        Unclaimed(u) -> u.connection() match
            Ok(c) ->
                s.handle = Connected(c)
                Some(c)
            Err(_) -> None
        _ -> None
end connection_at

// The socket a builtin was handed, as the slot and generation that name it -- or the complaint about
// what it was handed instead.
//
// Not `private`: `net_tls.sysl` reads the socket `startTls` and `alpnProtocol` were handed.
socket_of(v: Value, at: Span, name: string) -> Result[(usize, usize), Signal]
    v match
        Socket(i, g) ->
            val id = usize(i)
            val gen = usize(g)

            if socket_at(id, gen).is_some() then Ok((id, gen)) else Err(failure(at, s"this socket is closed, and `${name}` needs an open one"))
        other -> Err(failure(at, s"`${name}` takes a socket, and this is ${other.type_name()}"))

// Take a slot for a socket, and put the slate callback that goes with it in the same place.
//
// **`repeating` is true and nothing ever fires it.** The flag is what stops `fire` from spending a
// slot when its callback runs, and a socket's slot is spent by `close` alone -- so the value that
// means "not one-shot" is the right one here even though this is not a timer.
//
// Not `private`: `channel.sysl` holds a socket that arrived over a channel in the same table, which
// is what keeps the loop alive while one is open and closes it when the slot goes.
hold_socket(h: SockHandle, cb: Value) -> Value
    val s: &Sock = Sock(h, false, false, buf(), false, false)
    val id = claim(Pending(cb, Null, null, None, Some(s), true, true, 0, 0))

    socket_value(id, gen_at(id))
end hold_socket

// A socket's value, from the slot and generation `event.sysl` hands out. **Every socket a program
// sees is made here**, the two halves being 32 bits each in a `Value` (see `Value.Socket`).
private socket_value(id: usize, gen: usize) -> Value = Socket(u32(id), u32(gen))

// Whether a task spawned for this slot is still about the socket in it. See the header.
private owns(id: usize, gen: usize, stamp: usize) -> bool = same_run(stamp) && holds(id, gen)

// The slate callback a socket's slot is holding.
private callback_of(id: usize, gen: usize) -> Value
    if !holds(id, gen) then return Null

    current().pending.at(id).callback
end callback_of

// Replace it, which is what a second `onData` on one socket does.
private set_callback(id: usize, gen: usize, cb: Value)
    if !holds(id, gen) then return

    var slot = current().pending.at(id)

    slot.callback = cb
    current().pending.set(id, slot)
end set_callback

// The function this socket's slot is holding for a failure, or `Null` where nobody registered one.
private error_callback_of(id: usize, gen: usize) -> Value
    if !holds(id, gen) then return Null

    current().pending.at(id).on_error

// Replace it, which is what a second `onError` on one socket does. **Separately from the reader**,
// which is the whole reason it is a slot of its own -- see `error_socket`.
private set_error_callback(id: usize, gen: usize, cb: Value)
    if !holds(id, gen) then return

    var slot = current().pending.at(id)

    slot.on_error = cb
    current().pending.set(id, slot)
end set_error_callback

// Call a socket's slate callback with one argument. **The end of a stream nobody is reading yet is
// held rather than dropped**, so the reader a program registers later is still told it.
private deliver(id: usize, gen: usize, v: Value)
    v match
        Null -> if holding(id, gen)
            socket_at(id, gen).unwrap().held_end = true
            return
        _ -> ()

    call_slate(callback_of(id, gen), v)
end deliver

// Whether what arrives on this socket is to be held rather than handed over: there is no reader yet,
// or there is one and what arrived before it has not reached it yet -- the order is the stream's.
private holding(id: usize, gen: usize) -> bool
    val s = socket_at(id, gen) match
        None -> return false
        Some(it) -> it

    callback_of(id, gen) match
        Null -> true
        _ -> s.held.len() > 0 || s.held_end
end holding

// Hand a newly registered reader what was held for it, on the next turn rather than inside the
// `onData` call -- so the statements after that call run first, as they would for any arrival.
private async release_held(id: usize, gen: usize, stamp: usize)
    if !owns(id, gen, stamp) then return

    val s = socket_at(id, gen).unwrap()
    val bytes = s.held

    s.held = buf()

    if bytes.len() > 0 then handed_over(id, gen, bytes.view(), s.as_text)

    if s.held_end && owns(id, gen, stamp)
        s.held_end = false
        deliver(id, gen, Null)
end release_held

// The same call, given the function rather than the slot it came out of. `Null` is nobody to call
// and not an error: a socket the program has not read from yet has no callback in it.
//
// **A fault inside it stops the program**, as it does for a timer and for the same reason: the loop
// is not running a statement, so there is nothing to attach the complaint to but the whole run.
// That is a fault in the program's OWN code, and is a different thing from the socket failing.
private call_slate(cb: Value, v: Value)
    cb match
        Null -> return
        _ -> ()

    var args: Buf[Value] = buf()
    val mark = root_mark()

    hold(cb)
    hold(v)
    args.push(v)

    apply_callback(cb, args, point(0), "onData") match
        Ok(_) -> ()
        Err(s) -> current().loop_fault = Some(s)

    release(mark)
end call_slate

// Hand this socket's failure to the function the program registered, and say whether there was one.
private failure_told(id: usize, gen: usize, message: string) -> bool
    val fn = error_callback_of(id, gen)

    fn match
        Null -> return false
        _ -> ()

    // The mark is taken before the string is made, not after: everything allocated inside it is what
    // `release` gives back, and a value made before it has nothing rooting it in between.
    val mark = root_mark()
    val said = str_value(message)

    hold(said)
    call_slate(fn, said)
    release(mark)

    true
end failure_told

// This socket has failed while the program was reading it.
//
// **A PEER MAY NOT STOP THE PROGRAM, AND BEFORE THIS ONE COULD.** A connection reset -- which any
// client can produce, deliberately or by being unplugged -- reached `loop_fails` and ended the whole
// run, so every slate server was killable from outside by a client that hung up rudely. It is the
// same argument the failed handshake below is already decided by, and there was no reason for a
// plain socket to be the exception.
//
// **Where the program registered no handler the failure arrives as the end of the stream**, which is
// what the ordinary reader already copes with: `if chunk == null then close(c)` is right whether the
// peer finished or vanished. What such a program cannot do is tell the two apart -- which is what
// `onError` is for, and why not registering one has to mean something rather than being refused.
//
// Not `private`: `secured` in `net_tls.sysl` ends a stream whose handshake failed with it.
stream_failed(id: usize, gen: usize, message: string)
    if !failure_told(id, gen, message) then deliver(id, gen, Null)

// Stop the program with a sentence of slate's own, from inside a callback.
//
// Not `private`: `server.sysl` reports a handler's fault the same way.
loop_fails(message: string)
    current().loop_fault match
        Some(_) -> ()
        None -> current().loop_fault = Some(failure(point(0), message))

// -- what a program calls --------------------------------------------------------------------------

// `listen(port, onConnection)` -- a server, accepting on every interface.
//
// **A port of `0` asks the kernel for one**, which is what `localPort` is for and what lets a test
// run without choosing a number no other program is using.
//
// **`secure` is what makes it HTTPS**, and it is here rather than beside `serve` because TLS is a
// transport: a listener told a certificate hands out connections whose bytes are already decrypted,
// so `slate:http` and anything else written over these sockets works over TLS unchanged.
//
// **`reuse_port` is `SO_REUSEPORT`**, asking the kernel to spread accepted connections across every
// process that binds the same port with it set, rather than giving the port to one listener alone --
// the foundation of a worker cluster. It is refused rather than silently doing something else on a
// kernel that does not distribute this way -- `ENOTSUP`, macOS included -- and the failure below is
// that refusal in the ordinary "cannot listen" sentence.
//
// **kairos binds and listens in one call**, so the probe below asks about a port this server is
// already listening on, and a TLS setup that fails closes a listener that is already open. Nothing
// is accepted before the loop turns, so neither is anything a program can see.
listen_socket(port: long, secure: Option[Secure], reuse_port: bool, cb: Value, at: Span) -> Step
    cb match
        Fn(_) -> ()
        Native(_) -> ()
        HostFn(_) -> ()
        other -> return fault(at, s"`listen` needs a function to call with each connection, and this is ${other.type_name()}")

    if port < 0 || port > 65535 then return fault(at, s"a port is between 0 and 65535, and this is ${port}")

    var server = listen_any(port, reuse_port)

    // **A port of `0` is a promise of a FREE port, and on macOS the dual-stack bind does not keep
    // it.** The kernel's choice for `::` does not avoid a port some other process holds on
    // `127.0.0.1` alone, and the bind succeeds -- after which a client dialling `127.0.0.1` (or
    // `localhost`, which `connect` resolves to IPv4 first) reaches THAT listener and not this one.
    // It answers a stranger's bytes or a failed handshake, once in a few hundred runs on a machine
    // with other servers on it, and nothing in the sentence names a port. So a kernel choice that
    // someone else holds on the IPv4 loopback is handed back and another is asked for. A port the
    // PROGRAM named is its own business, and is left exactly as it was.
    var tries = 0

    while port == 0 && tries < PortTries
        val l = server match
            Ok(it) -> it
            Err(_) -> break

        val chosen = l.port() match
            Ok(p) -> p
            Err(_) -> break

        if loopback_free(chosen) then break

        tries += 1
        l.close()
        server = listen_any(port, reuse_port)

    val listener = server match
        Err(e) -> return fault(at, e)
        Ok(l) -> l

    serving(listener, secure, cb, at)
end listen_socket

// `listen(socket, onConnection)` -- accept on a listening socket another program passed over a
// channel. **The socket is already bound and listening**, so there is no port to choose and nothing
// to secure: a supervisor that wants TLS hands out the connections, which is the default anyway.
listen_passed(v: Value, cb: Value, at: Span) -> Step
    cb match
        Fn(_) -> ()
        Native(_) -> ()
        HostFn(_) -> ()
        other -> return fault(at, s"`listen` needs a function to call with each connection, and this is ${other.type_name()}")

    val (id, gen) = socket_of(v, at, "listen")?
    val s = socket_at(id, gen).unwrap()

    val passed = s.handle match
        Unclaimed(u) -> u
        Listening(_) -> return fault(at, "this socket is already listening")
        _ -> return fault(at, "`listen` takes a socket another program was listening on, and this one is a connection")

    val l = passed.listen() match
        Err(e) -> return fault(at, s"cannot listen on this socket: ${e}")
        Ok(it) -> it

    // **The socket keeps its slot and its value**, so the program goes on holding the one it was
    // handed -- `close` on it stops the listening, and `localPort` answers the port it is on.
    s.handle = Listening(l)
    set_callback(id, gen, cb)
    loop_events().spawn(accepting(id, gen, run_stamp(), l))

    Ok(v)
end listen_passed

// A listener that is open, put in a slot and accepting.
private serving(l: &Listener, secure: Option[Secure], cb: Value, at: Span) -> Step
    val held = hold_socket(Listening(l), cb)
    val (id, gen) = socket_slot(held)

    secure match
        None -> ()
        Some(how) ->
            tls_serve(id, how.certificate.view(), how.key.view(), how.alpn.view()) match
                Err(e) ->
                    surrender(id)
                    return fault(at, e)
                Ok(_) -> ()

    loop_events().spawn(accepting(id, gen, run_stamp(), l))
    Ok(held)
end serving

// How many kernel choices `listen(0)` hands back before settling for one. Another process holding the
// chosen port on the IPv4 loopback is rare, so a second choice is nearly always the last.
private const PortTries: int = 16

// A listener on every address, both families, at this port -- or the sentence for why there is none.
//
// **`::` RATHER THAN `0.0.0.0`, WHICH IS WHAT MAKES `localhost` REACH THIS SERVER.** A dual-stack
// socket accepts IPv4 connections as mapped addresses, so `127.0.0.1` still arrives -- and
// `localhost` resolves to `::1` first on every machine that follows RFC 6724, which is all of them.
// Bound to IPv4 alone, a slate server was simply not there for a client that asked for it by name,
// and the failure was `ECONNREFUSED` -- which reads as nothing listening.
//
// **A host with no IPv6 at all falls back**, since the listen is what says so and there is nothing to
// be gained by refusing to serve. The sentence is the fallback's, which says the same thing about a
// port that is taken or a kernel that refuses `reusePort`.
private listen_any(port: long, reuse_port: bool) -> Result[&Listener, string]
    libuv.ip6("::", int(port)) match
        Err(_) -> ()
        Ok(a) -> current().io.listen(a, reuse_port = reuse_port) match
            Ok(l) -> return Ok(l)
            Err(_) -> ()

    val addr = libuv.ip4("0.0.0.0", int(port)) match
        Err(e) -> return Err(s"this address could not be read: ${e}")
        Ok(a) -> a

    current().io.listen(addr, reuse_port = reuse_port) match
        Err(e) -> Err(s"cannot listen on port ${port}: ${e}")
        Ok(l) -> Ok(l)
end listen_any

// Whether nothing else is listening on `127.0.0.1` at `port`.
//
// **The probe is a bind AND a listen**, because libuv defers `EADDRINUSE` from the bind to whichever
// of `listen` or `connect` comes next -- and `io.listen` is both. libuv sets `SO_REUSEADDR` on every
// socket, which is what lets the probe take the specific address beside this server's wildcard -- a
// wildcard that is already listening -- while still being refused by a listener that holds that
// exact address.
//
// Not `private`: `tests_io.sysl` asks it with a squatter standing on the port, the kernel's own
// choice of port being something no test can arrange.
loopback_free(port: int) -> bool
    val addr = libuv.ip4("127.0.0.1", port) match
        Err(_) -> return true
        Ok(a) -> a

    current().io.listen(addr, 1) match
        Err(_) -> false
        Ok(probe) ->
            probe.close()
            true
end loopback_free

// The slot and generation inside a socket value, for the places here that made one and know it is a
// socket.
// Not `private`, for `hold_socket`'s reason.
socket_slot(v: Value) -> (usize, usize) = v match
    Socket(id, gen) -> (usize(id), usize(gen))
    _ -> (0, 0)

// A listener's accept loop, one connection at a time for as long as its slot holds it. **Closing the
// listener is what ends it**: the accept waiting at the time ends with `ECANCELED`, and the slot has
// already gone.
private async accepting(id: usize, gen: usize, stamp: usize, l: &Listener)
    loop
        val got = await l.accept()

        if !owns(id, gen, stamp)
            got match
                Ok(c) -> c.close()
                Err(_) -> ()

            return

        got match
            Err(e) ->
                loop_fails(s"a connection could not be accepted: ${e}")
                return
            Ok(c) -> accepted(id, gen, c)
end accepting

// One connection has arrived.
private accepted(id: usize, gen: usize, conn: &Connection)
    // **The connection gets a slot of its own with no callback yet.** It is the program's to read
    // from, write to and close, and until it calls `onData` there is nothing to deliver anything to.
    val made = hold_socket(Connected(conn), Null)
    val (cid, _) = socket_slot(made)

    // **The connection belongs to whoever opened the LISTENER, and not to whatever is running when it
    // arrives.** A client dials when it likes, so the slot is claimed inside whichever of `slate
    // test`'s scopes the loop happened to be turning in -- and a server a `@setupAll` opened goes on
    // accepting for the whole file. Without this a test waits for a connection it never asked for,
    // reports it as its own leak, and closes it under the tests still to come.
    inherit_scope(id, cid)

    // **The handshake drives itself from here**: the connection is read at once, so a program that
    // registers its reader late -- after an `await` in the connection callback, say -- still has its
    // handshake finished, and whatever the client sent it in the meantime is held for that reader.
    if tls_listener(id)
        tls_accepted(id, cid) match
            Err(e) ->
                surrender(cid)
                loop_fails(e)
                return
            Ok(_) -> ()

        read_for_tls(cid, gen_at(cid))

    deliver(id, gen, made)
end accepted

// `connect(host, port)` -- a promise of a connected socket.
//
// **`host` IS A NAME AND NOT ONLY AN ADDRESS**, which is what puts a hosted service in reach: a
// program dialling `db.example.com` has to be able to say `db.example.com`, and not only because
// typing an address is tiresome. **TLS verifies a NAME**, so a program that had resolved the name
// itself would arrive at `startTls` holding an address and have nothing left to check a certificate
// against -- and the only ways out of that are to trust whatever certificate turns up, or to carry
// the name alongside the address by hand. Resolving here is what keeps the name where the handshake
// needs it.
//
// The resolver is libuv's, on its thread pool, which is the same one `fetch` uses.
//
// **AN ADDRESS THAT IS ALREADY WRITTEN OUT DOES NOT GO TO THE RESOLVER.** `getaddrinfo` is a call
// onto a system service whose latency nothing here bounds, and asking it what `127.0.0.1` means puts
// that wait in front of a connection whose destination was never in doubt. `libuv.ip` is `inet_pton`
// and answers from the text alone, so a literal is dialled directly and everything else takes the
// path above. node draws the line in the same place, and for the same reason.
//
// **The fallback is not a formality**: `inet_pton` is stricter than the resolver, which still reads
// `127.1` and `2130706433` as addresses, so a form it refuses is a name as far as this is concerned
// and is looked up exactly as it always was.
connect_socket(host: string, port: long, at: Span) -> Step
    if port < 0 || port > 65535 then return fault(at, s"a port is between 0 and 65535, and this is ${port}")

    // The promise is made before the lookup starts, because the lookup can fail and a failure has to
    // have somewhere to go -- and a name that does not resolve is a connection that did not happen,
    // which is a settled promise and not a thrown complaint.
    val waiting = begin_request()
    val promised = awaited_request(waiting)
    val what = s"cannot connect to ${host}:${port}"
    val ask = Asked(waiting, gen_at(waiting), run_stamp(), at)

    libuv.ip(host, int(port)) match
        Ok(written) ->
            // **Two slots, and they are not the same thing.** One holds the socket for as long as the
            // program has it; the other roots the promise for the length of the attempt and is given
            // back when the attempt finishes. Settling the promise would otherwise take the socket
            // with it.
            val (id, gen) = socket_slot(hold_socket(Dialling, Null))

            loop_events().spawn(dialled(ask, id, gen, written, what))
        Err(_) -> loop_events().spawn(resolving(ask, host, port, what))

    Ok(promised)
end connect_socket

// The request a task answers: its slot, the generation it was claimed with, the run it belongs to,
// and where the call that made it was written.
//
// Not `private`: `net_half.sysl` answers a `shutdown` with the same shape.
struct Asked
    id: usize
    gen: usize
    stamp: usize
    at: Span

// Whether the request a task was spawned for is still waiting on it.
still_asked(a: Asked) -> bool = same_run(a.stamp) && holds(a.id, a.gen)

// Look the name up, then dial what it answered.
//
// **The port goes in as the SERVICE**, which is what puts it in the address the resolver answers
// with; there is no way to set one on an `Address` afterwards. `client.sysl` says the same thing.
//
// **The first IPv4 answer is preferred, and any answer will do where there is none.** A resolver
// hands back every way it found and the ordering is the system's, so `localhost` on this machine
// answers `::1` ahead of `127.0.0.1` -- and a program that listened with `listen` and connected to
// its own port would then be refused, because a slate listener binds IPv4. Preferring one family is
// the smallest thing that keeps those two agreeing, and it costs nothing on a host that has only
// the other. **Walking the whole list on a refusal is what a browser does** and is what this should
// grow into; it would change nothing above.
private async resolving(ask: Asked, host: string, port: long, what: string)
    val got = await current().io.resolve(host, s"${port}")

    if !still_asked(ask) then return

    val found = got match
        Err(e) ->
            refuse_request(ask.id, ask.at, s"cannot find ${host}", e)
            return
        Ok(answers) -> answers

    if found.len == 0
        deny_request(ask.id, ask.at, s"there is no address for ${host}")
        return

    var pick: usize = 0

    for i in 0..<found.len
        if found[i].family == libuv.AF_INET
            pick = i
            break

    val (id, gen) = socket_slot(hold_socket(Dialling, Null))

    await dialled(ask, id, gen, found[pick].address, what)
end resolving

// There is somewhere to connect to, however it was arrived at -- a name the resolver answered for, or
// an address the program wrote out. **Everything from the socket onwards is the same either way**,
// which is what lets the literal skip the resolver without a second copy of any of it.
private async dialled(ask: Asked, id: usize, gen: usize, address: libuv.Address, what: string)
    val got = await current().io.connect(address)

    // A socket whose slot was given back while it dialled -- a reset, or a program that ended -- is
    // nobody's, so a connection that turns up anyway is closed rather than left open.
    if !owns(id, gen, ask.stamp)
        got match
            Ok(c) -> c.close()
            Err(_) -> ()

        return

    got match
        Err(e) ->
            surrender(id)
            if still_asked(ask) then refuse_request(ask.id, ask.at, what, e)
        Ok(c) ->
            val s = socket_at(id, gen).unwrap()

            s.handle = Connected(c)
            if still_asked(ask) then answer_request(ask.id, socket_value(id, gen))
end dialled

// `startTls`, `alpnProtocol` and what a secured socket does with a read are `net_tls.sysl`'s.

// `onData(sock, fn)` and `onBytes(sock, fn)` -- start reading.
//
// `fn` is called with each chunk as it arrives and with `null` once the peer has finished sending.
// **A second call replaces the first's function**, which is what makes a protocol that changes what
// it expects halfway through writable at all: the reader already running is left running, and reads
// the slot's function and kind afresh at every chunk.
read_socket(v: Value, cb: Value, as_text: bool, at: Span) -> Step
    val name = if as_text then "onData" else "onBytes"

    cb match
        Fn(_) -> ()
        Native(_) -> ()
        HostFn(_) -> ()
        other -> return fault(at, s"`${name}` needs a function to call with each chunk, and this is ${other.type_name()}")

    val (id, gen) = socket_of(v, at, name)?
    val s = socket_at(id, gen).unwrap()

    // A listening socket has no bytes to read, which libuv answered with `ENOTCONN` and kairos with a
    // type that has no `read`.
    val conn = connection_at(id, gen) match
        None -> return fault(at, "cannot read from this socket: socket is not connected")
        Some(c) -> c

    set_callback(id, gen, cb)
    s.as_text = as_text

    // A secured socket was already being read, and may have something waiting for this reader --
    // including the end of its stream, after which there is nothing left to start a reader for.
    if s.held.len() > 0 || s.held_end
        loop_events().spawn(release_held(id, gen, run_stamp()))

        if s.held_end then return Ok(Null)

    if !s.reading
        s.reading = true
        loop_events().spawn(reading(id, gen, run_stamp(), conn))

    Ok(Null)
end read_socket

// A connection's reader: one chunk at a time, until the stream ends or fails or the program closes
// it. **A chunk nobody asked for stays in the kernel**, kairos stopping libuv's reading inside the
// callback that took one -- so a socket the program has stopped reading by closing it leaves nothing
// half-delivered. **A secured socket is read from the moment it is secured, reader or none, but only
// until its handshake is over**: what the reads that finished it decrypted is held in its slot, and
// then a socket nobody is reading stops being read, exactly as a plain one is never started.
//
// Not `private`: `read_for_tls` in `net_tls.sysl` starts one for a socket being secured.
async reading(id: usize, gen: usize, stamp: usize, conn: &Connection)
    loop
        val got = await conn.read()

        if !owns(id, gen, stamp) then return

        got match
            // **The end of the stream is `null` and not a failure**, which is libuv's own distinction
            // and the right one: a peer closing its half is how a request ordinarily ends.
            Ok(bytes) if bytes.len == 0 ->
                read_ended(id, gen)
                handshake_denied(id, "this connection ended before the TLS handshake finished")
                deliver(id, gen, Null)
                return
            Ok(bytes) ->
                val as_text = socket_at(id, gen).unwrap().as_text

                if tls_here(id)
                    secured(id, gen, bytes, as_text)

                    if settled_unread(id, gen)
                        read_ended(id, gen)
                        return
                else
                    plainly_arrived(id, gen, bytes, as_text)
            Err(e) ->
                read_ended(id, gen)
                handshake_denied(id, s"this connection failed before the TLS handshake finished: ${e}")
                stream_failed(id, gen, s"this connection failed: ${e}")
                return
end reading

// The reader has stopped, so the next `onData` starts another -- which is what a second `onData`
// after the end of the stream did with libuv too, reading the end again.
private read_ended(id: usize, gen: usize)
    socket_at(id, gen) match
        Some(s) -> s.reading = false
        None -> ()

// Whether a secured socket's reader should stop: the handshake is over and the program has no reader.
// **This is what keeps a secured socket's backpressure.** Reading past the handshake for nobody would
// hold everything a client sends in memory, for as long as the program waits to call `onData`; so
// only what was decrypted by the reads that finished the handshake is held, and the rest stays in the
// kernel until `onData` or `onBytes` starts a reader again.
private settled_unread(id: usize, gen: usize) -> bool
    if socket_at(id, gen).is_none() || !tls_ready(id) then return false

    callback_of(id, gen) match
        Null -> true
        _ -> false

// `onError(sock, fn)` -- what to call if this socket fails.
//
// `fn` is called with a sentence saying what went wrong, INSTEAD of the `null` that would otherwise
// end the stream, so a program that wants to tell a reset from a peer that finished registers one
// and a program that does not need never hear about it.
//
// **A REGISTRATION OF ITS OWN, RATHER THAN A THIRD ARGUMENT TO `onData`, BECAUSE `onData` REPLACES
// ITS CALLBACK.** That replacement is the point of it -- a protocol that changes what it expects
// halfway through calls `onData` again -- and a handler passed alongside the reader would be
// silently dropped by that second call, which is the worst way for an error channel to fail. Making
// an omitted third argument mean "keep the one you have" only moves the problem: there would then be
// no way to say "and stop telling me", the given-and-empty against never-given ambiguity that slate
// does not have anywhere else.
//
// **A failure only arrives on a socket somebody is reading**, since reading is what finds one. So
// this on its own starts nothing, and an `onError` without an `onData` is a handler that waits.
error_socket(v: Value, cb: Value, at: Span) -> Step
    cb match
        Fn(_) -> ()
        Native(_) -> ()
        HostFn(_) -> ()
        other -> return fault(at, s"`onError` needs a function to call with the reason, and this is ${other.type_name()}")

    val (id, gen) = socket_of(v, at, "onError")?

    set_error_callback(id, gen, cb)

    Ok(Null)
end error_socket

// Everything OpenSSL wants sent, written to the socket. **Nothing awaits it**: the program's own
// `send` answers a promise for its own bytes, and a handshake record belongs to nobody -- the task
// beside the write only hears whether it failed.
//
// Not `private`: `net_tls.sysl` pushes the ClientHello and every handshake turn with it.
push_wire(id: usize, gen: usize)
    val out = tls_pull(id)

    if out.len() == 0 then return

    connection_at(id, gen) match
        None -> ()
        Some(c) -> loop_events().spawn(wired(id, gen, run_stamp(), c.write(out.view())))

    // **Read once**: taking the list is what clears it, so asking twice would answer the second
    // question with nothing and leave those promises pending forever.
    val settled = tls_settled(id)

    for i in 0..<settled.len()
        answer_request(settled.at(i), Null)

// How a write of TLS records ended.
private async wired(id: usize, gen: usize, stamp: usize, t: Task[Result[unit, libuv.Error]])
    (await t) match
        Ok(_) -> ()
        Err(e) -> if owns(id, gen, stamp) then stream_failed(id, gen, s"this connection could not be written to: ${e}")

// What arrived for the program, held where nobody is reading yet and handed over otherwise.
//
// Not `private`: `secured` in `net_tls.sysl` hands on what it decrypted.
plainly_arrived(id: usize, gen: usize, bytes: []const u8, as_text: bool)
    if holding(id, gen)
        socket_at(id, gen).unwrap().held.extend(bytes)
        return

    handed_over(id, gen, bytes, as_text)

// What arrived, handed to the reader as the kind it asked for.
private handed_over(id: usize, gen: usize, bytes: []const u8, as_text: bool)
    if as_text
        // **A chunk is a chunk and not a message**, so this can split a character in half
        // where a peer sends one across two packets. `onBytes` is the reader that cannot.
        from_utf8(bytes) match
            Ok(text) -> deliver(id, gen, str_value(text))
            Err(_) -> stream_failed(id, gen, "this chunk is not text -- `onBytes` reads a socket that carries something else")
    else
        // **A CHUNK IS A BUFFER NOW, WHERE IT WAS AN ARRAY OF NUMBERS.** The chunk is the one place a
        // program meets bytes without asking for them, so it is the place the old shape cost the
        // most: a 64 KiB read built 65,536 `Value`s and a megabyte of heap to hand back 64 KiB of
        // data. Everything a program did with the array it can do with this -- `for`, `[i]`,
        // `.length`, `fromBytes`, `send` -- and `chunk.toArray()` is the array where it wanted one.
        var payload: Buf[u8] = buf()

        payload.extend(bytes)

        val mark = root_mark()
        val b = new_bytes(payload)

        hold(Bytes(b))
        deliver(id, gen, Bytes(b))
        release(mark)

// `send(sock, data)` -- a promise that settles when the bytes have gone.
//
// The write is issued here; the promise is what says it happened.
send_socket(v: Value, text: string, at: Span) -> Step = send_bytes(v, text.bytes, at)

// The same write, given the bytes rather than a string.
//
// **Both halves of `send` end here**, so a program that sends text and one that sends bytes get the
// same promise, the same refusal and the same lifetime -- the only difference being who did the
// encoding.
send_bytes(v: Value, payload: []const u8, at: Span) -> Step
    val (id, gen) = socket_of(v, at, "send")?
    val waiting = begin_request()
    val promised = awaited_request(waiting)
    val ask = Asked(waiting, gen_at(waiting), run_stamp(), at)

    // A listening socket cannot be written to, which libuv answered with `EPIPE` at the call.
    val conn = connection_at(id, gen) match
        None ->
            refuse_request(waiting, at, "cannot send", libuv.Error(libuv.EPIPE))
            return Ok(promised)
        Some(c) -> c

    if socket_at(id, gen).unwrap().finished
        deny_request(waiting, at, "cannot send: this end has shut down its writing, and only `close` is left to it")
        return Ok(promised)

    // **On a TLS connection the bytes that reach the socket are not the bytes the program wrote**,
    // so the write below is of the ciphertext OpenSSL produced. Where the handshake has not finished
    // the plaintext is queued instead and this request is settled when it finally goes out, which is
    // what `tls_settled` is for.
    if tls_here(id)
        tls_send(id, payload, waiting) match
            Err(e) ->
                deny_request(waiting, at, e)
                return Ok(promised)
            Ok(went) ->
                if !went then return Ok(promised)

        val cipher = tls_pull(id)

        loop_events().spawn(sent(ask, conn.write(cipher.view())))
        return Ok(promised)

    loop_events().spawn(sent(ask, conn.write(payload)))
    Ok(promised)
end send_bytes

// How one `send` ended, which is what its promise says.
private async sent(ask: Asked, t: Task[Result[unit, libuv.Error]])
    val r = await t

    if !still_asked(ask) then return

    r match
        Ok(_) -> answer_request(ask.id, Null)
        Err(e) -> refuse_request(ask.id, ask.at, "cannot send", e)

// `close(sock)` -- and with it the slot, which is what lets the program exit.
close_socket(v: Value, at: Span) -> Step
    v match
        Socket(i, g) ->
            val id = usize(i)
            val gen = usize(g)

            // **Closing a socket twice is not an error.** A server closing its connections and a
            // read callback closing its own on end-of-stream is the ordinary way to write this, and
            // making the second one a failure would make the ordinary way wrong.
            if socket_at(id, gen).is_some()
                handshake_denied(id, "this socket was closed before the TLS handshake finished")
                tls_drop(id)
                surrender(id)

            Ok(Null)
        other -> fault(at, s"`close` takes a socket, and this is ${other.type_name()}")

// `localPort(sock)` -- the port this end is actually on.
//
// **The whole reason a program may ask for port `0`.** The kernel picks one, and this is how the
// program finds out which, so nothing has to guess at a number that is free.
local_port(v: Value, at: Span) -> Step
    val (id, gen) = socket_of(v, at, "localPort")?

    val port: Result[int, libuv.Error] = socket_at(id, gen).unwrap().handle match
        Listening(l) -> l.port()
        _ -> connection_at(id, gen) match
            Some(c) -> c.local() match
                Ok(a) -> Ok(a.port())
                Err(e) -> Err(e)
            None -> Err(libuv.Error(libuv.EINVAL))

    port match
        Err(e) -> fault(at, s"this socket has no address: ${e}")
        Ok(p) -> Ok(Int(long(p)))

// `remoteAddress(conn)` -- the IP the other end of this connection is at, as text.
//
// **`null` where the socket has no other end**, which is a listener and a socket that has been
// closed. That is an answer rather than a fault for `alpnProtocol`'s reason: a program asking who
// connected is asking about a thing that may not be there, and `libuv` says so with `ENOTCONN`
// rather than with anything a program did wrong.
//
// **THE `::ffff:` PREFIX IS TAKEN OFF, AND THAT IS NOT COSMETIC.** `listen` binds `::` so that a
// client that asked for `localhost` reaches the server, and a dual-stack socket then reports every
// IPv4 client as the mapped form -- so an allow-list written against `127.0.0.1`, or a rate limit
// keyed on it, would never match anything on a machine with IPv6. What a program wants is the
// address the client would tell you it has.
remote_address(v: Value, at: Span) -> Step
    val (id, gen) = socket_of(v, at, "remoteAddress")?

    val conn = connection_at(id, gen) match
        None -> return Ok(Null)
        Some(c) -> c

    conn.peer() match
        Err(_) -> Ok(Null)
        Ok(a) -> Ok(Str(new_str_scanned(unmapped(a.ip()))))

// An IPv4 address that arrived over a dual-stack socket, written the way it was dialled.
private unmapped(ip: string) -> string
    val prefix = "::ffff:".bytes
    val n = prefix.len

    if ip.bytes.len <= n then return ip

    for i in 0..<n
        if ip.bytes[i] != prefix[i] then return ip

    from_utf8_unchecked(ip.bytes[n..])
end unmapped
