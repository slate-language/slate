module dev.slatelang.slate

import sh.sysl.gc
import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// Promises, and the queue that hands their answers back.
//
// **A promise needs nothing from the machine, and `await` needs everything from it.** That split is
// the whole shape of this file: settling a promise is bookkeeping any interpreter could do, while
// resuming the call that was waiting means putting a whole line of execution back where it was --
// operand stack, frames, scope -- which is possible only because `vm.sysl` made all of that data.
//
// ## Three queues, and why the ready one is not the event loop
//
// `event.sysl` runs libuv, which answers *when something happened outside the program*: a timer
// expired, a socket had bytes. This queue answers something narrower -- *a value a suspended call is
// owed is now known* -- and it has to drain completely between two turns of the loop. That is
// JavaScript's microtask/macrotask split, and it is not a refinement: a program that resolved a
// promise from a timer callback and then ran the next timer before the awaiting function had moved
// would interleave in an order nobody can reason about.
//
// ## What a rejection is here
//
// slate has no `throw` and no `catch`, so a promise fails when the `async` function running it
// faults. Awaiting that promise raises the same fault in the awaiting function, which -- having no
// catch either -- fails in turn. A chain of `await`s therefore propagates a fault to whoever is
// waiting at the end of it, which is what a language with exceptions gets from unwinding.
//
// **And a fault nobody is waiting for is reported rather than dropped.** That is the one thing node
// gets wrong by default and warns about instead; here it is the program's fault, pointed at the line
// that raised it.

// A machine that is owed a value, and the value it is owed.
//
// **The answer travels with the id rather than being read back off the promise**, because a promise
// may be settled once and awaited by many: each waiter is queued with what the promise held at the
// moment it settled, and nothing later can change what any of them sees.
struct Resumption
    // Which parked machine.
    machine: usize

    value: Value

    // Whether the promise failed, and with what. `await` raises this instead of answering.
    failed: bool
    message: string
    at: Span
    src: usize

    // Whether the failure was `exit`, and its status -- see `PromiseObj`, which this is a snapshot of.
    quit: bool
    quit_status: long

// The answers waiting to be handed back. **Not `private`: `vm.sysl`'s `Await` queues onto it.**
var ready: Buf[Resumption] = buf()

// How far down `ready` the drain has got. A cursor rather than a shift, so that a resumption which
// queues more work does not move the entries behind it.
var ready_head: usize = 0

// Every promise that has failed, whether or not anything was waiting.
//
// **Kept until the program ends, because "was this handled?" cannot be answered when it fails.** A
// promise may be awaited long after it settles -- `val p = risky()` and then `await p` three lines
// later is the ordinary shape -- so the question is asked once, at the end, of everything that failed.
var rejections: Buf[*PromiseObj] = buf()

// What the scheduler can still reach. Called from `roots`.
mark_scheduler(h: *gc.Heap)
    for i in ready_head..<ready.len()
        mark_value(h, ready.at(i).value)

    for i in 0..<rejections.len()
        gc.mark(h, ptr_cast(rejections.at(i)))

    for i in 0..<fault_watches.len()
        gc.mark(h, ptr_cast(fault_watches.at(i).watched))
        gc.mark(h, ptr_cast(fault_watches.at(i).out))

    // The other kind of waiter that is not a parked machine -- see `combine.sysl`.
    mark_combinations(h)

// A promise `assertFaults` is watching, and the promise it hands the verdict to.
//
// **A native cannot `await`, so the verdict is written down and taken when the promise settles.**
// `assertFaults` is handed an `async` function as readily as an ordinary one, and what an `async`
// function answers is a promise that has not failed yet -- so reading it where it was answered would
// call every asynchronous fault a value. The test awaits what this settles instead.
struct FaultWatch
    // The promise that has to fail.
    watched: *PromiseObj

    // The one the test is awaiting: `null` where the call faulted as it was meant to, and a
    // complaint where it did not.
    out: *PromiseObj

    // What the complaint has to contain, empty where the call said nothing about it.
    wanted: string

    // Where `assertFaults` was written, so the complaint points at the call rather than at whatever
    // line the promise happened to settle on.
    at: Span

// The watches still owed an answer.
//
// **A root the collector has to walk**, for `rejections`' reason and more sharply: between the native
// answering and the promise settling, nothing else holds either of these.
var fault_watches: Buf[FaultWatch] = buf()

// Watch a promise for the failure a test asked it for, and answer nothing -- the caller already holds
// the promise to hand back.
//
// **The watched promise is marked handled here.** A promise that fails exactly as it was asked to is
// dealt with by definition, and left unmarked it would be reported at the end of the run as a
// rejection nobody was waiting for.
watch_for_fault(watched: *PromiseObj, out: *PromiseObj, wanted: string, at: Span)
    watched.handled = true
    fault_watches.push(FaultWatch(watched, out, wanted, at))

    // **A promise that had already settled wakes nothing later**, `reject(...)` being one a program
    // can write, so the verdict is taken now rather than never.
    if watched.settled then settle_watches(watched)
end watch_for_fault

// Hand the verdict to everything watching this promise.
//
// **The watches are taken off the list BEFORE any of them is answered**, because settling `out` wakes
// it in turn and a second walk of a list this one is halfway through has nothing to make it agree
// with the first.
private settle_watches(pr: *PromiseObj)
    var taken: Buf[FaultWatch] = buf()
    var left: Buf[FaultWatch] = buf()

    for i in 0..<fault_watches.len()
        val w = fault_watches.at(i)

        if w.watched == pr then taken.push(w) else left.push(w)

    if taken.is_empty() then return

    fault_watches = left

    for i in 0..<taken.len()
        answer_watch(taken.at(i), pr)
end settle_watches

private answer_watch(w: FaultWatch, pr: *PromiseObj)
    if !pr.failed
        settle_err(w.out, s"expected a fault, got a value: ${show_value(pr.value)}", w.at, current_source)
        return
    end if

    if w.wanted != "" && !pr.message.contains(w.wanted)
        settle_err(w.out, s"the fault said \"${pr.message}\", wanted it to contain \"${w.wanted}\"", w.at, current_source)
        return
    end if

    settle_ok(w.out, Null)
end answer_watch

// Give the queues back between runs.
reset_async()
    ready.clear()
    ready_head = 0
    rejections.clear()
    fault_watches.clear()
    reset_combinations()

// Every failure that has been reported, marked as dealt with and forgotten.
//
// **So that one rejection is not reported twice.** `slate test` asks `unhandled_rejection` once per
// phase of a test -- the `@setup`, the test itself, the `@teardown` -- and a rejection left on the
// list would be found again by the next of them and reported as that one's failure.
forget_rejections()
    for i in 0..<rejections.len()
        rejections.at(i).handled = true

    rejections.clear()

// -- settling ---------------------------------------------------------------------------------------

// **A promise settles once.** A second answer is dropped rather than refused, which is JavaScript's
// rule: the call that resolved it first has already been told it succeeded, and there is no honest
// way to take that back.
settle_ok(pr: *PromiseObj, v: Value)
    if pr.settled then return

    pr.settled = true
    pr.failed = false
    pr.value = v
    wake(pr)

settle_err(pr: *PromiseObj, message: string, at: Span, src: usize)
    if pr.settled then return

    pr.settled = true
    pr.failed = true
    pr.value = Null
    pr.message = message
    pr.at = at
    pr.src = src

    // Recorded whether or not anything is waiting -- see `rejections`.
    rejections.push(pr)
    wake(pr)

    // **A promise the program threw away has failed for good, so it is reported now.** The check the
    // other rejections get waits for the loop to drain, which is fine for a script and useless for a
    // server: a program holding a listener never drains, so the fault would sit here for as long as
    // the process lived. This is the half of the question that can be answered early.
    orphan_failed(pr)
end settle_err

// **`exit` settling the promise of the `async` function it was called inside.**
//
// **A variant of its own and not a call to `settle_err`, for the same reason `Quit` is a variant of
// its own and not a `Fail` with a special message.** `pr.message` is still given the rendered
// sentence -- `slate test` reads it straight off a test's own promise without asking what kind of
// failure it was -- but `pr.quit` is what tells `resume_one`, `orphan_failed` and
// `unhandled_rejection` to hand `exit` back out as `Quit` rather than as an ordinary fault, which is
// what keeps it uncatchable and keeps its status reaching the driver from an `await` away exactly as
// it does from a call that never suspended.
settle_quit(pr: *PromiseObj, at: Span, src: usize, status: long)
    if pr.settled then return

    pr.settled = true
    pr.failed = true
    pr.quit = true
    pr.quit_status = status
    pr.value = Null
    pr.message = signal_message(Quit(at, src, status))
    pr.at = at
    pr.src = src

    rejections.push(pr)
    wake(pr)
    orphan_failed(pr)
end settle_quit

// A failure nothing can ever be waiting for, made the program's fault where it stands.
//
// **`loop_fault` and not a return value, because neither caller can report anything.** One is
// `settle_err`, reached from a timer callback or a socket read; the other is the `Discard` that threw
// the promise away. The loop reads it at the top of its next turn and stops the program there, which
// is the path a callback that faults outright already takes.
//
// **`exit` is handed back as `Quit`, carrying the file the promise remembered rather than whatever
// `current_source` happens to be here** -- the loop is somewhere else entirely by the time an orphan
// is found, and `failure` would otherwise stamp the wrong file on the right offset.
orphan_failed(pr: *PromiseObj)
    if !pr.orphaned || !pr.failed || pr.handled then return

    loop_fault match
        Some(_) -> ()
        None -> loop_fault = Some(promise_signal(pr))
end orphan_failed

// What a failed promise is, told back as the `Signal` it settled with -- `Quit` where `exit` is why
// it failed, an ordinary `Fail` otherwise. Carries the file the promise remembered rather than
// whatever `current_source` happens to be at the point this is asked, which may be neither the file
// the fault was raised in nor the one the promise was made in.
private promise_signal(pr: *PromiseObj) -> Signal =
    if pr.quit
        Quit(pr.at, pr.src, pr.quit_status)
    else
        Fail(pr.at, pr.src, s"this failed inside an `async` function whose promise nothing awaited: ${pr.message}")

// Queue everything that was waiting on this.
private wake(pr: *PromiseObj)
    for i in 0..<pr.waiters.len()
        ready.push(Resumption(pr.waiters.at(i), pr.value, pr.failed, pr.message, pr.at, pr.src, pr.quit, pr.quit_status))

    pr.waiters.clear()

    // **And whatever a test is watching this one for**, which is the other kind of waiter and needs
    // no machine put back -- see `FaultWatch`.
    settle_watches(pr)

    // **And whatever `all`, `allSettled`, `race` or `any` is collecting it for**, which is the third
    // -- `combine.sysl` holds the list and the four answers.
    settle_combinations(pr)
end wake

// **A NATIVE COULD ONCE BE TOLD WHEN A PROMISE SETTLED, AND NOTHING NEEDS IT ANY MORE.** The one
// caller was the HTTP server, which had to wait on the promise an `async` handler answered; that
// server is written in slate now and waits with `await` like any other program. What went with it is
// a field on every promise, a branch in `wake`, and a second way for a settled promise to be acted
// on -- which is the argument for writing a library in the language rather than beside it.

// The first failure nothing ever awaited, if there is one.
//
// **It points at where the fault happened rather than at the call nobody awaited**, which is the
// useful end of the chain: a fault propagates from one promise to the next carrying the span it was
// raised at, so the last promise in the chain names the first line that went wrong. node's unhandled
// rejection warning shows the original stack for the same reason.
unhandled_rejection() -> Option[Signal]
    for i in 0..<rejections.len()
        val pr = rejections.at(i)

        if !pr.handled
            return Some(promise_signal(pr))

    None
end unhandled_rejection

// -- starting a coroutine -----------------------------------------------------------------------------

// Call an `async` function: it gets a machine of its own, and the caller gets a promise at once.
//
// **The body runs immediately and only stops at its first `await`**, which is JavaScript's rule and
// the one that makes an async function readable: everything above the first `await` has already
// happened by the time the caller sees the promise.
start_async(c: *ClosureObj, args: Buf[Value], at: Span) -> Step
    val mark = root_mark()
    val emark = env_mark()

    // The arguments live only in this sysl local, which the mark phase cannot see, and `new_promise`
    // allocates.
    for i in 0..<args.len()
        hold(args.at(i))

    val pr = new_promise()

    hold(Promise(pr))

    // From here the caller's machine is parked and `vm` is the coroutine's.
    val here = park()

    vm.promise = pr

    val chunk = current_unit.chunks.at(c.body)

    // A chunk whose parameters are slots is started with no scope of its own, exactly as it is
    // called with none: the arguments go into the frame the coroutine's own machine is about to lay.
    if chunk.slotted
        finish(run_chunk(&current_unit, c.body, c.scope, args))
    else
        val scope = new_env(c.scope)

        hold_env(scope)

        bind_arguments(scope, c, args, chunk.variadic)

        finish(run_chunk(&current_unit, c.body, scope, buf()))

    // Whether it finished or suspended, the caller is what runs next.
    unpark(here)
    release_env(emark)
    release(mark)
    Ok(Promise(pr))
end start_async

// Write a finished line of execution's answer into the promise it belongs to.
//
// **A suspended one falls through both arms**, and not by an omission: `Await` parks before it raises
// `Wait`, so by the time this is reached `vm` is the fresh machine that park left behind and its
// promise is null. The coroutine's own promise went into `parked` with it, to be settled by whichever
// resumption finally runs it to the end.
finish(outcome: Step)
    val pr = vm.promise

    if pr == null then return

    outcome match
        Ok(v) -> settle_ok(pr, v)
        Err(Fail(at, src, m)) -> settle_err(pr, m, at, src)
        Err(Quit(at, src, n)) -> settle_quit(pr, at, src, n)
        Err(Wait) -> ()
        Err(s) -> settle_err(pr, signal_message(s), signal_span(s), signal_source(s))
end finish

// -- draining -----------------------------------------------------------------------------------------

// Hand every owed answer back, including any owed by the ones that run.
//
// **It drains to empty rather than taking a turn**, which is what makes it a microtask queue: a
// resumption that resolves another promise is run before the event loop gets another turn.
run_microtasks()
    loop
        if ready_head >= ready.len()
            // Everything queued has run, so the buffer starts again from nothing.
            ready.clear()
            ready_head = 0
            return

        val r = ready.at(ready_head)

        ready_head += 1
        resume_one(r)
end run_microtasks

// Put one machine back and let it carry on.
private resume_one(r: Resumption)
    val mark = root_mark()

    hold(r.value)

    // The line of execution that was running -- the main program, or another coroutine -- is set
    // aside rather than left in a sysl local, so that its values stay rooted while this one runs.
    val here = park()

    unpark(r.machine)

    // **The answer is written OVER the promise `await` left on the stack.** That is the other half of
    // the bargain `Await` made by not popping: the promise stayed reachable while the machine was
    // parked, and the slot it occupied is where its value belongs.
    vm.stack.set(vm.stack.len() - 1, r.value)

    val outcome: Step = if r.failed
        // **A failed promise raises in the call that awaited it, and that call may be inside a
        // `try`.** So the machine is put back and the fault is offered to *its* handlers rather than
        // made into an `Err` here -- which is what makes `await readFile(p) catch e -> ...` work at
        // all. The handlers went into `parked` with the machine, which is why they are a field of it.
        //
        // With nothing to catch it the answer is the same one this used to build by hand: the
        // coroutine ends and its own promise fails in turn.
        //
        // **`exit` is handed back as `Quit`, and `guarded` matches `Fail` and only `Fail`** -- so a
        // `try` around the `await` is offered nothing and this passes straight through it, exactly as
        // it would have if `exit` had never crossed a promise at all.
        resume_failed(&current_unit, if r.quit then Quit(r.at, r.src, r.quit_status) else Fail(r.at, r.src, r.message))
    else
        resume_chunk(&current_unit)

    finish(outcome)
    unpark(here)
    release(mark)
end resume_one
