module dev.slatelang.slate
@tests

import sysl.text.Search

// `slate:sqlite` -- the module written in slate, and the eight natives under it.
//
// **`tests/js/p30.sl` is where the two back ends are compared**, this being a module whose whole
// floor is different on each: the machine's libsqlite3 through `sh.sysl.sqlite` here, node's
// `node:sqlite` there. So what is checked in this file is the interpreter's half, and what is
// checked in the corpus is that a program cannot tell which one it is running on.
//
// **Nearly everything here opens `:memory:`**, which is a private database living as long as the
// connection -- no file to clean up and no order dependence between tests. The two whose subject is
// a file use `in_db`, which makes a directory and scrubs it.

private val Notes: string = "db.exec(\"create table notes (id integer primary key, title text, weight real, body blob)\")\n"

@test
A_DATABASE_IS_ONE_OBJECT_AND_EVERYTHING_ELSE_IS_A_METHOD_ON_IT()
    // **`exec`, `query`, `run`, `transaction` and `close` could not have been exports**: `close` is
    // `slate:net`'s, `query` is `slate:dom`'s and `run` is `slate:process`'s, and every built-in
    // module declares into one scope.
    val text = "val db = sqlite(\":memory:\")\n" + Notes +
        "print(db.exec is function, db.query is function, db.run is function)\n" +
        "print(db.transaction is function, db.compiledWith is function, db.close is function)\n"

    assert_eq(sqlite_out(text), "true true true\ntrue true true")

@test
run_ANSWERS_WHAT_IT_CHANGED_AND_THE_KEY_SQLITE_CHOSE()
    val text = "val db = sqlite(\":memory:\")\n" + Notes +
        "val a = db.run(\"insert into notes (title) values (?)\", \"first\")\n" +
        "print(a.changes, a.lastInsertRowid)\n" +
        "print(db.run(\"insert into notes (title) values (?)\", \"second\").lastInsertRowid)\n" +
        // **0 is not an error and is invisible without asking**, which is the whole reason `changes`
        // is answered rather than left to a second call.
        "print(db.run(\"update notes set title = ? where id = ?\", \"gone\", 99).changes)\n" +
        "print(db.run(\"update notes set title = ? where id = ?\", \"kept\", 1).changes)\n"

    assert_eq(sqlite_out(text), "1 1\n2\n0\n1")

@test
A_ROW_IS_AN_OBJECT_KEYED_BY_COLUMN_NAME()
    val text = "val db = sqlite(\":memory:\")\n" + Notes +
        "db.run(\"insert into notes (title, weight) values (?, ?)\", \"a note\", 1.5)\n" +
        "val rows = db.query(\"select id, title, weight from notes\")\n" +
        "print(len(rows))\n" +
        "print(rows[0].id, rows[0].title, rows[0].weight)\n" +
        "print(toJSON(rows[0]))\n"

    assert_eq(sqlite_out(text), "1\n1 a note 1.5\n{\"id\":1,\"title\":\"a note\",\"weight\":1.5}")

@test
THE_FIVE_STORAGE_CLASSES_COME_BACK_AS_THE_FIVE_SLATE_VALUES()
    // **The type belongs to the VALUE and not to the column**, SQLite being dynamically typed -- so
    // `type_at` is asked per row, which is what lets one column answer an integer in one row and
    // text in the next.
    val text = "val db = sqlite(\":memory:\")\n" +
        "db.exec(\"create table anything (v)\")\n" +
        "db.run(\"insert into anything values (?)\", 42)\n" +
        "db.run(\"insert into anything values (?)\", 2.5)\n" +
        "db.run(\"insert into anything values (?)\", \"words\")\n" +
        "db.run(\"insert into anything values (?)\", toBytes(\"hi\"))\n" +
        "db.run(\"insert into anything values (?)\", null)\n" +
        "for row in db.query(\"select v from anything\")\n" +
        "    print(row.v is integer, row.v is real, row.v is string, row.v is array, row.v == null)\n"

    assert_eq(sqlite_out(text), "true false false false false\n" +
        "false true false false false\n" +
        "false false true false false\n" +
        "false false false true false\n" +
        "false false false false true")

@test
A_BOOLEAN_GOES_IN_AS_0_OR_1_AND_BYTES_COME_BACK_AS_BYTES()
    // **SQLite has no boolean storage class**, `true` in SQL being the integer 1 -- so this is the
    // value the database would have held anyway, said in slate.
    val text = "val db = sqlite(\":memory:\")\n" + Notes +
        "db.run(\"insert into notes (title, body) values (?, ?)\", true, toBytes(\"hi\"))\n" +
        "val row = db.query(\"select title, body from notes\")[0]\n" +
        "print(row.title, toJSON(row.body), fromBytes(row.body).value)\n"

    assert_eq(sqlite_out(text), "1 [104,105] hi")

@test
A_PARAMETER_IS_NEVER_INTERPOLATED_INTO_THE_SQL()
    // **Nothing a parameter holds can become part of the query**, the statement being compiled
    // before it is given a value -- which is why there is no escaping function in this module.
    val text = "val db = sqlite(\":memory:\")\n" + Notes +
        "db.run(\"insert into notes (title) values (?)\", \"'; drop table notes; --\")\n" +
        "print(db.query(\"select title from notes\")[0].title)\n" +
        "print(len(db.query(\"select name from sqlite_master where name = 'notes'\")))\n"

    assert_eq(sqlite_out(text), "'; drop table notes; --\n1")

@test
exec_RUNS_EVERY_STATEMENT_AND_query_RUNS_THE_FIRST()
    // **That is SQLite's own behaviour and not this module's**: `sqlite3_prepare` compiles the first
    // statement in a piece of text and hands back a pointer to what is left. `exec` walks that
    // pointer and is the call a schema goes through.
    val text = "val db = sqlite(\":memory:\")\n" +
        "db.exec(\"create table a (x); create table b (x); insert into a values (1)\")\n" +
        "print(len(db.query(\"select name from sqlite_master where type = 'table' order by name\")))\n" +
        "db.query(\"select 1; select 2\")\n" +
        "print(\"one statement ran\")\n"

    assert_eq(sqlite_out(text), "2\none statement ran")

@test
A_STATEMENT_IS_COMPILED_ONCE_AND_RUN_MANY_TIMES()
    // **This is the whole of what "prepared" buys**, and it is why `query` takes the SQL rather than
    // a statement object: one parse and one plan per piece of SQL for the life of the connection.
    val text = "val db = sqlite(\":memory:\")\n" + Notes +
        "for i in 1..100\n" +
        "    db.run(\"insert into notes (title) values (?)\", \"note \" + string(i))\n" +
        "print(db.query(\"select count(*) as n from notes\")[0].n)\n" +
        "print(db.query(\"select title from notes where id = ?\", 50)[0].title)\n"

    assert_eq(sqlite_out(text), "100\nnote 50")

@test
A_TRANSACTION_COMMITS_ON_A_RETURN_AND_ROLLS_BACK_ON_A_FAULT()
    // **The rollback path is the one a program forgets**: a failure between `begin` and `commit`
    // that simply returns leaves the transaction open, holding its locks, until the connection
    // closes.
    val text = "val db = sqlite(\":memory:\")\n" + Notes +
        "both()\n" +
        "    db.run(\"insert into notes (title) values ('a')\")\n" +
        "    db.run(\"insert into notes (title) values ('b')\")\n" +
        "    \"done\"\n" +
        "\nprint(db.transaction(both))\n" +
        "print(db.query(\"select count(*) as n from notes\")[0].n)\n" +
        "half()\n" +
        "    db.run(\"insert into notes (title) values ('c')\")\n" +
        "\n    throw \"halfway\"\n" +
        "\nprint(db.transaction(half) catch e -> e.message)\n" +
        "print(db.query(\"select count(*) as n from notes\")[0].n)\n"

    assert_eq(sqlite_out(text), "done\n2\nhalfway\n2")

@test
A_SECOND_TRANSACTION_INSIDE_ONE_IS_REFUSED_BY_THE_DATABASE()
    // **SQLite has no nested transactions**, so a second `begin` is refused rather than counted --
    // and the sentence is SQLite's own, which is what makes it the same on both back ends.
    val text = "val db = sqlite(\":memory:\")\n" + Notes +
        "inner() = db.transaction(() -> 1)\n" +
        "print(db.transaction(inner) catch e -> e.message)\n"

    assert(sqlite_out(text).contains("cannot start a transaction within a transaction"))

@test
FTS5_IS_THERE_AND_bm25_COMES_BACK_AS_A_REAL()
    // **What SQLite can do is a property of the MACHINE**, it being the library the machine supplies
    // rather than one slate carries -- so this asks before it reaches for full-text search, which is
    // the alternative to finding out at the `create virtual table`.
    val text = "val db = sqlite(\":memory:\")\n" +
        "print(db.compiledWith(\"ENABLE_FTS5\"), db.compiledWith(\"SQLITE_ENABLE_FTS5\"))\n" +
        "print(db.compiledWith(\"AN_OPTION_NOBODY_HAS\"))\n" +
        "db.exec(\"create virtual table search using fts5(body)\")\n" +
        "db.run(\"insert into search (body) values (?)\", \"the quick brown fox\")\n" +
        "db.run(\"insert into search (body) values (?)\", \"a lazy dog sleeping\")\n" +
        "val hits = db.query(\"select body, bm25(search) as score from search where search match ? order by score\", \"fox\")\n" +
        "print(len(hits), hits[0].body)\n" +
        // **bm25 is negative on purpose**, FTS5 ordering a better match first by making its score
        // smaller.
        "print(hits[0].score is real, hits[0].score < 0)\n"

    assert_eq(sqlite_out(text), "true true\nfalse\n1 the quick brown fox\ntrue true")

@test
A_DATABASE_IS_A_FILE_AND_WHAT_WAS_WRITTEN_IS_STILL_THERE()
    val text = "val first = sqlite(\"<dir>/notes.db\")\n" +
        "first.exec(\"create table notes (title text)\")\n" +
        "first.run(\"insert into notes (title) values (?)\", \"kept\")\n" +
        "first.close()\n" +
        "val second = sqlite(\"<dir>/notes.db\", { readOnly: true })\n" +
        "print(second.query(\"select title from notes\")[0].title)\n" +
        // **A read-only connection refuses a write**, which is what the option is for.
        "print(second.run(\"insert into notes (title) values (?)\", \"no\") catch e -> e.message)\n" +
        "second.close()\n"

    val said = in_db(text)

    assert(said.contains("kept"))
    assert(said.contains("attempt to write a readonly database"))

@test
readOnly_FAILS_WHERE_THERE_IS_NO_DATABASE_AND_THE_DEFAULT_MAKES_ONE()
    // **`Read` fails where there is no file and `Create` makes one**, which is the difference the
    // option is for: a reader that silently created an empty database would answer nothing at all
    // rather than saying the database it was pointed at is not there.
    val said = fails_in_db("sqlite(\"<dir>/missing.db\", { readOnly: true })")

    assert(said.contains("could not be opened"))
    assert(said.contains("unable to open database file"))

    val made = in_db("val db = sqlite(\"<dir>/made.db\")\ndb.exec(\"create table t (x)\")\nprint(\"made it\")\ndb.close()")

    assert_eq(made, "made it")

@test
A_BUSY_TIMEOUT_IS_TAKEN_AND_IS_WHAT_SQLITE_HOLDS()
    val text = "val db = sqlite(\":memory:\", { busyTimeout: 250 })\n" +
        "print(db.query(\"PRAGMA busy_timeout\")[0].timeout)\n"

    assert_eq(sqlite_out(text), "250")

@test
AN_OPTION_NOBODY_MEANT_TO_WRITE_IS_NAMED_RATHER_THAN_DROPPED()
    // **An option spelled wrongly and ignored is a setting a program believes it made**, which is
    // `h2Client`'s rule for the same reason.
    val said = sqlite_fails("sqlite(\":memory:\", { busytimeout: 250 })")

    assert(said.contains("`busytimeout` is not one of a database's options"))
    assert(said.contains("`readOnly` and `busyTimeout`"))

    assert(sqlite_fails("sqlite(\":memory:\", { readOnly: 1 })").contains("`readOnly` is true or false, and this is an integer"))
    assert(sqlite_fails("sqlite(\":memory:\", { busyTimeout: \"soon\" })").contains("`busyTimeout` is a whole number of milliseconds, and this is a string"))

@test
EVERY_FAILURE_HERE_IS_A_FAULT_AND_EVERY_ONE_IS_A_SENTENCE()
    // **slate's rule is that text from outside the program is an answer and a value the program
    // built itself is a fault**, and a local database is on the second side of that line nearly
    // everywhere it can fail: the SQL is in the program, the parameter count is a property of that
    // SQL, and a call on a closed database is a mistake in the order things were done.
    assert(sqlite_fails("sqlite(\":memory:\").query(\"select nope from nowhere\")")
        .contains("the database refused this SQL: no such table: nowhere"))

    assert(sqlite_fails("sqlite(\":memory:\").exec(\"this is not sql\")")
        .contains("the database refused this SQL: near \"this\": syntax error"))

    assert(sqlite_fails("sqlite(\":memory:\").query(\"select ?, ?\", 1)")
        .contains("this SQL takes 2 parameters and was given 1"))

    assert(sqlite_fails("sqlite(\":memory:\").query(\"select ?\", 1, 2)")
        .contains("this SQL takes 1 parameter and was given 2"))

    assert(sqlite_fails("sqlite(\":memory:\").query(\"select ?\", sqlite)")
        .contains("a parameter is text, a number, a boolean, bytes or null, and this is a function"))

@test
A_CALL_ON_A_CLOSED_DATABASE_SAYS_WHICH_CALL_IT_WAS()
    val text = "val db = sqlite(\":memory:\")\n" + Notes + "db.close()\n"

    assert(sqlite_fails(text + "db.query(\"select 1\")").contains("this database is closed, and `query` needs an open one"))
    assert(sqlite_fails(text + "db.run(\"select 1\")").contains("this database is closed, and `run` needs an open one"))
    assert(sqlite_fails(text + "db.exec(\"select 1\")").contains("this database is closed, and `exec` needs an open one"))
    assert(sqlite_fails(text + "db.transaction(() -> 1)").contains("this database is closed, and `transaction` needs an open one"))

    // **Closing twice is not an error**, a database being a thing a program closes on a path it may
    // reach more than once.
    assert_eq(sqlite_out(text + "db.close()\nprint(\"closed twice\")"), "closed twice")

@test
A_DATABASE_OUTLIVES_THE_PROGRAM_AND_THE_CONNECTION_DOES_NOT()
    // **`forget_sqlite` is in `reset_events`**, beside the socket table: a connection left open past
    // its program would leave the suite itself holding an open file on a database nobody is using.
    // What is asserted here is the half a program can see -- the FILE is still there and still
    // writable by whoever opens it next, having been left open by the program that made it.
    val said = in_db_twice(
        "val db = sqlite(\"<dir>/notes.db\")\n" +
        "db.exec(\"create table notes (title text)\")\n" +
        "db.run(\"insert into notes (title) values (?)\", \"first\")\n" +
        "print(\"left open on purpose\")\n",

        "val db = sqlite(\"<dir>/notes.db\", { readOnly: false })\n" +
        "db.run(\"insert into notes (title) values (?)\", \"second\")\n" +
        "for row in db.query(\"select title from notes order by rowid\")\n" +
        "    print(row.title)\n" +
        "db.close()\n")

    assert_eq(said, "left open on purpose\nfirst\nsecond")
