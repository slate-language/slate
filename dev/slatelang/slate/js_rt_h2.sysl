module dev.slatelang.slate

#if feature_http2

// `slate:nghttp2`'s server half in the JavaScript back end -- an HTTP/2 session written out.
//
// **This is `js_rt_http.sysl`'s second case of two readings of one grammar.** The interpreter's
// session is nghttp2, a C library; node's own HTTP/2 is `http2`, which is asynchronous all the way
// down and cannot be handed bytes and asked at once what they said. `slate:http`'s HTTP/2 speaker
// is written against exactly that synchronous shape -- `h2Receive`, then `h2Next` until it answers
// `null`, then `h2Send` -- so what is here is a session that works that way: frames parsed from the
// bytes it was given, HPACK, flow control, and the events and frames that follow.
//
// ## What is here, and what is not
//
// **The session both halves share, and the server's half of it**, which is what `serve` needs. What
// only a client does -- opening streams, reading responses, being refused once the server has gone
// away -- is `js_rt_h2_client.sysl`'s subclass, whose block closes the `h2` scope; HPACK is
// `js_rt_h2_hpack.sysl`, whose block opens it. The control frames (`h2Settings`, `h2Ping`,
// `h2WindowUpdate`) and `h2Wants` are here, being the same on both ends. The class is cut in two at
// its `-- flow control received --` section: this block reads, and `js_rt_h2_write.sysl` -- which
// closes the class -- credits and writes.
//
// **The encoder never indexes.** Every field goes out as an indexed static entry or a literal
// without indexing, so the peer's table is never touched and a `SETTINGS_HEADER_TABLE_SIZE` it
// sends changes nothing here. What that costs is a few bytes of header on a repeated field, and
// what it buys is that this side holds no table the peer could drive out of step. **The decoder is
// complete**: it has to be, a client indexes whatever it likes.
//
// **A peer is held to what nghttp2 holds it to**, since a session that buffers whatever arrives is
// a memory-exhaustion risk for every `slate js` server: a frame over the size advertised, DATA past
// a stream's window (RST_STREAM FLOW_CONTROL_ERROR) or the connection's (GOAWAY FLOW_CONTROL_ERROR),
// more than a hundred streams open at once (REFUSED_STREAM),
// a header block past eight CONTINUATIONs, and resets past nghttp2's rapid-reset bucket.
//
// **A CONNECTION ERROR ANSWERS EXACTLY WHAT nghttp2 ANSWERS**, which was measured rather than
// assumed. `h2Receive` answers `null` and a GOAWAY with the error's code is queued (FLOW_CONTROL_ERROR,
// FRAME_SIZE_ERROR, COMPRESSION_ERROR, PROTOCOL_ERROR, and INTERNAL_ERROR for the rapid-reset bucket);
// nothing is delivered after the error, and no event says so. The rapid reset is the one exception to
// "nothing after": it only queues, so the rest of the same bytes are still read, and input stops once
// the GOAWAY has gone out through `h2Send`. Two things are not connection errors at all and answer
// `{ error }` from this call and every one after it with no GOAWAY: bytes that do not begin with the
// preface, and a header block past eight CONTINUATIONs. The program's own `h2Goaway` still goes out
// after those, and any GOAWAY that goes out closes the peer's streams numbered past its last stream
// as REFUSED_STREAM, which is what the interpreter's session reports.

js_runtime_h2() -> string = raw"""
            // -- frames --------------------------------------------------------------------------------------

            const DATA = 0, HEADERS = 1, PRIORITY = 2, RST_STREAM = 3, SETTINGS = 4, PUSH_PROMISE = 5
            const PING = 6, GOAWAY = 7, WINDOW_UPDATE = 8, CONTINUATION = 9
            const END_STREAM = 1, ACK = 1, END_HEADERS = 4, PADDED = 8, PRIORITY_FLAG = 32

            const PREFACE = Buffer.from("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n", "latin1")

            // The size of a frame this side accepts until its own SETTINGS raise it, and of the largest
            // DATA frame it sends.
            const MAX_FRAME = 16384

            // The window this side opens for every stream and for the connection until the program
            // widens one, so a peer may have this much unacknowledged at most. Flow-control credit
            // goes back as nghttp2 returns it: once HALF a window has been consumed, counted
            // separately for the connection and for each stream.
            const INITIAL_WINDOW = 65535

            // **The limits a peer is held to, which are nghttp2's in substance.** The first two are
            // advertised in this side's SETTINGS; the CONTINUATION cap is nghttp2's default since the
            // 2024 CONTINUATION flood, and the reset bucket is the one it added for the 2023 rapid
            // reset -- a burst of a thousand, refilled at thirty-three a second.
            const MAX_STREAMS = 100
            const MAX_HEADER_LIST = 65536
            const MAX_CONTINUATIONS = 8
            const RESET_BURST = 1000
            const RESET_RATE = 33

            const NO_ERROR = 0, PROTOCOL_ERROR = 1, INTERNAL_ERROR = 2, FLOW_CONTROL_ERROR = 3, STREAM_CLOSED = 5, FRAME_SIZE_ERROR = 6
            const REFUSED_STREAM = 7, COMPRESSION_ERROR = 9, ENHANCE_YOUR_CALM = 11

            // Ends the reading of what a peer sent, after a connection error has queued its GOAWAY.
            class Halt extends Error {}

            // What nghttp2 puts in front of a failure it reports, which is what `h2Receive` answers.
            const PEER = "reading what the peer sent: "

            // **What goes out first is nghttp2's order, not the order things were asked for**: SETTINGS
            // and PING ahead of everything, then the frames about streams already open, then the HEADERS
            // that open new ones, then DATA. Each queued frame carries its rank and `send` sorts on it.
            const URGENT = 0, REGULAR = 1, OPENING = 2, BODY = 3

            const MAX_WINDOW = 0x7fffffff

            const frame = (type, flags, stream, payload) => {
                const head = Buffer.alloc(9)

                head.writeUIntBE(payload.length, 0, 3)
                head[3] = type
                head[4] = flags
                head.writeUInt32BE(stream, 5)

                return payload.length === 0 ? head : Buffer.concat([head, payload])
            }

            const u32 = (n) => {
                const b = Buffer.alloc(4)

                b.writeUInt32BE(n, 0)

                return b
            }

            class Session {
                constructor(auto) {
                    this.auto = auto
                    this.inbuf = Buffer.alloc(0)
                    this.prefaced = false
                    this.out = []
                    this.events = []
                    this.streams = new Map()
                    this.pending = new Set()
                    this.dec = new Decoder()
                    this.sendWin = 65535
                    this.peerWin = 65535
                    this.peerFrame = 16384
                    this.connCredit = 0
                    this.recvWin = INITIAL_WINDOW
                    this.continuing = null
                    this.lastStream = 0
                    this.closed = false
                    this.failed = null
                    this.terminated = false
                    this.ignoring = false
                    this.goaways = []
                    this.resetTokens = RESET_BURST
                    this.resetAt = Date.now()
                    this.isClient = false
                    this.localWin = INITIAL_WINDOW
                    this.localInitial = INITIAL_WINDOW
                    this.localFrame = MAX_FRAME
                    this.localStreams = MAX_STREAMS
                    this.unacked = []
                    this.goawaySent = false
                    this.goawayRecv = false
                    this.termSent = false

                    // The header list this side keeps, which is `sh.sysl.nghttp2`'s
                    // `Session.max_header_list`: the last SETTINGS_MAX_HEADER_LIST_SIZE this side
                    // sent, and 64 KiB until it sends one.
                    this.headerCap = MAX_HEADER_LIST

                    // The server's own SETTINGS go first, as nghttp2 writes them: the empty frame a
                    // session opens with, then the two limits it holds the peer to, so that a client
                    // which reads them never meets the refusal. Each is acknowledged on its own.
                    this.settings([])
                    this.settings([[3, MAX_STREAMS], [6, MAX_HEADER_LIST]])
                }

                // A frame to go out, ranked; `after` runs once it has gone, which is when nghttp2
                // counts a stream as closed by what this side wrote.
                put(rank, bytes, after, stream) {
                    this.out.push({ rank: rank, bytes: bytes, after: after, stream: stream })
                }

                // This side's SETTINGS, which are in force once the peer acknowledges them.
                settings(entries) {
                    const body = Buffer.alloc(entries.length * 6)

                    entries.forEach(([id, value], i) => {
                        body.writeUInt16BE(id, i * 6)
                        body.writeUInt32BE(value, i * 6 + 2)
                    })

                    this.put(URGENT, frame(SETTINGS, 0, 0, body))
                    this.unacked.push(entries)

                    // **The header list is held from the moment it is announced, not at the ACK**,
                    // which is where the binding holds it: a peer that has not yet read the setting
                    // has still been told, and a block past it costs this side nothing to refuse.
                    for (const [id, value] of entries) if (id === 6) this.headerCap = value
                }

                // The peer has acknowledged the oldest SETTINGS this side sent. A new initial window
                // moves every open stream's window by the difference, as nghttp2 moves it.
                acknowledged() {
                    const entries = this.unacked.shift()

                    if (entries === undefined) return

                    for (const [id, value] of entries) {
                        if (id === 1) {
                            this.dec.limit = value

                            if (this.dec.max > value) {
                                this.dec.max = value
                                this.dec.evict(value)
                            }
                        } else if (id === 3) {
                            this.localStreams = value
                        } else if (id === 4) {
                            const delta = value - this.localInitial

                            this.localInitial = value

                            for (const s of this.streams.values()) {
                                s.localWin += delta
                                s.recvWin += delta
                            }
                        } else if (id === 5) {
                            this.localFrame = value
                        }
                    }
                }

                ping() {
                    this.put(URGENT, frame(PING, 0, 0, Buffer.alloc(8)))
                }

                // **The program's own WINDOW_UPDATE is nghttp2's arithmetic**: an increment pays off
                // what has arrived and not been credited first, and only what is left over widens the
                // window itself -- which is why a window can never pass the protocol's limit without
                // the call refusing. Credit the session owed is reduced by the same amount.
                windowUpdate(stream, by) {
                    if (by === 0) return null

                    const s = stream === 0 ? this : this.streams.get(stream)

                    if (s === undefined) return null

                    const owed = Math.max(0, s.localWin - s.recvWin)

                    if (by > owed) {
                        if (s.localWin > MAX_WINDOW - (by - owed)) return "submitting WINDOW_UPDATE: Flow control error"

                        s.localWin += by - owed
                    }

                    s.recvWin += by

                    if (stream === 0) this.connCredit = Math.max(0, this.connCredit - by)
                    else s.credit = Math.max(0, s.credit - by)

                    this.put(REGULAR, frame(WINDOW_UPDATE, 0, stream, u32(by)))

                    return null
                }

                // `{ read, write }`, nghttp2's two answers: nothing at all once a GOAWAY that ends the
                // connection has gone out; reading while a stream is open or no GOAWAY has passed
                // either way; writing while anything is queued that the windows let out.
                wants() {
                    if (this.termSent) return [false, false]

                    const read = this.streams.size > 0 || !(this.goawaySent || this.goawayRecv)
                    let write = this.out.length > 0

                    if (this.sendWin > 0)
                        for (const s of this.pending)
                            if ((s.queue.length > 0 && s.sendWin > 0) || (s.queue.length === 0 && s.finishing && !s.sentEnded)) write = true

                    return [read, write]
                }

                // Whether a stream the peer named was never opened by anybody.
                neverOpened(stream) {
                    return stream > this.lastStream
                }

                // A connection error that is not worth reading past: its GOAWAY is queued, the session
                // reads nothing more, and `h2Receive` answers `null`. The program's own `h2Goaway`
                // after it is not sent, the peer having been told why already.
                fatal(code, why) {
                    this.terminate(code, why)
                    this.ignoring = true

                    throw new Halt()
                }

                // A connection error that only queues its GOAWAY, so the bytes already in hand are still
                // read -- the rapid-reset bucket's, as nghttp2 does it. Said once however often it recurs.
                terminate(code, why) {
                    if (this.terminated) return

                    this.terminated = true
                    this.queueGoaway(this.lastStream, code, why)
                }

                // A GOAWAY, with the reason nghttp2 gives in its debug data where it gives one.
                queueGoaway(last, code, why) {
                    const debug = why === undefined ? Buffer.alloc(0) : Buffer.from(why, "latin1")
                    const body = Buffer.alloc(8 + debug.length)

                    body.writeUInt32BE(last, 0)
                    body.writeUInt32BE(code, 4)
                    debug.copy(body, 8)
                    this.put(REGULAR, frame(GOAWAY, 0, 0, body))
                    this.goaways.push(last)
                }

                // A stream error: RST_STREAM with its code, and the stream gone as though the peer had
                // reset it, so the program is told `streamClose` and forgets what it held for it.
                resetStream(stream, code) {
                    this.put(REGULAR, frame(RST_STREAM, 0, stream, u32(code)))

                    const s = this.streams.get(stream)

                    if (s !== undefined) this.drop(s, code)
                }

                // -- reading -------------------------------------------------------------------------------

                // Bytes in. Answers `null`, or the sentence for a failure the library itself reports.
                receive(chunk) {
                    if (this.failed !== null) return this.failed

                    if (this.ignoring) return null

                    this.inbuf = this.inbuf.length === 0 ? Buffer.from(chunk) : Buffer.concat([this.inbuf, chunk])

                    try {
                        this.pump()
                    } catch (e) {
                        if (e instanceof Halt) return null

                        if (e instanceof LibError) {
                            this.failed = PEER + e.message

                            return this.failed
                        }

                        throw e
                    }

                    return null
                }

                pump() {
                    if (!this.prefaced) {
                        const n = Math.min(this.inbuf.length, PREFACE.length)

                        if (!this.inbuf.subarray(0, n).equals(PREFACE.subarray(0, n)))
                            throw new LibError("Received bad client magic byte string")

                        if (n < PREFACE.length) return

                        this.inbuf = this.inbuf.subarray(PREFACE.length)
                        this.prefaced = true
                    }

                    for (;;) {
                        if (this.inbuf.length < 9) return

                        const len = this.inbuf.readUIntBE(0, 3)

                        if (len > this.localFrame) this.fatal(FRAME_SIZE_ERROR)

                        if (this.inbuf.length < 9 + len) return

                        const type = this.inbuf[3]
                        const flags = this.inbuf[4]
                        const stream = this.inbuf.readUInt32BE(5) & 0x7fffffff
                        const payload = this.inbuf.subarray(9, 9 + len)

                        this.inbuf = this.inbuf.subarray(9 + len)

                        // What a frame got wrong is a connection error carrying the code it names, or
                        // PROTOCOL_ERROR where it names none.
                        try {
                            this.take(type, flags, stream, payload)
                        } catch (e) {
                            if (e instanceof H2Error && !(e instanceof LibError)) this.fatal(e.code === undefined ? PROTOCOL_ERROR : e.code)

                            throw e
                        }
                    }
                }

                take(type, flags, stream, payload) {
                    // A client hears the server's SETTINGS before anything else, or hangs up.
                    if (this.isClient && !this.heardSettings) {
                        if (type !== SETTINGS || (flags & ACK) !== 0) this.fatal(PROTOCOL_ERROR, "SETTINGS expected")

                        this.heardSettings = true
                    }

                    if (this.continuing !== null && (type !== CONTINUATION || stream !== this.continuing.stream))
                        refuse("a header block was interrupted by another frame")

                    switch (type) {
                        case DATA: return this.takeData(flags, stream, payload)
                        case HEADERS: return this.takeHeaders(flags, stream, payload)
                        case CONTINUATION: return this.takeContinuation(flags, stream, payload)
                        case PRIORITY: return
                        case RST_STREAM: return this.takeReset(stream, payload)
                        case SETTINGS: return this.takeSettings(flags, stream, payload)
                        case PUSH_PROMISE: refuse("a client may not push")
                        case PING: return this.takePing(flags, stream, payload)
                        case GOAWAY: return this.takeGoaway(stream, payload)
                        case WINDOW_UPDATE: return this.takeWindow(stream, payload)
                        default: return
                    }
                }

                // A frame's payload without its padding.
                unpadded(flags, payload) {
                    if ((flags & PADDED) === 0) return [payload, 0]

                    if (payload.length < 1) refuse("a padded frame has no padding length")

                    const pad = payload[0]

                    if (pad >= payload.length) refuse("a frame is padded past its own length")

                    return [payload.subarray(1, payload.length - pad), pad + 1]
                }

                takeData(flags, stream, payload) {
                    if (stream === 0) refuse("DATA on stream zero")

                    // **THE PEER IS HELD TO BOTH WINDOWS, or a body is buffered for as long as it is
                    // sent.** Credit only goes back as the program consumes, so a client that ignores
                    // the windows is the one thing that could make this session hold more than they
                    // allow. **Past either window is a connection error, a stream's included**, which is
                    // what nghttp2 answers (GOAWAY FLOW_CONTROL_ERROR) rather than a reset of the stream.
                    // The whole payload counts, padding included, as RFC 9113 says.
                    if (payload.length > this.recvWin)
                        this.fatal(FLOW_CONTROL_ERROR)

                    this.recvWin -= payload.length

                    const [data, padding] = this.unpadded(flags, payload)
                    const s = this.streams.get(stream)

                    if (s === undefined) {
                        if (this.neverOpened(stream)) refuse("DATA on a stream that was never opened")

                        this.credit(undefined, payload.length)

                        return
                    }

                    if (s.recvEnded) refuse("DATA on a stream the peer had ended")

                    if (payload.length > s.recvWin)
                        this.fatal(FLOW_CONTROL_ERROR)

                    s.recvWin -= payload.length

                    // A session that extends its own windows counts the whole payload as consumed, but a
                    // stream this frame ends is not credited (nghttp2 sends nothing for a stream whose
                    // peer has finished). One that does not counts only the padding, which the program
                    // never reads; the data is counted when it is consumed.
                    if (this.auto) this.credit(s, payload.length, (flags & END_STREAM) === 0)
                    else this.credit(s, padding, true)

                    if (data.length > 0)
                        this.events.push({ kind: "data", stream: stream, bytes: new Uint8Array(data) })

                    if ((flags & END_STREAM) !== 0) this.ended(s)
                }

                takeHeaders(flags, stream, payload) {
                    if (stream === 0) refuse("HEADERS on stream zero")

                    // A request is the last stream this side has processed from the moment its first
                    // frame arrives, a header block still being read included, which is what the
                    // GOAWAY for a connection error afterwards names.
                    if (!this.streams.has(stream)) {
                        if (stream % 2 === 0 || stream <= this.lastStream)
                            refuse("a request opened stream " + stream + ", which a client may not use")

                        this.lastStream = stream
                    }

                    let [block] = this.unpadded(flags, payload)

                    if ((flags & PRIORITY_FLAG) !== 0) {
                        if (block.length < 5) refuse("a HEADERS frame is too short for its priority")

                        block = block.subarray(5)
                    }

                    // **The block is announced before its fields arrive**, which is nghttp2's
                    // `BeginHeaders` and what a header-read deadline starts at. nghttp2 says it only
                    // where the frame is going to be read as a block -- not for a request refused for
                    // too many streams, nor for HEADERS on a stream the peer had ended -- so those two
                    // are decided here, before it.
                    const known = this.streams.get(stream)

                    if (known !== undefined) {
                        if (known.recvEnded) coded(STREAM_CLOSED, "HEADERS on a stream the peer had ended")

                        this.events.push({ kind: "beginHeaders", stream: stream, of: "trailer" })
                    } else if (this.streams.size < this.localStreams) {
                        this.events.push({ kind: "beginHeaders", stream: stream, of: "request" })
                    }

                    if ((flags & END_HEADERS) === 0) {
                        this.continuing = { stream: stream, flags: flags, parts: [block], count: 0 }

                        return
                    }

                    this.headed(stream, flags, block)
                }

                takeContinuation(flags, stream, payload) {
                    if (this.continuing === null) refuse("a CONTINUATION with no header block to continue")

                    const held = this.continuing

                    // **A header block is bounded in frames.** Held until END_HEADERS, a block nobody
                    // ends -- the 2024 CONTINUATION flood, often of empty frames -- would grow for as long
                    // as the peer kept sending, so past eight the library gives up on the connection, as
                    // nghttp2's does: an `{ error }` and no GOAWAY. Its size is not bounded here, because
                    // nghttp2 does not bound it either: eight frames of 16 KiB are all it can come to,
                    // and what the block says is held to the header list limit once it is decoded.
                    held.count += 1

                    if (held.count > MAX_CONTINUATIONS)
                        throw new LibError("Too many CONTINUATION frames following a HEADER frame")

                    held.parts.push(payload)

                    if ((flags & END_HEADERS) === 0) return

                    this.continuing = null
                    this.headed(stream, held.flags, Buffer.concat(held.parts), held.dropped === true)
                }

                // A whole header block has arrived: a request, or the trailers of one -- or the block
                // of a stream the program reset while it was arriving, which is decoded and dropped.
                headed(stream, flags, block, dropped) {
                    let fields

                    // A block that is not valid HPACK is a connection error: the table it would have
                    // built is out of step with the peer's, so nothing after it could be read.
                    try {
                        // **The list is capped as it is decoded**, the binding's way: each field is
                        // counted (name + value + 32) and past `headerCap` none is kept, while the block
                        // is still read to its end for the table's sake. `decode` answers `null` then,
                        // and the event is `headerListTooLarge` IN PLACE OF `headers`, the stream left
                        // open for the program to answer -- `slate:http` answers `431`.
                        fields = this.dec.decode(block, this.headerCap)
                    } catch (e) {
                        if (e instanceof H2Error) this.fatal(COMPRESSION_ERROR)

                        throw e
                    }

                    if (dropped) return

                    const known = this.streams.get(stream)

                    if (known !== undefined) {
                        if (fields === null) this.events.push({ kind: "headerListTooLarge", stream: stream, of: "trailer" })
                        else this.events.push({ kind: "headers", stream: stream, headers: fields, of: "trailer" })

                        if ((flags & END_STREAM) !== 0) this.ended(known)

                        return
                    }

                    // **A request past the stream limit never reaches the program**, and the stream
                    // number is spent either way. Too many open at once is REFUSED_STREAM, which tells
                    // the client it may try again.
                    if (this.streams.size >= this.localStreams) {
                        this.put(REGULAR, frame(RST_STREAM, 0, stream, u32(REFUSED_STREAM)))

                        return
                    }

                    const s = {
                        id: stream,
                        localWin: this.localInitial,
                        recvWin: this.localInitial,
                        recvEnded: false,
                        sentEnded: false,
                        headSent: false,
                        finishing: false,
                        trailers: null,
                        queue: [],
                        sendWin: this.peerWin,
                        credit: 0,
                        closed: false
                    }

                    this.streams.set(stream, s)

                    if (fields === null) this.events.push({ kind: "headerListTooLarge", stream: stream, of: "request" })
                    else this.events.push({ kind: "headers", stream: stream, headers: fields, of: "request" })

                    if ((flags & END_STREAM) !== 0) this.ended(s)
                }

                // The peer will send this stream no more.
                ended(s) {
                    s.recvEnded = true

                    this.events.push({ kind: "streamEnd", stream: s.id })
                    this.settle(s)
                }

                // Both halves of a stream are over: it goes, and the program is told.
                settle(s) {
                    if (s.recvEnded && s.sentEnded) this.drop(s, 0)
                }

                drop(s, code) {
                    if (s.closed) return

                    s.closed = true
                    s.queue = []

                    this.streams.delete(s.id)
                    this.pending.delete(s)
                    this.events.push({ kind: "streamClose", stream: s.id, code: code })
                }

                takeReset(stream, payload) {
                    if (stream === 0) refuse("RST_STREAM on stream zero")
                    if (payload.length !== 4) coded(FRAME_SIZE_ERROR, "an RST_STREAM that is not four bytes")

                    const s = this.streams.get(stream)

                    if (s === undefined) return

                    // **Rapid reset**, the 2023 pattern: a request opened and reset at once costs the
                    // client two frames and the server a handler, so resets are drawn from nghttp2's
                    // bucket, and a client that empties it is hung up on. **The code is INTERNAL_ERROR,
                    // which is what nghttp2 sends for it** -- not ENHANCE_YOUR_CALM, though that is the
                    // code RFC 9113 suggests -- and the reset that emptied it is still delivered.
                    // A client is not held to it: the streams being reset are its own.
                    if (!this.isClient) {
                        const now = Date.now()

                        this.resetTokens = Math.min(RESET_BURST, this.resetTokens + (now - this.resetAt) * RESET_RATE / 1000)
                        this.resetAt = now

                        if (this.resetTokens < 1) this.terminate(INTERNAL_ERROR)
                        else this.resetTokens -= 1
                    }

                    this.events.push({ kind: "rstStream", stream: stream, code: payload.readUInt32BE(0) })
                    this.drop(s, payload.readUInt32BE(0))
                }

                takeSettings(flags, stream, payload) {
                    if (stream !== 0) refuse("SETTINGS on a stream")

                    if ((flags & ACK) !== 0) {
                        if (payload.length !== 0) coded(FRAME_SIZE_ERROR, "a SETTINGS acknowledgement with a payload")

                        this.acknowledged()

                        return
                    }

                    if (payload.length % 6 !== 0) coded(FRAME_SIZE_ERROR, "a SETTINGS frame that is not whole entries")

                    for (let at = 0; at < payload.length; at += 6) {
                        const id = payload.readUInt16BE(at)
                        const value = payload.readUInt32BE(at + 2)

                        if (id === 4) {
                            if (value > 0x7fffffff) coded(FLOW_CONTROL_ERROR, "an initial window larger than the protocol allows")

                            const delta = value - this.peerWin

                            this.peerWin = value

                            for (const s of this.streams.values()) s.sendWin += delta
                        } else if (id === 5) {
                            if (value < 16384 || value > 16777215) refuse("a maximum frame size outside the protocol's range")

                            this.peerFrame = value
                        }
                    }

                    this.put(URGENT, frame(SETTINGS, ACK, 0, Buffer.alloc(0)))
                    this.events.push({ kind: "settings" })
                }

                takePing(flags, stream, payload) {
                    if (stream !== 0) refuse("PING on a stream")
                    if (payload.length !== 8) coded(FRAME_SIZE_ERROR, "a PING that is not eight bytes")

                    const ack = (flags & ACK) !== 0

                    if (!ack) this.put(URGENT, frame(PING, ACK, 0, Buffer.from(payload)))

                    this.events.push({ kind: "ping", ack: ack })
                }

                takeGoaway(stream, payload) {
                    if (stream !== 0) refuse("GOAWAY on a stream")
                    if (payload.length < 8) coded(FRAME_SIZE_ERROR, "a GOAWAY that is too short")

                    const last = payload.readUInt32BE(0) & 0x7fffffff

                    this.goawayRecv = true
                    this.events.push({ kind: "goaway", lastStream: last, code: payload.readUInt32BE(4) })

                    // This side's own streams past the last the peer processed were never seen, and
                    // close as REFUSED_STREAM -- a client's, a server opening none of its own.
                    for (const s of [...this.streams.values()])
                        if (s.id % 2 === (this.isClient ? 1 : 0) && s.id > last) this.drop(s, REFUSED_STREAM)
                }

                takeWindow(stream, payload) {
                    if (payload.length !== 4) coded(FRAME_SIZE_ERROR, "a WINDOW_UPDATE that is not four bytes")

                    const by = payload.readUInt32BE(0) & 0x7fffffff

                    if (by === 0) refuse("a WINDOW_UPDATE of nothing")

                    if (stream === 0) {
                        this.sendWin += by

                        if (this.sendWin > 0x7fffffff) coded(FLOW_CONTROL_ERROR, "a connection window past the protocol's limit")
                    } else {
                        const s = this.streams.get(stream)

                        if (s === undefined) return

                        s.sendWin += by

                        if (s.sendWin > 0x7fffffff) {
                            this.put(REGULAR, frame(RST_STREAM, 0, stream, u32(3)))
                            this.drop(s, 3)

                            return
                        }
                    }

                    this.events.push({ kind: "windowUpdate", stream: stream, increment: by })
                }
"""

