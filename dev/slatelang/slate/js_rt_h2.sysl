module dev.slatelang.slate

#if feature_http2

// `slate:nghttp2`'s server half in the JavaScript back end -- an HTTP/2 session written out.
//
// **This is `js_rt_http.sysl`'s second case of two readings of one grammar.** The interpreter's
// session is nghttp2, a C library; node's own HTTP/2 is `http2`, which is asynchronous all the way
// down and cannot be handed bytes and asked at once what they said. `slate:http`'s HTTP/2 speaker
// is written against exactly that synchronous shape -- `h2Receive`, then `h2Next` until it answers
// `null`, then `h2Send` -- so what is here is a session that works that way: frames parsed from the
// bytes it was given, HPACK, flow control, and the events and frames that follow.
//
// ## What is here, and what is not
//
// **The server's half, which is what `serve` needs**: `h2Server`, `h2Receive`, `h2Send`, `h2Next`,
// `h2Respond`, `h2RespondStream`, `h2Push`, `h2Finish`, `h2Goaway`, `h2Consume` and `h2Close`. The
// client's half, `h2Settings`, `h2Reset`, `h2WindowUpdate`, `h2Ping`, `h2Wants` and the stand-alone
// HPACK calls stay on the `OWED` list and say so. HPACK itself is `js_rt_h2_hpack.sysl`, whose block
// opens the `h2` scope that this one closes.
//
// **The encoder never indexes.** Every field goes out as an indexed static entry or a literal
// without indexing, so the peer's table is never touched and a `SETTINGS_HEADER_TABLE_SIZE` it
// sends changes nothing here. What that costs is a few bytes of header on a repeated field, and
// what it buys is that this side holds no table the peer could drive out of step. **The decoder is
// complete**: it has to be, a client indexes whatever it likes.
//
// **A peer is held to what nghttp2 holds it to**, since a session that buffers whatever arrives is
// a memory-exhaustion risk for every `slate js` server: a frame over the size advertised, DATA past
// a stream's window (RST_STREAM FLOW_CONTROL_ERROR) or the connection's (GOAWAY FLOW_CONTROL_ERROR),
// more than a hundred streams open at once (REFUSED_STREAM), a header list past 64 KiB (`431`),
// a header block past eight CONTINUATIONs or 64 KiB, and resets past nghttp2's rapid-reset bucket
// (both GOAWAY ENHANCE_YOUR_CALM). A connection error is `{ error }` from `h2Receive`, as it is in
// the interpreter, with the GOAWAY that says why already queued.

js_runtime_h2() -> string = raw"""
            // -- frames --------------------------------------------------------------------------------------

            const DATA = 0, HEADERS = 1, PRIORITY = 2, RST_STREAM = 3, SETTINGS = 4, PUSH_PROMISE = 5
            const PING = 6, GOAWAY = 7, WINDOW_UPDATE = 8, CONTINUATION = 9
            const END_STREAM = 1, ACK = 1, END_HEADERS = 4, PADDED = 8, PRIORITY_FLAG = 32

            const PREFACE = Buffer.from("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n", "latin1")

            // The size of a frame this side accepts: the protocol's default, which it never raises.
            const MAX_FRAME = 16384

            // Flow-control credit is given back in lumps of this size rather than frame by frame.
            const CREDIT_LUMP = 16384

            // The window this side opens for every stream and for the connection: the protocol's
            // default, which it never raises, so a peer may have this much unacknowledged at most.
            const INITIAL_WINDOW = 65535

            // **The limits a peer is held to, which are nghttp2's in substance.** The first two are
            // advertised in this side's SETTINGS; the CONTINUATION cap is nghttp2's default since the
            // 2024 CONTINUATION flood, and the reset bucket is the one it added for the 2023 rapid
            // reset -- a burst of a thousand, refilled at thirty-three a second.
            const MAX_STREAMS = 100
            const MAX_HEADER_LIST = 65536
            const MAX_CONTINUATIONS = 8
            const RESET_BURST = 1000
            const RESET_RATE = 33

            const NO_ERROR = 0, FLOW_CONTROL_ERROR = 3, FRAME_SIZE_ERROR = 6, REFUSED_STREAM = 7, ENHANCE_YOUR_CALM = 11

            const frame = (type, flags, stream, payload) => {
                const head = Buffer.alloc(9)

                head.writeUIntBE(payload.length, 0, 3)
                head[3] = type
                head[4] = flags
                head.writeUInt32BE(stream, 5)

                return payload.length === 0 ? head : Buffer.concat([head, payload])
            }

            const u32 = (n) => {
                const b = Buffer.alloc(4)

                b.writeUInt32BE(n, 0)

                return b
            }

            class Session {
                constructor(auto) {
                    this.auto = auto
                    this.inbuf = Buffer.alloc(0)
                    this.prefaced = false
                    this.out = []
                    this.events = []
                    this.streams = new Map()
                    this.pending = new Set()
                    this.dec = new Decoder()
                    this.sendWin = 65535
                    this.peerWin = 65535
                    this.peerFrame = 16384
                    this.connCredit = 0
                    this.recvWin = INITIAL_WINDOW
                    this.continuing = null
                    this.lastStream = 0
                    this.closed = false
                    this.failed = null
                    this.resetTokens = RESET_BURST
                    this.resetAt = Date.now()

                    // The server's own SETTINGS go first: every default but the two limits it holds
                    // the peer to, so that a client which reads them never meets the refusal.
                    const limits = Buffer.alloc(12)

                    limits.writeUInt16BE(3, 0)
                    limits.writeUInt32BE(MAX_STREAMS, 2)
                    limits.writeUInt16BE(6, 6)
                    limits.writeUInt32BE(MAX_HEADER_LIST, 8)
                    this.out.push(frame(SETTINGS, 0, 0, limits))
                }

                // A connection error this side names: a GOAWAY carrying its code goes out ahead of the
                // sentence `h2Receive` answers, and the session reads nothing more. The program's own
                // `h2Goaway` after it is not sent, the peer having been told why already.
                fatal(code, message) {
                    this.goaway(this.lastStream, code)
                    this.failed = message
                    refuse(message)
                }

                // A stream error: RST_STREAM with its code, and the stream gone as though the peer had
                // reset it, so the program is told `streamClose` and forgets what it held for it.
                resetStream(stream, code) {
                    this.out.push(frame(RST_STREAM, 0, stream, u32(code)))

                    const s = this.streams.get(stream)

                    if (s !== undefined) this.drop(s, code)
                }

                // -- reading -------------------------------------------------------------------------------

                // Bytes in. Answers `null`, or the sentence for what the peer got wrong.
                receive(chunk) {
                    if (this.failed !== null) return this.failed

                    this.inbuf = this.inbuf.length === 0 ? Buffer.from(chunk) : Buffer.concat([this.inbuf, chunk])

                    try {
                        this.pump()
                    } catch (e) {
                        if (e instanceof H2Error) return e.message

                        throw e
                    }

                    return null
                }

                pump() {
                    if (!this.prefaced) {
                        const n = Math.min(this.inbuf.length, PREFACE.length)

                        if (!this.inbuf.subarray(0, n).equals(PREFACE.subarray(0, n)))
                            refuse("the connection did not begin with the HTTP/2 preface")

                        if (n < PREFACE.length) return

                        this.inbuf = this.inbuf.subarray(PREFACE.length)
                        this.prefaced = true
                    }

                    for (;;) {
                        if (this.inbuf.length < 9) return

                        const len = this.inbuf.readUIntBE(0, 3)

                        if (len > MAX_FRAME) this.fatal(FRAME_SIZE_ERROR, "a frame of " + len + " bytes is larger than the " + MAX_FRAME + " this side accepts")

                        if (this.inbuf.length < 9 + len) return

                        const type = this.inbuf[3]
                        const flags = this.inbuf[4]
                        const stream = this.inbuf.readUInt32BE(5) & 0x7fffffff
                        const payload = this.inbuf.subarray(9, 9 + len)

                        this.inbuf = this.inbuf.subarray(9 + len)
                        this.take(type, flags, stream, payload)
                    }
                }

                take(type, flags, stream, payload) {
                    if (this.continuing !== null && (type !== CONTINUATION || stream !== this.continuing.stream))
                        refuse("a header block was interrupted by another frame")

                    switch (type) {
                        case DATA: return this.takeData(flags, stream, payload)
                        case HEADERS: return this.takeHeaders(flags, stream, payload)
                        case CONTINUATION: return this.takeContinuation(flags, stream, payload)
                        case PRIORITY: return
                        case RST_STREAM: return this.takeReset(stream, payload)
                        case SETTINGS: return this.takeSettings(flags, stream, payload)
                        case PUSH_PROMISE: refuse("a client may not push")
                        case PING: return this.takePing(flags, stream, payload)
                        case GOAWAY: return this.takeGoaway(stream, payload)
                        case WINDOW_UPDATE: return this.takeWindow(stream, payload)
                        default: return
                    }
                }

                // A frame's payload without its padding.
                unpadded(flags, payload) {
                    if ((flags & PADDED) === 0) return [payload, 0]

                    if (payload.length < 1) refuse("a padded frame has no padding length")

                    const pad = payload[0]

                    if (pad >= payload.length) refuse("a frame is padded past its own length")

                    return [payload.subarray(1, payload.length - pad), pad + 1]
                }

                takeData(flags, stream, payload) {
                    if (stream === 0) refuse("DATA on stream zero")

                    // **THE PEER IS HELD TO BOTH WINDOWS, or a body is buffered for as long as it is
                    // sent.** Credit only goes back as the program consumes, so a client that ignores
                    // the windows is the one thing that could make this session hold more than they
                    // allow. Past the connection's it is a connection error; past a stream's, that
                    // stream is reset and the bytes are credited to the connection, nobody reading them.
                    // The whole payload counts, padding included, as RFC 9113 says.
                    if (payload.length > this.recvWin)
                        this.fatal(FLOW_CONTROL_ERROR, "the peer sent " + payload.length + " bytes of DATA past the connection's window of " + this.recvWin)

                    this.recvWin -= payload.length

                    const [data, padding] = this.unpadded(flags, payload)
                    const s = this.streams.get(stream)

                    if (s === undefined) {
                        if (stream > this.lastStream) refuse("DATA on a stream that was never opened")

                        this.credit(undefined, payload.length, false)

                        return
                    }

                    if (s.recvEnded) refuse("DATA on a stream the peer had ended")

                    if (payload.length > s.recvWin) {
                        this.credit(undefined, payload.length, false)
                        this.resetStream(stream, FLOW_CONTROL_ERROR)

                        return
                    }

                    s.recvWin -= payload.length

                    // Padding is not something the program reads, so its credit goes straight back.
                    this.credit(s, padding, true)

                    if (data.length > 0) {
                        this.events.push({ kind: "data", stream: stream, bytes: new Uint8Array(data) })

                        if (this.auto) this.consume(stream, data.length)
                    }

                    if ((flags & END_STREAM) !== 0) this.ended(s)
                }

                takeHeaders(flags, stream, payload) {
                    if (stream === 0) refuse("HEADERS on stream zero")

                    let [block] = this.unpadded(flags, payload)

                    if ((flags & PRIORITY_FLAG) !== 0) {
                        if (block.length < 5) refuse("a HEADERS frame is too short for its priority")

                        block = block.subarray(5)
                    }

                    if ((flags & END_HEADERS) === 0) {
                        this.continuing = { stream: stream, flags: flags, parts: [block], size: block.length, count: 0 }

                        return
                    }

                    this.headed(stream, flags, block)
                }

                takeContinuation(flags, stream, payload) {
                    if (this.continuing === null) refuse("a CONTINUATION with no header block to continue")

                    const held = this.continuing

                    // **A header block is bounded in frames and in bytes.** Held until END_HEADERS, a
                    // block nobody ends -- the 2024 CONTINUATION flood, often of empty frames -- would
                    // grow for as long as the peer kept sending, so past either limit the connection
                    // goes, as nghttp2's does.
                    held.count += 1
                    held.size += payload.length

                    if (held.count > MAX_CONTINUATIONS)
                        this.fatal(ENHANCE_YOUR_CALM, "a header block ran to more than " + MAX_CONTINUATIONS + " CONTINUATION frames")

                    if (held.size > MAX_HEADER_LIST)
                        this.fatal(ENHANCE_YOUR_CALM, "a header block ran past " + MAX_HEADER_LIST + " bytes")

                    held.parts.push(payload)

                    if ((flags & END_HEADERS) === 0) return

                    this.continuing = null
                    this.headed(stream, held.flags, Buffer.concat(held.parts))
                }

                // A whole header block has arrived: a request, or the trailers of one.
                headed(stream, flags, block) {
                    const fields = this.dec.decode(block, MAX_HEADER_LIST)
                    const known = this.streams.get(stream)

                    if (known !== undefined) {
                        if (known.recvEnded) refuse("HEADERS on a stream the peer had ended")

                        if (fields === null) return this.resetStream(stream, ENHANCE_YOUR_CALM)

                        this.events.push({ kind: "headers", stream: stream, headers: fields, of: "trailer" })

                        if ((flags & END_STREAM) !== 0) this.ended(known)

                        return
                    }

                    if (stream % 2 === 0 || stream <= this.lastStream)
                        refuse("a request opened stream " + stream + ", which a client may not use")

                    this.lastStream = stream

                    // **A request past a limit never reaches the program**, and the stream number is
                    // spent either way. Too many open at once is REFUSED_STREAM, which tells the client
                    // it may try again; a header list past the size this side advertised is answered
                    // `431` here, the program having nothing it could do with a request it was never
                    // given -- and a reset after it where the client meant to send a body.
                    if (this.streams.size >= MAX_STREAMS) {
                        this.out.push(frame(RST_STREAM, 0, stream, u32(REFUSED_STREAM)))

                        return
                    }

                    if (fields === null) {
                        const ends = (flags & END_STREAM) !== 0

                        this.headFrames(stream, encodeFields([[":status", "431", false]]), true)

                        if (!ends) this.out.push(frame(RST_STREAM, 0, stream, u32(NO_ERROR)))

                        return
                    }

                    const s = {
                        id: stream,
                        recvWin: INITIAL_WINDOW,
                        recvEnded: false,
                        sentEnded: false,
                        headSent: false,
                        finishing: false,
                        trailers: null,
                        queue: [],
                        sendWin: this.peerWin,
                        credit: 0,
                        closed: false
                    }

                    this.streams.set(stream, s)
                    this.events.push({ kind: "headers", stream: stream, headers: fields, of: "request" })

                    if ((flags & END_STREAM) !== 0) this.ended(s)
                }

                // The peer will send this stream no more.
                ended(s) {
                    s.recvEnded = true

                    this.events.push({ kind: "streamEnd", stream: s.id })
                    this.settle(s)
                }

                // Both halves of a stream are over: it goes, and the program is told.
                settle(s) {
                    if (s.recvEnded && s.sentEnded) this.drop(s, 0)
                }

                drop(s, code) {
                    if (s.closed) return

                    s.closed = true
                    s.queue = []

                    this.streams.delete(s.id)
                    this.pending.delete(s)
                    this.events.push({ kind: "streamClose", stream: s.id, code: code })
                }

                takeReset(stream, payload) {
                    if (stream === 0) refuse("RST_STREAM on stream zero")
                    if (payload.length !== 4) refuse("an RST_STREAM that is not four bytes")

                    const s = this.streams.get(stream)

                    if (s === undefined) return

                    // **Rapid reset**, the 2023 pattern: a request opened and reset at once costs the
                    // client two frames and the server a handler, so resets are drawn from nghttp2's
                    // bucket, and a client that empties it is told to calm down and hung up on.
                    const now = Date.now()

                    this.resetTokens = Math.min(RESET_BURST, this.resetTokens + (now - this.resetAt) * RESET_RATE / 1000)
                    this.resetAt = now

                    if (this.resetTokens < 1)
                        this.fatal(ENHANCE_YOUR_CALM, "the peer reset streams faster than " + RESET_RATE + " a second, after a burst of " + RESET_BURST)

                    this.resetTokens -= 1
                    this.events.push({ kind: "rstStream", stream: stream, code: payload.readUInt32BE(0) })
                    this.drop(s, payload.readUInt32BE(0))
                }

                takeSettings(flags, stream, payload) {
                    if (stream !== 0) refuse("SETTINGS on a stream")

                    if ((flags & ACK) !== 0) {
                        if (payload.length !== 0) refuse("a SETTINGS acknowledgement with a payload")

                        return
                    }

                    if (payload.length % 6 !== 0) refuse("a SETTINGS frame that is not whole entries")

                    for (let at = 0; at < payload.length; at += 6) {
                        const id = payload.readUInt16BE(at)
                        const value = payload.readUInt32BE(at + 2)

                        if (id === 4) {
                            if (value > 0x7fffffff) refuse("an initial window larger than the protocol allows")

                            const delta = value - this.peerWin

                            this.peerWin = value

                            for (const s of this.streams.values()) s.sendWin += delta
                        } else if (id === 5) {
                            if (value < 16384 || value > 16777215) refuse("a maximum frame size outside the protocol's range")

                            this.peerFrame = value
                        }
                    }

                    this.out.push(frame(SETTINGS, ACK, 0, Buffer.alloc(0)))
                    this.events.push({ kind: "settings" })
                }

                takePing(flags, stream, payload) {
                    if (stream !== 0) refuse("PING on a stream")
                    if (payload.length !== 8) refuse("a PING that is not eight bytes")

                    const ack = (flags & ACK) !== 0

                    if (!ack) this.out.push(frame(PING, ACK, 0, Buffer.from(payload)))

                    this.events.push({ kind: "ping", ack: ack })
                }

                takeGoaway(stream, payload) {
                    if (stream !== 0) refuse("GOAWAY on a stream")
                    if (payload.length < 8) refuse("a GOAWAY that is too short")

                    this.events.push({
                        kind: "goaway",
                        lastStream: payload.readUInt32BE(0) & 0x7fffffff,
                        code: payload.readUInt32BE(4)
                    })
                }

                takeWindow(stream, payload) {
                    if (payload.length !== 4) refuse("a WINDOW_UPDATE that is not four bytes")

                    const by = payload.readUInt32BE(0) & 0x7fffffff

                    if (by === 0) refuse("a WINDOW_UPDATE of nothing")

                    if (stream === 0) {
                        this.sendWin += by

                        if (this.sendWin > 0x7fffffff) refuse("a connection window past the protocol's limit")
                    } else {
                        const s = this.streams.get(stream)

                        if (s === undefined) return

                        s.sendWin += by

                        if (s.sendWin > 0x7fffffff) {
                            this.out.push(frame(RST_STREAM, 0, stream, u32(3)))
                            this.drop(s, 3)

                            return
                        }
                    }

                    this.events.push({ kind: "windowUpdate", stream: stream, increment: by })
                }

                // -- flow control received ----------------------------------------------------------------

                // Credit `n` bytes back to the peer: the connection's, and the stream's where it is still
                // sending. **Lumps, not frames**, so a body arriving in sixteen-kilobyte DATA frames is
                // not answered by a WINDOW_UPDATE per frame.
                credit(s, n, immediate) {
                    if (n === 0) return

                    this.connCredit += n

                    if (immediate || this.connCredit >= CREDIT_LUMP) {
                        this.out.push(frame(WINDOW_UPDATE, 0, 0, u32(this.connCredit)))
                        this.recvWin += this.connCredit
                        this.connCredit = 0
                    }

                    if (s === undefined || s.recvEnded) return

                    s.credit += n

                    if (immediate || s.credit >= CREDIT_LUMP) {
                        this.out.push(frame(WINDOW_UPDATE, 0, s.id, u32(s.credit)))
                        s.recvWin += s.credit
                        s.credit = 0
                    }
                }

                consume(stream, n) {
                    this.credit(this.streams.get(stream), n, false)
                }

                // -- writing -------------------------------------------------------------------------------

                // A header block as a HEADERS frame and the CONTINUATIONs it needs.
                headFrames(stream, block, endStream) {
                    const size = this.peerFrame
                    let first = true

                    for (let at = 0; first || at < block.length; at += size) {
                        const part = block.subarray(at, at + size)
                        const last = at + size >= block.length

                        if (first) {
                            this.out.push(frame(HEADERS, (last ? END_HEADERS : 0) | (endStream ? END_STREAM : 0), stream, part))
                            first = false
                        } else {
                            this.out.push(frame(CONTINUATION, last ? END_HEADERS : 0, stream, part))
                        }
                    }
                }

                open(stream, name) {
                    const s = this.streams.get(stream)

                    if (s === undefined || s.closed) fault("`" + name + "` was given stream " + stream + ", which is not open")

                    return s
                }

                respond(stream, fields, body, whole) {
                    const s = this.open(stream, whole ? "h2Respond" : "h2RespondStream")

                    if (s.headSent) fault("stream " + stream + " has already been answered")

                    s.headSent = true

                    const ends = whole && body.length === 0

                    this.headFrames(stream, encodeFields(fields), ends)

                    if (ends) {
                        s.sentEnded = true
                        this.settle(s)

                        return
                    }

                    if (whole) {
                        s.queue.push(body)
                        s.finishing = true
                        this.pending.add(s)
                    }
                }

                push(stream, piece) {
                    const s = this.streams.get(stream)

                    if (s === undefined || s.closed) return "stream " + stream + " is closed"
                    if (!s.headSent) return "stream " + stream + " has no head yet"
                    if (s.finishing) return "stream " + stream + " has already been finished"

                    if (piece.length > 0) {
                        s.queue.push(piece)
                        this.pending.add(s)
                    }

                    return null
                }

                finish(stream, trailers) {
                    const s = this.streams.get(stream)

                    if (s === undefined || s.closed) return "stream " + stream + " is closed"
                    if (!s.headSent) return "stream " + stream + " has no head yet"
                    if (s.finishing) return "stream " + stream + " has already been finished"

                    s.finishing = true
                    s.trailers = trailers === null ? null : encodeFields(trailers)
                    this.pending.add(s)

                    return null
                }

                goaway(last, code) {
                    if (this.failed !== null) return

                    const body = Buffer.alloc(8)

                    body.writeUInt32BE(last, 0)
                    body.writeUInt32BE(code, 4)
                    this.out.push(frame(GOAWAY, 0, 0, body))
                }

                // Every queued body that the windows allow, as DATA frames.
                flush() {
                    for (const s of this.pending) {
                        while (s.queue.length > 0 && s.sendWin > 0 && this.sendWin > 0) {
                            const head = s.queue[0]
                            const n = Math.min(head.length, s.sendWin, this.sendWin, this.peerFrame)
                            const piece = n === head.length ? head : head.subarray(0, n)

                            if (n === head.length) s.queue.shift()
                            else s.queue[0] = head.subarray(n)

                            s.sendWin -= n
                            this.sendWin -= n

                            const last = s.queue.length === 0 && s.finishing && s.trailers === null

                            this.out.push(frame(DATA, last ? END_STREAM : 0, s.id, Buffer.from(piece)))

                            if (last) {
                                s.sentEnded = true

                                break
                            }
                        }

                        if (s.queue.length === 0 && s.finishing && !s.sentEnded) {
                            if (s.trailers !== null) this.headFrames(s.id, s.trailers, true)
                            else this.out.push(frame(DATA, END_STREAM, s.id, Buffer.alloc(0)))

                            s.sentEnded = true
                        }

                        if (s.queue.length === 0) {
                            this.pending.delete(s)
                            this.settle(s)
                        }
                    }
                }

                send() {
                    this.flush()

                    const out = this.out.length === 0 ? Buffer.alloc(0) : Buffer.concat(this.out)

                    this.out = []

                    return out
                }
            }

            return { Session, H2Error }
        })()

"""

#else
js_runtime_h2() -> string = ""
#endif
