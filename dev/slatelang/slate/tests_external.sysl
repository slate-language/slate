module dev.slatelang.slate
@tests

import sysl.text.Search

// `external` -- naming a value of the JavaScript host, and what crosses the boundary.
//
// **The two hosts answer DIFFERENTLY here on purpose, so there is no corpus file and there cannot
// be one.** A corpus file is one program run twice and diffed; an external is the host's value, and
// the interpreter has no host -- so what a program does with one is an answer under `slate js` and a
// refusal naming the command in the interpreter. `node_said` is what asks the JavaScript side, which
// is `slate:dom`'s and `slate:lmdb`'s arrangement for the same reason.
//
// `docs/reference/external.md` is the chapter and is run by the suite as well.

// -- the declaration ----------------------------------------------------------------------------

@test
AN_EXTERNAL_DECLARATION_BINDS_A_GLOBAL_BY_NAME()
    val p = "external JSON\n\nprint(JSON.stringify({ a: 1 }))\n"

    assert_eq(node_said(p), "{\"a\":1}")

// **A path is how a global is REACHED and everything after it is an operation on the value**, so the
// declaration takes names with dots between them and nothing else.
@test
AN_EXTERNAL_DECLARATION_BINDS_A_DOTTED_PATH()
    val p = "external stringify = \"JSON.stringify\"\n\nprint(stringify([1, 2]))\n"

    assert_eq(node_said(p), "[1,2]")

@test
AN_EXTERNAL_DECLARATION_IS_REFUSED_BELOW_THE_TOP_LEVEL()
    val p = "main()\n    external localStorage\n\n    print(1)\n\nmain()\n"

    assert(fails(p).contains("top level of a file"))

@test
A_PATH_THAT_IS_NOT_NAMES_WITH_DOTS_IS_REFUSED()
    assert(fails("external f = \"JSON.stringify()\"\n").contains("is not a path to a host value"))
    assert(fails("external f = \"\"\n").contains("is not a path to a host value"))
    assert(fails("external f = \"a..b\"\n").contains("is not a path to a host value"))

// **A global that is not there is a fault at the DECLARATION and not at the first use**, which is
// nearly always a program in the wrong host -- a node build reaching for `document`, a page reaching
// for `process`.
@test
A_MISSING_GLOBAL_FAULTS_AT_THE_DECLARATION_QUOTING_THE_PATH()
    val p = "external nothingIsHere\n\nprint(1)\n"

    assert(node_said(p).contains("this JavaScript host has no `nothingIsHere`"))

// -- what the checker may and may not say ---------------------------------------------------------

// **Arithmetic over an external is refused before the program runs**, the machine refusing it too --
// which is what this pass is allowed to report and the whole of what it is allowed to report.
@test
ARITHMETIC_ON_AN_EXTERNAL_IS_REFUSED_BY_THE_CHECKER()
    val said = fails("external localStorage\n\nprint(localStorage + 1)\n")

    assert(said.contains("does not apply to external"))

@test
AN_EXTERNAL_ANNOTATION_FITS_ONLY_AN_EXTERNAL()
    val bad = "external localStorage\n\nf(x: external) = 1\n\nprint(f(2))\n"
    val good = "external localStorage\n\nf(x: external) = 1\n\nprint(f(localStorage))\n"

    assert(fails(bad).contains("external"))
    assert_eq(out(good), "1")

// **Nothing about an external's MEMBERS is claimed, which is why `ExternalType` answers no method
// kind.** A refusal there would be this pass inventing a fault about a name only the host can know.
@test
THE_CHECKER_SAYS_NOTHING_ABOUT_AN_EXTERNALS_MEMBERS()
    val said = fails("external localStorage\n\nlocalStorage.whateverThisIs(1)\n")

    assert(said.contains("no JavaScript host"))
    assert(!said.contains("is not something"))

// -- what an external is to the language ------------------------------------------------------------

// **The restriction is on OPERATIONS and never on travel**, or a program could not hold the observer
// it made for as long as the element it watches.
@test
AN_EXTERNAL_IS_A_VALUE_AND_STORING_ONE_IS_ORDINARY()
    val p = "external localStorage\n\nval kept = [localStorage]\n\n" +
        "print(kept.length, kept[0] == localStorage, localStorage is external)\n"

    assert_eq(out(p), "1 true true")

// **Nothing a pattern does may fault**, so a structural pattern does not match rather than refusing.
@test
AN_EXTERNAL_MATCHES_ONLY_A_NAME_AND_A_WILDCARD()
    val p = "external localStorage\n\nprint(localStorage match\n" +
        "    n @ number -> \"a number\"\n" +
        "    { length } -> \"an object\"\n" +
        "    [a] -> \"an array\"\n" +
        "    _ -> \"only the name\")\n"

    assert_eq(out(p), "only the name")

// **Identity, and there is nothing structural to fall back on.** Two declarations of one path name
// one host value; two paths name two.
@test
EQUALITY_IS_IDENTITY_AND_TWO_DECLARATIONS_OF_ONE_PATH_ARE_ONE_VALUE()
    val p = "external a = \"JSON\"\nexternal b = \"JSON\"\nexternal c = \"Math\"\n\n" +
        "print(a == b, a == c, a != c)\n"

    assert_eq(out(p), "true false true")
    assert_eq(node_said(p), "true false true")

@test
AN_EXTERNAL_PRINTS_BARE_WHERE_THE_HOST_OFFERS_NO_NAME()
    assert_eq(out("external localStorage\n\nprint(localStorage)\n"), "<external>")

@test
AN_EXTERNAL_PRINTS_ITS_CONSTRUCTOR_NAME_ON_THE_JAVASCRIPT_HOST()
    val p = "external Map\n\nprint(Map.new())\n"

    assert_eq(node_said(p), "<external Map>")

// -- the interpreter ------------------------------------------------------------------------------

// **The declaration RUNS and only the operations refuse**, which is `slate:dom`'s rule: a refusal at
// the declaration would make an import of a module that binds a host value a complaint about the
// module, and the module is the one thing that is right.
@test
THE_DECLARATION_ITSELF_RUNS_UNDER_THE_INTERPRETER()
    assert_eq(out("external localStorage\n\nprint(\"ran\")\n"), "ran")

@test
EVERY_HOST_OPERATION_ON_AN_EXTERNAL_FAULTS_NAMING_THE_COMMAND()
    val decl = "external x = \"JSON\"\n\n"

    assert(fails(decl + "print(x.parse)\n").contains("no JavaScript host"))
    assert(fails(decl + "print(x.parse(\"1\"))\n").contains("no JavaScript host"))
    assert(fails(decl + "print(x[\"parse\"])\n").contains("no JavaScript host"))
    assert(fails(decl + "x[\"parse\"] = 1\n").contains("no JavaScript host"))
    assert(fails(decl + "print(x(1))\n").contains("no JavaScript host"))
    assert(fails(decl + "print(x.new(1))\n").contains("no JavaScript host"))
    assert(fails(decl + "print(x.parse(\"1\"))\n").contains("slate js"))

// -- what crosses the boundary --------------------------------------------------------------------

// **An array and an object are COPIED**, slate's array being the host's array and slate's object a
// table the runtime owns -- so handing either straight out would put slate's own representation
// where the host can write to it.
@test
A_SLATE_ARRAY_AND_OBJECT_CROSS_OUT_AS_COPIES()
    val p = "external JSON\n\n" +
        "print(JSON.stringify({ a: [1, 2.5, \"x\", true, null], b: { c: 1 } }))\n"

    assert_eq(node_said(p), "{\"a\":[1,2.5,\"x\",true,null],\"b\":{\"c\":1}}")

@test
AN_INTEGER_TOO_LARGE_TO_BE_EXACT_FAULTS_AT_THE_BOUNDARY()
    val p = "external JSON\n\nprint(JSON.stringify(1 << 60))\n"

    assert(node_said(p).contains("too large to hand to JavaScript exactly"))

@test
A_VALUE_WITH_NO_JAVASCRIPT_READING_FAULTS_NAMING_ITS_KIND()
    val p = "external JSON\n\nprint(JSON.stringify(Set([1])))\n"

    assert(node_said(p).contains("a set does not cross to JavaScript"))

// **A whole number is an integer and a fractional one is a real**, which is `slate:dom`'s rule for
// its own property reads: what a program reads off a host is most often a count, and a real there
// would make the loop written over it a fault.
@test
A_HOST_NUMBER_COMES_BACK_WHOLE_OR_FRACTIONAL()
    val p = "external JSON\n\nval v = JSON.parse(\"{\\\"n\\\": 4, \\\"f\\\": 1.5}\")\n\n" +
        "print(v.n, v.f, v.n is integer, v.f is real)\n"

    assert_eq(node_said(p), "4 1.5 true true")

// **`undefined` becomes `null`**: a property that is absent and one holding `undefined` are the same
// read in JavaScript, so nothing here can honestly say which happened -- and slate's own `undefined`
// may not be stored anywhere.
@test
UNDEFINED_FROM_THE_HOST_COMES_BACK_NULL()
    val p = "external JSON\n\nval v = JSON.parse(\"{}\")\n\nprint(v.nope == null)\n"

    assert_eq(node_said(p), "true")

// **Everything that is not a primitive stays external**, which is the invariant read backwards.
@test
A_HOST_OBJECT_AND_ARRAY_COME_BACK_EXTERNAL()
    val p = "external JSON\n\nval v = JSON.parse(\"[1, {\\\"a\\\": 1}]\")\n\n" +
        "print(v is external, v[0], v[1] is external, v[1].a)\n"

    assert_eq(node_said(p), "true 1 true 1")

@test
A_THENABLE_COMES_BACK_A_PROMISE_AND_AWAIT_WAITS_ON_IT()
    val p = "external Promise\n\nasync main()\n" +
        "    val p = Promise.resolve(41)\n\n" +
        "    print(p is promise, await p)\n\nmain()\n"

    assert_eq(node_said(p), "true 41")

// **A callback is given as many arguments as it declares and no more**, which is the rule slate's own
// natives follow -- JavaScript's `map` calls back with three, so a strict count would refuse the
// ordinary case.
@test
A_CLOSURE_HANDED_OUT_TAKES_AS_MANY_ARGUMENTS_AS_IT_DECLARES()
    val p = "external Array\nexternal JSON\n\nmain()\n" +
        "    val xs = Array.new(3)\n\n    xs.fill(7)\n\n" +
        "    print(JSON.stringify(xs.map((v, i) -> v + i)))\n" +
        "    print(JSON.stringify(xs.map(v -> v * 2)))\n\nmain()\n"

    assert_eq(node_said(p), "[7,8,9]\n[14,14,14]")

// **A method call keeps its receiver and a bare call keeps the one its PATH gave it**, which is what
// a host method called on anything else throws about -- a browser's `fetch` called off the window
// answers `Illegal invocation` and makes no request at all.
@test
A_METHOD_CALL_KEEPS_THE_RECEIVER_AND_A_GLOBAL_CALL_KEEPS_THE_GLOBAL()
    val p = "external Map\nexternal isNaN\n\nmain()\n" +
        "    val m = Map.new()\n\n    m.set(\"k\", 5)\n\n" +
        "    print(m.get(\"k\"), m.size, isNaN(1))\n\n" +
        "    val taken = m.get\n\n    try\n        taken(\"k\")\n    catch e\n        print(\"unbound\")\n\nmain()\n"

    assert_eq(node_said(p), "5 1 false\nunbound")

@test
NEW_ON_AN_EXTERNAL_CONSTRUCTS_WITH_JAVASCRIPTS_NEW()
    val p = "external Map\n\nmain()\n    val m = Map.new([[\"a\", 1]])\n\n" +
        "    print(m.get(\"a\"), m is external)\n\nmain()\n"

    assert_eq(node_said(p), "1 true")

@test
A_PROPERTY_WRITE_AND_A_COMPUTED_KEY_REACH_THE_HOST()
    val p = "external JSON\n\nmain()\n" +
        "    val v = JSON.parse(\"{\\\"a\\\": 1}\")\n\n    v.b = 2\n    v[\"c\"] = 3\n\n" +
        "    print(v.b, v[\"c\"], JSON.stringify(v))\n\nmain()\n"

    assert_eq(node_said(p), "2 3 {\"a\":1,\"b\":2,\"c\":3}")
