module dev.slatelang.slate

// `slate:url` -- percent-encoding and the `name=value` grammar, and nothing else.
//
// **IT EXISTS SO THAT A PAGE CAN REACH THEM.** These four were `slate:http`'s, exported with a
// comment saying in as many words that a framework over that module needs the same decoder its
// router uses. That was true and the export was not enough: a browser page importing `slate:http`
// to reach two functions grows by **239 KB** -- 340,761 bytes to 579,710, measured -- because the
// JavaScript back end emits the whole of an imported module and `slate:http` is a server, an HTTP/2
// speaker and a file server. A page that only wants to read a query string was paying for all of it.
//
// **So this is the lowest module slate has after `slate:llhttp`**, and it is here for the same
// reason that one is: what a program actually wanted was underneath something much larger.
// `slate:http` imports it, so nothing that was written against `slate:http` changed.
//
// **It asks nothing of the host.** No socket, no clock, no document -- `toBytes` and `fromBytes` are
// the whole of what it reaches for, so it works under the interpreter, under node and in a browser
// with no branch anywhere.
//
// **base64url IS HERE FOR THE REASON THE PERCENT-CODER IS.** `slate:jwt` had one privately and three
// other places wanted it: a signed cookie, a webhook signature, an identifier that has to survive a
// URL. None of them could reach it, so each wrote hex instead and paid a third more bytes for it.
// It is a URL-safe encoding of bytes, which is what this module is about, and it asks nothing of the
// host either -- so `slate:jwt` now imports it from here rather than carrying its own copy.

url_source() -> string = raw"""
    // -- percent-encoding --------------------------------------------------------------------------

    // Percent-decoding, over BYTES rather than characters.
    //
    // **`%C3%A9` is two bytes that are one character**, so a decoder working a character at a time cannot
    // put them back together -- it collects the bytes and decodes the lot at the end. That is also why
    // this answers its input unchanged where the bytes turn out not to be text: a URL is something
    // somebody else wrote, and a fault here would let any peer stop a program.
    //
    // `plusIsSpace` is the one difference between a query or a form and everything else that is
    // percent-encoded. A cookie's `+` is a `+`, and so is a path segment's.
    export percentDecode(s: string, plusIsSpace: boolean) -> string =
        if !contains(s, "%") && !(plusIsSpace && contains(s, "+")) then return s

        val bs = toBytes(s)
        var out = []
        var i = 0

        while i < len(bs)
            val b = bs[i]

            if b == 37 && i + 2 < len(bs)
                val hi = hexNibble(bs[i + 1])
                val lo = hexNibble(bs[i + 2])

                // **A `%` that is not followed by two hex digits is a `%`**, which is what every browser
                // does with one. Refusing would be refusing a request over a character a person typed.
                if hi < 0 || lo < 0
                    push(out, b)
                    i = i + 1
                else
                    push(out, hi * 16 + lo)
                    i = i + 3
            elif b == 43 && plusIsSpace
                push(out, 32)
                i = i + 1
            else
                push(out, b)
                i = i + 1

        val back = fromBytes(out)

        if back.ok then back.value else s

    hexNibble(b: integer) -> integer =
        if b >= 48 && b <= 57 then b - 48
        elif b >= 65 && b <= 70 then b - 55
        elif b >= 97 && b <= 102 then b - 87
        else 0 - 1

    // Percent-ENCODING, for a value going into a URL or a cookie.
    //
    // **The unreserved set of RFC 3986 and nothing more.** Encoding more than is needed is always safe
    // and encoding less never is, so the rule is the narrow one.
    export encodeComponent(s: string) -> string =
        val bs = toBytes(s)
        var out = []
        var i = 0

        while i < len(bs)
            val b = bs[i]

            if unreserved(b)
                push(out, b)
            else
                push(out, 37)
                push(out, hexDigit(b / 16))
                push(out, hexDigit(b % 16))

            i = i + 1

        fromBytes(out).value

    // **The brackets are what continue the lines**, a trailing operator outside a bracket pair not
    // being a continuation in slate.
    unreserved(b: integer) -> boolean =
        ((b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) ||
            b == 45 || b == 46 || b == 95 || b == 126)

    hexDigit(n: integer) -> integer = if n < 10 then 48 + n else 55 + n

    // -- the `name=value` grammar ------------------------------------------------------------------

    // `a=1&b=two+words` as an object.
    //
    // **A repeated name is the LAST one**, and that is a decision rather than an oversight. The
    // alternative every framework reaches for is an array where a name repeats, which makes the TYPE of
    // `q.name` depend on what a client sent -- so a program that read it as a string works until somebody
    // sends the field twice. A value whose shape varies is the thing this language argues against
    // everywhere; a name a program genuinely expects more than once is read off the raw text by hand.
    export parseQuery(s: string) -> object = parsePairs(s, "&", true)

    // The same grammar with the separator and the `+` rule named, which is what a query string, a
    // form body and a `Cookie` header all are.
    //
    // **Exported because the three callers do not exhaust it.** `slate:http` reads forms and cookies
    // through this; a program reading any other header of the same shape -- and there are a dozen --
    // would otherwise write it again.
    export parsePairs(s: string, sep: string, plusIsSpace: boolean) -> object =
        var out = {}

        if s == "" then return out

        for part in split(s, sep)
            val one = trim(part)

            if one != ""
                val at = indexOf(one, "=")

                if at == null
                    // **A name with no `=` is present and empty**, which is what a bare `?debug` means to
                    // everybody who writes one.
                    out[percentDecode(one, plusIsSpace)] = ""
                elif at > 0
                    val name = one[0..<at]
                    val value = unquoted(one[(at + 1)..<len(one)])

                    out[if plusIsSpace then percentDecode(name, true) else name] = percentDecode(value, plusIsSpace)

        out

    // A value may be wrapped in quotes -- a cookie's is, by the specification -- and a program wants
    // what is inside.
    unquoted(v: string) -> string =
        if len(v) >= 2 && startsWith(v, "\"") && endsWith(v, "\"") then v[1..<(len(v) - 1)] else v

    // -- base64url ----------------------------------------------------------------------------------

    // The URL and filename safe alphabet of RFC 4648 SS5: base64 with two characters swapped -- `-`
    // for `+` and `_` for `/` -- so that what comes out needs no percent-encoding on top of it.
    val Base64urlChars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

    // `base64urlEncode(v)` -- bytes, or the bytes of a string, as unpadded base64url.
    //
    // **A string is its UTF-8 bytes**, which is `encodeComponent`'s rule beside it and the only
    // reading there is: what an encoding of bytes does with text is encode the text's bytes.
    //
    // **THE PADDING IS LEFT OFF, and that is what makes this base64url rather than base64.** A `=` is
    // not safe in a URL and JOSE forbids it outright, so there is no option to write one -- an
    // encoder whose answer sometimes had to be percent-encoded would defeat the point of the
    // alphabet.
    export base64urlEncode(v: string | array) -> string =
        val bytes = if v is string then toBytes(v) else v
        var out = ""
        var i = 0

        while i + 2 < len(bytes)
            val n = bytes[i] * 65536 + bytes[i + 1] * 256 + bytes[i + 2]

            out = out + Base64urlChars[n / 262144 % 64] + Base64urlChars[n / 4096 % 64]
            out = out + Base64urlChars[n / 64 % 64] + Base64urlChars[n % 64]
            i = i + 3

        val left = len(bytes) - i

        // The tail is one or two bytes, written as the two or three characters that carry them.
        if left == 1
            val n = bytes[i] * 16

            out = out + Base64urlChars[n / 64 % 64] + Base64urlChars[n % 64]
        elif left == 2
            val n = bytes[i] * 1024 + bytes[i + 1] * 4

            out = out + Base64urlChars[n / 4096 % 64] + Base64urlChars[n / 64 % 64] + Base64urlChars[n % 64]

        out

    // `base64urlDecode(s)` -- the BYTES that text stands for, or why it is not base64url.
    //
    // **It answers a result rather than faulting, and answers BYTES rather than text.** Text
    // encoded this way arrives from outside -- a cookie, a token, a signature somebody sent -- so
    // being malformed is a condition the caller was always going to deal with, which is this
    // language's rule for anything read from outside. And what was encoded is as likely to be a
    // digest as a sentence: `fromBytes` is the one call to text, and it answers a result of its own
    // for the same reason, so the two compose without either of them guessing.
    //
    //     val r = base64urlDecode(piece)
    //
    //     if r.ok then fromBytes(r.value) else r
    export base64urlDecode(s: string) -> object =
        // **A length one past a multiple of four is not base64url at all.** Six bits per character
        // means a leftover of one character carries no whole byte, so such a piece is truncated
        // rather than merely odd -- and answering the bytes before the truncation would let a
        // signature be compared against a prefix of itself.
        if len(s) % 4 == 1
            return { ok: false, error: "a base64url piece is never one character past a multiple of four" }

        var out = []
        var acc = 0
        var bits = 0

        for c in chars(s)
            val v = indexOf(Base64urlChars, c)

            // **The character is named**, a decoder saying only that its input was wrong being a
            // sentence a reader can do nothing with. `=` lands here, which is right: the padded
            // spelling is base64 and this is not it.
            if v == null
                return { ok: false, error: "`" + c + "` is not a base64url character" }

            acc = acc * 64 + v
            bits = bits + 6

            if bits >= 8
                bits = bits - 8

                // **Written out rather than worked out.** Six bits in and eight out leaves 0, 2 or 4,
                // so there are exactly three answers and no arithmetic worth doing once per
                // character.
                val shift = if bits == 0 then 1 elif bits == 2 then 4 else 16

                push(out, acc / shift % 256)
                acc = acc % shift

        // **Left-over bits must be zero.** Two spellings differing only in the bits past the last
        // whole byte would otherwise decode to the same bytes, which is how a signature check is
        // walked past in a format that compares its tokens as text.
        if acc != 0
            return { ok: false, error: "this text ends with bits that are not part of a byte" }

        { ok: true, value: out }
    """
