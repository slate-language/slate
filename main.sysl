import slate.*
import sh.sysl.parsing.*

main()
    val src = source_of("probe.slate", "val x = 42\nif x > 10\n    print(\"big\")\n")
    val r = lex(src)

    if !r.ok()
        print(r.report.render(src))
    else
        var t = r.tokens

        loop
            t.advance() match
                None -> break
                Some(x) -> print(x)
