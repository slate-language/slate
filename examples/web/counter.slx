// A counter in a web page -- the smallest thing that is a whole application.
//
// **The same components render to markup and to the document**, which is the point of the exercise:
// nothing below mentions a page except the last two lines, and swapping `domHost("#app")` for the
// default string host renders the same tree to a string beside `slate:http`.
//
// Build it and load `index.html` beside it:
//
//     slate js examples/web/counter.slx -o examples/web/counter.js

import { createElement, Fragment, mount, useState } from "../../packages/react/react.slx"
import { domHost } from "../../packages/react/dom.slx"

Counter({ start = 0, step = 1 }) =
    val [count, setCount] = useState(start)

    <div class="counter">
        <p class="reading">{count}</p>
        <button onClick={() -> setCount(count + step)}>+{step}</button>
        <button onClick={() -> setCount(count - step)}>-{step}</button>
        <button class="reset" onClick={() -> setCount(start)}>reset</button>
    </div>

App(props) =
    <>
        <h1>slate counts</h1>
        <Counter start={0} step={1}/>
        <Counter start={100} step={5}/>
    </>

mount(<App/>, domHost("#app"))
