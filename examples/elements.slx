// Elements, written in the source.
//
// **slate calls this slx, after tsx, and an element is a CALL.** `<div class="x">hi</div>` is read
// as `createElement("div", { class: "x" }, ["hi"])` and handed on -- so nothing in the language knows
// what an element means, and the function below is where the meaning is. A framework supplies a real
// one; this file supplies a small one you can read, which is the point.
//
// The file is named `.slx` the way a React file is named `.tsx`. It buys nothing but the name: slate
// reads elements in every file, `<` in prefix position being unable to begin anything else.

// **A lowercase tag is a host element and arrives as the string `"div"`; a capitalised one is a name
// the program has in scope and arrives as the value.** React's rule, and the reason a component is
// written `Card` and a paragraph `p`.
createElement(t, props, kids) =
    // A component renders by being called, and is handed its children under `children`.
    if t is function then return t({ ...props, children: kids })

    var out = s"<${t}"

    for [name, value] in entries(props)
        out = s"${out} ${name}=\"${value}\""

    s"${out}>${rendered(kids)}</${t}>"

// **A child may itself be a list**, `{items.map(...)}` being one, so the children are flattened as
// they are rendered rather than at the point they were written.
rendered(kids) =
    var out = ""

    for kid in kids
        if kid is array
            out = s"${out}${rendered(kid)}"
        else
            out = s"${out}${kid}"

    out

// `<>...</>` is an element whose type is this, which is how a component returns several things
// without a tag around them.
Fragment(props) = rendered(props.children)

// A hole is an ordinary expression, and the text around it keeps the spaces it was written with.
val who = "world"

print(<p>hello {who}!</p>)

// An attribute's value is a string or a `{ ... }`, and a bare one is `true` -- which is what
// `disabled` means everywhere it is written. A hyphen is part of a name inside a tag.
print(<input type="text" data-id="name" disabled/>)

// A component is a function of its props.
Card(props) = <div class="card"><h2>{props.title}</h2>{props.children}</div>

print(<Card title="Notes">a note</Card>)

// `{...}` spreads an object's fields into the attributes, and one written after it wins -- the same
// rule, and the same `with`, that an object literal's `...` has.
val theme = { class: "dark", lang: "en" }

print(<span {...theme} lang="fr">bonjour</span>)

// **An element written across lines opens no block**, the layout being suspended inside one the way
// it is inside brackets. Text that spans lines is trimmed of the indentation that only lined it up
// under its tag, and joined with one space; text on a single line is kept exactly as written.
print(
    <ul class="list">
        <li>one</li>
        <li>two</li>
    </ul>)

// An element is an expression, so it goes wherever one goes.
val rows = ["a", "b"].map(r -> <li>{r}</li>)

print(<><h3>rows</h3>{rows}</>)
