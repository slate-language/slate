// A React-like framework, written in slate.
//
// **`packages/react/` is the framework and this is a page built with it.** A component is a function
// of its props; `useState` gives it something to remember; `mount` renders it and keeps the tree so
// that a change can render it again. Nothing in the language knows what an element means --
// `<div/>` is `createElement("div", {}, [])`, and `createElement` is imported like anything else.
import { createElement, Fragment, mount, html, flush, useState, useMemo, useEffect } from "../packages/react/react.slx"

// A component is a function of its props, and `props.children` is what was written between its tags.
Panel(props) = <section class="panel"><h2>{props.title}</h2>{props.children}</section>

// `useState` answers the value and the way to change it. The setter takes a value or a function of
// the old one, and a set to what is already there renders nothing.
Counter(props) =
    val [count, setCount] = useState(props.from)

    // Worked out only when what it depends on changes.
    val label = useMemo(() -> "counted " + string(count) + " times", [count])

    // Run after the render is committed, and again whenever `count` changes.
    useEffect(() -> note(count), [count])

    <div class="counter">
        <p>{label}</p>
        <button onClick={() -> setCount(n -> n + 1)}>+1</button>
    </div>

val log = []

note(n) =
    push(log, n)

    null

// A keyed list: each row keeps its own instance when the order changes, which is what a key is for.
Rows(props) = <ul>{props.names.map(name -> <li key={name}>{name}</li>)}</ul>

val root = mount(
    <Panel title="A page">
        <Counter from={0}/>
        <Rows names={["ada", "grace"]}/>
    </Panel>)

print(html(root))
print("effects so far:", log)

// **A change is queued rather than rendered on the spot** -- two setters called in one handler are
// one render, which is what stops a handler from seeing a half-updated tree. `flush` is how a program
// says "now"; left alone the render happens one turn of the event loop later.
var press = null

Clicks(props) =
    val [n, set] = useState(0)

    press = () -> set(m -> m + 1)

    <p>clicked {n}</p>

val clicks = mount(<Clicks/>)

press()
press()

print(html(clicks))

flush(clicks)

print(html(clicks))

// `<>...</>` is a fragment: several things with no tag around them.
print(html(mount(<><b>a fragment</b>{" holds several things"}</>)))
