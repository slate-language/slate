// Slate -- a small indentation-structured, garbage-collected language, written in sysl.
//
// **It is the product.** It began as a way of finding out what sysl is like to write a real front end
// in -- a tree-walking interpreter reaching for nearly everything a language has: recursive data
// through references, payload-carrying enums, traits with associated types, generics over a
// container, closures that outlive the frame that made them, and an error path carrying a position
// from the byte that caused it to the sentence a person reads. It turned out to be a language worth
// having on its own, and that is what it is built as now: something fun, pleasant and powerful to
// write, aimed first at what an API server needs.
//
// The module is `dev.slatelang.slate`, from the domain the project owns -- the same reversal that
// gives the org's own packages `sh.sysl.*` from sysl.sh. A hyphen cannot appear in a module path,
// which is why the domain is `slatelang.dev` and not the `slate-lang.dev` that redirects to it.
//
// **The prefix is also what lets `main.sysl` live in the module rather than importing it.** The
// executable is named for the package, so with the sources in a directory called `slate/` the
// linker had a binary and a directory competing for `./slate`; under `dev/slatelang/slate/` nothing
// at the root shares the name.

package {
  name    = "slate"
  version = "0.0.30"

  // The oldest compiler this builds with.
  //
  // **Moved from 0.0.82 to 0.0.88 because `http.sysl` imports `sysl.posix.net`**, which arrived in
  // 0.0.88 (card 0018); to 0.0.90 because `monocypher` 0.4.0 states that floor for its own Argon2;
  // and to 0.0.91 because `password.sysl` imports `sysl.posix.rand.entropy_from_os`, which arrived
  // there (card 0373) and replaced a hand-rolled `/dev/urandom` reader; and to 0.0.95 because
  // `crypto.sysl` imports `sysl.crypto.sha1`, which arrived there (card 0363) and replaced a SHA-1
  // written out in slate inside `slate:ws`; and to 0.0.98 because `crypto.sysl` imports
  // `sysl.crypto.md5` and `sysl.crypto.pbkdf2_hmac256`, which arrived there (cards 0396 and 0395)
  // and replaced an MD5 written out in slate inside `slate-language/pg` and a PBKDF2 written out
  // here. This is the one reason a floor may move: something here genuinely needs a newer compiler.
  // It is NOT moved to track the newest release -- that instinct is wrong and recurs, because
  // raising a floor makes a package unusable by anyone not following head in exchange for nothing.
  sysl = "0.0.98"
}

// **The reader is `sh.sysl.parsing`'s, and reaching for `layout` is deliberate.** That module -- the
// column stack that turns indentation into brackets -- had no consumer in the org when this project
// started: `json` has no line structure and ogol has no indentation at all. A language whose blocks
// are indented runs is the consumer it was written for, so this exercises the one tier of the
// toolkit nothing had yet run.
// **The version is a floor rather than a preference, and it has moved twice for that reason.** 0.3.0,
// because slate writes a `match` as a call argument and before it a bracket suspended the off-side
// rule outright -- so the arms' newlines meant nothing and the block never opened. The feature that
// fixes it was raised from here: `opens_block` lets a grammar nominate the tokens that open a block,
// and `close_bracket` answers how many blocks the closing bracket closed, so the lexer emits their
// `DEDENT`s before the `)`.
//
// **0.8.0, because type parameters need two things a parser keeps beside its cursor** -- `ScopedNames`
// for the names a region introduced, and `names_end` for the lookahead that tells `first[T](xs)` from
// `handlers[0](x)`. Both were written HERE first and moved there, which is the direction this
// dependency has always run: neither has anything to do with types, which is what made them general.
// **`gc` is here because slate makes a cycle on every named function.** `define` binds a closure
// into the very scope that closure captured, so the scope holds the closure and the closure holds
// the scope -- and reference counting can never free that. Nothing declared the back-edge, so `weak`
// cannot help either: it is a cycle in somebody else's program, which is the case a tracing
// collector exists for.
dependencies {
  parsing { git = "github.com/sysl-lang/parsing", version = "0.8.0" }
  gc { git = "github.com/sysl-lang/gc", version = "0.2.2" }

  // **Deflate, for unwrapping a package.** A `.tar.gz` is a gzip wrapper around a raw deflate
  // stream, and `gzip.sysl` is the wrapper -- miniz is the compression itself.
  miniz { git = "github.com/sysl-lang/miniz", version = "0.2.2" }

  // **TLS, for fetching a package.** Bound over OpenSSL's memory BIOs, so it takes no loop and
  // touches no socket -- which is why the same package serves this blocking fetcher and would serve
  // an `await fetch()` on libuv unchanged.
  openssl { git = "github.com/sysl-lang/openssl", version = "0.2.0" }

  // **HTTP/1.1 parsing, which is node's llhttp.** `slate:http` is written in slate and owns the
  // server -- keep-alive, the idle clock, pipelining order, the request and response shapes -- but
  // the parse itself is a byte-at-a-time scan, which is the worst thing an interpreted language can
  // be asked to do and the place a malformed request has to be refused rather than misread. This is
  // node's own layering: JS `http` over a C parser.
  llhttp { git = "github.com/sysl-lang/llhttp", version = "0.2.0" }

  // **The event loop, and the reason slate has one at all.** A callback runs *from* the loop rather
  // than from inside an expression, so it needs nothing of the machine; `await` is the one that
  // needed the machine, and it is built on this.
  libuv { git = "github.com/sysl-lang/libuv", version = "0.1.3" }

  // **JSON, because slate's own value model already IS JSON's** -- null, booleans, two kinds of
  // number, strings, arrays and records, and nothing else. So the binding is two conversions and no
  // design, which is what makes it the cheapest of the org's packages to reach for and the one that
  // tests the mapping rather than the parser.
  json { git = "github.com/sysl-lang/json", version = "0.1.1" }

  // **Perl-compatible regular expressions.** sysl's own `sysl.regex` is POSIX extended syntax, under
  // which `\d` is a literal `d` rather than a digit -- so a pattern anybody would write compiles and
  // quietly matches nothing. This is the dialect a person expects, and it is bound rather than
  // written because PCRE2 is thirty years of somebody else's edge cases.
  pcre2 { git = "github.com/sysl-lang/pcre2", version = "0.1.2" }

  // **Argon2id, for `slate:password`.** Vendored C that includes `<stddef.h>` and `<stdint.h>` and
  // nothing else -- it opens no file, reads no clock and asks the operating system for nothing,
  // which is why it states no capability. The salt is the one thing it cannot supply, and slate asks
  // the kernel through `sysl.posix.rand.entropy_from_os`.
  monocypher { git = "github.com/sysl-lang/monocypher", version = "0.4.0" }

  // **Brotli, for `slate:brotli` and for `Content-Encoding: br`.** Every browser asks for it before
  // gzip, and on text it is worth roughly a sixth over gzip in the same speed class. `miniz` above
  // is still here for gzip itself, which is what a `.tar.gz` package is wrapped in.
  brotli { git = "github.com/sysl-lang/brotli", version = "0.1.1" }

  // **HTTP/2, which is HPACK and a framing session and no socket at all.** nghttp2 is given bytes
  // and answers bytes, exactly as `openssl` is -- which is what lets `h2` be TLS's payload with
  // neither package knowing the other exists. It is the library curl, Apache and Envoy use, and the
  // half of HTTP/2 nobody should write twice is HPACK: a decoder that trusts its input is a
  // decompression bomb waiting for somebody to send it one. **Not vendored**: `brew install nghttp2`
  // on macOS, `libnghttp2-dev` on Debian.
  nghttp2 { git = "github.com/sysl-lang/nghttp2", version = "0.3.0" }

  // **Redis, and there is no socket in the package.** hiredis separates parsing from transport, so
  // this binds `redisReader` alone -- fed bytes, answering replies -- and the connection stays
  // slate's, on the same loop as everything else. A blocking client would have made a request
  // handler that touched Redis stop answering everybody else. **Not vendored**: `brew install
  // hiredis` on macOS, `libhiredis-dev` on Debian.
  redis { git = "github.com/sysl-lang/hiredis", version = "0.1.1" }
}

// **`heap = true`.** An interpreter grows a token list, a syntax tree and an environment chain while
// it reads, and none of the three has a size known before the input does. Slate is a host program
// and will not be linked into a board, so nothing is being given up here.
requires {
  heap = true
}
